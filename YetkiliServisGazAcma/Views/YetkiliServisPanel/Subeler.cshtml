@{
    ViewData["Title"] = "Şube / Servis Noktaları";
    ViewData["PanelTitle"] = "Şube / Servis Noktaları";
    ViewData["PanelSubtitle"] = "Yetkili Servis";
    ViewData["ActiveMenu"] = "Subeler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var subeler = ViewBag.Subeler as List<YetkiliServisGazAcma.Entities.Ys_Sube>
        ?? new List<YetkiliServisGazAcma.Entities.Ys_Sube>();
    int aktifSube = subeler.Count(x => x.AktifMi);
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ys-operations.css" asp-append-version="true" />
}

<div class="ys-workspace">
    <header class="ys-page-header">
        <div class="ys-page-heading">
            <span class="ys-page-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
            <div class="ys-page-copy">
                <h1>Şube / Servis Noktaları</h1>
                <p>Hizmet noktalarınızın iletişim, konum ve çalışma durumunu yönetin.</p>
            </div>
        </div>
        <div class="ys-page-actions">
            <span class="df-pill df-pill-success">@aktifSube aktif</span>
            <span class="df-pill df-pill-info">@subeler.Count toplam</span>
        </div>
    </header>

    @if (TempData["Basarili"] != null)
    {
        <div class="ys-alert is-success"><i class="bi bi-check-circle" aria-hidden="true"></i>@TempData["Basarili"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="ys-alert is-danger"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@TempData["Hata"]</div>
    }

    <details class="ys-collapsible" open="@(!subeler.Any())">
        <summary>
            <span class="ys-summary-heading">
                <i class="bi bi-building-add" aria-hidden="true"></i>
                <strong>Yeni Şube Ekle</strong>
                <span>Yeni hizmet noktasını tanımlayın</span>
            </span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </summary>
        <div class="ys-collapsible-body">
            <form method="post" action="/ys-panel/subeler/ekle">
                @Html.AntiForgeryToken()
                <div class="ys-form-grid is-three-column">
                    <div class="ys-field"><label for="subeAdi">Şube Adı *</label><input type="text" id="subeAdi" name="subeAdi" placeholder="Örn. Merkez Şube" required /></div>
                    <div class="ys-field"><label for="subeIl">İl</label><input type="text" id="subeIl" name="il" placeholder="Örn. Çorum" /></div>
                    <div class="ys-field"><label for="subeIlce">İlçe</label><input type="text" id="subeIlce" name="ilce" placeholder="Örn. Merkez" /></div>
                    <div class="ys-field"><label for="subeTelefon">Telefon</label><input type="tel" id="subeTelefon" name="telefon" placeholder="0XXX XXX XX XX" /></div>
                    <div class="ys-field is-wide"><label for="subeAdres">Adres</label><textarea id="subeAdres" name="adres" placeholder="Şubenin açık adresi"></textarea></div>
                    <div class="ys-field">
                        <span class="ys-field-label">Kayıt Durumu</span>
                        <label class="ys-check-row"><input type="checkbox" name="aktifMi" value="true" checked /> Aktif olarak oluştur</label>
                    </div>
                </div>
                <div class="ys-actions" style="margin-top:12px">
                    <button type="submit" class="df-btn df-btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Şubeyi Kaydet</button>
                </div>
            </form>
        </div>
    </details>

    <section class="ys-panel is-blue">
        <div class="ys-panel-head">
            <div class="ys-panel-heading">
                <span class="ys-section-icon"><i class="bi bi-buildings" aria-hidden="true"></i></span>
                <div>
                    <h2 class="ys-panel-title">Kayıtlı Servis Noktaları</h2>
                    <p class="ys-panel-subtitle">@subeler.Count şube kaydı</p>
                </div>
            </div>
        </div>
        <div class="ys-table-wrap">
            <table class="ys-table">
                <thead>
                    <tr>
                        <th>Şube</th>
                        <th>Konum</th>
                        <th>Telefon</th>
                        <th>Durum</th>
                        <th><span class="visually-hidden">İşlemler</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!subeler.Any())
                    {
                        <tr><td colspan="5"><div class="ys-empty">Henüz şube kaydı bulunmuyor.</div></td></tr>
                    }
                    else
                    {
                        @foreach (var s in subeler)
                        {
                            <tr>
                                <td><span class="ys-table-primary">@s.SubeAdi</span><span class="ys-table-secondary">@(string.IsNullOrWhiteSpace(s.Adres) ? "Adres girilmemiş" : s.Adres)</span></td>
                                <td>@(string.Join(" / ", new[] { s.Il, s.Ilce }.Where(x => !string.IsNullOrWhiteSpace(x))))</td>
                                <td>@(string.IsNullOrWhiteSpace(s.Telefon) ? "-" : s.Telefon)</td>
                                <td><span class="df-pill @(s.AktifMi ? "df-pill-success" : "df-pill-danger")">@(s.AktifMi ? "Aktif" : "Pasif")</span></td>
                                <td>
                                    <div class="ys-table-actions">
                                        <a class="df-btn df-btn-secondary df-btn-sm" href="/ys-panel/subeler/duzenle/@s.Id" title="Şubeyi düzenle"><i class="bi bi-pencil" aria-hidden="true"></i> Düzenle</a>
                                        <form method="post" action="/ys-panel/subeler/durum">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="df-btn @(s.AktifMi ? "df-btn-warning" : "df-btn-success") df-btn-sm">
                                                <i class="bi @(s.AktifMi ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i> @(s.AktifMi ? "Pasife Al" : "Aktife Al")
                                            </button>
                                        </form>
                                        <form method="post" action="/ys-panel/subeler/sil" onsubmit="return confirm('Şubeyi silmek istiyor musunuz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="df-btn df-btn-danger df-btn-sm" title="Şubeyi sil"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
