@using YetkiliServisGazAcma.Entities
@using YetkiliServisGazAcma.Models.ViewModels
@{
    ViewData["Title"] = "Yetkili Servis Paneli";
    ViewData["PanelTitle"] = "Genel Bakış";
    ViewData["PanelSubtitle"] = "Yetkili Servis";
    ViewData["ActiveMenu"] = "Dashboard";
    ViewData["ContentClass"] = "personnel-home-content role-dashboard-content";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var firma = ViewBag.Firma as Ys_Firma;
    var sonIslemler = ViewBag.SonIslemler as List<Ys_DevreyeAlma> ?? new List<Ys_DevreyeAlma>();
    var buAy = Sayi(ViewBag.BuAy);
    var toplam = Sayi(ViewBag.Toplam);
    var tamamlananIslem = Sayi(ViewBag.TamamlananIslem);
    var bekleyenIslem = Sayi(ViewBag.BekleyenIslem);
    var iptalIslem = Sayi(ViewBag.IptalIslem);
    var bugun = DateTime.Today;
    var firmaAdi = string.IsNullOrWhiteSpace(firma?.FirmaAdi) ? "Yetkili Servis" : firma.FirmaAdi;
    var ilkKurulumZorunlu = ViewBag.IlkKurulumZorunlu as bool? ?? false;
    var ilkKurulumTamamlandi = ViewBag.IlkKurulumTamamlandi as bool? ?? true;
    var ilkKurulumEksikler = ViewBag.IlkKurulumEksikler as List<string> ?? new List<string>();
    var kurulumKilitli = ilkKurulumZorunlu && !ilkKurulumTamamlandi;

    var tumBelgeler = firma?.YetkiBelgeleri?.Where(x => !x.SilindiMi).ToList() ?? new List<Ys_YetkiBelgesi>();
    var gecerliBelgeler = tumBelgeler.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.Onaylandi
        && (!x.YetkiBelgesiBaslangicTarihi.HasValue || x.YetkiBelgesiBaslangicTarihi.Value.Date <= bugun)
        && x.YetkiBelgesiBitisTarihi.Date >= bugun);
    var belgeDikkat = tumBelgeler.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor);
    var aktifMarkaSayisi = firma?.FirmaMarkalar?.Count(x => !x.SilindiMi
        && x.YetkiBitisTarihi.Date >= bugun
        && x.Marka?.AktifMi == true
        && !x.Marka.SilindiMi) ?? 0;
    var aktifSubeSayisi = firma?.Subeler?.Count(x => !x.SilindiMi && x.AktifMi) ?? 0;
    var birincilIslemUrl = kurulumKilitli
        ? Url.Action("IlkKurulum", "YetkiliServisPanel")!
        : Url.Action("Index", "DevreyeAlma")!;

    var actions = new List<DashboardTileViewModel>
    {
        new()
        {
            Title = kurulumKilitli ? "İlk Kurulumu Tamamla" : "Yeni Cihaz Devreye Alma",
            Url = birincilIslemUrl,
            Icon = kurulumKilitli ? "bi bi-list-check" : "bi bi-plus-lg",
            MetricLabel = kurulumKilitli ? "Eksik kurulum adımlarını tamamla" : "Yeni cihaz kaydı oluştur",
            Tone = kurulumKilitli ? "amber" : "green",
            Featured = kurulumKilitli
        },
        new()
        {
            Title = "İşlem Geçmişi", Url = Url.Action("Gecmis", "DevreyeAlma")!, Icon = "bi bi-clock-history",
            MetricLabel = "Devreye alma kayıtlarını incele", Tone = "blue"
        },
        new()
        {
            Title = "Cihaz Devreye Alma Raporları", Url = Url.Action("Raporlar", "YetkiliServisPanel")!, Icon = "bi bi-bar-chart-line",
            MetricLabel = "İşlem sonuçlarını raporla", Tone = "cyan"
        },
        new()
        {
            Title = "Yetki Belgem", Url = Url.Action("Index", "YetkiBelgesi")!, Icon = "bi bi-file-earmark-check",
            MetricLabel = "Belge durumunu ve süresini yönet", Tone = "amber", Featured = belgeDikkat > 0
        },
        new()
        {
            Title = "Hizmet Verdiğim Markalar", Url = Url.Action("Markalar", "YetkiliServisPanel")!, Icon = "bi bi-tags",
            MetricLabel = "Marka kapsamını görüntüle", Tone = "cyan"
        },
        new()
        {
            Title = "Şubelerim", Url = Url.Action("Subeler", "YetkiliServisPanel")!, Icon = "bi bi-building",
            MetricLabel = "Şube bilgilerini yönet", Tone = "green"
        },
        new()
        {
            Title = "Profilim", Url = Url.Action("Profil", "YetkiliServisPanel")!, Icon = "bi bi-person-circle",
            MetricLabel = "Firma ve hesap bilgileri", Subtitle = "Hesabım", Tone = "blue"
        }
    };

    var quickActions = new List<DashboardTileViewModel>();
    foreach (var item in sonIslemler.Take(3))
    {
        var durum = item.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi
            ? "Tamamlandı"
            : item.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "İptal" : "Bekliyor";
        quickActions.Add(new DashboardTileViewModel
        {
            Title = string.IsNullOrWhiteSpace(item.MusteriAdi) ? $"Tesisat {item.TesistatNo ?? "-"}" : item.MusteriAdi,
            Url = Url.Action("Detay", "DevreyeAlma", new { id = item.Id })!,
            Icon = "bi bi-tools",
            MetricValue = durum,
            MetricLabel = "",
            Subtitle = $"Tesisat {item.TesistatNo ?? "-"} · {item.DevreyeAlmaTarihi:dd.MM.yyyy}",
            Tone = item.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "green" : "blue",
            Featured = quickActions.Count == 0 && item.Durum == DevreyeAlmaDurumDegerleri.Bekliyor
        });
    }
    if (quickActions.Count == 0)
    {
        quickActions.Add(new DashboardTileViewModel
        {
            Title = "Devreye alma kayıtlarını görüntüle", Url = Url.Action("Gecmis", "DevreyeAlma")!, Icon = "bi bi-clock-history",
            MetricValue = toplam.ToString(), MetricLabel = "kayıt", Subtitle = "İşlem geçmişi", Tone = "blue", Featured = true
        });
        quickActions.Add(new DashboardTileViewModel
        {
            Title = "Yetki belgesi durumunu aç", Url = Url.Action("Index", "YetkiBelgesi")!, Icon = "bi bi-file-earmark-check",
            MetricValue = gecerliBelgeler.ToString(), MetricLabel = "geçerli", Subtitle = "Yetki belgem", Tone = "amber"
        });
        quickActions.Add(new DashboardTileViewModel
        {
            Title = "Aktif şubeleri görüntüle", Url = Url.Action("Subeler", "YetkiliServisPanel")!, Icon = "bi bi-building",
            MetricValue = aktifSubeSayisi.ToString(), MetricLabel = "şube", Subtitle = "Şubelerim", Tone = "green"
        });
    }

    var sideMetrics = new List<RoleDashboardMetricViewModel>
    {
        new() { Label = "Toplam kayıt", Value = toplam.ToString(), Icon = "bi bi-archive", Tone = "blue", Url = Url.Action("Gecmis", "DevreyeAlma") },
        new() { Label = "Tamamlanan", Value = tamamlananIslem.ToString(), Icon = "bi bi-check2-circle", Tone = "green", Url = Url.Action("Gecmis", "DevreyeAlma") },
        new() { Label = "Aktif marka", Value = aktifMarkaSayisi.ToString(), Icon = "bi bi-tags", Tone = "cyan", Url = Url.Action("Markalar", "YetkiliServisPanel") },
        new() { Label = "Aktif şube", Value = aktifSubeSayisi.ToString(), Icon = "bi bi-building", Tone = "blue", Url = Url.Action("Subeler", "YetkiliServisPanel") }
    };

    var attentionItems = new List<DashboardTileViewModel>();
    if (bekleyenIslem > 0)
    {
        attentionItems.Add(new DashboardTileViewModel
        {
            Title = "Sonuç bekleyen işlemler", Url = Url.Action("Gecmis", "DevreyeAlma")!, Icon = "bi bi-hourglass-split",
            MetricValue = bekleyenIslem.ToString(), Subtitle = "İşlem takibi", Tone = "amber"
        });
    }
    if (iptalIslem > 0)
    {
        attentionItems.Add(new DashboardTileViewModel
        {
            Title = "İptal edilen işlemler", Url = Url.Action("Gecmis", "DevreyeAlma")!, Icon = "bi bi-x-circle",
            MetricValue = iptalIslem.ToString(), Subtitle = "Durum kontrolü", Tone = "amber"
        });
    }
    var dashboardModel = new RoleDashboardViewModel
    {
        Variant = "authorized-service",
        AriaLabel = "Yetkili servis operasyon özeti",
        HeroTitle = "Yetkili Servis Paneli",
        HeroKicker = firmaAdi,
        HeroKickerIcon = "bi bi-building-check",
        HeroImageUrl = "/images/hero/yetkili-servis-devreye-alma-dashboard.png",
        ActionsTitle = "İşlem Alanlarım",
        QuickActionsTitle = sonIslemler.Count > 0 ? "Son İşlemler" : "Hızlı İşlemler",
        QuickActionsMeta = "Güncel durum",
        Facts = new List<RoleDashboardFactViewModel>
        {
            new() { Icon = kurulumKilitli ? "bi bi-exclamation-circle" : "bi bi-tools", Value = kurulumKilitli ? ilkKurulumEksikler.Count.ToString() : buAy.ToString(), Label = kurulumKilitli ? "tamamlanacak kurulum adımı" : "bu ay kaydedilen cihaz", Url = birincilIslemUrl },
            new() { Icon = "bi bi-file-earmark-check", Value = gecerliBelgeler.ToString(), Label = "geçerli yetki belgesi", Url = Url.Action("Index", "YetkiBelgesi") }
        },
        Actions = actions,
        QuickActions = quickActions,
        SidePanel = new RoleDashboardSidePanelViewModel
        {
            Title = "Hizmet Özeti", Icon = "bi bi-grid-1x2", ItemsTitle = "Dikkat Gerektirenler",
            ActionText = "Geçmişi Aç", ActionUrl = Url.Action("Gecmis", "DevreyeAlma"),
            Metrics = sideMetrics, Items = attentionItems
        }
    };
}
@functions {
    private static int Sayi(object? value)
    {
        if (value is int sayi) return Math.Max(sayi, 0);
        return int.TryParse(value?.ToString(), out var sonuc) ? Math.Max(sonuc, 0) : 0;
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/personnel-home.css" asp-append-version="true" />
}

@await Html.PartialAsync("_RoleDashboard", dashboardModel)

@section Scripts {
    <script src="~/js/dashboard-carousel.js" asp-append-version="true"></script>
}
