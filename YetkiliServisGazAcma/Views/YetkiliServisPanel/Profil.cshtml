@{
    var kullanici = ViewBag.Kullanici as YetkiliServisGazAcma.Entities.AppKullanici;
    var firma = ViewBag.Firma as YetkiliServisGazAcma.Entities.Ys_Firma;
    ViewData["Title"] = "Firma Profilim";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Yetkili Servis";
    ViewData["ActiveMenu"] = "Profil";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var markalar = firma?.FirmaMarkalar?.Where(x => !x.SilindiMi && x.Marka != null).Select(x => x.Marka!).Distinct().ToList()
        ?? new List<YetkiliServisGazAcma.Entities.Ys_Marka>();
    var yetkiBelgeleri = firma?.YetkiBelgeleri?.Where(x => !x.SilindiMi).OrderByDescending(x => x.OlusturmaTarihi).ToList()
        ?? new List<YetkiliServisGazAcma.Entities.Ys_YetkiBelgesi>();
    var gecerli = yetkiBelgeleri.FirstOrDefault(x => x.Durum == YetkiBelgesiDurumDegerleri.Onaylandi && x.YetkiBelgesiBitisTarihi > DateTime.Now);
    var onayli = yetkiBelgeleri.FirstOrDefault(x => x.Durum == YetkiBelgesiDurumDegerleri.Onaylandi);
    var bekleyenBelge = yetkiBelgeleri.FirstOrDefault(x => x.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor
        && x.YetkiBelgesiBitisTarihi.Date >= DateTime.Today);
    var yetkiBelgesi = gecerli ?? bekleyenBelge ?? onayli ?? yetkiBelgeleri.FirstOrDefault();
    var adSoyad = kullanici?.AdSoyad ?? firma?.YetkiliKisi ?? "Yetkili Servis";
    var firmaAdi = firma?.FirmaAdi ?? "Firma";
    var basHarf = firmaAdi.Length > 0 ? firmaAdi[..1].ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) : "F";
    var bekleyenBelgeVar = bekleyenBelge != null;
    var belgeDurumu = gecerli != null ? "Geçerli" : bekleyenBelgeVar ? "Onay Bekliyor" : yetkiBelgesi?.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor && yetkiBelgesi.YetkiBelgesiBitisTarihi.Date < DateTime.Today ? "Süresi Doldu" : "Geçerli Belge Yok";
    var belgeClass = gecerli != null ? "df-pill-success" : bekleyenBelgeVar ? "df-pill-warning" : "df-pill-danger";
    var sifreAcik = TempData.ContainsKey("SifreHata") || TempData.ContainsKey("SifreBasarili");
}

@section PageStyles { <link rel="stylesheet" href="~/css/personnel-profile.css" asp-append-version="true" /> }

<div class="personnel-account service-account profile-theme--authorized-service">
    <aside class="account-identity" aria-label="Firma hesabı özeti">
        <div class="account-avatar" aria-hidden="true">@basHarf</div>
        <h1>@firmaAdi</h1>
        <div class="service-account-status"><span class="df-pill @belgeClass">@belgeDurumu</span><span class="df-pill df-pill-info">@markalar.Count marka</span></div>
        <dl>
            <div><dt><i class="bi bi-building" aria-hidden="true"></i>Dağıtım Şirketi</dt><dd>@(firma?.Sirket?.SirketAdi ?? "Tanımlı değil")</dd></div>
            <div><dt><i class="bi bi-geo-alt" aria-hidden="true"></i>Faaliyet İli</dt><dd>@(firma?.FaaliyetIli ?? "-")</dd></div>
            <div><dt><i class="bi bi-person" aria-hidden="true"></i>Yetkili Kişi</dt><dd>@adSoyad</dd></div>
        </dl>
    </aside>

    <div class="account-content">
        <div class="account-tabs" role="tablist" aria-label="Firma profili bölümleri" data-initial-tab="@(sifreAcik ? "security" : "contact")">
            <button type="button" role="tab" id="tab-contact" aria-controls="account-contact" aria-selected="true"><i class="bi bi-person-vcard" aria-hidden="true"></i>İletişim Bilgileri</button>
            <button type="button" role="tab" id="tab-firm" aria-controls="account-firm" aria-selected="false"><i class="bi bi-building-check" aria-hidden="true"></i>Firma ve Yetkiler</button>
            <button type="button" role="tab" id="tab-security" aria-controls="account-security" aria-selected="false"><i class="bi bi-shield-lock" aria-hidden="true"></i>Şifre ve Güvenlik</button>
        </div>

        <section class="account-section" id="account-contact" role="tabpanel" aria-labelledby="tab-contact">
            <form method="post" action="@Url.Action("ProfilGuncelle", "YetkiliServisPanel")">
                @Html.AntiForgeryToken()
                <div class="account-fields">
                    <label for="service-profile-name" class="account-field-wide">Ad Soyad<input id="service-profile-name" type="text" name="adSoyad" value="@kullanici?.AdSoyad" autocomplete="name" required /></label>
                    <label for="service-profile-email">E-posta<input id="service-profile-email" type="email" name="email" value="@kullanici?.Email" autocomplete="email" required /></label>
                    <label for="service-profile-phone">Telefon<input id="service-profile-phone" type="tel" name="telefon" value="@kullanici?.PhoneNumber" autocomplete="tel" /></label>
                    <label for="service-profile-user" class="account-field-wide">Kullanıcı Adı<input id="service-profile-user" type="text" value="@kullanici?.UserName" readonly /></label>
                </div>
                <footer><button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2" aria-hidden="true"></i>Bilgileri Kaydet</button></footer>
            </form>
        </section>

        <section class="account-section" id="account-firm" role="tabpanel" aria-labelledby="tab-firm" hidden>
            <dl class="account-work-data">
                <div><dt>Firma</dt><dd>@firmaAdi</dd></div>
                <div><dt>Vergi Kimlik No</dt><dd>@(firma?.VergiNo ?? "-")</dd></div>
                <div><dt>Faaliyet İli</dt><dd>@(firma?.FaaliyetIli ?? "-")</dd></div>
                <div><dt>Kayıt Tarihi</dt><dd>@(firma?.OlusturmaTarihi.ToString("dd.MM.yyyy") ?? "-")</dd></div>
            </dl>
            <div class="service-account-subsection">
                <h2>Marka Yetkileri</h2>
                <div class="account-permissions">
                    @if (markalar.Count == 0) { <span>Tanımlı marka bulunmuyor</span> }
                    @foreach (var marka in markalar) { <span><i class="bi bi-check2" aria-hidden="true"></i>@marka.MarkaAdi</span> }
                </div>
            </div>
            <div class="service-account-document">
                <i class="bi bi-file-earmark-check" aria-hidden="true"></i>
                <div><strong>@belgeDurumu</strong><span>@(yetkiBelgesi == null ? "Yetki belgesi yüklenmemiş" : $"Bitiş tarihi: {yetkiBelgesi.YetkiBelgesiBitisTarihi:dd.MM.yyyy}")</span></div>
                <a class="df-btn df-btn-secondary df-btn-sm" href="@Url.Action("Index", "YetkiBelgesi")">Belgeyi Aç</a>
            </div>
        </section>

        <section class="account-section" id="account-security" role="tabpanel" aria-labelledby="tab-security" hidden>
            <form method="post" action="@Url.Action("SifreDegistir", "YetkiliServisPanel")">
                @Html.AntiForgeryToken()
                <div class="account-fields">
                    <label for="service-current-password" class="account-field-wide">Mevcut Şifre<input id="service-current-password" type="password" name="mevcutSifre" autocomplete="current-password" required /></label>
                    <label for="service-new-password">Yeni Şifre<input id="service-new-password" type="password" name="yeniSifre" autocomplete="new-password" required /></label>
                    <label for="service-confirm-password">Yeni Şifre Tekrar<input id="service-confirm-password" type="password" name="yeniSifreTekrar" autocomplete="new-password" required /></label>
                </div>
                <footer><button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-lock" aria-hidden="true"></i>Şifreyi Güncelle</button></footer>
            </form>
        </section>
    </div>
</div>

@section Scripts { <script src="~/js/personnel-profile.js" asp-append-version="true"></script> }
