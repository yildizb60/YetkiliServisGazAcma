@{
    var kullanici = ViewBag.Kullanici as YetkiliServisGazAcma.Entities.AppKullanici;
    var firma = ViewBag.Firma as YetkiliServisGazAcma.Entities.Ys_Firma;
    ViewData["Title"] = "Firma Profilim";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Yetkili Servis";
    ViewData["ActiveMenu"] = "Profil";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var markalar = firma?.FirmaMarkalar?.Where(x => !x.SilindiMi && x.Marka != null).Select(x => x.Marka!).Distinct().ToList()
        ?? new List<YetkiliServisGazAcma.Entities.Ys_Marka>();
    var yetkiBelgeleri = firma?.YetkiBelgeleri?.Where(x => !x.SilindiMi).OrderByDescending(x => x.OlusturmaTarihi).ToList()
        ?? new List<YetkiliServisGazAcma.Entities.Ys_YetkiBelgesi>();
    var gecerli = yetkiBelgeleri.FirstOrDefault(x => x.Durum == YetkiBelgesiDurumDegerleri.Onaylandi && x.YetkiBelgesiBitisTarihi > DateTime.Now);
    var onayli = yetkiBelgeleri.FirstOrDefault(x => x.Durum == YetkiBelgesiDurumDegerleri.Onaylandi);
    var yetkiBelgesi = gecerli ?? onayli ?? yetkiBelgeleri.FirstOrDefault();
    var adSoyad = kullanici?.AdSoyad ?? firma?.YetkiliKisi ?? "Yetkili Servis";
    var basHarf = !string.IsNullOrEmpty(firma?.FirmaAdi) ? firma.FirmaAdi.Substring(0, 1).ToUpper() : "F";
    var belgeDurumu = gecerli != null ? "Geçerli" : yetkiBelgesi?.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor ? "Onay Bekliyor" : "Geçerli Belge Yok";
    var belgeClass = gecerli != null ? "df-pill-success" : yetkiBelgesi?.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor ? "df-pill-warning" : "df-pill-danger";
}

<div class="df-profile-workspace">
    @if (TempData["Basarili"] != null) { <div class="df-alert df-alert-success">@TempData["Basarili"]</div> }
    @if (TempData["Hata"] != null) { <div class="df-alert df-alert-danger">@TempData["Hata"]</div> }
    @if (TempData["SifreBasarili"] != null) { <div class="df-alert df-alert-success">@TempData["SifreBasarili"]</div> }
    @if (TempData["SifreHata"] != null) { <div class="df-alert df-alert-danger">@TempData["SifreHata"]</div> }

    <section class="df-page-panel df-profile-header">
        <div class="df-profile-header-inner">
            <div class="df-profile-avatar">@basHarf</div>
            <div class="df-profile-heading"><h2>@(firma?.FirmaAdi ?? "Firma")</h2><p>@adSoyad · @(firma?.Sirket?.SirketAdi ?? "Şirket tanımlı değil")</p></div>
            <div class="df-profile-header-meta">
                <span class="df-pill @belgeClass"><i class="bi bi-file-earmark-check"></i> @belgeDurumu</span>
                <span class="df-pill df-pill-info">@markalar.Count marka</span>
            </div>
        </div>
    </section>

    <div class="df-profile-grid">
        <section class="df-profile-section is-context">
            <div class="df-profile-section-head"><i class="bi bi-building"></i><div><strong>Firma Bilgileri</strong><small>Kayıtlı kurumsal bilgiler</small></div></div>
            <dl class="df-profile-info-grid">
                <div><dt>Firma</dt><dd>@(firma?.FirmaAdi ?? "-")</dd></div>
                <div><dt>VKN</dt><dd>@(firma?.VergiNo ?? "-")</dd></div>
                <div><dt>Faaliyet İli</dt><dd>@(firma?.FaaliyetIli ?? "-")</dd></div>
                <div><dt>Kayıt Tarihi</dt><dd>@(firma?.OlusturmaTarihi.ToString("dd.MM.yyyy") ?? "-")</dd></div>
            </dl>
            <div class="df-profile-section-body">
                <div class="df-profile-context-title">MARKA YETKİLERİ</div>
                <div class="df-profile-brands">
                    @if (markalar.Count == 0) { <span class="df-profile-brand">Tanımlı marka yok</span> }
                    else { foreach (var marka in markalar) { <span class="df-profile-brand">@marka.MarkaAdi</span> } }
                </div>
            </div>
        </section>

        <section class="df-profile-section is-account">
            <div class="df-profile-section-head"><i class="bi bi-person-vcard"></i><div><strong>İletişim Bilgileri</strong><small>Profilde görünen bilgiler</small></div></div>
            <div class="df-profile-section-body">
                <form method="post" action="/ys-panel/profil-guncelle">
                    @Html.AntiForgeryToken()
                    <div class="df-profile-form-grid">
                        <div class="df-profile-field is-wide"><label>Ad Soyad</label><input type="text" name="adSoyad" value="@kullanici?.AdSoyad" required /></div>
                        <div class="df-profile-field"><label>E-posta</label><input type="email" name="email" value="@kullanici?.Email" required /></div>
                        <div class="df-profile-field"><label>Telefon</label><input type="text" name="telefon" value="@kullanici?.PhoneNumber" autocomplete="tel" /></div>
                        <div class="df-profile-field is-wide"><label>Kullanıcı Adı (VKN)</label><input type="text" value="@kullanici?.UserName" readonly /></div>
                    </div>
                    <div class="df-profile-actions"><button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2"></i> Bilgileri Kaydet</button></div>
                </form>
            </div>
        </section>

        <section class="df-profile-section is-document">
            <div class="df-profile-section-head"><i class="bi bi-file-earmark-check"></i><div><strong>Yetki Belgesi</strong><small>Güncel belge durumu</small></div></div>
            <div class="df-profile-section-body">
                @if (yetkiBelgesi != null)
                {
                    <div class="df-profile-document">
                        <i class="bi bi-patch-check"></i>
                        <div class="df-profile-document-copy"><strong>@belgeDurumu</strong><small>Yükleme: @yetkiBelgesi.OlusturmaTarihi.ToString("dd.MM.yyyy") · Bitiş: @yetkiBelgesi.YetkiBelgesiBitisTarihi.ToString("dd.MM.yyyy")</small></div>
                        <a class="df-btn df-btn-secondary df-btn-sm" href="/ys-yetki-belgesi">Belgeyi Aç</a>
                    </div>
                }
                else
                {
                    <div class="df-profile-document"><i class="bi bi-file-earmark-plus"></i><div class="df-profile-document-copy"><strong>Yetki belgesi yüklenmemiş</strong><small>Belge işlemlerinden yeni kayıt oluşturabilirsiniz.</small></div><a class="df-btn df-btn-primary df-btn-sm" href="/ys-yetki-belgesi">Belge Ekle</a></div>
                }
            </div>
        </section>

        <details class="df-profile-section is-security df-profile-disclosure">
            <summary><i class="bi bi-key"></i><span><strong>Şifre Değiştir</strong><small>Yalnızca gerektiğinde açın</small></span><i class="bi bi-chevron-down"></i></summary>
            <div class="df-profile-section-body">
                <form method="post" action="/ys-panel/sifre-degistir">
                    @Html.AntiForgeryToken()
                    <div class="df-profile-form-grid">
                        <div class="df-profile-field is-wide"><label>Mevcut Şifre</label><input type="password" name="mevcutSifre" autocomplete="current-password" required /></div>
                        <div class="df-profile-field"><label>Yeni Şifre</label><input type="password" name="yeniSifre" autocomplete="new-password" required /></div>
                        <div class="df-profile-field"><label>Yeni Şifre Tekrar</label><input type="password" name="yeniSifreTekrar" autocomplete="new-password" required /></div>
                    </div>
                    <div class="df-profile-actions"><button type="submit" class="df-btn df-btn-secondary df-btn-sm"><i class="bi bi-lock"></i> Şifreyi Güncelle</button></div>
                </form>
            </div>
        </details>
    </div>
</div>
