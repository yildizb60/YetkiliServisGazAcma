@{
    var kullanici = ViewBag.Kullanici as YetkiliServisGazAcma.Entities.AppKullanici;
    ViewData["Title"] = "İlk Kurulum";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Yetkili Servis";
    ViewData["ActiveMenu"] = "Dashboard";
    ViewData["PanelArea"] = "YetkiliServis";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var firma = ViewBag.Firma as YetkiliServisGazAcma.Entities.Ys_Firma;
    var tumMarkalar = ViewBag.TumMarkalar as List<YetkiliServisGazAcma.Entities.Ys_Marka> ?? new();
    var tumKategoriler = ViewBag.TumKategoriler as List<YetkiliServisGazAcma.Entities.UrunKategori> ?? new();
    var seciliMarkaIds = ViewBag.SeciliMarkaIds as List<int> ?? new();
    var seciliKategoriIds = ViewBag.SeciliKategoriIds as List<int> ?? new();
    var aktifSubeSayisi = ViewBag.AktifSubeSayisi as int? ?? 0;
    var yetkiBelgesiVar = ViewBag.YetkiBelgesiVar as bool? ?? false;
    var onayliYetkiBelgesiVar = ViewBag.OnayliYetkiBelgesiVar as bool? ?? false;
    var eksikler = ViewBag.IlkKurulumEksikler as List<string> ?? new();
}

<div class="df-admin-workspace df-admin-editor df-onboarding-workspace">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <strong>Kurulum Durumu</strong>
            </div>
        </div>
        <div class="df-admin-metrics" aria-label="Kurulum durumu">
            <span class="df-admin-metric is-brand"><i class="bi bi-tags" aria-hidden="true"></i><span>Marka</span><strong>@seciliMarkaIds.Count</strong></span>
            <span class="df-admin-metric is-service"><i class="bi bi-grid" aria-hidden="true"></i><span>Kategori</span><strong>@seciliKategoriIds.Count</strong></span>
            <span class="df-admin-metric @(aktifSubeSayisi > 0 ? "is-active" : "is-waiting")"><i class="bi bi-building" aria-hidden="true"></i><span>Aktif Şube</span><strong>@aktifSubeSayisi</strong></span>
            <span class="df-admin-metric @(onayliYetkiBelgesiVar ? "is-approved" : "is-waiting")"><i class="bi bi-file-earmark-check" aria-hidden="true"></i><span>Yetki Belgesi</span><strong>@(onayliYetkiBelgesiVar ? "Onaylı" : yetkiBelgesiVar ? "Bekliyor" : "Eksik")</strong></span>
        </div>
    </section>

    @if (eksikler.Count > 0)
    {
        <div class="df-admin-help">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <div><strong>Kurulumu tamamlayın</strong>@string.Join(" · ", eksikler)</div>
        </div>
    }

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            <form method="post" action="/ys-panel/ilk-kurulum">
                @Html.AntiForgeryToken()
                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head"><span><i class="bi bi-tags" aria-hidden="true"></i></span><div><h3>Hizmet Alanları</h3><p>Servis verdiğiniz marka ve cihaz kategorilerini seçin.</p></div></div>
                    <div class="df-admin-choice-layout">
                        <div class="df-admin-choice-box">
                            <h4 class="df-admin-section-title"><i class="bi bi-tag" aria-hidden="true"></i> Markalar</h4>
                            @if (tumMarkalar.Count == 0)
                            {
                                <div class="df-admin-empty">Tanımlı marka bulunamadı.</div>
                            }
                            else
                            {
                                <div class="df-admin-choice-list">
                                @foreach (var marka in tumMarkalar)
                                {
                                    <label class="df-admin-choice"><input type="checkbox" name="markaIds" value="@marka.Id" checked="@(seciliMarkaIds.Contains(marka.Id) ? "checked" : null)" /><span>@marka.MarkaAdi</span></label>
                                }
                                </div>
                            }
                        </div>
                        <div class="df-admin-choice-box">
                            <h4 class="df-admin-section-title is-scope"><i class="bi bi-grid" aria-hidden="true"></i> Cihaz Kategorileri</h4>
                            @if (tumKategoriler.Count == 0)
                            {
                                <div class="df-admin-empty">Tanımlı kategori bulunamadı.</div>
                            }
                            else
                            {
                                <div class="df-admin-choice-list">
                                @foreach (var kategori in tumKategoriler)
                                {
                                    <label class="df-admin-choice"><input type="checkbox" name="kategoriIds" value="@kategori.Id" checked="@(seciliKategoriIds.Contains(kategori.Id) ? "checked" : null)" /><span>@kategori.Ad</span></label>
                                }
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head"><span><i class="bi bi-building-add" aria-hidden="true"></i></span><div><h3>@(aktifSubeSayisi > 0 ? "Yeni Şube Ekleyin" : "İlk Şubenizi Tanımlayın")</h3><p>@(aktifSubeSayisi > 0 ? "Mevcut şubenize ek olarak yeni bir hizmet noktası tanımlayabilirsiniz." : "Devam edebilmek için en az bir aktif şube gerekir.")</p></div></div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-half"><label for="subeAdi">Şube Adı</label><input id="subeAdi" type="text" name="subeAdi" placeholder="Örn. Merkez Şube" /></div>
                        <div class="df-admin-field is-half"><label for="telefon">Telefon</label><input id="telefon" type="tel" name="telefon" placeholder="0XXX XXX XX XX" autocomplete="tel" /></div>
                        <div class="df-admin-field"><label for="il">İl</label><input id="il" type="text" name="il" placeholder="İl" autocomplete="address-level1" /></div>
                        <div class="df-admin-field"><label for="ilce">İlçe</label><input id="ilce" type="text" name="ilce" placeholder="İlçe" autocomplete="address-level2" /></div>
                        <div class="df-admin-field is-full"><label for="adres">Adres</label><textarea id="adres" name="adres" placeholder="Şube adresi" autocomplete="street-address"></textarea></div>
                    </div>
                </section>

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head"><span><i class="bi bi-file-earmark-check" aria-hidden="true"></i></span><div><h3>Yetki Belgesi</h3><p>Belge yükleme ve onay durumunu kontrol edin.</p></div></div>
                    <div class="df-admin-help">
                        <i class="bi @(onayliYetkiBelgesiVar ? "bi-check-circle" : yetkiBelgesiVar ? "bi-hourglass-split" : "bi-exclamation-circle")" aria-hidden="true"></i>
                        <div>
                            <strong>@(onayliYetkiBelgesiVar ? "Yetki belgesi onaylı" : yetkiBelgesiVar ? "Yetki belgesi incelemede" : "Yetki belgesi yüklenmedi")</strong>
                            @(onayliYetkiBelgesiVar ? "Devreye alma işlemleri için belge durumu uygun." : yetkiBelgesiVar ? "Belge sonucu onay ekranından takip edilebilir." : "Kurulumu tamamlamak için bir yetki belgesi yükleyin.")
                        </div>
                    </div>
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/ys-yetki-belgesi"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Yetki Belgesi Ekranı</a>
                </section>

                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/ys-panel"><i class="bi bi-arrow-left" aria-hidden="true"></i> Panele Dön</a>
                    <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> Kurulumu Tamamla</button>
                </div>
            </form>
        </div>
    </section>
</div>
