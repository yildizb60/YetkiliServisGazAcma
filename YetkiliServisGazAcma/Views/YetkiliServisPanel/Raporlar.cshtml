@{
    ViewData["Title"] = "Cihaz Devreye Alma Raporları";
    ViewData["PanelTitle"] = "Raporlar";
    ViewData["PanelModule"] = "Yetkili Servis Paneli";
    ViewData["ActiveMenu"] = "Raporlar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    DateTime basTarih = ViewBag.BasTarih;
    DateTime bitTarih = ViewBag.BitTarih;
    var toplam = Convert.ToInt32(ViewBag.DevreyeSayisi);
    var tamamlanan = Convert.ToInt32(ViewBag.Tamamlanan);
    var bekleyen = Convert.ToInt32(ViewBag.Bekleyen);
    var durumlar = ViewBag.ChartDurumData as List<int> ?? new List<int>();
    var iptal = durumlar.Count > 2 ? durumlar[2] : 0;
    var aylar = ViewBag.ChartAylikLabels as List<string> ?? new List<string>();
    var aylik = ViewBag.ChartAylikData as List<int> ?? new List<int>();
    var chartCount = Math.Min(6, Math.Min(aylar.Count, aylik.Count));
    var chartMax = Math.Max(1, aylik.DefaultIfEmpty(0).Max());
    var tamamlanmaOrani = toplam == 0 ? 0 : Math.Round(tamamlanan * 100d / toplam, 1);
    string CssYuzde(double value) => Math.Clamp(value, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var pdfUrl = Url.Action("RaporlarPdf", "YetkiliServisPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") });
    var excelUrl = Url.Action("RaporlarExcel", "YetkiliServisPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") });
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/admin-reports.css" asp-append-version="true" />
}

<main class="df-admin-report-workspace df-operations-report df-role-report df-service-operations-report">
    <section class="df-ops-command" aria-labelledby="serviceReportHeading">
        <div class="df-ops-command-copy">
            <span class="df-ops-command-icon" aria-hidden="true"><i class="bi bi-bag-check"></i></span>
            <div><h1 id="serviceReportHeading">Devreye alma raporları</h1><p>@basTarih.ToString("dd.MM.yyyy") - @bitTarih.ToString("dd.MM.yyyy")</p></div>
        </div>
        <form method="get" action="@Url.Action("Raporlar", "YetkiliServisPanel")" class="df-ops-filter">
            <div class="df-admin-field"><label for="raporBas">Başlangıç</label><input id="raporBas" type="date" name="bas" value="@basTarih.ToString("yyyy-MM-dd")" /></div>
            <div class="df-admin-field"><label for="raporBit">Bitiş</label><input id="raporBit" type="date" name="bit" value="@bitTarih.ToString("yyyy-MM-dd")" /></div>
            <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Uygula</button>
        </form>
    </section>

    <section class="df-ops-kpis" aria-label="Devreye alma göstergeleri">
        <article class="df-ops-kpi is-volume"><span class="df-ops-kpi-icon"><i class="bi bi-inboxes" aria-hidden="true"></i></span><div><span>Toplam kayıt</span><strong>@toplam</strong></div></article>
        <article class="df-ops-kpi is-duration"><span class="df-ops-kpi-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span><div><span>Tamamlanan</span><strong>@tamamlanan</strong></div></article>
        <article class="df-ops-kpi is-compliance"><span class="df-ops-kpi-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span><div><span>Bekleyen</span><strong>@bekleyen</strong></div></article>
        <article class="df-ops-kpi is-repeat"><span class="df-ops-kpi-icon"><i class="bi bi-x-circle" aria-hidden="true"></i></span><div><span>İptal</span><strong>@iptal</strong></div></article>
    </section>

    <section class="df-ops-overview" aria-label="Devreye alma grafikleri">
        <div class="df-ops-monthly">
            <header class="df-ops-section-head"><div><h2>Aylık devreye alma işlemleri</h2></div><span>@toplam kayıt</span></header>
            @if (chartCount == 0)
            {
                <div class="df-ops-empty">Seçili dönemde işlem yok.</div>
            }
            else
            {
                <div class="df-ops-monthly-chart" style="--chart-count:@chartCount" role="img" aria-label="Aylık devreye alma işlemleri">
                    @for (var index = 0; index < chartCount; index++)
                    {
                        <div class="df-ops-month" title="@aylar[index]: @aylik[index] kayıt">
                            <strong>@aylik[index]</strong>
                            <span class="df-ops-month-track"><i style="--bar:@CssYuzde(aylik[index] * 100d / chartMax)%"></i></span>
                            <small>@aylar[index]</small>
                        </div>
                    }
                </div>
            }
        </div>
        <aside class="df-ops-status" aria-labelledby="serviceReportStatusHeading">
            <header class="df-ops-section-head"><div><h2 id="serviceReportStatusHeading">Durum dağılımı</h2></div></header>
            @if (toplam == 0)
            {
                <div class="df-ops-empty">Seçili dönemde kayıt yok.</div>
            }
            else
            {
                <div class="df-ops-completion">
                    <div class="df-ops-ring" style="--value:@CssYuzde(tamamlanmaOrani)" aria-label="Tamamlanan yüzde @tamamlanmaOrani"><strong>%@tamamlanmaOrani.ToString("0.#")</strong><span>tamamlandı</span></div>
                    <dl>
                        <div><dt><i class="is-complete" aria-hidden="true"></i> Tamamlanan</dt><dd>@tamamlanan</dd></div>
                        <div><dt><i class="is-active" aria-hidden="true"></i> Bekleyen</dt><dd>@bekleyen</dd></div>
                        <div><dt><i class="is-cancelled" aria-hidden="true"></i> İptal</dt><dd>@iptal</dd></div>
                    </dl>
                </div>
            }
        </aside>
    </section>

    <section class="df-ops-download-strip" aria-label="Devreye alma raporu indirme seçenekleri">
        <div><h2>Devreye alma kayıtları</h2><span>@basTarih.ToString("dd.MM.yyyy") - @bitTarih.ToString("dd.MM.yyyy")</span></div>
        <div class="df-ops-export-actions">
            <a class="df-btn df-btn-sm df-btn-pdf" href="@pdfUrl"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
            <a class="df-btn df-btn-sm df-btn-excel" href="@excelUrl"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
            <a class="df-btn df-btn-sm df-btn-secondary" href="@Url.Action("Gecmis", "DevreyeAlma")"><i class="bi bi-list-ul" aria-hidden="true"></i> Kayıtlar</a>
        </div>
    </section>
</main>
