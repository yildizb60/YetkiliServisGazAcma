@{
    ViewData["Title"] = "Cihaz Devreye Alma Raporları";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelModule"] = "Cihaz Devreye Alma";
    ViewData["PanelSubtitle"] = "Yetkili Servis";
    ViewData["ActiveMenu"] = "Raporlar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    DateTime basTarih = ViewBag.BasTarih;
    DateTime bitTarih = ViewBag.BitTarih;
    var iptal = Math.Max(Convert.ToInt32(ViewBag.DevreyeSayisi) - Convert.ToInt32(ViewBag.Tamamlanan) - Convert.ToInt32(ViewBag.Bekleyen), 0);
    var raporVar = Convert.ToInt32(ViewBag.DevreyeSayisi) > 0;
    var pdfUrl = Url.Action("RaporlarPdf", "YetkiliServisPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") });
    var excelUrl = Url.Action("RaporlarExcel", "YetkiliServisPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") });
    var jsonOptions = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ys-operations.css" asp-append-version="true" />
}

<div class="ys-workspace ys-reports-workspace">
    <section class="ys-report-controls">
        <form class="ys-query-grid" method="get" action="@Url.Action("Raporlar", "YetkiliServisPanel")">
            <div class="ys-field">
                <label for="raporBas">Başlangıç</label>
                <input type="date" id="raporBas" name="bas" value="@basTarih.ToString("yyyy-MM-dd")" />
            </div>
            <div class="ys-field">
                <label for="raporBit">Bitiş</label>
                <input type="date" id="raporBit" name="bit" value="@bitTarih.ToString("yyyy-MM-dd")" />
            </div>
            <div class="ys-report-control-actions">
                <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Uygula</button>
                <a class="df-btn df-btn-secondary df-btn-sm ys-quiet-export is-pdf @(!raporVar ? "is-disabled" : "")" href="@(raporVar ? pdfUrl : "#")" aria-disabled="@(!raporVar ? "true" : "false")" title="Filtrelenen kayıtları PDF olarak indir"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
                <a class="df-btn df-btn-secondary df-btn-sm ys-quiet-export is-excel @(!raporVar ? "is-disabled" : "")" href="@(raporVar ? excelUrl : "#")" aria-disabled="@(!raporVar ? "true" : "false")" title="Filtrelenen kayıtları Excel olarak indir"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
            </div>
        </form>
    </section>

    <div class="ys-summary-strip" aria-label="Rapor özeti">
        <div class="ys-summary-item">
            <span class="ys-summary-icon"><i class="bi bi-collection" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong>@ViewBag.DevreyeSayisi</strong><span>Toplam İşlem</span></span>
        </div>
        <div class="ys-summary-item is-success">
            <span class="ys-summary-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong>@ViewBag.Tamamlanan</strong><span>Tamamlanan</span></span>
        </div>
        <div class="ys-summary-item is-warning">
            <span class="ys-summary-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong>@ViewBag.Bekleyen</strong><span>Bekleyen</span></span>
        </div>
        <div class="ys-summary-item is-danger">
            <span class="ys-summary-icon"><i class="bi bi-x-circle" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong>@iptal</strong><span>İptal Edilen</span></span>
        </div>
    </div>

    <section class="ys-chart-grid" aria-label="Rapor grafikleri">
        <div class="ys-chart-panel">
            <div class="ys-chart-title">Aylık İşlem Trendi</div>
            <div class="ys-chart-wrap" id="wrapAylik">
                <div class="ys-chart-empty">Veri bulunamadı</div>
                <canvas id="aylikChart"></canvas>
            </div>
        </div>
        <div class="ys-chart-panel">
            <div class="ys-chart-title">İşlem Durumları</div>
            <div class="ys-chart-wrap" id="wrapDurum">
                <div class="ys-chart-empty">Veri bulunamadı</div>
                <canvas id="durumChart"></canvas>
            </div>
        </div>
        <div class="ys-chart-panel">
            <div class="ys-chart-title">Markaya Göre İşlem</div>
            <div class="ys-chart-wrap" id="wrapMarka">
                <div class="ys-chart-empty">Veri bulunamadı</div>
                <canvas id="markaChart"></canvas>
            </div>
        </div>
    </section>

</div>

<div id="raporChartData"
     data-aylik-labels='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartAylikLabels ?? new List<string>(), jsonOptions))'
     data-aylik-data='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartAylikData ?? new List<int>(), jsonOptions))'
     data-durum-data='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartDurumData ?? new List<int>(), jsonOptions))'
     data-marka-labels='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartMarkaLabels ?? new List<string>(), jsonOptions))'
     data-marka-data='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartMarkaData ?? new List<int>(), jsonOptions))'
     hidden></div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    (function () {
        const root = document.getElementById("raporChartData");
        if (!root) return;

        const parseArray = (raw) => {
            if (!raw) return [];
            try { const data = JSON.parse(raw); return Array.isArray(data) ? data : []; }
            catch { return []; }
        };
        const aylikLabels = parseArray(root.dataset.aylikLabels);
        const aylikData = parseArray(root.dataset.aylikData).map(Number);
        const durumData = parseArray(root.dataset.durumData).map(Number);
        const markaLabels = parseArray(root.dataset.markaLabels);
        const markaData = parseArray(root.dataset.markaData).map(Number);
        const hasAnyPositive = (arr) => arr.some(x => Number(x) > 0);
        const markHasData = (wrapId) => document.getElementById(wrapId)?.classList.add("has-data");
        const markRendered = (wrapId) => document.getElementById(wrapId)?.classList.add("chart-rendered");

        const renderFallback = (wrapId, labels, data) => {
            const wrap = document.getElementById(wrapId);
            if (!wrap) return;
            const max = Math.max(...data, 1);
            const holder = document.createElement("div");
            holder.className = "ys-chart-fallback";
            labels.forEach((label, index) => {
                const value = Number(data[index]) || 0;
                const row = document.createElement("div");
                row.className = "ys-chart-fallback-row";
                const labelEl = document.createElement("span");
                labelEl.textContent = label;
                const bar = document.createElement("span");
                bar.className = "ys-chart-fallback-bar";
                const fill = document.createElement("span");
                fill.className = "ys-chart-fallback-fill";
                fill.style.width = `${Math.max(4, Math.round((value / max) * 100))}%`;
                bar.appendChild(fill);
                const valueEl = document.createElement("strong");
                valueEl.textContent = value;
                row.append(labelEl, bar, valueEl);
                holder.appendChild(row);
            });
            wrap.appendChild(holder);
        };

        const aylikHasData = aylikLabels.length > 0 && hasAnyPositive(aylikData);
        const durumHasData = durumData.length === 3 && hasAnyPositive(durumData);
        const markaHasData = markaLabels.length > 0 && hasAnyPositive(markaData);
        if (aylikHasData) { markHasData("wrapAylik"); renderFallback("wrapAylik", aylikLabels, aylikData); }
        if (durumHasData) { markHasData("wrapDurum"); renderFallback("wrapDurum", ["Tamamlanan", "Bekleyen", "İptal"], durumData); }
        if (markaHasData) { markHasData("wrapMarka"); renderFallback("wrapMarka", markaLabels, markaData); }
        if (typeof Chart === "undefined") return;

        const commonOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { labels: { boxWidth: 9, boxHeight: 9, font: { size: 9 } } } }
        };
        if (aylikHasData) {
            markRendered("wrapAylik");
            new Chart(document.getElementById("aylikChart"), {
                type: "line",
                data: { labels: aylikLabels, datasets: [{ data: aylikData, borderColor: "#1f5fbf", backgroundColor: "rgba(31,95,191,.08)", fill: true, borderWidth: 2, tension: .3, pointRadius: 2 }] },
                options: { ...commonOptions, plugins: { legend: { display: false } }, scales: { x: { ticks: { font: { size: 9 } } }, y: { beginAtZero: true, ticks: { precision: 0, font: { size: 9 } } } } }
            });
        }
        if (durumHasData) {
            markRendered("wrapDurum");
            new Chart(document.getElementById("durumChart"), {
                type: "doughnut",
                data: { labels: ["Tamamlanan", "Bekleyen", "İptal"], datasets: [{ data: durumData, backgroundColor: ["#167a55", "#9a6500", "#b42336"], borderWidth: 0 }] },
                options: { ...commonOptions, cutout: "67%", plugins: { legend: { position: "bottom", labels: { boxWidth: 8, boxHeight: 8, font: { size: 9 } } } } }
            });
        }
        if (markaHasData) {
            markRendered("wrapMarka");
            new Chart(document.getElementById("markaChart"), {
                type: "bar",
                data: { labels: markaLabels, datasets: [{ data: markaData, backgroundColor: "rgba(14,145,189,.72)", borderRadius: 3, borderSkipped: false }] },
                options: { ...commonOptions, plugins: { legend: { display: false } }, scales: { x: { ticks: { font: { size: 9 } } }, y: { beginAtZero: true, ticks: { precision: 0, font: { size: 9 } } } } }
            });
        }
    })();

</script>
}
