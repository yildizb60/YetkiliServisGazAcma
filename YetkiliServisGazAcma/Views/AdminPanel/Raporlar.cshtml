@using System.Globalization
@using YetkiliServisGazAcma.Entities
@{
    var genelSistemAdminMi = ViewBag.GenelSistemAdminMi as bool? ?? false;
    var panelBasligi = "Raporlar";
    ViewData["Title"] = panelBasligi;
    ViewData["PanelTitle"] = panelBasligi;
    ViewData["PanelSubtitle"] = genelSistemAdminMi ? "Genel Sistem Admini" : "Şirket Admini";
    ViewData["ActiveMenu"] = "Raporlar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var sirketler = ViewBag.Sirketler as List<Dag_Sirket> ?? new();
    int? seciliSirketId = ViewBag.SeciliSirketId as int?;
    DateTime basTarih = ViewBag.BasTarih;
    DateTime bitTarih = ViewBag.BitTarih;
    var kapsamAdi = ViewBag.AktifSirketAdi as string ?? "Aktif kapsam";

    var talepSayisi = Convert.ToInt32(ViewBag.OperasyonTalepSayisi ?? 0);
    var tamamlanan = Convert.ToInt32(ViewBag.OperasyonTamamlanan ?? 0);
    var aktif = Convert.ToInt32(ViewBag.OperasyonAktif ?? 0);
    var reddedilen = Convert.ToInt32(ViewBag.OperasyonReddedilen ?? 0);
    var iptal = Convert.ToInt32(ViewBag.OperasyonIptal ?? 0);
    var ortalamaSaat = Convert.ToDouble(ViewBag.OrtalamaTamamlanmaSaati ?? 0, CultureInfo.InvariantCulture);
    var sureKayitSayisi = Convert.ToInt32(ViewBag.TamamlanmaSuresiKayitSayisi ?? 0);
    var ilkKontrolOrani = Convert.ToDouble(ViewBag.IlkKontrolUygunlukOrani ?? 0, CultureInfo.InvariantCulture);
    var ilkKontrolSayisi = Convert.ToInt32(ViewBag.IlkKontrolKayitSayisi ?? 0);
    var tekrarRandevuOrani = Convert.ToDouble(ViewBag.TekrarRandevuOrani ?? 0, CultureInfo.InvariantCulture);
    var kontrolEdilenSayisi = Convert.ToInt32(ViewBag.KontrolEdilenTalepSayisi ?? 0);

    var aylikLabels = ViewBag.OperasyonAylikLabels as List<string> ?? new();
    var aylikData = ViewBag.OperasyonAylikData as List<int> ?? new();
    var firmaLabels = ViewBag.OperasyonFirmaLabels as List<string> ?? new();
    var firmaData = ViewBag.OperasyonFirmaData as List<int> ?? new();
    var lokasyonLabels = ViewBag.OperasyonLokasyonLabels as List<string> ?? new();
    var lokasyonData = ViewBag.OperasyonLokasyonData as List<int> ?? new();
    var ekipLabels = ViewBag.OperasyonEkipLabels as List<string> ?? new();
    var ekipData = ViewBag.OperasyonEkipData as List<int> ?? new();
    var redLabels = ViewBag.OperasyonRedNedeniLabels as List<string> ?? new();
    var redData = ViewBag.OperasyonRedNedeniData as List<int> ?? new();

    var aylikMax = Math.Max(1, aylikData.DefaultIfEmpty(0).Max());
    var firmaMax = Math.Max(1, firmaData.DefaultIfEmpty(0).Max());
    var lokasyonMax = Math.Max(1, lokasyonData.DefaultIfEmpty(0).Max());
    var ekipMax = Math.Max(1, ekipData.DefaultIfEmpty(0).Max());
    var redMax = Math.Max(1, redData.DefaultIfEmpty(0).Max());
    var tamamlanmaOrani = talepSayisi == 0 ? 0 : Math.Round(tamamlanan * 100d / talepSayisi, 1);
    var operasyonVar = talepSayisi > 0;
    var devreyeSayisi = Convert.ToInt32(ViewBag.DevreyeSayisi ?? 0);

    string CssYuzde(double value) => Math.Clamp(value, 0, 100).ToString("0.##", CultureInfo.InvariantCulture);
    string SureMetni(double saat)
    {
        if (sureKayitSayisi == 0) return "-";
        if (saat < 24) return $"{saat:0.#} saat";
        return $"{saat / 24:0.#} gün";
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/admin-reports.css" asp-append-version="true" />
}

<main class="df-admin-report-workspace df-operations-report">
    <section class="df-ops-command" aria-labelledby="opsReportHeading">
        <div class="df-ops-command-copy">
            <span class="df-ops-command-icon" aria-hidden="true"><i class="bi bi-activity"></i></span>
            <div>
                <h1 id="opsReportHeading">Operasyon performansı</h1>
                <p>@kapsamAdi · @basTarih.ToString("dd.MM.yyyy") - @bitTarih.ToString("dd.MM.yyyy")</p>
            </div>
        </div>
        <form method="get" action="@Url.Action("Raporlar", "AdminPanel")" class="df-ops-filter">
            <input type="hidden" name="tip" value="operasyon" />
            <div class="df-admin-field">
                <label for="reportStart">Başlangıç</label>
                <input id="reportStart" type="date" name="bas" value="@basTarih.ToString("yyyy-MM-dd")" />
            </div>
            <div class="df-admin-field">
                <label for="reportEnd">Bitiş</label>
                <input id="reportEnd" type="date" name="bit" value="@bitTarih.ToString("yyyy-MM-dd")" />
            </div>
            @if (genelSistemAdminMi)
            {
                <div class="df-admin-field is-company-filter">
                    <label for="reportCompany">Şirket kapsamı</label>
                    <select id="reportCompany" name="sirketId">
                        <option value="">Tüm şirketler</option>
                        @foreach (var sirket in sirketler)
                        {
                            <option value="@sirket.Id" selected="@(seciliSirketId == sirket.Id ? "selected" : null)">@sirket.SirketAdi</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="df-ops-scope" aria-label="Rapor kapsamı">
                    <span>Rapor kapsamı</span>
                    <strong>@kapsamAdi</strong>
                </div>
            }
            <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Uygula</button>
        </form>
    </section>

    <section class="df-ops-kpis" aria-label="Temel operasyon göstergeleri">
        <article class="df-ops-kpi is-volume">
            <span class="df-ops-kpi-icon"><i class="bi bi-inboxes" aria-hidden="true"></i></span>
            <div><span>Talep sayısı</span><strong>@talepSayisi</strong><small>Seçili tarih aralığı</small></div>
        </article>
        <article class="df-ops-kpi is-duration">
            <span class="df-ops-kpi-icon"><i class="bi bi-stopwatch" aria-hidden="true"></i></span>
            <div><span>Ortalama tamamlanma</span><strong>@SureMetni(ortalamaSaat)</strong><small>@(sureKayitSayisi == 0 ? "Tamamlanan kayıt yok" : $"{sureKayitSayisi} tamamlanan talep")</small></div>
        </article>
        <article class="df-ops-kpi is-compliance">
            <span class="df-ops-kpi-icon"><i class="bi bi-patch-check" aria-hidden="true"></i></span>
            <div><span>İlk kontrolde uygunluk</span><strong>@(ilkKontrolSayisi == 0 ? "-" : $"%{ilkKontrolOrani:0.#}")</strong><small>@(ilkKontrolSayisi == 0 ? "Kontrol sonucu yok" : $"{ilkKontrolSayisi} ilk kontrol")</small></div>
        </article>
        <article class="df-ops-kpi is-repeat">
            <span class="df-ops-kpi-icon"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
            <div><span>Tekrar randevu oranı</span><strong>@(kontrolEdilenSayisi == 0 ? "-" : $"%{tekrarRandevuOrani:0.#}")</strong><small>@(kontrolEdilenSayisi == 0 ? "Kontrol sonucu yok" : $"{kontrolEdilenSayisi} kontrol edilen talep")</small></div>
        </article>
    </section>

    <div class="df-ops-tabs" role="tablist" aria-label="Rapor bölümleri">
        <button type="button" id="opsTabOverview" role="tab" aria-controls="opsPanelOverview" aria-selected="true" tabindex="0"><i class="bi bi-bar-chart" aria-hidden="true"></i> Genel Bakış</button>
        <button type="button" id="opsTabBreakdowns" role="tab" aria-controls="opsPanelBreakdowns" aria-selected="false" tabindex="-1"><i class="bi bi-diagram-3" aria-hidden="true"></i> Kırılımlar</button>
        <button type="button" id="opsTabExports" role="tab" aria-controls="opsPanelExports" aria-selected="false" tabindex="-1"><i class="bi bi-download" aria-hidden="true"></i> Rapor Çıktıları</button>
    </div>

    <section id="opsPanelOverview" class="df-ops-overview" role="tabpanel" aria-labelledby="opsTabOverview">
        <div class="df-ops-monthly">
            <header class="df-ops-section-head">
                <div><h2>Aylık talep hacmi</h2></div>
                <span><i class="bi bi-graph-up" aria-hidden="true"></i> @aylikData.Sum() talep</span>
            </header>
            @if (aylikLabels.Count == 0 || aylikData.Count == 0)
            {
                <div class="df-ops-empty">Aylık talep verisi bulunamadı.</div>
            }
            else
            {
                <div class="df-ops-monthly-chart" role="img" aria-label="Son altı aya ait talep sayıları">
                    @for (var i = 0; i < Math.Min(aylikLabels.Count, aylikData.Count); i++)
                    {
                        var bar = aylikData[i] * 100d / aylikMax;
                        <div class="df-ops-month" title="@aylikLabels[i]: @aylikData[i] talep">
                            <strong>@aylikData[i]</strong>
                            <span class="df-ops-month-track"><i style="--bar:@CssYuzde(bar)%"></i></span>
                            <small>@aylikLabels[i]</small>
                        </div>
                    }
                </div>
            }
        </div>
        <aside class="df-ops-status" aria-labelledby="opsStatusHeading">
            <header class="df-ops-section-head"><div><h2 id="opsStatusHeading">Talep durumu</h2></div></header>
            <div class="df-ops-completion">
                <div class="df-ops-ring" style="--value:@CssYuzde(tamamlanmaOrani)" aria-label="Tamamlanma oranı yüzde @tamamlanmaOrani"><strong>%@tamamlanmaOrani.ToString("0.#")</strong><span>tamamlandı</span></div>
                <dl>
                    <div><dt><i class="is-active"></i> Süreçte</dt><dd>@aktif</dd></div>
                    <div><dt><i class="is-complete"></i> Tamamlanan</dt><dd>@tamamlanan</dd></div>
                    <div><dt><i class="is-rejected"></i> Reddedilen</dt><dd>@reddedilen</dd></div>
                    <div><dt><i class="is-cancelled"></i> İptal</dt><dd>@iptal</dd></div>
                </dl>
            </div>
        </aside>
    </section>

    <section id="opsPanelBreakdowns" class="df-ops-breakdowns" role="tabpanel" aria-labelledby="opsTabBreakdowns" hidden>
        <div class="df-ops-breakdown">
            <header><span><i class="bi bi-buildings" aria-hidden="true"></i></span><div><h2>Firma bazlı talepler</h2></div></header>
            @if (firmaLabels.Count == 0)
            {
                <div class="df-ops-empty is-compact">Firma kırılımı bulunamadı.</div>
            }
            else
            {
                <ol class="df-ops-rank-list">
                    @for (var i = 0; i < Math.Min(firmaLabels.Count, firmaData.Count); i++)
                    {
                        <li><span title="@firmaLabels[i]">@firmaLabels[i]</span><strong>@firmaData[i]</strong><i style="--share:@CssYuzde(firmaData[i] * 100d / firmaMax)%"></i></li>
                    }
                </ol>
            }
        </div>
        <div class="df-ops-breakdown">
            <header><span><i class="bi bi-geo-alt" aria-hidden="true"></i></span><div><h2>İl ve ilçe yoğunluğu</h2></div></header>
            @if (lokasyonLabels.Count == 0)
            {
                <div class="df-ops-empty is-compact">Konum kırılımı bulunamadı.</div>
            }
            else
            {
                <ol class="df-ops-rank-list is-location">
                    @for (var i = 0; i < Math.Min(lokasyonLabels.Count, lokasyonData.Count); i++)
                    {
                        <li><span title="@lokasyonLabels[i]">@lokasyonLabels[i]</span><strong>@lokasyonData[i]</strong><i style="--share:@CssYuzde(lokasyonData[i] * 100d / lokasyonMax)%"></i></li>
                    }
                </ol>
            }
        </div>
        <div class="df-ops-breakdown">
            <header><span><i class="bi bi-people" aria-hidden="true"></i></span><div><h2>Ekip başına iş</h2></div></header>
            @if (ekipLabels.Count == 0)
            {
                <div class="df-ops-empty is-compact">Ekip ataması bulunamadı.</div>
            }
            else
            {
                <ol class="df-ops-rank-list is-team">
                    @for (var i = 0; i < Math.Min(ekipLabels.Count, ekipData.Count); i++)
                    {
                        <li><span title="@ekipLabels[i]">@ekipLabels[i]</span><strong>@ekipData[i]</strong><i style="--share:@CssYuzde(ekipData[i] * 100d / ekipMax)%"></i></li>
                    }
                </ol>
            }
        </div>
        <div class="df-ops-breakdown">
            <header><span><i class="bi bi-clipboard-x" aria-hidden="true"></i></span><div><h2>Reddedilme nedenleri</h2></div></header>
            @if (redLabels.Count == 0)
            {
                <div class="df-ops-empty is-compact">Seçili dönemde reddedilen talep yok.</div>
            }
            else
            {
                <ol class="df-ops-rank-list is-rejection">
                    @for (var i = 0; i < Math.Min(redLabels.Count, redData.Count); i++)
                    {
                        <li><span title="@redLabels[i]">@redLabels[i]</span><strong>@redData[i]</strong><i style="--share:@CssYuzde(redData[i] * 100d / redMax)%"></i></li>
                    }
                </ol>
            }
        </div>
    </section>

    <section id="opsPanelExports" class="df-ops-exports" role="tabpanel" aria-labelledby="opsTabExports" hidden>
        <header>
            <span><i class="bi bi-download" aria-hidden="true"></i></span>
            <div><h2 id="opsExportHeading">Rapor çıktıları</h2></div>
        </header>
        <div class="df-ops-export-row">
            <div><strong>Cihaz değişim operasyonları</strong><small>@talepSayisi kayıt · seçili dönem ve şirket kapsamı</small></div>
            <div class="df-ops-export-actions">
                <a class="df-btn df-btn-sm df-btn-pdf @(!operasyonVar ? "is-disabled" : "")" aria-disabled="@(!operasyonVar ? "true" : "false")" tabindex="@(!operasyonVar ? "-1" : null)" href="@(operasyonVar ? Url.Action("OperasyonRaporPdf", "AdminPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd"), sirketId = seciliSirketId }) : null)"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
                <a class="df-btn df-btn-sm df-btn-excel @(!operasyonVar ? "is-disabled" : "")" aria-disabled="@(!operasyonVar ? "true" : "false")" tabindex="@(!operasyonVar ? "-1" : null)" href="@(operasyonVar ? Url.Action("OperasyonRaporExcel", "AdminPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd"), sirketId = seciliSirketId }) : null)"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
                <a class="df-icon-action" href="/ykc/raporlar?bas=@basTarih.ToString("yyyy-MM-dd")&bit=@bitTarih.ToString("yyyy-MM-dd")" title="Cihaz değişim kayıtlarını aç" aria-label="Cihaz değişim kayıtlarını aç"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            </div>
        </div>
        <div class="df-ops-export-row">
            <div><strong>Cihaz devreye alma kayıtları</strong><small>@devreyeSayisi kayıt · servis işlemleri</small></div>
            <div class="df-ops-export-actions">
                <a class="df-btn df-btn-sm df-btn-pdf @(devreyeSayisi == 0 ? "is-disabled" : "")" aria-disabled="@(devreyeSayisi == 0 ? "true" : "false")" tabindex="@(devreyeSayisi == 0 ? "-1" : null)" href="@(devreyeSayisi > 0 ? Url.Action("RaporlarPdf", "AdminPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd"), sirketId = seciliSirketId }) : null)"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
                <a class="df-btn df-btn-sm df-btn-excel @(devreyeSayisi == 0 ? "is-disabled" : "")" aria-disabled="@(devreyeSayisi == 0 ? "true" : "false")" tabindex="@(devreyeSayisi == 0 ? "-1" : null)" href="@(devreyeSayisi > 0 ? Url.Action("RaporlarExcel", "AdminPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd"), sirketId = seciliSirketId }) : null)"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
                <a class="df-icon-action" href="@Url.Action("DevreyeAlmalar", "AdminPanel")" title="Devreye alma kayıtlarını aç" aria-label="Devreye alma kayıtlarını aç"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            </div>
        </div>
        <div class="df-ops-export-row">
            <div><strong>Yetki belgesi işlemleri</strong><small>Onay, ret ve belge geçmişi</small></div>
            <div class="df-ops-export-actions"><a class="df-btn df-btn-secondary df-btn-sm" href="@Url.Action("OnayBekleyenler", "AdminPanel")"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> Kayıtları Aç</a></div>
        </div>
    </section>
</main>

@section Scripts {
<script>
(() => {
    const tabs = Array.from(document.querySelectorAll('.df-ops-tabs [role="tab"]'));
    const selectTab = (tab, focus = false) => {
        for (const item of tabs) {
            const selected = item === tab;
            item.setAttribute('aria-selected', String(selected));
            item.tabIndex = selected ? 0 : -1;
            document.getElementById(item.getAttribute('aria-controls')).hidden = !selected;
        }
        if (focus) tab.focus();
    };
    for (const tab of tabs) {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', event => {
            if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
            event.preventDefault();
            const index = tabs.indexOf(tab);
            const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1
                : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
            selectTab(tabs[next], true);
        });
    }
})();
</script>
}
