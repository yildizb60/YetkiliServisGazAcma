@{
    ViewData["Title"] = "Operasyon Raporları";
    ViewData["PanelTitle"] = "Operasyon Raporları";
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "Raporlar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var sirketler = ViewBag.Sirketler as List<YetkiliServisGazAcma.Entities.Dag_Sirket>;
    var listeTipi = ViewBag.ListeTipi as string ?? "devreye";
    var raporTipi = ViewBag.RaporTipi as string ?? "devreye";
    var belgeRaporu = listeTipi == "yetkiBelgesi";
    int? seciliSirketId = ViewBag.SeciliSirketId as int?;
    DateTime basTarih = ViewBag.BasTarih;
    DateTime bitTarih = ViewBag.BitTarih;
    var seciliBelgeToplam = raporTipi == "onayli" ? Convert.ToInt32(ViewBag.YetkiBelgesiOnayli)
        : raporTipi == "bekleyen" ? Convert.ToInt32(ViewBag.YetkiBelgesiBekleyen)
        : raporTipi == "reddedilen" ? Convert.ToInt32(ViewBag.YetkiBelgesiReddedilen)
        : 0;
    var raporToplam = belgeRaporu ? seciliBelgeToplam : Convert.ToInt32(ViewBag.DevreyeSayisi ?? 0);
    var raporVar = raporToplam > 0;
    var raporTipiAdi = raporTipi switch
    {
        "onayli" => "Onaylanan Yetki Belgeleri",
        "bekleyen" => "Onay Bekleyen Yetki Belgeleri",
        "reddedilen" => "Reddedilen Yetki Belgeleri",
        _ => "Cihaz Devreye Alma İşlemleri"
    };
    var durumEtiketleriJson = System.Text.Json.JsonSerializer.Serialize(
        belgeRaporu
            ? new[] { "Onaylanan", "Onay Bekleyen", "Reddedilen" }
            : new[] { "Tamamlanan", "Bekleyen", "İptal" });
    var excelUrl = Url.Action("RaporlarExcel", "AdminPanel", new
    {
        bas = basTarih.ToString("yyyy-MM-dd"),
        bit = bitTarih.ToString("yyyy-MM-dd"),
        sirketId = seciliSirketId
    });
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/admin-reports.css" asp-append-version="true" />
}

<div class="df-admin-report-workspace">
    <section class="df-page-panel df-admin-report-filter">
        <form method="get" action="@Url.Action("Raporlar", "AdminPanel")" class="df-admin-report-form">
            <div class="df-admin-report-fields">
                <div class="df-admin-field"><label>Başlangıç</label><input type="date" name="bas" value="@basTarih.ToString("yyyy-MM-dd")" /></div>
                <div class="df-admin-field"><label>Bitiş</label><input type="date" name="bit" value="@bitTarih.ToString("yyyy-MM-dd")" /></div>
                <div class="df-admin-field">
                    <label>Şirket</label>
                    <select name="sirketId">
                        <option value="">Tümü</option>
                        @if (sirketler != null)
                        {
                            foreach (var s in sirketler)
                            {
                                <option value="@s.Id" selected="@(seciliSirketId.HasValue && seciliSirketId.Value == s.Id ? "selected" : null)">@s.SirketAdi</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <fieldset class="df-report-type-control">
                <legend>Rapor Türü</legend>
                <div class="df-report-type-options">
                    <label class="@(raporTipi == "devreye" ? "active" : "")"><input type="radio" name="tip" value="devreye" checked="@(raporTipi == "devreye" ? "checked" : null)" /><i class="bi bi-fire"></i><span>Cihaz Devreye Alma İşlemleri</span></label>
                    <label class="@(raporTipi == "onayli" ? "active" : "")"><input type="radio" name="tip" value="onayli" checked="@(raporTipi == "onayli" ? "checked" : null)" /><i class="bi bi-patch-check"></i><span>Onaylanan Yetki Belgeleri</span></label>
                    <label class="@(raporTipi == "bekleyen" ? "active" : "")"><input type="radio" name="tip" value="bekleyen" checked="@(raporTipi == "bekleyen" ? "checked" : null)" /><i class="bi bi-hourglass-split"></i><span>Onay Bekleyen Yetki Belgeleri</span></label>
                    <label class="@(raporTipi == "reddedilen" ? "active" : "")"><input type="radio" name="tip" value="reddedilen" checked="@(raporTipi == "reddedilen" ? "checked" : null)" /><i class="bi bi-x-circle"></i><span>Reddedilen Yetki Belgeleri</span></label>
                </div>
            </fieldset>
            <div class="df-admin-report-submit"><button class="df-btn df-btn-primary" type="submit"><i class="bi bi-funnel-fill"></i> Filtrele</button></div>
        </form>
    </section>

    <section class="df-report-charts" aria-label="Rapor grafikleri">
        <div class="df-report-chart"><h3>@(belgeRaporu ? "Aylık Yetki Belgesi Trendi" : "Aylık Cihaz Devreye Alma Trendi")</h3><div class="chart-wrap" id="wrapAylik"><div class="chart-empty">Veri bulunamadı</div><canvas id="aylikChart"></canvas></div></div>
        <div class="df-report-chart"><h3>@(belgeRaporu ? "Yetki Belgesi Durumları" : "Devreye Alma Durumları")</h3><div class="chart-wrap" id="wrapDurum"><div class="chart-empty">Veri bulunamadı</div><canvas id="durumChart"></canvas></div></div>
        <div class="df-report-chart"><h3>@(belgeRaporu ? "Şirkete Göre Yetki Belgeleri" : "Şirkete Göre Devreye Almalar")</h3><div class="chart-wrap" id="wrapSirket"><div class="chart-empty">Veri bulunamadı</div><canvas id="sirketChart"></canvas></div></div>
    </section>

    <section class="df-report-output-bar" aria-label="Seçili rapor özeti">
        <div class="df-report-output-icon" aria-hidden="true"><i class="bi @(belgeRaporu ? "bi-file-earmark-check" : "bi-bag-check")"></i></div>
        <div class="df-report-output-copy">
            <span>Seçili rapor</span>
            <strong>@raporTipiAdi</strong>
            <small>@basTarih.ToString("dd.MM.yyyy") - @bitTarih.ToString("dd.MM.yyyy") · @raporToplam kayıt</small>
        </div>
        <div class="df-report-output-actions">
            @if (!belgeRaporu)
            {
                <a class="df-btn df-btn-sm df-btn-pdf @(!raporVar ? "is-disabled" : "")" href="@Url.Action("RaporlarPdf", "AdminPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd"), sirketId = seciliSirketId })" aria-disabled="@(!raporVar ? "true" : "false")" title="Filtrelenen kayıtları PDF olarak indir"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
                <a class="df-btn df-btn-sm df-btn-excel @(!raporVar ? "is-disabled" : "")" href="@excelUrl" aria-disabled="@(!raporVar ? "true" : "false")" title="Filtrelenen kayıtları Excel olarak indir"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
                <a class="df-btn df-btn-sm df-btn-secondary" href="@Url.Action("DevreyeAlmalar", "AdminPanel")"><i class="bi bi-list-ul" aria-hidden="true"></i> Kayıtları Gör</a>
            }
            else
            {
                <a class="df-btn df-btn-sm df-btn-secondary" href="@Url.Action("OnayBekleyenler", "AdminPanel", new { durum = raporTipi })"><i class="bi bi-list-ul" aria-hidden="true"></i> Kayıtları Gör</a>
            }
        </div>
    </section>
</div>

<div id="raporChartData"
     data-aylik-labels='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartAylikLabels ?? new List<string>(), new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))'
     data-aylik-data='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartAylikData ?? new List<int>(), new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))'
     data-durum-data='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartDurumData ?? new List<int>(), new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))'
     data-durum-labels='@Html.Raw(durumEtiketleriJson)'
     data-sirket-labels='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartSirketLabels ?? new List<string>(), new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))'
     data-sirket-data='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartSirketData ?? new List<int>(), new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))'
     style="display:none"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            document.querySelectorAll('.df-report-type-options input[type="radio"]').forEach(function (input) {
                input.addEventListener('change', function () {
                    document.querySelectorAll('.df-report-type-options label').forEach(function (label) {
                        label.classList.toggle('active', label.contains(input));
                    });
                });
            });

            const root = document.getElementById("raporChartData");
            if (!root) return;

            const parseArray = (raw) => {
                if (!raw) return [];
                try {
                    const data = JSON.parse(raw);
                    return Array.isArray(data) ? data : [];
                } catch {
                    return [];
                }
            };

            const aylikLabels = parseArray(root.dataset.aylikLabels);
            const aylikData = parseArray(root.dataset.aylikData).map(Number);
            const durumData = parseArray(root.dataset.durumData).map(Number);
            const durumLabels = parseArray(root.dataset.durumLabels);
            const sirketLabels = parseArray(root.dataset.sirketLabels);
            const sirketData = parseArray(root.dataset.sirketData).map(Number);

            const hasAnyPositive = (arr) => arr.some(x => Number(x) > 0);
            const markHasData = (wrapId) => {
                const wrap = document.getElementById(wrapId);
                if (wrap) wrap.classList.add("has-data");
            };

            if (typeof Chart === "undefined") return;

            if (aylikLabels.length > 0 && hasAnyPositive(aylikData)) {
                markHasData("wrapAylik");
                new Chart(document.getElementById("aylikChart"), {
                    type: "line",
                    data: {
                        labels: aylikLabels,
                        datasets: [{
                            label: "İşlem",
                            data: aylikData,
                            borderColor: "#1B9FD4",
                            backgroundColor: "rgba(27, 159, 212, 0.18)",
                            fill: true,
                            borderWidth: 2,
                            tension: 0.35,
                            pointRadius: 3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }

            if (durumData.length === 3 && hasAnyPositive(durumData)) {
                markHasData("wrapDurum");
                new Chart(document.getElementById("durumChart"), {
                    type: "doughnut",
                    data: {
                        labels: durumLabels,
                        datasets: [{
                            data: durumData,
                            backgroundColor: ["#4CAF7D", "#1B9FD4", "#E24B4A"],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: "bottom" } }
                    }
                });
            }

            if (sirketLabels.length > 0 && hasAnyPositive(sirketData)) {
                markHasData("wrapSirket");
                new Chart(document.getElementById("sirketChart"), {
                    type: "bar",
                    data: {
                        labels: sirketLabels,
                        datasets: [{
                            label: "İşlem",
                            data: sirketData,
                            backgroundColor: "#1B9FD4"
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }
        })();

    </script>
}
