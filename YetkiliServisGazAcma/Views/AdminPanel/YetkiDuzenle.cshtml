@{
    ViewData["Title"] = "Yetki Düzenle";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "Yetkiler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var personel = ViewBag.Personel as YetkiliServisGazAcma.Entities.AppKullanici;
    var sirketler = ViewBag.Sirketler as List<YetkiliServisGazAcma.Entities.Dag_Sirket> ?? new();
    var seciliSirketIds = ViewBag.SeciliSirketIds as List<int> ?? new();
    var yetkiSirketMap = ViewBag.YetkiSirketMap as Dictionary<int, List<string>> ?? new();
    var yetkiGruplari = new[]
    {
        new
        {
            Baslik = "Yakıcı Cihaz Değişim İşlemleri",
            Ikon = "bi-fire",
            Ton = "is-blue",
            Yetkiler = new[]
            {
                new { Kod = "YKC_TALEP_GOR", Ad = "Yakıcı Cihaz Değişim Taleplerini Görüntüle", Ikon = "bi-inboxes" },
                new { Kod = "YKC_ATAMA_YAP", Ad = "Talep İnceleme, Ret/İptal ve Randevu Yönetimi", Ikon = "bi-calendar2-check" },
                new { Kod = "YKC_FR265_IMZA_ISLEM", Ad = "Teknik Kontrol, FR265 ve İmza İşlemleri", Ikon = "bi-pen" },
                new { Kod = "YKC_RAPOR_GOR", Ad = "Yakıcı Cihaz Değişim Raporlarını Görüntüle", Ikon = "bi-bar-chart" }
            }
        },
        new
        {
            Baslik = "Cihaz Devreye Alma ve Yetki Belgeleri",
            Ikon = "bi-file-earmark-check",
            Ton = "is-green",
            Yetkiler = new[]
            {
                new { Kod = "YETKI_BELGESI_ONAY", Ad = "Yetki Belgelerini Onayla veya Reddet", Ikon = "bi-patch-check" },
                new { Kod = "RAPOR_GOR", Ad = "Cihaz Devreye Alma Kayıtlarını ve Raporlarını Görüntüle", Ikon = "bi-file-earmark-bar-graph" }
            }
        },
        new
        {
            Baslik = "Firma ve Marka Yönetimi",
            Ikon = "bi-sliders",
            Ton = "is-cyan",
            Yetkiler = new[]
            {
                new { Kod = "KULLANICI_YONET", Ad = "Yetkili Servisleri Yönet", Ikon = "bi-tools" },
                new { Kod = "MARKA_YONET", Ad = "Markaları Yönet", Ikon = "bi-tags" }
            }
        },
        new
        {
            Baslik = "Gelişmiş",
            Ikon = "bi-stars",
            Ton = "is-full",
            Yetkiler = new[]
            {
                new { Kod = "TAM_YETKI", Ad = "Seçili Şirketin Tüm İşlem Yetkileri", Ikon = "bi-shield-check" }
            }
        }
    };
}

<section class="permission-editor">
    <header class="permission-editor-head">
        <span class="permission-editor-icon"><i class="bi bi-person-lock" aria-hidden="true"></i></span>
        <div>
            <h2>@(personel?.AdSoyad ?? "Personel")</h2>
            <p class="permission-editor-meta">@(personel?.Email ?? "E-posta bilgisi bulunmuyor")</p>
        </div>
    </header>
    <div class="permission-editor-body">
        <form method="post" class="df-permission-editor-form">
            @Html.AntiForgeryToken()
            @if (sirketler.Count > 1)
            {
                <label class="permission-company-picker">
                    <span>Yetkilendirilecek Şirket</span>
                    <select data-permission-company-select aria-label="Yetkileri düzenlenecek şirket">
                        @for (var index = 0; index < sirketler.Count; index++)
                        {
                            <option value="@sirketler[index].Id" selected="@(index == 0 ? "selected" : null)">@sirketler[index].SirketAdi</option>
                        }
                    </select>
                </label>
            }
            <div class="permission-companies" role="region" aria-label="Şirket ve işlem yetkileri" tabindex="0">
            @for (var index = 0; index < sirketler.Count; index++)
            {
                var sirket = sirketler[index];
                var sirketYetkileri = yetkiSirketMap.TryGetValue(sirket.Id, out var tanimliYetkiler)
                    ? tanimliYetkiler
                    : new List<string>();
                var sirketSecili = seciliSirketIds.Contains(sirket.Id) || sirketYetkileri.Count > 0;
                var sirketYetkiDurumu = !sirketSecili
                    ? "Şirket Yetkileri Kapalı"
                    : sirketYetkileri.Contains("TAM_YETKI", StringComparer.OrdinalIgnoreCase)
                        ? "Tüm İşlem Yetkileri Açık"
                        : sirketYetkileri.Count == 0 ? "İşlem Yetkisi Seçilmedi" : sirketYetkileri.Count + " İşlem Yetkisi Seçili";
                <details class="company-permission @(index == 0 ? "is-current" : null)" data-permission-company="@sirket.Id" @(index == 0 ? "open" : null)>
                    <summary>
                        <span class="company-permission-mark"><i class="bi bi-buildings" aria-hidden="true"></i></span>
                        <span class="company-permission-name">@sirket.SirketAdi</span>
                        <span class="company-permission-state">@sirketYetkiDurumu</span>
                        <input type="checkbox" class="company-enable" name="sirketIds" value="@sirket.Id" role="switch" aria-label="@sirket.SirketAdi için işlem yetkilerini etkinleştir" @(sirketSecili ? "checked" : null) />
                        <i class="bi bi-chevron-down company-permission-chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="permission-groups">
                        @foreach (var grup in yetkiGruplari.OrderByDescending(x => x.Yetkiler.Any(y => y.Kod == "TAM_YETKI")))
                        {
                            var tamYetkiGrubu = grup.Yetkiler.Any(y => y.Kod == "TAM_YETKI");
                            <section class="permission-group @grup.Ton @(tamYetkiGrubu ? "permission-group--full" : "")">
                                @if (!tamYetkiGrubu)
                                {
                                    <header class="permission-group-head">
                                        <span><i class="bi @grup.Ikon" aria-hidden="true"></i></span>
                                        <div><h3 class="permission-group-title">@grup.Baslik</h3></div>
                                    </header>
                                }
                                <div class="permission-list">
                                    @foreach (var yetki in grup.Yetkiler)
                                    {
                                        var yetkiSecili = sirketYetkileri.Contains(yetki.Kod, StringComparer.OrdinalIgnoreCase);
                                        var yetkiAciklamasi = yetki.Kod switch
                                        {
                                            "TAM_YETKI" => "Yalnız seçili şirketin işlem yetkilerini açar; şirket veya genel sistem admini rolü vermez.",
                                            "YKC_ATAMA_YAP" => "Talebi incelemeye alma, reddetme, iptal etme, ekip/personel atama ve randevu planlama veya yeniden planlama.",
                                            "YKC_FR265_IMZA_ISLEM" => "Teknik kontrol sonucunu kaydetme, FR265 formu ve ek belgeler, imzaya gönderme ve işlemi tamamlama.",
                                            _ => yetki.Ad
                                        };
                                        <label class="permission-option-wrap" title="@yetkiAciklamasi">
                                            <input type="checkbox" class="permission-option" data-permission="@yetki.Kod" name="yetkiler_@sirket.Id" value="@yetki.Kod" @(yetkiSecili ? "checked" : null) />
                                            <span class="permission-option-icon"><i class="bi @yetki.Ikon" aria-hidden="true"></i></span>
                                            <span class="permission-option-copy">
                                                <span class="permission-option-label">@yetki.Ad</span>
                                                @if (yetki.Kod == "RAPOR_GOR") { <small class="permission-option-description">Kayıt ayrıntıları ve PDF/Excel indirme</small> }
                                            </span>
                                            <span class="permission-option-check" aria-hidden="true"><i class="bi bi-check2"></i></span>
                                        </label>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                </details>
            }
            </div>
            <div class="permission-editor-actions">
                <a class="df-btn df-btn-secondary" href="/AdminPanel/yetkiler"><i class="bi bi-x-lg" aria-hidden="true"></i> Vazgeç</a>
                <button type="submit" class="df-btn df-btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> Yetkileri Kaydet</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
    (function () {
        var companySelect = document.querySelector("[data-permission-company-select]");
        var companies = Array.from(document.querySelectorAll("[data-permission-company]"));
        function showSelectedCompany() {
            if (!companySelect) return;
            companies.forEach(function (company) {
                var current = company.dataset.permissionCompany === companySelect.value;
                company.classList.toggle("is-current", current);
                company.hidden = !current;
                company.open = current;
            });
        }
        if (companySelect) companySelect.addEventListener("change", showSelectedCompany);
        showSelectedCompany();

        document.querySelectorAll(".company-permission").forEach(function (company) {
            var companyToggle = company.querySelector(".company-enable");
            var options = Array.from(company.querySelectorAll(".permission-option"));
            var fullAccess = company.querySelector('[data-permission="TAM_YETKI"]');
            var requestView = company.querySelector('[data-permission="YKC_TALEP_GOR"]');
            var ykcDependent = company.querySelectorAll('[data-permission="YKC_ATAMA_YAP"], [data-permission="YKC_FR265_IMZA_ISLEM"], [data-permission="YKC_RAPOR_GOR"]');

            function refreshSummary() {
                var selectedCount = options.filter(function (option) { return option.checked; }).length;
                company.querySelector(".company-permission-state").textContent = !companyToggle.checked
                    ? "Şirket Yetkileri Kapalı"
                    : fullAccess && fullAccess.checked ? "Tüm İşlem Yetkileri Açık"
                    : selectedCount === 0 ? "İşlem Yetkisi Seçilmedi" : selectedCount + " İşlem Yetkisi Seçili";
            }

            function refreshCompanyState() {
                options.forEach(function (option) { option.disabled = !companyToggle.checked; });
                refreshSummary();
            }

            function syncYkcPermissions(changed) {
                if (!requestView) return;
                if (changed === requestView && !requestView.checked) {
                    ykcDependent.forEach(function (option) { option.checked = false; });
                    return;
                }
                if (Array.from(ykcDependent).some(function (option) { return option.checked; })) requestView.checked = true;
            }

            function syncFullAccess(changed) {
                if (!fullAccess) return;
                if (changed === fullAccess && fullAccess.checked) {
                    options.forEach(function (option) { if (option !== fullAccess) option.checked = false; });
                }
                if (changed !== fullAccess && changed && changed.checked) fullAccess.checked = false;
            }

            companyToggle.addEventListener("change", refreshCompanyState);
            options.forEach(function (option) {
                option.addEventListener("change", function () {
                    syncFullAccess(option);
                    syncYkcPermissions(option);
                    refreshSummary();
                });
            });
            refreshCompanyState();
            syncFullAccess(fullAccess);
            syncYkcPermissions();
            refreshSummary();
        });
    })();
</script>
}
