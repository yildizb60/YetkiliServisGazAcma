@{
    ViewData["Title"] = "Yetki Belgesi Bitiş Uyarıları";
    ViewData["PanelTitle"] = "Yetki Belgesi Bitiş Uyarıları";
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "YetkiBelgesiUyarilari";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var yaklasan = ViewBag.Yaklasan as List<AdminYetkiBelgesiOnayDto> ?? new();
    var gecmis = ViewBag.Gecmis as List<AdminYetkiBelgesiOnayDto> ?? new();
    var yaklasanSayisi = yaklasan.Count(x => x.YetkiBelgesiBitisTarihi.HasValue);
    var gecmisSayisi = gecmis.Count(x => x.YetkiBelgesiBitisTarihi.HasValue);
}

<div class="df-admin-workspace df-warning-workspace">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-title"><i class="bi bi-calendar2-exclamation" aria-hidden="true"></i> Belge özeti</div>
            </div>
            <div class="df-warning-metrics" aria-label="Belge uyarı özeti">
                <div class="df-warning-metric is-soon">
                    <i class="bi bi-hourglass-split"></i>
                    <span>30 gün içinde</span>
                    <strong>@yaklasanSayisi</strong>
                </div>
                <div class="df-warning-metric is-expired">
                    <i class="bi bi-exclamation-octagon"></i>
                    <span>Süresi dolan</span>
                    <strong>@gecmisSayisi</strong>
                </div>
            </div>
        </div>
    </section>

    <section class="df-admin-list-card df-warning-list is-soon">
        <div class="df-service-list-head">
            <div>
                <h3><i class="bi bi-clock-history"></i> 30 Gün İçinde Bitenler</h3>
                <span>Öncelikli yenileme gerektiren @yaklasanSayisi belge</span>
            </div>
            <span class="df-pill df-pill-warning">Yaklaşan</span>
        </div>

        @if (yaklasan.Count == 0)
        {
            <div class="df-admin-empty">Yakın tarihte süresi bitecek belge bulunmuyor.</div>
        }
        else
        {
            <div class="df-admin-table-scroll">
                <table class="df-table">
                    <thead><tr><th>Firma</th><th>Şirket</th><th>Bitiş Tarihi</th><th>Kalan Süre</th></tr></thead>
                    <tbody>
                    @foreach (var s in yaklasan)
                    {
                        int? kalanGun = s.YetkiBelgesiBitisTarihi.HasValue
                            ? (s.YetkiBelgesiBitisTarihi.Value.Date - DateTime.Today).Days : null;
                        <tr class="@(kalanGun <= 7 ? "df-warning-row-critical" : "")">
                            <td><div class="df-cell-main">@(s.FirmaAdi ?? "-")</div></td>
                            <td><div class="df-cell-sub">@(s.SirketAdi ?? "-")</div></td>
                            <td>@(s.YetkiBelgesiBitisTarihi?.ToString("dd.MM.yyyy") ?? "Tanımlı değil")</td>
                            <td>
                                @if (kalanGun.HasValue)
                                {
                                    <span class="df-pill df-pill-warning">@kalanGun gün</span>
                                }
                                else
                                {
                                    <span class="df-cell-sub">Tanımlı değil</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="df-admin-list-card df-warning-list is-expired">
        <div class="df-service-list-head">
            <div>
                <h3><i class="bi bi-calendar-x"></i> Süresi Dolanlar</h3>
                <span>Yenilenmesi gereken @gecmisSayisi belge</span>
            </div>
            <span class="df-pill df-pill-danger">Süresi Doldu</span>
        </div>

        @if (gecmis.Count == 0)
        {
            <div class="df-admin-empty">Süresi dolan yetki belgesi bulunmuyor.</div>
        }
        else
        {
            <div class="df-admin-table-scroll">
                <table class="df-table">
                    <thead><tr><th>Firma</th><th>Şirket</th><th>Bitiş Tarihi</th><th>Durum</th></tr></thead>
                    <tbody>
                    @foreach (var s in gecmis)
                    {
                        <tr>
                            <td><div class="df-cell-main">@(s.FirmaAdi ?? "-")</div></td>
                            <td><div class="df-cell-sub">@(s.SirketAdi ?? "-")</div></td>
                            <td>@(s.YetkiBelgesiBitisTarihi?.ToString("dd.MM.yyyy") ?? "Tanımlı değil")</td>
                            <td>
                                @if (s.YetkiBelgesiBitisTarihi.HasValue)
                                {
                                    <span class="df-pill df-pill-danger">Süresi Doldu</span>
                                }
                                else
                                {
                                    <span class="df-cell-sub">Tanımlı değil</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
