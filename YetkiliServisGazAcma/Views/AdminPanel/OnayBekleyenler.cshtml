@using YetkiliServisGazAcma.Entities
@{
    ViewData["Title"] = "Yetki Belgesi İşlemleri";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "OnayBekleyenler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var bekleyenler = ViewBag.Bekleyenler as List<Ys_YetkiBelgesi> ?? new List<Ys_YetkiBelgesi>();
    var onaylananlar = ViewBag.Onaylananlar as List<Ys_YetkiBelgesi> ?? new List<Ys_YetkiBelgesi>();
    var reddedilenler = ViewBag.Reddedilenler as List<Ys_YetkiBelgesi> ?? new List<Ys_YetkiBelgesi>();
    var suresiDolanlar = ViewBag.SuresiDolanlar as List<Ys_YetkiBelgesi> ?? new List<Ys_YetkiBelgesi>();
    var listelenenBelgeSayisi = bekleyenler.Concat(onaylananlar).Concat(reddedilenler).Concat(suresiDolanlar)
        .Select(x => x.Id).Distinct().Count();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" />
}

<div class="approval-board df-approval-workspace">
    <section class="df-page-panel approval-panels is-admin-approval">
        <div class="df-approval-list-total"><span>Listelenen yetki belgesi</span><strong>@listelenenBelgeSayisi</strong></div>
        <div class="df-approval-status-bar" role="tablist" data-approval-tabs aria-label="Yetki belgesi durumu">
            <button type="button" role="tab" id="admin-approval-waiting-tab" aria-controls="admin-approval-waiting" aria-selected="true" class="approval-tab approval-metric is-waiting active" data-target="bekleyen"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span>Onay Bekleyen</span><strong>@bekleyenler.Count</strong></button>
            <button type="button" role="tab" id="admin-approval-approved-tab" aria-controls="admin-approval-approved" aria-selected="false" class="approval-tab approval-metric is-approved" data-target="onaylanan"><i class="bi bi-check-circle" aria-hidden="true"></i><span>Onaylananlar</span><strong>@onaylananlar.Count</strong></button>
            <button type="button" role="tab" id="admin-approval-rejected-tab" aria-controls="admin-approval-rejected" aria-selected="false" class="approval-tab approval-metric is-rejected" data-target="reddedilen"><i class="bi bi-x-circle" aria-hidden="true"></i><span>Reddedilenler</span><strong>@reddedilenler.Count</strong></button>
            <button type="button" role="tab" id="admin-approval-expired-tab" aria-controls="admin-approval-expired" aria-selected="false" class="approval-tab approval-metric is-expired" data-target="suresi-dolan"><i class="bi bi-calendar-x" aria-hidden="true"></i><span>Süresi Doldu</span><strong>@suresiDolanlar.Count</strong></button>
        </div>
    <details class="df-approval-filter">
        <summary><span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Filtreler</strong></span><span>Aç <i class="bi bi-chevron-down" aria-hidden="true"></i></span></summary>
        <div class="df-approval-filter-body">
        <div class="df-approval-filter-grid">
            <div class="filtre-alan">
                <label for="filterFirma">Firma</label>
                <input type="text" id="filterFirma" placeholder="Firma adı" autocomplete="off" />
            </div>
            <div class="filtre-alan">
                <label for="filterSirket">Şirket</label>
                <input type="text" id="filterSirket" placeholder="Şirket adı" autocomplete="off" />
            </div>
            <div class="filtre-alan">
                <label for="filterYukleme">Belge Yükleme Tarihi</label>
                <input type="date" id="filterYukleme" />
            </div>
            <div class="filtre-alan">
                <label for="filterBaslangic">Geçerlilik Başlangıcı</label>
                <input type="date" id="filterBaslangic" />
            </div>
            <div class="filtre-alan">
                <label for="filterBitis">Yetki Belgesi Bitiş Tarihi</label>
                <input type="date" id="filterBitis" />
            </div>
        </div>
        <div class="df-approval-filter-actions">
            <button type="button" class="df-btn df-btn-primary df-btn-sm" id="approvalFilterApply"><i class="bi bi-funnel-fill" aria-hidden="true"></i> Filtrele</button>
            <button type="button" class="df-btn df-btn-secondary df-btn-sm" id="approvalFilterClear"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</button>
        </div>
        </div>
    </details>

        <div data-panel="bekleyen" class="active" id="admin-approval-waiting" role="tabpanel" aria-labelledby="admin-approval-waiting-tab">
            @await Html.PartialAsync("~/Views/Shared/_YetkiBelgesiOnayTable.cshtml", new Tuple<List<Ys_YetkiBelgesi>, string, string>(bekleyenler, "bekleyen", "admin"))
        </div>
        <div data-panel="onaylanan" id="admin-approval-approved" role="tabpanel" aria-labelledby="admin-approval-approved-tab">
            @await Html.PartialAsync("~/Views/Shared/_YetkiBelgesiOnayTable.cshtml", new Tuple<List<Ys_YetkiBelgesi>, string, string>(onaylananlar, "onaylanan", "admin"))
        </div>
        <div data-panel="reddedilen" id="admin-approval-rejected" role="tabpanel" aria-labelledby="admin-approval-rejected-tab">
            @await Html.PartialAsync("~/Views/Shared/_YetkiBelgesiOnayTable.cshtml", new Tuple<List<Ys_YetkiBelgesi>, string, string>(reddedilenler, "reddedilen", "admin"))
        </div>
        <div data-panel="suresi-dolan" id="admin-approval-expired" role="tabpanel" aria-labelledby="admin-approval-expired-tab">
            @await Html.PartialAsync("~/Views/Shared/_YetkiBelgesiOnayTable.cshtml", new Tuple<List<Ys_YetkiBelgesi>, string, string>(suresiDolanlar, "suresi-dolan", "admin"))
        </div>
    </section>
</div>

@section Scripts {
<script src="~/js/approval-row-details.js" asp-append-version="true"></script>
<script>
(function () {
    var tabs = document.querySelector('[data-approval-tabs]');
    var filterButton = document.getElementById('approvalFilterApply');
    var clearButton = document.getElementById('approvalFilterClear');
    var inputs = {
        firma: document.getElementById('filterFirma'),
        sirket: document.getElementById('filterSirket'),
        yukleme: document.getElementById('filterYukleme'),
        baslangic: document.getElementById('filterBaslangic'),
        bitis: document.getElementById('filterBitis')
    };

    function norm(value) {
        return (value || '').toLocaleLowerCase('tr-TR').trim();
    }

    function activatePanel(target) {
        if (!target) target = 'bekleyen';
        document.querySelectorAll('.approval-panels [data-panel]').forEach(function (panel) {
            panel.classList.toggle('active', panel.getAttribute('data-panel') === target);
        });
        if (tabs) {
            tabs.querySelectorAll('[data-target]').forEach(function (item) {
                var selected = item.getAttribute('data-target') === target;
                item.classList.toggle('active', selected);
                item.setAttribute('aria-selected', selected ? 'true' : 'false');
            });
        }
        applyFilters();
    }

    function applyFilters() {
        var activePanel = document.querySelector('.approval-panels [data-panel].active');
        if (!activePanel) return;

        var filters = {
            firma: norm(inputs.firma && inputs.firma.value),
            sirket: norm(inputs.sirket && inputs.sirket.value),
            yukleme: inputs.yukleme ? inputs.yukleme.value : '',
            baslangic: inputs.baslangic ? inputs.baslangic.value : '',
            bitis: inputs.bitis ? inputs.bitis.value : ''
        };

        var visibleCount = 0;
        var rows = activePanel.querySelectorAll('tr[data-approval-row="true"]');
        rows.forEach(function (row) {
            var visible = true;
            if (filters.firma) visible = visible && (norm(row.dataset.firma).indexOf(filters.firma) > -1 || norm(row.dataset.vergi).indexOf(filters.firma) > -1);
            if (filters.sirket) visible = visible && norm(row.dataset.sirket).indexOf(filters.sirket) > -1;
            if (filters.yukleme) visible = visible && row.dataset.yukleme === filters.yukleme;
            if (filters.baslangic) visible = visible && row.dataset.baslangic >= filters.baslangic;
            if (filters.bitis) visible = visible && row.dataset.bitis <= filters.bitis;
            row.hidden = !visible;
            var detail = row.nextElementSibling;
            if (detail?.matches('[data-approval-detail]')) detail.hidden = !visible || !row.classList.contains('is-expanded');
            if (visible) visibleCount++;
        });
        var empty = activePanel.querySelector('.df-approval-filter-empty');
        if (empty) empty.hidden = rows.length === 0 || visibleCount > 0;
    }

    if (tabs) {
        tabs.addEventListener('click', function (event) {
            var btn = event.target.closest('[data-target]');
            if (btn) activatePanel(btn.getAttribute('data-target'));
        });
    }
    if (filterButton) filterButton.addEventListener('click', applyFilters);
    if (clearButton) {
        clearButton.addEventListener('click', function () {
            Object.keys(inputs).forEach(function (key) {
                if (inputs[key]) inputs[key].value = '';
            });
            activatePanel(document.querySelector('.approval-tab.active')?.getAttribute('data-target') || 'bekleyen');
        });
    }
    var requestedStatus = new URLSearchParams(window.location.search).get('durum');
    var statusMap = { onayli: 'onaylanan', bekleyen: 'bekleyen', reddedilen: 'reddedilen', 'suresi-dolan': 'suresi-dolan' };
    activatePanel(statusMap[requestedStatus] || 'bekleyen');
})();
</script>
}
