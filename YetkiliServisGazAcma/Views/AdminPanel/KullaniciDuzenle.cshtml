@using YetkiliServisGazAcma.Entities
@{
    var hedef = ViewBag.Hedef as AppKullanici;
    var sirketler = ViewBag.Sirketler as List<Dag_Sirket> ?? new();
    var firmalar = ViewBag.Firmalar as List<Ys_Firma> ?? new();
    var returnUrl = ViewBag.ReturnUrl as string ?? "/AdminPanel/kullanicilar";
    var hedefTip = hedef?.KullaniciTipi ?? 0;
    var sirketAlaniGoster = hedefTip == KullaniciTipiDegerleri.SirketAdmin || hedefTip == KullaniciTipiDegerleri.Personel;
    var firmaAlaniGoster = hedefTip == KullaniciTipiDegerleri.YetkiliServis || hedefTip == KullaniciTipiDegerleri.SertifikaliFirma;
    var rolMetni = hedefTip == KullaniciTipiDegerleri.GenelSistemAdmin
        ? "Genel Sistem Admini"
        : hedefTip == KullaniciTipiDegerleri.SirketAdmin
            ? "Şirket Admini"
            : hedefTip == KullaniciTipiDegerleri.Personel
                ? "Personel"
                : hedefTip == KullaniciTipiDegerleri.YetkiliServis
                    ? "Yetkili Servis"
                    : hedefTip == KullaniciTipiDegerleri.SertifikaliFirma
                        ? "Sertifikalı Firma"
                        : "Kullanıcı";
    var sayfaBasligi = hedefTip == KullaniciTipiDegerleri.Personel
        ? "Personel Düzenle"
        : hedefTip == KullaniciTipiDegerleri.SirketAdmin
            ? "Şirket Yöneticisi Düzenle"
            : hedefTip == KullaniciTipiDegerleri.YetkiliServis
                ? "Yetkili Servis Kullanıcısını Düzenle"
                : hedefTip == KullaniciTipiDegerleri.SertifikaliFirma
                    ? "Sertifikalı Firma Kullanıcısını Düzenle"
                    : hedefTip == KullaniciTipiDegerleri.GenelSistemAdmin
                        ? "Sistem Yöneticisi Düzenle"
                        : "Kullanıcı Düzenle";
    var baglantiMetni = firmaAlaniGoster
        ? hedef?.Firma?.FirmaAdi
        : sirketAlaniGoster
            ? hedef?.Sirket?.SirketAdi
            : "Sistem geneli";

    ViewData["Title"] = sayfaBasligi;
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = hedefTip == KullaniciTipiDegerleri.Personel ? "Personeller" : "Kullanicilar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}

<div class="df-admin-workspace df-admin-editor df-user-edit-workspace">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-person-gear"></i> @rolMetni hesabı</div>
                <div class="df-panel-title">@sayfaBasligi</div>
                <div class="df-panel-subtitle">@(hedef?.AdSoyad ?? "-") · @(hedef?.Email ?? "-")</div>
            </div>
            <a class="df-btn df-btn-secondary df-btn-sm" href="@returnUrl"><i class="bi bi-arrow-left"></i> Listeye Dön</a>
        </div>
    </section>

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            @if (ViewBag.Hata != null)
            {
                <div class="df-alert df-alert-danger">@ViewBag.Hata</div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-person-vcard"></i></span>
                        <div>
                            <h3>Kimlik ve İletişim</h3>
                            <p>Kullanıcının görünen adı, iletişim bilgileri ve hesap durumunu güncelleyin.</p>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-half">
                            <label>Ad Soyad *</label>
                            <input name="adSoyad" value="@(hedef?.AdSoyad ?? "")" autocomplete="name" required />
                        </div>
                        <div class="df-admin-field is-half">
                            <label>E-Posta *</label>
                            <input type="email" name="email" value="@(hedef?.Email ?? "")" autocomplete="email" required />
                        </div>
                        <div class="df-admin-field is-half">
                            <label>Telefon</label>
                            <input name="telefon" value="@(hedef?.PhoneNumber ?? "")" autocomplete="tel" />
                        </div>
                        <div class="df-admin-field is-half">
                            <label>Hesap Durumu</label>
                            <select name="aktifMi">
                                @if (hedef?.AktifMi == true)
                                {
                                    <option value="true" selected="selected">Aktif</option>
                                    <option value="false">Pasif</option>
                                }
                                else
                                {
                                    <option value="true">Aktif</option>
                                    <option value="false" selected="selected">Pasif</option>
                                }
                            </select>
                        </div>
                    </div>
                </section>

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-diagram-3"></i></span>
                        <div>
                            <h3>Rol ve Kurumsal Bağlantı</h3>
                            <p>Rol bilgi amaçlı gösterilir; kullanıcının bağlı olduğu şirket veya firma güncellenebilir.</p>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-half">
                            <label>Kullanıcı Rolü</label>
                            <div class="df-admin-readonly-value">
                                <i class="bi bi-shield-check"></i>
                                <span>@rolMetni</span>
                            </div>
                        </div>
                        @if (sirketAlaniGoster)
                        {
                            <div class="df-admin-field is-half">
                                <label>@(hedefTip == KullaniciTipiDegerleri.SirketAdmin ? "Yönetilen Şirket *" : "Çalıştığı Şirket *")</label>
                                <select name="sirketId" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var sirket in sirketler)
                                    {
                                        if (hedef?.SirketId == sirket.Id)
                                        {
                                            <option value="@sirket.Id" selected="selected">@sirket.SirketAdi</option>
                                        }
                                        else
                                        {
                                            <option value="@sirket.Id">@sirket.SirketAdi</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        else if (firmaAlaniGoster)
                        {
                            <div class="df-admin-field is-half">
                                <label>Bağlı Firma *</label>
                                <select name="firmaId" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var firma in firmalar)
                                    {
                                        var firmaEtiketi = firma.Sirket != null ? $"{firma.FirmaAdi} ({firma.Sirket.SirketAdi})" : firma.FirmaAdi;
                                        if (hedef?.FirmaId == firma.Id)
                                        {
                                            <option value="@firma.Id" selected="selected">@firmaEtiketi</option>
                                        }
                                        else
                                        {
                                            <option value="@firma.Id">@firmaEtiketi</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="df-admin-field is-half">
                                <label>Kapsam</label>
                                <div class="df-admin-readonly-value"><i class="bi bi-globe2"></i><span>@baglantiMetni</span></div>
                            </div>
                        }
                    </div>
                </section>

                <details class="df-admin-password-panel">
                    <summary>
                        <span><i class="bi bi-key"></i><span><strong>Şifreyi Değiştir</strong><small>Mevcut şifre korunacaksa bu alanı açmanız gerekmez.</small></span></span>
                        <i class="bi bi-chevron-down"></i>
                    </summary>
                    <div class="df-admin-password-body">
                        <div class="df-admin-form-grid">
                            <div class="df-admin-field is-half">
                                <label>Yeni Şifre</label>
                                <input type="password" name="yeniSifre" autocomplete="new-password" />
                            </div>
                            <div class="df-admin-field is-half">
                                <label>Yeni Şifre Tekrar</label>
                                <input type="password" name="yeniSifreTekrar" autocomplete="new-password" />
                            </div>
                        </div>
                        <small class="df-admin-field-note">İki alan da doldurulmalı ve şifreler aynı olmalıdır.</small>
                    </div>
                </details>

                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="@returnUrl"><i class="bi bi-x-lg"></i> Vazgeç</a>
                    <button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2"></i> Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </section>
</div>
