@using YetkiliServisGazAcma.Entities
@{
    ViewData["Title"] = "Personeller";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "Personeller";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var personeller = ViewBag.Personeller as List<AppKullanici> ?? new List<AppKullanici>();
    var seciliQ = ViewBag.SeciliQ as string ?? string.Empty;
    var seciliSirket = ViewBag.SeciliSirket as string ?? string.Empty;
    var seciliDurum = ViewBag.SeciliDurum as string ?? string.Empty;
    var filtreAktif = !string.IsNullOrWhiteSpace(seciliQ)
        || !string.IsNullOrWhiteSpace(seciliSirket)
        || !string.IsNullOrWhiteSpace(seciliDurum);
    var aktifSayisi = personeller.Count(x => x.AktifMi);
    var pasifSayisi = personeller.Count - aktifSayisi;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/admin-directory.css" asp-append-version="true" />
}

<div class="df-user-directory df-person-directory">
    <div class="df-user-directory-bar">
        <div class="df-user-summary" aria-label="Personel durum özeti">
            <div><span>Toplam Personel</span><strong>@personeller.Count</strong></div>
            <div><span>Aktif Personel</span><strong>@aktifSayisi</strong></div>
            <div><span>Pasif Personel</span><strong>@pasifSayisi</strong></div>
        </div>
        <a class="df-btn df-btn-primary df-btn-sm js-admin-form-sheet-trigger"
           href="@Url.Action("PersonelEkle", "AdminPanel")"
           data-sheet-url="@Url.Action("PersonelEkle", "AdminPanel")"
           data-sheet-title="Yeni Personel">
            <i class="bi bi-person-plus" aria-hidden="true"></i> Yeni Personel
        </a>
    </div>

    <details class="df-user-filter" open="@(filtreAktif ? "open" : null)">
        <summary><span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Filtreler</strong></span><span>@(filtreAktif ? "Filtre uygulandı" : "Aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span></summary>
        <form method="get" action="@Url.Action("Personeller", "AdminPanel")">
            <div class="df-user-filter-grid df-person-filter-grid">
                <div class="filter-group"><label for="personSearch">Arama</label><input id="personSearch" type="search" name="q" value="@seciliQ" placeholder="Ad soyad, e-posta veya telefon" /></div>
                <div class="filter-group"><label for="personCompany">Dağıtım Şirketi</label><input id="personCompany" type="text" name="sirket" value="@seciliSirket" placeholder="Şirket adı" /></div>
                <div class="filter-group"><label for="personStatus">Durum</label><select id="personStatus" name="durum"><option value="" selected="@(string.IsNullOrEmpty(seciliDurum) ? "selected" : null)">Tümü</option><option value="Aktif" selected="@(seciliDurum == "Aktif" ? "selected" : null)">Aktif</option><option value="Pasif" selected="@(seciliDurum == "Pasif" ? "selected" : null)">Pasif</option></select></div>
            </div>
            <div class="df-user-filter-actions">
                <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-funnel-fill" aria-hidden="true"></i> Filtrele</button>
                <a class="df-btn df-btn-secondary df-btn-sm" href="@Url.Action("Personeller", "AdminPanel")"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
            </div>
        </form>
    </details>

    <section class="df-user-list">
        <div class="df-user-table-scroll">
            <div class="df-user-grid df-person-grid df-user-grid-head">
                <div>Personel</div><div>İletişim</div><div>Dağıtım Şirketi</div><div>Durum</div><div>İşlemler</div>
            </div>
            @if (personeller.Count == 0)
            {
                <div class="df-empty"><div class="df-empty-title">Personel kaydı bulunamadı.</div><p class="df-empty-text">Filtreleri temizleyip yeniden deneyin.</p></div>
            }
            else
            {
                foreach (var personel in personeller)
                {
                    var adParcalari = (personel.AdSoyad ?? "?")
                        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Take(2)
                        .Select(x => char.ToUpperInvariant(x[0]));
                    var basHarfler = string.Concat(adParcalari);
                    <div class="df-user-grid df-person-grid df-user-row">
                        <div class="df-user-identity"><span class="df-user-avatar">@basHarfler</span><strong>@(personel.AdSoyad ?? "-")</strong></div>
                        <div class="df-person-contact"><span>@(personel.Email ?? "-")</span>@if (!string.IsNullOrWhiteSpace(personel.PhoneNumber)){<small>@personel.PhoneNumber</small>}</div>
                        <div class="df-person-company"><strong>@(personel.Sirket?.SirketAdi ?? "-")</strong>@if (!string.IsNullOrWhiteSpace(personel.Sirket?.Il)){<small>@personel.Sirket.Il</small>}</div>
                        <div><span class="df-pill @(personel.AktifMi ? "df-pill-success" : "df-pill-danger")">@(personel.AktifMi ? "Aktif" : "Pasif")</span></div>
                        <div class="df-user-actions">
                            <a class="df-icon-action js-admin-form-sheet-trigger"
                               href="@Url.Action("KullaniciDuzenle", "AdminPanel", new { id = personel.Id, returnUrl = Url.Action("Personeller", "AdminPanel") })"
                               data-sheet-url="@Url.Action("KullaniciDuzenle", "AdminPanel", new { id = personel.Id, returnUrl = Url.Action("Personeller", "AdminPanel") })"
                               data-sheet-title="Personeli Düzenle"
                               title="Personeli düzenle"
                               aria-label="@personel.AdSoyad personelini düzenle"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            <form method="post" action="@Url.Action("PersonelDurum", "AdminPanel", new { id = personel.Id })">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="aktif" value="@(personel.AktifMi ? "false" : "true")" />
                                <button type="submit" class="df-icon-action @(personel.AktifMi ? "is-warning" : "is-success")" title="@(personel.AktifMi ? "Personeli pasifleştir" : "Personeli aktifleştir")" aria-label="@personel.AdSoyad personelini @(personel.AktifMi ? "pasifleştir" : "aktifleştir")"><i class="bi @(personel.AktifMi ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button>
                            </form>
                            <form method="post" action="@Url.Action("PersonelSil", "AdminPanel", new { id = personel.Id })" onsubmit="return confirm('Personeli silmek istediğinize emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="df-icon-action is-danger" title="Personeli sil" aria-label="@personel.AdSoyad personelini sil"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </section>
</div>

@await Html.PartialAsync("_AdminFormDrawer")

@section Scripts {
    <script src="~/js/admin-form-drawer.js" asp-append-version="true"></script>
}
