@using YetkiliServisGazAcma.Entities
@{
    ViewData["Title"] = "Yetkili Servisler";
    ViewData["PanelTitle"] = "Yetkili Servisler";
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "YetkiliServisler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var servisler = ViewBag.YetkiliServisler as List<Ys_Firma> ?? new List<Ys_Firma>();
    var sehirler = ViewBag.Sehirler as List<string> ?? new List<string>();
    var seciliQ = ViewBag.SeciliQ as string ?? "";
    var seciliIl = ViewBag.SeciliIl as string ?? "";
    var seciliDurum = ViewBag.SeciliDurum is int d ? d : (int?)null;
    var seciliDevreyeSiralama = ViewBag.SeciliDevreyeSiralama as string ?? "";
    var filtreAktif = !string.IsNullOrWhiteSpace(seciliQ)
        || !string.IsNullOrWhiteSpace(seciliIl)
        || seciliDurum.HasValue
        || !string.IsNullOrWhiteSpace(seciliDevreyeSiralama);
    ViewData["ServiceDirectoryAdmin"] = true;
    ViewData["ServiceDirectoryCanManage"] = true;
}

<div class="df-service-directory df-service-directory--detailed">
    <details class="df-service-filter" open="@(filtreAktif ? "open" : null)">
        <summary>
            <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Filtreler</strong></span>
            <span>@(filtreAktif ? "Filtre uygulandı" : "Aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <form method="get" action="/AdminPanel/yetkiliservisler">
            <div class="df-service-filter-grid">
                <div class="filtre-alan">
                    <label for="admin-servis-q">Firma / Yetkili</label>
                    <input id="admin-servis-q" type="text" name="q" value="@seciliQ" placeholder="Firma, yetkili, VKN veya telefon..." />
                </div>
                <div class="filtre-alan">
                    <label for="admin-servis-il">İl</label>
                    <select id="admin-servis-il" name="il">
                        <option value="">Tümü</option>
                        @foreach (var sehir in sehirler)
                        {
                            <option value="@sehir" selected="@(seciliIl == sehir ? "selected" : null)">@sehir</option>
                        }
                    </select>
                </div>
                <div class="filtre-alan">
                    <label for="admin-servis-devreye-siralama">Cihaz Devreye Alma Kaydı</label>
                    <select id="admin-servis-devreye-siralama" name="devreyeSiralama">
                        <option value="">Varsayılan</option>
                        <option value="azalan" selected="@(seciliDevreyeSiralama == "azalan" ? "selected" : null)">En çoktan aza</option>
                        <option value="artan" selected="@(seciliDevreyeSiralama == "artan" ? "selected" : null)">En azdan çoğa</option>
                    </select>
                </div>
                <div class="filtre-alan">
                    <label for="admin-servis-durum">Durum</label>
                    <select id="admin-servis-durum" name="durum">
                        <option value="" selected="@(seciliDurum == null ? "selected" : null)">Tümü</option>
                        <option value="1" selected="@(seciliDurum == 1 ? "selected" : null)">Aktif</option>
                        <option value="0" selected="@(seciliDurum == 0 ? "selected" : null)">Pasif</option>
                    </select>
                </div>
            </div>
            <div class="df-service-filter-actions">
                <a class="df-btn df-btn-secondary df-btn-sm" href="/AdminPanel/yetkiliservisler"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
                <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-funnel-fill" aria-hidden="true"></i> Filtrele</button>
            </div>
        </form>
    </details>

    <section class="df-service-list df-service-list-modern">
        <div class="df-service-list-head">
            <div>
                <h3><i class="bi bi-buildings" aria-hidden="true"></i> Servis Kayıtları</h3>
            </div>
            <div class="df-actions">
                <span class="df-pill df-pill-info">@servisler.Count kayıt</span>
                <a class="df-btn df-btn-secondary df-btn-sm" href="/yetkili-servisler" target="_blank"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Genel Liste</a>
                <a class="df-btn df-btn-primary df-btn-sm js-service-sheet-trigger"
                   href="/AdminPanel/yetkiliservisler/ekle"
                   data-sheet-url="/AdminPanel/yetkiliservisler/ekle"
                   data-sheet-title="Yeni Yetkili Servis">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Servis
                </a>
            </div>
        </div>
        <partial name="_YetkiliServisKayitlari" model="servisler" />
    </section>
</div>

<dialog class="df-directory-sheet df-admin-service-sheet" data-service-sheet aria-labelledby="serviceSheetTitle">
    <div class="df-directory-sheet-frame">
        <header class="df-directory-sheet-head">
            <div>
                <h2 id="serviceSheetTitle" data-service-sheet-title>Yetkili Servis</h2>
            </div>
            <button type="button" class="df-directory-sheet-close" data-service-sheet-close title="Paneli kapat" aria-label="Paneli kapat">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </header>
        <div class="df-directory-sheet-body" data-service-sheet-body>
            <div class="df-directory-sheet-loading" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Form hazırlanıyor</span>
            </div>
        </div>
    </div>
</dialog>

@section Scripts {
<script>
    (function () {
        var records = Array.prototype.slice.call(document.querySelectorAll("[data-service-record]"));
        var sheet = document.querySelector("[data-service-sheet]");
        var sheetTitle = document.querySelector("[data-service-sheet-title]");
        var sheetBody = document.querySelector("[data-service-sheet-body]");
        var closeButton = document.querySelector("[data-service-sheet-close]");
        var activeRequest = 0;
        var closeTimer = 0;

        function closeRecord(record) {
            var toggle = record.querySelector("[data-service-expand]");
            var detail = record.querySelector(".df-service-record-detail");
            record.classList.remove("is-expanded");
            toggle.setAttribute("aria-expanded", "false");
            toggle.setAttribute("title", "Satır ayrıntılarını aç");
            toggle.querySelector(".visually-hidden").textContent = "Satır ayrıntılarını aç";
            detail.setAttribute("aria-hidden", "true");
            detail.hidden = true;
        }

        records.forEach(function (record) {
            var toggle = record.querySelector("[data-service-expand]");
            toggle.addEventListener("click", function () {
                var willOpen = !record.classList.contains("is-expanded");
                records.forEach(function (item) {
                    if (item !== record) closeRecord(item);
                });

                if (!willOpen) {
                    closeRecord(record);
                    return;
                }

                record.classList.add("is-expanded");
                toggle.setAttribute("aria-expanded", "true");
                toggle.setAttribute("title", "Satır ayrıntılarını kapat");
                toggle.querySelector(".visually-hidden").textContent = "Satır ayrıntılarını kapat";
                var detail = record.querySelector(".df-service-record-detail");
                detail.hidden = false;
                detail.setAttribute("aria-hidden", "false");
            });
        });

        var query = new URLSearchParams(window.location.search);
        var selectedId = query.get("servis");
        var selectedRecord = records.find(function (record) {
            return record.getAttribute("data-service-id") === selectedId;
        });
        if (selectedRecord) {
            selectedRecord.querySelector("[data-service-expand]").click();
            window.requestAnimationFrame(function () {
                selectedRecord.scrollIntoView({ block: "nearest" });
            });
            query.delete("servis");
            var cleanUrl = window.location.pathname + (query.toString() ? "?" + query.toString() : "") + window.location.hash;
            window.history.replaceState(null, "", cleanUrl);
        }

        function closeSheet() {
            if (!sheet || !sheet.open) return;
            activeRequest += 1;
            sheet.classList.remove("is-visible");
            document.documentElement.classList.remove("df-sheet-open");
            window.clearTimeout(closeTimer);
            closeTimer = window.setTimeout(function () {
                closeTimer = 0;
                if (sheet.open) sheet.close();
                sheetBody.replaceChildren();
            }, 180);
        }

        function initializeServiceForm(container) {
            var sehirSelect = container.querySelector("[data-firma-kodu-select]");
            var firmaTarget = container.querySelector("[data-firma-kodu-target]");
            var search = container.querySelector("#markaSearch");
            var list = container.querySelector("#markaList");
            var selectAll = container.querySelector("#markaSelectAll");

            function firmaKoduGuncelle() {
                if (!sehirSelect || !firmaTarget) return;
                var option = sehirSelect.options[sehirSelect.selectedIndex];
                var firmaKodu = option ? option.getAttribute("data-firma-kodu") : "";
                firmaTarget.textContent = firmaKodu ? "Bağlı firma kodu: " + firmaKodu : "";
                firmaTarget.classList.toggle("is-visible", !!firmaKodu);
            }

            if (sehirSelect) {
                sehirSelect.addEventListener("change", firmaKoduGuncelle);
                firmaKoduGuncelle();
            }

            if (search && list) {
                search.addEventListener("input", function () {
                    var query = search.value.toLocaleLowerCase("tr-TR");
                    list.querySelectorAll(".marka-item").forEach(function (item) {
                        var name = (item.getAttribute("data-name") || "").toLocaleLowerCase("tr-TR");
                        item.style.display = name.indexOf(query) >= 0 ? "flex" : "none";
                    });
                });
            }

            if (selectAll && list) {
                selectAll.addEventListener("change", function () {
                    list.querySelectorAll(".marka-item input[type='checkbox']").forEach(function (checkbox) {
                        checkbox.checked = selectAll.checked;
                    });
                });
            }

            var firstField = container.querySelector("input:not([type='hidden']), select");
            if (firstField) firstField.focus();
        }

        async function openSheet(trigger) {
            if (!sheet || !sheetBody) return;
            window.clearTimeout(closeTimer);
            closeTimer = 0;
            var requestId = ++activeRequest;
            var url = trigger.getAttribute("data-sheet-url") || trigger.getAttribute("href");
            sheetTitle.textContent = trigger.getAttribute("data-sheet-title") || "Yetkili Servis";
            sheetBody.innerHTML = '<div class="df-directory-sheet-loading" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Form hazırlanıyor</span></div>';

            if (!sheet.open) sheet.showModal();
            document.documentElement.classList.add("df-sheet-open");
            window.requestAnimationFrame(function () { sheet.classList.add("is-visible"); });

            try {
                var response = await fetch(url, {
                    credentials: "same-origin",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) throw new Error("Form alınamadı");

                var html = await response.text();
                if (requestId !== activeRequest) return;
                var parsed = new DOMParser().parseFromString(html, "text/html");
                var sourceForm = parsed.querySelector(".df-admin-form-body form");
                if (!sourceForm) throw new Error("Form bulunamadı");

                var form = document.importNode(sourceForm, true);
                form.classList.add("df-directory-sheet-form");
                sheetBody.replaceChildren(form);
                initializeServiceForm(sheetBody);
            } catch (error) {
                if (requestId !== activeRequest) return;
                sheetBody.innerHTML = '<div class="df-directory-sheet-error"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><strong>Form açılamadı.</strong><p>İşleme normal sayfada devam edebilirsiniz.</p></div>';
                var fallback = document.createElement("a");
                fallback.className = "df-btn df-btn-primary df-btn-sm";
                fallback.href = url;
                fallback.innerHTML = '<i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Sayfada aç';
                sheetBody.querySelector(".df-directory-sheet-error").appendChild(fallback);
            }
        }

        document.querySelectorAll(".js-service-sheet-trigger").forEach(function (trigger) {
            trigger.addEventListener("click", function (event) {
                event.preventDefault();
                openSheet(trigger);
            });
        });

        sheetBody.addEventListener("click", function (event) {
            var cancelLink = event.target.closest('a[href="/AdminPanel/yetkiliservisler"]');
            if (!cancelLink) return;
            event.preventDefault();
            closeSheet();
        });

        closeButton.addEventListener("click", closeSheet);
        sheet.addEventListener("cancel", function (event) {
            event.preventDefault();
            closeSheet();
        });
    })();
</script>
}
