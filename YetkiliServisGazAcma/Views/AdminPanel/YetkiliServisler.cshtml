@using YetkiliServisGazAcma.Entities
@{
    ViewData["Title"] = "Yetkili Servisler";
    ViewData["PanelTitle"] = "Yetkili Servisler";
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "YetkiliServisler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var servisler = ViewBag.YetkiliServisler as List<Ys_Firma> ?? new List<Ys_Firma>();
    var sehirler = ViewBag.Sehirler as List<string> ?? new List<string>();
    var devreyeSayilari = ViewBag.DevreyeSayilari as Dictionary<int, int> ?? new Dictionary<int, int>();
    var seciliQ = ViewBag.SeciliQ as string ?? "";
    var seciliIl = ViewBag.SeciliIl as string ?? "";
    var seciliDurum = ViewBag.SeciliDurum is int d ? d : (int?)null;
    var seciliDevreyeSiralama = ViewBag.SeciliDevreyeSiralama as string ?? "";
    var filtreAktif = !string.IsNullOrWhiteSpace(seciliQ)
        || !string.IsNullOrWhiteSpace(seciliIl)
        || seciliDurum.HasValue
        || !string.IsNullOrWhiteSpace(seciliDevreyeSiralama);
}

<div class="df-service-directory">
    <section class="df-page-panel df-service-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-building-check" aria-hidden="true"></i> SERVİS YÖNETİMİ</div>
                <h2 class="df-panel-title">Yetkili Servisler</h2>
                <div class="df-panel-subtitle">Servisleri, faaliyet illerini ve devreye alma durumlarını tek listeden yönetin.</div>
            </div>
            <div class="df-actions">
                <a class="df-btn df-btn-secondary df-btn-sm" href="/yetkili-servisler" target="_blank"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Genel Liste</a>
                <a class="df-btn df-btn-primary df-btn-sm" href="/AdminPanel/yetkiliservisler/ekle"><i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Servis</a>
            </div>
        </div>
    </section>

    @if (TempData["Basarili"] != null) { <div class="df-alert df-alert-success">@TempData["Basarili"]</div> }
    @if (TempData["Hata"] != null) { <div class="df-alert df-alert-danger">@TempData["Hata"]</div> }

    <details class="df-service-filter" open="@(filtreAktif ? "open" : null)">
        <summary>
            <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Filtreler</strong><small>Firma, şehir, durum veya işlem sayısına göre listeyi daraltın.</small></span>
            <span>@(filtreAktif ? "Filtre uygulandı" : "Aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <form method="get" action="/AdminPanel/yetkiliservisler">
            <div class="df-service-filter-grid">
                <div class="filtre-alan">
                    <label>Firma / Yetkili</label>
                    <input type="text" name="q" value="@seciliQ" placeholder="Firma, yetkili, VKN veya telefon..." />
                </div>
                <div class="filtre-alan">
                    <label>Şehir</label>
                    <select name="il">
                        <option value="">Tümü</option>
                        @foreach (var sehir in sehirler)
                        {
                            <option value="@sehir" selected="@(seciliIl == sehir ? "selected" : null)">@sehir</option>
                        }
                    </select>
                </div>
                <div class="filtre-alan">
                    <label>Devreye Alma</label>
                    <select name="devreyeSiralama">
                        <option value="">Varsayılan</option>
                        <option value="azalan" selected="@(seciliDevreyeSiralama == "azalan" ? "selected" : null)">En çoktan aza</option>
                        <option value="artan" selected="@(seciliDevreyeSiralama == "artan" ? "selected" : null)">En azdan çoğa</option>
                    </select>
                </div>
                <div class="filtre-alan">
                    <label>Durum</label>
                    <select name="durum">
                        <option value="" selected="@(seciliDurum == null ? "selected" : null)">Tümü</option>
                        <option value="1" selected="@(seciliDurum == 1 ? "selected" : null)">Aktif</option>
                        <option value="0" selected="@(seciliDurum == 0 ? "selected" : null)">Pasif</option>
                    </select>
                </div>
            </div>
            <div class="df-service-filter-actions">
                <a class="df-btn df-btn-secondary df-btn-sm" href="/AdminPanel/yetkiliservisler"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
                <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-funnel-fill" aria-hidden="true"></i> Filtrele</button>
            </div>
        </form>
    </details>

    <section class="df-service-list">
        <div class="df-service-list-head">
            <div>
                <h3><i class="bi bi-list-check" aria-hidden="true"></i> Yetkili Servis Listesi</h3>
                <span>Firma bilgileri, işlem hacmi ve kayıt durumu</span>
            </div>
            <strong>@servisler.Count kayıt</strong>
        </div>
        <div class="df-service-table-scroll">
            <div class="df-service-grid df-service-grid-head">
                <div>Firma</div><div>Şehir</div><div>Vergi No</div><div>İşlem</div><div>Durum</div><div>İşlemler</div>
            </div>
            @if (servisler.Count == 0)
            {
                <div class="df-empty">
                    <div class="df-empty-title">Yetkili servis kaydı bulunamadı.</div>
                    <p class="df-empty-text">Filtreleri temizleyip yeniden deneyin.</p>
                </div>
            }
            else
            {
                foreach (var servis in servisler)
                {
                    var devreyeSayisi = devreyeSayilari.TryGetValue(servis.Id, out var sayi) ? sayi : 0;
                    <div class="df-service-grid df-service-row @(servis.AktifMi ? "is-active" : "is-passive")">
                        <div>
                            <span class="df-service-name">@(servis.FirmaAdi ?? "-")</span>
                            <small>@(string.IsNullOrWhiteSpace(servis.YetkiliKisi) ? "Yetkili kişi tanımlı değil" : servis.YetkiliKisi)</small>
                        </div>
                        <div>@(servis.FaaliyetIli ?? "-")</div>
                        <div>@(servis.VergiNo ?? "-")</div>
                        <div><span class="df-service-count">@devreyeSayisi</span></div>
                        <div><span class="df-pill @(servis.AktifMi ? "df-pill-success" : "df-pill-danger")">@(servis.AktifMi ? "Aktif" : "Pasif")</span></div>
                        <div class="df-service-actions">
                            <a class="df-icon-action" href="/AdminPanel/yetkiliservisler/detay/@servis.Id" title="Servis detayını görüntüle"><i class="bi bi-eye" aria-hidden="true"></i><span>Detay</span></a>
                            <a class="df-icon-action" href="/AdminPanel/yetkiliservisler/duzenle/@servis.Id" title="Servisi düzenle"><i class="bi bi-pencil" aria-hidden="true"></i><span>Düzenle</span></a>
                            @if (devreyeSayisi > 0)
                            {
                                <button type="button" class="df-icon-action is-disabled" disabled title="Bu servisin devreye alma işlemi olduğu için silinemez."><i class="bi bi-lock" aria-hidden="true"></i><span>Silinemez</span></button>
                            }
                            else
                            {
                                <form method="post" action="/AdminPanel/yetkiliservisler/sil/@servis.Id" onsubmit="return confirm('Bu yetkili servisi silmek istiyor musunuz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="df-icon-action is-danger" title="Servisi sil"><i class="bi bi-trash3" aria-hidden="true"></i><span>Sil</span></button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </section>
</div>
