@{
    ViewData["Title"] = "Yetkili Servis Ekle";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "YetkiliServisler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var sehirler = ViewBag.Sehirler as List<string> ?? new();
    var sehirFirmaKodlari = ViewBag.SehirFirmaKodlari as Dictionary<string, string> ?? new();
    var kategoriler = ViewBag.Kategoriler as List<YetkiliServisGazAcma.Entities.UrunKategori> ?? new();
    var markalar = ViewBag.Markalar as List<YetkiliServisGazAcma.Entities.Ys_Marka> ?? new();
}

<div class="df-admin-workspace df-admin-editor df-service-create-workspace">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-building-add"></i> Yeni servis kaydı</div>
                <div class="df-panel-title">Yetkili Servis Ekle</div>
                <div class="df-panel-subtitle">Firma bilgisini, faaliyet ilini, yetkili markaları ve hizmet kapsamını aynı kayıtta tanımlayın.</div>
            </div>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/AdminPanel/yetkiliservisler">
                <i class="bi bi-arrow-left"></i>
                Listeye Dön
            </a>
        </div>
    </section>

    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            <form method="post" action="/AdminPanel/yetkiliservisler/ekle">
                @Html.AntiForgeryToken()

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-buildings"></i></span>
                        <div>
                            <h3>Firma ve İletişim Bilgileri</h3>
                            <p>Servisin kurumsal kimlik, iletişim ve faaliyet bilgilerini girin.</p>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                    <div class="df-admin-field">
                        <label>Firma Adı *</label>
                        <input type="text" name="firmaAdi" placeholder="Yetkili servis firma adı" required />
                    </div>
                    <div class="df-admin-field">
                        <label>Yetkili Kişi</label>
                        <input type="text" name="yetkiliKisi" placeholder="Ad soyad" />
                    </div>
                    <div class="df-admin-field">
                        <label>Telefon</label>
                        <input type="text" name="telefon" placeholder="0(---) --- -- --" />
                    </div>
                    <div class="df-admin-field">
                        <label>E-Posta</label>
                        <input type="email" name="email" placeholder="firma@ornek.com" />
                    </div>
                    <div class="df-admin-field">
                        <label>Şehir</label>
                        <select name="faaliyetIli" data-firma-kodu-select required>
                            <option value="">Seçiniz</option>
                            @foreach (var sehir in sehirler)
                            {
                                var firmaKodu = sehirFirmaKodlari.TryGetValue(sehir, out var kod) ? kod : "";
                                <option value="@sehir" data-firma-kodu="@firmaKodu">@sehir</option>
                            }
                        </select>
                        <div class="firma-kodu-hint" data-firma-kodu-target></div>
                    </div>
                    <div class="df-admin-field">
                        <label>Vergi No</label>
                        <input type="text" name="vergiNo" />
                    </div>
                    <div class="df-admin-field">
                        <label>Vergi Dairesi</label>
                        <input type="text" name="vergiDairesi" />
                    </div>
                    <div class="df-admin-field is-wide">
                        <label>Adres</label>
                        <input type="text" name="adres" placeholder="Firma adresi" />
                    </div>
                    </div>
                </section>

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-patch-check"></i></span>
                        <div>
                            <h3>Yetki ve Hizmet Kapsamı</h3>
                            <p>Servisin çalışabileceği markaları ve hizmet türlerini belirleyin.</p>
                        </div>
                    </div>
                    <div class="df-admin-choice-layout">
                        <div class="df-admin-choice-box">
                        <h3 class="df-admin-section-title is-scope">
                            <i class="bi bi-tags"></i>
                            Marka Seçimi
                        </h3>
                        <div class="df-admin-choice-note">Servisin işlem yapabildiği markaları seçin.</div>
                        <input class="marka-search" id="markaSearch" type="text" placeholder="Marka ara..." />
                        <div class="marka-list" id="markaList">
                            <label class="marka-item-all">
                                <input type="checkbox" id="markaSelectAll" />
                                Tümünü Seç
                            </label>
                            @foreach (var m in markalar)
                            {
                                <label class="marka-item" data-name="@m.MarkaAdi">
                                    <input type="checkbox" name="markaIds" value="@m.Id" />
                                    @m.MarkaAdi
                                </label>
                            }
                        </div>
                        </div>

                        <div class="df-admin-choice-box">
                        <h3 class="df-admin-section-title is-scope">
                            <i class="bi bi-ui-checks"></i>
                            Kullanılan Hizmet Türleri
                        </h3>
                        <div class="df-admin-choice-note">Servisin çalışacağı ürün veya hizmet türlerini işaretleyin.</div>
                        <div class="df-admin-choice-list">
                            @foreach (var k in kategoriler)
                            {
                                <label class="df-admin-choice">
                                    <input type="checkbox" name="kategoriIds" value="@k.Id" />
                                    @if (!string.IsNullOrWhiteSpace(k.IconUrl))
                                    {
                                        <span class="df-admin-choice-icon"><img src="@k.IconUrl" alt="@k.Ad" /></span>
                                    }
                                    else
                                    {
                                        <span class="df-admin-choice-icon"><i class="bi bi-box-seam"></i></span>
                                    }
                                    <span>@k.Ad</span>
                                </label>
                            }
                        </div>
                        </div>
                    </div>
                </section>

                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/AdminPanel/yetkiliservisler">
                        <i class="bi bi-x-lg"></i>
                        Vazgeç
                    </a>
                    <button type="submit" class="df-btn df-btn-primary df-btn-sm">
                        <i class="bi bi-check2"></i>
                        Kaydet
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
<script>
    (function () {
        var sehirSelect = document.querySelector("[data-firma-kodu-select]");
        var firmaTarget = document.querySelector("[data-firma-kodu-target]");
        var search = document.getElementById("markaSearch");
        var list = document.getElementById("markaList");
        var selectAll = document.getElementById("markaSelectAll");

        function firmaKoduGuncelle() {
            if (!sehirSelect || !firmaTarget) return;
            var option = sehirSelect.options[sehirSelect.selectedIndex];
            var firmaKodu = option ? option.getAttribute("data-firma-kodu") : "";
            if (firmaKodu) {
                firmaTarget.textContent = "Bağlı firma kodu: " + firmaKodu;
                firmaTarget.classList.add("is-visible");
            } else {
                firmaTarget.textContent = "";
                firmaTarget.classList.remove("is-visible");
            }
        }

        if (sehirSelect) {
            sehirSelect.addEventListener("change", firmaKoduGuncelle);
            firmaKoduGuncelle();
        }

        if (search && list) {
            search.addEventListener("input", function () {
                var q = search.value.toLowerCase();
                var items = list.querySelectorAll(".marka-item");
                items.forEach(function (item) {
                    var name = (item.getAttribute("data-name") || "").toLowerCase();
                    item.style.display = name.indexOf(q) >= 0 ? "flex" : "none";
                });
            });
        }

        if (selectAll && list) {
            selectAll.addEventListener("change", function () {
                var checked = selectAll.checked;
                var boxes = list.querySelectorAll(".marka-item input[type='checkbox']");
                boxes.forEach(function (b) { b.checked = checked; });
            });
        }
    })();
</script>
}
