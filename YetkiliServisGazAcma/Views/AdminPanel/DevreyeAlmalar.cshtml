@model List<YetkiliServisGazAcma.Entities.Ys_DevreyeAlma>
@{
    ViewData["Title"] = "Cihaz Devreye Alma Kayıtları";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "DevreyeAlmalar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var markalar = ViewBag.Markalar as List<YetkiliServisGazAcma.Entities.Ys_Marka> ?? new();
    var sehirler = ViewBag.Sehirler as List<string> ?? new();
    var firmaIlceleri = ViewBag.FirmaIlceleri as Dictionary<int, string> ?? new();
    var secilenMarka = Context.Request.Query["marka"].ToString();
    var secilenServis = Context.Request.Query["servis"].ToString();
    var secilenIl = ViewBag.SeciliIl as string ?? Context.Request.Query["il"].ToString();
    var secilenDurum = Context.Request.Query["durum"].ToString();
    var secilenBas = Context.Request.Query["bas"].ToString();
    var secilenBit = Context.Request.Query["bit"].ToString();
    var filtreAktif = !string.IsNullOrWhiteSpace(secilenMarka)
        || !string.IsNullOrWhiteSpace(secilenServis)
        || !string.IsNullOrWhiteSpace(secilenIl)
        || !string.IsNullOrWhiteSpace(secilenDurum)
        || !string.IsNullOrWhiteSpace(secilenBas)
        || !string.IsNullOrWhiteSpace(secilenBit);
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" />
}

<div class="df-admin-workspace df-operations-directory">
    <section class="df-admin-list-card">
        <div class="df-service-list-head is-operation-toolbar">
            <div class="df-operation-list-count" aria-label="@Model.Count kayıt görüntüleniyor"><i class="bi bi-list-check" aria-hidden="true"></i><strong>@Model.Count</strong><span>kayıt</span></div>
            <div class="df-export-actions" aria-label="Dışa aktarma işlemleri">
                <button type="button" class="df-btn df-btn-danger df-btn-sm" data-admin-list-export data-export-url="@Url.Action("RaporlarPdf", "AdminPanel")" disabled="@(!Model.Any())" title="Seçili kayıtları; seçim yoksa listedeki kayıtları PDF olarak indir"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF İndir</button>
                <button type="button" class="df-btn df-btn-success df-btn-sm" data-admin-list-export data-export-url="@Url.Action("RaporlarExcel", "AdminPanel")" disabled="@(!Model.Any())" title="Seçili kayıtları; seçim yoksa listedeki kayıtları Excel olarak indir"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel İndir</button>
            </div>
        </div>
    <details class="df-admin-filter" open="@(filtreAktif ? "open" : null)">
        <summary>
            <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Kayıtları Filtrele</strong></span>
            <span>@(filtreAktif ? "Filtre uygulandı" : "Filtreleri aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <form method="get" action="@Url.Action("DevreyeAlmalar", "AdminPanel")">
                <div class="df-admin-filter-grid">
                    <div class="df-admin-field"><label for="marka">Marka</label><select id="marka" name="marka"><option value="">Tümü</option>@foreach (var m in markalar) { <option value="@m.MarkaAdi" selected="@(secilenMarka == m.MarkaAdi ? "selected" : null)">@m.MarkaAdi</option> }</select></div>
                    <div class="df-admin-field"><label for="servis">Yetkili Servis</label><input id="servis" type="search" name="servis" value="@secilenServis" placeholder="Servis adı" /></div>
                    <div class="df-admin-field"><label for="il">İl</label><select id="il" name="il"><option value="">Tümü</option>@foreach (var sehir in sehirler) { <option value="@sehir" selected="@(secilenIl == sehir ? "selected" : null)">@sehir</option> }</select></div>
                    <div class="df-admin-field"><label for="durum">Durum</label><select id="durum" name="durum"><option value="">Tümü</option><option value="1" selected="@(secilenDurum == "1" ? "selected" : null)">Tamamlandı</option><option value="0" selected="@(secilenDurum == "0" ? "selected" : null)">Bekliyor</option><option value="2" selected="@(secilenDurum == "2" ? "selected" : null)">İptal</option></select></div>
                    <div class="df-admin-field is-half"><label for="bas">Başlangıç Tarihi</label><input id="bas" type="date" name="bas" value="@secilenBas" /></div>
                    <div class="df-admin-field is-half"><label for="bit">Bitiş Tarihi</label><input id="bit" type="date" name="bit" value="@secilenBit" /></div>
                </div>
                <div class="df-admin-filter-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="@Url.Action("DevreyeAlmalar", "AdminPanel")"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Sonuçları Göster</button>
                </div>
            </form>
        </div>
    </details>

        @if (!Model.Any())
        {
            <div class="df-admin-empty"><i class="bi bi-inbox" aria-hidden="true"></i> Filtrelere uygun kayıt bulunamadı.</div>
        }
        else
        {
            <div class="df-admin-table-scroll">
                <table class="df-table df-commissioning-table">
                    <thead><tr><th><input id="adminTumunuSec" type="checkbox" aria-label="Tüm kayıtları seç" /></th><th>Abone</th><th>Tesisat Bilgileri</th><th>Yetkili Servis</th><th>Cihaz Bilgileri</th><th>Devreye Alma</th><th>Durum</th><th>İşlem</th></tr></thead>
                    <tbody>
                    @foreach (var d in Model)
                    {
                        var ilce = firmaIlceleri.TryGetValue(d.FirmaId, out var bulunanIlce) ? bulunanIlce : "-";
                        var durumYazi = d.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "Tamamlandı" : d.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "İptal" : "Bekliyor";
                        var durumSinif = d.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "df-pill-success" : d.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "df-pill-danger" : "df-pill-warning";
                        var tarihVar = d.DevreyeAlmaTarihi.Year > 1900;
                        var cihazMarka = d.CihazMarka ?? d.Marka?.MarkaAdi;
                        var cihazModeli = string.Equals(d.CihazModeli?.Trim(), cihazMarka?.Trim(), StringComparison.OrdinalIgnoreCase)
                            || string.Equals(d.CihazModeli?.Trim(), d.CihazTipi?.Trim(), StringComparison.OrdinalIgnoreCase)
                                ? null
                                : d.CihazModeli;
                        var cihazOzeti = string.Join(" · ", new[] { cihazMarka, cihazModeli }.Where(x => !string.IsNullOrWhiteSpace(x)));
                        if (string.IsNullOrWhiteSpace(cihazOzeti)) cihazOzeti = "Cihaz bilgisi bulunmuyor";
                        var detaySatiriId = $"devreye-alma-detay-{d.Id}";
                        <tr class="df-commissioning-record-row" data-commissioning-record>
                            <td><input class="admin-row-check" type="checkbox" value="@d.Id" aria-label="@d.TesistatNo kaydını seç" /></td>
                            <td><div class="df-cell-main">@(string.IsNullOrWhiteSpace(d.MusteriAdi) ? "Abone adı kayıtlı değil" : d.MusteriAdi)</div>@if (!string.IsNullOrWhiteSpace(d.MusteriTelefon)) { <div class="df-cell-sub"><i class="bi bi-telephone" aria-hidden="true"></i> @d.MusteriTelefon</div> }</td>
                            <td><dl class="df-operation-id-list"><div><dt>Tesisat No:</dt><dd>@(d.TesistatNo ?? "-")</dd></div><div><dt>Abone No:</dt><dd>@(d.AboneNo ?? "-")</dd></div></dl></td>
                            <td><div class="df-cell-value">@(d.Firma?.FirmaAdi ?? "-")</div><div class="df-cell-sub">@string.Join(" / ", new[] { d.Firma?.FaaliyetIli, ilce }.Where(x => !string.IsNullOrWhiteSpace(x)))</div></td>
                            <td><dl class="df-device-facts"><div><dt>Tür</dt><dd>@(string.IsNullOrWhiteSpace(d.CihazTipi) ? "-" : d.CihazTipi)</dd></div><div><dt>Marka</dt><dd>@(string.IsNullOrWhiteSpace(cihazMarka) ? "-" : cihazMarka)</dd></div>@if (!string.IsNullOrWhiteSpace(cihazModeli)) { <div class="df-device-model"><dt>Model</dt><dd title="@cihazModeli">@cihazModeli</dd></div> }</dl></td>
                            <td><time class="df-cell-value" datetime="@(tarihVar ? d.DevreyeAlmaTarihi.ToString("yyyy-MM-dd") : null)">@(tarihVar ? d.DevreyeAlmaTarihi.ToString("dd.MM.yyyy") : "Tarih bilgisi yok")</time>@if (!string.IsNullOrWhiteSpace(d.TeknisyenAdi)) { <div class="df-cell-sub">Teknisyen: @d.TeknisyenAdi</div> }</td>
                            <td><span class="df-pill @durumSinif">@durumYazi</span></td>
                            <td>
                                <div class="df-commissioning-row-actions">
                                    <a class="df-icon-action commissioning-row-action" href="@Url.Action("DevreyeAlmaDetay", "AdminPanel", new { id = d.Id })" title="Tam ayrıntıyı görüntüle" aria-label="@(string.IsNullOrWhiteSpace(d.MusteriAdi) ? "Devreye alma kaydını görüntüle" : $"{d.MusteriAdi} devreye alma kaydını görüntüle")"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    <button class="df-icon-action commissioning-row-action df-commissioning-expand" type="button" data-commissioning-expand aria-expanded="false" aria-controls="@detaySatiriId" title="Satır ayrıntılarını aç" aria-label="Satır ayrıntılarını aç"><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
                                </div>
                            </td>
                        </tr>
                        <tr id="@detaySatiriId" class="df-commissioning-detail-row" hidden>
                            <td colspan="8">
                                <div class="df-commissioning-detail-panel">
                                    <div class="df-commissioning-detail-grid">
                                        <section>
                                            <span><i class="bi bi-person-vcard" aria-hidden="true"></i> Abone ve Tesisat</span>
                                            <strong>@(string.IsNullOrWhiteSpace(d.MusteriAdi) ? "Abone adı kayıtlı değil" : d.MusteriAdi)</strong>
                                            <small>Tesisat: @(d.TesistatNo ?? "-") · Abone: @(d.AboneNo ?? "-")</small>
                                        </section>
                                        <section>
                                            <span><i class="bi bi-geo-alt" aria-hidden="true"></i> Adres</span>
                                            <strong>@(string.IsNullOrWhiteSpace(d.Adres) ? "Adres bilgisi bulunmuyor" : d.Adres)</strong>
                                            <small>@(string.IsNullOrWhiteSpace(d.MusteriTelefon) ? "Telefon bilgisi bulunmuyor" : d.MusteriTelefon)</small>
                                        </section>
                                        <section>
                                            <span><i class="bi bi-fire" aria-hidden="true"></i> Cihaz</span>
                                            <strong>@cihazOzeti</strong>
                                            <small>Seri No: @(string.IsNullOrWhiteSpace(d.SeriNo) ? "-" : d.SeriNo) · Kapasite: @(string.IsNullOrWhiteSpace(d.CihazKapasite) ? "-" : d.CihazKapasite)</small>
                                        </section>
                                        <section>
                                            <span><i class="bi bi-building-check" aria-hidden="true"></i> Servis ve Teknisyen</span>
                                            <strong>@(d.Firma?.FirmaAdi ?? "Yetkili servis bilgisi yok")</strong>
                                            <small>@(string.IsNullOrWhiteSpace(d.TeknisyenAdi) ? "Teknisyen bilgisi yok" : d.TeknisyenAdi)@if (!string.IsNullOrWhiteSpace(d.TeknisyenYetkiBelgesiNo)) { <text> · Belge: @d.TeknisyenYetkiBelgesiNo</text> }</small>
                                        </section>
                                    </div>
                                    <footer class="df-commissioning-detail-footer">
                                        <div>
                                            <span>Kayıt #@d.Id</span>
                                            @if (!string.IsNullOrWhiteSpace(d.Notlar))
                                            {
                                                <small title="@d.Notlar">@d.Notlar</small>
                                            }
                                        </div>
                                        <div class="df-actions">
                                            <a class="df-btn df-btn-secondary df-btn-sm" href="@Url.Action("DevreyeAlmaPdf", "AdminPanel", new { id = d.Id })"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
                                            <a class="df-btn df-btn-secondary df-btn-sm" href="@Url.Action("DevreyeAlmaExcel", "AdminPanel", new { id = d.Id })"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
                                            <a class="df-btn df-btn-primary df-btn-sm" href="@Url.Action("DevreyeAlmaDetay", "AdminPanel", new { id = d.Id })">Tüm Ayrıntılar <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                                        </div>
                                    </footer>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const rows = Array.from(document.querySelectorAll('.admin-row-check'));
            const all = document.getElementById('adminTumunuSec');
            all?.addEventListener('change', () => rows.forEach(row => { row.checked = all.checked; }));

            const records = Array.from(document.querySelectorAll('[data-commissioning-record]'));
            const setRecordState = (record, expanded) => {
                const toggle = record.querySelector('[data-commissioning-expand]');
                const detail = toggle ? document.getElementById(toggle.getAttribute('aria-controls')) : null;
                if (!toggle || !detail) return;
                record.classList.toggle('is-expanded', expanded);
                detail.hidden = !expanded;
                toggle.setAttribute('aria-expanded', String(expanded));
                toggle.setAttribute('title', expanded ? 'Satır ayrıntılarını kapat' : 'Satır ayrıntılarını aç');
                toggle.setAttribute('aria-label', expanded ? 'Satır ayrıntılarını kapat' : 'Satır ayrıntılarını aç');
            };

            records.forEach(record => {
                record.querySelector('[data-commissioning-expand]')?.addEventListener('click', () => {
                    const willOpen = !record.classList.contains('is-expanded');
                    records.forEach(other => setRecordState(other, false));
                    setRecordState(record, willOpen);
                });
            });

            document.querySelectorAll('[data-admin-list-export]').forEach(button => {
                button.addEventListener('click', () => {
                    const selected = rows.filter(row => row.checked);
                    const exportRows = selected.length ? selected : rows;
                    if (!exportRows.length) return;

                    const url = new URL(button.dataset.exportUrl, window.location.origin);
                    exportRows.forEach(row => url.searchParams.append('ids', row.value));
                    window.location.assign(url.toString());
                });
            });
        })();
    </script>
}
