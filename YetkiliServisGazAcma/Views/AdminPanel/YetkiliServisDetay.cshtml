@using YetkiliServisGazAcma.Entities
@{
    ViewData["Title"] = "Yetkili Servis Detay";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "YetkiliServisler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var servis = ViewBag.Servis as Ys_Firma;
    var yetkiBelgeleri = ViewBag.YetkiBelgeleri as List<Ys_YetkiBelgesi> ?? new();
    var subeler = ViewBag.Subeler as List<Ys_Sube> ?? new();
    var devreye = ViewBag.Devreye as List<Ys_DevreyeAlma> ?? new();
    var markalar = servis?.FirmaMarkalar?
        .Where(x => !x.SilindiMi && x.Marka != null)
        .Select(x => x.Marka!)
        .Distinct()
        .ToList() ?? new List<Ys_Marka>();
    var kategoriler = servis?.FirmaKategoriler?.Where(x => !x.SilindiMi
            && x.Kategori != null
            && !x.Kategori.SilindiMi
            && x.Kategori.AktifMi
            && KullanilanKategoriMi(x.Kategori.Ad))
        .Select(x => x.Kategori!)
        .GroupBy(x => NormalizeKategori(x.Ad))
        .Select(g => g.First())
        .ToList() ?? new List<UrunKategori>();

    var durumClass = servis?.AktifMi == true ? "df-pill-success" : "df-pill-danger";
    var durumYazi = servis?.AktifMi == true ? "Aktif" : "Pasif";
}

@functions {
    private static string Deger(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static bool Gosterilebilir(string? value)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Trim() != "-"
            && !string.Equals(value.Trim(), "string", StringComparison.OrdinalIgnoreCase);
    }

    private static bool KullanilanKategoriMi(string? ad)
    {
        var key = NormalizeKategori(ad);
        return key == "kombi" || key.Contains("merkezikazan") || key.Contains("sofben") || key.Contains("sohben");
    }

    private static string NormalizeKategori(string? ad)
    {
        if (string.IsNullOrWhiteSpace(ad)) return string.Empty;
        var normalized = ad.Trim().ToLower(new System.Globalization.CultureInfo("tr-TR")).Normalize(System.Text.NormalizationForm.FormD);
        var chars = normalized.Where(ch => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch) != System.Globalization.UnicodeCategory.NonSpacingMark && char.IsLetterOrDigit(ch)).ToArray();
        return new string(chars).Replace("ı", "i").Replace("ş", "s").Replace("ğ", "g").Replace("ü", "u").Replace("ö", "o").Replace("ç", "c");
    }

    private static string KategoriIkon(string? ad)
    {
        var key = NormalizeKategori(ad);
        if (key.Contains("kombi") || key.Contains("kazan")) return "bi-fire";
        if (key.Contains("sofben") || key.Contains("sohben")) return "bi-droplet";
        return "bi-tools";
    }
}

<div class="df-service-detail df-admin-service-detail">
    <section class="df-page-panel df-service-detail-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-building-check"></i> YETKİLİ SERVİS</div>
                <h2 class="df-panel-title">@Deger(servis?.FirmaAdi)</h2>
                <div class="df-panel-subtitle">@Deger(servis?.Sirket?.SirketAdi) · @Deger(servis?.FaaliyetIli)</div>
            </div>
            <div class="df-actions">
                <span class="df-pill @durumClass">@durumYazi</span>
                <a class="df-btn df-btn-secondary df-btn-sm" href="/AdminPanel/yetkiliservisler"><i class="bi bi-arrow-left"></i> Listeye Dön</a>
                @if (servis != null)
                {
                    <a class="df-btn df-btn-primary df-btn-sm" href="/AdminPanel/yetkiliservisler/duzenle/@servis.Id"><i class="bi bi-pencil"></i> Düzenle</a>
                }
            </div>
        </div>
        <div class="df-service-summary" aria-label="Yetkili servis özeti">
            <div><span>Yetkili Kişi</span><strong>@(Gosterilebilir(servis?.YetkiliKisi) ? servis!.YetkiliKisi : "Tanımlı değil")</strong></div>
            <div><span>Marka Yetkisi</span><strong>@markalar.Count marka</strong></div>
            <div><span>Şube</span><strong>@subeler.Count şube</strong></div>
            <div><span>Devreye Alma</span><strong>@devreye.Count işlem</strong></div>
        </div>
    </section>

    <section class="df-service-detail-section is-company">
        <div class="df-service-detail-title"><i class="bi bi-building"></i><span><strong>Firma ve İletişim</strong><small>Servisin kayıtlı kurumsal bilgileri</small></span></div>
        <dl class="df-service-info-grid">
            <div><dt>Firma</dt><dd>@Deger(servis?.FirmaAdi)</dd></div>
            <div><dt>Şirket</dt><dd>@Deger(servis?.Sirket?.SirketAdi)</dd></div>
            @if (Gosterilebilir(servis?.YetkiliKisi)) { <div><dt>Yetkili Kişi</dt><dd>@servis!.YetkiliKisi</dd></div> }
            @if (Gosterilebilir(servis?.VergiNo)) { <div><dt>Vergi No</dt><dd>@servis!.VergiNo</dd></div> }
            @if (Gosterilebilir(servis?.VergiDairesi)) { <div><dt>Vergi Dairesi</dt><dd>@servis!.VergiDairesi</dd></div> }
            @if (Gosterilebilir(servis?.Telefon)) { <div><dt>Telefon</dt><dd>@servis!.Telefon</dd></div> }
            @if (Gosterilebilir(servis?.Email)) { <div><dt>E-posta</dt><dd>@servis!.Email</dd></div> }
            @if (Gosterilebilir(servis?.FaaliyetIli)) { <div><dt>Faaliyet İli</dt><dd>@servis!.FaaliyetIli</dd></div> }
            @if (Gosterilebilir(servis?.Adres)) { <div class="is-wide"><dt>Adres</dt><dd>@servis!.Adres</dd></div> }
        </dl>
    </section>

    <div class="df-service-detail-split">
        <section class="df-service-detail-section is-brand">
            <div class="df-service-detail-title"><i class="bi bi-patch-check"></i><span><strong>Marka Yetkileri</strong><small>İşlem yapılabilen markalar</small></span></div>
            <div class="df-service-chip-list">
                @if (markalar.Count == 0) { <span class="df-service-empty-inline">Tanımlı marka bulunmuyor.</span> }
                else { foreach (var marka in markalar) { <span class="df-service-chip"><i class="bi bi-check2"></i>@marka.MarkaAdi</span> } }
            </div>
        </section>

        <section class="df-service-detail-section is-category">
            <div class="df-service-detail-title"><i class="bi bi-grid"></i><span><strong>Cihaz Kategorileri</strong><small>Yetkili olunan cihaz grupları</small></span></div>
            <div class="df-service-category-list">
                @if (kategoriler.Count == 0) { <span class="df-service-empty-inline">Tanımlı kategori bulunmuyor.</span> }
                else
                {
                    foreach (var kategori in kategoriler)
                    {
                        <div><span class="df-service-category-icon"><i class="bi @KategoriIkon(kategori.Ad)"></i></span><strong>@kategori.Ad</strong></div>
                    }
                }
            </div>
        </section>
    </div>

    <details class="df-service-detail-section df-service-detail-disclosure">
        <summary class="df-service-detail-title"><i class="bi bi-file-earmark-check"></i><span><strong>Yetki Belgeleri</strong><small>@yetkiBelgeleri.Count belge kaydı</small></span><i class="bi bi-chevron-down"></i></summary>
        @if (yetkiBelgeleri.Count == 0)
        {
            <span class="df-service-empty-inline">Yetki belgesi kaydı yok.</span>
        }
        else
        {
            <div class="service-list">
                <div class="service-row service-row-head cert"><div>Yükleme</div><div>Başlangıç</div><div>Bitiş</div><div>Durum</div></div>
                @foreach (var belge in yetkiBelgeleri)
                {
                    <div class="service-row cert">
                        <div>@belge.OlusturmaTarihi.ToString("dd.MM.yyyy")</div>
                        <div>@(belge.YetkiBelgesiBaslangicTarihi?.ToString("dd.MM.yyyy") ?? "-")</div>
                        <div>@belge.YetkiBelgesiBitisTarihi.ToString("dd.MM.yyyy")</div>
                        <div>
                            @if (belge.Durum == YetkiBelgesiDurumDegerleri.Onaylandi) { <span class="df-pill df-pill-success">Onaylı</span> }
                            else if (belge.Durum == YetkiBelgesiDurumDegerleri.Reddedildi) { <span class="df-pill df-pill-danger">Reddedildi</span> }
                            else { <span class="df-pill df-pill-warning">Bekliyor</span> }
                        </div>
                    </div>
                }
            </div>
        }
    </details>

    <details class="df-service-detail-section is-branch df-service-detail-disclosure">
        <summary class="df-service-detail-title"><i class="bi bi-diagram-3"></i><span><strong>Şubeler</strong><small>@subeler.Count bağlı servis noktası</small></span><i class="bi bi-chevron-down"></i></summary>
        @if (subeler.Count == 0)
        {
            <span class="df-service-empty-inline">Şube kaydı yok.</span>
        }
        else
        {
            <div class="df-service-branch-list">
                @foreach (var sube in subeler)
                {
                    <article><div><i class="bi bi-geo-alt"></i><strong>@Deger(sube.SubeAdi)</strong></div><p>@Deger((sube.Il + " " + sube.Ilce).Trim())</p>@if (Gosterilebilir(sube.Telefon)) { <span><i class="bi bi-telephone"></i>@sube.Telefon</span> }</article>
                }
            </div>
        }
    </details>

    <details class="df-service-detail-section df-service-detail-disclosure">
        <summary class="df-service-detail-title"><i class="bi bi-clock-history"></i><span><strong>Son Devreye Almalar</strong><small>@devreye.Count işlem kaydı</small></span><i class="bi bi-chevron-down"></i></summary>
        @if (devreye.Count == 0)
        {
            <span class="df-service-empty-inline">Devreye alma kaydı yok.</span>
        }
        else
        {
            <div class="service-list">
                <div class="service-row service-row-head devreye"><div>Tesisat No</div><div>Marka</div><div>Tarih</div><div>Durum</div></div>
                @foreach (var kayit in devreye)
                {
                    <div class="service-row devreye">
                        <div>@Deger(kayit.TesistatNo)</div><div>@Deger(kayit.Marka?.MarkaAdi ?? kayit.CihazMarka)</div><div>@kayit.OlusturmaTarihi.ToString("dd.MM.yyyy")</div>
                        <div>@if (kayit.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi) { <span class="df-pill df-pill-success">Tamamlandı</span> } else if (kayit.Durum == DevreyeAlmaDurumDegerleri.Iptal) { <span class="df-pill df-pill-danger">İptal</span> } else { <span class="df-pill df-pill-warning">Bekliyor</span> }</div>
                    </div>
                }
            </div>
        }
    </details>
</div>
