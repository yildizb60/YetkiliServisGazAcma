@{
    ViewData["Title"] = "Yeni Kullanıcı";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "Kullanicilar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    string formAdSoyad = ViewBag.FormAdSoyad ?? "";
    string formEmail = ViewBag.FormEmail ?? "";
    string formTelefon = ViewBag.FormTelefon ?? "";
    var genelSistemAdminMi = ViewBag.GenelSistemAdminMi as bool? ?? false;
    string formRol = ViewBag.FormRol ?? (genelSistemAdminMi ? "SirketAdmin" : "Personel");
    if (!genelSistemAdminMi && (formRol == "GenelSistemAdmin" || formRol == "SirketAdmin" || formRol == "SuperAdmin"))
    {
        formRol = "Personel";
    }
    int formSirketId = ViewBag.FormSirketId is int s ? s : 0;
    var sirketler = ViewBag.Sirketler as List<YetkiliServisGazAcma.Entities.Dag_Sirket> ?? new();
}

<div class="df-admin-workspace df-admin-editor df-user-create-workspace">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-person-add"></i> Kullanıcı hesabı</div>
                <div class="df-panel-title">Yeni Kullanıcı</div>
                <div class="df-panel-subtitle">Önce kullanıcının rolünü ve bağlı olduğu kurumu, ardından hesap bilgilerini girin.</div>
            </div>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/AdminPanel/Kullanicilar"><i class="bi bi-arrow-left"></i> Kullanıcılara Dön</a>
        </div>
    </section>

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            @if (ViewBag.Hata != null)
            {
                <div class="df-alert df-alert-danger">@ViewBag.Hata</div>
            }

            <form method="post" action="/AdminPanel/Kullanicilar/ekle">
                @Html.AntiForgeryToken()

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-diagram-3"></i></span>
                        <div>
                            <h3>Rol ve Bağlantı</h3>
                            <p>Kullanıcının sistemde ne yapacağını ve hangi şirket kapsamında çalışacağını belirleyin.</p>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-half">
                            <label>Rol *</label>
                            <select name="rol" id="rolSelect" required>
                                @if (genelSistemAdminMi)
                                {
                                    <option value="GenelSistemAdmin" selected="@(formRol == "GenelSistemAdmin")">Genel Sistem Admini</option>
                                    <option value="SirketAdmin" selected="@(formRol == "SirketAdmin" || formRol == "SuperAdmin")">Şirket Admini</option>
                                }
                                <option value="Personel" selected="@(formRol == "Personel")">Personel</option>
                                <option value="YetkiliServis" selected="@(formRol == "YetkiliServis")">Yetkili Servis</option>
                                <option value="SertifikaliFirma" selected="@(formRol == "SertifikaliFirma")">Sertifikalı Firma</option>
                            </select>
                            <small class="df-admin-field-note" id="roleHelp"></small>
                        </div>
                        <div class="df-admin-field is-half" id="sirketGroup">
                            <label id="sirketLabel">Şirket *</label>
                            <select id="sirketIdSelect" name="SirketId">
                                <option value="">Seçiniz</option>
                                @foreach (var sirket in sirketler)
                                {
                                    <option value="@sirket.Id" selected="@(formSirketId == sirket.Id)">@sirket.SirketAdi</option>
                                }
                            </select>
                        </div>
                    </div>
                </section>

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-person-vcard"></i></span>
                        <div>
                            <h3>Hesap Bilgileri</h3>
                            <p>Oturum açacak kişiye ait temel iletişim ve giriş bilgilerini girin.</p>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-half">
                            <label>Ad Soyad *</label>
                            <input name="adSoyad" value="@formAdSoyad" autocomplete="name" required />
                        </div>
                        <div class="df-admin-field is-half">
                            <label>E-Posta *</label>
                            <input type="email" name="email" value="@formEmail" autocomplete="email" required />
                        </div>
                        <div class="df-admin-field is-half">
                            <label>Telefon</label>
                            <input name="telefon" value="@formTelefon" autocomplete="tel" />
                        </div>
                        <div class="df-admin-field is-half">
                            <label>Geçici Şifre *</label>
                            <input type="password" name="sifre" autocomplete="new-password" required />
                            <small class="df-admin-field-note">En az 6 karakter, en az bir küçük harf ve bir rakam.</small>
                        </div>
                    </div>
                </section>

                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/AdminPanel/Kullanicilar"><i class="bi bi-x-lg"></i> Vazgeç</a>
                    <button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-person-check"></i> Kullanıcıyı Oluştur</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
<script>
    (function () {
        var rolSelect = document.getElementById("rolSelect");
        var sirketGroup = document.getElementById("sirketGroup");
        var sirketLabel = document.getElementById("sirketLabel");
        var sirketIdSelect = document.getElementById("sirketIdSelect");
        var roleHelp = document.getElementById("roleHelp");
        if (!rolSelect || !sirketGroup || !sirketLabel || !sirketIdSelect || !roleHelp) return;

        function uygulaRolDavranisi() {
            var rol = (rolSelect.value || "").trim();
            var genelAdminMi = rol === "GenelSistemAdmin";
            var firmaKullanicisiMi = rol === "YetkiliServis" || rol === "SertifikaliFirma";
            var sirketGerekliMi = !genelAdminMi;

            sirketGroup.hidden = !sirketGerekliMi;
            sirketIdSelect.disabled = !sirketGerekliMi;
            sirketIdSelect.required = sirketGerekliMi;
            if (!sirketGerekliMi) sirketIdSelect.value = "";

            sirketLabel.textContent = firmaKullanicisiMi ? "Bağlı Dağıtım Şirketi *" : "Şirket *";
            if (firmaKullanicisiMi) {
                roleHelp.textContent = "Firma hesabı oluşturulur ve seçilen dağıtım şirketine bağlanır.";
            } else if (rol === "Personel") {
                roleHelp.textContent = "Personelin ek işlem yetkileri Yetkiler ekranından belirlenir.";
            } else if (rol === "SirketAdmin" || rol === "SuperAdmin") {
                roleHelp.textContent = "Şirket yöneticisi yalnızca bağlı şirket kapsamındaki kayıtları yönetir.";
            } else {
                roleHelp.textContent = "Sistem genelindeki yönetim hesabıdır.";
            }
        }

        rolSelect.addEventListener("change", uygulaRolDavranisi);
        uygulaRolDavranisi();
    })();
</script>
}
