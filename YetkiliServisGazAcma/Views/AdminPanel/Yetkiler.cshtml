@{
    ViewData["Title"] = "Yetkiler";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "Yetkiler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var personeller = ViewBag.Personeller as List<YetkiliServisGazAcma.Entities.AppKullanici>;
    var yetkiIsimler = ViewBag.YetkiIsimler as Dictionary<string, string> ?? new();
    var yetkiMap = ViewBag.YetkiMap as Dictionary<string, List<string>> ?? new();
    var yetkiSirketAdlariMap = ViewBag.YetkiSirketAdlariMap as Dictionary<string, List<string>> ?? new();
    var toplamPersonel = personeller?.Count ?? 0;
    var yetkiTanimliPersonel = yetkiMap.Values.Count(yetkiler => yetkiler.Count > 0);
    var tamYetkiliPersonel = yetkiMap.Values.Count(yetkiler => yetkiler.Any(yetki => string.Equals(yetki, "TAM_YETKI", StringComparison.OrdinalIgnoreCase)));
    var sirketKapsami = yetkiSirketAdlariMap.Values
        .SelectMany(sirketler => sirketler)
        .Where(sirket => !string.IsNullOrWhiteSpace(sirket))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
}

<div class="df-admin-workspace df-permission-workspace">
<section class="df-permission-overview" aria-label="Yetki özeti">
    <div class="df-permission-stat is-blue">
        <span class="df-permission-stat-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
        <span><small>Kayıtlı personel</small><strong>@toplamPersonel</strong></span>
    </div>
    <div class="df-permission-stat is-green">
        <span class="df-permission-stat-icon"><i class="bi bi-person-check" aria-hidden="true"></i></span>
        <span><small>Yetki tanımlı</small><strong>@yetkiTanimliPersonel</strong></span>
    </div>
    <div class="df-permission-stat is-amber">
        <span class="df-permission-stat-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
        <span><small>Tam yetkili</small><strong>@tamYetkiliPersonel</strong></span>
    </div>
    <div class="df-permission-stat is-cyan">
        <span class="df-permission-stat-icon"><i class="bi bi-buildings" aria-hidden="true"></i></span>
        <span><small>Şirket kapsamı</small><strong>@sirketKapsami</strong></span>
    </div>
</section>

<details class="matrix-card">
    <summary class="matrix-head">
        <span class="matrix-heading"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i><span><strong>Rol ve Erişim Çerçevesi</strong></span></span>
        <span class="matrix-toggle"><span class="when-closed">Matrisi Aç</span><span class="when-open">Matrisi Kapat</span><i class="bi bi-chevron-down" aria-hidden="true"></i></span>
    </summary>
    <div class="matrix-scroll">
    <table class="matrix-table">
        <thead>
            <tr>
                <th>Rol</th>
                <th>Menü Görünürlüğü</th>
                <th>Sayfa Erişimi</th>
                <th>Yönetim İşlemleri</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><span class="df-role-cell"><i class="bi bi-shield-fill-check" aria-hidden="true"></i>Genel Sistem Admini</span></td>
                <td class="ok">Tüm menüler görünür</td>
                <td class="ok">Tüm sayfalar</td>
                <td class="ok">Ekle / Düzenle / Sil / Onay + Kullanıcı yönetimi</td>
            </tr>
            <tr>
                <td><span class="df-role-cell is-company"><i class="bi bi-building-gear" aria-hidden="true"></i>Şirket Admini</span></td>
                <td class="ok">Kendi şirketinin yönetim menüleri</td>
                <td class="ok">Kendi şirket verileri</td>
                <td class="ok">Personel, servis ve yetki yönetimi</td>
            </tr>
            <tr>
                <td><span class="df-role-cell is-personnel"><i class="bi bi-person-badge" aria-hidden="true"></i>Personel</span></td>
                <td class="ok">Verilen işlem yetkilerine göre</td>
                <td class="ok">Yetkili olduğu şirket ve modüller</td>
                <td class="ok">Görüntüleme, onay, atama veya raporlama</td>
            </tr>
            <tr>
                <td><span class="df-role-cell is-service"><i class="bi bi-tools" aria-hidden="true"></i>Yetkili Servis</span></td>
                <td class="ok">Servis işlemleri ve firma kayıtları</td>
                <td class="ok">Yalnız bağlı firma verileri</td>
                <td class="ok">Devreye alma ve belge yükleme</td>
            </tr>
            <tr>
                <td><span class="df-role-cell is-certified"><i class="bi bi-building-check" aria-hidden="true"></i>Sertifikalı Firma</span></td>
                <td class="ok">Cihaz değişim talep ve raporları</td>
                <td class="ok">Yalnız bağlı firma talepleri</td>
                <td class="ok">Talep oluşturma ve kayıt takibi</td>
            </tr>
        </tbody>
    </table>
    </div>
</details>

<section class="df-admin-list-card df-permission-list">
    <div class="df-service-list-head">
        <div>
            <h3><i class="bi bi-person-lock"></i> Personel Yetkileri</h3>
        </div>
        <strong>@toplamPersonel personel</strong>
    </div>
    <div class="tablo-head">
        <div>Personel</div><div>Yetki Kapsamı</div><div>İşlem Yetkileri</div><div>İşlem</div>
    </div>
    @if (personeller == null || personeller.Count == 0)
    {
        <div class="empty">Personel kaydı yok</div>
    }
    else
    {
        foreach (var p in personeller)
        {
            var yetkiler = yetkiMap.ContainsKey(p.Id) ? yetkiMap[p.Id] : new List<string>();
            var sirketAdlari = yetkiSirketAdlariMap.ContainsKey(p.Id) ? yetkiSirketAdlariMap[p.Id] : new List<string>();
            var gorunenYetkiler = yetkiler.Take(4).ToList();

            <div class="tablo-row">
                <div class="df-permission-person" data-label="Personel">
                    <span class="df-permission-person-icon"><i class="bi bi-person" aria-hidden="true"></i></span>
                    <span><strong>@(p.AdSoyad ?? "-")</strong><small>@(p.Email ?? "E-posta bilgisi yok")</small></span>
                </div>
                <div data-label="Yetki kapsamı">
                    @if (sirketAdlari.Count == 0)
                    {
                        <span class="df-empty-value">Şirket atanmamış</span>
                    }
                    else
                    {
                        <div class="yetki-list">
                            @foreach (var sirketAdi in sirketAdlari)
                            {
                                <span class="df-permission-token is-company">@sirketAdi</span>
                            }
                        </div>
                    }
                </div>
                <div data-label="İşlem yetkileri">
                    @if (yetkiler.Count == 0)
                    {
                        <span class="df-empty-value">Yetki tanımlanmamış</span>
                    }
                    else
                    {
                        <div class="yetki-list">
                            @foreach (var y in gorunenYetkiler)
                            {
                                <span class="df-permission-token" data-permission-code="@y">@(yetkiIsimler.ContainsKey(y) ? yetkiIsimler[y] : y)</span>
                            }
                            @if (yetkiler.Count > gorunenYetkiler.Count)
                            {
                                <span class="df-permission-token-more">+@(yetkiler.Count - gorunenYetkiler.Count) yetki</span>
                            }
                        </div>
                    }
                </div>
                <div class="df-permission-row-action" data-label="İşlem">
                    <a class="df-permission-edit js-admin-form-sheet-trigger"
                       href="@Url.Action("YetkiDuzenle", "AdminPanel", new { id = p.Id })"
                       data-sheet-url="@Url.Action("YetkiDuzenle", "AdminPanel", new { id = p.Id })"
                       data-sheet-title="@p.AdSoyad Yetkileri"
                       data-sheet-variant="permission"><i class="bi bi-sliders2" aria-hidden="true"></i> Düzenle</a>
                </div>
            </div>
        }
    }
</section>
</div>

@await Html.PartialAsync("_AdminFormDrawer")

@section Scripts {
    <script src="~/js/admin-form-drawer.js" asp-append-version="true"></script>
}
