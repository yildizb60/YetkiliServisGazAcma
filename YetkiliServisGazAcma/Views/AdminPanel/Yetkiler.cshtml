@{
    ViewData["Title"] = "Yetkiler";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "Yetkiler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var personeller = ViewBag.Personeller as List<YetkiliServisGazAcma.Entities.AppKullanici>;
    var yetkiIsimler = ViewBag.YetkiIsimler as Dictionary<string, string> ?? new();
    var yetkiMap = ViewBag.YetkiMap as Dictionary<string, List<string>> ?? new();
    var yetkiSirketAdlariMap = ViewBag.YetkiSirketAdlariMap as Dictionary<string, List<string>> ?? new();
}

@section Styles {
    <style>
        .tablo-head,
        .tablo-row {
            grid-template-columns: 1.2fr 1.4fr 1.2fr 1.6fr .8fr;
        }

        .yetki-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .yetki-badge {
            background: var(--df-primary-soft);
            color: var(--df-primary);
            padding: 5px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
        }

        .legend {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 8px;
        }

        .legend-wrap {
            padding: 12px 20px 18px;
        }

        .matrix-card {
            background: #fff;
            border-radius: 8px;
            border: 1px solid var(--df-border);
            border-top: 3px solid var(--df-primary);
            margin-bottom: 12px;
            overflow: hidden;
            box-shadow: 0 1px 2px rgba(16, 24, 40, .04);
        }

        .matrix-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            min-height: 62px;
            padding: 10px 14px;
            border-bottom: 1px solid transparent;
            color: var(--df-text);
            background: #f8fbff;
            cursor: pointer;
            list-style: none;
        }

        .matrix-card[open] .matrix-head {
            border-bottom-color: var(--df-border);
        }

        .matrix-heading {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .matrix-heading > i {
            width: 32px;
            height: 32px;
            border-radius: 7px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--df-primary);
            background: var(--df-primary-soft);
        }

        .matrix-heading strong,
        .matrix-heading small {
            display: block;
        }

        .matrix-heading strong {
            font-size: 14px;
            font-weight: 700;
        }

        .matrix-heading small {
            margin-top: 2px;
            color: var(--df-muted);
            font-size: 10px;
            font-weight: 400;
            line-height: 1.45;
        }

        .matrix-toggle {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--df-primary);
            font-size: 11px;
            font-weight: 600;
        }

        .matrix-toggle .when-open,
        .matrix-card[open] .matrix-toggle .when-closed {
            display: none;
        }

        .matrix-card[open] .matrix-toggle .when-open {
            display: inline;
        }

        .matrix-card[open] .matrix-toggle i {
            transform: rotate(180deg);
        }

        .matrix-scroll {
            overflow-x: auto;
        }

        .matrix-table {
            width: 100%;
            border-collapse: collapse;
            margin: 6px 0 10px;
        }

        .matrix-table th {
            text-align: left;
            padding: 9px 16px;
            font-size: 10px;
            font-weight: 600 !important;
            color: #5f7388;
            background: #f6fbff;
            border-bottom: 1px solid #e2ecf6;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .matrix-table td {
            padding: 9px 16px;
            border-bottom: 1px solid #edf3fa;
            font-size: 12px;
            font-weight: 400;
            line-height: 1.5;
            color: #2e3c49;
            vertical-align: top;
        }

        .matrix-table tr:last-child td {
            border-bottom: none;
        }

        .matrix-table tbody tr:hover {
            background: #f8fcff;
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            border: 1px solid #d5e7f7;
            background: #eef7ff;
            color: #14558f;
        }

        .ok {
            color: #0b6e4f;
            font-weight: 500;
        }

        .no {
            color: #8b2f2f;
            font-weight: 500;
        }

        @@media (max-width: 960px) {
            .tablo-head,
            .tablo-row {
                grid-template-columns: 1fr;
                gap: 8px;
            }
        }
    </style>
}

<div class="df-admin-workspace df-permission-workspace">
<details class="matrix-card">
    <summary class="matrix-head">
        <span class="matrix-heading"><i class="bi bi-grid-3x3-gap"></i><span><strong>Rol - Yetki Matrisi</strong></span></span>
        <span class="matrix-toggle"><span class="when-closed">Matrisi Aç</span><span class="when-open">Matrisi Kapat</span><i class="bi bi-chevron-down"></i></span>
    </summary>
    <div class="matrix-scroll">
    <table class="matrix-table">
        <thead>
            <tr>
                <th>Rol</th>
                <th>Menü Görünürlüğü</th>
                <th>Sayfa Erişimi</th>
                <th>Yönetim İşlemleri</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><span class="role-badge">Süper Admin</span></td>
                <td class="ok">Tüm menüler görünür</td>
                <td class="ok">Tüm sayfalar</td>
                <td class="ok">Ekle / Düzenle / Sil / Onay + Kullanıcı yönetimi</td>
            </tr>
            <tr>
                <td><span class="role-badge">Şirket Admini</span></td>
                <td class="ok">Kendi şirketinin yönetim menüleri</td>
                <td class="ok">Kendi şirket verileri</td>
                <td class="ok">Personel, servis ve yetki yönetimi</td>
            </tr>
            <tr>
                <td><span class="role-badge">Personel (Tam Yetki)</span></td>
                <td class="ok">Yetki verilen şirketteki tüm menüler</td>
                <td class="ok">Yetkili olduğu şirket sayfaları</td>
                <td class="ok">Ekle / Düzenle / Sil / Onay</td>
            </tr>
            <tr>
                <td><span class="role-badge">Personel (Yetki Belgesi Onay)</span></td>
                <td class="ok">Yetki Belgesi Onayı + Belge Geçmişi</td>
                <td class="ok">Onay ekranlarına erişim</td>
                <td class="ok">Onay / Red işlemleri yapılır</td>
            </tr>
            <tr>
                <td><span class="role-badge">Personel (Rapor Gör)</span></td>
                <td class="ok">Raporlar menüsü görünür</td>
                <td class="ok">Rapor ekranı erişilebilir</td>
                <td class="no">Yönetim işlemi yok, sadece görüntüleme</td>
            </tr>
            <tr>
                <td><span class="role-badge">Personel (Marka Yönet)</span></td>
                <td class="ok">Markalar menüsü görünür</td>
                <td class="ok">Marka sayfalarına erişim</td>
                <td class="ok">Ekle / Düzenle / Sil</td>
            </tr>
            <tr>
                <td><span class="role-badge">Personel (YKC Talepleri Gör)</span></td>
                <td class="ok">Cihaz Değişim Talepleri menüsü görünür</td>
                <td class="ok">YKC talep listesi ve detay kayıtları</td>
                <td class="no">Atama, kontrol ve imza işlemi yapamaz</td>
            </tr>
            <tr>
                <td><span class="role-badge">Personel (YKC Atama ve Randevu)</span></td>
                <td class="ok">Cihaz Değişim Talepleri menüsü görünür</td>
                <td class="ok">YKC talep detayında yönlendirme/randevu alanı</td>
                <td class="ok">187 Acil veya mühendis yönlendirmesi ve randevu kaydı</td>
            </tr>
            <tr>
                <td><span class="role-badge">Personel (YKC FR265 ve İmza)</span></td>
                <td class="ok">Cihaz Değişim Talepleri menüsü görünür</td>
                <td class="ok">FR265 kontrol, önizleme ve imza akışı</td>
                <td class="ok">Kontrol sonucu, imzaya gönderme, imza durum sorgulama ve tamamlama</td>
            </tr>
            <tr>
                <td><span class="role-badge">Personel (YKC Raporları Gör)</span></td>
                <td class="ok">Cihaz Değişim Raporları menüsü görünür</td>
                <td class="ok">YKC rapor ekranı ve dışa aktarım</td>
                <td class="no">Operasyon kararı değiştirmez</td>
            </tr>
            <tr>
                <td><span class="role-badge">Personel (Yetkisiz)</span></td>
                <td class="ok">Ana Sayfa + Profilim daima görünür</td>
                <td class="ok">Marka / Şirket / Yetkili Servis listeleri görüntülenir</td>
                <td class="no">Ekle / Düzenle / Sil / Onay kapalı</td>
            </tr>
        </tbody>
    </table>
    </div>
</details>

<section class="df-admin-list-card df-permission-list">
    <div class="df-service-list-head">
        <div><h3><i class="bi bi-person-lock"></i> Personel Yetkileri</h3></div>
    </div>
    <div class="legend-wrap">
        <div class="legend">
            <span class="yetki-badge"><i class="bi bi-check2-circle"></i> Yetki Belgesi Onay</span>
            <span class="yetki-badge"><i class="bi bi-bar-chart-line"></i> Rapor Gör</span>
            <span class="yetki-badge"><i class="bi bi-person-gear"></i> Kullanıcı Yönet</span>
            <span class="yetki-badge"><i class="bi bi-building-check"></i> Marka Yönet</span>
            <span class="yetki-badge"><i class="bi bi-fire"></i> YKC Talep</span>
            <span class="yetki-badge"><i class="bi bi-calendar2-check"></i> YKC Atama</span>
            <span class="yetki-badge"><i class="bi bi-file-earmark-lock"></i> YKC FR265 / İmza</span>
            <span class="yetki-badge"><i class="bi bi-shield-lock"></i> Tam Yetki</span>
        </div>
    </div>
    <div class="tablo-head">
        <div>Ad Soyad</div><div>E-Posta</div><div>Şirket</div><div>Mevcut Yetkiler</div><div>İşlem</div>
    </div>
    @if (personeller == null || personeller.Count == 0)
    {
        <div class="empty">Personel kaydı yok</div>
    }
    else
    {
        foreach (var p in personeller)
        {
            var yetkiler = yetkiMap.ContainsKey(p.Id) ? yetkiMap[p.Id] : new List<string>();
            var sirketAdlari = yetkiSirketAdlariMap.ContainsKey(p.Id) ? yetkiSirketAdlariMap[p.Id] : new List<string>();

            <div class="tablo-row">
                <div>@(p.AdSoyad ?? "-")</div>
                <div>@(p.Email ?? "-")</div>
                <div>
                    @if (sirketAdlari.Count == 0)
                    {
                        <span style="color:#bbb;">-</span>
                    }
                    else
                    {
                        <div class="yetki-list">
                            @foreach (var sirketAdi in sirketAdlari)
                            {
                                <span class="yetki-badge">@sirketAdi</span>
                            }
                        </div>
                    }
                </div>
                <div>
                    @if (yetkiler.Count == 0)
                    {
                        <span style="color:#bbb;">-</span>
                    }
                    else
                    {
                        <div class="yetki-list">
                            @foreach (var y in yetkiler)
                            {
                                <span class="yetki-badge">@(yetkiIsimler.ContainsKey(y) ? yetkiIsimler[y] : y)</span>
                            }
                        </div>
                    }
                </div>
                <div>
                    <a class="btn-link" href="@Url.Action("YetkiDuzenle", "AdminPanel", new { id = p.Id })">Yetki Düzenle</a>
                </div>
            </div>
        }
    }
</section>
</div>
