@using YetkiliServisGazAcma.Models.ViewModels
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["PanelTitle"] = "Ana Sayfa";
    ViewData["PanelSubtitle"] = ViewBag.AdminDashboardAltBaslik as string ?? "Yönetim";
    ViewData["ActiveMenu"] = "Dashboard";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var onayBekleyen = ViewBag.OnayBekleyen is int ob ? ob : 0;
    var suresiBitecek = ViewBag.SuresiBitecek is int sb ? sb : 0;
    var toplamFirma = ViewBag.ToplamFirma is int tf ? tf : 0;
    var toplamSirket = ViewBag.ToplamSirket is int ts ? ts : 0;
    var toplamDevreyeAlma = ViewBag.ToplamDevreyeAlma is int td ? td : 0;
    var buAyDevreyeAlma = ViewBag.BuAyDevreyeAlma is int ba ? ba : 0;

    var kartlar = new List<DashboardTileViewModel>
    {
        new()
        {
            Title = "Yetki Belgesi Onayları",
            Url = Url.Action("OnayBekleyenler", "AdminPanel")!,
            Icon = "bi bi-file-earmark-check",
            Tone = "amber",
            MetricValue = onayBekleyen.ToString(),
            MetricLabel = "karar bekleyen belge",
            Stat1Label = "Bekleyen",
            Stat1Value = onayBekleyen.ToString(),
            Stat1Class = onayBekleyen > 0 ? "df-badge-pulse" : "df-tile-stat-val",
            Stat2Label = "Süre uyarısı",
            Stat2Value = suresiBitecek.ToString(),
            Featured = onayBekleyen > 0
        },
        new()
        {
            Title = "Yetkili Servis Yönetimi",
            Url = Url.Action("YetkiliServisler", "AdminPanel")!,
            Icon = "bi bi-building-check",
            Tone = "cyan",
            MetricValue = toplamFirma.ToString(),
            MetricLabel = "kayıtlı yetkili servis",
            Stat1Label = "Toplam servis",
            Stat1Value = toplamFirma.ToString(),
            Stat2Label = "Belge uyarısı",
            Stat2Value = suresiBitecek.ToString()
        },
        new()
        {
            Title = "Cihaz Devreye Alma Kayıtları",
            Url = Url.Action("DevreyeAlmalar", "AdminPanel")!,
            Icon = "bi bi-bag-check",
            Tone = "green",
            MetricValue = buAyDevreyeAlma.ToString(),
            MetricLabel = "bu ay kaydedilen işlem",
            Stat1Label = "Toplam kayıt",
            Stat1Value = toplamDevreyeAlma.ToString(),
            Stat2Label = "Bu ay",
            Stat2Value = buAyDevreyeAlma.ToString()
        },
        new()
        {
            Title = "Kullanıcı ve Yetki Yönetimi",
            Url = Url.Action("Kullanicilar", "AdminPanel")!,
            Icon = "bi bi-person-gear",
            Tone = "blue",
            MetricLabel = "hesap, rol ve erişim işlemleri",
            Stat1Label = "Kullanıcılar",
            Stat1Value = "Yönet",
            Stat2Label = "Yetkiler",
            Stat2Value = "Düzenle"
        },
        new()
        {
            Title = "Dağıtım Şirketleri",
            Url = Url.Action("Index", "DagitimSirket")!,
            Icon = "bi bi-buildings",
            Tone = "red",
            MetricValue = toplamSirket.ToString(),
            MetricLabel = "kayıtlı dağıtım şirketi",
            Stat1Label = "Şirket kapsamı",
            Stat1Value = toplamSirket.ToString(),
            Stat2Label = "Görünüm",
            Stat2Value = "Yönetim"
        }
    };
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<div class="df-dashboard role-dashboard admin-role-dashboard">
    <div class="section-label">
        <i class="bi bi-grid" aria-hidden="true"></i>
        Yönetim Alanları
    </div>

    <nav class="df-approval-grid role-card-grid admin-card-grid" aria-label="Yönetim alanları" style="--role-card-count:@kartlar.Count">
        @foreach (var kart in kartlar)
        {
            <a class="df-atile is-@kart.Tone @(kart.Featured ? "is-featured" : "")" href="@kart.Url" aria-label="@(kart.Featured ? "Öncelikli: " + kart.Title : kart.Title)">
                <div class="df-atile-top">
                    <div class="df-atile-icon"><i class="@kart.Icon" aria-hidden="true"></i></div>
                    <div class="df-atile-name">@kart.Title</div>
                    <i class="bi bi-arrow-right admin-tile-arrow" aria-hidden="true"></i>
                </div>
                <div class="admin-tile-metric @(string.IsNullOrWhiteSpace(kart.MetricValue) ? "is-text" : "")">
                    @if (!string.IsNullOrWhiteSpace(kart.MetricValue))
                    {
                        <strong>@kart.MetricValue</strong>
                    }
                    <span>@kart.MetricLabel</span>
                </div>
                <dl class="admin-tile-stats">
                    <div><dt>@kart.Stat1Label</dt><dd class="@kart.Stat1Class">@kart.Stat1Value</dd></div>
                    <div><dt>@kart.Stat2Label</dt><dd class="@kart.Stat2Class">@kart.Stat2Value</dd></div>
                </dl>
            </a>
        }
    </nav>

    <section class="admin-command-grid" aria-label="Operasyon özeti">
        <article class="admin-command-panel">
            <header><span><i class="bi bi-inboxes" aria-hidden="true"></i></span><div><h2>Bekleyen İşler</h2><small>Karar ve süre takibi</small></div></header>
            <div class="admin-command-rows">
                <a href="@Url.Action("OnayBekleyenler", "AdminPanel")"><span><i class="bi bi-file-earmark-check" aria-hidden="true"></i><strong>Yetki belgesi kararları</strong></span><em class="@(onayBekleyen > 0 ? "is-warning" : "")">@onayBekleyen</em><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                <a href="@Url.Action("YetkiBelgesiUyarilari", "AdminPanel")"><span><i class="bi bi-calendar2-x" aria-hidden="true"></i><strong>Süre uyarısı bulunan belgeler</strong></span><em class="@(suresiBitecek > 0 ? "is-danger" : "")">@suresiBitecek</em><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
            </div>
        </article>

        <article class="admin-command-panel is-scope">
            <header><span><i class="bi bi-diagram-3" aria-hidden="true"></i></span><div><h2>Sistem Kapsamı</h2><small>Aktif yönetim görünümü</small></div></header>
            <dl class="admin-scope-stats">
                <div><dt>Dağıtım Şirketi</dt><dd>@toplamSirket</dd></div>
                <div><dt>Yetkili Servis</dt><dd>@toplamFirma</dd></div>
                <div><dt>Devreye Alma Kaydı</dt><dd>@toplamDevreyeAlma</dd></div>
                <div><dt>Bu Ay Kaydedilen</dt><dd>@buAyDevreyeAlma</dd></div>
            </dl>
        </article>
    </section>
</div>
