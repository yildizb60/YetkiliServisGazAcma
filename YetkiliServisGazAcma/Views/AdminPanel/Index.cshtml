@using YetkiliServisGazAcma.Models.ViewModels
@using YetkiliServisGazAcma.Entities
@{
    ViewData["Title"] = "Yönetim Genel Bakışı";
    ViewData["PanelTitle"] = "Genel Bakış";
    ViewData["PanelSubtitle"] = ViewBag.AdminDashboardAltBaslik as string ?? "Yönetim";
    ViewData["ActiveMenu"] = "Dashboard";
    ViewData["ContentClass"] = "personnel-home-content role-dashboard-content";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var onayBekleyen = Sayi(ViewBag.OnayBekleyen);
    var suresiBitecek = Sayi(ViewBag.SuresiBitecek);
    var toplamFirma = Sayi(ViewBag.ToplamFirma);
    var buAyDevreyeAlma = Sayi(ViewBag.BuAyDevreyeAlma);
    var genelSistemAdminMi = ViewBag.GenelSistemAdminMi as bool? ?? false;
    var sirketAdminMi = User.IsInRole(KullaniciRolAdlari.SirketAdmin);
    var adminRoluVar = genelSistemAdminMi || sirketAdminMi;
    var rolAdi = ViewBag.AdminDashboardAltBaslik as string ?? (genelSistemAdminMi ? "Genel Sistem Admini" : "Şirket Admini");
    var actions = new List<DashboardTileViewModel>();

    if (adminRoluVar)
    {
        actions.Add(new DashboardTileViewModel
        {
            Title = "Yetki Belgesi İşlemleri", Url = Url.Action("OnayBekleyenler", "AdminPanel")!, Icon = "bi bi-file-earmark-check-fill",
            MetricLabel = "Belge kararları ve süre takibi", Tone = "amber", Featured = onayBekleyen > 0
        });
        actions.Add(new DashboardTileViewModel
        {
            Title = "Yetkili Servis Yönetimi", Url = Url.Action("YetkiliServisler", "AdminPanel")!, Icon = "bi bi-building-check",
            MetricLabel = "Servis kayıtları ve yetkiler", Tone = "cyan"
        });
        actions.Add(new DashboardTileViewModel
        {
            Title = "Cihaz Devreye Alma", Url = Url.Action("DevreyeAlmalar", "AdminPanel")!, Icon = "bi bi-tools",
            MetricLabel = "Kayıt ve sonuç takibi", Tone = "green"
        });
        actions.Add(new DashboardTileViewModel
        {
            Title = "Cihaz Değişim İşlemleri", Url = Url.Action("Talepler", "Ykc")!, Icon = "bi bi-fire",
            MetricLabel = "Talep ve randevuları yönet", Subtitle = "Cihaz değişim süreci", Tone = "blue"
        });
        actions.Add(new DashboardTileViewModel
        {
            Title = "Kullanıcı ve Yetkiler", Url = Url.Action("Kullanicilar", "AdminPanel")!, Icon = "bi bi-people",
            MetricLabel = "Hesap ve erişimleri yönet", Subtitle = "Kullanıcı yönetimi", Tone = "blue"
        });
        actions.Add(new DashboardTileViewModel
        {
            Title = "Şube Yönetimi", Url = Url.Action("Subeler", "AdminPanel")!, Icon = "bi bi-diagram-3",
            MetricLabel = "Şube kapsamını görüntüle", Subtitle = "Şube yönetimi", Tone = "green"
        });
        if (genelSistemAdminMi)
        {
            actions.Add(new DashboardTileViewModel
            {
                Title = "Yetkili Servis Markaları", Url = Url.Action("Index", "Marka")!, Icon = "bi bi-tags",
                MetricLabel = "Marka kapsamını yönet", Subtitle = "Marka yönetimi", Tone = "amber"
            });
        }
    }

    var quickActions = new List<DashboardTileViewModel>
    {
        new()
        {
            Title = "Belge süre uyarıları", Url = Url.Action("YetkiBelgesiUyarilari", "AdminPanel")!, Icon = "bi bi-calendar2-x",
            MetricValue = suresiBitecek.ToString(), MetricLabel = "uyarı", Subtitle = "Süre takibi",
            Tone = "amber", Featured = suresiBitecek > 0
        },
        new()
        {
            Title = "Bu ay kaydedilen cihaz işlemleri", Url = Url.Action("DevreyeAlmalar", "AdminPanel")!, Icon = "bi bi-tools",
            MetricValue = buAyDevreyeAlma.ToString(), MetricLabel = "kayıt", Subtitle = "Cihaz devreye alma", Tone = "green"
        }
    };

    var dashboardModel = new RoleDashboardViewModel
    {
        Variant = genelSistemAdminMi ? "system-admin" : "company-admin",
        AriaLabel = $"{rolAdi} yönetim özeti",
        HeroTitle = genelSistemAdminMi ? "Genel Sistem Admin Paneli" : "Şirket Admin Paneli",
        HeroKicker = string.Empty,
        HeroKickerIcon = "bi bi-shield-check",
        HeroImageUrl = "/images/hero/admin-yonetim-dashboard.png",
        ActionsTitle = "Yönetim Alanları",
        QuickActionsTitle = "Güncel Hareket",
        QuickActionsMeta = "Güncel durum",
        Facts = new List<RoleDashboardFactViewModel>
        {
            new() { Icon = "bi bi-file-earmark-check-fill", Value = onayBekleyen.ToString(), Label = "karar bekleyen belge", Url = Url.Action("OnayBekleyenler", "AdminPanel") },
            new() { Icon = "bi bi-building-check", Value = toplamFirma.ToString(), Label = "yetkili servis", Url = Url.Action("YetkiliServisler", "AdminPanel") }
        },
        Actions = actions,
        QuickActions = quickActions,
        ShowYkcCalendar = true,
        YkcCalendarTitle = "Takvim"
    };
}
@functions {
    private static int Sayi(object? value)
    {
        if (value is int sayi) return Math.Max(sayi, 0);
        return int.TryParse(value?.ToString(), out var sonuc) ? Math.Max(sonuc, 0) : 0;
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/personnel-home.css" asp-append-version="true" />
}

@await Html.PartialAsync("_RoleDashboard", dashboardModel)

@section Scripts {
    <script src="~/js/dashboard-carousel.js" asp-append-version="true"></script>
}
