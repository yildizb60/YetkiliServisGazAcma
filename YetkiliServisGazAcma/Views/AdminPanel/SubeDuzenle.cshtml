@using YetkiliServisGazAcma.Entities
@using YetkiliServisGazAcma.Models.ViewModels
@{
    Layout = null;
    var sube = ViewBag.Sube as AdminSubeDto ?? new();
}
@await Html.PartialAsync("_BranchEditor", new BranchEditorViewModel
{
    Branch = sube,
    CanSelectFirm = true,
    Firms = ViewBag.Firmalar as List<AdminSubeFirmaDto> ?? new(),
    PostUrl = Url.Action("SubeDuzenle", "AdminPanel", new { id = sube.Id })!
})
