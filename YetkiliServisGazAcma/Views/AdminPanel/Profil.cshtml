@{
    ViewData["Title"] = "Profil Yönetimi";
    ViewData["PanelTitle"] = "Profilim";
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "Profil";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var kullanici = ViewBag.Kullanici as YetkiliServisGazAcma.Entities.AppKullanici;
    var adSoyad = kullanici?.AdSoyad ?? "Sistem Yöneticisi";
    var email = kullanici?.Email ?? "-";
    var tel = kullanici?.PhoneNumber ?? "";
    var basHarf = !string.IsNullOrEmpty(adSoyad) ? adSoyad.Substring(0, 1).ToUpper() : "A";
    var rolAdi = ViewBag.GenelSistemAdminMi == true
        ? "Genel Sistem Admini"
        : kullanici?.KullaniciTipi switch
        {
            YetkiliServisGazAcma.Business.Services.KullaniciTipiDegerleri.SirketAdmin => "Şirket Yöneticisi",
            YetkiliServisGazAcma.Business.Services.KullaniciTipiDegerleri.Personel => "Şirket Personeli",
            YetkiliServisGazAcma.Business.Services.KullaniciTipiDegerleri.YetkiliServis => "Yetkili Servis",
            YetkiliServisGazAcma.Business.Services.KullaniciTipiDegerleri.SertifikaliFirma => "Sertifikalı Firma",
            _ => "Kullanıcı"
        };
}

<div class="df-profile-workspace">
    @if (TempData["Basarili"] != null) { <div class="df-alert df-alert-success">@TempData["Basarili"]</div> }
    @if (TempData["SifreBasarili"] != null) { <div class="df-alert df-alert-success">@TempData["SifreBasarili"]</div> }
    @if (TempData["SifreHata"] != null) { <div class="df-alert df-alert-danger">@TempData["SifreHata"]</div> }

    <section class="df-page-panel df-profile-header">
        <div class="df-profile-header-inner">
            <div class="df-profile-avatar">@basHarf</div>
            <div class="df-profile-heading"><h2>@adSoyad</h2><p>@email</p></div>
            <div class="df-profile-header-meta">
                <span class="df-pill df-pill-info"><i class="bi bi-shield-check"></i> @rolAdi</span>
                <span class="df-pill @(kullanici?.AktifMi == true ? "df-pill-success" : "df-pill-danger")">@(kullanici?.AktifMi == true ? "Aktif" : "Pasif")</span>
            </div>
        </div>
    </section>

    <div class="df-profile-grid">
        <section class="df-profile-section is-account">
            <div class="df-profile-section-head"><i class="bi bi-person-vcard"></i><div><strong>İletişim Bilgileri</strong><small>Profilde görünen temel bilgiler</small></div></div>
            <div class="df-profile-section-body">
                <form method="post" action="/AdminPanel/profil-guncelle">
                    @Html.AntiForgeryToken()
                    <div class="df-profile-form-grid">
                        <div class="df-profile-field is-wide"><label>Ad Soyad</label><input type="text" name="adSoyad" value="@adSoyad" required /></div>
                        <div class="df-profile-field"><label>E-posta</label><input type="email" name="email" value="@email" required /></div>
                        <div class="df-profile-field"><label>Telefon</label><input type="text" name="telefon" value="@tel" autocomplete="tel" /></div>
                    </div>
                    <div class="df-profile-actions"><button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2"></i> Bilgileri Kaydet</button></div>
                </form>
            </div>
        </section>

        <section class="df-profile-section is-security">
            <div class="df-profile-section-head"><i class="bi bi-key"></i><div><strong>Şifre Değiştir</strong><small>Hesap güvenliği</small></div></div>
            <div class="df-profile-section-body">
                <form method="post" action="/AdminPanel/sifre-degistir">
                    @Html.AntiForgeryToken()
                    <div class="df-profile-form-grid">
                        <div class="df-profile-field is-wide"><label>Mevcut Şifre</label><input type="password" name="mevcutSifre" autocomplete="current-password" required /></div>
                        <div class="df-profile-field"><label>Yeni Şifre</label><input type="password" name="yeniSifre" autocomplete="new-password" required /></div>
                        <div class="df-profile-field"><label>Yeni Şifre Tekrar</label><input type="password" name="yeniSifreTekrar" autocomplete="new-password" required /></div>
                    </div>
                    <div class="df-profile-actions"><button type="submit" class="df-btn df-btn-secondary df-btn-sm"><i class="bi bi-lock"></i> Şifreyi Güncelle</button></div>
                </form>
            </div>
        </section>

        <section class="df-profile-section is-context is-wide">
            <div class="df-profile-section-head"><i class="bi bi-person-lock"></i><div><strong>Hesap Özeti</strong><small>Değiştirilemeyen sistem bilgileri</small></div></div>
            <dl class="df-profile-info-grid">
                <div><dt>Kullanıcı Adı</dt><dd>@(kullanici?.UserName ?? "-")</dd></div>
                <div><dt>Rol</dt><dd>@rolAdi</dd></div>
                <div><dt>Hesap Durumu</dt><dd>@(kullanici?.AktifMi == true ? "Aktif" : "Pasif")</dd></div>
                <div><dt>E-posta Onayı</dt><dd>@(kullanici?.EmailConfirmed == true ? "Onaylandı" : "Onaylanmadı")</dd></div>
            </dl>
        </section>
    </div>
</div>
