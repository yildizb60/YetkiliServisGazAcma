@model YetkiliServisGazAcma.Entities.Ys_Firma
@{
    ViewData["Title"] = "Yetkili Servis Düzenle";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "YetkiliServisler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var servis = Model ?? ViewBag.Servis as YetkiliServisGazAcma.Entities.Ys_Firma;
    var sehirler = ViewBag.Sehirler as List<string> ?? new();
    var sehirFirmaKodlari = ViewBag.SehirFirmaKodlari as Dictionary<string, string> ?? new();
    var kategoriler = ViewBag.Kategoriler as List<YetkiliServisGazAcma.Entities.UrunKategori> ?? new();
    var seciliKategoriler = ViewBag.SeciliKategoriler as List<int> ?? new();
}

<div class="df-admin-workspace df-admin-editor df-service-create-workspace df-management-form">

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            <form class="df-admin-service-editor-form is-edit" method="post" action="/AdminPanel/yetkiliservisler/duzenle/@servis?.Id">
                @Html.AntiForgeryToken()
                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-buildings"></i></span>
                        <div>
                            <h3>Firma ve İletişim Bilgileri</h3>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                    <div class="df-admin-field"><label for="admin-service-edit-name">Firma Adı *</label><input id="admin-service-edit-name" type="text" name="firmaAdi" value="@servis?.FirmaAdi" placeholder="Yetkili servis firma adı" required /></div>
                    <div class="df-admin-field"><label for="admin-service-edit-contact">Yetkili Kişi</label><input id="admin-service-edit-contact" type="text" name="yetkiliKisi" value="@servis?.YetkiliKisi" placeholder="Ad soyad" /></div>
                    <div class="df-admin-field"><label for="admin-service-edit-phone">Telefon</label><input id="admin-service-edit-phone" type="text" name="telefon" value="@servis?.Telefon" placeholder="0(---) --- -- --" /></div>
                    <div class="df-admin-field"><label for="admin-service-edit-email">E-Posta</label><input id="admin-service-edit-email" type="email" name="email" value="@servis?.Email" placeholder="firma@ornek.com" /></div>
                    <div class="df-admin-field">
                        <label for="admin-service-edit-city">Şehir *</label>
                        <select id="admin-service-edit-city" name="faaliyetIli" data-firma-kodu-select required>
                            <option value="">Seçiniz</option>
                            @foreach (var sehir in sehirler)
                            {
                                var firmaKodu = sehirFirmaKodlari.TryGetValue(sehir, out var kod) ? kod : "";
                                <option value="@sehir" data-firma-kodu="@firmaKodu" selected="@(string.Equals(servis?.FaaliyetIli, sehir, StringComparison.CurrentCultureIgnoreCase))">@sehir</option>
                            }
                        </select>
                        <div class="firma-kodu-hint" data-firma-kodu-target></div>
                    </div>
                    <div class="df-admin-field"><label for="admin-service-edit-tax-no">Vergi No</label><input id="admin-service-edit-tax-no" type="text" name="vergiNo" value="@servis?.VergiNo" placeholder="Vergi kimlik numarası" /></div>
                    <div class="df-admin-field"><label for="admin-service-edit-tax-office">Vergi Dairesi</label><input id="admin-service-edit-tax-office" type="text" name="vergiDairesi" value="@servis?.VergiDairesi" placeholder="Vergi dairesi" /></div>
                    <div class="df-admin-field is-wide"><label for="admin-service-edit-address">Adres</label><input id="admin-service-edit-address" type="text" name="adres" value="@servis?.Adres" placeholder="Firma adresi" /></div>
                    </div>
                </section>

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-patch-check"></i></span>
                        <div><h3>Hizmet ve Kayıt Bilgileri</h3></div>
                    </div>
                    <div class="df-admin-choice-layout df-admin-service-settings">
                    <div class="df-admin-choice-box df-admin-scope-box">
                        <h3 class="df-admin-section-title is-scope"><i class="bi bi-ui-checks"></i> Hizmet Türleri</h3>
                        <div class="df-admin-choice-list">
                            @foreach (var kategori in kategoriler)
                            {
                                <label class="df-admin-choice">
                                    <input type="checkbox" name="kategoriIds" value="@kategori.Id" checked="@(seciliKategoriler.Contains(kategori.Id))" />
                                    <span class="df-admin-choice-icon">
                                        @if (!string.IsNullOrWhiteSpace(kategori.IconUrl))
                                        {
                                            <img src="@kategori.IconUrl" alt="" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-box-seam"></i>
                                        }
                                    </span>
                                    <span>@kategori.Ad</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="df-admin-choice-box df-admin-status-box">
                        <h3 class="df-admin-section-title is-scope"><i class="bi bi-toggle-on"></i> Kayıt Durumu</h3>
                        <div class="df-admin-choice-list">
                        <label class="df-admin-choice">
                            <input type="radio" name="aktifMi" value="true" checked="@(servis?.AktifMi == true)" />
                            <span class="df-admin-choice-icon"><i class="bi bi-check-circle"></i></span>
                            <span>Aktif</span>
                        </label>
                        <label class="df-admin-choice">
                            <input type="radio" name="aktifMi" value="false" checked="@(servis?.AktifMi == false)" />
                            <span class="df-admin-choice-icon"><i class="bi bi-slash-circle"></i></span>
                            <span>Pasif</span>
                        </label>
                        </div>
                    </div>
                    </div>
                </section>

                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/AdminPanel/yetkiliservisler"><i class="bi bi-x-lg"></i> Vazgeç</a>
                    <button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2"></i> Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
<script>
    (function () {
        var sehirSelect = document.querySelector("[data-firma-kodu-select]");
        var firmaTarget = document.querySelector("[data-firma-kodu-target]");
        function firmaKoduGuncelle() {
            if (!sehirSelect || !firmaTarget) return;
            var option = sehirSelect.options[sehirSelect.selectedIndex];
            var firmaKodu = option ? option.getAttribute("data-firma-kodu") : "";
            firmaTarget.textContent = firmaKodu ? "Bağlı firma kodu: " + firmaKodu : "";
            firmaTarget.classList.toggle("is-visible", !!firmaKodu);
        }
        if (sehirSelect) {
            sehirSelect.addEventListener("change", firmaKoduGuncelle);
            firmaKoduGuncelle();
        }
    })();
</script>
}
