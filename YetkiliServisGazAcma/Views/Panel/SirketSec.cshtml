@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Çalışma Şirketini Seçin";
    var kullanici = ViewBag.Kullanici as YetkiliServisGazAcma.Entities.AppKullanici;
    var sirketler = ViewBag.Sirketler as List<YetkiliServisGazAcma.Entities.Dag_Sirket> ?? new();
    int? aktifSirketId = ViewBag.AktifSirketId as int?;
    var genelSistemAdminMi = ViewBag.GenelSistemAdminMi as bool? ?? false;
    string returnUrl = ViewBag.ReturnUrl as string ?? "/personel-panel";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
}

<main class="login-shell">
    <section class="login-side" aria-label="Çalışma şirketi seçimi">
    <div class="login-card" data-company-step>
        <a class="login-brand" href="/giris" aria-label="Giriş sayfası"><img src="/images/company/corumgaz-kargaz-surmeligaz-logo.png" alt="Çorumgaz, Kargaz ve Sürmeligaz" /></a>
        <header class="login-card-head">
            <div>
                <h1 id="company-select-title">Çalışma Şirketi</h1>
                <p>@(kullanici?.AdSoyad ?? "Kullanıcı")</p>
            </div>
        </header>
        <div>
            @if (TempData["Hata"] != null) { <div class="login-message is-error">@TempData["Hata"]</div> }
            <form method="post" action="/panel/sirket-sec">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="company-select-list" role="radiogroup" aria-label="Dağıtım şirketi">
                    @if (genelSistemAdminMi)
                    {
                        var selectedAll = !aktifSirketId.HasValue;
                        <label class="company-select-option @(selectedAll ? "is-selected" : "")">
                            <input type="radio" name="sirketId" value="0" required checked="@(selectedAll ? "checked" : null)" />
                            <span class="company-select-option-icon"><i class="bi bi-grid" aria-hidden="true"></i></span>
                            <span><strong>Tüm Şirketler</strong><small>Genel yönetim ve tüm kayıtlar</small></span>
                            <i class="bi bi-check-circle-fill company-select-check" aria-hidden="true"></i>
                        </label>
                    }
                    @foreach (var sirket in sirketler)
                    {
                        var selected = aktifSirketId == sirket.Id;
                        <label class="company-select-option @(selected ? "is-selected" : "")">
                            <input type="radio" name="sirketId" value="@sirket.Id" required checked="@(selected ? "checked" : null)" />
                            <span class="company-select-option-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
                            <span><strong>@sirket.SirketAdi</strong><small>@(string.IsNullOrWhiteSpace(sirket.Il) ? "Şirket kaydı" : sirket.Il)</small></span>
                            <i class="bi bi-check-circle-fill company-select-check" aria-hidden="true"></i>
                        </label>
                    }
                </div>
                <div class="company-select-actions">
                    <a class="login-secondary" href="/cikis"><i class="bi bi-box-arrow-left" aria-hidden="true"></i> Güvenli Çıkış</a>
                    <button class="login-submit" type="submit"><span>Panele Geç</span><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                </div>
            </form>
        </div>
    </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/login-flow.js" asp-append-version="true"></script>
}
