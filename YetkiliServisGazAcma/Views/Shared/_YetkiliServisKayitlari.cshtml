@model List<YetkiliServisGazAcma.Entities.Ys_Firma>
@{
    var adminMi = ViewData["ServiceDirectoryAdmin"] is true;
    var servisYonetebilir = ViewData["ServiceDirectoryCanManage"] is true;
    var temelYol = adminMi ? "/AdminPanel/yetkiliservisler" : "/personel-panel/yetkiliservisler";
    var devreyeSayilari = ViewBag.DevreyeSayilari as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="df-service-table-scroll">
    <div class="df-service-grid df-service-grid-head">
        <div>Firma Adı</div><div>Yetkili Ad Soyad</div><div>İletişim</div><div>Şehir</div><div>Cihaz Devreye Alma</div><div>Durum</div><div class="df-service-grid-actions-heading">İşlemler</div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="df-empty"><div class="df-empty-title">Yetkili servis kaydı bulunamadı.</div><p class="df-empty-text">Filtreleri temizleyip yeniden deneyin.</p></div>
    }
    else
    {
        <div class="df-service-records">
            @foreach (var servis in Model)
            {
                var devreyeSayisi = devreyeSayilari.TryGetValue(servis.Id, out var sayi) ? sayi : 0;
                var detayId = $"servis-detay-{servis.Id}";
                var markaAdlari = string.Join(", ", servis.FirmaMarkalar?.Where(x => x.Marka != null && !string.IsNullOrWhiteSpace(x.Marka.MarkaAdi)).Select(x => x.Marka!.MarkaAdi) ?? Enumerable.Empty<string?>());
                var kategoriAdlari = string.Join(", ", servis.FirmaKategoriler?
                    .Where(x => !x.SilindiMi && x.Kategori != null && !x.Kategori.SilindiMi && x.Kategori.AktifMi && !string.IsNullOrWhiteSpace(x.Kategori.Ad))
                    .Select(x => x.Kategori!.Ad).Distinct() ?? Enumerable.Empty<string?>());
                <article class="df-service-record @(servis.AktifMi ? "is-active" : "is-passive")" data-service-record data-service-id="@servis.Id">
                    <div class="df-service-grid df-service-row">
                        <div><span class="df-service-name">@(servis.FirmaAdi ?? "-")</span></div>
                        <div><span class="df-service-person">@(string.IsNullOrWhiteSpace(servis.YetkiliKisi) ? "Tanımlı değil" : servis.YetkiliKisi)</span></div>
                        <div class="df-service-contact"><span>@(string.IsNullOrWhiteSpace(servis.Telefon) ? "Telefon tanımlı değil" : servis.Telefon)</span></div>
                        <div class="df-service-city"><i class="bi bi-geo-alt" aria-hidden="true"></i><span>@(servis.FaaliyetIli ?? "-")</span></div>
                        <div><span class="df-service-volume" aria-label="@devreyeSayisi cihaz devreye alma kaydı"><strong>@devreyeSayisi</strong><span>kayıt</span></span></div>
                        <div><span class="df-service-state @(servis.AktifMi ? "is-active" : "is-passive")">@(servis.AktifMi ? "Aktif" : "Pasif")</span></div>
                        <div class="df-service-actions">
                            @if (servisYonetebilir)
                            {
                                <a class="df-directory-action js-service-sheet-trigger"
                                   href="@temelYol/duzenle/@servis.Id"
                                   data-sheet-url="@temelYol/duzenle/@servis.Id"
                                   data-sheet-title="Yetkili Servisi Düzenle"
                                   title="Servisi düzenle"
                                   aria-label="@(servis.FirmaAdi ?? "Yetkili servis") kaydını düzenle"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                @if (devreyeSayisi > 0)
                                {
                                    <button type="button" class="df-directory-action is-disabled" disabled title="Bu servisin devreye alma kaydı olduğu için silinemez." aria-label="Servis silinemez"><i class="bi bi-lock" aria-hidden="true"></i></button>
                                }
                                else
                                {
                                    <form method="post" action="@temelYol/sil/@servis.Id" data-toast-confirm data-confirm-title="Yetkili servisi sil" data-confirm-message="@servis.FirmaAdi adlı servis silinecek. Bu işlem geri alınamaz." data-confirm-action="Servisi Sil">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="df-directory-action is-danger" title="Servisi sil" aria-label="@(servis.FirmaAdi ?? "Yetkili servis") kaydını sil"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                    </form>
                                }
                            }
                            <button type="button" class="df-directory-action df-service-expand" data-service-expand aria-expanded="false" aria-controls="@detayId" title="Satır ayrıntılarını aç"><i class="bi bi-chevron-down" aria-hidden="true"></i><span class="visually-hidden">Satır ayrıntılarını aç</span></button>
                        </div>
                    </div>
                    <div class="df-service-record-detail" id="@detayId" aria-hidden="true" hidden>
                        <div class="df-service-record-detail-inner">
                            <div class="df-service-detail-grid">
                                <div><span>E-posta</span><strong>@(string.IsNullOrWhiteSpace(servis.Email) ? "Tanımlı değil" : servis.Email)</strong></div>
                                <div><span>Vergi bilgisi</span><strong>@(string.IsNullOrWhiteSpace(servis.VergiNo) ? "Numara tanımlı değil" : servis.VergiNo)</strong><small>@(string.IsNullOrWhiteSpace(servis.VergiDairesi) ? "Vergi dairesi tanımlı değil" : servis.VergiDairesi)</small></div>
                                <div><span>Bağlı dağıtım şirketi</span><strong>@(string.IsNullOrWhiteSpace(servis.Sirket?.SirketAdi) ? "Şirket bilgisi tanımlı değil" : servis.Sirket.SirketAdi)</strong></div>
                                <div><span>Yetkili markalar</span><strong>@(string.IsNullOrWhiteSpace(markaAdlari) ? "Marka atanmamış" : markaAdlari)</strong></div>
                                <div><span>Hizmet kategorileri</span><strong>@(string.IsNullOrWhiteSpace(kategoriAdlari) ? "Kategori atanmamış" : kategoriAdlari)</strong></div>
                                <div><span>Açık adres</span><strong>@(string.IsNullOrWhiteSpace(servis.Adres) ? "Adres tanımlı değil" : servis.Adres)</strong></div>
                            </div>
                            @if (adminMi)
                            {
                                <div class="df-service-detail-footer">
                                    <span><i class="bi bi-wrench-adjustable-circle" aria-hidden="true"></i> @devreyeSayisi devreye alma kaydı</span>
                                    <a class="df-btn df-btn-secondary df-btn-sm" href="@temelYol/detay/@servis.Id">Tüm ayrıntılar <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                                </div>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
