@{
    var path = Context?.Request?.Path.ToString() ?? "";
    var activeMenu = (ViewData["ActiveMenu"] ?? ViewBag.ActiveMenu)?.ToString() ?? "";
    var panelArea = (ViewData["PanelArea"] ?? ViewBag.PanelArea)?.ToString() ?? "";
    var isPersonelPanel = string.Equals(panelArea, "Personel", StringComparison.OrdinalIgnoreCase)
        || (string.IsNullOrWhiteSpace(panelArea) && path.StartsWith("/personel-panel", StringComparison.OrdinalIgnoreCase));
    var isYetkiliServisPanel = string.Equals(panelArea, "YetkiliServis", StringComparison.OrdinalIgnoreCase)
        || (string.IsNullOrWhiteSpace(panelArea) && (
            path.StartsWith("/ys-panel", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("/ys-devreyeal", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("/ys-yetki-belgesi", StringComparison.OrdinalIgnoreCase)));
    var isSertifikaliFirmaPanel = string.Equals(panelArea, "SertifikaliFirma", StringComparison.OrdinalIgnoreCase)
        || (User.IsInRole("SertifikaliFirma") && path.StartsWith("/ykc", StringComparison.OrdinalIgnoreCase));
    var genelSistemAdminMi = (ViewBag.GenelSistemAdminMi as bool?)
        ?? (User.IsInRole("GenelSistemAdmin") || User.IsInRole("SuperAdmin"));
    var sirketAdminMi = User.IsInRole("SirketAdmin");
    var personelMi = User.IsInRole("Personel");
    var ykcYetkileri = ViewBag.YkcYetkileri as YkcYetkiOzeti ?? new YkcYetkiOzeti();

    string? panelAltBaslik = isSertifikaliFirmaPanel
        ? "Sertifikalı Firma"
        : isYetkiliServisPanel
        ? null
        : isPersonelPanel
            ? null
            : genelSistemAdminMi
                ? "Genel Sistem Admini"
                : sirketAdminMi
                    ? "Şirket Admini"
                    : personelMi
                        ? "Personel Paneli"
                        : "Admin Paneli";
    var panelAnaBaslik = isSertifikaliFirmaPanel
        ? "Cihaz Değişim"
        : isYetkiliServisPanel
            ? "Yetkili Servis"
            : isPersonelPanel
                ? "Personel Paneli"
                : "Yönetim Paneli";

    string Active(string key, params string[] prefixes)
    {
        if (string.Equals(activeMenu, key, StringComparison.OrdinalIgnoreCase))
            return " active";

        return prefixes.Any(prefix => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            ? " active"
            : "";
    }

    string ActiveExact(string key, params string[] exactPaths)
    {
        if (string.Equals(activeMenu, key, StringComparison.OrdinalIgnoreCase))
            return " active";

        return exactPaths.Any(exact => string.Equals(path, exact, StringComparison.OrdinalIgnoreCase))
            ? " active"
            : "";
    }

    string ActiveUnless(string key, string excludedActiveMenu, params string[] prefixes)
    {
        if (string.Equals(activeMenu, excludedActiveMenu, StringComparison.OrdinalIgnoreCase)
            || string.Equals(activeMenu, "YkcTakvim", StringComparison.OrdinalIgnoreCase))
            return "";

        return Active(key, prefixes);
    }
}
@{
    var groups = new List<(string Title, string Icon, List<(string Text, string Url, string Icon, string Active)> Links)>();
    void Group(string title, string icon, params (string Text, string Url, string Icon, string Active)[] links)
    {
        if (links.Length > 0) groups.Add((title, icon, links.ToList()));
    }
    var home = isYetkiliServisPanel ? "/ys-panel" : isSertifikaliFirmaPanel ? "/ykc" : isPersonelPanel ? "/personel-panel" : "/AdminPanel";
    var homeActive = ActiveExact(isSertifikaliFirmaPanel ? "YkcOzet" : "Dashboard", home, home + "/index");
    if (isYetkiliServisPanel)
    {
        Group("Cihaz Devreye Alma", "bi-bag-check",
            ("Yeni Devreye Alma", "/ys-devreyeal", "bi-plus-lg", ActiveExact("DevreyeAl", "/ys-devreyeal")),
            ("İşlem Geçmişi", "/ys-devreyeal/gecmis", "bi-clock-history", Active("DevreyeGecmis", "/ys-devreyeal/gecmis", "/ys-devreyeal/detay")),
            ("Raporlar", "/ys-panel/raporlar", "bi-bar-chart-line", Active("Raporlar", "/ys-panel/raporlar")));
        Group("Yetkili Servis İşlemleri", "bi-tools",
            ("Yetki Belgem", "/ys-yetki-belgesi", "bi-file-earmark-check", Active("YetkiBelgesi", "/ys-yetki-belgesi")),
            ("Hizmet Verdiğim Markalar", "/ys-panel/markalar", "bi-tag", Active("Markalar", "/ys-panel/markalar")),
            ("Şubelerim", "/ys-panel/subeler", "bi-building", Active("Subeler", "/ys-panel/subeler")));
        Group("Hesabım", "bi-person-circle",
            ("Profilim", "/ys-panel/profil", "bi-person", Active("Profil", "/ys-panel/profil")));
    }
    else if (isSertifikaliFirmaPanel)
    {
        Group("Cihaz Değişim İşlemleri", "bi-fire",
            ("Yeni Talep", "/ykc/yeni", "bi-plus-lg", Active("YkcYeni", "/ykc/yeni")),
            ("Taleplerim", "/ykc/talepler", "bi-journal-text", Active("YkcTalepler", "/ykc/talepler", "/ykc/detay", "/ykc/fr265")));
    }
    else
    {
        var area = isPersonelPanel ? "/personel-panel" : "/AdminPanel";
        var certificates = new List<(string, string, string, string)> {
            ("Onay Bekleyen Belgeler", area + "/onay-bekleyenler", "bi-file-earmark-check", Active("OnayBekleyenler", area + "/onay-bekleyenler"))
        };
        if (isPersonelPanel)
            certificates.Add(("Yetki Belgesi Geçmişi", area + "/onay-gecmisi", "bi-clock-history", Active("OnayGecmisi", area + "/onay-gecmisi")));
        else
            certificates.Add(("Bitiş Uyarıları", area + "/yetki-belgesi-uyarilari", "bi-exclamation-triangle", Active("YetkiBelgesiUyarilari", area + "/yetki-belgesi-uyarilari")));
        Group("Yetki Belgesi İşlemleri", "bi-file-earmark-check", certificates.ToArray());
        Group("Cihaz Devreye Alma", "bi-bag-check",
            ("Cihaz Devreye Alma Kayıtları", area + "/devreyealmalar", "bi-list-check", Active("DevreyeAlmalar", area + "/devreyealmalar")));
        var ykc = new List<(string, string, string, string)>();
        if (!isPersonelPanel || ykcYetkileri.TalepleriGorebilir)
        {
            ykc.Add(("Talepler", "/ykc/talepler", "bi-journal-text", ActiveUnless("YkcTalepler", "YkcRaporlar", "/ykc/talepler", "/ykc/detay", "/ykc/yeni", "/ykc/fr265")));
            ykc.Add(("Randevu Takvimi", "/ykc/takvim", "bi-calendar3", Active("YkcTakvim", "/ykc/takvim")));
        }
        if (!isPersonelPanel || ykcYetkileri.RaporlariGorebilir)
            ykc.Add(("Raporlar", "/ykc/raporlar", "bi-bar-chart-line", Active("YkcRaporlar", "/ykc/raporlar")));
        Group("Cihaz Değişim İşlemleri", "bi-fire", ykc.ToArray());
        var services = new List<(string, string, string, string)> {
            ("Yetkili Servisler", area + "/yetkiliservisler", "bi-tools", Active("YetkiliServisler", area + "/yetkiliservisler"))
        };
        if (isPersonelPanel || genelSistemAdminMi)
        {
            var brands = isPersonelPanel ? area + "/markalar" : "/Marka";
            services.Add(("Yetkili Servis Markaları", brands, "bi-tag", Active("Markalar", brands)));
        }
        if (!isPersonelPanel)
            services.Add(("Şubeler", area + "/subeler", "bi-building", Active("Subeler", area + "/subeler")));
        Group("Yetkili Servis Yönetimi", "bi-tools", services.ToArray());
        if (!isPersonelPanel)
            Group("Kullanıcı ve Yetki Yönetimi", "bi-people",
                ("Personeller", area + "/personeller", "bi-person-badge", Active("Personeller", area + "/personeller")),
                ("Kullanıcılar", area + "/kullanicilar", "bi-people", Active("Kullanicilar", area + "/kullanicilar")),
                ("Yetkiler", area + "/yetkiler", "bi-shield-check", Active("Yetkiler", area + "/yetkiler")));
        Group("Raporlama", "bi-bar-chart-line",
            ("Operasyon Raporları", area + "/raporlar", "bi-graph-up", Active("Raporlar", area + "/raporlar")));
        Group("Hesabım", "bi-person-circle",
            ("Profilim", area + "/profil", "bi-person", Active("Profil", area + "/profil")));
    }
}
<aside class="sidebar">
    <a class="logo" href="@home" aria-label="Ana sayfa">
        @if (!string.IsNullOrWhiteSpace(ViewBag.PanelLogoUrl as string))
        {
            <img class="panel-company-logo" src="@(ViewBag.PanelLogoUrl as string)" alt="@(ViewBag.PanelSirketAdi as string ?? "Şirket")" />
        }
        else
        {
            <div class="logo-circle"><i class="bi bi-fire" aria-hidden="true"></i></div>
        }
        <div>
            <div class="logo-text">@panelAnaBaslik</div>
            @if (!string.IsNullOrWhiteSpace(panelAltBaslik))
            {
                <div class="logo-sub">@panelAltBaslik</div>
            }
            <div class="logo-company">@(ViewBag.PanelSirketAdi as string ?? "Genel Yönetim")</div>
        </div>
    </a>
    <nav class="nav sidebar-nav" aria-label="Ana menü">
        <div class="nav-section-title">Ana Menü</div>
        <a class="@("nav-item" + homeActive)" href="@home" aria-current="@(homeActive.Length > 0 ? "page" : null)">
            <i class="bi bi-house-door" aria-hidden="true"></i><span>Ana Sayfa</span>
        </a>
        @foreach (var group in groups)
        {
            <details class="nav-item-group" open="@group.Links.Any(x => x.Active.Length > 0)">
                <summary><i class="bi @group.Icon" aria-hidden="true"></i><span>@group.Title</span><i class="bi bi-chevron-down submenu-arrow" aria-hidden="true"></i></summary>
                <div class="nav-submenu">
                    @foreach (var link in group.Links)
                    {
                        <a class="@("nav-subitem" + link.Active)" href="@link.Url" aria-current="@(link.Active.Length > 0 ? "page" : null)">
                            <i class="bi @link.Icon" aria-hidden="true"></i><span>@link.Text</span>
                            @if (link.Url.EndsWith("/onay-bekleyenler") && (ViewBag.OnayBekleyen ?? 0) > 0)
                            {
                                <span class="nav-badge">@ViewBag.OnayBekleyen</span>
                            }
                        </a>
                    }
                </div>
            </details>
        }
    </nav>
    <a class="cikis-btn" href="/cikis"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Güvenli Çıkış</a>
</aside>
