@{
    var path = Context?.Request?.Path.ToString() ?? "";
    var activeMenu = (ViewData["ActiveMenu"] ?? ViewBag.ActiveMenu)?.ToString() ?? "";
    var panelArea = (ViewData["PanelArea"] ?? ViewBag.PanelArea)?.ToString() ?? "";
    var isPersonelPanel = string.Equals(panelArea, "Personel", StringComparison.OrdinalIgnoreCase)
        || (string.IsNullOrWhiteSpace(panelArea) && path.StartsWith("/personel-panel", StringComparison.OrdinalIgnoreCase));
    var isYetkiliServisPanel = string.Equals(panelArea, "YetkiliServis", StringComparison.OrdinalIgnoreCase)
        || (string.IsNullOrWhiteSpace(panelArea) && (
            path.StartsWith("/ys-panel", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("/ys-devreyeal", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("/ys-yetki-belgesi", StringComparison.OrdinalIgnoreCase)));
    var isSertifikaliFirmaPanel = string.Equals(panelArea, "SertifikaliFirma", StringComparison.OrdinalIgnoreCase)
        || (User.IsInRole("SertifikaliFirma") && path.StartsWith("/ykc", StringComparison.OrdinalIgnoreCase));
    var genelSistemAdminMi = (ViewBag.GenelSistemAdminMi as bool?)
        ?? (User.IsInRole("GenelSistemAdmin") || User.IsInRole("SuperAdmin"));
    var sirketAdminMi = User.IsInRole("SirketAdmin");
    var personelMi = User.IsInRole("Personel");
    var ykcYetkileri = ViewBag.YkcYetkileri as YkcYetkiOzeti ?? new YkcYetkiOzeti();

    var panelAltBaslik = isSertifikaliFirmaPanel
        ? "Sertifikalı Firma"
        : isYetkiliServisPanel
        ? "Yetkili Servis"
        : isPersonelPanel
            ? "Personel Paneli"
            : genelSistemAdminMi
                ? "Genel Sistem Admini"
                : sirketAdminMi
                    ? "Şirket Admini"
                    : personelMi
                        ? "Personel Paneli"
                        : "Admin Paneli";

    string Active(string key, params string[] prefixes)
    {
        if (string.Equals(activeMenu, key, StringComparison.OrdinalIgnoreCase))
            return " active";

        return prefixes.Any(prefix => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            ? " active"
            : "";
    }

    string ActiveExact(string key, params string[] exactPaths)
    {
        if (string.Equals(activeMenu, key, StringComparison.OrdinalIgnoreCase))
            return " active";

        return exactPaths.Any(exact => string.Equals(path, exact, StringComparison.OrdinalIgnoreCase))
            ? " active"
            : "";
    }
}
<aside class="sidebar">
    <div class="logo">
        @if (!string.IsNullOrWhiteSpace(ViewBag.PanelLogoUrl as string))
        {
            <img class="panel-company-logo" src="@(ViewBag.PanelLogoUrl as string)" alt="@(ViewBag.PanelSirketAdi as string ?? "Şirket")" />
        }
        else
        {
            <div class="logo-circle"><div class="logo-dot"></div></div>
        }
        <div>
            <div class="logo-text">Gaz A&#231;ma</div>
            <div class="logo-sub">@panelAltBaslik</div>
            <div class="logo-company">@(ViewBag.PanelSirketAdi as string ?? "Genel Yönetim")</div>
        </div>
    </div>

    <nav class="nav">
        @if (isYetkiliServisPanel)
        {
            <div class="nav-section">Firma</div>
            <a class="@("nav-item" + ActiveExact("Dashboard", "/ys-panel"))" href="/ys-panel">
                <span class="nav-ico"><i class="bi bi-house-door"></i></span> Ana Sayfa
            </a>

            <div class="nav-section">İşlemler</div>
            <a class="@("nav-item" + ActiveExact("DevreyeAl", "/ys-devreyeal"))" href="/ys-devreyeal">
                <span class="nav-ico"><i class="bi bi-bag-check"></i></span> Cihaz Devreye Al
            </a>
            <a class="@("nav-item" + Active("DevreyeGecmis", "/ys-devreyeal/gecmis", "/ys-devreyeal/detay"))" href="/ys-devreyeal/gecmis">
                <span class="nav-ico"><i class="bi bi-clock-history"></i></span> İşlem Geçmişim
            </a>
            <a class="@("nav-item" + Active("Raporlar", "/ys-panel/raporlar"))" href="/ys-panel/raporlar">
                <span class="nav-ico"><i class="bi bi-bar-chart-line"></i></span> Raporlarım
            </a>

            <div class="nav-section">Firma</div>
            <a class="@("nav-item" + Active("YetkiBelgesi", "/ys-yetki-belgesi"))" href="/ys-yetki-belgesi">
                <span class="nav-ico"><i class="bi bi-file-earmark-text"></i></span> Yetki Belgem
            </a>
            <a class="@("nav-item" + Active("Markalar", "/ys-panel/markalar"))" href="/ys-panel/markalar">
                <span class="nav-ico"><i class="bi bi-building-check"></i></span> Markalarım
            </a>
            <a class="@("nav-item" + Active("Subeler", "/ys-panel/subeler"))" href="/ys-panel/subeler">
                <span class="nav-ico"><i class="bi bi-building-gear"></i></span> Şube / Servis Noktaları
            </a>
            <a class="@("nav-item" + Active("Profil", "/ys-panel/profil"))" href="/ys-panel/profil">
                <span class="nav-ico"><i class="bi bi-person"></i></span> Profilim
            </a>
        }
        else if (isSertifikaliFirmaPanel)
        {
            <div class="nav-section">Cihaz Değişim</div>
            <div class="nav-quick-grid">
                <a class="@("nav-quick-item" + ActiveExact("YkcOzet", "/ykc"))" href="/ykc" title="Ana Sayfa">
                    <span class="nav-quick-ico"><i class="bi bi-house-door"></i></span>
                    <span>Ana Sayfa</span>
                </a>
                <a class="@("nav-quick-item" + Active("YkcYeni", "/ykc/yeni"))" href="/ykc/yeni" title="Yeni Talep">
                    <span class="nav-quick-ico"><i class="bi bi-plus-lg"></i></span>
                    <span>Yeni Talep</span>
                </a>
                <a class="@("nav-quick-item" + Active("YkcTalepler", "/ykc/talepler", "/ykc/detay", "/ykc/fr265"))" href="/ykc/talepler" title="Taleplerim">
                    <span class="nav-quick-ico"><i class="bi bi-journal-text"></i></span>
                    <span>Taleplerim</span>
                </a>
            </div>
        }
        else if (isPersonelPanel)
        {
            <div class="nav-section">Panel</div>
            <a class="@("nav-item" + ActiveExact("Dashboard", "/personel-panel"))" href="/personel-panel">
                <span class="nav-ico"><i class="bi bi-house-door"></i></span> Ana Sayfa
            </a>

            <div class="nav-section">İşlemler</div>
            <a class="@("nav-item" + Active("OnayBekleyenler", "/personel-panel/onay-bekleyenler"))" href="/personel-panel/onay-bekleyenler">
                <span class="nav-ico"><i class="bi bi-check2-circle"></i></span> Yetki Belgesi Onay
                @if (ViewBag.OnayBekleyen > 0)
                {
                    <span class="nav-badge">@ViewBag.OnayBekleyen</span>
                }
            </a>
            <a class="@("nav-item" + Active("DevreyeAlmalar", "/personel-panel/devreyealmalar"))" href="/personel-panel/devreyealmalar">
                <span class="nav-ico"><i class="bi bi-bag-check"></i></span> Devreye Almalar
            </a>
            @if (ykcYetkileri.TalepleriGorebilir)
            {
                <a class="@("nav-item" + Active("YkcTalepler", "/ykc/talepler", "/ykc/detay", "/ykc/fr265"))" href="/ykc/talepler">
                    <span class="nav-ico"><i class="bi bi-fire"></i></span> Cihaz Değişim Talepleri
                </a>
            }
            @if (ykcYetkileri.RaporlariGorebilir)
            {
                <a class="@("nav-item" + Active("YkcRaporlar", "/ykc/raporlar"))" href="/ykc/raporlar">
                    <span class="nav-ico"><i class="bi bi-bar-chart-line"></i></span> Cihaz Değişim Raporları
                </a>
            }
            <a class="@("nav-item" + Active("Markalar", "/personel-panel/markalar"))" href="/personel-panel/markalar">
                <span class="nav-ico"><i class="bi bi-building-check"></i></span> Markalar
            </a>
            <a class="@("nav-item" + Active("YetkiliServisler", "/personel-panel/yetkiliservisler"))" href="/personel-panel/yetkiliservisler">
                <span class="nav-ico"><i class="bi bi-tools"></i></span> Yetkili Servisler
            </a>
            <div class="nav-section">Raporlar</div>
            <a class="@("nav-item" + Active("Raporlar", "/personel-panel/raporlar"))" href="/personel-panel/raporlar">
                <span class="nav-ico"><i class="bi bi-graph-up"></i></span> Genel Raporlar
            </a>
            <a class="@("nav-item" + Active("OnayGecmisi", "/personel-panel/onay-gecmisi"))" href="/personel-panel/onay-gecmisi">
                <span class="nav-ico"><i class="bi bi-clock-history"></i></span> Onay Geçmişi
            </a>

            <div class="nav-section">Sistem</div>
            <a class="@("nav-item" + Active("Profil", "/personel-panel/profil"))" href="/personel-panel/profil">
                <span class="nav-ico"><i class="bi bi-person"></i></span> Profilim
            </a>
        }
        else
        {
            <div class="nav-section">Genel</div>
            <a class="@("nav-item" + ActiveExact("Dashboard", "/AdminPanel", "/AdminPanel/index"))" href="/AdminPanel">
                <span class="nav-ico"><i class="bi bi-house-door"></i></span> Dashboard
            </a>

            <div class="nav-section">Yönetim</div>
            @if (genelSistemAdminMi)
            {
                <a class="@("nav-item" + Active("Markalar", "/Marka"))" href="/Marka">
                    <span class="nav-ico"><i class="bi bi-building-check"></i></span> Markalar
                </a>
            }
            <a class="@("nav-item" + Active("OnayBekleyenler", "/AdminPanel/onay-bekleyenler"))" href="/AdminPanel/onay-bekleyenler">
                <span class="nav-ico"><i class="bi bi-check2-circle"></i></span> Yetki Belgesi Onay
                @if (ViewBag.OnayBekleyen > 0)
                {
                    <span class="nav-badge">@ViewBag.OnayBekleyen</span>
                }
            </a>
            <a class="@("nav-item" + Active("YetkiBelgesiUyarilari", "/AdminPanel/yetki-belgesi-uyarilari"))" href="/AdminPanel/yetki-belgesi-uyarilari">
                <span class="nav-ico"><i class="bi bi-exclamation-triangle"></i></span> Bitiş Uyarıları
            </a>
            <a class="@("nav-item" + Active("DevreyeAlmalar", "/AdminPanel/devreyealmalar"))" href="/AdminPanel/devreyealmalar">
                <span class="nav-ico"><i class="bi bi-bag-check"></i></span> Devreye Almalar
            </a>
            <a class="@("nav-item" + Active("YkcTalepler", "/ykc/talepler", "/ykc/detay", "/ykc/yeni", "/ykc/fr265"))" href="/ykc/talepler">
                <span class="nav-ico"><i class="bi bi-fire"></i></span> Cihaz Değişim Talepleri
            </a>
            <a class="@("nav-item" + Active("YkcRaporlar", "/ykc/raporlar"))" href="/ykc/raporlar">
                <span class="nav-ico"><i class="bi bi-bar-chart-line"></i></span> Cihaz Değişim Raporları
            </a>
            <a class="@("nav-item" + Active("Raporlar", "/AdminPanel/raporlar"))" href="/AdminPanel/raporlar">
                <span class="nav-ico"><i class="bi bi-graph-up"></i></span> Raporlar
            </a>
            <a class="@("nav-item" + Active("YetkiliServisler", "/AdminPanel/yetkiliservisler"))" href="/AdminPanel/yetkiliservisler">
                <span class="nav-ico"><i class="bi bi-tools"></i></span> Yetkili Servisler
            </a>
            <a class="@("nav-item" + Active("Subeler", "/AdminPanel/subeler"))" href="/AdminPanel/subeler">
                <span class="nav-ico"><i class="bi bi-building-gear"></i></span> Şube / Servis Noktaları
            </a>
            <a class="@("nav-item" + Active("Personeller", "/AdminPanel/personeller"))" href="/AdminPanel/personeller">
                <span class="nav-ico"><i class="bi bi-people"></i></span> Personeller
            </a>
            <a class="@("nav-item" + Active("Kullanicilar", "/AdminPanel/kullanicilar"))" href="/AdminPanel/kullanicilar">
                <span class="nav-ico"><i class="bi bi-person-gear"></i></span> Kullanıcılar
            </a>
            <a class="@("nav-item" + Active("Yetkiler", "/AdminPanel/yetkiler"))" href="/AdminPanel/yetkiler">
                <span class="nav-ico"><i class="bi bi-shield-lock"></i></span> Yetkiler
            </a>

            <div class="nav-section">Sistem</div>
            <a class="@("nav-item" + Active("Profil", "/AdminPanel/profil"))" href="/AdminPanel/profil">
                <span class="nav-ico"><i class="bi bi-person"></i></span> Profilim
            </a>
