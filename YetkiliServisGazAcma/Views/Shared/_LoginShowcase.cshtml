<section class="login-visual" aria-hidden="true" data-login-showcase>
    <div class="login-showcase__stage">
        <article class="login-showcase__slide is-active" data-login-slide data-login-scene="monitor" aria-hidden="false">
            <img class="login-showcase__device login-showcase__device--monitor" src="~/images/login/workflow-monitor-base-v4.png" alt="" />
            <img class="login-showcase__overlay overlay-region--monitor-certificate showcase-step-1" src="~/images/login/workflow-monitor-overlay-v1.png" alt="" />
            <img class="login-showcase__overlay overlay-region--monitor-appointment showcase-step-2" src="~/images/login/workflow-monitor-overlay-v1.png" alt="" />
            <img class="login-showcase__overlay overlay-region--monitor-service showcase-step-3" src="~/images/login/workflow-monitor-overlay-v1.png" alt="" />
            <img class="login-showcase__overlay overlay-region--monitor-complete showcase-step-4" src="~/images/login/workflow-monitor-overlay-v1.png" alt="" />
        </article>

        <article class="login-showcase__slide" data-login-slide data-login-scene="laptop" aria-hidden="true">
            <img class="login-showcase__device login-showcase__device--laptop" src="~/images/login/workflow-laptop-base-v4.png" alt="" />
            <img class="login-showcase__overlay overlay-region--laptop-device showcase-step-1" src="~/images/login/workflow-laptop-overlay-v1.png" alt="" />
            <img class="login-showcase__overlay overlay-region--laptop-arrow showcase-step-2" src="~/images/login/workflow-laptop-overlay-v1.png" alt="" />
            <img class="login-showcase__overlay overlay-region--laptop-hand-ring showcase-step-3" src="~/images/login/workflow-laptop-overlay-v1.png" alt="" />
            <img class="login-showcase__overlay overlay-region--laptop-service showcase-step-4" src="~/images/login/workflow-laptop-overlay-v1.png" alt="" />
            <img class="login-showcase__overlay overlay-region--laptop-complete showcase-step-5" src="~/images/login/workflow-laptop-overlay-v1.png" alt="" />
            <img class="login-showcase__overlay overlay-region--laptop-appointment showcase-step-6" src="~/images/login/workflow-laptop-overlay-v1.png" alt="" />
        </article>
    </div>
</section>
