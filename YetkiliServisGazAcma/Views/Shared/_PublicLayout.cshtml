@{
    var title = ViewData["Title"]?.ToString() ?? "Yetkili Servis Gaz Açma Sistemi";
    var compactDesktop = ViewData["CompactDesktop"] as bool? == true;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - Yetkili Servis Gaz Açma Sistemi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/page-transition.css" asp-append-version="true" />
    @if (compactDesktop)
    {
        <style>
            @@media (min-width: 981px) {
                html { overflow-x: hidden; }
                body.public-compact-desktop { zoom: .9; }
            }
        </style>
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(compactDesktop ? "public-compact-desktop" : null)">
    @await Html.PartialAsync("_PageTransition")
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/page-transition.js" asp-append-version="true"></script>
</body>
</html>
