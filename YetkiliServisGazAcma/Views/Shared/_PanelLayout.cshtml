@{
    var title = ViewData["Title"]?.ToString() ?? "Panel";
    var successMessages = new[] { "Basarili", "Mesaj", "SifreBasarili" }
        .Select(key => TempData[key]?.ToString())
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();
    var errorMessages = new[] { "Hata", "SifreHata" }
        .Select(key => TempData[key]?.ToString())
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();
    var bodyClasses = string.Join(" ", new[]
    {
        successMessages.Count > 0 ? "has-operation-toast-success" : null,
        errorMessages.Count > 0 ? "has-operation-toast-error" : null
    }.Where(value => value != null));
    var contentClasses = ViewData["ContentClass"]?.ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Yetkili Servis Gaz Açma</title>
    <link rel="stylesheet" href="~/css/panel-layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/panel-unify.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    @await RenderSectionAsync("PageStyles", required: false)
    <link rel="stylesheet" href="~/css/operation-toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/record-tabs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page-transition.css" asp-append-version="true" />
</head>
<body class="@bodyClasses" data-onay="@(ViewBag.OnayBekleyen ?? 0)" data-sure="@(ViewBag.SuresiBitecek ?? 0)">
    @await Html.PartialAsync("_PageTransition")
    <div class="df-toast-stack" data-operation-toast-stack aria-live="polite" aria-atomic="true">
        @foreach (var message in successMessages)
        {
            <div class="df-operation-toast" data-operation-toast data-timeout="9000" role="status">
                <span class="df-operation-toast-icon"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
                <span class="df-operation-toast-copy"><strong>İşlem Başarılı</strong><span>@message</span></span>
                <button class="df-operation-toast-close" type="button" data-operation-toast-close aria-label="Bildirimi kapat"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
        }
        @foreach (var message in errorMessages)
        {
            <div class="df-operation-toast is-error" data-operation-toast data-timeout="9000" role="alert">
                <span class="df-operation-toast-icon"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i></span>
                <span class="df-operation-toast-copy"><strong>İşlem Tamamlanamadı</strong><span>@message</span></span>
                <button class="df-operation-toast-close" type="button" data-operation-toast-close aria-label="Bildirimi kapat"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
        }
    </div>
    <div class="layout">
        @await Html.PartialAsync("_PanelSidebar")
        <main class="main">
            @await Html.PartialAsync("_PanelTopbar")
            <div class="content @contentClasses">
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="/js/notification-panel.js" asp-append-version="true"></script>
    <script src="/js/operation-toast.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/record-tabs.js" asp-append-version="true"></script>
    <script src="~/js/page-transition.js" asp-append-version="true"></script>
</body>
</html>
