@model YetkiliServisGazAcma.Entities.Ys_Firma
@{
    var edit = ViewData["ServisDuzenleme"] as bool? ?? false;
    var sehirler = ViewBag.Sehirler as List<string> ?? new();
    var kategoriler = ViewBag.Kategoriler as List<YetkiliServisGazAcma.Entities.UrunKategori> ?? new();
    var markalar = ViewBag.Markalar as List<YetkiliServisGazAcma.Entities.Ys_Marka> ?? new();
    var seciliKategoriler = ViewBag.SeciliKategoriler as List<int> ?? new();
    var seciliMarkalar = ViewBag.SeciliMarkalar as List<int> ?? new();
}
<div class="service-editor">
    <form class="service-editor-form" method="post" action="@(edit ? Url.Action("YetkiliServisDuzenle", "PersonelPanel", new { id = Model.Id }) : Url.Action("YetkiliServisEkle", "PersonelPanel"))">
        @Html.AntiForgeryToken()
        <section class="service-editor-section service-editor-section--identity" aria-labelledby="service-identity-title">
            <div class="service-section-heading">
                <span class="service-section-icon" aria-hidden="true"><i class="bi bi-buildings"></i></span>
                <div class="service-section-copy">
                    <h2 id="service-identity-title">Firma ve İletişim Bilgileri</h2>
                    <p>Servisin kurumsal, iletişim ve vergi bilgilerini tanımlayın.</p>
                </div>
                @if (edit)
                {
                    <label class="service-active-toggle">
                        <input type="checkbox" name="aktifMi" value="true" checked="@Model.AktifMi" />
                        <span aria-hidden="true"></span>
                        <strong>Aktif servis</strong>
                    </label>
                    <input type="hidden" name="aktifMi" value="false" />
                }
            </div>

            <div class="service-editor-fields">
                <div class="service-field service-field--span-2">
                    <label for="service-name">Firma Adı <span aria-hidden="true">*</span></label>
                    <input id="service-name" name="firmaAdi" value="@Model.FirmaAdi" placeholder="Yetkili servis firma adı" autocomplete="organization" required />
                </div>
                <div class="service-field">
                    <label for="service-contact">Yetkili Kişi</label>
                    <input id="service-contact" name="yetkiliKisi" value="@Model.YetkiliKisi" placeholder="Ad soyad" autocomplete="name" />
                </div>
                <div class="service-field">
                    <label for="service-phone">Telefon</label>
                    <input id="service-phone" name="telefon" type="tel" value="@Model.Telefon" placeholder="0(---) --- -- --" autocomplete="tel" />
                </div>
                <div class="service-field">
                    <label for="service-email">E-posta</label>
                    <input id="service-email" name="email" type="email" value="@Model.Email" placeholder="firma@ornek.com" autocomplete="email" />
                </div>
                <div class="service-field">
                    <label for="service-city">Şehir <span aria-hidden="true">*</span></label>
                    <select id="service-city" name="faaliyetIli" required>
                        <option value="">Şehir seçin</option>
                        @foreach (var sehir in sehirler)
                        {
                            <option value="@sehir" selected="@(string.Equals(Model.FaaliyetIli, sehir, StringComparison.CurrentCultureIgnoreCase))">@sehir</option>
                        }
                    </select>
                </div>
                <div class="service-field">
                    <label for="service-tax-id">Vergi No</label>
                    <input id="service-tax-id" name="vergiNo" value="@Model.VergiNo" placeholder="Vergi numarası" inputmode="numeric" />
                </div>
                <div class="service-field">
                    <label for="service-tax-office">Vergi Dairesi</label>
                    <input id="service-tax-office" name="vergiDairesi" value="@Model.VergiDairesi" placeholder="Vergi dairesi" />
                </div>
                <div class="service-field">
                    <label for="service-address">Adres</label>
                    <input id="service-address" name="adres" value="@Model.Adres" placeholder="Firma adresi" autocomplete="street-address" />
                </div>
            </div>
        </section>

        <section class="service-editor-section service-editor-section--scope" aria-labelledby="service-scope-title">
            <div class="service-section-heading">
                <span class="service-section-icon" aria-hidden="true"><i class="bi bi-patch-check"></i></span>
                <div class="service-section-copy">
                    <h2 id="service-scope-title">Yetki ve Hizmet Kapsamı</h2>
                    <p>Servisin işlem yapabildiği marka ve cihaz gruplarını seçin.</p>
                </div>
            </div>

            <div class="service-scope-grid">
                <div class="service-choice-panel">
                    <div class="service-choice-heading">
                        <h3><i class="bi bi-tags" aria-hidden="true"></i>Yetkili Markalar</h3>
                        <output id="service-brand-count" aria-live="polite"></output>
                    </div>
                    <label class="service-brand-search" for="service-brand-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input id="service-brand-search" type="search" placeholder="Marka ara..." autocomplete="off" aria-label="Marka ara" />
                    </label>
                    <div class="service-brand-list">
                        <label class="service-choice service-choice--all"><input id="service-all-brands" type="checkbox" /><span>Tüm markalar</span></label>
                        @foreach (var marka in markalar)
                        {
                            <label class="service-choice" data-brand-name="@marka.MarkaAdi"><input type="checkbox" name="markaIds" value="@marka.Id" checked="@seciliMarkalar.Contains(marka.Id)" /><span>@marka.MarkaAdi</span></label>
                        }
                        @if (markalar.Count == 0)
                        {
                            <p class="service-choice-empty">Kayıtlı marka bulunmuyor.</p>
                        }
                        <p id="service-brand-empty" class="service-choice-empty" hidden>Eşleşen marka bulunamadı.</p>
                    </div>
                </div>

                <div class="service-choice-panel service-choice-panel--categories">
                    <div class="service-choice-heading">
                        <h3><i class="bi bi-ui-checks" aria-hidden="true"></i>Hizmet Türleri</h3>
                    </div>
                    <div class="service-category-list">
                        @foreach (var kategori in kategoriler)
                        {
                            <label class="service-category-choice">
                                <input type="checkbox" name="kategoriIds" value="@kategori.Id" checked="@seciliKategoriler.Contains(kategori.Id)" />
                                @if (!string.IsNullOrWhiteSpace(kategori.IconUrl))
                                {
                                    <span class="service-category-icon" aria-hidden="true"><img src="@kategori.IconUrl" alt="" /></span>
                                }
                                else
                                {
                                    <span class="service-category-icon" aria-hidden="true"><i class="bi bi-box-seam"></i></span>
                                }
                                <span>@kategori.Ad</span>
                            </label>
                        }
                        @if (kategoriler.Count == 0)
                        {
                            <p class="service-choice-empty">Kayıtlı hizmet türü bulunmuyor.</p>
                        }
                    </div>
                </div>
            </div>
        </section>

        <footer class="service-editor-actions">
            <a href="@Url.Action("YetkiliServisler", "PersonelPanel")" class="df-btn df-btn-secondary df-btn-sm"><i class="bi bi-x-lg" aria-hidden="true"></i>Vazgeç</a>
            <button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2" aria-hidden="true"></i>@(edit ? "Değişiklikleri Kaydet" : "Servisi Kaydet")</button>
        </footer>
    </form>
</div>
