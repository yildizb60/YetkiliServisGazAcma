<dialog class="df-directory-sheet df-account-sheet" data-admin-form-sheet aria-labelledby="adminFormSheetTitle">
    <div class="df-directory-sheet-frame">
        <header class="df-directory-sheet-head">
            <h2 id="adminFormSheetTitle" data-admin-form-sheet-title>Kayıt İşlemi</h2>
            <button type="button" class="df-directory-sheet-close" data-admin-form-sheet-close title="Paneli kapat" aria-label="Paneli kapat">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </header>
        <div class="df-directory-sheet-body" data-admin-form-sheet-body>
            <div class="df-directory-sheet-loading" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Form hazırlanıyor</span>
            </div>
        </div>
    </div>
</dialog>
