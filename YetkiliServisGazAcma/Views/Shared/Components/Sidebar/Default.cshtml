@model YetkiliServisGazAcma.Models.ViewModels.SidebarViewModel
<aside class="sidebar @(Model.ServicePanel ? "is-service-sidebar" : null)" id="panelSidebar">
    <a class="logo" href="@Model.HomeUrl" aria-label="Ana sayfa">
        @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
        {
            <img class="panel-company-logo" src="@(Model.LogoUrl)" alt="@(Model.CompanyName)" />
        }
        else
        {
            <img class="panel-company-logo" src="~/images/company/corumgaz-symbol-mark.svg" alt="Uygulama logosu" />
        }
    </a>
    <button class="sidebar-collapse-toggle" type="button" data-sidebar-collapse aria-controls="panelSidebar" aria-expanded="true" aria-label="Menüyü daralt veya genişlet" title="Menüyü daralt">
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
    </button>
    <nav class="nav sidebar-nav" aria-label="Ana menü">
        <div class="nav-section-title">Ana Menü</div>
        <a class="@("nav-item" + Model.HomeActive)" href="@Model.HomeUrl" aria-current="@(Model.HomeActive.Length > 0 ? "page" : null)" title="Ana Sayfa">
            <i class="bi bi-house-door" aria-hidden="true"></i><span>Ana Sayfa</span>
        </a>
        @foreach (var group in Model.Groups)
        {
            <details class="nav-item-group" open="@group.Expanded">
                <summary title="@group.Title"><i class="bi @group.Icon" aria-hidden="true"></i><span>@group.Title</span><i class="bi bi-chevron-down submenu-arrow" aria-hidden="true"></i></summary>
                <div class="nav-submenu">
                    @foreach (var link in group.Links)
                    {
                        <a class="@("nav-subitem" + link.Active)" href="@link.Url" aria-current="@(link.Active.Length > 0 ? "page" : null)">
                            <i class="bi @link.Icon" aria-hidden="true"></i><span>@link.Text</span>
                            @if (link.Badge > 0)
                            {
                                <span class="nav-badge">@link.Badge</span>
                            }
                        </a>
                    }
                </div>
            </details>
        }
    </nav>
    <a class="cikis-btn" href="@Model.LogoutUrl" title="Güvenli Çıkış"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Güvenli Çıkış</span></a>
</aside>
