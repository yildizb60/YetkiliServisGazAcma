@model YkcTakvimSonuc
<link rel="stylesheet" href="~/css/ykc-calendar.css" asp-append-version="true" />
<section class="ykc-calendar ykc-dashboard-agenda" aria-labelledby="today-appointments-title">
    <header class="ykc-calendar-header">
        <div class="ykc-dashboard-agenda-title">
            <span class="ykc-dashboard-agenda-icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span>
            <div>
                <h2 id="today-appointments-title">Bugünkü Randevular</h2>
                <small>@DateTime.Today.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</small>
            </div>
        </div>
        <div class="ykc-dashboard-agenda-actions">
            @if (Model != null)
            {
                <span class="ykc-dashboard-agenda-count">@Model.Toplam planlı ziyaret</span>
            }
            <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/takvim"><i class="bi bi-calendar3" aria-hidden="true"></i> Takvim</a>
        </div>
    </header>
    @if (Model == null)
    {
        <div class="ykc-dashboard-agenda-empty"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>Randevu bilgisi şu anda alınamıyor.</span></div>
    }
    else if (Model.Toplam == 0)
    {
        <div class="ykc-dashboard-agenda-empty"><i class="bi bi-calendar2" aria-hidden="true"></i><span>Bugün planlı ziyaret yok.</span></div>
    }
    else
    {
        @foreach (var item in Model.Kayitlar.Take(2))
        {
            <a class="ykc-calendar-entry" href="/ykc/detay/@item.Id">
                <time>@item.Saat</time>
                <span><strong>@item.Musteri</strong><small>Tesisat @item.TesisatNo · @item.Adres</small></span>
                <span><strong>@(item.Personel ?? item.Ekip)</strong><small>@item.Bolge</small></span>
                <span>@YkcDurumSunumu.Etiket(item.Durum)</span><i class="bi bi-arrow-right"></i>
            </a>
        }
        @if (Model.Toplam > 2) { <a class="ykc-dashboard-agenda-more" href="/ykc/takvim">Tüm randevuları gör <i class="bi bi-arrow-right" aria-hidden="true"></i></a> }
    }
</section>
