@model YetkiliServisGazAcma.ViewComponents.YkcRandevuOzetiModel
@{
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var ayBasi = new DateTime(Model.Tarih.Year, Model.Tarih.Month, 1);
    var ilkGun = ayBasi.AddDays(-(((int)ayBasi.DayOfWeek + 6) % 7));
    var action = Context.Request.Path.ToString();
    var filtreAktif = new[] { Model.Filtre.Il, Model.Filtre.Bolge, Model.Filtre.Personel, Model.Filtre.Musteri, Model.Filtre.TesisatNo }.Any(x => !string.IsNullOrWhiteSpace(x));
    string OzetLink(DateTime gun, string? gorunum = null) => Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(action, new Dictionary<string,string?> {
        ["takvimTarih"] = gun.ToString("yyyy-MM-dd"), ["takvimIl"] = Model.Filtre.Il, ["takvimBolge"] = Model.Filtre.Bolge,
        ["takvimPersonel"] = Model.Filtre.Personel, ["takvimAbone"] = Model.Filtre.Musteri, ["takvimTesisat"] = Model.Filtre.TesisatNo,
        ["takvimGorunum"] = gorunum ?? Model.Gorunum
    }) + "#home-calendar";
    string GunLink(DateTime gun) => OzetLink(gun);
    string GorunumLink(string gorunum) => OzetLink(Model.Tarih, gorunum);
    var temizleLink = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(action, new Dictionary<string,string?> {
        ["takvimTarih"] = Model.Tarih.ToString("yyyy-MM-dd"), ["takvimGorunum"] = Model.Gorunum
    }) + "#home-calendar";
    var takvimBaslangic = Model.Gorunum == "gun" ? Model.Tarih : ayBasi;
    var takvimBitis = Model.Gorunum == "gun" ? Model.Tarih : ayBasi.AddMonths(1).AddDays(-1);
    var takvimLink = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/ykc/takvim", new Dictionary<string,string?> {
        ["Baslangic"] = takvimBaslangic.ToString("yyyy-MM-dd"), ["Bitis"] = takvimBitis.ToString("yyyy-MM-dd"),
        ["Il"] = Model.Filtre.Il, ["Bolge"] = Model.Filtre.Bolge, ["Personel"] = Model.Filtre.Personel,
        ["Musteri"] = Model.Filtre.Musteri, ["TesisatNo"] = Model.Filtre.TesisatNo
    });
}
<link rel="stylesheet" href="~/css/home-calendar.css" asp-append-version="true" />
<section class="home-calendar @(Model.FirmaGorunumu ? "is-firm-calendar" : "has-view-modes")" id="home-calendar" aria-labelledby="home-calendar-title">
    <header class="home-calendar-heading">
        <h2 id="home-calendar-title"><i class="bi bi-calendar2-week" aria-hidden="true"></i>@(Model.Baslik ?? (Model.FirmaGorunumu ? "Cihaz Değişim Randevularım" : "Cihaz Değişim Kontrol Takvimi"))</h2>
        <a href="@takvimLink">Takvimi Aç <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
    </header>
    @if (!Model.FirmaGorunumu)
    {
        <nav class="home-calendar-view-modes" aria-label="Takvim görünümü">
            <a href="@GorunumLink("gun")" aria-current="@(Model.Gorunum == "gun" ? "page" : null)">Günlük</a>
            <a href="@GorunumLink("ay")" aria-current="@(Model.Gorunum == "ay" ? "page" : null)">Aylık</a>
            <a href="@GorunumLink("yil")" aria-current="@(Model.Gorunum == "yil" ? "page" : null)">Yıllık</a>
        </nav>
    }
    <details class="home-calendar-filter-panel" open="@(filtreAktif ? "open" : null)">
    <summary><span><i class="bi bi-funnel" aria-hidden="true"></i>Randevuları Filtrele</span><span>@(filtreAktif ? "Filtre uygulandı" : "")<i class="bi bi-chevron-down" aria-hidden="true"></i></span></summary>
    <form method="get" action="@action#home-calendar" class="home-calendar-filters">
        <input type="hidden" name="takvimTarih" value="@Model.Tarih.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="takvimGorunum" value="@Model.Gorunum" />
        <label>Abone Adı Soyadı<input name="takvimAbone" value="@Model.Filtre.Musteri" maxlength="120" /></label>
        @if (Model.FirmaGorunumu)
        {
            <label>Tesisat No<input name="takvimTesisat" value="@Model.Filtre.TesisatNo" maxlength="120" inputmode="numeric" /></label>
        }
        else
        {
            <label class="home-calendar-team-filter">Ekip
                <select name="takvimPersonel">
                    <option value="">Tüm ekipler</option>
                    <option value="Acil" selected="@(string.Equals(Model.Filtre.Personel, "Acil", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Acil</option>
                    <option value="Mühendis" selected="@(string.Equals(Model.Filtre.Personel, "Mühendis", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Mühendis</option>
                </select>
            </label>
            <label>İl<input name="takvimIl" value="@Model.Filtre.Il" maxlength="120" /></label>
            <label>Bölge<input name="takvimBolge" value="@Model.Filtre.Bolge" maxlength="120" /></label>
        }
        <button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-funnel" aria-hidden="true"></i>Filtrele</button>
        <a href="@temizleLink" class="home-calendar-icon" aria-label="Takvim filtrelerini temizle" title="Filtreleri temizle"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></a>
    </form>
    </details>
    <div class="home-calendar-body is-@Model.Gorunum-view">
        @if (!Model.FirmaGorunumu && Model.Gorunum == "gun")
        {
            <nav class="home-day-picker" aria-label="Randevu günü seçimi">
                <div class="home-period-nav">
                    <a class="home-calendar-icon" href="@OzetLink(Model.Tarih.AddDays(-1), "gun")" title="Önceki gün" aria-label="Önceki gün"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                    <strong>@Model.Tarih.ToString("dd MMMM yyyy", tr)</strong>
                    <a class="home-calendar-icon" href="@OzetLink(Model.Tarih.AddDays(1), "gun")" title="Sonraki gün" aria-label="Sonraki gün"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                </div>
                <div class="home-day-picker__summary"><span>@Model.Tarih.ToString("dddd", tr)</span><strong>@(Model.Gun?.Toplam ?? 0)</strong><small>kontrol randevusu</small></div>
                <a class="home-calendar-today" href="@OzetLink(DateTime.Today, "gun")">Bugüne Dön</a>
            </nav>
        }
        else if (!Model.FirmaGorunumu && Model.Gorunum == "yil")
        {
            <nav class="home-year-picker" aria-label="Randevu ayı seçimi">
                <div class="home-period-nav">
                    <a class="home-calendar-icon" href="@OzetLink(Model.Tarih.AddYears(-1), "yil")" title="Önceki yıl" aria-label="Önceki yıl"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                    <strong>@Model.Tarih.Year</strong>
                    <a class="home-calendar-icon" href="@OzetLink(Model.Tarih.AddYears(1), "yil")" title="Sonraki yıl" aria-label="Sonraki yıl"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                </div>
                <div class="home-year-months">
                    @for (var ay = 1; ay <= 12; ay++)
                    {
                        var ayTarihi = new DateTime(Model.Tarih.Year, ay, 1);
                        <a href="@OzetLink(ayTarihi, "ay")" aria-current="@(ay == Model.Tarih.Month ? "date" : null)">@ayTarihi.ToString("MMM", tr)</a>
                    }
                </div>
                <a class="home-calendar-today" href="@OzetLink(DateTime.Today, "yil")">Bu Yıla Dön</a>
            </nav>
        }
        else
        {
            <nav class="home-month" aria-label="Randevu günü seçimi">
                <div class="home-month-nav">
                    <a class="home-calendar-icon" href="@OzetLink(ayBasi.AddMonths(-1), "ay")" title="Önceki ay" aria-label="Önceki ay"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                    <strong>@Model.Tarih.ToString("MMMM yyyy", tr)</strong>
                    <a class="home-calendar-icon" href="@OzetLink(ayBasi.AddMonths(1), "ay")" title="Sonraki ay" aria-label="Sonraki ay"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                </div>
                <div class="home-month-days">
                    @foreach (var gun in new[] { "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz" }) { <span>@gun</span> }
                    @for (var i = 0; i < 42; i++)
                    {
                        var gun = ilkGun.AddDays(i);
                        if (gun.Month != Model.Tarih.Month)
                        {
                            <span class="home-month-empty" aria-hidden="true"></span>
                        }
                        else
                        {
                            var count = Model.AyGunleri.FirstOrDefault(x => x.Tarih.Date == gun)?.Toplam ?? 0;
                            <a href="@GunLink(gun)" class="@(gun == DateTime.Today ? "is-today" : "")"
                               aria-current="@(gun == Model.Tarih ? "date" : null)"
                               aria-label="@($"{gun.ToString("dd MMMM yyyy", tr)}{(count > 0 ? $", {count} randevu" : "")}")">
                                @gun.Day
                                @if ((Model.FirmaGorunumu && count > 0) || (!Model.FirmaGorunumu && gun == DateTime.Today))
                                {
                                    <i class="home-month-dot" aria-hidden="true"></i>
                                }
                            </a>
                        }
                    }
                </div>
                <a class="home-calendar-today" href="@OzetLink(DateTime.Today, "ay")">Bugüne Dön</a>
            </nav>
        }
        <div class="home-visits">
            <header>
                <h3>@(Model.FirmaGorunumu ? $"{(Model.Tarih == DateTime.Today ? "Bugün · " : "")}{Model.Tarih.ToString("dd MMMM dddd", tr)}" : "Randevular")</h3>
                @if (Model.FirmaGorunumu && Model.Gun != null)
                {
                    <span>@Model.Gun.Toplam randevu</span>
                }
                else if (!Model.FirmaGorunumu)
                {
                    <a href="@takvimLink">Tümünü Gör <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                }
            </header>
            @if (!Model.FirmaGorunumu)
            {
                <div class="home-visits-date">
                    <span>@(Model.Tarih == DateTime.Today ? "Bugün · " : "")@Model.Tarih.ToString("dd MMMM dddd", tr)</span>
                    @if (Model.Gun != null) { <small>@Model.Gun.Toplam randevu</small> }
                </div>
            }
            @if (Model.Gun == null)
            {
                <div class="home-visits-empty"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><p>Randevular alınamadı.</p><a href="@GunLink(Model.Tarih)">Yeniden Dene</a></div>
            }
            else if (Model.Gun.Toplam == 0)
            {
                <div class="home-visits-empty"><i class="bi bi-calendar2-check" aria-hidden="true"></i><p>Seçili gün ve filtrelerde kontrol randevusu yok.</p></div>
            }
            else
            {
                <div class="home-visit-list" tabindex="0" role="region" aria-label="Seçili günün kontrol randevuları">
                    @foreach (var item in Model.Gun.Kayitlar)
                    {
                        var yonlendirilen = !string.IsNullOrWhiteSpace(item.Personel)
                            ? item.Personel
                            : !string.IsNullOrWhiteSpace(item.Ekip) ? item.Ekip : "Atanmadı";
                        <a class="home-visit @(item.Durum == YkcDurumDegerleri.Tamamlandi ? "is-complete" : "")" href="/ykc/detay/@item.Id?kaynak=takvim">
                            @if (!Model.FirmaGorunumu)
                            {
                                <span class="home-visit-person is-personnel-visit">
                                    <span class="home-visit-identity">
                                        <strong>@(string.IsNullOrWhiteSpace(item.Musteri) ? "Abone adı kayıtlı değil" : item.Musteri)</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.TesisatNo))
                                        {
                                            <span class="home-visit-installation"><i class="bi bi-house-door" aria-hidden="true"></i>Tesisat @item.TesisatNo</span>
                                        }
                                    </span>
                                    <span class="home-visit-primary">
                                        <span class="home-visit-time"><i class="bi bi-clock" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(item.Saat) ? "Saat yok" : item.Saat)</span>
                                        <span class="home-visit-assignee"><i class="bi bi-people" aria-hidden="true"></i>@yonlendirilen</span>
                                        @if (item.Durum != YkcDurumDegerleri.Atandi)
                                        {
                                            <span class="df-pill home-visit-state @YkcDurumSunumu.CssSinifi(item.Durum)">@YkcDurumSunumu.Etiket(item.Durum)</span>
                                        }
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(item.Adres))
                                    {
                                        <small><i class="bi bi-geo-alt" aria-hidden="true"></i>@item.Adres</small>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="home-visit-person">
                                    <strong>@(string.IsNullOrWhiteSpace(item.Musteri) ? "Abone adı kayıtlı değil" : item.Musteri)</strong>
                                    <span class="home-visit-meta">
                                        <span><i class="bi bi-clock" aria-hidden="true"></i>@Model.Tarih.ToString("dd MMM yyyy", tr)</span>
                                        <span class="home-visit-time">@(string.IsNullOrWhiteSpace(item.Saat) ? "Saat yok" : item.Saat)</span>
                                    </span>
                                    <small><i class="bi bi-geo-alt" aria-hidden="true"></i>@item.Adres</small>
                                    <span class="home-visit-tags">
                                        <span><i class="bi bi-house-door" aria-hidden="true"></i>Tesisat @item.TesisatNo</span>
                                        <span class="df-pill @YkcDurumSunumu.CssSinifi(item.Durum)">@YkcDurumSunumu.Etiket(item.Durum)</span>
                                    </span>
                                </span>
                            }
                            <i class="bi bi-three-dots-vertical home-visit-menu" aria-hidden="true"></i>
                        </a>
                    }
                </div>
                @if (Model.Gun.Toplam > Model.Gun.Kayitlar.Count) { <a class="home-calendar-more" href="@takvimLink">Günün tüm @Model.Gun.Toplam randevusunu gör <i class="bi bi-arrow-right" aria-hidden="true"></i></a> }
            }
        </div>
    </div>
</section>
