@model DevreyeAlmaListeViewModel
@{
    var sorgu = Context.Request.Query;
    string Deger(string ad) => sorgu[ad].ToString();
    var filtreAdlari = new[] { "tesisat", "sozlesme", "musteri", "marka", "cihazTipi", "durum", "servis", "il", "ilce", "bas", "bit" };
    var filtreAktif = filtreAdlari.Any(ad => !string.IsNullOrWhiteSpace(Deger(ad)));
    var durumlar = new[]
    {
        (Kod: Model.ServisPaneli ? "tamamlandi" : DevreyeAlmaDurumDegerleri.Tamamlandi.ToString(), Ad: "Tamamlandı"),
        (Kod: Model.ServisPaneli ? "bekliyor" : DevreyeAlmaDurumDegerleri.Bekliyor.ToString(), Ad: "Bekliyor"),
        (Kod: Model.ServisPaneli ? "iptal" : DevreyeAlmaDurumDegerleri.Iptal.ToString(), Ad: "İptal")
    };
}

<div class="df-admin-workspace df-operations-directory df-commissioning-directory" data-history-directory data-storage-key="commissioning-view">
    <partial name="_KayitListeAracCubugu" model="@(new KayitListeAracCubuguViewModel { Baslik = "Devreye Alma Kayıtları", KayitSayisi = Model.Kayitlar.Count, KayitVar = Model.Kayitlar.Any(), PdfUrl = Model.PdfUrl, ExcelUrl = Model.ExcelUrl, YeniKayitUrl = Model.YeniKayitUrl })" />

    <section class="df-commissioning-surface">
        <details id="commissioningFiltersPanel" class="df-admin-filter df-commissioning-filter" open="@(filtreAktif ? "open" : null)">
            <summary><span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Kayıtları Filtrele</strong></span><span>@(filtreAktif ? "Filtre uygulandı" : "Filtreleri aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span></summary>
            <div class="df-admin-filter-body">
                <form id="commissioningFilters" method="get" action="@Model.ListeUrl">
                    @if (Model.SirketId.HasValue) { <input type="hidden" name="sirketId" value="@Model.SirketId" /> }
                    <div class="df-admin-filter-grid">
                        <div class="df-admin-field"><label for="tesisat">Tesisat No</label><input id="tesisat" type="search" name="tesisat" value="@Deger("tesisat")" placeholder="Tesisat no" /></div>
                        <div class="df-admin-field"><label for="sozlesme">Sözleşme No</label><input id="sozlesme" type="search" name="sozlesme" value="@Deger("sozlesme")" placeholder="Sözleşme no" /></div>
                        <div class="df-admin-field"><label for="musteri">Abone Adı Soyadı</label><input id="musteri" type="search" name="musteri" value="@Deger("musteri")" placeholder="Ad, abone no veya telefon" /></div>
                        <div class="df-admin-field"><label for="marka">Marka</label><select id="marka" name="marka"><option value="">Tümü</option>@foreach (var marka in Model.Markalar) { <option value="@marka" selected="@(Deger("marka") == marka ? "selected" : null)">@marka</option> }</select></div>
                        <div class="df-admin-field"><label for="cihazTipi">Yakıcı Cihaz Tipi</label><select id="cihazTipi" name="cihazTipi"><option value="">Tümü</option>@foreach (var tip in Model.CihazTipleri) { <option value="@tip" selected="@(Deger("cihazTipi") == tip ? "selected" : null)">@DevreyeAlmaCihazTipiSunumu.Etiket(tip)</option> }</select></div>
                        <div class="df-admin-field"><label for="durum">Durum</label><select id="durum" name="durum"><option value="">Tümü</option>@foreach (var durum in durumlar) { <option value="@durum.Kod" selected="@(Deger("durum") == durum.Kod ? "selected" : null)">@durum.Ad</option> }</select></div>
                        @if (!Model.ServisPaneli)
                        {
                            <div class="df-admin-field"><label for="servis">Yetkili Servis</label><input id="servis" type="search" name="servis" value="@Deger("servis")" placeholder="Servis adı" /></div>
                            <div class="df-admin-field"><label for="il">İl</label><select id="il" name="il"><option value="">Tümü</option>@foreach (var sehir in Model.Sehirler) { <option value="@sehir" selected="@(Deger("il") == sehir ? "selected" : null)">@sehir</option> }</select></div>
                            <div class="df-admin-field"><label for="ilce">İlçe</label><input id="ilce" type="search" name="ilce" value="@Deger("ilce")" placeholder="İlçe" /></div>
                        }
                        <div class="df-admin-field"><label for="bas">Başlangıç Tarihi</label><input id="bas" type="date" name="bas" value="@Deger("bas")" /></div>
                        <div class="df-admin-field"><label for="bit">Bitiş Tarihi</label><input id="bit" type="date" name="bit" value="@Deger("bit")" /></div>
                    </div>
                    <div class="df-admin-filter-actions"><a class="df-btn df-btn-secondary df-btn-sm" href="@Model.TemizleUrl"><i class="bi bi-x-lg" aria-hidden="true"></i>Temizle</a><button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-search" aria-hidden="true"></i>Sonuçları Göster</button></div>
                </form>
            </div>
        </details>
        @if (!Model.Kayitlar.Any())
        {
            <div class="df-admin-empty"><i class="bi bi-inbox" aria-hidden="true"></i>Filtrelere uygun kayıt bulunamadı.</div>
        }
        else
        {
            <partial name="_DevreyeAlmaTable" model="Model.Kayitlar" />
        }
    </section>
    <partial name="_KayitSutunFiltresi" model='@("commissioningFilters")' />
</div>
