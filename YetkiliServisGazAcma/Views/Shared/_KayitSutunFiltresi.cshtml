@model string
<div id="historyColumnFilter" class="ys-history-column-popover" data-history-column-popover role="dialog" aria-labelledby="historyColumnTitle" hidden>
    <header><strong id="historyColumnTitle"></strong><button type="button" data-history-column-close title="Kapat" aria-label="Sütun filtresini kapat"><i class="bi bi-x-lg" aria-hidden="true"></i></button></header><div data-history-column-body></div><footer><button type="button" data-history-column-clear><i class="bi bi-x-circle" aria-hidden="true"></i>Temizle</button><button class="ys-history-apply" type="submit" form="@Model"><i class="bi bi-check2" aria-hidden="true"></i>Uygula</button></footer>
</div>
