@using YetkiliServisGazAcma.Entities
@model Tuple<List<Ys_YetkiBelgesi>, string, string>
@{
    var kayitlar = Model.Item1 ?? new List<Ys_YetkiBelgesi>();
    var durum = Model.Item2;
    var panel = Model.Item3;
    var bekleyen = durum == "bekleyen";
    var onayUrl = panel == "personel" ? Url.Action("Onayla", "PersonelPanel") : Url.Action("Onayla", "YetkiBelgesi");
    var redUrl = panel == "personel" ? Url.Action("Reddet", "PersonelPanel") : Url.Action("Reddet", "YetkiBelgesi");
    var bosMetin = durum switch
    {
        "onaylanan" => "Onaylanan yetki belgesi bulunmuyor.",
        "reddedilen" => "Reddedilen yetki belgesi bulunmuyor.",
        "suresi-dolan" => "Süresi dolan yetki belgesi bulunmuyor.",
        _ => "Onay bekleyen yetki belgesi bulunmuyor."
    };
}
<div class="df-table-wrap df-approval-table-wrap">
    <table class="df-table df-approval-table is-compact-approval">
        <thead>
            <tr>
                <th>Yetkili Servis</th>
                <th>Bağlı Şirket</th>
                <th>Başlangıç Tarihi</th>
                <th>Bitiş Tarihi</th>
                <th>Yükleme Tarihi</th>
                <th>Durum</th>
                <th>Belge</th>
                <th>@(bekleyen ? "Onay İşlemleri" : "Son İşlem")</th>
            </tr>
        </thead>
        <tbody>
            @if (!kayitlar.Any())
            {
                <tr class="approval-empty-row">
                    <td colspan="8">
                        <div class="df-empty">
                            <div class="df-empty-title">@bosMetin</div>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var s in kayitlar)
                {
                    var baslangic = s.YetkiBelgesiBaslangicTarihi ?? s.OlusturmaTarihi;
                    var kalanGun = (s.YetkiBelgesiBitisTarihi.Date - DateTime.Now.Date).Days;
                    var suresiDolmus = kalanGun < 0;
                    var onaylanabilir = YetkiBelgesiService.OnaylanabilirMi(s, DateTime.Today);
                    var kalanYazi = kalanGun < 0 ? $"{Math.Abs(kalanGun)} gün geçti" : $"{kalanGun} gün kaldı";
                    var durumClass = s.Durum == YetkiBelgesiDurumDegerleri.Onaylandi ? "is-approved" : s.Durum == YetkiBelgesiDurumDegerleri.Reddedildi ? "is-rejected" : suresiDolmus ? "is-expired" : "is-waiting";
                    var durumIcon = s.Durum == YetkiBelgesiDurumDegerleri.Onaylandi ? "bi-check-circle" : s.Durum == YetkiBelgesiDurumDegerleri.Reddedildi ? "bi-x-circle" : suresiDolmus ? "bi-calendar-x" : "bi-hourglass-split";
                    var durumYazi = s.Durum == YetkiBelgesiDurumDegerleri.Onaylandi ? "Onaylandı" : s.Durum == YetkiBelgesiDurumDegerleri.Reddedildi ? "Reddedildi" : suresiDolmus ? "Süresi doldu" : "Onay bekliyor";
                    var firmaAdi = s.Firma?.FirmaAdi ?? "";
                    var sirketAdi = s.Firma?.Sirket?.SirketAdi ?? "";
                    var firmaAdres = s.Firma?.Adres ?? "";
                    var vergiNo = s.Firma?.VergiNo ?? "";
                    var yukleme = s.OlusturmaTarihi.ToString("yyyy-MM-dd");
                    var baslangicFiltre = baslangic.ToString("yyyy-MM-dd");
                    var bitisFiltre = s.YetkiBelgesiBitisTarihi.ToString("yyyy-MM-dd");
                    var detailId = $"approval-detail-{panel}-{durum}-{s.Id}";

                    <tr data-approval-row="true"
                        data-firma="@firmaAdi"
                        data-sirket="@sirketAdi"
                        data-adres="@($"{firmaAdres} {s.Firma?.FaaliyetIli}")"
                        data-vergi="@vergiNo"
                        data-yukleme="@yukleme"
                        data-baslangic="@baslangicFiltre"
                        data-bitis="@bitisFiltre"
                        data-durum="@durum">
                        <td>
                            <div class="df-approval-service-name">
                                <span class="df-cell-main">@firmaAdi</span>
                                <button type="button" class="df-approval-expand" data-approval-expand aria-controls="@detailId" aria-expanded="false" aria-label="@firmaAdi ayrıntılarını aç" title="Satır ayrıntılarını aç"><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
                            </div>
                        </td>
                        <td>
                            <span class="df-approval-company-name">@(string.IsNullOrWhiteSpace(sirketAdi) ? "-" : sirketAdi)</span>
                            @if (!string.IsNullOrWhiteSpace(s.Firma?.FaaliyetIli))
                            {
                                <small class="df-approval-company-city"><i class="bi bi-geo-alt" aria-hidden="true"></i>@s.Firma.FaaliyetIli</small>
                            }
                        </td>
                        <td><time datetime="@baslangicFiltre">@baslangic.ToString("dd.MM.yyyy")</time></td>
                        <td><time datetime="@bitisFiltre">@s.YetkiBelgesiBitisTarihi.ToString("dd.MM.yyyy")</time></td>
                        <td><time datetime="@yukleme">@s.OlusturmaTarihi.ToString("dd.MM.yyyy")</time></td>
                        <td>
                            <span class="df-certificate-status @durumClass"><i class="bi @durumIcon" aria-hidden="true"></i>@durumYazi</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(s.DosyaYolu))
                            {
                                <a class="df-document-link is-icon" href="@Url.Action("Dosya", "YetkiBelgesi", new { id = s.Id })" target="_blank" rel="noopener noreferrer" title="Belgeyi İncele" aria-label="Belgeyi İncele"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i></a>
                            }
                            else
                            {
                                <span class="df-cell-sub">Dosya yüklenmemiş</span>
                            }
                        </td>
                        <td>
                            <div class="df-approval-row-actions">
                            @if (bekleyen)
                            {
                                    @if (onaylanabilir)
                                    {
                                        <form method="post" action="@onayUrl">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="df-approval-action is-approve"><i class="bi bi-check2" aria-hidden="true"></i><span>Onayla</span></button>
                                        </form>
                                    }
                                    <details class="df-approval-reject">
                                        <summary class="df-approval-action is-reject"><i class="bi bi-x-lg" aria-hidden="true"></i><span>Reddet</span></summary>
                                        <form method="post" action="@redUrl">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <label for="red-gerekce-@(panel)-@(durum)-@(s.Id)">Red gerekçesi</label>
                                            <input class="df-control" id="red-gerekce-@(panel)-@(durum)-@(s.Id)" type="text" name="gerekce" required maxlength="500" />
                                            <button type="submit" class="df-approval-action is-reject is-confirm"><i class="bi bi-check2" aria-hidden="true"></i><span>Reddi Kaydet</span></button>
                                        </form>
                                    </details>
                            }
                            else if (durum == "suresi-dolan")
                            {
                                <span class="df-cell-sub">Karar verilemez</span>
                            }
                            else
                            {
                                <div class="df-approval-decision"><strong>@(s.OnaylayanKullanici ?? "Sistem")</strong></div>
                            }
                            </div>
                        </td>
                    </tr>
                    <tr id="@detailId" class="df-approval-detail-row" data-approval-detail hidden>
                            <td colspan="8">
                                <div class="df-approval-detail-grid">
                                    <div><span>Vergi No</span><strong>@(string.IsNullOrWhiteSpace(vergiNo) ? "Tanımlı değil" : vergiNo)</strong></div>
                                    <div><span>Yetkili Kişi</span><strong>@(string.IsNullOrWhiteSpace(s.Firma?.YetkiliKisi) ? "Tanımlı değil" : s.Firma.YetkiliKisi)</strong></div>
                                    <div><span>Geçerlilik</span><strong>@kalanYazi</strong></div>
                                    <div><span>Yükleme</span><strong>@s.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</strong></div>
                                    <div class="is-wide"><span>Firma Adresi</span><strong>@(string.IsNullOrWhiteSpace(firmaAdres) ? "Tanımlı değil" : firmaAdres)</strong></div>
                                    @if (s.OnayTarihi.HasValue)
                                    {
                                        <div><span>Karar Tarihi</span><strong>@s.OnayTarihi.Value.ToString("dd.MM.yyyy HH:mm")</strong></div>
                                    }
                                    @if (!onaylanabilir && bekleyen)
                                    {
                                        <div class="is-wide"><span>Karar Durumu</span><strong>Belgenin tarih aralığı nedeniyle onaylanamaz.</strong></div>
                                    }
                                    @if (s.Durum == YetkiBelgesiDurumDegerleri.Reddedildi && !string.IsNullOrWhiteSpace(s.RedGerekce))
                                    {
                                        <div class="is-wide"><span>Red Gerekçesi</span><strong>@s.RedGerekce</strong></div>
                                    }
                                </div>
                            </td>
                        </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="df-approval-filter-empty" hidden>Filtreye uygun belge bulunamadı.</div>
