@model IReadOnlyList<DevreyeAlmaKayitDto>
@{
    var alan = ViewData["DevreyeAlmaAlan"] as string ?? "/personel-panel";
    var servisPaneli = alan == "/ys-devreyeal";
    var adminPaneli = alan == "/AdminPanel";
    var tumunuSecId = adminPaneli ? "adminTumunuSec" : "tumunuSec";
    var secimSinifi = adminPaneli ? "admin-row-check" : "row-check";
    ViewData["DevreyeAlmaColspan"] = servisPaneli ? 9 : 10;
}

<div class="df-admin-table-scroll">
    <table class="df-table df-commissioning-table @(servisPaneli ? "is-firm-history" : null)">
        <thead>
            <tr>
                <th scope="col" class="df-commissioning-col-select"><input id="@tumunuSecId" data-commissioning-select-all type="checkbox" aria-label="Tüm kayıtları seç" /></th>
                <th scope="col" class="df-commissioning-col-customer">Abone Adı Soyadı</th>
                <th scope="col" class="df-commissioning-col-installation">Tesisat No</th>
                <th scope="col" class="df-commissioning-col-contract">Sözleşme No</th>
                @if (!servisPaneli)
                {
                    <th scope="col" class="df-commissioning-col-company">Yetkili Servis</th>
                }
                <th scope="col" class="df-commissioning-col-type">Yakıcı Cihaz Tipi</th>
                <th scope="col" class="df-commissioning-col-device">Devreye Alınan Cihaz</th>
                <th scope="col" class="df-commissioning-col-date">Devreye Alma Tarihi</th>
                <th scope="col" class="df-commissioning-col-status">Durum</th>
                <th scope="col" class="df-commissioning-col-action">İşlem</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var d in Model)
        {
            var durumYazi = d.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "Tamamlandı" : d.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "İptal" : "Bekliyor";
            var durumSinif = d.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "df-pill-success" : d.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "df-pill-danger" : "df-pill-warning";
            var tarihVar = d.DevreyeAlmaTarihi.Year > 1900;
            var cihazMarka = d.CihazMarka ?? d.MarkaAdi;
            var cihazModeli = string.Equals(d.CihazModeli?.Trim(), cihazMarka?.Trim(), StringComparison.OrdinalIgnoreCase)
                || string.Equals(d.CihazModeli?.Trim(), d.CihazTipi?.Trim(), StringComparison.OrdinalIgnoreCase)
                    ? null
                    : d.CihazModeli;
            var detaySatiriId = $"devreye-alma-detay-{d.Id}";
            <tr class="df-commissioning-record-row" data-commissioning-record data-export-id="@d.Id">
                <td class="df-commissioning-col-select"><input class="@secimSinifi" data-commissioning-select type="checkbox" value="@d.Id" aria-label="@(d.MusteriAdi ?? d.TesistatNo) kaydını seç" /></td>
                <td class="df-commissioning-col-customer" data-label="Abone Adı Soyadı" data-record-id="@d.Id"><div class="df-cell-main" title="@d.MusteriAdi">@(string.IsNullOrWhiteSpace(d.MusteriAdi) ? "Abone adı kayıtlı değil" : d.MusteriAdi)</div>@if (!string.IsNullOrWhiteSpace(d.MusteriTelefon)) { <div class="df-cell-sub"><i class="bi bi-telephone" aria-hidden="true"></i> @d.MusteriTelefon</div> }</td>
                <td class="df-commissioning-col-installation" data-label="Tesisat No"><span class="df-cell-value">@(d.TesistatNo ?? "-")</span></td>
                <td class="df-commissioning-col-contract" data-label="Sözleşme No"><span class="df-cell-value">@(d.SozlesmeNo ?? "-")</span></td>
                @if (!servisPaneli)
                {
                    <td class="df-commissioning-col-company" data-label="Yetkili Servis"><div class="df-cell-value" title="@d.FirmaAdi">@(d.FirmaAdi ?? "-")</div></td>
                }
                <td class="df-commissioning-col-type" data-label="Yakıcı Cihaz Tipi">
                    <partial name="_YakiciCihazTipiEtiketi" model='@(d.CihazTipi ?? "")' />
                </td>
                <td class="df-commissioning-col-device" data-label="Devreye Alınan Cihaz"><dl class="df-device-facts"><div><dt>Marka:</dt><dd>@(string.IsNullOrWhiteSpace(cihazMarka) ? "-" : cihazMarka)</dd></div>@if (!string.IsNullOrWhiteSpace(cihazModeli)) { <div class="df-device-model"><dt>Model:</dt><dd title="@cihazModeli">@cihazModeli</dd></div> }</dl></td>
                <td class="df-commissioning-col-date" data-label="Devreye Alma Tarihi"><time class="df-cell-value" datetime="@(tarihVar ? d.DevreyeAlmaTarihi.ToString("yyyy-MM-dd") : null)">@(tarihVar ? d.DevreyeAlmaTarihi.ToString("dd.MM.yyyy") : "Tarih bilgisi yok")</time></td>
                <td class="df-commissioning-col-status" data-label="Durum"><span class="df-pill @durumSinif">@durumYazi</span></td>
                <td class="df-commissioning-col-action">
                    <div class="df-commissioning-row-actions">
                        <button class="df-icon-action commissioning-row-action df-commissioning-expand" type="button" data-commissioning-expand aria-expanded="false" aria-controls="@detaySatiriId" title="İşlem ayrıntılarını görüntüle" aria-label="@(string.IsNullOrWhiteSpace(d.MusteriAdi) ? "İşlem ayrıntılarını görüntüle" : $"{d.MusteriAdi} işlem ayrıntılarını görüntüle")"><i class="bi bi-eye" aria-hidden="true"></i></button>
                    </div>
                </td>
            </tr>
            <partial name="_DevreyeAlmaInlineDetails" model="d" />
        }
        </tbody>
    </table>
</div>
