@model YetkiliServisGazAcma.Entities.Ys_Firma
@{
    ViewData["Title"] = "Yetkili Servis Düzenle";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "YetkiliServisler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var servis = Model ?? ViewBag.Servis as YetkiliServisGazAcma.Entities.Ys_Firma;
    var sehirler = ViewBag.Sehirler as List<string> ?? new();
    var kategoriler = ViewBag.Kategoriler as List<YetkiliServisGazAcma.Entities.UrunKategori> ?? new();
    var markalar = ViewBag.Markalar as List<YetkiliServisGazAcma.Entities.Ys_Marka> ?? new();
    var seciliKategoriler = ViewBag.SeciliKategoriler as List<int> ?? new();
    var seciliMarkalar = ViewBag.SeciliMarkalar as List<int> ?? new();
}

<div class="df-admin-workspace df-admin-editor df-service-create-workspace">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-pencil-square"></i> Servis kaydı</div>
                <div class="df-panel-title">Yetkili Servis Düzenle</div>
                <div class="df-panel-subtitle">@servis?.FirmaAdi firmasının iletişim, kapsam ve durum bilgilerini güncelleyin.</div>
            </div>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/yetkiliservisler"><i class="bi bi-arrow-left"></i> Listeye Dön</a>
        </div>
    </section>

    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            <form method="post" action="/personel-panel/yetkiliservisler/duzenle/@servis?.Id">
                @Html.AntiForgeryToken()
                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-buildings"></i></span>
                        <div>
                            <h3>Firma ve İletişim Bilgileri</h3>
                            <p>Servisin kurumsal kimlik, iletişim ve faaliyet bilgilerini güncelleyin.</p>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                    <div class="df-admin-field"><label>Firma Adı *</label><input type="text" name="firmaAdi" value="@servis?.FirmaAdi" required /></div>
                    <div class="df-admin-field"><label>Yetkili Kişi</label><input type="text" name="yetkiliKisi" value="@servis?.YetkiliKisi" /></div>
                    <div class="df-admin-field"><label>Telefon</label><input type="text" name="telefon" value="@servis?.Telefon" /></div>
                    <div class="df-admin-field"><label>E-Posta</label><input type="email" name="email" value="@servis?.Email" /></div>
                    <div class="df-admin-field">
                        <label>Şehir *</label>
                        <select name="faaliyetIli" required>
                            <option value="">Seçiniz</option>
                            @foreach (var sehir in sehirler)
                            {
                                <option value="@sehir" selected="@(string.Equals(servis?.FaaliyetIli, sehir, StringComparison.CurrentCultureIgnoreCase))">@sehir</option>
                            }
                        </select>
                    </div>
                    <div class="df-admin-field"><label>Vergi No</label><input type="text" name="vergiNo" value="@servis?.VergiNo" /></div>
                    <div class="df-admin-field"><label>Vergi Dairesi</label><input type="text" name="vergiDairesi" value="@servis?.VergiDairesi" /></div>
                    <div class="df-admin-field is-wide"><label>Adres</label><input type="text" name="adres" value="@servis?.Adres" /></div>
                    </div>
                </section>

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-patch-check"></i></span>
                        <div>
                            <h3>Yetki ve Hizmet Kapsamı</h3>
                            <p>Servisin çalışabileceği markaları ve hizmet türlerini güncelleyin.</p>
                        </div>
                    </div>
                    <div class="df-admin-choice-layout">
                        <div class="df-admin-choice-box">
                        <h3 class="df-admin-section-title is-scope"><i class="bi bi-tags"></i> Marka Seçimi</h3>
                        <div class="df-admin-choice-note">Servisin işlem yapabildiği markaları seçin.</div>
                        <input class="marka-search" id="markaSearch" type="search" placeholder="Marka ara..." autocomplete="off" />
                        <div class="marka-list" id="markaList">
                            <label class="marka-item-all"><input type="checkbox" id="markaSelectAll" /> Tümünü Seç</label>
                            @foreach (var marka in markalar)
                            {
                                <label class="marka-item" data-name="@marka.MarkaAdi">
                                    <input type="checkbox" name="markaIds" value="@marka.Id" checked="@(seciliMarkalar.Contains(marka.Id))" />
                                    @marka.MarkaAdi
                                </label>
                            }
                        </div>
                        </div>
                        <div class="df-admin-choice-box">
                        <h3 class="df-admin-section-title is-scope"><i class="bi bi-ui-checks"></i> Kullanılan Hizmet Türleri</h3>
                        <div class="df-admin-choice-note">Servisin çalışacağı ürün veya hizmet türlerini işaretleyin.</div>
                        <div class="df-admin-choice-list">
                            @foreach (var kategori in kategoriler)
                            {
                                <label class="df-admin-choice">
                                    <input type="checkbox" name="kategoriIds" value="@kategori.Id" checked="@(seciliKategoriler.Contains(kategori.Id))" />
                                    <span class="df-admin-choice-icon">
                                        @if (!string.IsNullOrWhiteSpace(kategori.IconUrl))
                                        {
                                            <img src="@kategori.IconUrl" alt="" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-box-seam"></i>
                                        }
                                    </span>
                                    <span>@kategori.Ad</span>
                                </label>
                            }
                        </div>
                        </div>
                    </div>
                </section>

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-toggle-on"></i></span>
                        <div>
                            <h3>Kayıt Durumu</h3>
                            <p>Pasif kayıtlar yeni işlemlerde seçim listelerinde gösterilmez.</p>
                        </div>
                    </div>
                    <div class="df-admin-choice-box df-admin-status-box">
                        <div class="df-admin-choice-list">
                        <label class="df-admin-choice">
                            <input type="radio" name="aktifMi" value="true" checked="@(servis?.AktifMi == true)" />
                            <span class="df-admin-choice-icon"><i class="bi bi-check-circle"></i></span>
                            <span>Aktif</span>
                        </label>
                        <label class="df-admin-choice">
                            <input type="radio" name="aktifMi" value="false" checked="@(servis?.AktifMi == false)" />
                            <span class="df-admin-choice-icon"><i class="bi bi-slash-circle"></i></span>
                            <span>Pasif</span>
                        </label>
                        </div>
                    </div>
                </section>

                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/yetkiliservisler"><i class="bi bi-x-lg"></i> Vazgeç</a>
                    <button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2"></i> Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
<script>
    (function () {
        var search = document.getElementById("markaSearch");
        var list = document.getElementById("markaList");
        var selectAll = document.getElementById("markaSelectAll");
        if (search && list) {
            search.addEventListener("input", function () {
                var query = search.value.toLocaleLowerCase("tr-TR");
                list.querySelectorAll(".marka-item").forEach(function (item) {
                    item.style.display = (item.dataset.name || "").toLocaleLowerCase("tr-TR").includes(query) ? "flex" : "none";
                });
            });
        }
        if (selectAll && list) {
            var boxes = Array.from(list.querySelectorAll(".marka-item input[type='checkbox']"));
            selectAll.checked = boxes.length > 0 && boxes.every(function (box) { return box.checked; });
            selectAll.addEventListener("change", function () {
                boxes.forEach(function (box) { box.checked = selectAll.checked; });
            });
            boxes.forEach(function (box) {
                box.addEventListener("change", function () {
                    selectAll.checked = boxes.length > 0 && boxes.every(function (item) { return item.checked; });
                });
            });
        }
    })();
</script>
<script>
    (function () {
        var yetki = {
            yetkiBelgesi: @((ViewBag.YetkiBelgesi == true).ToString().ToLower()),
            rapor: @((ViewBag.YetkiRapor == true).ToString().ToLower())
        };
        function hide(selector, allowed) {
            if (allowed) return;
            document.querySelectorAll(selector).forEach(function (el) { el.style.display = "none"; });
        }
        hide('a[href="/personel-panel/onay-bekleyenler"]', yetki.yetkiBelgesi);
        hide('a[href="/personel-panel/onay-gecmisi"]', yetki.yetkiBelgesi);
        hide('a[href="/personel-panel/raporlar"]', yetki.rapor);
    })();
</script>
}
