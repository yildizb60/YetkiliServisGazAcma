@model YetkiliServisGazAcma.Entities.Ys_DevreyeAlma
@{
    ViewData["Title"] = "Devreye Alma Detay";
    ViewData["PanelTitle"] = "Devreye Alma Detay";
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "DevreyeAlmalar";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var marka = Model.Marka?.MarkaAdi ?? Model.CihazMarka ?? "-";
    var durumClass = Model.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "df-pill-success" : Model.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "df-pill-danger" : "df-pill-warning";
    var durumYazi = Model.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "Tamamlandı" : Model.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "İptal" : "Bekliyor";
}

@functions {
    private static string Deger(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : System.Net.WebUtility.HtmlDecode(value);
    }

    private static string Tarih(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd.MM.yyyy") : "-";
    }

    private static bool Gosterilebilir(string? value)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Trim() != "-"
            && !string.Equals(value.Trim(), "string", StringComparison.OrdinalIgnoreCase);
    }

    private static bool GecerliSeriNo(string? value)
    {
        if (!Gosterilebilir(value))
            return false;

        var sadeDeger = new string(value!.Where(char.IsLetterOrDigit).ToArray());
        return sadeDeger.Length > 0 && sadeDeger.Any(x => x != '0');
    }

    private static bool GecerliBelgeNo(string? value)
    {
        return GecerliSeriNo(value);
    }
}

<div class="cert-stack df-devreye-detail">
    <section class="df-page-panel">
        <div class="df-panel-head">
            <div>
                <h2 class="df-panel-title">Tesisat No: @Deger(Model.TesistatNo)</h2>
                <div class="df-panel-subtitle">@(Deger(Model.Firma?.FirmaAdi)) / @(Deger(marka))</div>
            </div>
            <div class="df-actions">
                <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/devreyealmalar">Listeye D&#246;n</a>
                <a class="df-btn df-btn-primary df-btn-sm" href="/personel-panel/devreyealma-pdf/@Model.Id" target="_blank"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
                <a class="df-btn df-btn-success df-btn-sm" href="/personel-panel/devreyealma-excel/@Model.Id" target="_blank"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
                <span class="df-pill @durumClass">@durumYazi</span>
            </div>
        </div>

        <div class="df-toolbar">
            <div class="df-form-row">
                <div class="df-field">
                    <label>Devreye Alma Tarihi</label>
                    <div class="df-control">@Model.DevreyeAlmaTarihi.ToString("dd.MM.yyyy")</div>
                </div>
                <div class="df-field">
                    <label>Marka</label>
                    <div class="df-control">@Deger(marka)</div>
                </div>
                <div class="df-field">
                    <label>Teknisyen</label>
                    <div class="df-control">@Deger(Model.TeknisyenAdi)</div>
                </div>
                <div class="df-field">
                    <label>Servis</label>
                    <div class="df-control">@Deger(Model.Firma?.FirmaAdi)</div>
                </div>
            </div>
        </div>
    </section>

    <div class="df-detail-grid">
        <section class="df-detail-card df-detail-card--customer">
            <div class="df-detail-card-title df-detail-card-title--icon"><i class="bi bi-person-vcard" aria-hidden="true"></i>M&#252;&#351;teri Bilgileri</div>
            <div class="df-detail-info">
                @if (Gosterilebilir(Model.MusteriAdi))
                {
                    <div class="info-item"><div class="info-label">M&#252;&#351;teri</div><div class="info-value">@Deger(Model.MusteriAdi)</div></div>
                }
                @if (Gosterilebilir(Model.MusteriTelefon))
                {
                    <div class="info-item"><div class="info-label">Telefon</div><div class="info-value">@Deger(Model.MusteriTelefon)</div></div>
                }
                @if (Gosterilebilir(Model.MusteriTcNo ?? Model.AboneNo))
                {
                    <div class="info-item"><div class="info-label">TC</div><div class="info-value">@Deger(Model.MusteriTcNo ?? Model.AboneNo)</div></div>
                }
                @if (Gosterilebilir(Model.Adres))
                {
                    <div class="info-item info-item-wide"><div class="info-label">Adres</div><div class="info-value">@Deger(Model.Adres)</div></div>
                }
            </div>
        </section>

        <section class="df-detail-card df-detail-card--installation">
            <div class="df-detail-card-title df-detail-card-title--icon"><i class="bi bi-house-gear" aria-hidden="true"></i>Tesisat Bilgileri</div>
            <div class="df-detail-info">
                @if (Gosterilebilir(Model.TesistatNo))
                {
                    <div class="info-item"><div class="info-label">Tesisat No</div><div class="info-value">@Deger(Model.TesistatNo)</div></div>
                }
                @if (Gosterilebilir(Model.AboneNo))
                {
                    <div class="info-item"><div class="info-label">Servis Cari Kod</div><div class="info-value">@Deger(Model.AboneNo)</div></div>
                }
            </div>
        </section>

        <section class="df-detail-card df-detail-card--device">
            <div class="df-detail-card-title df-detail-card-title--icon"><i class="bi bi-fire" aria-hidden="true"></i>Cihaz Bilgileri</div>
            <div class="df-detail-info">
                @if (Gosterilebilir(Model.CihazTipi))
                {
                    <div class="info-item"><div class="info-label">Cihaz Tipi</div><div class="info-value">@Deger(Model.CihazTipi)</div></div>
                }
                @if (Gosterilebilir(Model.CihazModeli))
                {
                    <div class="info-item"><div class="info-label">Model</div><div class="info-value">@Deger(Model.CihazModeli)</div></div>
                }
                @if (GecerliSeriNo(Model.SeriNo))
                {
                    <div class="info-item"><div class="info-label">Seri No</div><div class="info-value">@Deger(Model.SeriNo)</div></div>
                }
                @if (Gosterilebilir(Model.CihazKapasite))
                {
                    <div class="info-item"><div class="info-label">Kapasite</div><div class="info-value">@Deger(Model.CihazKapasite)</div></div>
                }
            </div>
        </section>

        <section class="df-detail-card df-detail-card--technician">
            <div class="df-detail-card-title df-detail-card-title--icon"><i class="bi bi-person-gear" aria-hidden="true"></i>Teknisyen Bilgileri</div>
            <div class="df-detail-info">
                @if (Gosterilebilir(Model.TeknisyenAdi))
                {
                    <div class="info-item"><div class="info-label">Teknisyen</div><div class="info-value">@Deger(Model.TeknisyenAdi)</div></div>
                }
                @if (GecerliBelgeNo(Model.TeknisyenYetkiBelgesiNo))
                {
                    <div class="info-item"><div class="info-label">Yetki Belgesi No</div><div class="info-value">@Deger(Model.TeknisyenYetkiBelgesiNo)</div></div>
                }
            </div>
        </section>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notlar))
    {
        <section class="df-detail-card">
            <div class="df-detail-card-title">Notlar</div>
            <div class="df-detail-note">@Model.Notlar</div>
        </section>
    }

</div>
