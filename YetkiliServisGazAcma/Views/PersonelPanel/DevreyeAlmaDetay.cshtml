@model YetkiliServisGazAcma.Entities.Ys_DevreyeAlma
@{
    ViewData["Title"] = "Devreye Alma Detay";
    ViewData["PanelTitle"] = "Devreye Alma Detay";
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "DevreyeAlmalar";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var marka = Model.Marka?.MarkaAdi ?? Model.CihazMarka ?? "-";
    var durumClass = Model.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "df-pill-success" : Model.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "df-pill-danger" : "df-pill-warning";
    var durumYazi = Model.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "Tamamlandı" : Model.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "İptal" : "Bekliyor";
}

@functions {
    private static string Deger(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : System.Net.WebUtility.HtmlDecode(value);
    }

    private static string Tarih(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd.MM.yyyy") : "-";
    }

    private static bool Gosterilebilir(string? value)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Trim() != "-"
            && !string.Equals(value.Trim(), "string", StringComparison.OrdinalIgnoreCase);
    }

    private static bool GecerliSeriNo(string? value)
    {
        if (!Gosterilebilir(value))
            return false;

        var sadeDeger = new string(value!.Where(char.IsLetterOrDigit).ToArray());
        return sadeDeger.Length > 0 && sadeDeger.Any(x => x != '0');
    }

    private static bool GecerliBelgeNo(string? value)
    {
        return GecerliSeriNo(value);
    }
}

<div class="cert-stack df-devreye-detail">
    <section class="df-page-panel df-devreye-record-head">
        <div class="df-panel-head">
            <div>
                <h2 class="df-panel-title">Tesisat No: @Deger(Model.TesistatNo)</h2>
                <div class="df-panel-subtitle">@(Deger(Model.Firma?.FirmaAdi)) / @(Deger(marka))</div>
            </div>
            <div class="df-actions">
                <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/devreyealmalar">Listeye D&#246;n</a>
                <a class="df-btn df-btn-primary df-btn-sm" href="/personel-panel/devreyealma-pdf/@Model.Id" target="_blank"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
                <a class="df-btn df-btn-success df-btn-sm" href="/personel-panel/devreyealma-excel/@Model.Id" target="_blank"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
                <span class="df-pill @durumClass">@durumYazi</span>
            </div>
        </div>
        <div class="df-devreye-facts" aria-label="Devreye alma özeti">
            <div><i class="bi bi-calendar-check"></i><span>Devreye Alma Tarihi</span><strong>@Model.DevreyeAlmaTarihi.ToString("dd.MM.yyyy")</strong></div>
            <div><i class="bi bi-tag"></i><span>Marka</span><strong>@Deger(marka)</strong></div>
            <div><i class="bi bi-person-gear"></i><span>Teknisyen</span><strong>@Deger(Model.TeknisyenAdi)</strong></div>
            <div><i class="bi bi-building-check"></i><span>Servis</span><strong>@Deger(Model.Firma?.FirmaAdi)</strong></div>
        </div>
    </section>

    <section class="df-devreye-record">
        <section class="df-devreye-record-group is-customer">
            <div class="df-devreye-record-title"><i class="bi bi-person-vcard" aria-hidden="true"></i><span>M&#252;&#351;teri Bilgileri</span></div>
            <dl class="df-devreye-record-info">
                    @if (Gosterilebilir(Model.MusteriAdi))
                    {
                    <div><dt>M&#252;&#351;teri</dt><dd>@Deger(Model.MusteriAdi)</dd></div>
                    }
                    @if (Gosterilebilir(Model.MusteriTelefon))
                    {
                    <div><dt>Telefon</dt><dd>@Deger(Model.MusteriTelefon)</dd></div>
                    }
                    @if (Gosterilebilir(Model.MusteriTcNo ?? Model.AboneNo))
                    {
                    <div><dt>TC</dt><dd>@Deger(Model.MusteriTcNo ?? Model.AboneNo)</dd></div>
                    }
                    @if (Gosterilebilir(Model.Adres))
                    {
                    <div class="is-wide"><dt>Adres</dt><dd>@Deger(Model.Adres)</dd></div>
                    }
            </dl>
        </section>

        <section class="df-devreye-record-group is-installation">
            <div class="df-devreye-record-title"><i class="bi bi-house-gear" aria-hidden="true"></i><span>Tesisat Bilgileri</span></div>
            <dl class="df-devreye-record-info">
                    @if (Gosterilebilir(Model.TesistatNo))
                    {
                    <div><dt>Tesisat No</dt><dd>@Deger(Model.TesistatNo)</dd></div>
                    }
                    @if (Gosterilebilir(Model.AboneNo))
                    {
                    <div><dt>Abone No</dt><dd>@Deger(Model.AboneNo)</dd></div>
                    }
            </dl>
        </section>

        <section class="df-devreye-record-group is-device">
            <div class="df-devreye-record-title"><i class="bi bi-fire" aria-hidden="true"></i><span>Cihaz Bilgileri</span></div>
            <dl class="df-devreye-record-info">
                    @if (Gosterilebilir(Model.CihazTipi))
                    {
                    <div><dt>Cihaz Tipi</dt><dd>@Deger(Model.CihazTipi)</dd></div>
                    }
                    @if (Gosterilebilir(Model.CihazModeli))
                    {
                    <div class="is-wide"><dt>Model</dt><dd>@Deger(Model.CihazModeli)</dd></div>
                    }
                    @if (GecerliSeriNo(Model.SeriNo))
                    {
                    <div><dt>Seri No</dt><dd>@Deger(Model.SeriNo)</dd></div>
                    }
                    @if (Gosterilebilir(Model.CihazKapasite))
                    {
                    <div><dt>Kapasite</dt><dd>@Deger(Model.CihazKapasite)</dd></div>
                    }
            </dl>
        </section>

        <section class="df-devreye-record-group is-technician">
            <div class="df-devreye-record-title"><i class="bi bi-person-gear" aria-hidden="true"></i><span>Teknisyen Bilgileri</span></div>
            <dl class="df-devreye-record-info">
                    @if (Gosterilebilir(Model.TeknisyenAdi))
                    {
                    <div><dt>Teknisyen</dt><dd>@Deger(Model.TeknisyenAdi)</dd></div>
                    }
                    @if (GecerliBelgeNo(Model.TeknisyenYetkiBelgesiNo))
                    {
                    <div><dt>Yetki Belgesi No</dt><dd>@Deger(Model.TeknisyenYetkiBelgesiNo)</dd></div>
                    }
            </dl>
        </section>

        @if (Gosterilebilir(Model.Notlar))
        {
            <section class="df-devreye-record-note">
                <i class="bi bi-sticky" aria-hidden="true"></i>
                <div><span>Notlar</span><p>@Model.Notlar</p></div>
            </section>
        }
    </section>
</div>
