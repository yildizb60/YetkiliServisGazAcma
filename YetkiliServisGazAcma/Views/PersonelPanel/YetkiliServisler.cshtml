@model List<YetkiliServisGazAcma.Entities.Ys_Firma>
@{
    ViewData["Title"] = "Yetkili Servisler";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "YetkiliServisler";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var q = ViewBag.Query as string ?? "";
    var secilenIl = ViewBag.Il as string ?? "";
    var secilenDurum = ViewBag.Durum as string ?? "";
    var secilenSiralama = ViewBag.Siralama as string ?? "";
    var sehirler = ViewBag.Sehirler as List<string> ?? new List<string>();
    var servisYonetebilir = ViewBag.YetkiServis != false;
    var filtreAktif = !string.IsNullOrWhiteSpace(q)
        || !string.IsNullOrWhiteSpace(secilenIl)
        || !string.IsNullOrWhiteSpace(secilenDurum)
        || !string.IsNullOrWhiteSpace(secilenSiralama);
    ViewData["ServiceDirectoryAdmin"] = false;
    ViewData["ServiceDirectoryCanManage"] = servisYonetebilir;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/service-editor.css" asp-append-version="true" />
}

<div class="df-service-directory df-service-directory--detailed">
    <details class="df-service-filter" open="@(filtreAktif ? "open" : null)">
        <summary>
            <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Filtreler</strong></span>
            <span>@(filtreAktif ? "Filtre uygulandı" : "Aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <form method="get" action="/personel-panel/yetkiliservisler">
            <div class="df-service-filter-grid">
                <div class="filtre-alan">
                    <label for="personel-servis-q">Firma / Yetkili</label>
                    <input id="personel-servis-q" type="text" name="q" value="@q" placeholder="Firma, yetkili, VKN veya telefon..." />
                </div>
                <div class="filtre-alan">
                    <label for="personel-servis-il">İl</label>
                    <select id="personel-servis-il" name="il">
                        <option value="">Tümü</option>
                        @foreach (var sehir in sehirler)
                        {
                            <option value="@sehir" selected="@(secilenIl == sehir ? "selected" : null)">@sehir</option>
                        }
                    </select>
                </div>
                <div class="filtre-alan">
                    <label for="personel-servis-siralama">Devreye Alma Kayıt Sayısı</label>
                    <select id="personel-servis-siralama" name="siralama">
                        <option value="">Varsayılan</option>
                        <option value="azalan" selected="@(secilenSiralama == "azalan" ? "selected" : null)">En çoktan aza</option>
                        <option value="artan" selected="@(secilenSiralama == "artan" ? "selected" : null)">En azdan çoğa</option>
                    </select>
                </div>
                <div class="filtre-alan">
                    <label for="personel-servis-durum">Durum</label>
                    <select id="personel-servis-durum" name="durum">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(secilenDurum) ? "selected" : null)">Tümü</option>
                        <option value="1" selected="@(secilenDurum == "1" ? "selected" : null)">Aktif</option>
                        <option value="0" selected="@(secilenDurum == "0" ? "selected" : null)">Pasif</option>
                    </select>
                </div>
            </div>
            <div class="df-service-filter-actions">
                <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/yetkiliservisler"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
                <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-funnel-fill" aria-hidden="true"></i> Filtrele</button>
            </div>
        </form>
    </details>

    <section class="df-service-list df-service-list-modern">
        <div class="df-service-list-head">
            <div><h3><i class="bi bi-buildings" aria-hidden="true"></i> Servis Kayıtları</h3></div>
            <div class="df-actions">
                <span class="df-pill df-pill-info">@Model.Count kayıt</span>
                <a class="df-btn df-btn-secondary df-btn-sm" href="/yetkili-servisler" target="_blank"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Genel Liste</a>
                @if (servisYonetebilir)
                {
                    <a class="df-btn df-btn-primary df-btn-sm js-service-sheet-trigger" href="/personel-panel/yetkiliservisler/ekle" data-sheet-url="/personel-panel/yetkiliservisler/ekle" data-sheet-title="Yeni Yetkili Servis">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Servis
                    </a>
                }
            </div>
        </div>
        <partial name="_YetkiliServisKayitlari" model="Model" />
    </section>
</div>

@if (servisYonetebilir)
{
    <dialog class="df-directory-sheet df-personnel-service-sheet" data-service-sheet aria-labelledby="serviceSheetTitle">
        <div class="df-directory-sheet-frame">
            <header class="df-directory-sheet-head">
                <div><h2 id="serviceSheetTitle" data-service-sheet-title>Yetkili Servis</h2></div>
                <button type="button" class="df-directory-sheet-close" data-service-sheet-close title="Paneli kapat" aria-label="Paneli kapat"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </header>
            <div class="df-directory-sheet-body" data-service-sheet-body></div>
        </div>
    </dialog>
}

@section Scripts {
<script src="~/js/service-record-details.js" asp-append-version="true"></script>
<script>
    (function () {
        var records = Array.prototype.slice.call(document.querySelectorAll("[data-service-record]"));
        var sheet = document.querySelector("[data-service-sheet]");
        var sheetTitle = document.querySelector("[data-service-sheet-title]");
        var sheetBody = document.querySelector("[data-service-sheet-body]");
        var closeButton = document.querySelector("[data-service-sheet-close]");
        var activeRequest = 0;
        var closeTimer = 0;

        var initialParams = new URLSearchParams(window.location.search);
        var selectedId = initialParams.get("servis");
        if (selectedId && /^\d+$/.test(selectedId)) {
            var selectedRecord = records.find(function (record) { return record.dataset.serviceId === selectedId; });
            if (selectedRecord) {
                selectedRecord.querySelector("[data-service-expand]").click();
                selectedRecord.scrollIntoView({ block: "nearest" });
            }
            initialParams.delete("servis");
            window.history.replaceState({}, document.title, window.location.pathname + (initialParams.toString() ? "?" + initialParams.toString() : "") + window.location.hash);
        }

        if (!sheet || !sheetBody || !closeButton) return;

        function closeSheet() {
            if (!sheet.open) return;
            activeRequest += 1;
            sheet.classList.remove("is-visible");
            document.documentElement.classList.remove("df-sheet-open");
            window.clearTimeout(closeTimer);
            closeTimer = window.setTimeout(function () {
                closeTimer = 0;
                if (sheet.open) sheet.close();
                sheetBody.replaceChildren();
            }, 180);
        }

        function initializeServiceForm(root) {
            var search = root.querySelector("#service-brand-search");
            var selectAll = root.querySelector("#service-all-brands");
            var items = Array.prototype.slice.call(root.querySelectorAll("[data-brand-name]"));
            var boxes = items.map(function (item) { return item.querySelector("input"); }).filter(Boolean);
            var count = root.querySelector("#service-brand-count");
            var empty = root.querySelector("#service-brand-empty");
            function update() {
                var selected = boxes.filter(function (box) { return box.checked; }).length;
                if (selectAll) { selectAll.checked = selected > 0 && selected === boxes.length; selectAll.indeterminate = selected > 0 && selected < boxes.length; selectAll.disabled = boxes.length === 0; }
                if (count) count.textContent = selected + " seçili";
            }
            if (search) search.addEventListener("input", function () {
                var query = search.value.trim().toLocaleLowerCase("tr-TR");
                items.forEach(function (item) { item.hidden = !(item.dataset.brandName || "").toLocaleLowerCase("tr-TR").includes(query); });
                if (empty) empty.hidden = items.length === 0 || items.some(function (item) { return !item.hidden; });
            });
            if (selectAll) selectAll.addEventListener("change", function () { boxes.forEach(function (box) { box.checked = selectAll.checked; }); update(); });
            boxes.forEach(function (box) { box.addEventListener("change", update); });
            update();
            root.querySelector("input:not([type='hidden']), select")?.focus();
        }

        async function openSheet(trigger) {
            window.clearTimeout(closeTimer);
            closeTimer = 0;
            var requestId = ++activeRequest;
            var url = trigger.getAttribute("data-sheet-url") || trigger.getAttribute("href");
            sheetTitle.textContent = trigger.getAttribute("data-sheet-title") || "Yetkili Servis";
            sheetBody.innerHTML = '<div class="df-directory-sheet-loading" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Form hazırlanıyor</span></div>';
            if (!sheet.open) sheet.showModal();
            document.documentElement.classList.add("df-sheet-open");
            window.requestAnimationFrame(function () { sheet.classList.add("is-visible"); });
            try {
                var response = await fetch(url, { credentials: "same-origin", headers: { "X-Requested-With": "XMLHttpRequest" } });
                if (response.redirected) {
                    window.location.assign(response.url);
                    return;
                }
                if (!response.ok) throw new Error("Form alınamadı");
                var parsed = new DOMParser().parseFromString(await response.text(), "text/html");
                var sourceForm = parsed.querySelector(".service-editor form");
                if (!sourceForm) throw new Error("Form bulunamadı");
                if (requestId !== activeRequest) return;
                var editor = document.createElement("div");
                editor.className = "service-editor df-directory-sheet-editor";
                editor.appendChild(document.importNode(sourceForm, true));
                sheetBody.replaceChildren(editor);
                initializeServiceForm(editor);
            } catch (error) {
                if (requestId !== activeRequest) return;
                sheetBody.innerHTML = '<div class="df-directory-sheet-error"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><strong>Form açılamadı.</strong><p>Lütfen kısa bir süre sonra yeniden deneyin.</p></div>';
            }
        }

        document.querySelectorAll(".js-service-sheet-trigger").forEach(function (trigger) { trigger.addEventListener("click", function (event) { event.preventDefault(); openSheet(trigger); }); });
        sheetBody.addEventListener("click", function (event) { var cancelLink = event.target.closest('a[href="/personel-panel/yetkiliservisler"]'); if (!cancelLink) return; event.preventDefault(); closeSheet(); });
        closeButton.addEventListener("click", closeSheet);
        sheet.addEventListener("cancel", function (event) { event.preventDefault(); closeSheet(); });

        var initialTrigger = null;
        var editId = initialParams.get("duzenle");
        if (editId && /^\d+$/.test(editId)) {
            initialTrigger = Array.prototype.find.call(
                document.querySelectorAll(".js-service-sheet-trigger[data-sheet-url]"),
                function (trigger) {
                    return trigger.getAttribute("data-sheet-url") === "/personel-panel/yetkiliservisler/duzenle/" + editId;
                });
        } else if (initialParams.get("panel") === "ekle") {
            initialTrigger = document.querySelector('.js-service-sheet-trigger[data-sheet-url="/personel-panel/yetkiliservisler/ekle"]');
        }

        if (initialTrigger) {
            initialParams.delete("duzenle");
            initialParams.delete("panel");
            var cleanUrl = window.location.pathname + (initialParams.toString() ? "?" + initialParams.toString() : "");
            window.history.replaceState({}, document.title, cleanUrl);
            openSheet(initialTrigger);
        }
    })();
</script>
}
