@model YetkiliServisGazAcma.Entities.Ys_Firma
@{
    ViewData["Title"] = "Yetkili Servis Detayı";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "YetkiliServisler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    bool yYetkiBelgesi = ViewBag.YetkiBelgesi != false;
    bool yRapor = ViewBag.YetkiRapor != false;
    bool yServis = ViewBag.YetkiServis != false;
    var subeler = Model.Subeler?.Where(x => !x.SilindiMi).ToList() ?? new List<YetkiliServisGazAcma.Entities.Ys_Sube>();
    var markalar = Model.FirmaMarkalar?
        .Where(x => !x.SilindiMi && x.Marka != null)
        .Select(x => x.Marka!)
        .Distinct()
        .ToList() ?? new List<YetkiliServisGazAcma.Entities.Ys_Marka>();

    string NormalizeKategori(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var lower = value.Trim().ToLower(new System.Globalization.CultureInfo("tr-TR"))
            .Normalize(System.Text.NormalizationForm.FormD);
        var chars = lower
            .Where(ch => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch) != System.Globalization.UnicodeCategory.NonSpacingMark && char.IsLetterOrDigit(ch))
            .ToArray();
        return new string(chars)
            .Replace("ı", "i")
            .Replace("ş", "s")
            .Replace("ğ", "g")
            .Replace("ü", "u")
            .Replace("ö", "o")
            .Replace("ç", "c");
    }

    bool KullanilanKategoriMi(string? value)
    {
        var key = NormalizeKategori(value);
        return key == "kombi"
            || key.Contains("merkezikazan")
            || key.Contains("sofben")
            || key.Contains("sohben");
    }

    string KategoriIkon(string? value)
    {
        var key = NormalizeKategori(value);
        if (key.Contains("kombi") || key.Contains("kazan")) return "bi-fire";
        if (key.Contains("sofben") || key.Contains("sohben")) return "bi-droplet";
        return "bi-tools";
    }

    bool Gosterilebilir(string? value)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Trim() != "-"
            && !string.Equals(value.Trim(), "string", StringComparison.OrdinalIgnoreCase);
    }

    var kategoriler = Model.FirmaKategoriler?
        .Where(x => !x.SilindiMi && x.Kategori != null && KullanilanKategoriMi(x.Kategori.Ad))
        .Select(x => x.Kategori!)
        .ToList() ?? new List<YetkiliServisGazAcma.Entities.UrunKategori>();
}

<div class="df-service-detail">
    <section class="df-page-panel df-service-detail-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-building-check" aria-hidden="true"></i> YETKİLİ SERVİS</div>
                <h2 class="df-panel-title">@Model.FirmaAdi</h2>
                <div class="df-panel-subtitle">@(Model.Sirket?.SirketAdi ?? "Şirket bilgisi bulunmuyor")</div>
            </div>
            <div class="df-actions">
                <span class="df-pill @(Model.AktifMi ? "df-pill-success" : "df-pill-danger")">@(Model.AktifMi ? "Aktif" : "Pasif")</span>
                <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/yetkiliservisler"><i class="bi bi-arrow-left" aria-hidden="true"></i> Listeye Dön</a>
                @if (yServis)
                {
                    <a class="df-btn df-btn-primary df-btn-sm" href="/personel-panel/yetkiliservisler/duzenle/@Model.Id"><i class="bi bi-pencil" aria-hidden="true"></i> Düzenle</a>
                }
            </div>
        </div>
        <div class="df-service-summary" aria-label="Yetkili servis özeti">
            <div><span>Yetkili Kişi</span><strong>@(Gosterilebilir(Model.YetkiliKisi) ? Model.YetkiliKisi : "Tanımlı değil")</strong></div>
            <div><span>Faaliyet İli</span><strong>@(Gosterilebilir(Model.FaaliyetIli) ? Model.FaaliyetIli : "Tanımlı değil")</strong></div>
            <div><span>Marka Yetkisi</span><strong>@markalar.Count marka</strong></div>
            <div><span>Şube</span><strong>@subeler.Count şube</strong></div>
        </div>
    </section>

    <section class="df-service-detail-section is-company">
        <div class="df-service-detail-title"><i class="bi bi-building" aria-hidden="true"></i><span><strong>Firma ve İletişim</strong><small>Servisin kayıtlı kurumsal bilgileri</small></span></div>
        <dl class="df-service-info-grid">
            <div><dt>Firma</dt><dd>@Model.FirmaAdi</dd></div>
            <div><dt>Şirket</dt><dd>@(Model.Sirket?.SirketAdi ?? "-")</dd></div>
            @if (Gosterilebilir(Model.YetkiliKisi)) { <div><dt>Yetkili Kişi</dt><dd>@Model.YetkiliKisi</dd></div> }
            @if (Gosterilebilir(Model.VergiNo)) { <div><dt>Vergi No</dt><dd>@Model.VergiNo</dd></div> }
            @if (Gosterilebilir(Model.VergiDairesi)) { <div><dt>Vergi Dairesi</dt><dd>@Model.VergiDairesi</dd></div> }
            @if (Gosterilebilir(Model.Telefon)) { <div><dt>Telefon</dt><dd>@Model.Telefon</dd></div> }
            @if (Gosterilebilir(Model.Email)) { <div><dt>E-posta</dt><dd>@Model.Email</dd></div> }
            @if (Gosterilebilir(Model.FaaliyetIli)) { <div><dt>Faaliyet İli</dt><dd>@Model.FaaliyetIli</dd></div> }
            @if (Gosterilebilir(Model.Adres)) { <div class="is-wide"><dt>Adres</dt><dd>@Model.Adres</dd></div> }
        </dl>
    </section>

    <div class="df-service-detail-split">
        <section class="df-service-detail-section is-brand">
            <div class="df-service-detail-title"><i class="bi bi-patch-check" aria-hidden="true"></i><span><strong>Marka Yetkileri</strong><small>Servisin işlem yapabildiği markalar</small></span></div>
            <div class="df-service-chip-list">
                @if (markalar.Count == 0)
                {
                    <span class="df-service-empty-inline">Tanımlı marka bulunmuyor.</span>
                }
                else
                {
                    foreach (var marka in markalar)
                    {
                        <span class="df-service-chip"><i class="bi bi-check2" aria-hidden="true"></i>@marka.MarkaAdi</span>
                    }
                }
            </div>
        </section>

        <section class="df-service-detail-section is-category">
            <div class="df-service-detail-title"><i class="bi bi-grid" aria-hidden="true"></i><span><strong>Cihaz Kategorileri</strong><small>Servisin yetkili olduğu cihaz grupları</small></span></div>
            <div class="df-service-category-list">
                @if (kategoriler.Count == 0)
                {
                    <span class="df-service-empty-inline">Tanımlı kategori bulunmuyor.</span>
                }
                else
                {
                    foreach (var kategori in kategoriler)
                    {
                        <div><span class="df-service-category-icon"><i class="bi @KategoriIkon(kategori.Ad)" aria-hidden="true"></i></span><strong>@kategori.Ad</strong></div>
                    }
                }
            </div>
        </section>
    </div>

    <section class="df-service-detail-section is-branch">
        <div class="df-service-detail-title"><i class="bi bi-diagram-3" aria-hidden="true"></i><span><strong>Şubeler</strong><small>Servise bağlı aktif organizasyon noktaları</small></span><span class="df-pill df-pill-info">@subeler.Count kayıt</span></div>
        @if (subeler.Count == 0)
        {
            <div class="df-service-empty-inline">Şube kaydı bulunmuyor.</div>
        }
        else
        {
            <div class="df-service-branch-list">
                @foreach (var sube in subeler)
                {
                    <article>
                        <div><i class="bi bi-geo-alt" aria-hidden="true"></i><strong>@sube.SubeAdi</strong></div>
                        <p>@sube.Il / @sube.Ilce</p>
                        @if (Gosterilebilir(sube.Telefon)) { <span><i class="bi bi-telephone" aria-hidden="true"></i>@sube.Telefon</span> }
                        @if (Gosterilebilir(sube.Adres)) { <span><i class="bi bi-signpost" aria-hidden="true"></i>@sube.Adres</span> }
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
<script>
(function () {
    var yetki = {
        yetkiBelgesi: @((ViewBag.YetkiBelgesi == true).ToString().ToLower()),
        rapor: @((ViewBag.YetkiRapor == true).ToString().ToLower())
    };

    function hide(selector, allowed) {
        if (allowed) return;
        document.querySelectorAll(selector).forEach(function (element) {
            element.style.display = 'none';
        });
    }

    hide('a[href="/personel-panel/onay-bekleyenler"]', yetki.yetkiBelgesi);
    hide('a[href="/personel-panel/onay-gecmisi"]', yetki.yetkiBelgesi);
    hide('a[href="/personel-panel/raporlar"]', yetki.rapor);

    var raporSection = Array.from(document.querySelectorAll('.nav-section')).find(function (element) {
        return (element.textContent || '').toLocaleLowerCase('tr-TR').indexOf('rapor') >= 0;
    });
    if (!yetki.rapor && raporSection) raporSection.style.display = 'none';
})();
</script>
}
