@model List<YetkiliServisGazAcma.Entities.Ys_Marka>
@{
    ViewData["Title"] = "Yetkili Servis Markaları";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "Markalar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var markalar = Model ?? new List<YetkiliServisGazAcma.Entities.Ys_Marka>();
    var aktifSayisi = markalar.Count(x => x.AktifMi);
    var pasifSayisi = markalar.Count - aktifSayisi;
    var markaYonetebilir = ViewBag.YetkiMarkaYonet != false;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" />
}

<div class="df-admin-workspace df-brand-workspace">
    <section class="df-admin-list-card">
        <div class="df-service-list-head">
            <div><h3><i class="bi bi-tags" aria-hidden="true"></i> Marka Listesi</h3></div>
            <div class="df-admin-metrics df-inline-metrics" aria-label="Marka durum özeti">
                <button class="df-admin-metric active" type="button" data-brand-status="all"><i class="bi bi-collection"></i><span>Tümü</span><strong>@markalar.Count</strong></button>
                <button class="df-admin-metric is-active" type="button" data-brand-status="active"><i class="bi bi-check-circle"></i><span>Aktif</span><strong>@aktifSayisi</strong></button>
                <button class="df-admin-metric is-passive" type="button" data-brand-status="passive"><i class="bi bi-slash-circle"></i><span>Pasif</span><strong>@pasifSayisi</strong></button>
            </div>
            @if (markaYonetebilir)
            {
                <button class="df-btn df-btn-primary df-btn-sm js-personnel-brand-create" type="button"><i class="bi bi-plus-lg"></i> Yeni Marka</button>
            }
        </div>
    <details class="df-admin-filter">
        <summary>
            <span>
                <i class="bi bi-funnel"></i>
                <span><strong>Kayıtları Filtrele</strong></span>
            </span>
            <span>Filtreleri aç <i class="bi bi-chevron-down"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <div class="df-admin-filter-grid">
                <div class="df-admin-field">
                    <label for="brandSearch">Arama</label>
                    <input id="brandSearch" type="search" placeholder="Marka adı veya açıklama..." autocomplete="off" />
                </div>
                <div class="df-admin-field">
                    <label for="brandStatus">Durum</label>
                    <select id="brandStatus"><option value="all">Tümü</option><option value="active">Aktif</option><option value="passive">Pasif</option></select>
                </div>
            </div>
        </div>
    </details>

        <div class="df-admin-table-scroll">
            <table class="df-table">
                <thead>
                    <tr><th>Marka Adı</th><th>Açıklama</th><th>Durum</th><th>İşlemler</th></tr>
                </thead>
                <tbody>
                    @if (!markalar.Any())
                    {
                        <tr><td colspan="4"><div class="df-admin-empty">Henüz marka kaydı bulunmuyor.</div></td></tr>
                    }
                    else
                    {
                        foreach (var marka in markalar)
                        {
                            <tr data-brand-row data-status="@(marka.AktifMi ? "active" : "passive")" data-search="@($"{marka.MarkaAdi} {marka.Aciklama}".ToLowerInvariant())">
                                <td><div class="df-cell-main">@marka.MarkaAdi</div></td>
                                <td><div class="df-cell-sub">@(string.IsNullOrWhiteSpace(marka.Aciklama) ? "-" : marka.Aciklama)</div></td>
                                <td><span class="df-pill @(marka.AktifMi ? "df-pill-success" : "df-pill-muted")">@(marka.AktifMi ? "Aktif" : "Pasif")</span></td>
                                <td>
                                    @if (markaYonetebilir)
                                    {
                                        <div class="df-actions">
                                            <button class="df-icon-action js-personnel-brand-edit" type="button" data-id="@marka.Id" data-name="@marka.MarkaAdi" data-description="@marka.Aciklama" data-active="@marka.AktifMi.ToString().ToLowerInvariant()"><i class="bi bi-pencil-square"></i> Düzenle</button>
                                            <form method="post" action="/personel-panel/markalar/sil/@marka.Id" onsubmit="return confirm('Bu markayı silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="df-icon-action is-danger"><i class="bi bi-trash"></i> Sil</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="df-cell-sub">Görüntüleme</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    <tr data-filter-empty hidden>
                        <td colspan="4"><div class="df-admin-empty">Filtreye uygun marka bulunamadı.</div></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (markaYonetebilir)
{
    <div class="df-modal" id="personnelBrandEditModal" aria-hidden="true">
        <div class="df-modal-backdrop" data-brand-modal-close></div>
        <div class="df-modal-dialog df-modal-dialog-sm" role="dialog" aria-modal="true" aria-labelledby="personnelBrandModalTitle" tabindex="-1">
            <form id="personnelBrandEditForm" method="post">
                @Html.AntiForgeryToken()
                <div class="df-modal-header">
                    <div class="df-modal-heading"><span class="df-modal-icon"><i class="bi bi-tag"></i></span><div><h3 id="personnelBrandModalTitle">Cihaz Markası</h3></div></div>
                    <button class="df-modal-close" type="button" data-brand-modal-close aria-label="Kapat"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="df-modal-body">
                    <div class="df-modal-form-grid">
                        <div class="df-admin-field"><label for="personnelBrandName">Marka Adı *</label><input id="personnelBrandName" type="text" name="MarkaAdi" required /></div>
                        <div class="df-admin-field"><label for="personnelBrandStatus">Kayıt Durumu</label><select id="personnelBrandStatus" name="AktifMi"><option value="true">Aktif</option><option value="false">Pasif</option></select></div>
                        <div class="df-admin-field is-wide"><label for="personnelBrandDescription">Açıklama</label><textarea id="personnelBrandDescription" name="Aciklama" rows="3"></textarea></div>
                    </div>
                </div>
                <div class="df-modal-footer"><button class="df-btn df-btn-secondary" type="button" data-brand-modal-close>Vazgeç</button><button class="df-btn df-btn-primary" type="submit"><i class="bi bi-check2"></i> Kaydet</button></div>
            </form>
        </div>
    </div>
}

@section Scripts {
<script>
    (function () {
        var search = document.getElementById("brandSearch");
        var statusButtons = Array.from(document.querySelectorAll("button[data-brand-status]"));
        var statusSelect = document.getElementById("brandStatus");
        var rows = Array.from(document.querySelectorAll("[data-brand-row]"));
        var emptyRow = document.querySelector("[data-filter-empty]");
        var currentStatus = "all";

        function filterRows() {
            var query = search ? search.value.trim().toLocaleLowerCase("tr-TR") : "";
            var visible = 0;
            rows.forEach(function (row) {
                var statusMatches = currentStatus === "all" || row.dataset.status === currentStatus;
                var searchMatches = !query || (row.dataset.search || "").toLocaleLowerCase("tr-TR").includes(query);
                var show = statusMatches && searchMatches;
                row.hidden = !show;
                if (show) visible += 1;
            });
            if (emptyRow) emptyRow.hidden = visible !== 0 || rows.length === 0;
        }

        statusButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                currentStatus = button.dataset.brandStatus || "all";
                if (statusSelect) statusSelect.value = currentStatus;
                statusButtons.forEach(function (item) { item.classList.toggle("active", item === button); });
                filterRows();
            });
        });
        if (statusSelect) {
            statusSelect.addEventListener("change", function () {
                currentStatus = statusSelect.value || "all";
                statusButtons.forEach(function (item) { item.classList.toggle("active", item.dataset.brandStatus === currentStatus); });
                filterRows();
            });
        }
        if (search) search.addEventListener("input", filterRows);

        var editModal = document.getElementById("personnelBrandEditModal");
        var editForm = document.getElementById("personnelBrandEditForm");
        var modalTitle = document.getElementById("personnelBrandModalTitle");
        var lastEditTrigger = null;
        function openEditModal(trigger, values) {
            if (!editModal || !editForm) return;
            lastEditTrigger = trigger;
            editForm.action = values.action;
            document.getElementById("personnelBrandName").value = values.name || "";
            document.getElementById("personnelBrandStatus").value = values.active === false ? "false" : "true";
            document.getElementById("personnelBrandDescription").value = values.description || "";
            if (modalTitle) modalTitle.textContent = values.title;
            editModal.classList.add("is-open");
            editModal.setAttribute("aria-hidden", "false");
            document.body.classList.add("df-modal-open");
            document.getElementById("personnelBrandName").focus();
        }
        function closeEditModal() {
            if (!editModal) return;
            editModal.classList.remove("is-open");
            editModal.setAttribute("aria-hidden", "true");
            document.body.classList.remove("df-modal-open");
            lastEditTrigger?.focus();
        }
        document.addEventListener("click", function (event) {
            var createButton = event.target.closest(".js-personnel-brand-create");
            if (createButton) {
                openEditModal(createButton, {
                    action: "@Url.Action("MarkaEkle", "PersonelPanel")",
                    title: "Yeni Cihaz Markası",
                    active: true
                });
                return;
            }
            var button = event.target.closest(".js-personnel-brand-edit");
            if (button && editModal && editForm) {
                openEditModal(button, {
                    action: "/personel-panel/markalar/duzenle/" + button.dataset.id,
                    title: "Cihaz Markasını Düzenle",
                    name: button.dataset.name,
                    description: button.dataset.description,
                    active: button.dataset.active === "true"
                });
                return;
            }
            if (event.target.closest("[data-brand-modal-close]")) closeEditModal();
        });
        document.addEventListener("keydown", function (event) { if (event.key === "Escape" && editModal?.classList.contains("is-open")) closeEditModal(); });
    })();
</script>
<script>
    (function () {
        var yetki = {
            yetkiBelgesi: @((ViewBag.YetkiBelgesi == true).ToString().ToLower()),
            rapor: @((ViewBag.YetkiRapor == true).ToString().ToLower())
        };
        function hide(selector, allowed) {
            if (allowed) return;
            document.querySelectorAll(selector).forEach(function (el) { el.style.display = "none"; });
        }
        hide('a[href="/personel-panel/onay-bekleyenler"]', yetki.yetkiBelgesi);
        hide('a[href="/personel-panel/onay-gecmisi"]', yetki.yetkiBelgesi);
        hide('a[href="/personel-panel/raporlar"]', yetki.rapor);
    })();
</script>
}
