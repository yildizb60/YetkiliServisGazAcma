@model List<YetkiliServisGazAcma.Entities.Ys_Marka>
@{
    ViewData["Title"] = "Markalar";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "Markalar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var markalar = Model ?? new List<YetkiliServisGazAcma.Entities.Ys_Marka>();
    var aktifSayisi = markalar.Count(x => x.AktifMi);
    var pasifSayisi = markalar.Count - aktifSayisi;
    var markaYonetebilir = ViewBag.YetkiMarkaYonet != false;
}

<div class="df-admin-workspace df-brand-workspace">
    @if (TempData["Basarili"] != null)
    {
        <div class="df-alert df-alert-success">@TempData["Basarili"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-tags"></i> Marka kataloğu</div>
                <div class="df-panel-title">Markalar</div>
                <div class="df-panel-subtitle">Yetkili servislerin işlem yapabildiği cihaz markalarını görüntüleyin ve yönetin.</div>
            </div>
            @if (markaYonetebilir)
            {
                <a class="df-btn df-btn-primary df-btn-sm" href="/personel-panel/markalar/ekle">
                    <i class="bi bi-plus-lg"></i>
                    Yeni Marka
                </a>
            }
        </div>
        <div class="df-admin-metrics" aria-label="Marka durum özeti">
            <button class="df-admin-metric active" type="button" data-brand-status="all">
                <i class="bi bi-collection"></i><span>Tüm Markalar</span><strong>@markalar.Count</strong>
            </button>
            <button class="df-admin-metric is-active" type="button" data-brand-status="active">
                <i class="bi bi-check-circle"></i><span>Aktif</span><strong>@aktifSayisi</strong>
            </button>
            <button class="df-admin-metric is-passive" type="button" data-brand-status="passive">
                <i class="bi bi-slash-circle"></i><span>Pasif</span><strong>@pasifSayisi</strong>
            </button>
        </div>
    </section>

    <details class="df-admin-filter">
        <summary>
            <span>
                <i class="bi bi-funnel"></i>
                <span><strong>Filtreler</strong><small>Marka adı veya açıklama ile listede arayın.</small></span>
            </span>
            <span>Filtreleri aç <i class="bi bi-chevron-down"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <div class="df-admin-filter-grid">
                <div class="df-admin-field is-wide">
                    <label for="brandSearch">Arama</label>
                    <input id="brandSearch" type="search" placeholder="Marka adı veya açıklama..." autocomplete="off" />
                </div>
            </div>
        </div>
    </details>

    <section class="df-admin-list-card">
        <div class="df-service-list-head">
            <div>
                <h3><i class="bi bi-tags"></i> Marka Listesi</h3>
                <span><strong id="brandVisibleCount">@markalar.Count</strong> kayıt listeleniyor</span>
            </div>
        </div>
        <div class="df-admin-table-scroll">
            <table class="df-table">
                <thead>
                    <tr><th>Marka Adı</th><th>Açıklama</th><th>Durum</th><th>İşlemler</th></tr>
                </thead>
                <tbody>
                    @if (!markalar.Any())
                    {
                        <tr><td colspan="4"><div class="df-admin-empty">Henüz marka kaydı bulunmuyor.</div></td></tr>
                    }
                    else
                    {
                        foreach (var marka in markalar)
                        {
                            <tr data-brand-row data-status="@(marka.AktifMi ? "active" : "passive")" data-search="@($"{marka.MarkaAdi} {marka.Aciklama}".ToLowerInvariant())">
                                <td><div class="df-cell-main">@marka.MarkaAdi</div></td>
                                <td><div class="df-cell-sub">@(string.IsNullOrWhiteSpace(marka.Aciklama) ? "-" : marka.Aciklama)</div></td>
                                <td><span class="df-pill @(marka.AktifMi ? "df-pill-success" : "df-pill-muted")">@(marka.AktifMi ? "Aktif" : "Pasif")</span></td>
                                <td>
                                    @if (markaYonetebilir)
                                    {
                                        <div class="df-actions">
                                            <a class="df-icon-action" href="/personel-panel/markalar/duzenle/@marka.Id"><i class="bi bi-pencil-square"></i> Düzenle</a>
                                            <form method="post" action="/personel-panel/markalar/sil/@marka.Id" onsubmit="return confirm('Bu markayı silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="df-icon-action is-danger"><i class="bi bi-trash"></i> Sil</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="df-cell-sub">Görüntüleme</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    <tr data-filter-empty hidden>
                        <td colspan="4"><div class="df-admin-empty">Filtreye uygun marka bulunamadı.</div></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
<script>
    (function () {
        var search = document.getElementById("brandSearch");
        var statusButtons = Array.from(document.querySelectorAll("[data-brand-status]"));
        var rows = Array.from(document.querySelectorAll("[data-brand-row]"));
        var emptyRow = document.querySelector("[data-filter-empty]");
        var count = document.getElementById("brandVisibleCount");
        var currentStatus = "all";

        function filterRows() {
            var query = search ? search.value.trim().toLocaleLowerCase("tr-TR") : "";
            var visible = 0;
            rows.forEach(function (row) {
                var statusMatches = currentStatus === "all" || row.dataset.status === currentStatus;
                var searchMatches = !query || (row.dataset.search || "").toLocaleLowerCase("tr-TR").includes(query);
                var show = statusMatches && searchMatches;
                row.hidden = !show;
                if (show) visible += 1;
            });
            if (count) count.textContent = String(visible);
            if (emptyRow) emptyRow.hidden = visible !== 0 || rows.length === 0;
        }

        statusButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                currentStatus = button.dataset.brandStatus || "all";
                statusButtons.forEach(function (item) { item.classList.toggle("active", item === button); });
                filterRows();
            });
        });
        if (search) search.addEventListener("input", filterRows);
    })();
</script>
<script>
    (function () {
        var yetki = {
            yetkiBelgesi: @((ViewBag.YetkiBelgesi == true).ToString().ToLower()),
            rapor: @((ViewBag.YetkiRapor == true).ToString().ToLower())
        };
        function hide(selector, allowed) {
            if (allowed) return;
            document.querySelectorAll(selector).forEach(function (el) { el.style.display = "none"; });
        }
        hide('a[href="/personel-panel/onay-bekleyenler"]', yetki.yetkiBelgesi);
        hide('a[href="/personel-panel/onay-gecmisi"]', yetki.yetkiBelgesi);
        hide('a[href="/personel-panel/raporlar"]', yetki.rapor);
    })();
</script>
}
