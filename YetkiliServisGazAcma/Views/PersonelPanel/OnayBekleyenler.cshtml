@model List<AdminYetkiBelgesiOnayDto>
@{
    ViewData["Title"] = "Yetki Belgesi Onay ve Takip";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Yetki Belgesi";
    ViewData["ActiveMenu"] = "OnayBekleyenler";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var bekleyenler = Model ?? new List<AdminYetkiBelgesiOnayDto>();
    var onaylananlar = ViewBag.Onaylananlar as List<AdminYetkiBelgesiOnayDto> ?? new List<AdminYetkiBelgesiOnayDto>();
    var reddedilenler = ViewBag.Reddedilenler as List<AdminYetkiBelgesiOnayDto> ?? new List<AdminYetkiBelgesiOnayDto>();
    var suresiDolanlar = ViewBag.SuresiDolanlar as List<AdminYetkiBelgesiOnayDto> ?? new List<AdminYetkiBelgesiOnayDto>();
    var kayitlar = bekleyenler.Concat(onaylananlar).Concat(reddedilenler).Concat(suresiDolanlar).Cast<YetkiBelgesiKayitDto>().ToList();
    var sayfalama = ViewBag.Sayfalama as YetkiBelgesiOnaySayfalamaDto ?? new();
}
@section PageStyles {
    <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" />
}
@await Html.PartialAsync("_YetkiBelgesiOnayWorkspace", new Tuple<IReadOnlyList<YetkiBelgesiKayitDto>, YetkiBelgesiOnaySayfalamaDto, string>(kayitlar, sayfalama, "personel"))
@section Scripts {
    <script src="~/js/approval-row-details.js" asp-append-version="true"></script>
}
