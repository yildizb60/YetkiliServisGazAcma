@model List<YetkiliServisGazAcma.Entities.Ys_YetkiBelgesi>
@using YetkiliServisGazAcma.Entities
@{
    ViewData["Title"] = "Yetki Belgesi Onayları";
    ViewData["PanelTitle"] = "Yetki Belgesi Onayları";
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "OnayBekleyenler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var bekleyenler = Model ?? new List<Ys_YetkiBelgesi>();
    var onaylananlar = ViewBag.Onaylananlar as List<Ys_YetkiBelgesi> ?? new List<Ys_YetkiBelgesi>();
    var reddedilenler = ViewBag.Reddedilenler as List<Ys_YetkiBelgesi> ?? new List<Ys_YetkiBelgesi>();
}

@section Styles {
    <style>
        .approval-board {
            --approval-ink: #172033;
            --approval-muted: #667085;
            --approval-border: #dce2ea;
            --approval-blue: #1f5fbf;
            --approval-blue-soft: #edf4ff;
            --approval-purple: #7658d8;
            --approval-purple-soft: #f3efff;
            --approval-cyan: #0e91bd;
            --approval-cyan-soft: #eef9ff;
            --approval-green: #167a55;
            --approval-green-soft: #edf8f3;
            --approval-red: #b42336;
            --approval-red-soft: #fff1f2;
            display: grid;
            gap: 12px;
        }
        .approval-summary-panel { border-top: 3px solid var(--approval-purple); }
        .approval-summary-head { align-items: center; padding: 11px 14px; background: #fff; }
        .approval-title-wrap { display: flex; align-items: center; gap: 10px; min-width: 0; }
        .approval-title-icon { width: 34px; height: 34px; border-radius: 6px; color: var(--approval-purple); background: var(--approval-purple-soft); border: 1px solid #ded5fb; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; font-size: 16px; }
        .approval-metrics { display: flex; flex-wrap: wrap; gap: 7px; align-items: center; justify-content: flex-end; margin-left: auto; }
        .approval-metric { min-width: 138px; min-height: 40px; background: var(--approval-purple-soft); border: 1px solid #ded5fb; border-left: 3px solid var(--approval-purple); border-radius: 6px; padding: 6px 9px; display: grid; grid-template-columns: 25px minmax(0, 1fr) auto; align-items: center; gap: 7px; }
        .approval-metric:nth-child(2) { background: var(--approval-green-soft); border-color: #cde8db; border-left-color: var(--approval-green); }
        .approval-metric:nth-child(3) { background: var(--approval-red-soft); border-color: #f5d0d6; border-left-color: var(--approval-red); }
        .approval-metric-icon { width: 25px; height: 25px; border-radius: 5px; background: #fff; color: var(--approval-purple); display: inline-flex; align-items: center; justify-content: center; font-size: 13px; }
        .approval-metric:nth-child(2) .approval-metric-icon { color: var(--approval-green); }
        .approval-metric:nth-child(3) .approval-metric-icon { color: var(--approval-red); }
        .approval-metric .info-label { font-size: 10px; color: #526071; font-weight: 800; line-height: 1.2; }
        .approval-metric .info-value { font-size: 17px; color: var(--approval-ink); font-weight: 900; line-height: 1; }
        .filtre-kart { --detail-accent: var(--approval-cyan); background: #fff; border-radius: 8px; border: 1px solid var(--approval-border); padding: 12px 16px 14px; }
        .filtre-baslik { font-size: 13px; font-weight: 800; color: var(--approval-ink); margin-bottom: 10px; border-bottom: 1px solid var(--approval-border); padding-bottom: 8px; display: flex; align-items: center; gap: 7px; }
        .filtre-baslik i { color: var(--approval-cyan); }
        .filtre-grid { display: grid; grid-template-columns: repeat(6, minmax(130px, 1fr)); gap: 10px; align-items: end; }
        .filtre-alan { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
        .filtre-alan label { font-size: 10px; color: var(--approval-muted); font-weight: 800; }
        .filtre-alan input,
        .filtre-alan select { min-height: 36px; padding: 8px 10px; border: 1px solid #cfd7e3; border-radius: 5px; font-size: 12px; outline: none; color: var(--approval-ink); background: #fff; min-width: 0; }
        .filtre-alan input:focus,
        .filtre-alan select:focus { border-color: var(--approval-cyan); box-shadow: 0 0 0 3px rgba(14, 145, 189, .10); }
        .approval-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
        .approval-tab {
            border: 1px solid var(--df-border);
            background: var(--df-surface);
            color: var(--df-text-soft);
            border-radius: var(--df-radius);
            min-height: 36px;
            padding: 0 14px;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
        }
        .approval-tab.active { background: var(--approval-blue-soft); border-color: #c8d9f3; color: var(--approval-blue); }
        .approval-list-panel { border-top: 3px solid var(--approval-blue); }
        .approval-list-panel > .df-panel-head { padding: 11px 14px; background: #fff; }
        .approval-table-title { font-size: 14px; font-weight: 800; color: var(--approval-ink); display: flex; align-items: center; gap: 8px; }
        .approval-table-title i { color: var(--approval-blue); }
        .approval-panels [data-panel] { display: none; }
        .approval-panels [data-panel].active { display: block; }
        .approval-panels [data-panel] > .df-table-wrap { max-height: clamp(320px, calc(100vh - 360px), 520px); overflow: auto; scrollbar-gutter: stable; }
        .approval-panels .df-table thead th { position: sticky; top: 0; z-index: 2; background: #f7f9fc; box-shadow: 0 1px 0 var(--approval-border); }
        @@media (max-width: 1180px) {
            .filtre-grid { grid-template-columns: repeat(3, minmax(160px, 1fr)); }
        }
        @@media (max-width: 900px) {
            .approval-summary-head { align-items: flex-start; }
            .approval-metrics { width: 100%; justify-content: stretch; margin-left: 0; }
            .approval-metric { flex: 1 1 150px; }
            .filtre-grid { grid-template-columns: 1fr; }
            .approval-panels [data-panel] > .df-table-wrap { max-height: none; }
        }
    </style>
}

<div class="approval-board">
    @if (TempData["Basarili"] != null)
    {
        <div class="df-alert df-alert-success">@TempData["Basarili"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <section class="df-page-panel approval-summary-panel">
        <div class="df-panel-head approval-summary-head">
            <div class="approval-title-wrap">
                <span class="approval-title-icon" aria-hidden="true"><i class="bi bi-file-earmark-check"></i></span>
                <div>
                    <h2 class="df-panel-title">Yetki Belgesi Onayları</h2>
                    <div class="df-panel-subtitle">Size tanımlı şirketlerdeki başvuruları inceleyin ve sonuçlandırın.</div>
                </div>
            </div>
            <div class="approval-metrics" aria-label="Yetki belgesi durum ozeti">
                <div class="approval-metric">
                    <span class="approval-metric-icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                    <div class="info-label">Onaya G&#246;nderildi</div>
                    <div class="info-value">@bekleyenler.Count</div>
                </div>
                <div class="approval-metric">
                    <span class="approval-metric-icon" aria-hidden="true"><i class="bi bi-check-circle"></i></span>
                    <div class="info-label">Onaylananlar</div>
                    <div class="info-value">@onaylananlar.Count</div>
                </div>
                <div class="approval-metric">
                    <span class="approval-metric-icon" aria-hidden="true"><i class="bi bi-x-circle"></i></span>
                    <div class="info-label">Reddedilenler</div>
                    <div class="info-value">@reddedilenler.Count</div>
                </div>
            </div>
        </div>
    </section>

    <section class="filtre-kart">
        <div class="filtre-baslik"><i class="bi bi-funnel" aria-hidden="true"></i>Filtrele</div>
        <div class="filtre-grid">
            <div class="filtre-alan">
                <label>Firma</label>
                <input type="text" id="filterFirma" placeholder="Firma adı" autocomplete="off" />
            </div>
            <div class="filtre-alan">
                <label>Şirket</label>
                <input type="text" id="filterSirket" placeholder="Şirket adı" autocomplete="off" />
            </div>
            <div class="filtre-alan">
                <label>Yükleme</label>
                <input type="date" id="filterYukleme" />
            </div>
            <div class="filtre-alan">
                <label>Başlangıç</label>
                <input type="date" id="filterBaslangic" />
            </div>
            <div class="filtre-alan">
                <label>Bitiş</label>
                <input type="date" id="filterBitis" />
            </div>
            <div class="filtre-alan">
                <label>Durum</label>
                <select id="filterDurum">
                    <option value="bekleyen">Onaya Gönderildi</option>
                    <option value="onaylanan">Onaylananlar</option>
                    <option value="reddedilen">Reddedilenler</option>
                </select>
            </div>
        </div>
    </section>

    <section class="df-page-panel approval-panels approval-list-panel">
        <div class="df-panel-head">
            <div class="approval-table-title"><i class="bi bi-list-check" aria-hidden="true"></i>Yetki Belgesi Listesi</div>
            <div class="approval-tabs" data-approval-tabs>
                <button type="button" class="approval-tab active" data-target="bekleyen">Onaya G&#246;nderildi (@bekleyenler.Count)</button>
                <button type="button" class="approval-tab" data-target="onaylanan">Onaylananlar (@onaylananlar.Count)</button>
                <button type="button" class="approval-tab" data-target="reddedilen">Reddedilenler (@reddedilenler.Count)</button>
            </div>
        </div>

        <div data-panel="bekleyen" class="active">
            @await Html.PartialAsync("~/Views/Shared/_YetkiBelgesiOnayTable.cshtml", new Tuple<List<Ys_YetkiBelgesi>, string, string>(bekleyenler, "bekleyen", "personel"))
        </div>
        <div data-panel="onaylanan">
            @await Html.PartialAsync("~/Views/Shared/_YetkiBelgesiOnayTable.cshtml", new Tuple<List<Ys_YetkiBelgesi>, string, string>(onaylananlar, "onaylanan", "personel"))
        </div>
        <div data-panel="reddedilen">
            @await Html.PartialAsync("~/Views/Shared/_YetkiBelgesiOnayTable.cshtml", new Tuple<List<Ys_YetkiBelgesi>, string, string>(reddedilenler, "reddedilen", "personel"))
        </div>
    </section>
</div>

@section Scripts {
<script>
(function () {
    var tabs = document.querySelector('[data-approval-tabs]');
    var durumSelect = document.getElementById('filterDurum');
    var inputs = {
        firma: document.getElementById('filterFirma'),
        sirket: document.getElementById('filterSirket'),
        yukleme: document.getElementById('filterYukleme'),
        baslangic: document.getElementById('filterBaslangic'),
        bitis: document.getElementById('filterBitis')
    };

    function norm(value) {
        return (value || '').toLocaleLowerCase('tr-TR').trim();
    }

    function activatePanel(target) {
        if (!target) target = 'bekleyen';
        document.querySelectorAll('.approval-panels [data-panel]').forEach(function (panel) {
            panel.classList.toggle('active', panel.getAttribute('data-panel') === target);
        });
        if (tabs) {
            tabs.querySelectorAll('[data-target]').forEach(function (item) {
                item.classList.toggle('active', item.getAttribute('data-target') === target);
            });
        }
        if (durumSelect && durumSelect.value !== target) durumSelect.value = target;
        applyFilters();
    }

    function applyFilters() {
        var activePanel = document.querySelector('.approval-panels [data-panel].active');
        if (!activePanel) return;

        var filters = {
            firma: norm(inputs.firma && inputs.firma.value),
            sirket: norm(inputs.sirket && inputs.sirket.value),
            yukleme: inputs.yukleme ? inputs.yukleme.value : '',
            baslangic: inputs.baslangic ? inputs.baslangic.value : '',
            bitis: inputs.bitis ? inputs.bitis.value : ''
        };

        activePanel.querySelectorAll('tr[data-approval-row="true"]').forEach(function (row) {
            var visible = true;
            if (filters.firma) visible = visible && (norm(row.dataset.firma).indexOf(filters.firma) > -1 || norm(row.dataset.vergi).indexOf(filters.firma) > -1);
            if (filters.sirket) visible = visible && norm(row.dataset.sirket).indexOf(filters.sirket) > -1;
            if (filters.yukleme) visible = visible && row.dataset.yukleme === filters.yukleme;
            if (filters.baslangic) visible = visible && row.dataset.baslangic >= filters.baslangic;
            if (filters.bitis) visible = visible && row.dataset.bitis <= filters.bitis;
            row.style.display = visible ? '' : 'none';
        });
    }

    if (tabs) {
        tabs.addEventListener('click', function (event) {
            var btn = event.target.closest('[data-target]');
            if (btn) activatePanel(btn.getAttribute('data-target'));
        });
    }
    if (durumSelect) durumSelect.addEventListener('change', function () { activatePanel(durumSelect.value); });
    Object.keys(inputs).forEach(function (key) {
        if (inputs[key]) inputs[key].addEventListener('input', applyFilters);
    });
})();
</script>
}
