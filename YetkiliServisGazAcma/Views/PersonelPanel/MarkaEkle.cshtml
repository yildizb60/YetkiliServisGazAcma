@model YetkiliServisGazAcma.Entities.Ys_Marka
@{
    ViewData["Title"] = "Yeni Marka Ekle";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "Markalar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}

<div class="df-admin-workspace df-admin-editor df-brand-workspace">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-plus-circle"></i> Yeni kayıt</div>
                <div class="df-panel-title">Yeni Marka Ekle</div>
                <div class="df-panel-subtitle">Yetkili servislerin hizmet verebildiği cihaz markasını sisteme tanımlayın.</div>
            </div>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/markalar"><i class="bi bi-arrow-left"></i> Markalara Dön</a>
        </div>
    </section>

    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            <form method="post" action="/personel-panel/markalar/ekle">
                @Html.AntiForgeryToken()
                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-bookmark-plus"></i></span>
                        <div>
                            <h3>Marka Bilgileri</h3>
                            <p>Servis yetkilendirmelerinde kullanılacak marka adını tanımlayın.</p>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-half">
                            <label>Marka Adı *</label>
                            <input type="text" name="MarkaAdi" placeholder="Örn. Vaillant" required />
                        </div>
                        <div class="df-admin-field is-full">
                            <label>Açıklama</label>
                            <textarea name="Aciklama" placeholder="Gerekliyse kısa bir açıklama girin."></textarea>
                            <small class="df-admin-field-note">Açıklama zorunlu değildir.</small>
                        </div>
                    </div>
                </section>
                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/markalar"><i class="bi bi-x-lg"></i> Vazgeç</a>
                    <button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2"></i> Kaydet</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
<script>
    (function () {
        var yetki = {
            yetkiBelgesi: @((ViewBag.YetkiBelgesi == true).ToString().ToLower()),
            rapor: @((ViewBag.YetkiRapor == true).ToString().ToLower())
        };
        function hide(selector, allowed) {
            if (allowed) return;
            document.querySelectorAll(selector).forEach(function (el) { el.style.display = "none"; });
        }
        hide('a[href="/personel-panel/onay-bekleyenler"]', yetki.yetkiBelgesi);
        hide('a[href="/personel-panel/onay-gecmisi"]', yetki.yetkiBelgesi);
        hide('a[href="/personel-panel/raporlar"]', yetki.rapor);
    })();
</script>
}
