@{
    ViewData["Title"] = "Profilim";
    ViewData["ActiveMenu"] = "Profil";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var kullanici = ViewBag.Kullanici as YetkiliServisGazAcma.Entities.AppKullanici;
    var sirket = ViewBag.Sirket as YetkiliServisGazAcma.Entities.Dag_Sirket;
    var yetkilerim = ViewBag.Yetkilerim as List<string> ?? new();
    var adSoyad = kullanici?.AdSoyad ?? "";
    var basHarf = string.IsNullOrWhiteSpace(adSoyad) ? "" : adSoyad[..1].ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
    var sifreAcik = TempData.ContainsKey("SifreHata") || TempData.ContainsKey("SifreBasarili");
}
@section PageStyles { <link rel="stylesheet" href="~/css/personnel-profile.css" asp-append-version="true" /> }
<div class="personnel-account profile-theme--personnel">
    <aside class="account-identity" aria-label="Hesap bilgileri">
        <div class="account-avatar" aria-hidden="true">@basHarf</div>
        <h1>@adSoyad</h1>
        @if (kullanici != null) {
            <span class="df-pill @(kullanici.AktifMi ? "df-pill-success" : "df-pill-muted")">@(kullanici.AktifMi ? "Aktif" : "Pasif")</span>
        }
        <dl><div><dt><i class="bi bi-building" aria-hidden="true"></i>İşlem Yapılan Şirket</dt><dd>@(sirket?.SirketAdi ?? "Şirket seçilmedi")</dd></div><div><dt><i class="bi bi-geo-alt" aria-hidden="true"></i>İl</dt><dd>@(sirket?.Il ?? "-")</dd></div></dl>
    </aside>
    <div class="account-content">
    <div class="account-tabs" role="tablist" aria-label="Profil bölümleri" data-initial-tab="@(sifreAcik ? "security" : "personal")">
        <button type="button" role="tab" id="tab-personal" aria-controls="account-personal" aria-selected="true"><i class="bi bi-person-vcard" aria-hidden="true"></i>Kişisel Bilgiler</button>
        <button type="button" role="tab" id="tab-work" aria-controls="account-work" aria-selected="false"><i class="bi bi-building-check" aria-hidden="true"></i>Şirket ve Yetkiler</button>
        <button type="button" role="tab" id="tab-security" aria-controls="account-security" aria-selected="false"><i class="bi bi-shield-lock" aria-hidden="true"></i>Şifre ve Güvenlik</button>
    </div>
    <section class="account-section" id="account-personal" role="tabpanel" aria-labelledby="tab-personal">
        <form method="post" action="@Url.Action("ProfilGuncelle", "PersonelPanel")">
            @Html.AntiForgeryToken()
            <div class="account-fields">
                <label for="profile-name" class="account-field-wide">Ad Soyad<input id="profile-name" name="adSoyad" value="@adSoyad" autocomplete="name" required /></label>
                <label for="profile-email">E-posta<input id="profile-email" name="email" type="email" value="@kullanici?.Email" autocomplete="email" required /></label>
                <label for="profile-phone">Telefon<input id="profile-phone" name="telefon" type="tel" value="@kullanici?.PhoneNumber" autocomplete="tel" /></label>
            </div>
            <footer><button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2" aria-hidden="true"></i>Bilgileri Kaydet</button></footer>
        </form>
    </section>
    <section class="account-section" id="account-work" role="tabpanel" aria-labelledby="tab-work">
        <dl class="account-work-data">
            <div><dt>Aktif Şirket</dt><dd>@(sirket?.SirketAdi ?? "Tanımlı değil")</dd></div>
            <div><dt>Şirket İli</dt><dd>@(sirket?.Il ?? "Tanımlı değil")</dd></div>
            <div><dt>Şirket Telefonu</dt><dd>@(sirket?.Telefon ?? "Tanımlı değil")</dd></div>
            <div><dt>Şirket E-postası</dt><dd>@(sirket?.Email ?? "Tanımlı değil")</dd></div>
        </dl>
        <h2>Tanımlı Yetkiler</h2>
        <div class="account-permissions">
            @if (yetkilerim.Count == 0) { <span>Yetki tanımlı değil</span> }
            @foreach (var yetki in yetkilerim) { <span><i class="bi bi-check2" aria-hidden="true"></i>@yetki</span> }
        </div>
    </section>
    <section class="account-section" id="account-security" role="tabpanel" aria-labelledby="tab-security">
        <form method="post" action="@Url.Action("SifreDegistir", "PersonelPanel")">
            @Html.AntiForgeryToken()
            <div class="account-fields">
                <label for="profile-current-password" class="account-field-wide">Mevcut Şifre<input id="profile-current-password" type="password" name="mevcutSifre" autocomplete="current-password" required /></label>
                <label for="profile-new-password">Yeni Şifre<input id="profile-new-password" type="password" name="yeniSifre" autocomplete="new-password" required /></label>
                <label for="profile-confirm-password">Yeni Şifre Tekrar<input id="profile-confirm-password" type="password" name="yeniSifreTekrar" autocomplete="new-password" required /></label>
            </div>
            <footer><button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-lock" aria-hidden="true"></i>Şifreyi Güncelle</button></footer>
        </form>
    </section>
    </div>
</div>
@section Scripts { <script src="~/js/personnel-profile.js" asp-append-version="true"></script> }
