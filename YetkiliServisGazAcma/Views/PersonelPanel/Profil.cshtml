@{
    ViewData["Title"] = "Profil Yönetimi";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "Profil";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var kullanici = ViewBag.Kullanici as YetkiliServisGazAcma.Entities.AppKullanici;
    var sirket = ViewBag.Sirket as YetkiliServisGazAcma.Entities.Dag_Sirket;
    var yetkilerim = ViewBag.Yetkilerim as List<string> ?? new List<string>();
    var adSoyad = kullanici?.AdSoyad ?? "Personel";
    var email = kullanici?.Email ?? "-";
    var tel = kullanici?.PhoneNumber ?? "";
    var basHarf = !string.IsNullOrEmpty(adSoyad) ? adSoyad.Substring(0, 1).ToUpper() : "P";
}
<div class="df-profile-workspace df-personnel-profile">
    @if (TempData["Basarili"] != null) { <div class="df-alert df-alert-success">@TempData["Basarili"]</div> }
    @if (TempData["SifreBasarili"] != null) { <div class="df-alert df-alert-success">@TempData["SifreBasarili"]</div> }
    @if (TempData["SifreHata"] != null) { <div class="df-alert df-alert-danger">@TempData["SifreHata"]</div> }

    <section class="df-personnel-profile-shell">
        <aside class="df-personnel-identity">
            <div class="df-profile-avatar">@basHarf</div>
            <span class="df-profile-eyebrow">PERSONEL PROFİLİ</span>
            <h2>@adSoyad</h2>
            <span class="df-pill df-pill-info"><i class="bi bi-person-badge"></i> Şirket Personeli</span>
            <div class="df-personnel-contact">
                <div><i class="bi bi-envelope"></i><span>@email</span></div>
                <div><i class="bi bi-telephone"></i><span>@(string.IsNullOrWhiteSpace(tel) ? "Telefon tanımlı değil" : tel)</span></div>
            </div>
        </aside>

        <div class="df-personnel-profile-main">
            <div class="df-personnel-profile-title">
                <span><i class="bi bi-person-vcard"></i></span>
                <div>
                    <h3>Profil Bilgileri</h3>
                    <p>İletişim bilgilerinizi güncel tutun.</p>
                </div>
            </div>

            <form method="post" action="/personel-panel/profil-guncelle">
                @Html.AntiForgeryToken()
                <div class="df-personnel-form-grid">
                    <div class="df-profile-field"><label>Ad Soyad</label><input type="text" name="adSoyad" value="@adSoyad" required /></div>
                    <div class="df-profile-field"><label>E-posta</label><input type="email" name="email" value="@email" required /></div>
                    <div class="df-profile-field"><label>Telefon</label><input type="text" name="telefon" value="@tel" autocomplete="tel" /></div>
                </div>

                <div class="df-personnel-scope-strip" aria-label="Çalışma kapsamı">
                    <div class="df-personnel-scope-item is-company">
                        <i class="bi bi-building-check"></i>
                        <span>Bağlı Şirket</span>
                        <strong>@(sirket?.SirketAdi ?? "Tanımlı değil")</strong>
                    </div>
                    <div class="df-personnel-scope-item is-location">
                        <i class="bi bi-geo-alt"></i>
                        <span>Görev İli</span>
                        <strong>@(sirket?.Il ?? "Tanımlı değil")</strong>
                    </div>
                    <div class="df-personnel-scope-item is-permission">
                        <i class="bi bi-shield-check"></i>
                        <span>Yetkiler</span>
                        <div class="df-profile-permissions">
                            @if (yetkilerim.Count == 0) { <span class="df-profile-permission">Yetki tanımlı değil</span> }
                            else { foreach (var yetki in yetkilerim) { <span class="df-profile-permission"><i class="bi bi-check2"></i>@yetki</span> } }
                        </div>
                    </div>
                </div>

                <div class="df-personnel-profile-actions">
                    <div class="df-personnel-company-contact">
                        @if (!string.IsNullOrWhiteSpace(sirket?.Telefon)) { <span><i class="bi bi-telephone"></i>@sirket.Telefon</span> }
                        @if (!string.IsNullOrWhiteSpace(sirket?.Email)) { <span><i class="bi bi-envelope"></i>@sirket.Email</span> }
                    </div>
                    <button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2"></i> Bilgileri Kaydet</button>
                </div>
            </form>
        </div>
    </section>

    <details class="df-profile-section is-security df-profile-disclosure df-personnel-security">
        <summary><i class="bi bi-shield-lock"></i><div><strong>Şifre ve Güvenlik</strong><small>Şifrenizi gerektiğinde güncelleyin</small></div><i class="bi bi-chevron-down"></i></summary>
        <div class="df-profile-section-body">
            <form method="post" action="/personel-panel/sifre-degistir">
                @Html.AntiForgeryToken()
                <div class="df-profile-form-grid">
                    <div class="df-profile-field"><label>Mevcut Şifre</label><input type="password" name="mevcutSifre" autocomplete="current-password" required /></div>
                    <div class="df-profile-field"><label>Yeni Şifre</label><input type="password" name="yeniSifre" autocomplete="new-password" required /></div>
                    <div class="df-profile-field"><label>Yeni Şifre Tekrar</label><input type="password" name="yeniSifreTekrar" autocomplete="new-password" required /></div>
                </div>
                <div class="df-profile-actions"><button type="submit" class="df-btn df-btn-secondary df-btn-sm"><i class="bi bi-lock"></i> Şifreyi Güncelle</button></div>
            </form>
        </div>
    </details>
</div>

@section Scripts {
<script>
(function () {
    var yetki = {
        yetkiBelgesi: @((ViewBag.YetkiBelgesi == true).ToString().ToLower()),
        rapor: @((ViewBag.YetkiRapor == true).ToString().ToLower())
    };
    function hide(selector, allowed) {
        if (allowed) return;
        document.querySelectorAll(selector).forEach(function (element) { element.style.display = 'none'; });
    }
    hide('a[href="/personel-panel/onay-bekleyenler"]', yetki.yetkiBelgesi);
    hide('a[href="/personel-panel/onay-gecmisi"]', yetki.yetkiBelgesi);
    hide('a[href="/personel-panel/raporlar"]', yetki.rapor);
    var raporSection = Array.from(document.querySelectorAll('.nav-section')).find(function (element) {
        return (element.textContent || '').toLocaleLowerCase('tr-TR').indexOf('rapor') >= 0;
    });
    if (!yetki.rapor && raporSection) raporSection.style.display = 'none';
})();
</script>
}
