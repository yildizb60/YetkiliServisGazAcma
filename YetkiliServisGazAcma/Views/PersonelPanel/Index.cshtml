@using YetkiliServisGazAcma.Entities
@{
    ViewData["Title"] = "Personel Paneli";
    ViewData["PanelTitle"] = "Genel Bakış";
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "Dashboard";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var sonBekleyenler = ViewBag.SonBekleyenler as List<Ys_YetkiBelgesi> ?? new();
    var sonIslemler = ViewBag.SonIslemler as List<Ys_DevreyeAlma> ?? new();
    var onayBekleyen = ViewBag.OnayBekleyen is int ob ? ob : 0;
    var toplamFirma = ViewBag.ToplamFirma is int tf ? tf : 0;
    var toplamDevreyeAlma = ViewBag.ToplamDevreyeAlma is int td ? td : sonIslemler.Count;
    var toplamMarka = ViewBag.ToplamMarka is int tm ? tm : 0;
    var toplamSirket = ViewBag.ToplamSirket is int ts ? ts : 0;
    var buAy = ViewBag.BuAy is int ba ? ba : 0;
    var belgeYetkisi = ViewBag.YetkiBelgesi == true;
    var raporYetkisi = ViewBag.YetkiRapor == true;
    var sirketYetkisi = ViewBag.YetkiSirket == true;
    var islemler = new List<DashboardAction>();
    if (belgeYetkisi)
    {
        islemler.Add(new DashboardAction("Yetki Belgesi Onayları", "/personel-panel/onay-bekleyenler", "bi bi-file-earmark-check", onayBekleyen.ToString(), "bekleyen başvuru", "blue"));
    }
    islemler.Add(new DashboardAction("Cihaz Devreye Alma", "/personel-panel/devreyealmalar", "bi bi-bag-check", toplamDevreyeAlma.ToString(), $"toplam kayıt · bu ay {buAy}", "green"));
    islemler.Add(new DashboardAction("Yetkili Servisler", "/personel-panel/yetkiliservisler", "bi bi-building-check", toplamFirma.ToString(), "kayıtlı servis", "cyan"));
    islemler.Add(new DashboardAction("Cihaz Markaları", "/personel-panel/markalar", "bi bi-tags", toplamMarka.ToString(), "tanımlı marka", "amber"));
    if (sirketYetkisi)
    {
        islemler.Add(new DashboardAction("Dağıtım Şirketleri", "/personel-panel/sirketler", "bi bi-buildings", toplamSirket.ToString(), "tanımlı şirket", "purple"));
    }
    if (raporYetkisi)
    {
        islemler.Add(new DashboardAction("Raporlar", "/personel-panel/raporlar", "bi bi-bar-chart-line", "", "işlem ve belge raporları", "gray"));
    }
}

@functions {
    private sealed record DashboardAction(string Title, string Url, string Icon, string Value, string Meta, string Tone);
}

<div class="df-dashboard df-personnel-home">
    @await Component.InvokeAsync("YkcRandevuOzeti")

    <section class="df-home-section" aria-labelledby="personnel-actions-title">
        <div class="df-home-section-head">
            <div>
                <span class="df-home-kicker"><i class="bi bi-grid" aria-hidden="true"></i> Çalışma alanı</span>
                <h1 id="personnel-actions-title">İşlemler</h1>
            </div>
        </div>
        <div class="df-home-action-grid">
            @foreach (var item in islemler)
            {
                <a class="df-home-action is-@item.Tone" href="@item.Url">
                    <span class="df-home-action-icon"><i class="@item.Icon" aria-hidden="true"></i></span>
                    <span class="df-home-action-copy"><strong>@item.Title</strong><small>@item.Meta</small></span>
                    @if (!string.IsNullOrWhiteSpace(item.Value))
                    {
                        <span class="df-home-action-value">@item.Value</span>
                    }
                    <i class="bi bi-chevron-right df-home-action-arrow" aria-hidden="true"></i>
                </a>
            }
        </div>
    </section>

    <div class="df-home-feed-grid">
        @if (belgeYetkisi)
        {
            <section class="df-home-feed" aria-labelledby="pending-documents-title">
                <header>
                    <div><span class="df-home-feed-icon is-blue"><i class="bi bi-file-earmark-check" aria-hidden="true"></i></span><h2 id="pending-documents-title">Bekleyen Yetki Belgeleri</h2></div>
                    <a href="/personel-panel/onay-bekleyenler">Tümünü Gör <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </header>
                @if (!sonBekleyenler.Any())
                {
                    <div class="df-home-empty"><i class="bi bi-check2-circle" aria-hidden="true"></i><span>Bekleyen başvuru bulunmuyor.</span></div>
                }
                else
                {
                    <div class="df-home-feed-list">
                        @foreach (var belge in sonBekleyenler.Take(4))
                        {
                            <a href="/personel-panel/onay-bekleyenler" class="df-home-feed-row">
                                <span><strong>@(belge.Firma?.FirmaAdi ?? "Firma bilgisi yok")</strong><small>@(belge.Firma?.Sirket?.SirketAdi ?? "Şirket bilgisi yok")</small></span>
                                <time datetime="@belge.OlusturmaTarihi.ToString("O")">@belge.OlusturmaTarihi.ToString("dd.MM.yyyy")</time>
                            </a>
                        }
                    </div>
                }
                <footer><a href="/personel-panel/onay-gecmisi"><i class="bi bi-clock-history" aria-hidden="true"></i> Sonuçlanan yetki belgeleri</a></footer>
            </section>
        }

        <section class="df-home-feed" aria-labelledby="recent-commissioning-title">
            <header>
                <div><span class="df-home-feed-icon is-green"><i class="bi bi-bag-check" aria-hidden="true"></i></span><h2 id="recent-commissioning-title">Son Devreye Alma Kayıtları</h2></div>
                <a href="/personel-panel/devreyealmalar">Tümünü Gör <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </header>
            @if (!sonIslemler.Any())
            {
                <div class="df-home-empty"><i class="bi bi-inbox" aria-hidden="true"></i><span>Henüz işlem kaydı bulunmuyor.</span></div>
            }
            else
            {
                <div class="df-home-feed-list">
                    @foreach (var islem in sonIslemler.Take(4))
                    {
                        <a href="/personel-panel/devreyealmalar/detay/@islem.Id" class="df-home-feed-row">
                            <span><strong>@(string.IsNullOrWhiteSpace(islem.MusteriAdi) ? $"Tesisat {islem.TesistatNo}" : islem.MusteriAdi)</strong><small>@islem.TesistatNo · @(islem.Firma?.FirmaAdi ?? "Yetkili servis bilgisi yok")</small></span>
                            <time datetime="@islem.DevreyeAlmaTarihi.ToString("O")">@islem.DevreyeAlmaTarihi.ToString("dd.MM.yyyy")</time>
                        </a>
                    }
                </div>
            }
        </section>
    </div>
</div>
