@using YetkiliServisGazAcma.Entities
@using YetkiliServisGazAcma.Models.ViewModels
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["PanelTitle"] = "Ana Sayfa";
    ViewData["ActiveMenu"] = "Dashboard";
    ViewData["ContentClass"] = "personnel-home-content role-dashboard-content";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var ykc = ViewBag.YkcOzet as YkcDashboardOzetDto;
    var belgeYetkisi = ViewBag.YetkiBelgesi == true;
    var raporYetkisi = ViewBag.YetkiRapor == true;
    var servisYetkisi = ViewBag.YetkiServis == true;
    var markaYetkisi = ViewBag.YetkiMarka == true;
    var ykcTalepYetkisi = ViewBag.YetkiYkcTalep == true;
    var ykcRaporYetkisi = ViewBag.YetkiYkcRapor == true;
    var actions = new List<DashboardTileViewModel>();
    var quickActions = new List<DashboardTileViewModel>();
    var facts = new List<RoleDashboardFactViewModel>();
    var summaryMetrics = new List<RoleDashboardMetricViewModel>();

    var onayBekleyen = Sayi(ViewBag.OnayBekleyen);
    var onaylanan = Sayi(ViewBag.OnaylananBelge);
    var toplamDevreyeAlma = Sayi(ViewBag.ToplamDevreyeAlma);
    var buAyDevreyeAlma = Sayi(ViewBag.BuAy);
    var servisToplam = Sayi(ViewBag.ServisToplam);
    var servisAktif = Sayi(ViewBag.ServisAktif);

    if (belgeYetkisi)
    {
        var url = Url.Action("OnayBekleyenler", "PersonelPanel")!;
        actions.Add(new DashboardTileViewModel
        {
            Title = "Yetki Belgesi Onayları", Url = url, Icon = "bi bi-file-earmark-check",
            MetricValue = onayBekleyen.ToString(), MetricLabel = "bekleyen belge", Subtitle = "Belge kararları",
            Stat1Label = "onaylandı", Stat1Value = onaylanan.ToString(), Tone = "amber", Featured = onayBekleyen > 0
        });
        quickActions.Add(new DashboardTileViewModel
        {
            Title = "Karar bekleyen yetki belgeleri", Url = url, Icon = "bi bi-file-earmark-check",
            MetricValue = onayBekleyen.ToString(), MetricLabel = "bekleyen", Subtitle = "Yetki belgesi işlemleri",
            Tone = "amber", Featured = onayBekleyen > 0
        });
        facts.Add(new RoleDashboardFactViewModel { Icon = "bi bi-file-earmark-check", Value = onayBekleyen.ToString(), Label = "onay bekleyen belge", Url = url });
        summaryMetrics.Add(new RoleDashboardMetricViewModel { Label = "Bekleyen belge", Value = onayBekleyen.ToString(), Icon = "bi bi-file-earmark-check", Tone = "amber", Url = url });
    }

    if (ykcTalepYetkisi)
    {
        var taleplerUrl = Url.Action("Talepler", "Ykc")!;
        var takvimUrl = Url.Action("Takvim", "Ykc")!;
        actions.Add(new DashboardTileViewModel
        {
            Title = "Cihaz Değişim İşlemleri", Url = taleplerUrl, Icon = "bi bi-fire",
            MetricValue = (ykc?.Incelemede ?? 0).ToString(), MetricLabel = "inceleme bekleyen", Subtitle = "Talep ve kontrol süreci",
            Stat1Label = "kontrolde", Stat1Value = (ykc?.RandevuSaha ?? 0).ToString(), Tone = "blue",
            Featured = (ykc?.Incelemede ?? 0) > 0
        });
        quickActions.Add(new DashboardTileViewModel
        {
            Title = "Kontrol randevularını görüntüle", Url = takvimUrl, Icon = "bi bi-calendar2-week",
            MetricValue = (ykc?.RandevuSaha ?? 0).ToString(), MetricLabel = "kontrolde", Subtitle = "Randevu takvimi", Tone = "blue"
        });
        facts.Add(new RoleDashboardFactViewModel { Icon = "bi bi-calendar-check", Value = (ykc?.RandevuSaha ?? 0).ToString(), Label = "kontrol sürecindeki talep", Url = takvimUrl });
        summaryMetrics.Add(new RoleDashboardMetricViewModel { Label = "Kontrolde", Value = (ykc?.RandevuSaha ?? 0).ToString(), Icon = "bi bi-calendar-check", Tone = "blue", Url = takvimUrl });
    }

    if (raporYetkisi)
    {
        var url = Url.Action("DevreyeAlmalar", "PersonelPanel")!;
        actions.Add(new DashboardTileViewModel
        {
            Title = "Cihaz Devreye Alma Kayıtları", Url = url, Icon = "bi bi-tools",
            MetricValue = buAyDevreyeAlma.ToString(), MetricLabel = "bu ay kaydedilen", Subtitle = "Kayıt ve raporlama",
            Stat1Label = "toplam kayıt", Stat1Value = toplamDevreyeAlma.ToString(), Tone = "green"
        });
        quickActions.Add(new DashboardTileViewModel
        {
            Title = "Cihaz devreye alma arşivi", Url = url, Icon = "bi bi-archive",
            MetricValue = toplamDevreyeAlma.ToString(), MetricLabel = "kayıt", Subtitle = "Kayıt arşivi", Tone = "green"
        });
        facts.Add(new RoleDashboardFactViewModel { Icon = "bi bi-tools", Value = buAyDevreyeAlma.ToString(), Label = "bu ay kaydedilen cihaz", Url = url });
        summaryMetrics.Add(new RoleDashboardMetricViewModel { Label = "Devreye alma", Value = toplamDevreyeAlma.ToString(), Icon = "bi bi-tools", Tone = "green", Url = url });
    }

    if (servisYetkisi)
    {
        var url = Url.Action("YetkiliServisler", "PersonelPanel")!;
        actions.Add(new DashboardTileViewModel
        {
            Title = "Yetkili Servis Yönetimi", Url = url, Icon = "bi bi-building-check",
            MetricValue = servisAktif.ToString(), MetricLabel = "aktif servis", Subtitle = "Servis kayıtları",
            Stat1Label = "toplam servis", Stat1Value = servisToplam.ToString(), Tone = "cyan"
        });
        quickActions.Add(new DashboardTileViewModel
        {
            Title = "Aktif yetkili servis kayıtları", Url = url, Icon = "bi bi-building-check",
            MetricValue = servisAktif.ToString(), MetricLabel = "aktif", Subtitle = "Yetkili servis yönetimi", Tone = "cyan"
        });
        facts.Add(new RoleDashboardFactViewModel { Icon = "bi bi-building-check", Value = servisAktif.ToString(), Label = "aktif yetkili servis", Url = url });
        summaryMetrics.Add(new RoleDashboardMetricViewModel { Label = "Aktif servis", Value = servisAktif.ToString(), Icon = "bi bi-building-check", Tone = "cyan", Url = url });
    }

    if (markaYetkisi)
    {
        var url = Url.Action("Markalar", "PersonelPanel")!;
        actions.Add(new DashboardTileViewModel
        {
            Title = "Yetkili Servis Markaları", Url = url, Icon = "bi bi-tags",
            MetricLabel = "Marka kapsamını yönet", Subtitle = "Marka yönetimi", Tone = "cyan"
        });
        quickActions.Add(new DashboardTileViewModel
        {
            Title = "Marka kapsamını düzenle", Url = url, Icon = "bi bi-tags",
            MetricValue = "Aç", Subtitle = "Marka yönetimi", Tone = "cyan"
        });
    }

    if (ykcRaporYetkisi)
    {
        var url = Url.Action("Raporlar", "Ykc")!;
        actions.Add(new DashboardTileViewModel
        {
            Title = "Cihaz Değişim Raporları", Url = url, Icon = "bi bi-bar-chart-line",
            MetricLabel = "Operasyon sonuçlarını incele", Subtitle = "Cihaz değişim raporları", Tone = "blue"
        });
        quickActions.Add(new DashboardTileViewModel
        {
            Title = "Cihaz değişim raporlarını aç", Url = url, Icon = "bi bi-bar-chart-line",
            MetricValue = "Aç", Subtitle = "Raporlama", Tone = "blue"
        });
    }

    var profilUrl = Url.Action("Profil", "PersonelPanel")!;
    if (actions.Count == 0)
    {
        actions.Add(new DashboardTileViewModel
        {
            Title = "Profilim", Url = profilUrl, Icon = "bi bi-person-circle",
            MetricLabel = "Hesap bilgilerini görüntüle", Subtitle = "Hesabım", Tone = "blue"
        });
    }
    if (quickActions.Count < 3)
    {
        quickActions.Add(new DashboardTileViewModel
        {
            Title = "Profil bilgilerim", Url = profilUrl, Icon = "bi bi-person-circle",
            MetricValue = "Aç", Subtitle = "Hesabım", Tone = "blue"
        });
    }
    if (facts.Count == 0)
        facts.Add(new RoleDashboardFactViewModel { Icon = "bi bi-person-check", Value = "Aktif", Label = "personel hesabı", Url = profilUrl });
    if (summaryMetrics.Count == 0)
        summaryMetrics.Add(new RoleDashboardMetricViewModel { Label = "Hesap", Value = "Aktif", Icon = "bi bi-person-check", Tone = "blue", Url = profilUrl });

    var dashboardModel = new RoleDashboardViewModel
    {
        Variant = "personnel",
        AriaLabel = "Personel operasyon özeti",
        HeroTitle = "Operasyon Merkezi",
        HeroKicker = DateTime.Today.ToString("dd MMMM yyyy, dddd", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")),
        ActionsTitle = "Görev Alanlarım",
        QuickActionsTitle = "Hızlı İşlemler",
        QuickActionsMeta = "Güncel durum",
        ShowYkcCalendar = ykcTalepYetkisi,
        Facts = facts,
        Actions = actions,
        QuickActions = quickActions,
        SidePanel = ykcTalepYetkisi ? null : new RoleDashboardSidePanelViewModel
        {
            Title = "Yetki Özeti", Icon = "bi bi-shield-check", ItemsTitle = "Erişilebilir İşlemler",
            ActionText = "Profilim", ActionUrl = profilUrl, Metrics = summaryMetrics, Items = quickActions
        }
    };
}
@functions {
    private static int Sayi(object? value)
    {
        if (value is int sayi) return Math.Max(sayi, 0);
        return int.TryParse(value?.ToString(), out var sonuc) ? Math.Max(sonuc, 0) : 0;
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/personnel-home.css" asp-append-version="true" />
}

@await Html.PartialAsync("_RoleDashboard", dashboardModel)

@section Scripts {
    <script src="~/js/dashboard-carousel.js" asp-append-version="true"></script>
}
