@using YetkiliServisGazAcma.Entities
@using YetkiliServisGazAcma.Models.ViewModels
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["PanelTitle"] = "Ana Sayfa";
    ViewData["ActiveMenu"] = "Dashboard";
    ViewData["ContentClass"] = "personnel-home-content";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var ykc = ViewBag.YkcOzet as YkcDashboardOzetDto;
    var belgeYetkisi = ViewBag.YetkiBelgesi == true;
    var actions = new List<DashboardTileViewModel>();
    if (belgeYetkisi)
    {
        var bekleyen = Sayi(ViewBag.OnayBekleyen);
        var onaylanan = Sayi(ViewBag.OnaylananBelge);
        var reddedilen = Sayi(ViewBag.ReddedilenBelge);
        actions.Add(new DashboardTileViewModel
        {
            Title = "Yetki Belgesi Onayları",
            Url = Url.Action("OnayBekleyenler", "PersonelPanel")!,
            Icon = "bi bi-file-earmark-check",
            MetricValue = bekleyen.ToString(),
            MetricLabel = "Karar bekleyen",
            Stat1Label = "Bekleyen",
            Stat1Value = bekleyen.ToString(),
            Stat1Class = bekleyen > 0 ? "df-badge-pulse" : "df-tile-stat-val",
            Stat2Label = "Onaylanan",
            Stat2Value = onaylanan.ToString(),
            Stat3Label = "Reddedilen",
            Stat3Value = reddedilen.ToString(),
            Tone = "amber",
            Featured = bekleyen > 0
        });
    }
    if (ViewBag.YetkiYkcTalep == true)
    {
        actions.Add(new DashboardTileViewModel
        {
            Title = "Cihaz Değişim İşlemleri",
            Url = Url.Action("Talepler", "Ykc")!,
            Icon = "bi bi-fire",
            MetricValue = (ykc?.Incelemede ?? 0).ToString(),
            MetricLabel = "İnceleme / atama bekleyen",
            Stat1Label = "Bekleyen",
            Stat1Value = (ykc?.Incelemede ?? 0).ToString(),
            Stat1Class = (ykc?.Incelemede ?? 0) > 0 ? "df-badge-pulse" : "df-tile-stat-val",
            Stat2Label = "Kontrolde",
            Stat2Value = (ykc?.RandevuSaha ?? 0).ToString(),
            Stat3Label = "Tamamlanan",
            Stat3Value = (ykc?.Tamamlanan ?? 0).ToString(),
            Tone = "blue"
        });
    }

    var toplamDevreyeAlma = Sayi(ViewBag.ToplamDevreyeAlma);
    var buAyDevreyeAlma = Sayi(ViewBag.BuAy);
    var sonIslem = (ViewBag.SonIslemler as List<Ys_DevreyeAlma>)?.FirstOrDefault(x => x.DevreyeAlmaTarihi.Year > 1900);
    actions.Add(new DashboardTileViewModel
    {
        Title = "Cihaz Devreye Alma Kayıtları",
        Url = Url.Action("DevreyeAlmalar", "PersonelPanel")!,
        Icon = "bi bi-tools",
        MetricValue = buAyDevreyeAlma.ToString(),
        MetricLabel = "Bu ay kaydedilen",
        Stat1Label = "Toplam",
        Stat1Value = toplamDevreyeAlma.ToString(),
        Stat2Label = "Bu Ay",
        Stat2Value = buAyDevreyeAlma.ToString(),
        Stat3Label = "Son Kayıt",
        Stat3Value = sonIslem?.DevreyeAlmaTarihi.ToString("dd.MM.yyyy") ?? "Yok",
        Tone = "green"
    });

    if (ViewBag.YetkiServis == true)
    {
        var servisToplam = Sayi(ViewBag.ServisToplam);
        var servisAktif = Sayi(ViewBag.ServisAktif);
        var servisPasif = Sayi(ViewBag.ServisPasif);
        actions.Add(new DashboardTileViewModel
        {
            Title = "Yetkili Servis Yönetimi",
            Url = Url.Action("YetkiliServisler", "PersonelPanel")!,
            Icon = "bi bi-building-check",
            MetricValue = servisAktif.ToString(),
            MetricLabel = "Aktif servis",
            Stat1Label = "Toplam",
            Stat1Value = servisToplam.ToString(),
            Stat2Label = "Aktif",
            Stat2Value = servisAktif.ToString(),
            Stat3Label = "Pasif",
            Stat3Value = servisPasif.ToString(),
            Tone = "cyan"
        });
    }
}
@functions {
    private static int Sayi(object? value)
    {
        if (value is int sayi) return Math.Max(sayi, 0);
        return int.TryParse(value?.ToString(), out var sonuc) ? Math.Max(sonuc, 0) : 0;
    }
}
@section PageStyles {
    <link rel="stylesheet" href="~/css/personnel-home.css" asp-append-version="true" />
}
<div class="df-dashboard role-dashboard personnel-role-dashboard">
    <div class="section-label">
        <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>
        Görev Alanlarım
    </div>
    <nav class="df-approval-grid role-card-grid" aria-label="Yetkili olduğum işlemler" style="--role-card-count:@actions.Count">
        @foreach (var item in actions)
        {
            <a class="df-atile is-@item.Tone @(item.Featured ? "is-featured" : "")" href="@item.Url" aria-label="@(item.Featured ? "Öncelikli: " + item.Title : item.Title)">
                <div class="df-atile-top">
                    <div class="df-atile-icon"><i class="@item.Icon" aria-hidden="true"></i></div>
                    <div class="df-atile-name">@item.Title</div>
                    <i class="bi bi-arrow-right personnel-tile-arrow" aria-hidden="true"></i>
                </div>
                <div class="personnel-tile-metric">
                    <strong>@item.MetricValue</strong>
                    <span>@item.MetricLabel</span>
                </div>
                <dl class="personnel-tile-stats">
                    <div><dt>@item.Stat1Label</dt><dd class="@item.Stat1Class">@item.Stat1Value</dd></div>
                    <div><dt>@item.Stat2Label</dt><dd class="@item.Stat2Class">@item.Stat2Value</dd></div>
                    <div><dt>@item.Stat3Label</dt><dd class="@item.Stat3Class">@item.Stat3Value</dd></div>
                </dl>
            </a>
        }
    </nav>
    @await Component.InvokeAsync("YkcRandevuOzeti")
</div>
