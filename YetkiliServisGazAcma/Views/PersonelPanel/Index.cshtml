@using YetkiliServisGazAcma.Entities
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["PanelTitle"] = "Ana Sayfa";
    ViewData["ActiveMenu"] = "Dashboard";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var ykc = ViewBag.YkcOzet as YkcDashboardOzetDto;
    var belgeYetkisi = ViewBag.YetkiBelgesi == true;
    string Sayi(object? value) => value?.ToString() ?? "-";
    var actions = new List<(string Title, string Url, string Icon, string Value, string Caption, string Tone, string Label1, string Stat1, string Label2, string Stat2)>();
    if (belgeYetkisi)
        actions.Add(("Yetki Belgesi Onayları", "/personel-panel/onay-bekleyenler", "bi-file-earmark-check", Sayi(ViewBag.OnayBekleyen), "İnceleme bekleyen belge", "amber", "Onaylanan", Sayi(ViewBag.OnaylananBelge), "Reddedilen", Sayi(ViewBag.ReddedilenBelge)));
    if (ViewBag.YetkiYkcTalep == true)
        actions.Add(("Cihaz Değişim Talepleri", "/ykc/talepler", "bi-fire", Sayi(ykc?.Incelemede), "İnceleme / atama bekleyen", "blue", "Kontrolde", Sayi(ykc?.RandevuSaha), "Tamamlanan", Sayi(ykc?.Tamamlanan)));
    var sonIslem = (ViewBag.SonIslemler as List<Ys_DevreyeAlma>)?.FirstOrDefault(x => x.DevreyeAlmaTarihi.Year > 1900);
    actions.Add(("Cihaz Devreye Alma", "/personel-panel/devreyealmalar", "bi-tools", Sayi(ViewBag.BuAy), "Bu ayki devreye alma kaydı", "green", "Toplam kayıt", Sayi(ViewBag.ToplamDevreyeAlma), "Son işlem", sonIslem?.DevreyeAlmaTarihi.ToString("dd.MM.yyyy") ?? "-"));
    if (ViewBag.YetkiServis == true)
        actions.Add(("Yetkili Servisler", "/personel-panel/yetkiliservisler", "bi-building-check", Sayi(ViewBag.ServisToplam), "Kayıtlı yetkili servis", "cyan", "Aktif", Sayi(ViewBag.ServisAktif), "Pasif", Sayi(ViewBag.ServisPasif)));
}
@section PageStyles { <link rel="stylesheet" href="~/css/operations-home.css" asp-append-version="true" /> }
<div class="ops-home ops-personnel-home">
    <nav class="ops-tiles" aria-label="Yetkili olduğum işlemler">
        @foreach (var item in actions)
        {
            <a class="ops-tile is-@item.Tone" href="@item.Url">
                <div class="ops-tile-heading"><i class="bi @item.Icon" aria-hidden="true"></i><h2>@item.Title</h2></div>
                <strong class="ops-tile-number">@item.Value</strong>
                <span class="ops-tile-caption">@item.Caption</span>
                <dl class="ops-tile-breakdown">
                    <div><dt>@item.Label1</dt><dd>@item.Stat1</dd></div>
                    <div><dt>@item.Label2</dt><dd>@item.Stat2</dd></div>
                </dl>
                <i class="bi bi-arrow-up-right ops-tile-arrow" aria-hidden="true"></i>
            </a>
        }
    </nav>
    @await Component.InvokeAsync("YkcRandevuOzeti")
</div>
