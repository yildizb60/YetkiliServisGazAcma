@model List<YetkiliServisGazAcma.Entities.Dag_Sirket>
@{
    ViewData["Title"] = "Dağıtım Şirketleri";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "Sirketler";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var q = ViewBag.Query as string ?? "";
    var aktifSayisi = Model.Count(x => x.AktifMi);
    var pasifSayisi = Model.Count - aktifSayisi;
}

<div class="df-admin-workspace df-company-directory">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-title"><i class="bi bi-buildings" aria-hidden="true"></i> Şirket Özeti</div>
            </div>
            <a class="df-btn df-btn-primary df-btn-sm" href="/personel-panel/sirketler/ekle"><i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Şirket</a>
        </div>
        <div class="df-admin-metrics" aria-label="Şirket özeti">
            <span class="df-admin-metric is-company"><i class="bi bi-buildings" aria-hidden="true"></i><span>Toplam</span><strong>@Model.Count</strong></span>
            <span class="df-admin-metric is-active"><i class="bi bi-check-circle" aria-hidden="true"></i><span>Aktif</span><strong>@aktifSayisi</strong></span>
            <span class="df-admin-metric is-passive"><i class="bi bi-dash-circle" aria-hidden="true"></i><span>Pasif</span><strong>@pasifSayisi</strong></span>
        </div>
    </section>

    <details class="df-admin-filter" open="@(!string.IsNullOrWhiteSpace(q) ? "open" : null)">
        <summary>
            <span><i class="bi bi-search" aria-hidden="true"></i><strong>Şirket Ara</strong><small>Şirket adı, il veya telefon</small></span>
            <span>@(!string.IsNullOrWhiteSpace(q) ? "Arama uygulandı" : "Aramayı aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <form method="get" action="/personel-panel/sirketler">
                <div class="df-admin-filter-grid">
                    <div class="df-admin-field is-full"><label for="q">Arama</label><input id="q" type="search" name="q" value="@q" placeholder="Şirket adı, il veya telefon" /></div>
                </div>
                <div class="df-admin-filter-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/sirketler"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Ara</button>
                </div>
            </form>
        </div>
    </details>

    <section class="df-admin-list-card">
        <div class="df-service-list-head">
            <div><h3><i class="bi bi-building-check" aria-hidden="true"></i> Şirket Listesi</h3><span>Kurumsal kayıt ve iletişim bilgileri</span></div>
            <strong>@Model.Count kayıt</strong>
        </div>
        @if (Model.Count == 0)
        {
            <div class="df-admin-empty"><i class="bi bi-inbox" aria-hidden="true"></i> Aramanıza uygun şirket bulunamadı.</div>
        }
        else
        {
            <div class="df-admin-table-scroll"><table class="df-table">
                <thead><tr><th>Şirket</th><th>İl</th><th>İletişim</th><th>Durum</th><th>İşlemler</th></tr></thead>
                <tbody>
                @foreach (var sirket in Model)
                {
                    <tr>
                        <td><div class="df-cell-main">@sirket.SirketAdi</div><div class="df-cell-sub">Dağıtım şirketi</div></td>
                        <td>@(string.IsNullOrWhiteSpace(sirket.Il) ? "-" : sirket.Il)</td>
                        <td><div class="df-cell-main">@(string.IsNullOrWhiteSpace(sirket.Telefon) ? "-" : sirket.Telefon)</div><div class="df-cell-sub">@(string.IsNullOrWhiteSpace(sirket.Email) ? "E-posta bilgisi yok" : sirket.Email)</div></td>
                        <td><span class="df-pill @(sirket.AktifMi ? "df-pill-success" : "df-pill-muted")">@(sirket.AktifMi ? "Aktif" : "Pasif")</span></td>
                        <td><div class="df-actions">
                            <a class="df-icon-action" href="/personel-panel/sirketler/duzenle/@sirket.Id" title="Şirketi düzenle"><i class="bi bi-pencil" aria-hidden="true"></i><span>Düzenle</span></a>
                            <form method="post" action="/personel-panel/sirketler/sil/@sirket.Id" onsubmit="return confirm('Bu şirket kaydını silmek istiyor musunuz?');">@Html.AntiForgeryToken()<button class="df-icon-action is-danger" type="submit" title="Şirketi sil"><i class="bi bi-trash3" aria-hidden="true"></i><span>Sil</span></button></form>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </section>
</div>
