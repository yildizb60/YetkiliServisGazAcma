@{
    ViewData["Title"] = "Operasyon Raporları";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "Raporlar";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var listeTipi = ViewBag.ListeTipi as string ?? "devreye";
    var raporTipi = ViewBag.RaporTipi as string ?? "devreye";
    var belgeRaporu = listeTipi == "yetkiBelgesi";
    var ykcRaporu = listeTipi == "ykc";
    var genelRaporYetkisi = ViewBag.YetkiRapor == true;
    var belgeYetkisi = ViewBag.YetkiBelgesi == true;
    var ykcRaporYetkisi = ViewBag.YetkiYkcRapor == true;
    DateTime basTarih = ViewBag.BasTarih ?? DateTime.Now.Date.AddDays(-30);
    DateTime bitTarih = ViewBag.BitTarih ?? DateTime.Now.Date;

    var raporAylar = (ViewBag.RaporAylar as IEnumerable<string>)?.ToList() ?? new List<string>();
    var raporAylik = (ViewBag.RaporAylik as IEnumerable<int>)?.ToList() ?? new List<int>();
    var durumSayilari = (ViewBag.RaporDurum as IEnumerable<int>)?.ToList() ?? new List<int>();
    var ozelDurumEtiketleri = ViewBag.RaporDurumEtiketleri as IEnumerable<string>;
    var durumEtiketleri = ozelDurumEtiketleri?.ToList()
        ?? (belgeRaporu
            ? new List<string> { "Onaylanan", "Onay Bekleyen", "Reddedilen" }
            : new List<string> { "Tamamlanan", "Bekleyen", "İptal" });
    var durumToplam = Math.Max(1, durumSayilari.Sum());
    var raporAylarJson = System.Text.Json.JsonSerializer.Serialize(raporAylar);
    var raporAylikJson = System.Text.Json.JsonSerializer.Serialize(raporAylik);

    var seciliBelgeToplam = raporTipi == "onayli" ? Convert.ToInt32(ViewBag.YetkiBelgesiOnayli)
        : raporTipi == "bekleyen" ? Convert.ToInt32(ViewBag.YetkiBelgesiBekleyen)
        : raporTipi == "reddedilen" ? Convert.ToInt32(ViewBag.YetkiBelgesiReddedilen)
        : 0;
    var raporToplam = belgeRaporu ? seciliBelgeToplam : Convert.ToInt32(ViewBag.RaporToplam ?? 0);
    var disAktarilabilir = raporToplam > 0;
    var raporTipiAdi = raporTipi switch
    {
        "onayli" => "Onaylanan Yetki Belgeleri",
        "bekleyen" => "Onay Bekleyen Yetki Belgeleri",
        "reddedilen" => "Reddedilen Yetki Belgeleri",
        "ykc" => "Cihaz Değişim İşlemleri",
        _ => "Cihaz Devreye Alma İşlemleri"
    };
    var raporAciklama = raporTipi switch
    {
        "onayli" => "Dönem içinde onaylanan servis yetki belgeleri",
        "bekleyen" => "Karar bekleyen servis yetki belgeleri",
        "reddedilen" => "Dönem içinde reddedilen servis yetki belgeleri",
        "ykc" => "Cihaz değişim talepleri ve süreç sonuçları",
        _ => "Yetkili servislerin cihaz devreye alma kayıtları"
    };
    var raporIkonu = ykcRaporu ? "bi-arrow-repeat" : belgeRaporu ? "bi-file-earmark-check" : "bi-bag-check";
    var grafikBasligi = ykcRaporu ? "Firmalara Göre İşlem Dağılımı" : belgeRaporu ? "Aylık Belge İşlemleri" : "Aylık Devreye Alma İşlemleri";
    var pdfUrl = ykcRaporu
        ? Url.Action("RaporPdf", "Ykc", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") })
        : Url.Action("RaporlarPdf", "PersonelPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd"), tip = belgeRaporu ? raporTipi : null });
    var excelUrl = ykcRaporu
        ? Url.Action("RaporExcel", "Ykc", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") })
        : Url.Action("RaporlarExcel", "PersonelPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd"), tip = belgeRaporu ? raporTipi : null });
    var kayitlarUrl = ykcRaporu
        ? Url.Action("Raporlar", "Ykc", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") })
        : belgeRaporu
            ? Url.Action("OnayBekleyenler", "PersonelPanel", new { tab = raporTipi == "onayli" ? "onaylanan" : raporTipi == "reddedilen" ? "reddedilen" : "bekleyen" })
            : Url.Action("DevreyeAlmalar", "PersonelPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") });
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/admin-reports.css" asp-append-version="true" />
}

<div class="df-admin-report-workspace df-personnel-report-workspace">
    <section class="df-page-panel df-personnel-report-controls" aria-labelledby="report-selection-title">
        <div class="df-personnel-report-controls-head">
            <span><i class="bi bi-sliders2" aria-hidden="true"></i></span>
            <div><h2 id="report-selection-title">Rapor Seçimi</h2><small>İşlem türü ve dönem</small></div>
        </div>
        <form method="get" action="@Url.Action("Raporlar", "PersonelPanel")" class="df-personnel-report-form">
            <div class="df-admin-field is-report-type">
                <label for="tip">Rapor Türü</label>
                <select id="tip" name="tip">
                    @if (genelRaporYetkisi || ykcRaporYetkisi)
                    {
                        <optgroup label="Cihaz İşlemleri">
                            @if (genelRaporYetkisi)
                            {
                                <option value="devreye" selected="@(raporTipi == "devreye" ? "selected" : null)">Cihaz Devreye Alma İşlemleri</option>
                            }
                            @if (ykcRaporYetkisi)
                            {
                                <option value="ykc" selected="@(raporTipi == "ykc" ? "selected" : null)">Cihaz Değişim İşlemleri</option>
                            }
                        </optgroup>
                    }
                    @if (genelRaporYetkisi && belgeYetkisi)
                    {
                        <optgroup label="Yetki Belgeleri">
                            <option value="onayli" selected="@(raporTipi == "onayli" ? "selected" : null)">Onaylanan Yetki Belgeleri</option>
                            <option value="bekleyen" selected="@(raporTipi == "bekleyen" ? "selected" : null)">Onay Bekleyen Yetki Belgeleri</option>
                            <option value="reddedilen" selected="@(raporTipi == "reddedilen" ? "selected" : null)">Reddedilen Yetki Belgeleri</option>
                        </optgroup>
                    }
                </select>
            </div>
            <div class="df-admin-field"><label for="bas">Başlangıç</label><input id="bas" type="date" name="bas" value="@basTarih.ToString("yyyy-MM-dd")" /></div>
            <div class="df-admin-field"><label for="bit">Bitiş</label><input id="bit" type="date" name="bit" value="@bitTarih.ToString("yyyy-MM-dd")" /></div>
            <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Raporu Hazırla</button>
        </form>
    </section>

    <section class="df-page-panel df-personnel-report-result" aria-labelledby="report-result-title">
        <header class="df-personnel-report-result-head">
            <span class="df-personnel-report-result-icon" aria-hidden="true"><i class="bi @raporIkonu"></i></span>
            <div class="df-personnel-report-result-copy">
                <h2 id="report-result-title">@raporTipiAdi</h2>
                <p>@raporAciklama</p>
                <small>@basTarih.ToString("dd.MM.yyyy") - @bitTarih.ToString("dd.MM.yyyy")</small>
            </div>
            <div class="df-personnel-report-total"><strong>@raporToplam</strong><span>kayıt</span></div>
            <div class="df-personnel-report-actions">
                <a class="df-btn df-btn-sm df-btn-pdf @(!disAktarilabilir ? "is-disabled" : "")" href="@(disAktarilabilir ? pdfUrl : "#")" aria-disabled="@(!disAktarilabilir ? "true" : "false")" title="Hazırlanan raporu PDF olarak indir"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
                <a class="df-btn df-btn-sm df-btn-excel @(!disAktarilabilir ? "is-disabled" : "")" href="@(disAktarilabilir ? excelUrl : "#")" aria-disabled="@(!disAktarilabilir ? "true" : "false")" title="Hazırlanan raporu Excel olarak indir"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
                <a class="df-btn df-btn-sm df-btn-secondary" href="@kayitlarUrl"><i class="bi bi-list-ul" aria-hidden="true"></i> Kayıtlar</a>
            </div>
        </header>
        <div class="df-personnel-report-preview">
            <section class="df-personnel-report-chart" aria-labelledby="report-chart-title">
                <div class="df-personnel-report-section-head"><h3 id="report-chart-title">@grafikBasligi</h3><span>Dönem görünümü</span></div>
                <div class="df-personnel-report-chart-wrap" id="reportChartWrap">
                    <div class="chart-empty">Seçilen dönem için grafik verisi bulunamadı.</div>
                    <canvas id="reportChart"></canvas>
                </div>
            </section>
            <aside class="df-personnel-report-status" aria-labelledby="report-status-title">
                <div class="df-personnel-report-section-head"><h3 id="report-status-title">Durum Özeti</h3><span>@durumSayilari.Sum() işlem</span></div>
                <div class="df-personnel-report-status-list">
                    @if (!durumSayilari.Any())
                    {
                        <div class="df-personnel-report-empty">Durum verisi bulunamadı.</div>
                    }
                    else
                    {
                        @for (var index = 0; index < durumSayilari.Count; index++)
                        {
                            var etiket = index < durumEtiketleri.Count ? durumEtiketleri[index] : $"Durum {index + 1}";
                            <div>
                                <span><i class="is-tone-@(index % 3)" aria-hidden="true"></i>@etiket</span>
                                <strong>@durumSayilari[index]</strong>
                                <progress max="@durumToplam" value="@durumSayilari[index]" aria-label="@etiket: @durumSayilari[index]"></progress>
                            </div>
                        }
                    }
                </div>
            </aside>
        </div>
    </section>
</div>

<div id="raporData"
     data-labels='@Html.Raw(raporAylarJson)'
     data-values='@Html.Raw(raporAylikJson)'
     data-chart-type="@(ykcRaporu ? "bar" : "line")"
     hidden></div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function () {
    const dataEl = document.getElementById('raporData');
    const canvas = document.getElementById('reportChart');
    const wrap = document.getElementById('reportChartWrap');
    if (!dataEl || !canvas || !wrap || typeof Chart === 'undefined') return;
    const parse = value => {
        try {
            const result = JSON.parse(value || '[]');
            return Array.isArray(result) ? result : [];
        } catch {
            return [];
        }
    };
    const labels = parse(dataEl.dataset.labels);
    const values = parse(dataEl.dataset.values).map(Number);
    if (!labels.length || !values.some(value => value > 0)) return;
    const bar = dataEl.dataset.chartType === 'bar';
    wrap.classList.add('has-data');
    new Chart(canvas, {
        type: bar ? 'bar' : 'line',
        data: {
            labels,
            datasets: [{
                data: values,
                borderColor: '#315fca',
                backgroundColor: bar ? '#315fca' : 'rgba(49,95,202,.12)',
                borderWidth: bar ? 0 : 2,
                borderRadius: bar ? 5 : 0,
                fill: !bar,
                tension: .3,
                pointRadius: bar ? 0 : 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { grid: { display: false } } }
        }
    });
})();
</script>
}
