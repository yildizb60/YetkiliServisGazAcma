@{
    ViewData["Title"] = "Operasyon Raporları";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "Raporlar";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var sonIslemler = ViewBag.SonIslemler as List<YetkiliServisGazAcma.Entities.Ys_DevreyeAlma>;
    var yetkiBelgesiIslemler = ViewBag.YetkiBelgesiIslemler as List<YetkiliServisGazAcma.Entities.Ys_YetkiBelgesi>;
    var listeTipi = ViewBag.ListeTipi as string ?? "devreye";
    var raporTipi = ViewBag.RaporTipi as string ?? "devreye";
    DateTime basTarih = ViewBag.BasTarih ?? DateTime.Now.Date.AddDays(-30);
    DateTime bitTarih = ViewBag.BitTarih ?? DateTime.Now.Date;
    var raporAylarJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.RaporAylar ?? new List<string>());
    var raporAylikJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.RaporAylik ?? new List<int>());
    var raporMarkaJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.RaporMarka ?? new List<string>());
    var raporMarkaSayiJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.RaporMarkaSayi ?? new List<int>());
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/admin-reports.css" asp-append-version="true" />
}

<div class="df-admin-report-workspace">
    <section class="df-page-panel df-admin-report-filter">
        <form method="get" action="/personel-panel/raporlar" class="df-admin-report-form">
            <div class="df-admin-report-fields is-two">
                <div class="df-admin-field"><label for="bas">Başlangıç</label><input id="bas" type="date" name="bas" value="@basTarih.ToString("yyyy-MM-dd")" /></div>
                <div class="df-admin-field"><label for="bit">Bitiş</label><input id="bit" type="date" name="bit" value="@bitTarih.ToString("yyyy-MM-dd")" /></div>
            </div>
            <fieldset class="df-report-type-control">
                <legend>Rapor Türü</legend>
                <div class="df-report-type-options">
                    <label class="@(raporTipi == "devreye" ? "active" : "")"><input type="radio" name="tip" value="devreye" checked="@(raporTipi == "devreye" ? "checked" : null)" /><i class="bi bi-bag-check" aria-hidden="true"></i><span>Cihaz Devreye Alma</span></label>
                    <label class="@(raporTipi == "onayli" ? "active" : "")"><input type="radio" name="tip" value="onayli" checked="@(raporTipi == "onayli" ? "checked" : null)" /><i class="bi bi-patch-check" aria-hidden="true"></i><span>Onaylı Belgeler</span></label>
                    <label class="@(raporTipi == "bekleyen" ? "active" : "")"><input type="radio" name="tip" value="bekleyen" checked="@(raporTipi == "bekleyen" ? "checked" : null)" /><i class="bi bi-hourglass-split" aria-hidden="true"></i><span>Bekleyen Belgeler</span></label>
                    <label class="@(raporTipi == "reddedilen" ? "active" : "")"><input type="radio" name="tip" value="reddedilen" checked="@(raporTipi == "reddedilen" ? "checked" : null)" /><i class="bi bi-x-circle" aria-hidden="true"></i><span>Reddedilen Belgeler</span></label>
                </div>
            </fieldset>
            <div class="df-admin-report-submit"><button class="df-btn df-btn-primary" type="submit"><i class="bi bi-funnel-fill" aria-hidden="true"></i> Raporla</button></div>
        </form>
    </section>

    <section class="df-report-charts" aria-label="Rapor grafikleri">
        <div class="df-report-chart"><h3>Aylık İşlem</h3><div class="chart-wrap" id="wrapAylik"><div class="chart-empty">Veri bulunamadı</div><canvas id="aylikChart"></canvas></div></div>
        <div class="df-report-chart"><h3>Durum Dağılımı</h3><div class="chart-wrap" id="wrapDurum"><div class="chart-empty">Veri bulunamadı</div><canvas id="durumChart"></canvas></div></div>
        <div class="df-report-chart"><h3>Marka Dağılımı</h3><div class="chart-wrap" id="wrapMarka"><div class="chart-empty">Veri bulunamadı</div><canvas id="markaChart"></canvas></div></div>
    </section>

    <section class="df-admin-list-card df-admin-report-results">
        <div class="df-service-list-head df-report-results-head">
            <div><h3><i class="bi bi-table" aria-hidden="true"></i> @((listeTipi == "devreye") ? "Son Cihaz Devreye Alma Kayıtları" : "Yetki Belgesi İşlemleri")</h3><span>@basTarih.ToString("dd.MM.yyyy") - @bitTarih.ToString("dd.MM.yyyy") tarih aralığı</span></div>
            <div class="df-admin-metrics df-inline-metrics" aria-label="Rapor özeti">
                <span class="df-admin-metric"><i class="bi bi-collection" aria-hidden="true"></i><span>Toplam İşlem</span><strong>@ViewBag.RaporToplam</strong></span>
                <span class="df-admin-metric is-approved"><i class="bi bi-check-circle" aria-hidden="true"></i><span>Tamamlanan</span><strong>@ViewBag.RaporTamam</strong></span>
                <span class="df-admin-metric is-waiting"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span>Bekleyen</span><strong>@ViewBag.RaporBekleyen</strong></span>
                <span class="df-admin-metric is-rejected"><i class="bi bi-x-circle" aria-hidden="true"></i><span>İptal</span><strong>@ViewBag.RaporIptal</strong></span>
            </div>
        </div>
        @if (listeTipi == "devreye")
        {
            if (sonIslemler == null || sonIslemler.Count == 0)
            {
                <div class="df-admin-empty"><i class="bi bi-inbox" aria-hidden="true"></i> Bu aralıkta işlem bulunamadı.</div>
            }
            else
            {
                <div class="df-admin-table-scroll"><table class="df-table"><thead><tr><th>Müşteri</th><th>Tesisat No</th><th>Yetkili Servis</th><th>Marka</th><th>Devreye Alma Tarihi</th></tr></thead><tbody>
                @foreach (var d in sonIslemler)
                {
                    <tr><td><div class="df-cell-main">@(d.MusteriAdi ?? "-")</div></td><td><div class="df-cell-main">@d.TesistatNo</div></td><td><div class="df-cell-main">@(d.Firma?.FirmaAdi ?? "-")</div></td><td>@(d.Marka?.MarkaAdi ?? d.CihazMarka ?? "-")</td><td>@d.DevreyeAlmaTarihi.ToString("dd.MM.yyyy")</td></tr>
                }
                </tbody></table></div>
            }
        }
        else
        {
            if (yetkiBelgesiIslemler == null || yetkiBelgesiIslemler.Count == 0)
            {
                <div class="df-admin-empty"><i class="bi bi-inbox" aria-hidden="true"></i> Bu aralıkta yetki belgesi kaydı bulunamadı.</div>
            }
            else
            {
                <div class="df-admin-table-scroll"><table class="df-table"><thead><tr><th>Firma</th><th>Şirket</th><th>Tarih</th><th>Durum</th></tr></thead><tbody>
                @foreach (var belge in yetkiBelgesiIslemler)
                {
                    var durumSinif = belge.Durum == YetkiBelgesiDurumDegerleri.Onaylandi ? "df-pill-success" : belge.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor ? "df-pill-warning" : "df-pill-danger";
                    var durumYazi = belge.Durum == YetkiBelgesiDurumDegerleri.Onaylandi ? "Onaylandı" : belge.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor ? "Bekliyor" : "Reddedildi";
                    <tr><td><div class="df-cell-main">@(belge.Firma?.FirmaAdi ?? "-")</div></td><td>@(belge.Firma?.Sirket?.SirketAdi ?? "-")</td><td>@belge.OlusturmaTarihi.ToString("dd.MM.yyyy")</td><td><span class="df-pill @durumSinif">@durumYazi</span></td></tr>
                }
                </tbody></table></div>
            }
        }
    </section>
</div>

<div id="raporData"
     data-aylar='@Html.Raw(raporAylarJson)'
     data-aylik='@Html.Raw(raporAylikJson)'
     data-marka='@Html.Raw(raporMarkaJson)'
     data-marka-sayi='@Html.Raw(raporMarkaSayiJson)'
     hidden></div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function () {
    document.querySelectorAll('.df-report-type-options input[type="radio"]').forEach(function (input) {
        input.addEventListener('change', function () {
            document.querySelectorAll('.df-report-type-options label').forEach(function (label) { label.classList.toggle('active', label.contains(input)); });
        });
    });

    const dataEl = document.getElementById('raporData');
    if (!dataEl || typeof Chart === 'undefined') return;
    const parse = function (value) { try { const result = JSON.parse(value || '[]'); return Array.isArray(result) ? result : []; } catch { return []; } };
    const aylikLabels = parse(dataEl.dataset.aylar);
    const aylikData = parse(dataEl.dataset.aylik).map(Number);
    const markaLabels = parse(dataEl.dataset.marka);
    const markaData = parse(dataEl.dataset.markaSayi).map(Number);
    const durumData = [Number('@ViewBag.RaporTamam'), Number('@ViewBag.RaporBekleyen'), Number('@ViewBag.RaporIptal')];
    const hasData = function (arr) { return arr.some(function (value) { return Number(value) > 0; }); };
    const showChart = function (id) { const wrap = document.getElementById(id); if (wrap) wrap.classList.add('has-data'); };

    if (aylikLabels.length && hasData(aylikData)) {
        showChart('wrapAylik');
        new Chart(document.getElementById('aylikChart'), { type: 'line', data: { labels: aylikLabels, datasets: [{ data: aylikData, borderColor: '#1f5fbf', backgroundColor: 'rgba(31,95,191,.12)', fill: true, borderWidth: 2, tension: .3, pointRadius: 2 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } } });
    }
    if (hasData(durumData)) {
        showChart('wrapDurum');
        new Chart(document.getElementById('durumChart'), { type: 'doughnut', data: { labels: ['Tamamlandı', 'Bekliyor', 'İptal'], datasets: [{ data: durumData, backgroundColor: ['#167a55', '#d08a00', '#b13a48'], borderWidth: 0 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } } });
    }
    if (markaLabels.length && hasData(markaData)) {
        showChart('wrapMarka');
        new Chart(document.getElementById('markaChart'), { type: 'bar', data: { labels: markaLabels, datasets: [{ data: markaData, backgroundColor: '#167a55', borderRadius: 4 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } } });
    }
})();
</script>
}
