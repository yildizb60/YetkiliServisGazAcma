@{
    ViewData["Title"] = "Raporlar";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "Raporlar";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var listeTipi = ViewBag.ListeTipi as string ?? "devreye";
    var raporTipi = ViewBag.RaporTipi as string ?? "devreye";
    var belgeRaporu = listeTipi == "yetkiBelgesi";
    var ykcRaporu = listeTipi == "ykc";
    var genelRaporYetkisi = ViewBag.YetkiRapor == true;
    var belgeYetkisi = ViewBag.YetkiBelgesi == true;
    var ykcRaporYetkisi = ViewBag.YetkiYkcRapor == true;
    DateTime basTarih = ViewBag.BasTarih ?? DateTime.Now.Date.AddDays(-30);
    DateTime bitTarih = ViewBag.BitTarih ?? DateTime.Now.Date;

    var raporAylar = (ViewBag.RaporAylar as IEnumerable<string>)?.ToList() ?? new List<string>();
    var raporAylik = (ViewBag.RaporAylik as IEnumerable<int>)?.ToList() ?? new List<int>();
    var durumSayilari = (ViewBag.RaporDurum as IEnumerable<int>)?.ToList() ?? new List<int>();
    var ozelDurumEtiketleri = ViewBag.RaporDurumEtiketleri as IEnumerable<string>;
    var durumEtiketleri = ozelDurumEtiketleri?.ToList()
        ?? (belgeRaporu
            ? new List<string> { "Onaylanan", "Onay Bekleyen", "Reddedilen" }
            : new List<string> { "Tamamlanan", "Bekleyen", "İptal" });
    var durumToplam = durumSayilari.Sum();
    var chartMax = Math.Max(1, raporAylik.DefaultIfEmpty(0).Max());
    var chartCount = Math.Min(6, Math.Min(raporAylar.Count, raporAylik.Count));
    var ilkDurumEtiketi = durumEtiketleri.FirstOrDefault() ?? "İşlem";
    var ilkDurumOrani = durumToplam == 0 ? 0 : Math.Round(durumSayilari.FirstOrDefault() * 100d / durumToplam, 1);
    string CssYuzde(double value) => Math.Clamp(value, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    var seciliBelgeToplam = raporTipi == "onayli" ? Convert.ToInt32(ViewBag.YetkiBelgesiOnayli)
        : raporTipi == "bekleyen" ? Convert.ToInt32(ViewBag.YetkiBelgesiBekleyen)
        : raporTipi == "reddedilen" ? Convert.ToInt32(ViewBag.YetkiBelgesiReddedilen)
        : 0;
    var raporToplam = belgeRaporu ? seciliBelgeToplam : Convert.ToInt32(ViewBag.RaporToplam ?? 0);
    var disAktarilabilir = raporToplam > 0;
    var raporTipiAdi = raporTipi switch
    {
        "onayli" => "Onaylanan Yetki Belgeleri",
        "bekleyen" => "Onay Bekleyen Yetki Belgeleri",
        "reddedilen" => "Reddedilen Yetki Belgeleri",
        "ykc" => "Cihaz Değişim İşlemleri",
        _ => "Cihaz Devreye Alma İşlemleri"
    };
    var raporIkonu = ykcRaporu ? "bi-arrow-repeat" : belgeRaporu ? "bi-file-earmark-check" : "bi-bag-check";
    var grafikBasligi = ykcRaporu ? "Firmalara göre işlemler" : belgeRaporu ? "Aylık belge işlemleri" : "Aylık devreye alma işlemleri";
    var pdfUrl = ykcRaporu
        ? Url.Action("RaporPdf", "Ykc", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") })
        : Url.Action("RaporlarPdf", "PersonelPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd"), tip = belgeRaporu ? raporTipi : null });
    var excelUrl = ykcRaporu
        ? Url.Action("RaporExcel", "Ykc", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") })
        : Url.Action("RaporlarExcel", "PersonelPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd"), tip = belgeRaporu ? raporTipi : null });
    var kayitlarUrl = ykcRaporu
        ? Url.Action("Raporlar", "Ykc", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") })
        : belgeRaporu
            ? Url.Action("OnayBekleyenler", "PersonelPanel", new { tab = raporTipi == "onayli" ? "onaylanan" : raporTipi == "reddedilen" ? "reddedilen" : "bekleyen" })
            : Url.Action("DevreyeAlmalar", "PersonelPanel", new { bas = basTarih.ToString("yyyy-MM-dd"), bit = bitTarih.ToString("yyyy-MM-dd") });
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/admin-reports.css" asp-append-version="true" />
}

<main class="df-admin-report-workspace df-operations-report df-role-report df-personnel-operations-report">
    <section class="df-ops-command" aria-labelledby="personnelReportHeading">
        <div class="df-ops-command-copy">
            <span class="df-ops-command-icon" aria-hidden="true"><i class="bi @raporIkonu"></i></span>
            <div><h1 id="personnelReportHeading">Raporlar</h1><p>@basTarih.ToString("dd.MM.yyyy") - @bitTarih.ToString("dd.MM.yyyy")</p></div>
        </div>
        <form method="get" action="@Url.Action("Raporlar", "PersonelPanel")" class="df-ops-filter">
            <div class="df-admin-field is-report-type">
                <label for="tip">Rapor türü</label>
                <select id="tip" name="tip">
                    @if (genelRaporYetkisi || ykcRaporYetkisi)
                    {
                        <optgroup label="Cihaz İşlemleri">
                            @if (genelRaporYetkisi)
                            {
                                <option value="devreye" selected="@(raporTipi == "devreye" ? "selected" : null)">Cihaz Devreye Alma İşlemleri</option>
                            }
                            @if (ykcRaporYetkisi)
                            {
                                <option value="ykc" selected="@(raporTipi == "ykc" ? "selected" : null)">Cihaz Değişim İşlemleri</option>
                            }
                        </optgroup>
                    }
                    @if (genelRaporYetkisi && belgeYetkisi)
                    {
                        <optgroup label="Yetki Belgeleri">
                            <option value="onayli" selected="@(raporTipi == "onayli" ? "selected" : null)">Onaylanan Yetki Belgeleri</option>
                            <option value="bekleyen" selected="@(raporTipi == "bekleyen" ? "selected" : null)">Onay Bekleyen Yetki Belgeleri</option>
                            <option value="reddedilen" selected="@(raporTipi == "reddedilen" ? "selected" : null)">Reddedilen Yetki Belgeleri</option>
                        </optgroup>
                    }
                </select>
            </div>
            <div class="df-admin-field"><label for="bas">Başlangıç</label><input id="bas" type="date" name="bas" value="@basTarih.ToString("yyyy-MM-dd")" /></div>
            <div class="df-admin-field"><label for="bit">Bitiş</label><input id="bit" type="date" name="bit" value="@bitTarih.ToString("yyyy-MM-dd")" /></div>
            <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Uygula</button>
        </form>
    </section>

    <section class="df-ops-kpis" aria-label="@raporTipiAdi göstergeleri">
        <article class="df-ops-kpi is-volume"><span class="df-ops-kpi-icon"><i class="bi bi-inboxes" aria-hidden="true"></i></span><div><span>Toplam kayıt</span><strong>@raporToplam</strong></div></article>
        @for (var index = 0; index < 3; index++)
        {
            var etiket = index < durumEtiketleri.Count ? durumEtiketleri[index] : "Diğer";
            var sayi = index < durumSayilari.Count ? durumSayilari[index] : 0;
            var ton = index == 0 ? "is-duration" : index == 1 ? "is-compliance" : "is-repeat";
            var ikon = index == 0 ? "bi-check2-circle" : index == 1 ? "bi-hourglass-split" : "bi-list-check";
            <article class="df-ops-kpi @ton"><span class="df-ops-kpi-icon"><i class="bi @ikon" aria-hidden="true"></i></span><div><span>@etiket</span><strong>@sayi</strong></div></article>
        }
    </section>

    <section class="df-ops-overview" aria-label="@raporTipiAdi grafikleri">
        <div class="df-ops-monthly">
            <header class="df-ops-section-head"><div><h2>@grafikBasligi</h2></div><span>@raporToplam kayıt</span></header>
            @if (chartCount == 0)
            {
                <div class="df-ops-empty">Seçili dönemde grafik verisi yok.</div>
            }
            else
            {
                <div class="df-ops-monthly-chart" style="--chart-count:@chartCount" role="img" aria-label="@grafikBasligi">
                    @for (var index = 0; index < chartCount; index++)
                    {
                        <div class="df-ops-month" title="@raporAylar[index]: @raporAylik[index] kayıt">
                            <strong>@raporAylik[index]</strong>
                            <span class="df-ops-month-track"><i style="--bar:@CssYuzde(raporAylik[index] * 100d / chartMax)%"></i></span>
                            <small>@raporAylar[index]</small>
                        </div>
                    }
                </div>
            }
        </div>
        <aside class="df-ops-status" aria-labelledby="personnelReportStatusHeading">
            <header class="df-ops-section-head"><div><h2 id="personnelReportStatusHeading">Durum dağılımı</h2></div></header>
            @if (durumToplam == 0)
            {
                <div class="df-ops-empty">Seçili dönemde kayıt yok.</div>
            }
            else
            {
                <div class="df-ops-completion">
                    <div class="df-ops-ring" style="--value:@CssYuzde(ilkDurumOrani)" aria-label="@ilkDurumEtiketi yüzde @ilkDurumOrani"><strong>%@ilkDurumOrani.ToString("0.#")</strong><span>@ilkDurumEtiketi</span></div>
                    <dl>
                        @for (var index = 0; index < durumSayilari.Count; index++)
                        {
                            var etiket = index < durumEtiketleri.Count ? durumEtiketleri[index] : $"Durum {index + 1}";
                            <div><dt><i class="is-status-@(index % 4)" aria-hidden="true"></i> @etiket</dt><dd>@durumSayilari[index]</dd></div>
                        }
                    </dl>
                </div>
            }
        </aside>
    </section>

    <section class="df-ops-download-strip" aria-label="@raporTipiAdi indirme seçenekleri">
        <div><h2>@raporTipiAdi</h2><span>@basTarih.ToString("dd.MM.yyyy") - @bitTarih.ToString("dd.MM.yyyy")</span></div>
        <div class="df-ops-export-actions">
            <a class="df-btn df-btn-sm df-btn-pdf @(!disAktarilabilir ? "is-disabled" : "")" href="@(disAktarilabilir ? pdfUrl : null)" aria-disabled="@(!disAktarilabilir ? "true" : "false")" tabindex="@(!disAktarilabilir ? "-1" : null)"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
            <a class="df-btn df-btn-sm df-btn-excel @(!disAktarilabilir ? "is-disabled" : "")" href="@(disAktarilabilir ? excelUrl : null)" aria-disabled="@(!disAktarilabilir ? "true" : "false")" tabindex="@(!disAktarilabilir ? "-1" : null)"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
            <a class="df-btn df-btn-sm df-btn-secondary" href="@kayitlarUrl"><i class="bi bi-list-ul" aria-hidden="true"></i> Kayıtlar</a>
        </div>
    </section>
</main>
