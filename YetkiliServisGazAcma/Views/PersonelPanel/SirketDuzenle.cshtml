@model YetkiliServisGazAcma.Entities.Dag_Sirket
@{
    ViewData["Title"] = "Şirket Düzenle";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "Sirketler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}

<div class="df-admin-workspace df-admin-editor df-company-edit-workspace">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-building-gear"></i> Dağıtım şirketi</div>
                <div class="df-panel-title">Şirket Düzenle</div>
                <div class="df-panel-subtitle">@Model.SirketAdi şirketinin iletişim, konum ve kullanım bilgilerini güncelleyin.</div>
            </div>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/sirketler"><i class="bi bi-arrow-left"></i> Şirketlere Dön</a>
        </div>
    </section>

    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            <form method="post" action="/personel-panel/sirketler/duzenle/@Model.Id">
                @Html.AntiForgeryToken()

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-buildings"></i></span>
                        <div>
                            <h3>Şirket Bilgileri</h3>
                            <p>Dağıtım şirketinin sistemde görünen adını ve kayıt durumunu güncelleyin.</p>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-half"><label>Şirket Adı *</label><input name="SirketAdi" value="@Model.SirketAdi" required /></div>
                        <div class="df-admin-field is-half">
                            <label>Kayıt Durumu</label>
                            <select name="AktifMi">
                                <option value="true" selected="@(Model.AktifMi)">Aktif</option>
                                <option value="false" selected="@(!Model.AktifMi)">Pasif</option>
                            </select>
                        </div>
                    </div>
                </section>

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-geo-alt"></i></span>
                        <div>
                            <h3>Konum ve İletişim</h3>
                            <p>Şirketin merkez konumunu ve iletişim kanallarını güncelleyin.</p>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field"><label>İl</label><input name="Il" value="@Model.Il" /></div>
                        <div class="df-admin-field"><label>Telefon</label><input name="Telefon" value="@Model.Telefon" autocomplete="tel" /></div>
                        <div class="df-admin-field"><label>E-Posta</label><input name="Email" type="email" value="@Model.Email" autocomplete="email" /></div>
                        <div class="df-admin-field is-full"><label>Adres</label><input name="Adres" value="@Model.Adres" /></div>
                    </div>
                </section>

                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/sirketler"><i class="bi bi-x-lg"></i> Vazgeç</a>
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-check2"></i> Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
<script>
(function () {
    var yetki = {
        yetkiBelgesi: @((ViewBag.YetkiBelgesi == true).ToString().ToLower()),
        rapor: @((ViewBag.YetkiRapor == true).ToString().ToLower())
    };
    function hide(selector, allowed) {
        if (allowed) return;
        document.querySelectorAll(selector).forEach(function (el) { el.style.display = "none"; });
    }
    hide('a[href="/personel-panel/onay-bekleyenler"]', yetki.yetkiBelgesi);
    hide('a[href="/personel-panel/onay-gecmisi"]', yetki.yetkiBelgesi);
    hide('a[href="/personel-panel/raporlar"]', yetki.rapor);
    var raporSection = Array.from(document.querySelectorAll(".nav-section")).find(function (item) {
        return (item.textContent || "").toLocaleLowerCase("tr-TR").includes("rapor");
    });
    if (!yetki.rapor && raporSection) raporSection.style.display = "none";
})();
</script>
}
