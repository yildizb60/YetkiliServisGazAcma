@model List<YetkiliServisGazAcma.Entities.Ys_YetkiBelgesi>
@{
    ViewData["Title"] = "Yetki Belgesi Geçmişi";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "OnayGecmisi";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var bas = ViewBag.Bas as DateTime?;
    var bit = ViewBag.Bit as DateTime?;
    var q = ViewBag.Q as string ?? "";
    var durum = ViewBag.Durum as string ?? "";
    var filtreAktif = bas.HasValue || bit.HasValue || !string.IsNullOrWhiteSpace(q) || !string.IsNullOrWhiteSpace(durum);
    var onaylanan = Model.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.Onaylandi);
    var reddedilen = Model.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.Reddedildi);
}

<div class="df-admin-workspace df-approval-history-workspace">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <h1 class="df-panel-title"><i class="bi bi-clock-history" aria-hidden="true"></i> Yetki Belgesi Geçmişi</h1>
            </div>
        </div>
    </section>

    <details class="df-admin-filter" open="@(filtreAktif ? "open" : null)">
        <summary>
            <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Filtreler</strong><small>Firma, şirket, karar veya tarih</small></span>
            <span>@(filtreAktif ? "Filtre uygulandı" : "Filtreleri aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <form method="get" action="/personel-panel/onay-gecmisi">
                <div class="df-admin-filter-grid">
                    <div class="df-admin-field is-wide"><label for="q">Firma veya Şirket</label><input id="q" type="search" name="q" value="@q" placeholder="Firma veya şirket adı" /></div>
                    <div class="df-admin-field"><label for="durum">Karar</label><select id="durum" name="durum"><option value="">Tümü</option><option value="1" selected="@(durum == "1" ? "selected" : null)">Onaylandı</option><option value="2" selected="@(durum == "2" ? "selected" : null)">Reddedildi</option></select></div>
                    <div class="df-admin-field is-half"><label for="bas">Başlangıç Tarihi</label><input id="bas" type="date" name="bas" value="@(bas?.ToString("yyyy-MM-dd"))" /></div>
                    <div class="df-admin-field is-half"><label for="bit">Bitiş Tarihi</label><input id="bit" type="date" name="bit" value="@(bit?.ToString("yyyy-MM-dd"))" /></div>
                </div>
                <div class="df-admin-filter-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/onay-gecmisi"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Sonuçları Göster</button>
                </div>
            </form>
        </div>
    </details>

    <section class="df-admin-list-card">
        <div class="df-service-list-head">
            <div><h3><i class="bi bi-journal-check" aria-hidden="true"></i> Sonuçlanan Yetki Belgeleri</h3></div>
            <div class="df-admin-metrics df-inline-metrics" aria-label="Yetki belgesi geçmişi özeti">
                <span class="df-admin-metric"><i class="bi bi-files" aria-hidden="true"></i><span>Toplam</span><strong>@Model.Count</strong></span>
                <span class="df-admin-metric is-approved"><i class="bi bi-check-circle" aria-hidden="true"></i><span>Onaylanan</span><strong>@onaylanan</strong></span>
                <span class="df-admin-metric is-rejected"><i class="bi bi-x-circle" aria-hidden="true"></i><span>Reddedilen</span><strong>@reddedilen</strong></span>
            </div>
        </div>
        @if (Model.Count == 0)
        {
            <div class="df-admin-empty"><i class="bi bi-inbox" aria-hidden="true"></i> Filtrelere uygun kayıt bulunamadı.</div>
        }
        else
        {
            <div class="df-admin-table-scroll"><table class="df-table">
                <thead><tr><th>Firma / Şirket</th><th>Onaylayan</th><th>Karar</th><th>İşlem Tarihi</th><th>Gerekçe</th></tr></thead>
                <tbody>
                @foreach (var belge in Model)
                {
                    var onayli = belge.Durum == YetkiBelgesiDurumDegerleri.Onaylandi;
                    <tr>
                        <td><div class="df-cell-main">@(belge.Firma?.FirmaAdi ?? "-")</div><div class="df-cell-sub">@(belge.Firma?.Sirket?.SirketAdi ?? "-")</div></td>
                        <td>@(string.IsNullOrWhiteSpace(belge.OnaylayanKullanici) ? "-" : belge.OnaylayanKullanici)</td>
                        <td><span class="df-pill @(onayli ? "df-pill-success" : "df-pill-danger")">@(onayli ? "Onaylandı" : "Reddedildi")</span></td>
                        <td>@(belge.OnayTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                        <td><div class="df-cell-sub">@(string.IsNullOrWhiteSpace(belge.RedGerekce) ? "-" : belge.RedGerekce)</div></td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </section>
</div>
