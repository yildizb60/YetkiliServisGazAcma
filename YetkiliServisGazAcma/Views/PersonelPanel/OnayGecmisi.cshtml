@model List<YetkiliServisGazAcma.Entities.Ys_YetkiBelgesi>
@{
    ViewData["Title"] = "Yetki Belgesi Geçmişi";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "OnayGecmisi";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var bas = ViewBag.Bas as DateTime?;
    var bit = ViewBag.Bit as DateTime?;
    var q = ViewBag.Q as string ?? "";
    var durum = ViewBag.Durum as string ?? "";
    var filtreAktif = bas.HasValue || bit.HasValue || !string.IsNullOrWhiteSpace(q) || !string.IsNullOrWhiteSpace(durum);
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" />
}

<div class="df-admin-workspace df-approval-history-workspace">
    <section class="df-admin-list-card">
        <nav class="df-certificate-flow-nav" aria-label="Yetki belgesi iş akışı">
            <a href="@Url.Action("OnayBekleyenler", "PersonelPanel")"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> Belge İşlemleri</a>
            <a class="is-active" href="@Url.Action("OnayGecmisi", "PersonelPanel")" aria-current="page"><i class="bi bi-clock-history" aria-hidden="true"></i> Karar Geçmişi</a>
        </nav>
        <div class="df-history-list-head">
            <span><i class="bi bi-clock-history" aria-hidden="true"></i>Sonuçlanan Belgeler</span>
            <small>@Model.Count kayıt</small>
        </div>
    <details class="df-admin-filter" open="@(filtreAktif ? "open" : null)">
        <summary>
            <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Kayıtları Filtrele</strong></span>
            <span>@(filtreAktif ? "Filtre uygulandı" : "Filtreleri aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <form method="get" action="@Url.Action("OnayGecmisi", "PersonelPanel")">
                <div class="df-admin-filter-grid">
                    <div class="df-admin-field is-wide"><label for="q">Yetkili Servis</label><input id="q" type="search" name="q" value="@q" placeholder="Firma adı, vergi no veya işlemi yapan" /></div>
                    <div class="df-admin-field"><label for="durum">Sonuç</label><select id="durum" name="durum"><option value="">Tümü</option><option value="1" selected="@(durum == "1" ? "selected" : null)">Onaylandı</option><option value="2" selected="@(durum == "2" ? "selected" : null)">Reddedildi</option></select></div>
                    <div class="df-admin-field is-half"><label for="bas">Başlangıç Tarihi</label><input id="bas" type="date" name="bas" value="@(bas?.ToString("yyyy-MM-dd"))" /></div>
                    <div class="df-admin-field is-half"><label for="bit">Bitiş Tarihi</label><input id="bit" type="date" name="bit" value="@(bit?.ToString("yyyy-MM-dd"))" /></div>
                </div>
                <div class="df-admin-filter-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="@Url.Action("OnayGecmisi", "PersonelPanel")"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Sonuçları Göster</button>
                </div>
            </form>
        </div>
    </details>

        @if (Model.Count == 0)
        {
            <div class="df-admin-empty"><i class="bi bi-inbox" aria-hidden="true"></i> Filtrelere uygun kayıt bulunamadı.</div>
        }
        else
        {
            <div class="df-admin-table-scroll"><table class="df-table df-approval-history-table">
                <thead><tr><th>Yetkili Servis</th><th>Son Geçerlilik</th><th>Kararı Veren</th><th>Karar</th><th>Karar Tarihi</th><th>Açıklama</th><th>Belge</th></tr></thead>
                <tbody>
                @foreach (var belge in Model)
                {
                    var onayli = belge.Durum == YetkiBelgesiDurumDegerleri.Onaylandi;
                    <tr>
                        <td><div class="df-cell-main">@(belge.Firma?.FirmaAdi ?? "-")</div>@if (!string.IsNullOrWhiteSpace(belge.Firma?.VergiNo)) { <div class="df-cell-sub">Vergi No: @belge.Firma.VergiNo</div> }</td>
                        <td><time datetime="@belge.YetkiBelgesiBitisTarihi.ToString("yyyy-MM-dd")">@belge.YetkiBelgesiBitisTarihi.ToString("dd.MM.yyyy")</time></td>
                        <td>@(string.IsNullOrWhiteSpace(belge.OnaylayanKullanici) ? "-" : belge.OnaylayanKullanici)</td>
                        <td><span class="df-certificate-status @(onayli ? "is-approved" : "is-rejected")"><i class="bi @(onayli ? "bi-check-circle" : "bi-x-circle")" aria-hidden="true"></i>@(onayli ? "Onaylandı" : "Reddedildi")</span></td>
                        <td>@(belge.OnayTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                        <td><div class="df-cell-sub">@(string.IsNullOrWhiteSpace(belge.RedGerekce) ? "-" : belge.RedGerekce)</div></td>
                        <td>@if (!string.IsNullOrWhiteSpace(belge.DosyaYolu)) { <a class="df-document-link is-icon" href="@Url.Action("Dosya", "YetkiBelgesi", new { id = belge.Id })" target="_blank" rel="noopener noreferrer" title="Yetki belgesini görüntüle" aria-label="@(belge.Firma?.FirmaAdi ?? "Yetkili servis") belgesini görüntüle"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i></a> } else { <span class="df-cell-sub">Yok</span> }</td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </section>
</div>
