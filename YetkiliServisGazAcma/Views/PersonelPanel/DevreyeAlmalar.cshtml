@model List<AdminDevreyeAlmaDto>
@{
    ViewData["Title"] = "Cihaz Devreye Alma Kayıtları";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["ActiveMenu"] = "DevreyeAlmalar";
    ViewData["PanelArea"] = "Personel";
    ViewData["DevreyeAlmaAlan"] = "/personel-panel";
    Layout = "_PanelLayout";
    var liste = new DevreyeAlmaListeViewModel
    {
        Kayitlar = Model,
        Sayfalama = ViewBag.Sayfalama as DevreyeAlmaSayfalamaDto,
        ListeUrl = Url.Action("DevreyeAlmalar", "PersonelPanel")!,
        TemizleUrl = Url.Action("DevreyeAlmalar", "PersonelPanel")!,
        PdfUrl = Url.Action("DevreyeAlmalarPdf", "PersonelPanel")!,
        ExcelUrl = Url.Action("DevreyeAlmalarExcel", "PersonelPanel")!,
        Markalar = (ViewBag.Markalar as List<AdminMarkaSecenekDto> ?? []).Select(m => m.MarkaAdi ?? "").ToList(),
        CihazTipleri = ViewBag.CihazTipleri as List<string> ?? [],
        Sehirler = ViewBag.Sehirler as List<string> ?? []
    };
}
@section PageStyles {
    <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/commissioning-history.css" asp-append-version="true" />
}
<partial name="_DevreyeAlmaDirectory" model="liste" />
@section Scripts {
    <script src="~/js/commissioning-row-details.js" asp-append-version="true"></script>
    <script src="~/js/commissioning-history.js" asp-append-version="true"></script>
}
