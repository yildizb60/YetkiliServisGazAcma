@model List<YetkiliServisGazAcma.Entities.Ys_DevreyeAlma>
@{
    ViewData["Title"] = "Cihaz Devreye Alma Kayıtları";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Personel Paneli";
    ViewData["ActiveMenu"] = "DevreyeAlmalar";
    ViewData["PanelArea"] = "Personel";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var markalar = ViewBag.Markalar as List<YetkiliServisGazAcma.Entities.Ys_Marka> ?? new();
    var firmaIlceleri = ViewBag.FirmaIlceleri as Dictionary<int, string> ?? new();
    var secilenTesisat = Context.Request.Query["tesisat"].ToString();
    var secilenMusteri = ViewBag.Musteri as string ?? Context.Request.Query["musteri"].ToString();
    var secilenMarka = Context.Request.Query["marka"].ToString();
    var secilenServis = Context.Request.Query["servis"].ToString();
    var secilenIl = Context.Request.Query["il"].ToString();
    var secilenIlce = Context.Request.Query["ilce"].ToString();
    var secilenDurum = Context.Request.Query["durum"].ToString();
    var secilenBas = Context.Request.Query["bas"].ToString();
    var secilenBit = Context.Request.Query["bit"].ToString();
    var filtreAktif = !string.IsNullOrWhiteSpace(secilenTesisat)
        || !string.IsNullOrWhiteSpace(secilenMusteri)
        || !string.IsNullOrWhiteSpace(secilenMarka)
        || !string.IsNullOrWhiteSpace(secilenServis)
        || !string.IsNullOrWhiteSpace(secilenIl)
        || !string.IsNullOrWhiteSpace(secilenIlce)
        || !string.IsNullOrWhiteSpace(secilenDurum)
        || !string.IsNullOrWhiteSpace(secilenBas)
        || !string.IsNullOrWhiteSpace(secilenBit);
    var tamamlanan = Model.Count(x => x.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi);
    var bekleyen = Model.Count(x => x.Durum == DevreyeAlmaDurumDegerleri.Bekliyor);
    var servisSayisi = Model.Select(x => x.FirmaId).Distinct().Count();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ykc-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ys-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" />
}

<div class="df-admin-workspace df-operations-directory">
    <section class="df-admin-list-card">
        <div class="df-service-list-head is-operation-toolbar">
            <div class="df-operation-list-title"><h3><i class="bi bi-list-check" aria-hidden="true"></i> Kayıt Listesi</h3><span>@Model.Count kayıt görüntüleniyor</span></div>
            <dl class="df-operation-summary" aria-label="Kayıt özeti">
                <div><dt>Tamamlanan</dt><dd>@tamamlanan</dd></div>
                <div><dt>Bekleyen</dt><dd>@bekleyen</dd></div>
                <div><dt>Yetkili Servis</dt><dd>@servisSayisi</dd></div>
            </dl>
            <details class="df-export-menu">
                <summary class="df-btn df-btn-secondary df-btn-sm"><i class="bi bi-download" aria-hidden="true"></i> Dışa Aktar <i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
                <div class="df-export-menu-panel" aria-label="Dışa aktarma işlemleri">
                    <button type="button" class="df-icon-action is-danger" onclick="indirSeciliPdf()"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i><span>Seçili kayıtları PDF indir</span></button>
                    <button type="button" class="df-icon-action is-danger" onclick="indirTumPdf()"><i class="bi bi-files" aria-hidden="true"></i><span>Tüm kayıtları PDF indir</span></button>
                    <button type="button" class="df-icon-action is-success" onclick="indirSeciliExcel()"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i><span>Seçili kayıtları Excel indir</span></button>
                    <button type="button" class="df-icon-action is-success" onclick="indirTumExcel()"><i class="bi bi-file-spreadsheet" aria-hidden="true"></i><span>Tüm kayıtları Excel indir</span></button>
                </div>
            </details>
        </div>
    <details class="df-admin-filter" open="@(filtreAktif ? "open" : null)">
        <summary>
            <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Kayıtları Filtrele</strong></span>
            <span>@(filtreAktif ? "Filtre uygulandı" : "Filtreleri aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <form method="get" action="/personel-panel/devreyealmalar">
                <div class="df-admin-filter-grid">
                    <div class="df-admin-field"><label for="tesisat">Tesisat No</label><input id="tesisat" type="search" name="tesisat" value="@secilenTesisat" placeholder="Tesisat no" /></div>
                    <div class="df-admin-field"><label for="musteri">Müşteri / Abone</label><input id="musteri" type="search" name="musteri" value="@secilenMusteri" placeholder="Ad, abone no veya telefon" /></div>
                    <div class="df-admin-field"><label for="servis">Yetkili Servis</label><input id="servis" type="search" name="servis" value="@secilenServis" placeholder="Servis adı" /></div>
                    <div class="df-admin-field"><label for="il">İl</label><input id="il" type="search" name="il" value="@secilenIl" placeholder="İl" /></div>
                    <div class="df-admin-field"><label for="ilce">İlçe</label><input id="ilce" type="search" name="ilce" value="@secilenIlce" placeholder="İlçe" /></div>
                    <div class="df-admin-field"><label for="marka">Marka</label><select id="marka" name="marka"><option value="">Tümü</option>@foreach (var m in markalar) { <option value="@m.MarkaAdi" selected="@(secilenMarka == m.MarkaAdi ? "selected" : null)">@m.MarkaAdi</option> }</select></div>
                    <div class="df-admin-field"><label for="durum">Durum</label><select id="durum" name="durum"><option value="">Tümü</option><option value="1" selected="@(secilenDurum == "1" ? "selected" : null)">Tamamlandı</option><option value="0" selected="@(secilenDurum == "0" ? "selected" : null)">Bekliyor</option><option value="2" selected="@(secilenDurum == "2" ? "selected" : null)">İptal</option></select></div>
                    <div class="df-admin-field is-half"><label for="bas">Başlangıç Tarihi</label><input id="bas" type="date" name="bas" value="@secilenBas" /></div>
                    <div class="df-admin-field is-half"><label for="bit">Bitiş Tarihi</label><input id="bit" type="date" name="bit" value="@secilenBit" /></div>
                </div>
                <div class="df-admin-filter-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/personel-panel/devreyealmalar"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Sonuçları Göster</button>
                </div>
            </form>
        </div>
    </details>

        @if (!Model.Any())
        {
            <div class="df-admin-empty"><i class="bi bi-inbox" aria-hidden="true"></i> Filtrelere uygun kayıt bulunamadı.</div>
        }
        else
        {
            <div class="df-admin-table-scroll">
                <table class="df-table df-commissioning-table">
                    <thead><tr><th><input id="tumunuSec" type="checkbox" aria-label="Tüm kayıtları seç" /></th><th>Müşteri</th><th>Tesisat ve Abone</th><th>Servis Konumu</th><th>Yetkili Servis / Marka</th><th>Devreye Alma Tarihi</th><th>Teknisyen</th><th>Durum</th><th>İşlem</th></tr></thead>
                    <tbody>
                    @foreach (var d in Model)
                    {
                        var ilce = firmaIlceleri.TryGetValue(d.FirmaId, out var firmaIlce) ? firmaIlce : "";
                        var durumYazi = d.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "Tamamlandı" : d.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "İptal" : "Bekliyor";
                        var durumSinif = d.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "df-pill-success" : d.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "df-pill-danger" : "df-pill-warning";
                        var tarihVar = d.DevreyeAlmaTarihi.Year > 1900;
                        <tr>
                            <td><input class="row-check" type="checkbox" value="@d.Id" aria-label="@d.TesistatNo kaydını seç" /></td>
                            <td><div class="df-cell-main">@(string.IsNullOrWhiteSpace(d.MusteriAdi) ? "Müşteri bilgisi yok" : d.MusteriAdi)</div><div class="df-cell-sub">@(string.IsNullOrWhiteSpace(d.MusteriTelefon) ? "Telefon bilgisi yok" : d.MusteriTelefon)</div></td>
                            <td><div class="df-cell-main">Tesisat No: @(d.TesistatNo ?? "-")</div><div class="df-cell-sub">Abone No: @(d.AboneNo ?? "-")</div></td>
                            <td><div class="df-cell-main">@(d.Firma?.FaaliyetIli ?? "-")</div><div class="df-cell-sub">@(string.IsNullOrWhiteSpace(ilce) ? "İlçe bilgisi yok" : ilce)</div></td>
                            <td><div class="df-cell-main">@(d.Firma?.FirmaAdi ?? "-")</div><div class="df-cell-sub">@(d.CihazMarka ?? d.Marka?.MarkaAdi ?? "Marka bilgisi yok")</div></td>
                            <td><div class="df-cell-main">@(tarihVar ? d.DevreyeAlmaTarihi.ToString("dd.MM.yyyy") : "Tarih bilgisi yok")</div></td>
                            <td><div class="df-cell-main">@(string.IsNullOrWhiteSpace(d.TeknisyenAdi) ? "Teknisyen bilgisi yok" : d.TeknisyenAdi)</div></td>
                            <td><span class="df-pill @durumSinif">@durumYazi</span></td>
                            <td><button class="df-icon-action ys-commissioning-row-view" type="button"
                                        title="İşlem detayını görüntüle"
                                        data-id="@d.Id"
                                        data-detail-url="/personel-panel/devreyealmalar/detay/@d.Id"
                                        data-pdf-url="/personel-panel/devreyealma-pdf/@d.Id"
                                        data-excel-url="/personel-panel/devreyealma-excel/@d.Id"
                                        data-musteri="@(d.MusteriAdi ?? "-")"
                                        data-telefon="@(d.MusteriTelefon ?? "-")"
                                        data-tc="@(d.MusteriTcNo ?? "-")"
                                        data-tesisat="@(d.TesistatNo ?? "-")"
                                        data-abone="@(d.AboneNo ?? "-")"
                                        data-adres="@(d.Adres ?? "-")"
                                        data-servis="@(d.Firma?.FirmaAdi ?? "-")"
                                        data-marka="@(d.CihazMarka ?? d.Marka?.MarkaAdi ?? "-")"
                                        data-cihaz="@(d.CihazTipi ?? "-")"
                                        data-model="@(d.CihazModeli ?? "-")"
                                        data-kapasite="@(d.CihazKapasite ?? "-")"
                                        data-teknisyen="@(d.TeknisyenAdi ?? "-")"
                                        data-notlar="@(d.Notlar ?? "-")"
                                        data-tarih="@(tarihVar ? d.DevreyeAlmaTarihi.ToString("dd.MM.yyyy") : "-")"
                                        data-durum="@durumYazi"
                                        data-durum-class="@durumSinif"><i class="bi bi-eye" aria-hidden="true"></i><span>Görüntüle</span></button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<div class="ykc-report-modal ys-commissioning-modal" id="commissioningDetailModal" aria-hidden="true">
    <div class="ykc-report-modal-backdrop" data-commissioning-modal-close></div>
    <div class="ykc-report-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="commissioningModalTitle" tabindex="-1">
        <div class="ykc-report-modal-header">
            <div class="ykc-modal-title-wrap">
                <div class="ykc-modal-icon"><i class="bi bi-person-check" aria-hidden="true"></i></div>
                <div><h3 class="ykc-modal-title" id="commissioningModalTitle">Devreye Alma Detayı</h3><div class="ykc-modal-subtitle" id="commissioningModalSubtitle">-</div></div>
            </div>
            <button class="ykc-modal-close" type="button" data-commissioning-modal-close aria-label="Kapat"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="ykc-report-modal-body">
            <div class="ykc-modal-stats">
                <div class="ykc-modal-stat ykc-modal-stat-primary"><i class="bi bi-activity"></i><div><small>Durum</small><strong><span class="df-pill" id="commissioningModalStatus">-</span></strong></div></div>
                <div class="ykc-modal-stat ykc-modal-stat-date"><i class="bi bi-calendar2-check"></i><div><small>Devreye Alma</small><strong id="commissioningModalDate">-</strong></div></div>
                <div class="ykc-modal-stat ykc-modal-stat-route"><i class="bi bi-building-check"></i><div><small>Yetkili Servis</small><strong id="commissioningModalService">-</strong></div></div>
            </div>
            <div class="ykc-modal-grid">
                <section class="ykc-modal-section ykc-modal-section-customer">
                    <div class="ykc-modal-section-title"><i class="bi bi-person-vcard"></i> Müşteri</div>
                    <div class="ykc-modal-info">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Ad Soyad</div><div class="ykc-modal-value" id="commissioningModalCustomer">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Telefon</div><div class="ykc-modal-value" id="commissioningModalPhone">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">TC</div><div class="ykc-modal-value" id="commissioningModalTc">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Adres</div><div class="ykc-modal-value" id="commissioningModalAddress">-</div></div>
                    </div>
                </section>
                <section class="ykc-modal-section ykc-modal-section-company">
                    <div class="ykc-modal-section-title"><i class="bi bi-house-gear"></i> Tesisat</div>
                    <div class="ykc-modal-info">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Tesisat No</div><div class="ykc-modal-value" id="commissioningModalInstallation">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Abone No</div><div class="ykc-modal-value" id="commissioningModalSubscriber">-</div></div>
                    </div>
                </section>
                <section class="ykc-modal-section ykc-modal-section-device">
                    <div class="ykc-modal-section-title"><i class="bi bi-fire"></i> Cihaz</div>
                    <div class="ykc-modal-info">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Cihaz Tipi</div><div class="ykc-modal-value" id="commissioningModalDevice">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Marka</div><div class="ykc-modal-value" id="commissioningModalBrand">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Model</div><div class="ykc-modal-value" id="commissioningModalModel">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Kapasite</div><div class="ykc-modal-value" id="commissioningModalCapacity">-</div></div>
                    </div>
                </section>
                <section class="ykc-modal-section ykc-modal-section-signature">
                    <div class="ykc-modal-section-title"><i class="bi bi-person-badge"></i> İşlem</div>
                    <div class="ykc-modal-info">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Teknisyen</div><div class="ykc-modal-value" id="commissioningModalTechnician">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Not</div><div class="ykc-modal-value" id="commissioningModalNote">-</div></div>
                    </div>
                </section>
            </div>
        </div>
        <div class="ykc-report-modal-footer">
            <button class="df-btn df-btn-secondary" type="button" data-commissioning-modal-close>Kapat</button>
            <a class="df-btn df-btn-danger" id="commissioningModalPdf" href="#"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
            <a class="df-btn df-btn-success" id="commissioningModalExcel" href="#"><i class="bi bi-file-earmark-excel"></i> Excel</a>
            <a class="df-btn df-btn-primary" id="commissioningModalDetail" href="#"><i class="bi bi-arrow-right-circle"></i> Tam Detay</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const tumunuSec = document.getElementById("tumunuSec");
            if (tumunuSec) {
                tumunuSec.addEventListener("change", function () {
                    document.querySelectorAll(".row-check").forEach(function (input) { input.checked = tumunuSec.checked; });
                });
            }

            const modal = document.getElementById("commissioningDetailModal");
            let lastTrigger = null;
            const setText = (id, value) => {
                const element = document.getElementById(id);
                if (element) element.textContent = value && value.trim ? (value.trim() || "-") : (value || "-");
            };
            const closeModal = () => {
                if (!modal) return;
                modal.classList.remove("is-open");
                modal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
                lastTrigger?.focus();
            };
            document.addEventListener("click", function (event) {
                const trigger = event.target.closest(".ys-commissioning-row-view");
                if (trigger && modal) {
                    const data = trigger.dataset;
                    lastTrigger = trigger;
                    setText("commissioningModalTitle", data.musteri === "-" ? "Devreye Alma Detayı" : data.musteri);
                    setText("commissioningModalSubtitle", "Tesisat No: " + (data.tesisat || "-") + " · " + (data.servis || "-"));
                    setText("commissioningModalDate", data.tarih);
                    setText("commissioningModalService", data.servis);
                    setText("commissioningModalCustomer", data.musteri);
                    setText("commissioningModalPhone", data.telefon);
                    setText("commissioningModalTc", data.tc);
                    setText("commissioningModalAddress", data.adres);
                    setText("commissioningModalInstallation", data.tesisat);
                    setText("commissioningModalSubscriber", data.abone);
                    setText("commissioningModalDevice", data.cihaz);
                    setText("commissioningModalBrand", data.marka);
                    setText("commissioningModalModel", data.model);
                    setText("commissioningModalCapacity", data.kapasite);
                    setText("commissioningModalTechnician", data.teknisyen);
                    setText("commissioningModalNote", data.notlar);
                    const status = document.getElementById("commissioningModalStatus");
                    if (status) {
                        status.textContent = data.durum || "-";
                        status.className = "df-pill " + (data.durumClass || "df-pill-muted");
                    }
                    document.getElementById("commissioningModalDetail").href = data.detailUrl || "#";
                    document.getElementById("commissioningModalPdf").href = data.pdfUrl || "#";
                    document.getElementById("commissioningModalExcel").href = data.excelUrl || "#";
                    modal.classList.add("is-open");
                    modal.setAttribute("aria-hidden", "false");
                    document.body.style.overflow = "hidden";
                    modal.querySelector("[data-commissioning-modal-close]")?.focus();
                    return;
                }
                if (event.target.closest("[data-commissioning-modal-close]")) closeModal();
            });
            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && modal?.classList.contains("is-open")) closeModal();
            });
        })();

        function seciliIdler() {
            return Array.from(document.querySelectorAll(".row-check:checked")).map(function (input) { return input.value; });
        }
        function tumIdler() {
            return Array.from(document.querySelectorAll(".row-check")).map(function (input) { return input.value; });
        }
        function kayitlariIndir(ids, yol, bosMesaj) {
            if (ids.length === 0) { alert(bosMesaj); return; }
            ids.forEach(function (id) { window.open(yol + id, "_blank"); });
        }
        function indirSeciliPdf() { kayitlariIndir(seciliIdler(), "/personel-panel/devreyealma-pdf/", "Lütfen en az bir işlem seçin."); }
        function indirTumPdf() { kayitlariIndir(tumIdler(), "/personel-panel/devreyealma-pdf/", "Kayıt bulunamadı."); }
        function indirSeciliExcel() { kayitlariIndir(seciliIdler(), "/personel-panel/devreyealma-excel/", "Lütfen en az bir işlem seçin."); }
        function indirTumExcel() { kayitlariIndir(tumIdler(), "/personel-panel/devreyealma-excel/", "Kayıt bulunamadı."); }
    </script>
}
