@model YetkiliServisGazAcma.Entities.Dag_Sirket
@{
    ViewData["Title"] = "Dağıtım Şirketini Düzenle";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "DagitimSirketler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var genelSistemAdminMi = ViewBag.GenelSistemAdminMi as bool? ?? false;
}

<div class="df-admin-workspace df-admin-editor df-company-editor">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-building-gear" aria-hidden="true"></i> ŞİRKET KAYDI</div>
                <h1 class="df-panel-title">Dağıtım Şirketini Düzenle</h1>
                <div class="df-panel-subtitle">@Model.SirketAdi şirketinin iletişim ve kayıt bilgilerini güncelleyin.</div>
            </div>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/DagitimSirket"><i class="bi bi-arrow-left" aria-hidden="true"></i> Şirketlere Dön</a>
        </div>
    </section>

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            @if (ViewBag.Hata != null)
            {
                <div class="df-alert df-alert-danger">@ViewBag.Hata</div>
            }
            <form method="post" action="/DagitimSirket/Duzenle">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />
                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-buildings" aria-hidden="true"></i></span>
                        <div><h3>Şirket Bilgileri</h3><p>Şirket adı ve faaliyet ilini doğrulayın.</p></div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-wide">
                            <label for="SirketAdi">Şirket Adı *</label>
                            <input id="SirketAdi" name="SirketAdi" value="@Model.SirketAdi" autocomplete="organization" required readonly="@(!genelSistemAdminMi ? "readonly" : null)" />
                        </div>
                        <div class="df-admin-field">
                            <label for="Il">İl *</label>
                            <input id="Il" name="Il" value="@Model.Il" autocomplete="address-level1" required readonly="@(!genelSistemAdminMi ? "readonly" : null)" />
                        </div>
                    </div>
                </section>
                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-telephone" aria-hidden="true"></i></span>
                        <div><h3>İletişim ve Durum</h3><p>İletişim bilgilerini ve kayıt durumunu güncelleyin.</p></div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-half"><label for="Telefon">Telefon</label><input id="Telefon" name="Telefon" value="@Model.Telefon" autocomplete="tel" /></div>
                        <div class="df-admin-field is-half"><label for="Email">E-posta</label><input id="Email" type="email" name="Email" value="@Model.Email" autocomplete="email" /></div>
                        <div class="df-admin-field is-full"><label for="Adres">Adres</label><textarea id="Adres" name="Adres" autocomplete="street-address">@Model.Adres</textarea></div>
                        <div class="df-admin-field">
                            <label for="AktifMi">Kayıt Durumu</label>
                            @if (!genelSistemAdminMi)
                            {
                                <input type="hidden" name="AktifMi" value="@Model.AktifMi.ToString().ToLowerInvariant()" />
                            }
                            <select id="AktifMi" name="AktifMi" disabled="@(!genelSistemAdminMi ? "disabled" : null)">
                                <option value="true" selected="@(Model.AktifMi ? "selected" : null)">Aktif</option>
                                <option value="false" selected="@(!Model.AktifMi ? "selected" : null)">Pasif</option>
                            </select>
                        </div>
                    </div>
                </section>
                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/DagitimSirket"><i class="bi bi-x-lg" aria-hidden="true"></i> Vazgeç</a>
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </section>
</div>
