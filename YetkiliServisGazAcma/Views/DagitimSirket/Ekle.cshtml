@model YetkiliServisGazAcma.Entities.Dag_Sirket
@{
    ViewData["Title"] = "Yeni Dağıtım Şirketi";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "DagitimSirketler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}

<div class="df-admin-workspace df-admin-editor df-company-editor">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-building-add" aria-hidden="true"></i> ŞİRKET KAYDI</div>
                <h1 class="df-panel-title">Yeni Dağıtım Şirketi</h1>
                <div class="df-panel-subtitle">Kurumsal kimlik, iletişim ve adres bilgilerini girin.</div>
            </div>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/DagitimSirket"><i class="bi bi-arrow-left" aria-hidden="true"></i> Şirketlere Dön</a>
        </div>
    </section>

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            @if (ViewBag.Hata != null)
            {
                <div class="df-alert df-alert-danger">@ViewBag.Hata</div>
            }
            <form method="post" action="/DagitimSirket/Ekle">
                @Html.AntiForgeryToken()
                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-buildings" aria-hidden="true"></i></span>
                        <div><h3>Şirket Bilgileri</h3><p>Listelerde ve kullanıcı bağlantılarında görünecek temel bilgiler.</p></div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-wide"><label>Şirket Adı *</label><input name="SirketAdi" value="@Model?.SirketAdi" autocomplete="organization" required /></div>
                        <div class="df-admin-field"><label>İl *</label><input name="Il" value="@Model?.Il" autocomplete="address-level1" required /></div>
                    </div>
                </section>
                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-telephone" aria-hidden="true"></i></span>
                        <div><h3>İletişim ve Adres</h3><p>Şirkete ulaşmak için kullanılacak iletişim bilgileri.</p></div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-half"><label>Telefon</label><input name="Telefon" value="@Model?.Telefon" autocomplete="tel" /></div>
                        <div class="df-admin-field is-half"><label>E-posta</label><input type="email" name="Email" value="@Model?.Email" autocomplete="email" /></div>
                        <div class="df-admin-field is-full"><label>Adres</label><textarea name="Adres" autocomplete="street-address">@Model?.Adres</textarea></div>
                    </div>
                </section>
                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/DagitimSirket"><i class="bi bi-x-lg" aria-hidden="true"></i> Vazgeç</a>
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> Şirketi Oluştur</button>
                </div>
            </form>
        </div>
    </section>
</div>
