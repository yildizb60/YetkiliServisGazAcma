@model List<YetkiliServisGazAcma.Entities.Dag_Sirket>
@{
    ViewData["Title"] = "Dağıtım Şirketleri";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "DagitimSirketler";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var seciliQ = ViewBag.SeciliQ as string ?? "";
    var seciliDurum = ViewBag.SeciliDurum as string ?? "tumu";
    var genelSistemAdminMi = ViewBag.GenelSistemAdminMi as bool? ?? false;
    var filtreAktif = !string.IsNullOrWhiteSpace(seciliQ) || seciliDurum != "tumu";
    var aktifSayisi = Model.Count(x => x.AktifMi);
}

<div class="df-admin-workspace df-company-directory">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-title"><i class="bi bi-buildings" aria-hidden="true"></i> Şirket özeti</div>
            </div>
            @if (genelSistemAdminMi)
            {
                <a class="df-btn df-btn-primary df-btn-sm" href="/DagitimSirket/Ekle"><i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Şirket</a>
            }
        </div>
        <div class="df-admin-metrics" aria-label="Şirket durum özeti">
            <span class="df-admin-metric is-company"><i class="bi bi-buildings" aria-hidden="true"></i> Toplam <strong>@Model.Count</strong></span>
            <span class="df-admin-metric is-active"><i class="bi bi-check-circle" aria-hidden="true"></i> Aktif <strong>@aktifSayisi</strong></span>
            <span class="df-admin-metric is-passive"><i class="bi bi-pause-circle" aria-hidden="true"></i> Pasif <strong>@(Model.Count - aktifSayisi)</strong></span>
        </div>
    </section>

    @if (TempData["Mesaj"] != null)
    {
        <div class="df-alert df-alert-success">@TempData["Mesaj"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <details class="df-admin-filter" open="@(filtreAktif ? "open" : null)">
        <summary>
            <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Filtreler</strong><small>Şirket adı, il, telefon veya kayıt durumuyla arayın.</small></span>
            <span>@(filtreAktif ? "Filtre uygulandı" : "Aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <form method="get" action="/DagitimSirket">
                <div class="df-admin-filter-grid">
                    <div class="df-admin-field is-wide">
                        <label>Arama</label>
                        <input type="search" name="q" value="@seciliQ" placeholder="Şirket adı, il veya telefon" />
                    </div>
                    <div class="df-admin-field">
                        <label>Durum</label>
                        <select name="durum">
                            <option value="tumu" selected="@(seciliDurum == "tumu" ? "selected" : null)">Tümü</option>
                            <option value="aktif" selected="@(seciliDurum == "aktif" ? "selected" : null)">Aktif</option>
                            <option value="pasif" selected="@(seciliDurum == "pasif" ? "selected" : null)">Pasif</option>
                        </select>
                    </div>
                </div>
                <div class="df-admin-filter-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/DagitimSirket"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-funnel-fill" aria-hidden="true"></i> Filtrele</button>
                </div>
            </form>
        </div>
    </details>

    <section class="df-admin-list-card">
        <div class="section-head">
            <div class="section-title"><i class="bi bi-list-check" aria-hidden="true"></i> Şirket Listesi</div>
            <span class="df-pill df-pill-muted">@Model.Count kayıt</span>
        </div>
        <div class="df-admin-table-scroll">
            <table class="df-table">
                <thead><tr><th>Şirket</th><th>İl</th><th>Telefon</th><th>Durum</th><th>İşlemler</th></tr></thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5"><div class="df-admin-empty">Filtreye uygun dağıtım şirketi bulunamadı.</div></td></tr>
                    }
                    else
                    {
                        @foreach (var sirket in Model)
                        {
                            <tr>
                                <td><div class="df-cell-main">@(sirket.SirketAdi ?? "-")</div><div class="df-cell-sub">@(sirket.Email ?? "E-posta tanımlı değil")</div></td>
                                <td>@(sirket.Il ?? "-")</td>
                                <td>@(sirket.Telefon ?? "-")</td>
                                <td><span class="df-pill @(sirket.AktifMi ? "df-pill-success" : "df-pill-danger")">@(sirket.AktifMi ? "Aktif" : "Pasif")</span></td>
                                <td>
                                    <div class="df-actions">
                                        <a class="df-icon-action" href="/DagitimSirket/Duzenle/@sirket.Id" title="Şirketi düzenle"><i class="bi bi-pencil" aria-hidden="true"></i><span>Düzenle</span></a>
                                        @if (genelSistemAdminMi)
                                        {
                                            <form method="post" action="/DagitimSirket/Sil/@sirket.Id" onsubmit="return confirm('Bu dağıtım şirketini silmek istiyor musunuz?');">
                                                @Html.AntiForgeryToken()
                                                <button class="df-icon-action is-danger" type="submit" title="Şirketi sil"><i class="bi bi-trash3" aria-hidden="true"></i><span>Sil</span></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
