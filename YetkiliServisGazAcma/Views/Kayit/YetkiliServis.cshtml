@model YetkiliServisGazAcma.Entities.Ys_Firma
@{
    ViewData["Title"] = "Yetkili Servis Kaydı";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    var sehirler = ViewBag.Sehirler as List<string> ?? new();
    var sehirFirmaKodlari = ViewBag.SehirFirmaKodlari as Dictionary<string, string> ?? new();
    var tumKategoriler = ViewBag.Kategoriler as List<YetkiliServisGazAcma.Entities.UrunKategori> ?? new();

    string NormalizeKategori(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var lower = value.Trim().ToLower(new System.Globalization.CultureInfo("tr-TR"))
            .Normalize(System.Text.NormalizationForm.FormD);
        var chars = lower
            .Where(ch => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch) != System.Globalization.UnicodeCategory.NonSpacingMark && char.IsLetterOrDigit(ch))
            .ToArray();
        return new string(chars)
            .Replace("ı", "i")
            .Replace("ş", "s")
            .Replace("ğ", "g")
            .Replace("ü", "u")
            .Replace("ö", "o")
            .Replace("ç", "c");
    }

    bool KullanilanKategoriMi(string? value)
    {
        var key = NormalizeKategori(value);
        return key == "kombi" || key.Contains("merkezikazan") || key.Contains("sofben") || key.Contains("sohben");
    }

    var kategoriler = tumKategoriler
        .Where(x => KullanilanKategoriMi(x.Ad))
        .GroupBy(x => NormalizeKategori(x.Ad))
        .Select(g => g.OrderByDescending(x => x.AktifMi)
            .ThenBy(x => string.IsNullOrWhiteSpace(x.IconUrl) ? 1 : 0)
            .ThenBy(x => x.SiraNo)
            .ThenBy(x => x.Ad)
            .First())
        .OrderBy(x => x.SiraNo)
        .ThenBy(x => x.Ad)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/registration.css" asp-append-version="true" />
}

<header class="registration-topbar">
    <a class="registration-brand" href="/giris" aria-label="Giriş sayfası">
        <img src="/images/company/corumgaz-kargaz-surmeligaz-logo.png" alt="Çorumgaz, Kargaz ve Sürmeligaz" />
    </a>
    <a class="registration-login" href="/giris"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Giriş Yap</a>
</header>

<main class="registration-page">
    <form class="registration-form" method="post" action="/kayit/yetkili-servis">
        @Html.AntiForgeryToken()

        <header class="registration-head">
            <span class="registration-head-icon"><i class="bi bi-building-add" aria-hidden="true"></i></span>
            <div>
                <span>Yetkili servis başvurusu</span>
                <h1>Firma Kaydı</h1>
            </div>
            <div class="registration-step"><strong>1</strong><span>Firma bilgileri</span><i class="bi bi-chevron-right" aria-hidden="true"></i><strong>2</strong><span>Yetki alanları</span></div>
        </header>

        @if (ViewBag.Hata != null)
        {
            <div class="registration-alert is-error"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @ViewBag.Hata</div>
        }
        @if (ViewBag.ApiUyari != null)
        {
            <div class="registration-alert is-error"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @ViewBag.ApiUyari</div>
        }

        <div class="registration-main-grid">
            <section class="registration-section company-section" aria-labelledby="company-title">
                <div class="registration-section-head">
                    <i class="bi bi-building" aria-hidden="true"></i>
                    <h2 id="company-title">Firma ve İletişim</h2>
                </div>
                <div class="registration-field-grid">
                    <div class="registration-field"><label for="VergiNo">VKN <span>*</span></label><input id="VergiNo" type="text" name="VergiNo" maxlength="10" inputmode="numeric" placeholder="10 haneli VKN" required value="@Model?.VergiNo" /></div>
                    <div class="registration-field"><label for="VergiDairesi">Vergi Dairesi <span>*</span></label><input id="VergiDairesi" type="text" name="VergiDairesi" placeholder="Vergi dairesi" required value="@Model?.VergiDairesi" /></div>
                    <div class="registration-field"><label for="FirmaAdi">Firma Unvanı <span>*</span></label><input id="FirmaAdi" type="text" name="FirmaAdi" placeholder="Firma unvanı" required value="@Model?.FirmaAdi" /></div>
                    <div class="registration-field"><label for="YetkiliKisi">Yetkili Kişi <span>*</span></label><input id="YetkiliKisi" type="text" name="YetkiliKisi" placeholder="Ad Soyad" required value="@Model?.YetkiliKisi" /></div>
                    <div class="registration-field"><label for="TcKimlikNo">T.C. Kimlik No <span>*</span></label><input id="TcKimlikNo" type="text" name="TcKimlikNo" maxlength="11" inputmode="numeric" placeholder="11 haneli T.C. Kimlik No" required value="@Model?.TcKimlikNo" /></div>
                    <div class="registration-field"><label for="Telefon">Telefon <span>*</span></label><input id="Telefon" type="tel" name="Telefon" placeholder="05XX XXX XX XX" required value="@Model?.Telefon" /></div>
                    <div class="registration-field"><label for="Email">E-posta <span>*</span></label><input id="Email" type="email" name="Email" placeholder="ornek@firma.com" required value="@Model?.Email" /></div>
                    <div class="registration-field"><label for="FaaliyetIli">Faaliyet İli <span>*</span></label><select name="FaaliyetIli" id="FaaliyetIli" data-firma-kodu-select required><option value="">İl seçin</option>@foreach (var sehir in sehirler){var firmaKodu = sehirFirmaKodlari.TryGetValue(sehir, out var kod) ? kod : "";<option value="@sehir" data-firma-kodu="@firmaKodu" selected="@(string.Equals(Model?.FaaliyetIli, sehir, StringComparison.CurrentCultureIgnoreCase) ? "selected" : null)">@sehir</option>}</select><small class="registration-field-hint" data-firma-kodu-target></small></div>
                    <div class="registration-field is-wide"><label for="Adres">Adres <span>*</span></label><input id="Adres" type="text" name="Adres" placeholder="Açık firma adresi" required value="@Model?.Adres" /></div>
                </div>
            </section>

            <section class="registration-section account-section" aria-labelledby="account-title">
                <div class="registration-section-head is-green">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    <h2 id="account-title">Hesap Güvenliği</h2>
                </div>
                <div class="registration-field"><label for="sifre">Şifre <span>*</span></label><input id="sifre" type="password" name="sifre" placeholder="En az 6 karakter ve 1 rakam" autocomplete="new-password" required /></div>
                <div class="registration-field"><label for="sifreTekrar">Şifre Tekrar <span>*</span></label><input id="sifreTekrar" type="password" name="sifreTekrar" placeholder="Şifrenizi tekrar girin" autocomplete="new-password" required /></div>
                <div class="registration-account-note"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Giriş kullanıcı adınız VKN olacaktır. Yetki belgenizi kayıt sonrası panelden yükleyebilirsiniz.</span></div>
            </section>
        </div>

        <div class="registration-authority-grid">
            <section class="registration-section" aria-labelledby="brands-title">
                <div class="registration-section-head">
                    <i class="bi bi-tags" aria-hidden="true"></i>
                    <h2 id="brands-title">Cihaz Markaları</h2>
                    <label class="registration-select-all"><input type="checkbox" id="tumMarkalar" onchange="TumunuSec(this)" /> Tümünü seç</label>
                </div>
                <div class="registration-brand-tools">
                    <div class="registration-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" id="markaArama" placeholder="Marka ara" oninput="markaFiltrele(this.value)" /></div>
                    <div class="registration-brand-list">
                        @foreach (var m in ViewBag.Markalar)
                        {
                            <label class="registration-choice marka-item"><input type="checkbox" name="markaidleri" value="@m.Id" id="marka_@m.Id" class="marka-cb" onchange="tumKontrol()" /><span>@m.MarkaAdi</span></label>
                        }
                    </div>
                </div>
            </section>

            <section class="registration-section" aria-labelledby="services-title">
                <div class="registration-section-head is-amber">
                    <i class="bi bi-tools" aria-hidden="true"></i>
                    <h2 id="services-title">Hizmet Türleri</h2>
                </div>
                <div class="registration-service-list">
                    @foreach (var k in kategoriler)
                    {
                        <label class="registration-choice is-service">
                            <input type="checkbox" name="kategoriidleri" value="@k.Id" />
                            <span class="registration-service-icon">@if (!string.IsNullOrWhiteSpace(k.IconUrl)){<img src="@k.IconUrl" alt="" />}else{<i class="bi bi-fire" aria-hidden="true"></i>}</span>
                            <span>@k.Ad</span>
                        </label>
                    }
                </div>
            </section>
        </div>

        <footer class="registration-actions">
            <div><a class="registration-cancel" href="/giris">Vazgeç</a><button class="registration-submit" type="submit"><i class="bi bi-send-check" aria-hidden="true"></i> Başvuruyu Tamamla</button></div>
        </footer>
    </form>
</main>

@section Scripts {
<script>
function firmaKoduBilgisiniGuncelle() {
    const select = document.querySelector('[data-firma-kodu-select]');
    const target = document.querySelector('[data-firma-kodu-target]');
    if (!select || !target) return;
    const option = select.options[select.selectedIndex];
    const firmaKodu = option ? option.getAttribute('data-firma-kodu') : '';
    target.textContent = firmaKodu ? 'Firma kodu: ' + firmaKodu : '';
    target.hidden = !firmaKodu;
}
function markaFiltrele(value) {
    const query = (value || '').toLocaleLowerCase('tr-TR').trim();
    document.querySelectorAll('.marka-item').forEach(item => { item.hidden = !item.textContent.toLocaleLowerCase('tr-TR').includes(query); });
}
function TumunuSec(element) {
    document.querySelectorAll('.marka-cb').forEach(input => { input.checked = element.checked; });
}
function tumKontrol() {
    const inputs = Array.from(document.querySelectorAll('.marka-cb'));
    const all = document.getElementById('tumMarkalar');
    if (all) all.checked = inputs.length > 0 && inputs.every(input => input.checked);
}
document.addEventListener('DOMContentLoaded', function () {
    const select = document.querySelector('[data-firma-kodu-select]');
    select?.addEventListener('change', firmaKoduBilgisiniGuncelle);
    firmaKoduBilgisiniGuncelle();
});
</script>
}
