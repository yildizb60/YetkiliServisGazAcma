@{
    ViewData["Title"] = "Cihaz Değişim Formu";
    Layout = "_PublicLayout";
}

@section Styles {
    <style>
        :root {
            --c-primary: #3bb7e8;
            --c-accent: #4caf7d;
            --c-ink: #0e1a24;
            --c-muted: #5a6b78;
            --c-bg: #f4f7fa;
            --c-card: #ffffff;
            --c-border: #e4edf4;
            --c-shadow: 0 16px 44px rgba(10, 27, 43, .11);
        }

        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Manrope", Arial, sans-serif; color: var(--c-ink); background: #fff; }
        a { color: inherit; text-decoration: none; }
        .container { max-width: 1320px; margin: 0 auto; padding: 0 22px; }

        .site-header {
            position: relative;
            top: 0;
            z-index: 30;
            background: #fff;
            box-shadow: 0 12px 28px rgba(0, 0, 0, .12);
            border-radius: 22px;
            margin: 18px auto -70px;
            max-width: 1480px;
            border: 1px solid #e6eef4;
        }
        .site-header-top { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--c-border); padding: 12px 0; gap: 16px; }
        .site-header-top-buttons { display: flex; flex-wrap: wrap; gap: 18px; font-size: 13px; font-weight: 800; text-transform: uppercase; margin-left: -8px; }
        .site-header-top-buttons a { padding: 8px 6px; }
        .site-header-top-buttons a.active { color: #0e1a24; }
        .site-header-top-action { display: flex; align-items: center; gap: 12px; }
        .header-search { display: flex; align-items: center; gap: 8px; }
        .site-search-btn { width: 34px; height: 34px; border-radius: 8px; border: 1px solid #d6e3ee; background: #fff; cursor: pointer; display: grid; place-items: center; }
        .header-search-input { width: 0; opacity: 0; padding: 0; border: 0; height: 32px; transition: all .2s ease; pointer-events: none; }
        .header-search.active .header-search-input { width: 180px; opacity: 1; padding: 6px 10px; border: 1px solid #d6e3ee; border-radius: 8px; pointer-events: auto; }
        .site-header-social { display: flex; gap: 10px; }
        .sm-btn { width: 36px; height: 36px; border-radius: 10px; border: 1px solid #d6efe3; background: #f7fbf9; display: grid; place-items: center; cursor: pointer; transition: all .2s ease; box-shadow: 0 6px 12px rgba(0, 0, 0, .08); }
        .sm-btn:hover { background: #eef9f2; }
        .site-header-lang { font-weight: 800; font-size: 12px; margin-left: 8px; }
        .icon { display: inline-block; width: 18px; height: 18px; background-repeat: no-repeat; background-position: center; background-size: contain; }
        .icon-search { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234CAF7D' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='7'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg>"); }
        .icon-facebook { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%234CAF7D'><path d='M13 3h4v4h-4c-1.1 0-2 .9-2 2v2h6v4h-6v6h-4v-6H5v-4h4V9c0-3.3 2.7-6 6-6z'/></svg>"); }
        .icon-instagram { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%234CAF7D'><path d='M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5.5A3.5 3.5 0 1 0 15.5 12 3.5 3.5 0 0 0 12 8.5zm6-2.75a1 1 0 1 0 1 1 1 1 0 0 0-1-1z'/></svg>"); }
        .icon-youtube { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%234CAF7D'><path d='M21.8 8.001a2.75 2.75 0 0 0-1.94-1.95C18.1 5.5 12 5.5 12 5.5s-6.1 0-7.86.55A2.75 2.75 0 0 0 2.2 8c-.55 1.76-.55 4-.55 4s0 2.24.55 4a2.75 2.75 0 0 0 1.94 1.95C5.9 18.5 12 18.5 12 18.5s6.1 0 7.86-.55A2.75 2.75 0 0 0 21.8 16c.55-1.76.55-4 .55-4s0-2.24-.55-4zM10 15.5v-7l6 3.5-6 3.5z'/></svg>"); }
        .icon-linkedin { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%234CAF7D'><path d='M6 9H3v12h3zM4.5 3.5A1.5 1.5 0 1 0 6 5a1.5 1.5 0 0 0-1.5-1.5zM21 13.5c0-2.5-1.3-4-3.5-4a3 3 0 0 0-2.5 1.4V9h-3v12h3v-6.5c0-1.4.8-2.2 1.9-2.2 1.1 0 1.7.8 1.7 2.2V21h3z'/></svg>"); }
        .site-header-content { display: flex; align-items: center; justify-content: space-between; padding: 26px 0; min-height: 98px; }
        .site-header-brand { font-weight: 800; color: #0e1a24; font-size: 22px; margin-left: -8px; }
        .site-header-cta a { padding: 12px 26px; border-radius: 999px; border: 2px solid var(--c-ink); font-weight: 800; color: #0e1a24; font-size: 14px; margin-right: 22px; }

        .banner { position: relative; margin-top: 12px; color: #fff; background: url("/images/hero/home-banner-modern-dogalgaz-yasam-alani.png") center 52%/cover no-repeat; min-height: 460px; display: flex; align-items: center; }
        .banner::before { content: ""; position: absolute; inset: 0; background: linear-gradient(120deg, rgba(0, 2, 3, .92), rgba(23, 94, 116, .64), rgba(76, 175, 125, .18)); }
        .banner-inner { position: relative; width: 100%; padding: 64px 0 46px; }
        .site-breadcrumbs { display: flex; align-items: center; gap: 8px; font-size: 12px; letter-spacing: .4px; text-transform: uppercase; opacity: .92; }
        .site-breadcrumbs .sep { opacity: .7; }
        .banner-title { text-align: center; margin: 54px 0 8px; font-size: 36px; font-weight: 900; }
        .banner-sub { text-align: center; font-size: 16px; opacity: .96; max-width: 780px; margin: 0 auto; line-height: 1.65; }

        .info-shell { background: #f4f7fa; padding: 0 0 64px; }
        .intro-cards { position: relative; z-index: 5; max-width: 1240px; margin: -64px auto 0; padding: 0 22px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
        .intro-card { background: #fff; border: 1px solid var(--c-border); border-top: 4px solid var(--c-accent); border-radius: 18px; box-shadow: var(--c-shadow); padding: 22px; }
        .intro-card strong { display: block; font-size: 15px; margin-bottom: 8px; color: #0e1a24; }
        .intro-card p { margin: 0; color: var(--c-muted); font-size: 13px; line-height: 1.65; }

        .process {
            max-width: 1200px;
            margin: 54px auto 0;
            padding: 34px 18px 24px;
            background: #fff;
            position: relative;
            overflow: hidden;
        }
        .process-head { text-align: center; margin-bottom: 28px; }
        .process-title { font-size: 30px; font-weight: 900; color: #112537; margin: 0; }
        .process-sub { margin-top: 8px; color: #607487; font-size: 15px; line-height: 1.55; }
        .process .step { position: absolute; left: 9%; right: 9%; top: 92px; z-index: 1; height: 260px; pointer-events: none; }
        .process .step img { width: 100%; height: 100%; object-fit: contain; display: block; opacity: .95; }
        .process-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; position: relative; z-index: 3; background: transparent; }
        .single-process { text-align: center; transition: transform .22s ease; background: transparent; position: relative; z-index: 5; }
        .single-process.down { margin-top: 64px; }
        .single-process:hover { transform: translateY(-4px); }
        .part-icon {
            width: 130px;
            height: 130px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: url("https://www.baskentgazyetkilifirma.com/assets/img/single-process-hover.png") 100% 100% no-repeat;
            background-size: contain;
            margin-bottom: 26px;
            position: relative;
            color: #fff;
            font-size: 42px;
        }
        .part-icon::after {
            content: "";
            position: absolute;
            inset: 0;
            background: none;
            z-index: 1;
            pointer-events: none;
            opacity: 0;
            transition: opacity .2s ease-in;
        }
        .part-icon > span:not(.step-num) {
            position: relative;
            z-index: 3;
        }
        .single-process:hover .part-icon {
            background: none;
            transform: translateY(-3px) scale(1.02);
        }
        .single-process:hover .part-icon::after {
            background: url("/img/process/process.png?v=20260410b") 100% 100% no-repeat;
            background-size: contain;
            opacity: 1;
        }
        .step-num {
            position: absolute;
            top: -2px;
            left: -4px;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #515251;
            color: #fff;
            font-size: 13px;
            line-height: 28px;
            font-weight: 800;
            z-index: 4;
        }
        .single-process:hover .step-num { background: #53a92c; }
        .single-process h4 { font-weight: 800; color: #1a2430; font-size: clamp(22px, 1.25vw, 28px); margin: 0 0 10px; line-height: 1.12; }
        .single-process p { font-size: 15px; line-height: 1.65; color: #334f67; margin: 0 auto; max-width: 260px; }

        .form-section { max-width: 1200px; margin: 54px auto 0; padding: 0 22px; display: grid; grid-template-columns: 1fr 1.05fr; gap: 22px; align-items: stretch; }
        .form-copy, .form-preview { background: #fff; border: 1px solid var(--c-border); border-radius: 18px; box-shadow: 0 14px 34px rgba(10, 27, 43, .08); padding: 24px; }
        .section-kicker { color: #2a8fb2; font-size: 12px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 8px; }
        .section-heading { margin: 0 0 10px; color: #0e1a24; font-size: 24px; font-weight: 900; }
        .form-copy p { color: var(--c-muted); line-height: 1.7; margin: 0 0 14px; font-size: 14px; }
        .rule-list { display: grid; gap: 10px; margin-top: 18px; }
        .rule-item { display: grid; grid-template-columns: 34px 1fr; gap: 10px; align-items: start; border: 1px solid #e8f0f6; background: #fbfdff; border-radius: 12px; padding: 12px; }
        .rule-no { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: #f0fdf4; color: #247047; font-weight: 900; }
        .rule-item strong { display: block; font-size: 13px; color: #0e1a24; margin-bottom: 3px; }
        .rule-item span { color: var(--c-muted); font-size: 12px; line-height: 1.55; }

        .doc-card { border: 1px solid #dfe9f1; border-radius: 14px; overflow: hidden; background: #fbfdff; }
        .doc-head { display: flex; justify-content: space-between; gap: 10px; align-items: center; background: #fff; border-bottom: 1px solid #dfe9f1; padding: 14px 16px; }
        .doc-title { font-weight: 900; color: #0e1a24; font-size: 14px; }
        .doc-pill { border-radius: 999px; background: #f0fdf4; color: #247047; border: 1px solid #d6efe3; padding: 6px 10px; font-size: 11px; font-weight: 900; }
        .doc-body { padding: 16px; display: grid; gap: 10px; }
        .doc-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .doc-field { background: #fff; border: 1px solid #e5eef5; border-radius: 10px; padding: 10px; min-height: 58px; }
        .doc-label { color: #728494; font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 6px; }
        .doc-value { color: #233846; font-size: 13px; font-weight: 800; }
        .doc-signatures { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 6px; }
        .signature { border: 1px dashed #c8d8e4; border-radius: 10px; background: #fff; min-height: 74px; padding: 10px; color: #728494; font-size: 11px; font-weight: 800; display: flex; align-items: flex-end; }
        .form-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
        .btn-main, .btn-soft { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; border-radius: 999px; padding: 0 18px; font-size: 13px; font-weight: 900; }
        .btn-main { background: #0e1a24; color: #fff; }
        .btn-soft { border: 1px solid #dce8f1; background: #fff; color: #335165; }

        .note-band { max-width: 1200px; margin: 28px auto 0; padding: 0 22px; }
        .note-inner { border: 1px solid #d6efe3; background: #f7fbf9; color: #2e5a43; border-radius: 16px; padding: 18px 20px; font-size: 13px; line-height: 1.7; }

        .emergency-strip { margin-top: 54px; background: #052d4a; color: rgba(255, 255, 255, .85); padding: 14px 18px; text-align: center; font-weight: 600; font-size: 13px; letter-spacing: .02em; }
        .emergency-strip strong { color: #fff; }
        footer { background: #ffffff; padding: 48px 18px 0; border-top: 3px solid #3bb7e8; margin-top: 0; }
        #footer .innerContainer { max-width: 1100px; margin: 0 auto; }
        #footer .columns { display: grid; grid-template-columns: 1.2fr 1fr 1.2fr; gap: 40px; padding-bottom: 36px; }
        #footer .mainHeading { font-weight: 800; margin-bottom: 14px; font-size: 14px; color: #1a3d2b; position: relative; padding-bottom: 10px; }
        #footer .mainHeading::after { content: ""; position: absolute; left: 0; bottom: 0; width: 32px; height: 2px; background: #1a3d2b; border-radius: 2px; }
        #footer .columnContent { font-size: 13px; color: #3a5a48; line-height: 1.75; }
        #footer ul.menu { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
        #footerBottom { background: #eaf6fb; padding: 14px 0; border-top: 1px solid #d5eaf5; }
        #footerBottom .innerContainer { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #3a5a48; padding: 0 18px; font-weight: 600; }

        @@media (max-width: 980px) {
            .site-header-top, .site-header-content { flex-direction: column; gap: 10px; align-items: flex-start; }
            .site-header-top-buttons { gap: 12px; }
            .intro-cards, .form-section { grid-template-columns: 1fr; }
            .process .step { display: none; }
            .process-row { grid-template-columns: 1fr 1fr; }
            .single-process.down { margin-top: 0; }
            #footer .columns { grid-template-columns: 1fr; }
            #footerBottom .innerContainer { flex-direction: column; gap: 8px; }
        }

        @@media (max-width: 640px) {
            .site-header { margin: 10px 10px -50px; border-radius: 16px; }
            .banner { min-height: 390px; }
            .banner-title { font-size: 30px; margin-top: 42px; }
            .process-row, .doc-row, .doc-signatures { grid-template-columns: 1fr; }
            .site-header-top-action { flex-wrap: wrap; }
        }
    </style>
}

<header class="site-header">
    <div class="container">
        <div class="site-header-top">
            <div class="site-header-top-buttons">
                <a href="/">ANASAYFA</a>
                <a href="/yetkili-servisler">YETKİLİ SERVİSLER</a>
                <a class="active" href="/cihaz-degisim-formu">CİHAZ DEĞİŞİMİ</a>
                <a href="/kayit/yetkili-servis">YETKİLİ SERVİS KAYDI</a>
                <a href="/giris">GİRİŞ</a>
            </div>
            <div class="site-header-top-action">
                <div class="header-search" id="headerSearch">
                    <button class="site-search-btn" type="button" onclick="document.getElementById('headerSearch').classList.toggle('active')" aria-label="Arama"><i class="icon icon-search"></i></button>
                    <input class="header-search-input" type="text" placeholder="Arama..." />
                </div>
                <div class="site-header-social">
                    <button type="button" class="sm-btn" aria-label="Facebook"><i class="icon icon-facebook"></i></button>
                    <button type="button" class="sm-btn" aria-label="Instagram"><i class="icon icon-instagram"></i></button>
                    <button type="button" class="sm-btn" aria-label="YouTube"><i class="icon icon-youtube"></i></button>
                    <button type="button" class="sm-btn" aria-label="LinkedIn"><i class="icon icon-linkedin"></i></button>
                </div>
                <div class="site-header-lang"><span>TR</span></div>
            </div>
        </div>
        <div class="site-header-content">
            <div class="site-header-brand">Yetkili Servis Gaz Açma Sistemi</div>
            <div class="site-header-cta"><a href="/giris"><span>TALEP OLUŞTUR</span></a></div>
        </div>
    </div>
</header>

<section class="banner">
    <div class="container banner-inner">
        <div class="site-breadcrumbs">
            <a href="/">ANASAYFA</a><span class="sep">/</span>
            <span>CİHAZ DEĞİŞİM FORMU</span>
        </div>
        <div class="banner-title">CİHAZ DEĞİŞİM FORMU</div>
        <div class="banner-sub">Daha önce dağıtım şirketince onaylanarak doğal gaz arzı sağlanan adreslerde, tadilat projesi gerektirmeyen yakıcı cihaz değişim taleplerinin nasıl ilerlediğini gösteren süreç bilgilendirme ekranı.</div>
    </div>
</section>

<main class="info-shell">
    <section class="intro-cards">
        <div class="intro-card">
            <strong>Ne zaman kullanılır?</strong>
            <p>Onaylı projedeki cihazın tipinde, yerleşiminde veya kapasitesinde değişiklik olmadan cihaz değişimi yapılmak istendiğinde kullanılır.</p>
        </div>
        <div class="intro-card">
            <strong>Kim doldurur?</strong>
            <p>Form, cihaz değişimini yapacak sertifikalı firma tarafından doldurulur ve dağıtım şirketi kontrolüne gönderilir.</p>
        </div>
        <div class="intro-card">
            <strong>Uygun bulunmazsa?</strong>
            <p>Dağıtım şirketi uygun görmezse süreç tadilat projesi kapsamında yürütülmek üzere firmaya bilgilendirme yapılır.</p>
        </div>
    </section>

    <section class="process">
        <div class="process-head">
            <h2 class="process-title">Cihaz Değişim Süreç Akışı</h2>
            <div class="process-sub">Sertifikalı firma talebinden iç tesisat incelemesine, saha kontrolünden işlem geçmişine kadar süreç tek hat üzerinde takip edilir.</div>
        </div>
        <div class="step" aria-hidden="true">
            <img src="https://www.baskentgazyetkilifirma.com/assets/img/step.png" alt="">
        </div>
        <div class="process-row">
            <div class="single-process">
                <div class="part-icon">
                    <span class="step-num">1</span>
                    <span>📥</span>
                </div>
                <h4>Tesisat Sorgulama</h4>
                <p>Tesisat ve sözleşme bilgisiyle son onaylı projedeki cihazlar sistemden sorgulanır.</p>
            </div>
            <div class="single-process down">
                <div class="part-icon">
                    <span class="step-num">2</span>
                    <span>🔍</span>
                </div>
                <h4>Cihaz Seçimi</h4>
                <p>Firma, projede görünen cihazlardan işlem yapılacak cihazı seçer ve yeni cihaz bilgilerini girer.</p>
            </div>
            <div class="single-process">
                <div class="part-icon">
                    <span class="step-num">3</span>
                    <span>🧾</span>
                </div>
                <h4>FR265 Formu</h4>
                <p>Dağıtım şirketi tip formatındaki form dijital olarak önizlenir, indirilir ve imzalı hali yüklenir.</p>
            </div>
            <div class="single-process down">
                <div class="part-icon">
                    <span class="step-num">4</span>
                    <span>✅</span>
                </div>
                <h4>İnceleme ve Sonuç</h4>
                <p>İç tesisat mühendisi formu kontrol eder; uygun ise randevu ve saha süreci tamamlanır.</p>
            </div>
        </div>
    </section>

    <section class="form-section">
        <div class="form-copy">
            <div class="section-kicker">Form ve kontrol mantığı</div>
            <h2 class="section-heading">Formda hangi bilgiler izlenir?</h2>
            <p>Cihaz Değişim Formu, onaylı proje eki olarak saklanacak resmi kayıt niteliğindedir. Sistemde tesisat, müşteri, firma, projedeki cihaz ve yeni takılacak cihaz bilgileri birlikte değerlendirilir.</p>
            <p>Projedeki cihaz ile yeni cihazın tipi, baca tipi ve kapasitesi uyumlu değilse süreç tadilat projesi gerektirebilir.</p>

            <div class="rule-list">
                <div class="rule-item">
                    <div class="rule-no">1</div>
                    <div><strong>Tip format korunur</strong><span>Dağıtım şirketince belirlenen Cihaz Değişim Formu formatı kullanılır.</span></div>
                </div>
                <div class="rule-item">
                    <div class="rule-no">2</div>
                    <div><strong>İmzalı nüsha takip edilir</strong><span>Firma, müşteri ve dağıtım şirketi yetkilisi imza süreci dosya geçmişinde izlenir.</span></div>
                </div>
                <div class="rule-item">
                    <div class="rule-no">3</div>
                    <div><strong>Geçmişe yansır</strong><span>Onaylanan değişiklik ilgili tesisatın cihaz değişim geçmişinde takip edilir.</span></div>
                </div>
            </div>

            <div class="form-actions">
                <a class="btn-main" href="/giris">Panele Giriş Yap</a>
                <a class="btn-soft" href="/kayit/yetkili-servis">Yetkili Servis Kaydı</a>
            </div>
        </div>

        <div class="form-preview">
            <div class="section-kicker">Formu incele</div>
            <h2 class="section-heading">Dijital form görünümü</h2>
            <div class="doc-card">
                <div class="doc-head">
                    <div class="doc-title">Proje Tadilatı Gerektirmeyen Yakıcı Cihaz Değişim Formu</div>
                    <div class="doc-pill">FR265</div>
                </div>
