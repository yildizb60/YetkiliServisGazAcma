@model List<YetkiliServisGazAcma.Entities.Ys_Marka>
@{
    ViewData["Title"] = "Markalar";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "Markalar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var seciliQ = ViewBag.SeciliQ as string ?? "";
    var seciliDurum = ViewBag.SeciliDurum as string ?? "tumu";
    var genelSistemAdminMi = ViewBag.GenelSistemAdminMi as bool? ?? false;
    var aktifSayisi = Model.Count(x => x.AktifMi);
    var pasifSayisi = Model.Count - aktifSayisi;
    var filtreAktif = !string.IsNullOrWhiteSpace(seciliQ) || seciliDurum != "tumu";
}

<div class="df-admin-workspace df-brand-workspace">
    @if (TempData["Mesaj"] != null)
    {
        <div class="df-alert df-alert-success">@TempData["Mesaj"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <div class="section-label">
        <i class="bi bi-tags"></i>
        Marka yönetimi
    </div>

    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-ui-checks-grid"></i> Marka kataloğu</div>
                <div class="df-panel-title">Markalar</div>
                <div class="df-panel-subtitle">Cihaz devreye alma ve yetki kapsamlarında kullanılan marka kayıtlarını yönetin.</div>
            </div>
            <div class="df-actions">
                @if (genelSistemAdminMi)
                {
                    <a class="df-btn df-btn-primary df-btn-sm" href="/Marka/Ekle">
                        <i class="bi bi-plus-lg"></i>
                        Yeni Marka
                    </a>
                }
            </div>
        </div>
        <div class="df-admin-metrics" aria-label="Marka durum özeti">
            <span class="df-admin-metric active">
                <i class="bi bi-collection"></i>
                <span>Tüm Markalar</span>
                <strong>@Model.Count</strong>
            </span>
            <span class="df-admin-metric is-active">
                <i class="bi bi-check-circle"></i>
                <span>Aktif</span>
                <strong>@aktifSayisi</strong>
            </span>
            <span class="df-admin-metric is-passive">
                <i class="bi bi-slash-circle"></i>
                <span>Pasif</span>
                <strong>@pasifSayisi</strong>
            </span>
        </div>
    </section>

    <details class="df-admin-filter" @(filtreAktif ? "open" : "")>
        <summary>
            <span>
                <i class="bi bi-funnel"></i>
                <span>
                    <strong>Filtreler</strong>
                    <small>Marka adı, açıklama veya durum ile arayın.</small>
                </span>
            </span>
            <span>Filtreleri aç <i class="bi bi-chevron-down"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <form method="get" action="/Marka">
                <div class="df-admin-filter-grid">
                    <div class="df-admin-field is-wide">
                        <label>Arama</label>
                        <input type="text" name="q" value="@seciliQ" placeholder="Marka adı, açıklama..." />
                    </div>
                    <div class="df-admin-field">
                        <label>Durum</label>
                        <select name="durum">
                            <option value="tumu" selected="@(seciliDurum == "tumu")">Tümü</option>
                            <option value="aktif" selected="@(seciliDurum == "aktif")">Aktif</option>
                            <option value="pasif" selected="@(seciliDurum == "pasif")">Pasif</option>
                        </select>
                    </div>
                </div>
                <div class="df-admin-filter-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/Marka">
                        <i class="bi bi-x-lg"></i>
                        Temizle
                    </a>
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit">
                        <i class="bi bi-search"></i>
                        Filtrele
                    </button>
                </div>
            </form>
        </div>
    </details>

    <section class="df-admin-list-card">
        <div class="df-service-list-head">
            <div>
                <h3><i class="bi bi-tags"></i> Marka Listesi</h3>
                <span>@Model.Count kayıt listeleniyor</span>
            </div>
        </div>

        <div class="df-admin-table-scroll">
            <table class="df-table">
                <thead>
                    <tr>
                        <th>Marka Adı</th>
                        <th>Açıklama</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4">
                                <div class="df-admin-empty">Henüz marka kaydı bulunmuyor.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var m in Model)
                        {
                            <tr>
                                <td>
                                    <div class="df-cell-main">@m.MarkaAdi</div>
                                </td>
                                <td>
                                    <div class="df-cell-sub">@(string.IsNullOrWhiteSpace(m.Aciklama) ? "-" : m.Aciklama)</div>
                                </td>
                                <td>
                                    <span class="df-pill @(m.AktifMi ? "df-pill-success" : "df-pill-muted")">
                                        @(m.AktifMi ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td>
                                    <div class="df-actions">
                                        @if (genelSistemAdminMi)
                                        {
                                            <a class="df-icon-action" href="/Marka/Duzenle/@m.Id">
                                                <i class="bi bi-pencil-square"></i>
                                                Düzenle
                                            </a>
                                            <a class="df-icon-action is-danger" href="/Marka/Sil/@m.Id"
                                               onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                                <i class="bi bi-trash"></i>
                                                Sil
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="df-icon-action is-disabled">Yetki yok</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
