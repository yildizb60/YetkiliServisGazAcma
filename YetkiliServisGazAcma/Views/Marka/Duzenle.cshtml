@model YetkiliServisGazAcma.Entities.Ys_Marka
@{
    ViewData["Title"] = "Marka Düzenle";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Admin Paneli";
    ViewData["ActiveMenu"] = "Markalar";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}

<div class="df-admin-workspace df-admin-editor df-brand-workspace">
    <section class="df-page-panel df-admin-hero">
        <div class="df-panel-head">
            <div>
                <div class="df-panel-kicker"><i class="bi bi-pencil-square"></i> Marka kaydı</div>
                <div class="df-panel-title">Marka Düzenle</div>
                <div class="df-panel-subtitle">@Model.MarkaAdi markasının adını ve açıklamasını güncelleyin.</div>
            </div>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/Marka"><i class="bi bi-arrow-left"></i> Markalara Dön</a>
        </div>
    </section>

    <section class="df-admin-form-card">
        <div class="df-admin-form-body">
            <form method="post" action="/Marka/Duzenle">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />

                <section class="df-admin-form-section">
                    <div class="df-admin-form-section-head">
                        <span><i class="bi bi-bookmark-check"></i></span>
                        <div>
                            <h3>Marka Bilgileri</h3>
                            <p>Servis yetkilendirmelerinde görünen marka bilgisini güncelleyin.</p>
                        </div>
                    </div>
                    <div class="df-admin-form-grid">
                        <div class="df-admin-field is-half">
                            <label>Marka Adı *</label>
                            <input type="text" name="MarkaAdi" value="@Model.MarkaAdi" required />
                        </div>
                        <div class="df-admin-field is-half">
                            <label>Kayıt Durumu</label>
                            <select name="AktifMi">
                                <option value="true" selected="@(Model.AktifMi)">Aktif</option>
                                <option value="false" selected="@(!Model.AktifMi)">Pasif</option>
                            </select>
                        </div>
                        <div class="df-admin-field is-full">
                            <label>Açıklama</label>
                            <textarea name="Aciklama" placeholder="Gerekliyse kısa bir açıklama girin.">@Model.Aciklama</textarea>
                            <small class="df-admin-field-note">Açıklama zorunlu değildir.</small>
                        </div>
                    </div>
                </section>

                <div class="df-admin-form-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm" href="/Marka"><i class="bi bi-x-lg"></i> Vazgeç</a>
                    <button type="submit" class="df-btn df-btn-primary df-btn-sm"><i class="bi bi-check2"></i> Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </section>
</div>
