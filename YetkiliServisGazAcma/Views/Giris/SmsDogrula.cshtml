@{
    ViewData["Title"] = "SMS Doğrulama";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
}

<main class="login-shell">
    <div class="login-visual" aria-hidden="true"></div>
    <section class="login-side" aria-label="SMS doğrulama">
        <div class="login-card">
            <a class="login-brand" href="/giris" aria-label="Giriş sayfası">
                <img src="/images/company/corumgaz-kargaz-surmeligaz-logo.png" alt="Çorumgaz, Kargaz ve Sürmeligaz" />
            </a>
            <header class="login-card-head">
                <span class="login-step-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                <h1>Telefon Doğrulama</h1>
                <p>Telefonunuza gönderilen tek kullanımlık kodu girin.</p>
            </header>
            @if (TempData["Bilgi"] != null) { <div class="login-message is-info">@TempData["Bilgi"]</div> }
            @if (ViewBag.Hata != null) { <div class="login-message is-error">@ViewBag.Hata</div> }
            <form method="post" action="/giris/sms-dogrula">
                @Html.AntiForgeryToken()
                <div class="login-field">
                    <label for="kod">Doğrulama Kodu</label>
                    <input class="otp-input" id="kod" name="kod" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder="Doğrulama kodu" required autofocus />
                </div>
                <button class="login-submit" type="submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> Girişi Tamamla</button>
            </form>
            <a class="login-link" href="/giris?temizle=true"><i class="bi bi-arrow-left" aria-hidden="true"></i> Giriş ekranına dön</a>
        </div>
    </section>
</main>
