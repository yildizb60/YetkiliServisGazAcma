@{
    ViewData["Title"] = "Giriş";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    bool smsBekleniyor = ViewBag.SmsBekleniyor as bool? ?? false;
    bool sifreUnuttum = ViewBag.SifreUnuttum as bool? ?? false;
    bool sifreSifirlaKodBekleniyor = ViewBag.SifreSifirlaKodBekleniyor as bool? ?? false;
    var bilgi = ViewBag.Bilgi ?? TempData["Bilgi"];
    var baslik = smsBekleniyor
        ? "Doğrulama Kodu"
        : sifreSifirlaKodBekleniyor
            ? "Yeni Şifre"
            : sifreUnuttum
                ? "Şifremi Unuttum"
                : "Hoş Geldiniz";
    var altBaslik = smsBekleniyor
        ? "Telefonunuza gönderilen doğrulama kodunu girin."
        : sifreSifirlaKodBekleniyor
            ? "Doğrulama kodunuzla yeni şifrenizi belirleyin."
            : sifreUnuttum
                ? "Kayıtlı hesabınızı yazarak SMS doğrulaması başlatın."
                : "VKN veya e-posta adresinizle giriş yapın.";
}

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
}

<partial name="_LoginHeader" />
<main class="login-shell">
    <div class="login-visual" aria-hidden="true"></div>
    <section class="login-side" aria-label="Kullanıcı girişi">
        <p class="visually-hidden" data-login-announcer aria-live="polite" aria-atomic="true"></p>
        <div class="login-card">
            <header class="login-card-head">
                <h1>@baslik</h1>
                <p>@altBaslik</p>
            </header>

            @if (ViewBag.Hata != null)
            {
                <div class="login-message is-error">@ViewBag.Hata</div>
            }
            @if (bilgi != null)
            {
                <div class="login-message is-info">@bilgi</div>
            }

            @if (smsBekleniyor)
            {
                <form method="post" action="/giris/sms-dogrula">
                    @Html.AntiForgeryToken()
                    <div class="login-field">
                        <label for="sms-kod">SMS Doğrulama Kodu</label>
                        <input class="otp-input" id="sms-kod" type="text" name="kod" placeholder="6 haneli kod" inputmode="numeric" autocomplete="one-time-code" maxlength="8" required />
                    </div>
                    <button type="submit" class="login-submit">Girişi Tamamla</button>
                </form>
                <a class="login-link" href="/giris?temizle=true">Baştan giriş yap</a>
            }
            else if (sifreSifirlaKodBekleniyor)
            {
                <form method="post" action="/giris/sifre-yenile">
                    @Html.AntiForgeryToken()
                    <div class="login-field"><label for="sifre-kod">SMS Doğrulama Kodu</label><input class="otp-input" id="sifre-kod" type="text" name="kod" placeholder="6 haneli kod" inputmode="numeric" autocomplete="one-time-code" maxlength="8" required /></div>
                    <div class="login-field"><label for="yeni-sifre">Yeni Şifre</label><input id="yeni-sifre" type="password" name="yeniSifre" placeholder="Yeni şifreniz" autocomplete="new-password" required /></div>
                    <div class="login-field"><label for="yeni-sifre-tekrar">Yeni Şifre Tekrar</label><input id="yeni-sifre-tekrar" type="password" name="yeniSifreTekrar" placeholder="Yeni şifreniz tekrar" autocomplete="new-password" required /></div>
                    <button type="submit" class="login-submit">Şifreyi Değiştir</button>
                </form>
                <a class="login-link" href="/giris?temizle=true">Giriş ekranına dön</a>
            }
            else if (sifreUnuttum)
            {
                <form method="post" action="/giris/sifre-unuttum">
                    @Html.AntiForgeryToken()
                    <div class="login-field"><label for="sifre-kullanici">VKN veya E-posta</label><input id="sifre-kullanici" type="text" name="kullaniciAdi" placeholder="VKN veya e-posta adresiniz" autocomplete="username" required /></div>
                    <button type="submit" class="login-submit">SMS Kodu Gönder</button>
                </form>
                <a class="login-link" href="/giris">Giriş ekranına dön</a>
            }
            else
            {
                <div class="nav nav-underline nav-justified login-tabs" role="tablist" aria-label="Giriş türü">
                    <button type="button" id="login-firma" role="tab" aria-selected="true" aria-controls="login-panel" data-login-mode="firma" data-demo-user="@(HostEnvironment.EnvironmentName == "Development" ? "test.sertifikalifirma@demo.com" : "")" data-demo-password="@(HostEnvironment.EnvironmentName == "Development" ? "Demo123!" : "")"><i class="bi bi-building-check" aria-hidden="true"></i><span>Sertifikalı Firma</span></button>
                    <button type="button" id="login-servis" role="tab" aria-selected="false" aria-controls="login-panel" tabindex="-1" data-login-mode="servis" data-demo-user="@(HostEnvironment.EnvironmentName == "Development" ? "test.servis@demo.com" : "")" data-demo-password="@(HostEnvironment.EnvironmentName == "Development" ? "Demo123!" : "")"><i class="bi bi-tools" aria-hidden="true"></i><span>Yetkili Servis</span></button>
                    <button type="button" id="login-personel" role="tab" aria-selected="false" aria-controls="login-panel" tabindex="-1" data-login-mode="personel" data-demo-user="@(HostEnvironment.EnvironmentName == "Development" ? "test.personel@demo.com" : "")" data-demo-password="@(HostEnvironment.EnvironmentName == "Development" ? "Demo123!" : "")"><i class="bi bi-person-badge" aria-hidden="true"></i><span>Personel</span></button>
                </div>
                <div id="login-panel" role="tabpanel" aria-labelledby="login-firma">
                <form method="post" action="/giris" id="login-form">
                    @Html.AntiForgeryToken()
                    <div class="login-field"><label for="kullanici-adi">VKN veya E-posta</label><input id="kullanici-adi" type="text" name="kullaniciAdi" placeholder="VKN veya e-posta adresiniz" autocomplete="username" required /></div>
                    <div class="login-field"><label for="sifre">Şifre</label><input id="sifre" type="password" name="sifre" placeholder="Şifreniz" autocomplete="current-password" required /></div>
                    <button type="submit" class="login-submit">Giriş Yap</button>
                </form>
                <a class="login-link" href="/giris/sifre-unuttum">Şifremi unuttum</a>
                </div>

                @if (HostEnvironment.EnvironmentName == "Development")
                {
                <details class="demo-logins">
                    <summary>Geliştirme kullanıcıları</summary>
                    <div class="demo-logins-body">
                        @foreach (var demo in new[]
                        {
                            new { Rol = "Genel Sistem Admini", Eposta = "test.geneladmin@demo.com" },
                            new { Rol = "Şirket Admini", Eposta = "test.sirketadmin@demo.com" },
                            new { Rol = "Personel", Eposta = "test.personel@demo.com" },
                            new { Rol = "Yetkili Servis", Eposta = "test.servis@demo.com" },
                            new { Rol = "Sertifikalı Firma", Eposta = "test.sertifikalifirma@demo.com" }
                        })
                        {
                            <button type="button" class="demo-login-btn" data-demo-user="@demo.Eposta" data-demo-password="Demo123!">
                                <span><span class="demo-login-role">@demo.Rol</span><span class="demo-login-mail">@demo.Eposta</span></span>
                                <span class="demo-login-pass">Seç</span>
                            </button>
                        }
                    </div>
                </details>
                }
            }

            <div class="login-registration" hidden="@(!smsBekleniyor && !sifreUnuttum && !sifreSifirlaKodBekleniyor)">
                <a class="login-register" href="/kayit/yetkili-servis">Yetkili Servis Kaydı</a>
            </div>
        </div>
    </section>
</main>

<script src="~/js/login-flow.js" asp-append-version="true"></script>
