@model YetkiliServisGazAcma.Entities.Ys_DevreyeAlma
@{
    ViewData["Title"] = "Devreye Alma Detayı";
    ViewData["PanelTitle"] = "Devreye Alma Detayı";
    ViewData["PanelSubtitle"] = "Yetkili Servis";
    ViewData["ActiveMenu"] = "DevreyeGecmis";
    ViewData["PanelArea"] = "YetkiliServis";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var marka = Model.Marka?.MarkaAdi ?? Model.CihazMarka;
    var firma = Model.Firma?.FirmaAdi;
    var musteriBasligi = !string.IsNullOrWhiteSpace(Model.MusteriAdi)
        ? System.Net.WebUtility.HtmlDecode(Model.MusteriAdi)
        : $"Devreye Alma Kaydı #{Model.Id}";
    var durumClass = Model.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi
        ? "df-pill-success"
        : Model.Durum == DevreyeAlmaDurumDegerleri.Iptal
            ? "df-pill-danger"
            : "df-pill-warning";
    var durumYazi = Model.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi
        ? "Tamamlandı"
        : Model.Durum == DevreyeAlmaDurumDegerleri.Iptal
            ? "İptal"
            : "Bekliyor";
}

@functions {
    private static string Deger(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : System.Net.WebUtility.HtmlDecode(value);
    }

    private static bool Var(string? value)
    {
        return !string.IsNullOrWhiteSpace(value) && value.Trim() != "-";
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ys-operations.css" asp-append-version="true" />
}

<div class="ys-workspace ys-detail-page">
    <header class="ys-page-header">
        <div class="ys-page-heading">
            <span class="ys-page-icon"><i class="bi bi-clipboard2-check" aria-hidden="true"></i></span>
            <div class="ys-page-copy">
                <h1>@musteriBasligi</h1>
                <p>Devreye Alma Kaydı #@Model.Id <span aria-hidden="true">·</span> Tesisat @Deger(Model.TesistatNo) <span aria-hidden="true">·</span> @Deger(firma)</p>
            </div>
        </div>
        <div class="ys-page-actions">
            <a class="df-btn df-btn-secondary df-btn-sm" href="/ys-devreyeal/gecmis">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Geçmişe Dön
            </a>
            <a class="df-btn ys-export-pdf df-btn-sm" href="/ys-devreyeal/pdf/@Model.Id" target="_blank" rel="noopener">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF
            </a>
            <a class="df-btn ys-export-excel df-btn-sm" href="/ys-devreyeal/excel/@Model.Id" target="_blank" rel="noopener">
                <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel
            </a>
        </div>
    </header>

    <div class="ys-summary-strip" aria-label="Devreye alma özeti">
        <div class="ys-summary-item @(Model.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "is-success" : "is-warning")">
            <span class="ys-summary-icon"><i class="bi bi-activity" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong><span class="df-pill @durumClass">@durumYazi</span></strong><span>İşlem Durumu</span></span>
        </div>
        <div class="ys-summary-item is-info">
            <span class="ys-summary-icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong>@Model.DevreyeAlmaTarihi.ToString("dd.MM.yyyy")</strong><span>Devreye Alma Tarihi</span></span>
        </div>
        <div class="ys-summary-item">
            <span class="ys-summary-icon"><i class="bi bi-fire" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong>@Deger(Model.CihazTipi) / @Deger(marka)</strong><span>Cihaz</span></span>
        </div>
        <div class="ys-summary-item is-success">
            <span class="ys-summary-icon"><i class="bi bi-person-gear" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong>@Deger(Model.TeknisyenAdi)</strong><span>Teknisyen</span></span>
        </div>
    </div>

    <div class="ys-detail-grid">
        <section class="ys-panel is-blue">
            <div class="ys-panel-head">
                <div class="ys-panel-heading">
                    <span class="ys-section-icon"><i class="bi bi-house-check" aria-hidden="true"></i></span>
                    <div>
                        <h2 class="ys-panel-title">Tesisat ve Müşteri</h2>
                    </div>
                </div>
            </div>
            <div class="ys-panel-body">
                <dl class="ys-detail-facts">
                    <div><dt>Tesisat No</dt><dd>@Deger(Model.TesistatNo)</dd></div>
                    @if (Var(Model.AboneNo))
                    {
                        <div><dt>Servis Cari Kod</dt><dd>@Deger(Model.AboneNo)</dd></div>
                    }
                    <div><dt>Müşteri</dt><dd>@Deger(Model.MusteriAdi)</dd></div>
                    @if (Var(Model.MusteriTelefon))
                    {
                        <div><dt>Telefon</dt><dd>@Deger(Model.MusteriTelefon)</dd></div>
                    }
                    @if (Var(Model.MusteriTcNo))
                    {
                        <div><dt>TC Kimlik No</dt><dd>@Deger(Model.MusteriTcNo)</dd></div>
                    }
                    @if (Var(Model.UygunlukBelgeNo))
                    {
                        <div><dt>Uygunluk Belgesi</dt><dd>@Deger(Model.UygunlukBelgeNo)</dd></div>
                    }
                    @if (Model.UygunlukTarihi.HasValue)
                    {
                        <div><dt>Uygunluk Tarihi</dt><dd>@Model.UygunlukTarihi.Value.ToString("dd.MM.yyyy")</dd></div>
                    }
                    @if (Var(Model.Adres))
                    {
                        <div class="is-wide"><dt>Adres</dt><dd>@Deger(Model.Adres)</dd></div>
                    }
                </dl>
            </div>
        </section>

        <section class="ys-panel is-green">
            <div class="ys-panel-head">
                <div class="ys-panel-heading">
                    <span class="ys-section-icon"><i class="bi bi-tools" aria-hidden="true"></i></span>
                    <div>
                        <h2 class="ys-panel-title">Cihaz ve Teknisyen</h2>
                    </div>
                </div>
            </div>
            <div class="ys-panel-body">
                <dl class="ys-detail-facts">
                    <div><dt>Cihaz Tipi</dt><dd>@Deger(Model.CihazTipi)</dd></div>
                    <div><dt>Marka</dt><dd>@Deger(marka)</dd></div>
                    @if (Var(Model.CihazModeli))
                    {
                        <div class="is-wide"><dt>Model</dt><dd>@Deger(Model.CihazModeli)</dd></div>
                    }
                    @if (Var(Model.CihazKapasite))
                    {
                        <div><dt>Kapasite</dt><dd>@Deger(Model.CihazKapasite)</dd></div>
                    }
                    @if (Var(Model.SeriNo))
                    {
                        <div><dt>Seri No</dt><dd>@Deger(Model.SeriNo)</dd></div>
                    }
                    <div><dt>Teknisyen</dt><dd>@Deger(Model.TeknisyenAdi)</dd></div>
                    @if (Var(Model.TeknisyenYetkiBelgesiNo))
                    {
                        <div><dt>Yetki Belgesi No</dt><dd>@Deger(Model.TeknisyenYetkiBelgesiNo)</dd></div>
                    }
                    <div><dt>Kayıt Tarihi</dt><dd>@Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</dd></div>
                </dl>
            </div>
        </section>
    </div>

    @if (Var(Model.Notlar))
    {
        <section class="ys-note-panel" aria-label="İşlem notu">
            <span class="ys-section-icon"><i class="bi bi-chat-left-text" aria-hidden="true"></i></span>
            <div><strong>İşlem Notu</strong><p>@Model.Notlar</p></div>
        </section>
    }
</div>
