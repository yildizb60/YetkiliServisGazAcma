@{
    ViewData["Title"] = "Cihaz Devreye Al";
    Layout = "_PanelLayout";
    ViewData["ActiveMenu"] = "DevreyeAl";
    ViewData["PanelArea"] = "YetkiliServis";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ys-operations.css" asp-append-version="true" />
}

<div class="ys-workspace ys-commissioning-workspace">
    <header class="ys-page-header">
        <div class="ys-page-heading">
            <span class="ys-page-icon"><i class="bi bi-wrench-adjustable-circle" aria-hidden="true"></i></span>
            <div class="ys-page-copy">
                <h1>Cihaz Devreye Alma</h1>
                <p>Tesisatı doğrulayın, servisten gelen cihazı seçin ve devreye alma kaydını tamamlayın.</p>
            </div>
        </div>
        <div class="ys-page-actions">
            <a class="df-btn df-btn-secondary df-btn-sm" href="/ys-devreyeal/gecmis">
                <i class="bi bi-clock-history" aria-hidden="true"></i> İşlem Geçmişim
            </a>
        </div>
    </header>

    @if (TempData["Hata"] != null)
    {
        <div class="ys-alert is-danger"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@TempData["Hata"]</div>
    }

    <nav class="ys-stepper" aria-label="Devreye alma adımları">
        <div class="ys-step aktif" id="adim1">
            <span class="ys-step-number">1</span>
            <span>Tesisat ve Cihaz</span>
        </div>
        <span class="ys-step-line" id="cizgi1"></span>
        <div class="ys-step" id="adim2">
            <span class="ys-step-number">2</span>
            <span>Devreye Alma Bilgileri</span>
        </div>
        <span class="ys-step-line" id="cizgi2"></span>
        <div class="ys-step" id="adim3">
            <span class="ys-step-number">3</span>
            <span>Tamamla</span>
        </div>
    </nav>

    <section class="ys-panel is-blue" aria-labelledby="tesisatSorguBaslik">
        <div class="ys-panel-head">
            <div class="ys-panel-heading">
                <span class="ys-section-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                <div>
                    <h2 class="ys-panel-title" id="tesisatSorguBaslik">Tesisatı Sorgulayın</h2>
                    <p class="ys-panel-subtitle">Tesisat ve sözleşme numarası birlikte doğrulanır.</p>
                </div>
            </div>
        </div>
        <div class="ys-panel-body">
            <div class="ys-query-grid">
                <div class="ys-field">
                    <label for="tesistatNo">Tesisat Numarası</label>
                    <input type="text" id="tesistatNo" inputmode="numeric" placeholder="Tesisat numarasını girin" />
                </div>
                <div class="ys-field">
                    <label for="sozlesmeNo">Sözleşme Numarası</label>
                    <input type="text" id="sozlesmeNo" inputmode="numeric" placeholder="Sözleşme numarasını girin" />
                </div>
                <button type="button" class="df-btn df-btn-primary" onclick="tesistatSorgula()">
                    <i class="bi bi-search" aria-hidden="true"></i> Sorgula
                </button>
            </div>
            <div class="ys-loading" id="sorgulaLoading" role="status">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Tesisat bilgileri alınıyor...
            </div>
        </div>
    </section>

    <section class="ys-panel is-cyan ys-hidden-panel" id="musteriBilgiKart" aria-labelledby="tesisatSonucBaslik">
        <div class="ys-panel-head">
            <div class="ys-panel-heading">
                <span class="ys-section-icon"><i class="bi bi-house-check" aria-hidden="true"></i></span>
                <div>
                    <h2 class="ys-panel-title" id="tesisatSonucBaslik">Tesisat ve Cihaz Bilgileri</h2>
                    <p class="ys-panel-subtitle">Doğrulanan bilgiler değiştirilemez; işleme alınacak cihazı seçin.</p>
                </div>
            </div>
            <span class="df-pill df-pill-success" id="b-durum"></span>
        </div>
        <div class="ys-panel-body ys-result-layout">
            <dl class="ys-fact-grid">
                <div class="ys-fact"><dt>Müşteri</dt><dd id="b-musteriAdi"></dd></div>
                <div class="ys-fact"><dt>Telefon</dt><dd id="b-musteriTelefon"></dd></div>
                <div class="ys-fact"><dt>Servis Cari Kod</dt><dd id="b-aboneNo"></dd></div>
                <div class="ys-fact"><dt>Sözleşme No</dt><dd id="b-sozlesmeNo"></dd></div>
                <div class="ys-fact"><dt>Sayaç No</dt><dd id="b-sayacNo"></dd></div>
                <div class="ys-fact is-wide"><dt>Adres</dt><dd id="b-adres"></dd></div>
            </dl>
            <div class="ys-device-picker">
                <h3>Servisten Gelen Cihazlar</h3>
                <p>Devreye alınacak cihazı seçin.</p>
                <div class="ys-device-list" id="b-cihazlar"></div>
            </div>
        </div>
    </section>

    <section class="ys-panel is-green ys-hidden-panel" id="formKart" aria-labelledby="devreyeFormBaslik">
        <div class="ys-panel-head">
            <div class="ys-panel-heading">
                <span class="ys-section-icon"><i class="bi bi-clipboard2-check" aria-hidden="true"></i></span>
                <div>
                    <h2 class="ys-panel-title" id="devreyeFormBaslik">Devreye Alma Bilgileri</h2>
                    <p class="ys-panel-subtitle">Seçilen cihaza ait model, seri ve teknisyen bilgilerini tamamlayın.</p>
                </div>
            </div>
        </div>
        <div class="ys-panel-body">
            <form method="post" action="/ys-devreyeal/kaydet" id="devreyeAlmaForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TesistatNo" id="f-tesistatNo" />
                <input type="hidden" name="AboneNo" id="f-aboneNo" />
                <input type="hidden" name="UygunlukBelgeNo" id="f-uygunlukBelgeNo" />
                <input type="hidden" name="UygunlukTarihi" id="f-uygunlukTarihi" />
                <input type="hidden" name="MusteriAdi" id="f-musteriAdi" />
                <input type="hidden" name="MusteriTcNo" id="f-musteriTcNo" />
                <input type="hidden" name="MusteriTelefon" id="f-musteriTelefon" />
                <input type="hidden" name="Adres" id="f-adres" />
                <input type="hidden" name="MarkaId" id="f-markaid" />
                <input type="hidden" name="CihazMarka" id="f-cihazMarka" />

                <div class="ys-form-grid is-three-column">
                    <div class="ys-field">
                        <label for="cihazTipi">Cihaz Tipi *</label>
                        <select name="CihazTipi" id="cihazTipi" required>
                            <option value="">Seçiniz</option>
                            <option value="Kombi">Kombi</option>
                            <option value="Şofben">Şofben</option>
                            <option value="Ocak">Ocak</option>
                            <option value="Firin">Fırın</option>
                            <option value="Kazan">Kazan</option>
                            <option value="Diger">Diğer</option>
                        </select>
                    </div>
                    <div class="ys-field"><label for="cihazModeli">Cihaz Modeli *</label><input type="text" name="CihazModeli" id="cihazModeli" placeholder="Cihaz modeli" required /></div>
                    <div class="ys-field"><label for="seriNo">Seri No *</label><input type="text" name="SeriNo" id="seriNo" placeholder="Seri numarası" required /></div>
                    <div class="ys-field"><label for="cihazKapasite">Kapasite (kcal/h)</label><input type="text" name="CihazKapasite" id="cihazKapasite" placeholder="Örn. 24000" /></div>
                    <div class="ys-field"><label for="teknisyenAdi">Teknisyen Adı Soyadı *</label><input type="text" name="TeknisyenAdi" id="teknisyenAdi" placeholder="Ad soyad" required /></div>
                    <div class="ys-field"><label for="teknisyenBelgeNo">Teknisyen Yetki Belgesi No *</label><input type="text" name="TeknisyenYetkiBelgesiNo" id="teknisyenBelgeNo" placeholder="Yetki belgesi numarası" required /></div>
                    <div class="ys-field is-wide"><label for="notlar">Notlar</label><input type="text" name="Notlar" id="notlar" placeholder="İşleme ilişkin gerekli not" /></div>
                </div>

                <div class="ys-actions" style="margin-top:12px">
                    <a class="df-btn df-btn-secondary" href="/ys-panel"><i class="bi bi-x-lg" aria-hidden="true"></i> Vazgeç</a>
                    <button type="submit" class="df-btn df-btn-success" id="btnKKaydet"><i class="bi bi-check2-circle" aria-hidden="true"></i> Devreye Almayı Tamamla</button>
                </div>
            </form>
        </div>
    </section>
</div>

<script>
    let seciliMarkaId = 0;
    let seciliMarkaAdi = "";
    let servisCihazlari = [];
    let seciliServisCihazIndex = -1;

    function setAdim(aktif) {
        for (let i = 1; i <= 3; i++) {
            const adim = document.getElementById("adim" + i);
            if (!adim) continue;
            adim.classList.remove("aktif", "tamamlandi");
            if (i < aktif) adim.classList.add("tamamlandi");
            if (i === aktif) adim.classList.add("aktif");
        }
        for (let i = 1; i <= 2; i++) {
            const cizgi = document.getElementById("cizgi" + i);
            if (cizgi) cizgi.classList.toggle("tamamlandi", i < aktif);
        }
    }

    function alanaGit(element) {
        if (!element) return;
        window.requestAnimationFrame(function () {
            const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            element.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
        });
    }

    function temizleSonrakiAdimlar() {
        document.getElementById("musteriBilgiKart")?.classList.remove("goster");
        document.getElementById("formKart")?.classList.remove("goster");
        seciliMarkaId = 0;
        seciliMarkaAdi = "";
        servisCihazlari = [];
        seciliServisCihazIndex = -1;
        document.querySelectorAll(".ys-device-option").forEach(x => x.classList.remove("secili"));
        setAdim(1);
    }

    function cihazAlanlariniTemizle() {
        const tipSelect = document.querySelector('select[name="CihazTipi"]');
        const kapasiteInput = document.querySelector('input[name="CihazKapasite"]');
        const modelInput = document.querySelector('input[name="CihazModeli"]');
        if (tipSelect) tipSelect.value = "";
        if (kapasiteInput) kapasiteInput.value = "";
        if (modelInput) modelInput.value = "";
        const cihazMarka = document.getElementById("f-cihazMarka");
        if (cihazMarka) cihazMarka.value = "";
    }

    function secimleriTemizle() {
        seciliMarkaId = 0;
        seciliMarkaAdi = "";
        seciliServisCihazIndex = -1;
        document.getElementById("f-markaid").value = "";
        document.getElementById("f-cihazMarka").value = "";
        document.querySelectorAll(".ys-device-option").forEach(x => x.classList.remove("secili"));
        cihazAlanlariniTemizle();
        document.getElementById("formKart")?.classList.remove("goster");
        setAdim(1);
    }

    async function tesistatSorgula() {
        const tesisatNoInput = document.getElementById("tesistatNo");
        const sozlesmeNoInput = document.getElementById("sozlesmeNo");
        const loading = document.getElementById("sorgulaLoading");
        const tesisatNo = (tesisatNoInput?.value || "").trim();
        const sozlesmeNo = (sozlesmeNoInput?.value || "").trim();

        if (!tesisatNo) { alert("Lütfen tesisat numarası giriniz."); tesisatNoInput?.focus(); return; }
        if (!sozlesmeNo) { alert("Lütfen sözleşme numarası giriniz."); sozlesmeNoInput?.focus(); return; }

        temizleSonrakiAdimlar();
        loading?.classList.add("goster");
        try {
            const response = await fetch("/ys-devreyeal/tesisat-sorgula", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ tesistatNo: tesisatNo, sozlesmeNo: sozlesmeNo })
            });
            if (!response.ok) { alert("Sorgu sırasında bir hata oluştu."); return; }

            const data = await response.json();
            if (!data.basarili) { alert(data.mesaj || "Tesisat sorgulaması başarısız."); return; }

            document.getElementById("b-musteriAdi").textContent = data.musteriAdi || "-";
            document.getElementById("b-musteriTelefon").textContent = data.musteriTelefon || "-";
            document.getElementById("b-aboneNo").textContent = data.aboneNo || "-";
            document.getElementById("b-sozlesmeNo").textContent = data.sozlesmeNo || sozlesmeNo || "-";
            document.getElementById("b-sayacNo").textContent = data.sayacNo || "-";
            document.getElementById("b-adres").textContent = data.adres || "-";
            document.getElementById("b-durum").textContent = data.durum || "Tesisat bulundu";

            const cihazlar = Array.isArray(data.cihazlar) ? data.cihazlar : [];
            servisCihazlari = cihazlar;
            const cihazListesi = document.getElementById("b-cihazlar");
            if (cihazListesi) {
                cihazListesi.innerHTML = "";
                if (cihazlar.length === 0) {
                    cihazListesi.textContent = "Cihaz bilgisi bulunamadı.";
                } else {
                    cihazlar.forEach(function (cihaz, index) {
                        const satir = document.createElement("div");
                        satir.className = "ys-device-option";
                        satir.setAttribute("role", "button");
                        satir.setAttribute("tabindex", "0");
                        satir.textContent = (cihaz.cihazMarka || "-") + " / " + (cihaz.cihazTipi || "-") + " / " + (cihaz.cihazKapasite || "-") + " kcal/h";
                        satir.addEventListener("click", function () { cihazSec(index); });
                        satir.addEventListener("keydown", function (event) {
                            if (event.key === "Enter" || event.key === " ") { event.preventDefault(); cihazSec(index); }
                        });
                        cihazListesi.appendChild(satir);
                    });
                }
            }

            document.getElementById("f-tesistatNo").value = data.tesistatNo || "";
            document.getElementById("f-aboneNo").value = data.aboneNo || data.sozlesmeNo || "";
            document.getElementById("f-uygunlukBelgeNo").value = "";
            document.getElementById("f-uygunlukTarihi").value = "";
            document.getElementById("f-musteriAdi").value = data.musteriAdi || "";
            document.getElementById("f-musteriTcNo").value = data.musteriTcNo || data.aboneNo || "";
            document.getElementById("f-musteriTelefon").value = data.musteriTelefon || "";
            document.getElementById("f-adres").value = data.adres || "";

            const sonuc = document.getElementById("musteriBilgiKart");
            sonuc?.classList.add("goster");
            setAdim(1);
            alanaGit(sonuc);
        } catch {
            alert("Bağlantı hatası oluştu. Lütfen tekrar deneyiniz.");
        } finally {
            loading?.classList.remove("goster");
        }
    }

    async function cihazSec(index) {
        const cihaz = servisCihazlari[index];
        if (!cihaz) return;
        if (seciliServisCihazIndex === index) { secimleriTemizle(); return; }

        seciliServisCihazIndex = index;
        document.querySelectorAll(".ys-device-option").forEach(function (satir, satirIndex) {
            satir.classList.toggle("secili", satirIndex === index);
        });

        const tipSelect = document.querySelector('select[name="CihazTipi"]');
        if (tipSelect && cihaz.cihazTipi) {
            const secenek = Array.from(tipSelect.options).find(option => option.value.toLocaleLowerCase("tr-TR") === cihaz.cihazTipi.toLocaleLowerCase("tr-TR"));
            if (secenek) tipSelect.value = secenek.value;
        }
        const kapasiteInput = document.querySelector('input[name="CihazKapasite"]');
        if (kapasiteInput) kapasiteInput.value = cihaz.cihazKapasite || "";
        const modelInput = document.querySelector('input[name="CihazModeli"]');
        if (modelInput && cihaz.cihazModeli) modelInput.value = cihaz.cihazModeli;
        document.getElementById("f-cihazMarka").value = cihaz.cihazMarka || "";
        await markaKontrolEt(cihaz);
    }

    async function markaKontrolEt(cihaz) {
        const tesistatNo = (document.getElementById("f-tesistatNo")?.value || "").trim();
        if (!tesistatNo) { alert("Önce tesisat sorgulaması yapınız."); return; }

        try {
            const response = await fetch("/ys-devreyeal/marka-kontrol", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ cihazMarka: cihaz?.cihazMarka || "" })
            });
            if (!response.ok) { alert("Marka kontrolü sırasında hata oluştu."); return; }

            const data = await response.json();
            if (!data.yetkili) { secimleriTemizle(); alert(data.mesaj || "Bu marka için yetkiniz bulunmamaktadır."); return; }

            seciliMarkaId = data.markaId || 0;
            seciliMarkaAdi = data.markaAdi || cihaz?.cihazMarka || "";
            document.getElementById("f-markaid").value = String(seciliMarkaId);
            document.getElementById("f-cihazMarka").value = seciliMarkaAdi;
            const formKart = document.getElementById("formKart");
            formKart?.classList.add("goster");
            setAdim(2);
            alanaGit(formKart);
            window.setTimeout(function () {
                document.getElementById("cihazModeli")?.focus({ preventScroll: false });
            }, 180);
        } catch {
            alert("Bağlantı hatası oluştu. Lütfen tekrar deneyiniz.");
        }
    }

    document.getElementById("devreyeAlmaForm")?.addEventListener("submit", function (event) {
        if (!document.getElementById("f-tesistatNo").value) { event.preventDefault(); alert("Önce tesisat sorgulaması yapınız."); return; }
        if (!document.getElementById("f-markaid").value || !document.getElementById("f-cihazMarka").value) {
            event.preventDefault();
            alert("Lütfen servisten gelen cihazlardan birini seçiniz.");
            return;
        }
        setAdim(3);
    });
</script>
