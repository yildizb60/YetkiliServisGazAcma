@{
    ViewData["Title"] = "Yeni Cihaz Devreye Alma Kaydı";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelModule"] = "Cihaz Devreye Alma";
    ViewData["ContentClass"] = "ys-commissioning-content";
    Layout = "_PanelLayout";
    ViewData["ActiveMenu"] = "DevreyeAl";
    ViewData["PanelArea"] = "YetkiliServis";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ys-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ykc-request.css" asp-append-version="true" />
}

<div class="ykc-request ys-commissioning-request">
    <form method="post" action="@Url.Action("Kaydet", "DevreyeAlma")" id="devreyeAlmaForm" class="ykc-request-workspace">
        @Html.AntiForgeryToken()
        <input type="hidden" name="TesistatNo" id="f-tesistatNo" />
        <input type="hidden" name="AboneNo" id="f-aboneNo" />
        <input type="hidden" name="UygunlukBelgeNo" id="f-uygunlukBelgeNo" />
        <input type="hidden" name="UygunlukTarihi" id="f-uygunlukTarihi" />
        <input type="hidden" name="MusteriAdi" id="f-musteriAdi" />
        <input type="hidden" name="MusteriTcNo" id="f-musteriTcNo" />
        <input type="hidden" name="MusteriTelefon" id="f-musteriTelefon" />
        <input type="hidden" name="Adres" id="f-adres" />
        <input type="hidden" name="MarkaId" id="f-markaid" />
        <input type="hidden" name="CihazMarka" id="f-cihazMarka" />

        <section class="ykc-request-section ykc-request-lookup" aria-labelledby="ys-query-title">
            <header class="ykc-request-section-head">
                <div><span class="ykc-request-section-icon"><i class="bi bi-house-check" aria-hidden="true"></i></span><h2 id="ys-query-title">Tesisat Sorgusu</h2></div>
                <span class="ykc-query-status" id="sorgulaLoading" role="status" hidden><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Tesisat bilgileri alınıyor</span>
            </header>
            <div class="ykc-request-query">
                <div class="ykc-request-query-fields">
                    <div class="ykc-field"><label for="tesistatNo">Tesisat No</label><input type="text" id="tesistatNo" inputmode="numeric" autocomplete="off" placeholder="Tesisat numarası" /></div>
                    <div class="ykc-field"><label for="sozlesmeNo">Sözleşme No</label><input type="text" id="sozlesmeNo" inputmode="numeric" autocomplete="off" placeholder="Sözleşme numarası" /></div>
                    <button type="button" class="df-btn df-btn-primary" id="ysInstallationQueryButton"><i class="bi bi-search" aria-hidden="true"></i> Tesisatı Sorgula</button>
                </div>
            </div>
        </section>

        <div id="ysCommissioningPending" class="ykc-request-pending">
            <span><i class="bi bi-house-dash" aria-hidden="true"></i></span>
            <strong>Tesisat bilgisi bekleniyor</strong>
        </div>

        <fieldset id="musteriBilgiKart" class="ykc-request-section ykc-request-device ys-commissioning-result" hidden disabled>
            <legend class="visually-hidden">Devreye alma kayıt bilgileri</legend>
            <div class="ykc-device-entry-layout">
                <section class="ykc-source-device" aria-labelledby="ys-source-title">
                    <header><div><span class="ykc-request-section-icon"><i class="bi bi-person-vcard" aria-hidden="true"></i></span><h2 id="ys-source-title">Müşteri ve Tesisat</h2></div><span class="ys-source-status" id="b-durum" role="status"></span></header>
                    <dl class="ykc-request-customer ys-source-facts">
                        <div><dt>Müşteri Adı</dt><dd id="b-musteriAdi">-</dd></div>
                        <div><dt>Telefon</dt><dd id="b-musteriTelefon">-</dd></div>
                        <div><dt>Sözleşme No</dt><dd id="b-sozlesmeNo">-</dd></div>
                        <div><dt>Sayaç No</dt><dd id="b-sayacNo">-</dd></div>
                        <div class="is-wide"><dt>Adres</dt><dd id="b-adres">-</dd></div>
                    </dl>
                    <div class="ys-commissioning-device-picker">
                        <h3><i class="bi bi-fire" aria-hidden="true"></i> Projedeki Cihazlar</h3>
                        <div class="ys-commissioning-device-list" id="b-cihazlar"></div>
                    </div>
                </section>

                <section class="ykc-new-device" aria-labelledby="ys-entry-title">
                    <header><div><span class="ykc-request-section-icon is-green"><i class="bi bi-clipboard2-check" aria-hidden="true"></i></span><h2 id="ys-entry-title">Devreye Alma Bilgileri</h2></div></header>
                    <div id="ysDevicePending" class="ys-device-entry-pending" aria-live="polite" aria-atomic="true"><i class="bi bi-hand-index-thumb" aria-hidden="true"></i><span><strong>Projedeki cihazı seçin</strong><small>Seçimin ardından kayıt alanları burada açılır.</small></span></div>
                    <div id="ysDeviceWorkCards" class="ys-device-work-cards" aria-live="polite"></div>
                    <fieldset id="formKart" class="ys-commissioning-form" hidden disabled>
                        <legend class="visually-hidden">Cihaz ve teknisyen bilgileri</legend>
                        <div class="ys-commissioning-form-grid">
                            <div class="ykc-field"><label for="cihazTipi">Cihaz Tipi *</label><select name="CihazTipi" id="cihazTipi" required><option value="">Seçiniz</option><option value="Kombi">Kombi</option><option value="Şofben">Şofben</option><option value="Ocak">Ocak</option><option value="Firin">Fırın</option><option value="Kazan">Kazan</option><option value="Diger">Diğer</option></select></div>
                            <div class="ykc-field"><label for="cihazModeli">Cihaz Modeli *</label><input type="text" name="CihazModeli" id="cihazModeli" placeholder="Cihaz modeli" required /></div>
                            <div class="ykc-field"><label for="seriNo">Seri No *</label><input type="text" name="SeriNo" id="seriNo" placeholder="Seri numarası" required /></div>
                            <div class="ykc-field"><label for="cihazKapasite">Kapasite (kcal/h)</label><input type="text" name="CihazKapasite" id="cihazKapasite" placeholder="Örn. 24000" /></div>
                            <div class="ykc-field"><label for="teknisyenAdi">Teknisyen Adı Soyadı *</label><input type="text" name="TeknisyenAdi" id="teknisyenAdi" placeholder="Ad soyad" required /></div>
                            <div class="ykc-field"><label for="teknisyenBelgeNo">Teknisyen Yetki Belgesi No *</label><input type="text" name="TeknisyenYetkiBelgesiNo" id="teknisyenBelgeNo" placeholder="Belge numarası" required /></div>
                            <div class="ykc-field is-wide"><label for="notlar">Notlar</label><textarea name="Notlar" id="notlar" placeholder="İşleme ilişkin gerekli not"></textarea></div>
                        </div>
                        <div class="ykc-request-completion ys-commissioning-actions">
                            <span class="ys-selected-device" id="ysSelectedDevice"><i class="bi bi-check2-circle" aria-hidden="true"></i><span>Seçilen cihaz doğrulandı</span></span>
                            <footer class="ykc-request-footer"><button type="submit" class="df-btn df-btn-success" id="btnKKaydet"><i class="bi bi-check2-circle" aria-hidden="true"></i> Devreye Almayı Tamamla</button></footer>
                        </div>
                    </fieldset>
                </section>
            </div>
        </fieldset>
    </form>
</div>

@section Scripts {
<script>
    const antiForgeryToken = document.querySelector('#devreyeAlmaForm input[name="__RequestVerificationToken"]')?.value || "";
    let servisCihazlari = [];
    let seciliServisCihazIndex = -1;
    let markaKontrolSirasi = 0;
    const cihazTaslaklari = new Map();
    const cihazKontrolBekleyen = new Set();
    const formKart = document.getElementById("formKart");
    const cihazKartlari = document.getElementById("ysDeviceWorkCards");
    const cihazAlanlari = ["CihazTipi", "CihazModeli", "SeriNo", "CihazKapasite", "TeknisyenAdi", "TeknisyenYetkiBelgesiNo", "Notlar"];

    const islemHatasi = (mesaj, alan) => {
        window.operationToast?.error(mesaj, 6000);
        alan?.focus();
    };

    function alanaGit(element) {
        if (!element) return;
        window.requestAnimationFrame(function () {
            const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            element.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
        });
    }

    function temizleSonrakiAdimlar() {
        markaKontrolSirasi++;
        const sonuc = document.getElementById("musteriBilgiKart");
        if (sonuc) { sonuc.hidden = true; sonuc.disabled = true; }
        document.getElementById("ysCommissioningPending").hidden = false;
        document.getElementById("ysDevicePending").hidden = false;
        cihazKartlari.after(formKart);
        cihazKartlari.replaceChildren();
        formKart.hidden = true;
        formKart.disabled = true;
        document.getElementById("f-markaid").value = "";
        document.getElementById("f-cihazMarka").value = "";
        servisCihazlari = [];
        seciliServisCihazIndex = -1;
        cihazTaslaklari.clear();
        cihazKontrolBekleyen.clear();
        cihazUyarisiSifirla();
    }

    function cihazUyarisiSifirla() {
        const pending = document.getElementById("ysDevicePending");
        pending.classList.remove("is-warning");
        pending.querySelector("i").className = "bi bi-hand-index-thumb";
        pending.querySelector("strong").textContent = "Projedeki cihazı seçin";
        pending.querySelector("small").textContent = "Seçimin ardından kayıt alanları burada açılır.";
        document.querySelectorAll(".ys-commissioning-device-option.is-unavailable").forEach(button => button.classList.remove("is-unavailable"));
    }

    function cihazUyarisiGoster(index, mesaj) {
        if (cihazTaslaklari.size === 0) {
            const pending = document.getElementById("ysDevicePending");
            pending.classList.add("is-warning");
            pending.querySelector("i").className = "bi bi-exclamation-triangle";
            pending.querySelector("strong").textContent = "Bu cihazla devam edilemiyor";
            pending.querySelector("small").textContent = mesaj;
        } else {
            window.operationToast?.error(mesaj, 6000);
        }
        document.querySelectorAll(".ys-commissioning-device-option")[index]?.classList.add("is-unavailable");
    }

    function aktifTaslagiSakla() {
        const taslak = cihazTaslaklari.get(seciliServisCihazIndex);
        if (!taslak || taslak.kayitId || formKart.hidden) return;
        cihazAlanlari.forEach(alan => {
            taslak.alanlar[alan] = formKart.querySelector(`[name="${alan}"]`)?.value || "";
        });
    }

    function cihazKartiniOlustur(index, taslak) {
        const kart = document.createElement("section");
        kart.className = "ys-device-work-card";
        kart.dataset.index = String(index);
        const dugme = document.createElement("button");
        dugme.type = "button";
        dugme.className = "ys-device-work-toggle";
        dugme.setAttribute("aria-expanded", "false");
        const baslik = document.createElement("strong");
        baslik.textContent = `${index + 1}. ${servisCihazlari[index]?.cihazTipi || "Cihaz"} · ${taslak.markaAdi}`;
        const durum = document.createElement("span");
        durum.className = "ys-device-work-state";
        durum.textContent = "Kayıt bilgileri";
        const ok = document.createElement("i");
        ok.className = "bi bi-chevron-down";
        ok.setAttribute("aria-hidden", "true");
        dugme.append(baslik, durum, ok);
        const govde = document.createElement("div");
        govde.className = "ys-device-work-body";
        govde.id = `ys-device-work-${index}`;
        dugme.setAttribute("aria-controls", govde.id);
        dugme.addEventListener("click", () => cihazKartiniAc(index));
        kart.append(dugme, govde);
        const sonrakiKart = Array.from(cihazKartlari.children).find(item => Number(item.dataset.index) > index);
        cihazKartlari.insertBefore(kart, sonrakiKart || null);
        taslak.kart = kart;
        taslak.govde = govde;
        taslak.durum = durum;
    }

    function cihazKartiniAc(index) {
        const taslak = cihazTaslaklari.get(index);
        if (!taslak) return;
        aktifTaslagiSakla();
        seciliServisCihazIndex = index;
        cihazKartlari.after(formKart);
        document.querySelectorAll(".ys-device-work-card").forEach(kart => {
            const acik = Number(kart.dataset.index) === index;
            kart.classList.toggle("is-active", acik);
            kart.querySelector(".ys-device-work-toggle")?.setAttribute("aria-expanded", String(acik));
        });
        document.querySelectorAll(".ys-commissioning-device-option").forEach((button, buttonIndex) => {
            button.classList.toggle("is-selected", cihazTaslaklari.has(buttonIndex));
            button.classList.toggle("is-active", buttonIndex === index);
            button.setAttribute("aria-pressed", String(cihazTaslaklari.has(buttonIndex)));
        });
        document.getElementById("ysDevicePending").hidden = true;
        if (taslak.kayitId) {
            formKart.hidden = true;
            formKart.disabled = true;
            const link = document.createElement("a");
            link.className = "df-btn df-btn-secondary df-btn-sm";
            link.href = `/ys-devreyeal/gecmis#devreye-alma-detay-${taslak.kayitId}`;
            link.textContent = "Kaydı Görüntüle";
            taslak.govde.replaceChildren(link);
            return;
        }
        taslak.govde.append(formKart);
        formKart.hidden = false;
        formKart.disabled = false;
        cihazAlanlari.forEach(alan => {
            const input = formKart.querySelector(`[name="${alan}"]`);
            if (input) input.value = taslak.alanlar[alan] || "";
        });
        document.getElementById("f-markaid").value = String(taslak.markaId);
        document.getElementById("f-cihazMarka").value = taslak.markaAdi;
        document.getElementById("ysSelectedDevice").querySelector("span").textContent = `${servisCihazlari[index]?.cihazTipi || "Cihaz"} · ${taslak.markaAdi}`;
    }

    function cihazSeciminiKaldir(index) {
        const taslak = cihazTaslaklari.get(index);
        if (!taslak) return;
        if (taslak.kayitId) {
            window.operationToast?.error("Tamamlanan devreye alma kaydı buradan kaldırılamaz.");
            return;
        }
        if (seciliServisCihazIndex === index) {
            cihazKartlari.after(formKart);
            formKart.hidden = true;
            formKart.disabled = true;
            seciliServisCihazIndex = -1;
        }
        taslak.kart.remove();
        cihazTaslaklari.delete(index);
        const secenek = document.querySelectorAll(".ys-commissioning-device-option")[index];
        secenek?.classList.remove("is-selected", "is-active");
        secenek?.setAttribute("aria-pressed", "false");
        const siradaki = Array.from(cihazTaslaklari.keys()).sort((a, b) => a - b)
            .find(cihazIndex => !cihazTaslaklari.get(cihazIndex).kayitId);
        if (siradaki !== undefined) cihazKartiniAc(siradaki);
        else if (cihazTaslaklari.size > 0) cihazKartiniAc(Math.min(...cihazTaslaklari.keys()));
        else {
            document.getElementById("ysDevicePending").hidden = false;
            cihazUyarisiSifirla();
        }
    }

    async function tesistatSorgula() {
        const tesisatNoInput = document.getElementById("tesistatNo");
        const sozlesmeNoInput = document.getElementById("sozlesmeNo");
        const loading = document.getElementById("sorgulaLoading");
        const tesisatNo = (tesisatNoInput?.value || "").trim();
        const sozlesmeNo = (sozlesmeNoInput?.value || "").trim();

        if (!tesisatNo) { islemHatasi("Tesisat numarası girilmelidir.", tesisatNoInput); return; }
        if (!sozlesmeNo) { islemHatasi("Sözleşme numarası girilmelidir.", sozlesmeNoInput); return; }

        temizleSonrakiAdimlar();
        loading.hidden = false;
        try {
            const response = await fetch("/ys-devreyeal/tesisat-sorgula", {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": antiForgeryToken },
                body: JSON.stringify({ tesistatNo: tesisatNo, sozlesmeNo: sozlesmeNo })
            });
            if (!response.ok) { islemHatasi("Tesisat sorgusu tamamlanamadı.", tesisatNoInput); return; }

            const data = await response.json();
            if (!data.basarili) { islemHatasi(data.mesaj || "Tesisat bulunamadı.", tesisatNoInput); return; }

            document.getElementById("b-musteriAdi").textContent = data.musteriAdi || "-";
            document.getElementById("b-musteriTelefon").textContent = data.musteriTelefon || "-";
            document.getElementById("b-sozlesmeNo").textContent = data.sozlesmeNo || sozlesmeNo || "-";
            document.getElementById("b-sayacNo").textContent = data.sayacNo || "-";
            document.getElementById("b-adres").textContent = data.adres || "-";
            document.getElementById("b-durum").textContent = data.durum || "Tesisat bulundu";

            servisCihazlari = Array.isArray(data.cihazlar) ? data.cihazlar : [];
            const cihazListesi = document.getElementById("b-cihazlar");
            cihazListesi.replaceChildren();
            if (servisCihazlari.length === 0) {
                const empty = document.createElement("p");
                empty.className = "ys-commissioning-device-empty";
                empty.textContent = "Projede cihaz kaydı bulunamadı.";
                cihazListesi.append(empty);
            } else {
                servisCihazlari.forEach(function (cihaz, index) {
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "ys-commissioning-device-option";
                    button.setAttribute("aria-pressed", "false");
                    const title = document.createElement("strong");
                    title.textContent = cihaz.cihazTipi || "Cihaz tipi belirtilmemiş";
                    const detail = document.createElement("span");
                    detail.textContent = [cihaz.cihazMarka, cihaz.cihazModeli, cihaz.cihazKapasite ? cihaz.cihazKapasite + " kcal/h" : null].filter(Boolean).join(" · ") || "Cihaz detayı bulunmuyor";
                    const icon = document.createElement("i");
                    icon.className = "bi bi-chevron-right";
                    icon.setAttribute("aria-hidden", "true");
                    button.append(title, detail, icon);
                    button.addEventListener("click", function () { cihazSec(index); });
                    cihazListesi.append(button);
                });
            }

            document.getElementById("f-tesistatNo").value = data.tesistatNo || "";
            document.getElementById("f-aboneNo").value = data.aboneNo || data.sozlesmeNo || "";
            document.getElementById("f-uygunlukBelgeNo").value = "";
            document.getElementById("f-uygunlukTarihi").value = "";
            document.getElementById("f-musteriAdi").value = data.musteriAdi || "";
            document.getElementById("f-musteriTcNo").value = data.musteriTcNo || "";
            document.getElementById("f-musteriTelefon").value = data.musteriTelefon || "";
            document.getElementById("f-adres").value = data.adres || "";

            const sonuc = document.getElementById("musteriBilgiKart");
            sonuc.hidden = false;
            sonuc.disabled = false;
            document.getElementById("ysCommissioningPending").hidden = true;
            alanaGit(sonuc);
        } catch {
            islemHatasi("Bağlantı kurulamadı. Lütfen yeniden deneyin.", tesisatNoInput);
        } finally {
            loading.hidden = true;
        }
    }

    async function cihazSec(index) {
        const cihaz = servisCihazlari[index];
        if (!cihaz) return;
        if (cihazTaslaklari.has(index)) {
            cihazSeciminiKaldir(index);
            return;
        }
        if (cihazKontrolBekleyen.has(index)) return;

        cihazUyarisiSifirla();
        const kontrolSirasi = markaKontrolSirasi;
        if (!cihaz.cihazMarka?.trim()) {
            cihazUyarisiGoster(index, `${cihaz.cihazTipi || "Cihaz"} marka bilgisi bulunmadığından devreye alma yapamazsınız.`);
            return;
        }
        cihazKontrolBekleyen.add(index);
        try { await markaKontrolEt(cihaz, index, kontrolSirasi); }
        finally { cihazKontrolBekleyen.delete(index); }
    }

    async function markaKontrolEt(cihaz, index, kontrolSirasi) {
        const tesistatNo = (document.getElementById("f-tesistatNo")?.value || "").trim();
        if (!tesistatNo) { islemHatasi("Önce tesisat sorgulaması yapılmalıdır.", document.getElementById("tesistatNo")); return; }
        try {
            const response = await fetch("/ys-devreyeal/marka-kontrol", {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": antiForgeryToken },
                body: JSON.stringify({ cihazMarka: cihaz?.cihazMarka || "" })
            });
            if (kontrolSirasi !== markaKontrolSirasi) return;
            if (!response.ok) { islemHatasi("Marka yetkisi kontrol edilemedi."); return; }
            const data = await response.json();
            if (kontrolSirasi !== markaKontrolSirasi) return;
            if (!data.yetkili) { cihazUyarisiGoster(index, data.mesaj || "Bu marka için firmanızın yetkisi bulunmuyor."); return; }

            const secenek = Array.from(document.getElementById("cihazTipi").options)
                .find(option => option.value.toLocaleLowerCase("tr-TR") === (cihaz.cihazTipi || "").toLocaleLowerCase("tr-TR"));
            const taslak = {
                markaId: data.markaId || 0,
                markaAdi: data.markaAdi || cihaz.cihazMarka || "",
                kayitId: null,
                alanlar: {
                    CihazTipi: secenek?.value || "",
                    CihazModeli: cihaz.cihazModeli || "",
                    SeriNo: "",
                    CihazKapasite: cihaz.cihazKapasite || "",
                    TeknisyenAdi: "",
                    TeknisyenYetkiBelgesiNo: "",
                    Notlar: ""
                }
            };
            cihazTaslaklari.set(index, taslak);
            cihazKartiniOlustur(index, taslak);
            const siradaki = Array.from(cihazTaslaklari.keys()).sort((a, b) => a - b)
                .find(cihazIndex => !cihazTaslaklari.get(cihazIndex).kayitId);
            const acikIndex = seciliServisCihazIndex >= 0 && seciliServisCihazIndex < index
                && !cihazTaslaklari.get(seciliServisCihazIndex)?.kayitId
                    ? seciliServisCihazIndex : siradaki;
            cihazKartiniAc(acikIndex ?? index);
            if (acikIndex === index) document.getElementById("cihazModeli")?.focus({ preventScroll: true });
        } catch {
            if (kontrolSirasi === markaKontrolSirasi) islemHatasi("Bağlantı kurulamadı. Lütfen yeniden deneyin.");
        }
    }

    document.getElementById("ysInstallationQueryButton")?.addEventListener("click", tesistatSorgula);
    document.getElementById("devreyeAlmaForm")?.addEventListener("submit", async function (event) {
        event.preventDefault();
        const taslak = cihazTaslaklari.get(seciliServisCihazIndex);
        if (!taslak || taslak.kayitId) { islemHatasi("Önce devreye alınacak cihazı seçin."); return; }
        const gecersiz = Array.from(formKart.querySelectorAll("input, select, textarea")).find(alan => !alan.checkValidity());
        if (gecersiz) { gecersiz.reportValidity(); return; }
        aktifTaslagiSakla();
        const payload = {};
        new FormData(event.currentTarget).forEach((value, key) => {
            if (key !== "__RequestVerificationToken" && (key !== "UygunlukTarihi" || value)) payload[key] = value;
        });
        payload.MarkaId = Number(payload.MarkaId);
        const kaydet = document.getElementById("btnKKaydet");
        kaydet.disabled = true;
        try {
            const response = await fetch("/ys-devreyeal/kaydet-json", {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": antiForgeryToken },
                body: JSON.stringify(payload)
            });
            if (!response.ok) { islemHatasi("Kayıt tamamlanamadı. Lütfen yeniden deneyin."); return; }
            const data = await response.json();
            if (!data.basarili) { islemHatasi(data.mesaj || "Kayıt tamamlanamadı."); return; }
            taslak.kayitId = data.id;
            taslak.durum.textContent = "Tamamlandı";
            taslak.kart.classList.add("is-completed");
            document.querySelectorAll(".ys-commissioning-device-option")[seciliServisCihazIndex]?.classList.add("is-completed");
            window.operationToast?.success(data.mesaj || "Cihaz devreye alındı.");
            const siradaki = Array.from(cihazTaslaklari.keys()).sort((a, b) => a - b)
                .find(index => !cihazTaslaklari.get(index).kayitId);
            cihazKartiniAc(siradaki ?? seciliServisCihazIndex);
        } catch {
            islemHatasi("Bağlantı kurulamadı. Lütfen yeniden deneyin.");
        } finally {
            kaydet.disabled = false;
        }
    });
</script>
}
