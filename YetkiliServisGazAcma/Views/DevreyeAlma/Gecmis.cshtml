@model List<YetkiliServisGazAcma.Entities.Ys_DevreyeAlma>
@{
    ViewData["Title"] = "Cihaz Devreye Alma Geçmişi";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelModule"] = "Cihaz Devreye Alma";
    Layout = "_PanelLayout";
    ViewData["ActiveMenu"] = "DevreyeGecmis";
    ViewData["PanelArea"] = "YetkiliServis";
    ViewData["DevreyeAlmaAlan"] = "/ys-devreyeal";
    ViewData["DevreyeAlmaColspan"] = 8;
    var markaList = ViewBag.MarkaList as List<string> ?? new List<string>();
    string seciliMarka = ViewBag.SeciliMarka as string ?? "";
    string seciliBas = ViewBag.SeciliBas as string ?? "";
    string seciliBit = ViewBag.SeciliBit as string ?? "";
    string seciliMusteri = ViewBag.SeciliMusteri as string ?? "";
    string seciliTesisat = ViewBag.SeciliTesisat as string ?? "";
    string seciliDurum = ViewBag.SeciliDurum as string ?? "";
    bool filtreAktif = !string.IsNullOrWhiteSpace(seciliMarka)
        || !string.IsNullOrWhiteSpace(seciliBas)
        || !string.IsNullOrWhiteSpace(seciliBit)
        || !string.IsNullOrWhiteSpace(seciliMusteri)
        || !string.IsNullOrWhiteSpace(seciliTesisat)
        || !string.IsNullOrWhiteSpace(seciliDurum);
}

@functions {
    private static string? Secili(bool kosul) => kosul ? "selected" : null;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ykc-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" />
}

<div class="df-admin-workspace df-operations-directory">
    <section class="df-admin-list-card">
        <div class="df-commissioning-history-toolbar">
            <span>@Model.Count kayıt</span>
            <div class="df-export-actions" aria-label="Dışa aktarma işlemleri">
                <button type="button" class="df-btn df-btn-danger df-btn-sm" data-commissioning-bulk-export data-export-url="@Url.Action("RaporlarPdf", "YetkiliServisPanel")" disabled="@(!Model.Any())" title="Listedeki kayıtları PDF olarak indir"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF İndir</button>
                <button type="button" class="df-btn df-btn-success df-btn-sm" data-commissioning-bulk-export data-export-url="@Url.Action("RaporlarExcel", "YetkiliServisPanel")" disabled="@(!Model.Any())" title="Listedeki kayıtları Excel olarak indir"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel İndir</button>
                <a class="df-btn df-btn-primary df-btn-sm" href="@Url.Action("Index", "DevreyeAlma")"><i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Kayıt</a>
            </div>
        </div>

        <details class="df-admin-filter" open="@(filtreAktif ? "open" : null)">
            <summary>
                <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Kayıtları Filtrele</strong></span>
                <span>@(filtreAktif ? "Filtre uygulandı" : "Filtreleri aç") <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
            </summary>
            <div class="df-admin-filter-body">
                <form method="get" action="@Url.Action("Gecmis", "DevreyeAlma")">
                    <div class="df-admin-filter-grid">
                        <div class="df-admin-field"><label for="tesisat">Tesisat No</label><input id="tesisat" type="search" name="tesisat" value="@seciliTesisat" placeholder="Tesisat no" /></div>
                        <div class="df-admin-field"><label for="musteri">Müşteri / Abone</label><input id="musteri" type="search" name="musteri" value="@seciliMusteri" placeholder="Ad, abone no veya telefon" /></div>
                        <div class="df-admin-field">
                            <label for="marka">Marka</label>
                            <select id="marka" name="marka">
                                <option value="">Tümü</option>
                                @foreach (var m in markaList)
                                {
                                    <option value="@m" selected="@Secili(string.Equals(seciliMarka, m, StringComparison.OrdinalIgnoreCase))">@m</option>
                                }
                            </select>
                        </div>
                        <div class="df-admin-field">
                            <label for="durum">Durum</label>
                            <select id="durum" name="durum">
                                <option value="">Tümü</option>
                                <option value="tamamlandi" selected="@Secili(string.Equals(seciliDurum, "tamamlandi", StringComparison.OrdinalIgnoreCase))">Tamamlandı</option>
                                <option value="bekliyor" selected="@Secili(string.Equals(seciliDurum, "bekliyor", StringComparison.OrdinalIgnoreCase))">Bekliyor</option>
                                <option value="iptal" selected="@Secili(string.Equals(seciliDurum, "iptal", StringComparison.OrdinalIgnoreCase))">İptal</option>
                            </select>
                        </div>
                        <div class="df-admin-field"><label for="bas">Başlangıç Tarihi</label><input id="bas" type="date" name="bas" value="@seciliBas" /></div>
                        <div class="df-admin-field"><label for="bit">Bitiş Tarihi</label><input id="bit" type="date" name="bit" value="@seciliBit" /></div>
                    </div>
                    <div class="df-admin-filter-actions">
                        <a class="df-btn df-btn-secondary df-btn-sm" href="@Url.Action("Gecmis", "DevreyeAlma")"><i class="bi bi-x-lg" aria-hidden="true"></i> Temizle</a>
                        <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Sonuçları Göster</button>
                    </div>
                </form>
            </div>
        </details>

        @if (!Model.Any())
        {
            <div class="df-admin-empty"><i class="bi bi-inbox" aria-hidden="true"></i> Filtrelere uygun kayıt bulunamadı.</div>
        }
        else
        {
            <div class="df-admin-table-scroll">
                <table class="df-table df-commissioning-table is-firm-history">
                    <thead><tr><th>Abone</th><th>Tesisat Bilgileri</th><th>Yakıcı Cihaz Tipi</th><th>Devreye Alınan Cihaz Bilgileri</th><th>Cihaz Devreye Alma Tarihi</th><th>Yetkili Ad Soyad</th><th>Durum</th><th>İşlem</th></tr></thead>
                    <tbody>
                    @foreach (var d in Model)
                    {
                        var durumYazi = d.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "Tamamlandı" : d.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "İptal" : "Bekliyor";
                        var durumSinif = d.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi ? "df-pill-success" : d.Durum == DevreyeAlmaDurumDegerleri.Iptal ? "df-pill-danger" : "df-pill-warning";
                        var tarihVar = d.DevreyeAlmaTarihi.Year > 1900;
                        var cihazMarka = d.CihazMarka ?? d.Marka?.MarkaAdi;
                        var cihazModeli = string.Equals(d.CihazModeli?.Trim(), cihazMarka?.Trim(), StringComparison.OrdinalIgnoreCase)
                            || string.Equals(d.CihazModeli?.Trim(), d.CihazTipi?.Trim(), StringComparison.OrdinalIgnoreCase)
                                ? null
                                : d.CihazModeli;
                        var detaySatiriId = $"devreye-alma-detay-{d.Id}";
                        <tr class="df-commissioning-record-row" data-commissioning-record data-export-id="@d.Id">
                            <td><div class="df-cell-main">@(string.IsNullOrWhiteSpace(d.MusteriAdi) ? "Abone adı kayıtlı değil" : d.MusteriAdi)</div>@if (!string.IsNullOrWhiteSpace(d.MusteriTelefon)) { <div class="df-cell-sub"><i class="bi bi-telephone" aria-hidden="true"></i> @d.MusteriTelefon</div> }</td>
                            <td><dl class="df-operation-id-list"><div><dt>Tesisat No:</dt><dd>@(d.TesistatNo ?? "-")</dd></div><div><dt>Abone No:</dt><dd>@(d.AboneNo ?? "-")</dd></div></dl></td>
                            <td><span class="df-device-type-tag">@(string.IsNullOrWhiteSpace(d.CihazTipi) ? "-" : d.CihazTipi)</span></td>
                            <td><dl class="df-device-facts"><div><dt>Marka</dt><dd>@(string.IsNullOrWhiteSpace(cihazMarka) ? "-" : cihazMarka)</dd></div>@if (!string.IsNullOrWhiteSpace(cihazModeli)) { <div class="df-device-model"><dt>Model</dt><dd title="@cihazModeli">@cihazModeli</dd></div> }</dl></td>
                            <td><time class="df-cell-value" datetime="@(tarihVar ? d.DevreyeAlmaTarihi.ToString("yyyy-MM-dd") : null)">@(tarihVar ? d.DevreyeAlmaTarihi.ToString("dd.MM.yyyy") : "Tarih bilgisi yok")</time></td>
                            <td><div class="df-cell-value">@(string.IsNullOrWhiteSpace(d.TeknisyenAdi) ? "-" : d.TeknisyenAdi)</div></td>
                            <td><span class="df-pill @durumSinif">@durumYazi</span></td>
                            <td>
                                <div class="df-commissioning-row-actions">
                                    <button class="df-icon-action commissioning-row-action df-commissioning-expand" type="button" data-commissioning-expand aria-expanded="false" aria-controls="@detaySatiriId" title="İşlem ayrıntılarını görüntüle" aria-label="@(string.IsNullOrWhiteSpace(d.MusteriAdi) ? "İşlem ayrıntılarını görüntüle" : $"{d.MusteriAdi} işlem ayrıntılarını görüntüle")"><i class="bi bi-eye" aria-hidden="true"></i></button>
                                </div>
                            </td>
                        </tr>
                        <partial name="_DevreyeAlmaInlineDetails" model="d" />
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/commissioning-row-details.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll("[data-commissioning-bulk-export]").forEach(button => {
            button.addEventListener("click", () => {
                const ids = Array.from(document.querySelectorAll("[data-commissioning-record][data-export-id]"))
                    .map(row => row.dataset.exportId).filter(Boolean);
                if (!ids.length) return;
                const url = new URL(button.dataset.exportUrl, window.location.origin);
                ids.forEach(id => url.searchParams.append("ids", id));
                window.location.assign(url.toString());
            });
        });
    </script>
}
