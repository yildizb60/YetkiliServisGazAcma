@model List<YetkiliServisGazAcma.Entities.Ys_DevreyeAlma>
@{
    ViewData["Title"] = "Cihaz Devreye Alma Geçmişi";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelModule"] = "Cihaz Devreye Alma";
    Layout = "_PanelLayout";
    ViewData["ActiveMenu"] = "DevreyeGecmis";
    ViewData["PanelArea"] = "YetkiliServis";
    var markaList = ViewBag.MarkaList as List<string> ?? new List<string>();
    string seciliMarka = ViewBag.SeciliMarka as string ?? "";
    string seciliBas = ViewBag.SeciliBas as string ?? "";
    string seciliBit = ViewBag.SeciliBit as string ?? "";
    string seciliMusteri = ViewBag.SeciliMusteri as string ?? "";
    string seciliDurum = ViewBag.SeciliDurum as string ?? "";
    bool filtreAktif = !string.IsNullOrWhiteSpace(seciliMarka)
        || !string.IsNullOrWhiteSpace(seciliBas)
        || !string.IsNullOrWhiteSpace(seciliBit)
        || !string.IsNullOrWhiteSpace(seciliMusteri)
        || !string.IsNullOrWhiteSpace(seciliDurum);
    int tamamlanan = Model.Count(x => x.Durum == DevreyeAlmaDurumDegerleri.Tamamlandi);
    int bekleyen = Model.Count(x => x.Durum == DevreyeAlmaDurumDegerleri.Bekliyor);
}

@functions {
    private static string Deger(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : System.Net.WebUtility.HtmlDecode(value);
    }

    private static string DurumYazi(int durum)
    {
        return durum == DevreyeAlmaDurumDegerleri.Tamamlandi
            ? "Tamamlandı"
            : durum == DevreyeAlmaDurumDegerleri.Iptal
                ? "İptal"
                : "Bekliyor";
    }

    private static string DurumClass(int durum)
    {
        return durum == DevreyeAlmaDurumDegerleri.Tamamlandi
            ? "df-pill-success"
            : durum == DevreyeAlmaDurumDegerleri.Iptal
                ? "df-pill-danger"
                : "df-pill-warning";
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ys-operations.css" asp-append-version="true" />
}

<div class="ys-workspace">
    <div class="ys-summary-strip is-three" aria-label="İşlem özeti">
        <div class="ys-summary-item">
            <span class="ys-summary-icon"><i class="bi bi-collection" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong>@Model.Count</strong><span>Toplam İşlem</span></span>
        </div>
        <div class="ys-summary-item is-success">
            <span class="ys-summary-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong>@tamamlanan</strong><span>Tamamlanan</span></span>
        </div>
        <div class="ys-summary-item is-warning">
            <span class="ys-summary-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
            <span class="ys-summary-copy"><strong>@bekleyen</strong><span>Bekleyen</span></span>
        </div>
    </div>

    <details class="ys-panel ys-filter" open="@filtreAktif">
        <summary>
            <span class="ys-summary-heading">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <strong>Filtreler</strong>
                <span>@(filtreAktif ? "Aktif filtre uygulanıyor" : "Marka, tarih, müşteri veya durum")</span>
            </span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </summary>
        <div class="ys-filter-body">
            <form class="ys-filter-grid" method="get" action="@Url.Action("Gecmis", "DevreyeAlma")">
                <div class="ys-field">
                    <label for="gecmisMarka">Marka</label>
                    <select id="gecmisMarka" name="marka">
                        <option value="">Tümü</option>
                        @foreach (var m in markaList)
                        {
                            <option selected="@(string.Equals(seciliMarka, m, StringComparison.OrdinalIgnoreCase))">@m</option>
                        }
                    </select>
                </div>
                <div class="ys-field"><label for="gecmisBas">Başlangıç</label><input id="gecmisBas" type="date" name="bas" value="@seciliBas" /></div>
                <div class="ys-field"><label for="gecmisBit">Bitiş</label><input id="gecmisBit" type="date" name="bit" value="@seciliBit" /></div>
                <div class="ys-field"><label for="gecmisMusteri">Müşteri</label><input id="gecmisMusteri" type="search" name="musteri" placeholder="Müşteri ara" value="@seciliMusteri" /></div>
                <div class="ys-field">
                    <label for="gecmisDurum">Durum</label>
                    <select id="gecmisDurum" name="durum">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(seciliDurum))">Tümü</option>
                        <option value="tamamlandi" selected="@(string.Equals(seciliDurum, "tamamlandi", StringComparison.OrdinalIgnoreCase))">Tamamlandı</option>
                        <option value="bekliyor" selected="@(string.Equals(seciliDurum, "bekliyor", StringComparison.OrdinalIgnoreCase))">Bekliyor</option>
                    </select>
                </div>
                <div class="ys-actions">
                    @if (filtreAktif)
                    {
                        <a class="df-btn df-btn-secondary df-btn-sm" href="@Url.Action("Gecmis", "DevreyeAlma")" title="Filtreleri temizle"><i class="bi bi-x-lg" aria-hidden="true"></i></a>
                    }
                    <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Uygula</button>
                </div>
            </form>
        </div>
    </details>

    <section class="ys-panel is-blue">
        <div class="ys-panel-head">
            <div class="ys-panel-heading">
                <span class="ys-section-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span>
                <div>
                    <h2 class="ys-panel-title">Devreye Alma Kayıtları</h2>
                </div>
            </div>
            <a class="df-btn df-btn-primary df-btn-sm ys-new-record-action" href="@Url.Action("Index", "DevreyeAlma")" title="Yeni cihaz devreye alma kaydı oluştur">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Kayıt
            </a>
        </div>
        <div class="ys-table-wrap">
            <table class="ys-table">
                <thead>
                    <tr>
                        <th>Tesisat</th>
                        <th>Müşteri</th>
                        <th>Marka</th>
                        <th>Model</th>
                        <th>Teknisyen</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th><span class="visually-hidden">İşlem</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8"><div class="ys-empty"><span>Seçilen ölçütlerde işlem bulunamadı.</span></div></td></tr>
                    }
                    else
                    {
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td><span class="ys-table-primary">@i.TesistatNo</span></td>
                                <td>@i.MusteriAdi</td>
                                <td>@Deger(i.CihazMarka)</td>
                                <td><span class="ys-model-clamp" title="@i.CihazModeli">@(!string.IsNullOrWhiteSpace(i.CihazModeli) && !string.Equals(i.CihazModeli.Trim(), i.CihazMarka?.Trim(), StringComparison.OrdinalIgnoreCase) ? i.CihazModeli : "-")</span></td>
                                <td>@i.TeknisyenAdi</td>
                                <td>@i.DevreyeAlmaTarihi.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <span class="df-pill @DurumClass(i.Durum)">@DurumYazi(i.Durum)</span>
                                </td>
                                <td>
                                    <div class="ys-table-actions">
                                        <button class="df-icon-action ys-history-detail"
                                                type="button"
                                                aria-label="@Deger(i.MusteriAdi) cihaz devreye alma kaydını görüntüle"
                                                title="İşlem detayını görüntüle"
                                                data-id="@i.Id"
                                                data-detail-url="/ys-devreyeal/detay/@i.Id"
                                                data-pdf-url="@Url.Action("PdfIndir", "DevreyeAlma", new { id = i.Id })"
                                                data-excel-url="@Url.Action("ExcelIndir", "DevreyeAlma", new { id = i.Id })"
                                                data-tesisat="@Deger(i.TesistatNo)"
                                                data-cari-kod="@Deger(i.AboneNo)"
                                                data-musteri="@Deger(i.MusteriAdi)"
                                                data-telefon="@Deger(i.MusteriTelefon)"
                                                data-tc="@Deger(i.MusteriTcNo)"
                                                data-adres="@Deger(i.Adres)"
                                                data-cihaz-tipi="@Deger(i.CihazTipi)"
                                                data-marka="@Deger(i.Marka?.MarkaAdi ?? i.CihazMarka)"
                                                data-model="@Deger(i.CihazModeli)"
                                                data-kapasite="@Deger(i.CihazKapasite)"
                                                data-seri-no="@Deger(i.SeriNo)"
                                                data-teknisyen="@Deger(i.TeknisyenAdi)"
                                                data-yetki-belgesi="@Deger(i.TeknisyenYetkiBelgesiNo)"
                                                data-devreye-tarihi="@i.DevreyeAlmaTarihi.ToString("dd.MM.yyyy")"
                                                data-kayit-tarihi="@i.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")"
                                                data-durum="@DurumYazi(i.Durum)"
                                                data-durum-class="@DurumClass(i.Durum)"
                                                data-notlar="@Deger(i.Notlar)">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="ys-report-modal" id="ysHistoryDetailModal" aria-hidden="true">
    <div class="ys-report-modal-backdrop" data-ys-modal-close></div>
    <div class="ys-report-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="ysHistoryModalTitle" tabindex="-1">
        <div class="ys-report-modal-header">
            <div class="ys-modal-title-wrap">
                <span class="ys-page-icon"><i class="bi bi-clipboard2-check" aria-hidden="true"></i></span>
                <div>
                    <h2 id="ysHistoryModalTitle">Devreye Alma Detayı</h2>
                    <p id="ysHistoryModalSubtitle">-</p>
                </div>
            </div>
            <button class="ys-modal-close" type="button" data-ys-modal-close aria-label="Kapat">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>

        <div class="ys-report-modal-body">
            <div class="ys-modal-summary">
                <div class="ys-modal-summary-item is-status"><i class="bi bi-activity" aria-hidden="true"></i><span><small>Durum</small><strong><span class="df-pill" id="ysModalDurum">-</span></strong></span></div>
                <div class="ys-modal-summary-item is-date"><i class="bi bi-calendar2-check" aria-hidden="true"></i><span><small>Devreye Alma</small><strong id="ysModalDevreyeTarihi">-</strong></span></div>
                <div class="ys-modal-summary-item is-device"><i class="bi bi-fire" aria-hidden="true"></i><span><small>Cihaz</small><strong id="ysModalCihazOzeti">-</strong></span></div>
                <div class="ys-modal-summary-item is-tech"><i class="bi bi-person-gear" aria-hidden="true"></i><span><small>Teknisyen</small><strong id="ysModalTeknisyenOzeti">-</strong></span></div>
            </div>

            <div class="ys-modal-grid">
                <section class="ys-modal-section is-blue">
                    <h3><i class="bi bi-house-check" aria-hidden="true"></i> Tesisat ve Müşteri</h3>
                    <dl class="ys-modal-facts">
                        <div><dt>Tesisat No</dt><dd id="ysModalTesisat">-</dd></div>
                        <div data-optional="cariKod"><dt>Servis Cari Kod</dt><dd id="ysModalCariKod">-</dd></div>
                        <div><dt>Müşteri</dt><dd id="ysModalMusteri">-</dd></div>
                        <div data-optional="telefon"><dt>Telefon</dt><dd id="ysModalTelefon">-</dd></div>
                        <div data-optional="tc"><dt>TC Kimlik No</dt><dd id="ysModalTc">-</dd></div>
                        <div class="is-wide" data-optional="adres"><dt>Adres</dt><dd id="ysModalAdres">-</dd></div>
                    </dl>
                </section>

                <section class="ys-modal-section is-green">
                    <h3><i class="bi bi-tools" aria-hidden="true"></i> Cihaz ve Kayıt</h3>
                    <dl class="ys-modal-facts">
                        <div><dt>Cihaz Tipi</dt><dd id="ysModalCihazTipi">-</dd></div>
                        <div><dt>Marka</dt><dd id="ysModalMarka">-</dd></div>
                        <div class="is-wide" data-optional="model"><dt>Model</dt><dd id="ysModalModel">-</dd></div>
                        <div data-optional="kapasite"><dt>Kapasite</dt><dd id="ysModalKapasite">-</dd></div>
                        <div data-optional="seriNo"><dt>Seri No</dt><dd id="ysModalSeriNo">-</dd></div>
                        <div data-optional="yetkiBelgesi"><dt>Teknisyen Yetki Belgesi</dt><dd id="ysModalYetkiBelgesi">-</dd></div>
                        <div><dt>Kayıt Tarihi</dt><dd id="ysModalKayitTarihi">-</dd></div>
                    </dl>
                </section>
            </div>

            <section class="ys-modal-note" id="ysModalNotAlani" hidden>
                <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                <div><strong>İşlem Notu</strong><p id="ysModalNotlar"></p></div>
            </section>
        </div>

        <div class="ys-report-modal-footer">
            <button class="df-btn df-btn-secondary df-btn-sm" type="button" data-ys-modal-close>Kapat</button>
            <a class="df-btn ys-export-pdf df-btn-sm" id="ysModalPdfLink" href="#" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
            <a class="df-btn ys-export-excel df-btn-sm" id="ysModalExcelLink" href="#" target="_blank" rel="noopener"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
            <a class="df-btn df-btn-primary df-btn-sm" id="ysModalDetailLink" href="#"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Tam Detayı Aç</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById('ysHistoryDetailModal');
            if (!modal) return;

            const durum = document.getElementById('ysModalDurum');
            const detailLink = document.getElementById('ysModalDetailLink');
            const pdfLink = document.getElementById('ysModalPdfLink');
            const excelLink = document.getElementById('ysModalExcelLink');
            const notAlani = document.getElementById('ysModalNotAlani');
            let sonTetikleyici = null;

            function temiz(value) {
                const sonuc = (value || '').trim();
                return sonuc && sonuc !== '-' ? sonuc : '';
            }

            function yaz(id, value) {
                const element = document.getElementById(id);
                if (element) element.textContent = temiz(value) || '-';
            }

            function opsiyonelAlan(name, value) {
                const element = modal.querySelector('[data-optional="' + name + '"]');
                if (element) element.hidden = !temiz(value);
            }

            function birlestir() {
                return Array.from(arguments).map(temiz).filter(Boolean).join(' / ') || '-';
            }

            function ac(button) {
                const data = button.dataset;
                sonTetikleyici = button;

                yaz('ysHistoryModalTitle', 'Devreye Alma Kaydı #' + data.id);
                yaz('ysHistoryModalSubtitle', birlestir('Tesisat ' + (temiz(data.tesisat) || '-'), data.musteri));
                yaz('ysModalDevreyeTarihi', data.devreyeTarihi);
                yaz('ysModalCihazOzeti', birlestir(data.cihazTipi, data.marka));
                yaz('ysModalTeknisyenOzeti', data.teknisyen);
                yaz('ysModalTesisat', data.tesisat);
                yaz('ysModalCariKod', data.cariKod);
                yaz('ysModalMusteri', data.musteri);
                yaz('ysModalTelefon', data.telefon);
                yaz('ysModalTc', data.tc);
                yaz('ysModalAdres', data.adres);
                yaz('ysModalCihazTipi', data.cihazTipi);
                yaz('ysModalMarka', data.marka);
                yaz('ysModalModel', data.model);
                yaz('ysModalKapasite', data.kapasite);
                yaz('ysModalSeriNo', data.seriNo);
                yaz('ysModalYetkiBelgesi', data.yetkiBelgesi);
                yaz('ysModalKayitTarihi', data.kayitTarihi);
                yaz('ysModalNotlar', data.notlar);

                ['cariKod', 'telefon', 'tc', 'adres', 'model', 'kapasite', 'seriNo', 'yetkiBelgesi']
                    .forEach(function (alan) { opsiyonelAlan(alan, data[alan]); });

                if (durum) {
                    durum.textContent = temiz(data.durum) || '-';
                    durum.className = 'df-pill ' + (data.durumClass || 'df-pill-secondary');
                }

                if (notAlani) notAlani.hidden = !temiz(data.notlar);
                if (detailLink) detailLink.href = data.detailUrl;
                if (pdfLink) pdfLink.href = data.pdfUrl;
                if (excelLink) excelLink.href = data.excelUrl;

                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
                modal.querySelector('[data-ys-modal-close]')?.focus();
            }

            function kapat() {
                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
                sonTetikleyici?.focus();
            }

            document.addEventListener('click', function (event) {
                const detay = event.target.closest('.ys-history-detail');
                if (detay) {
                    ac(detay);
                    return;
                }

                if (event.target.closest('[data-ys-modal-close]')) kapat();
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && modal.classList.contains('is-open')) kapat();
            });
        })();
    </script>
}
