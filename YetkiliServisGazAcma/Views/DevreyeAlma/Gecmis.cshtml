@model List<YsDevreyeAlmaDto>
@{
    ViewData["Title"] = "Cihaz Devreye Alma Geçmişi";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelModule"] = "Cihaz Devreye Alma";
    ViewData["ActiveMenu"] = "DevreyeGecmis";
    ViewData["PanelArea"] = "YetkiliServis";
    ViewData["DevreyeAlmaAlan"] = "/ys-devreyeal";
    Layout = "_PanelLayout";
    var liste = new DevreyeAlmaListeViewModel
    {
        Kayitlar = Model, ServisPaneli = true,
        Sayfalama = ViewBag.Sayfalama as DevreyeAlmaSayfalamaDto,
        ListeUrl = Url.Action("Gecmis", "DevreyeAlma")!,
        TemizleUrl = Url.Action("Gecmis", "DevreyeAlma")!,
        PdfUrl = Url.Action("RaporlarPdf", "YetkiliServisPanel")!,
        ExcelUrl = Url.Action("RaporlarExcel", "YetkiliServisPanel")!,
        YeniKayitUrl = Url.Action("Index", "DevreyeAlma"),
        Markalar = ViewBag.MarkaList as List<string> ?? [],
        CihazTipleri = ViewBag.CihazTipleri as List<string> ?? []
    };
}
@section PageStyles {
    <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/commissioning-history.css" asp-append-version="true" />
}
<partial name="_DevreyeAlmaDirectory" model="liste" />
@section Scripts {
    <script src="~/js/commissioning-row-details.js" asp-append-version="true"></script>
    <script src="~/js/commissioning-history.js" asp-append-version="true"></script>
}
