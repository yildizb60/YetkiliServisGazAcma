@model List<YetkiliServisGazAcma.Entities.Ys_YetkiBelgesi>
@{
    ViewData["Title"] = "Yetki Belgem";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Yetkili Servis";
    ViewData["ActiveMenu"] = "YetkiBelgesi";
    ViewData["PanelArea"] = "YetkiliServis";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var bekleyen = Model.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor);
    var onaylanan = Model.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.Onaylandi);
    var reddedilen = Model.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.Reddedildi);
}

@section PageStyles { <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" /> }

<div class="df-admin-workspace df-certificate-workspace">
    @if (TempData["Basarili"] != null) { <div class="df-alert df-alert-success">@TempData["Basarili"]</div> }
    @if (TempData["Hata"] != null) { <div class="df-alert df-alert-danger">@TempData["Hata"]</div> }

    <details class="df-admin-filter" open="@(Model.Count == 0 ? "open" : null)">
        <summary>
            <span><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i><strong>Yeni Yetki Belgesi Yükle</strong><small>PDF, JPG veya PNG</small></span>
            <span>Yükleme alanını aç <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <form method="post" action="/ys-yetki-belgesi/yukle" enctype="multipart/form-data" class="ys-certificate-upload">
                @Html.AntiForgeryToken()
                <div class="df-admin-field is-file"><label for="dosya">Belge Dosyası *</label><input id="dosya" type="file" name="dosya" accept=".pdf,.jpg,.jpeg,.png" required /></div>
                <div class="df-admin-field"><label for="baslangicTarihi">Başlangıç Tarihi</label><input id="baslangicTarihi" type="date" name="baslangicTarihi" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
                <div class="df-admin-field"><label for="bitisTarihi">Bitiş Tarihi *</label><input id="bitisTarihi" type="date" name="bitisTarihi" required /></div>
                <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Belgeyi Yükle</button>
            </form>
        </div>
    </details>

    <details class="df-admin-filter">
        <summary>
            <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Liste Filtreleri</strong><small>Tarih veya duruma göre daraltın</small></span>
            <span>Filtreleri aç <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <div class="df-admin-filter-grid">
                <div class="df-admin-field is-wide"><label for="yetkiBelgesiSearch">Arama</label><input id="yetkiBelgesiSearch" type="search" placeholder="Tarih veya durum" /></div>
                <div class="df-admin-field"><label for="yetkiBelgesiDurum">Durum</label><select id="yetkiBelgesiDurum"><option value="">Tümü</option><option value="Onay Bekliyor">Onay Bekliyor</option><option value="Onaylandı">Onaylandı</option><option value="Reddedildi">Reddedildi</option></select></div>
            </div>
        </div>
    </details>

    <section class="df-admin-list-card">
        <div class="df-service-list-head">
            <div><h3><i class="bi bi-clock-history" aria-hidden="true"></i> Belge Geçmişi</h3></div>
            <div class="df-admin-metrics df-inline-metrics" aria-label="Belge özeti">
                <span class="df-admin-metric"><i class="bi bi-files" aria-hidden="true"></i><span>Toplam</span><strong>@Model.Count</strong></span>
                <span class="df-admin-metric is-waiting"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span>Onay Bekleyen</span><strong>@bekleyen</strong></span>
                <span class="df-admin-metric is-approved"><i class="bi bi-check-circle" aria-hidden="true"></i><span>Onaylanan</span><strong>@onaylanan</strong></span>
                <span class="df-admin-metric is-rejected"><i class="bi bi-x-circle" aria-hidden="true"></i><span>Reddedilen</span><strong>@reddedilen</strong></span>
            </div>
        </div>
        @if (Model.Count == 0)
        {
            <div class="df-admin-empty"><i class="bi bi-file-earmark" aria-hidden="true"></i> Henüz yetki belgesi yüklenmedi.</div>
        }
        else
        {
            <div class="df-admin-table-scroll"><table class="df-table">
                <thead><tr><th>Belge</th><th>Başlangıç</th><th>Bitiş</th><th>Durum</th><th>İşlemler</th></tr></thead>
                <tbody>
                @foreach (var belge in Model)
                {
                    var baslangic = belge.YetkiBelgesiBaslangicTarihi ?? belge.OlusturmaTarihi;
                    var durumText = belge.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor ? "Onay Bekliyor" : belge.Durum == YetkiBelgesiDurumDegerleri.Onaylandi ? "Onaylandı" : "Reddedildi";
                    var durumClass = belge.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor ? "df-pill-warning" : belge.Durum == YetkiBelgesiDurumDegerleri.Onaylandi ? "df-pill-success" : "df-pill-danger";
                    var searchText = $"{belge.OlusturmaTarihi:dd.MM.yyyy} {baslangic:dd.MM.yyyy} {belge.YetkiBelgesiBitisTarihi:dd.MM.yyyy} {durumText}";
                    <tr class="sert-row" data-search="@searchText" data-durum="@durumText">
                        <td><div class="df-cell-main"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Yetki Belgesi</div><div class="df-cell-sub">@belge.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm") tarihinde yüklendi</div>@if (!string.IsNullOrWhiteSpace(belge.RedGerekce)) { <div class="df-cell-sub">Red gerekçesi: @belge.RedGerekce</div> }</td>
                        <td>@baslangic.ToString("dd.MM.yyyy")</td>
                        <td>@belge.YetkiBelgesiBitisTarihi.ToString("dd.MM.yyyy")</td>
                        <td><span class="df-pill @durumClass">@durumText</span></td>
                        <td><div class="df-actions">
                            <a class="df-icon-action" href="/ys-yetki-belgesi/dosya/@belge.Id" target="_blank" rel="noopener" title="Belgeyi görüntüle"><i class="bi bi-eye" aria-hidden="true"></i><span>Görüntüle</span></a>
                            <form method="post" action="/ys-yetki-belgesi/sil" onsubmit="return confirm('Yetki belgesini silmek istiyor musunuz?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@belge.Id" /><button class="df-icon-action is-danger" type="submit" title="Belgeyi sil"><i class="bi bi-trash3" aria-hidden="true"></i><span>Sil</span></button></form>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </section>
</div>

@section Scripts {
<script>
(function () {
    const searchInput = document.getElementById('yetkiBelgesiSearch');
    const durumSelect = document.getElementById('yetkiBelgesiDurum');
    const rows = Array.from(document.querySelectorAll('.sert-row'));
    if (!searchInput || !durumSelect || rows.length === 0) return;
    function filtrele() {
        const q = (searchInput.value || '').toLocaleLowerCase('tr-TR').trim();
        const durum = (durumSelect.value || '').toLocaleLowerCase('tr-TR').trim();
        rows.forEach(function (row) {
            const metin = (row.dataset.search || '').toLocaleLowerCase('tr-TR');
            const satirDurum = (row.dataset.durum || '').toLocaleLowerCase('tr-TR');
            row.hidden = !((q === '' || metin.includes(q)) && (durum === '' || satirDurum === durum));
        });
    }
    searchInput.addEventListener('input', filtrele);
    durumSelect.addEventListener('change', filtrele);
})();
</script>
}
