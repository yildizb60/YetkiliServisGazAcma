@model List<YetkiliServisGazAcma.Entities.Ys_YetkiBelgesi>
@{
    ViewData["Title"] = "Yetki Belgem";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelModule"] = "Yetkili Servis İşlemleri";
    ViewData["PanelSubtitle"] = "Yetkili Servis";
    ViewData["ActiveMenu"] = "YetkiBelgesi";
    ViewData["PanelArea"] = "YetkiliServis";
    ViewData["ContentClass"] = "certificate-content";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var bekleyen = Model.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor && x.YetkiBelgesiBitisTarihi.Date >= DateTime.Today);
    var suresiDolan = Model.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor && x.YetkiBelgesiBitisTarihi.Date < DateTime.Today);
    var onaylanan = Model.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.Onaylandi);
    var reddedilen = Model.Count(x => x.Durum == YetkiBelgesiDurumDegerleri.Reddedildi);
}

@section PageStyles { <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" /> }

<div class="df-admin-workspace df-certificate-workspace">
    <details class="df-admin-filter" open="@(Model.Count == 0 ? "open" : null)">
        <summary>
            <span><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i><strong>Yeni Yetki Belgesi Yükle</strong><small>PDF, JPG veya PNG</small></span>
            <span>Yükleme alanını aç <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <form method="post" action="@Url.Action("Yukle", "YetkiBelgesi")" enctype="multipart/form-data" class="ys-certificate-upload">
                @Html.AntiForgeryToken()
                <div class="df-admin-field is-file"><label for="dosya">Belge Dosyası *</label><input id="dosya" type="file" name="dosya" accept=".pdf,.jpg,.jpeg,.png" required /></div>
                <div class="df-admin-field"><label for="baslangicTarihi">Geçerlilik Başlangıcı</label><input id="baslangicTarihi" type="date" name="baslangicTarihi" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
                <div class="df-admin-field"><label for="bitisTarihi">Yetki Belgesi Bitiş Tarihi *</label><input id="bitisTarihi" type="date" name="bitisTarihi" required /></div>
                <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Belgeyi Yükle</button>
            </form>
        </div>
    </details>

    <details class="df-admin-filter">
        <summary>
            <span><i class="bi bi-funnel" aria-hidden="true"></i><strong>Liste Filtreleri</strong><small>Tarih veya duruma göre daraltın</small></span>
            <span>Filtreleri aç <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
        </summary>
        <div class="df-admin-filter-body">
            <div class="df-admin-filter-grid">
                <div class="df-admin-field is-wide"><label for="yetkiBelgesiSearch">Arama</label><input id="yetkiBelgesiSearch" type="search" placeholder="Tarih veya durum" /></div>
                <div class="df-admin-field"><label for="yetkiBelgesiDurum">Durum</label><select id="yetkiBelgesiDurum"><option value="">Tümü</option><option value="Onay Bekliyor">Onay Bekliyor</option><option value="Süresi Doldu">Süresi Doldu</option><option value="Onaylandı">Onaylandı</option><option value="Reddedildi">Reddedildi</option></select></div>
            </div>
        </div>
    </details>

    <section class="df-admin-list-card">
        <div class="df-service-list-head">
            <div><h3><i class="bi bi-clock-history" aria-hidden="true"></i> Belge Geçmişi</h3></div>
            <span class="df-pill df-pill-info">@Model.Count belge</span>
        </div>
        <div class="ys-certificate-summary" role="group" aria-label="Belge durumuna göre filtrele">
            <button type="button" data-belge-durum="" aria-pressed="true"><i class="bi bi-files" aria-hidden="true"></i><span>Toplam</span><strong>@Model.Count</strong></button>
            <button type="button" data-belge-durum="Onay Bekliyor" aria-pressed="false"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span>Onay Bekleyen</span><strong>@bekleyen</strong></button>
            <button type="button" data-belge-durum="Süresi Doldu" aria-pressed="false"><i class="bi bi-calendar-x" aria-hidden="true"></i><span>Süresi Doldu</span><strong>@suresiDolan</strong></button>
            <button type="button" data-belge-durum="Onaylandı" aria-pressed="false"><i class="bi bi-check-circle" aria-hidden="true"></i><span>Onaylanan</span><strong>@onaylanan</strong></button>
            <button type="button" data-belge-durum="Reddedildi" aria-pressed="false"><i class="bi bi-x-circle" aria-hidden="true"></i><span>Reddedilen</span><strong>@reddedilen</strong></button>
        </div>
        @if (Model.Count == 0)
        {
            <div class="df-admin-empty"><i class="bi bi-file-earmark" aria-hidden="true"></i> Henüz yetki belgesi yüklenmedi.</div>
        }
        else
        {
            <div class="df-admin-table-scroll"><table class="df-table ys-certificate-table">
                <colgroup><col style="width:19%" /><col style="width:23%" /><col style="width:21%" /><col style="width:16%" /><col style="width:21%" /></colgroup>
                <thead><tr><th>Belge</th><th>Yetki Belgesi Yükleme Tarihi</th><th>Yetki Belgesi Bitiş Tarihi</th><th>Durum</th><th>İşlemler</th></tr></thead>
                <tbody>
                @foreach (var belge in Model)
                {
                    var suresiDolmus = belge.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor && belge.YetkiBelgesiBitisTarihi.Date < DateTime.Today;
                    var durumText = suresiDolmus ? "Süresi Doldu" : belge.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor ? "Onay Bekliyor" : belge.Durum == YetkiBelgesiDurumDegerleri.Onaylandi ? "Onaylandı" : "Reddedildi";
                    var durumClass = suresiDolmus ? "is-expired" : belge.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor ? "is-pending" : belge.Durum == YetkiBelgesiDurumDegerleri.Onaylandi ? "is-approved" : "is-rejected";
                    var durumIcon = suresiDolmus ? "bi-calendar-x" : belge.Durum == YetkiBelgesiDurumDegerleri.OnaydaBekliyor ? "bi-hourglass-split" : belge.Durum == YetkiBelgesiDurumDegerleri.Onaylandi ? "bi-check-circle" : "bi-x-circle";
                    var searchText = $"{belge.OlusturmaTarihi:dd.MM.yyyy} {belge.YetkiBelgesiBitisTarihi:dd.MM.yyyy} {durumText}";
                    <tr class="sert-row" data-search="@searchText" data-durum="@durumText">
                        <td><div class="df-cell-main"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Yetki Belgesi</div>@if (!string.IsNullOrWhiteSpace(belge.RedGerekce)) { <div class="df-cell-sub">Red gerekçesi: @belge.RedGerekce</div> }</td>
                        <td>@belge.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@belge.YetkiBelgesiBitisTarihi.ToString("dd.MM.yyyy")</td>
                        <td><span class="ys-certificate-state @durumClass"><i class="bi @durumIcon" aria-hidden="true"></i>@durumText</span></td>
                        <td><div class="df-actions">
                            <a class="df-icon-action" href="@Url.Action("Dosya", "YetkiBelgesi", new { id = belge.Id })" target="_blank" rel="noopener" title="Belgeyi görüntüle"><i class="bi bi-eye" aria-hidden="true"></i><span>Görüntüle</span></a>
                            @if (belge.Durum != YetkiBelgesiDurumDegerleri.Onaylandi)
                            {
                                <form method="post" action="@Url.Action("Sil", "YetkiBelgesi")" data-toast-confirm data-confirm-title="Yetki belgesini sil" data-confirm-message="Yetki belgesi silinecek. Bu işlem geri alınamaz." data-confirm-action="Belgeyi Sil">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@belge.Id" /><button class="df-icon-action is-danger" type="submit" title="Belgeyi sil"><i class="bi bi-trash3" aria-hidden="true"></i><span>Sil</span></button></form>
                            }
                        </div></td>
                    </tr>
                }
                <tr id="belgeFiltreBos" hidden><td colspan="5" class="df-admin-empty">Seçilen ölçütlerde belge bulunamadı.</td></tr>
                </tbody>
            </table></div>
        }
    </section>
</div>

@section Scripts {
<script>
(function () {
    const searchInput = document.getElementById('yetkiBelgesiSearch');
    const durumSelect = document.getElementById('yetkiBelgesiDurum');
    const rows = Array.from(document.querySelectorAll('.sert-row'));
    const emptyRow = document.getElementById('belgeFiltreBos');
    const durumButtons = Array.from(document.querySelectorAll('[data-belge-durum]'));
    if (!searchInput || !durumSelect) return;
    function filtrele() {
        const q = (searchInput.value || '').toLocaleLowerCase('tr-TR').trim();
        const durum = (durumSelect.value || '').toLocaleLowerCase('tr-TR').trim();
        durumButtons.forEach(function (button) {
            button.setAttribute('aria-pressed', String((button.dataset.belgeDurum || '').toLocaleLowerCase('tr-TR') === durum));
        });
        let visibleCount = 0;
        rows.forEach(function (row) {
            const metin = (row.dataset.search || '').toLocaleLowerCase('tr-TR');
            const satirDurum = (row.dataset.durum || '').toLocaleLowerCase('tr-TR');
            row.hidden = !((q === '' || metin.includes(q)) && (durum === '' || satirDurum === durum));
            if (!row.hidden) visibleCount++;
        });
        if (emptyRow) emptyRow.hidden = visibleCount !== 0;
    }
    searchInput.addEventListener('input', filtrele);
    durumSelect.addEventListener('change', filtrele);
    durumButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            durumSelect.value = button.dataset.belgeDurum || '';
            filtrele();
        });
    });
})();
</script>
}
