@model YkcRaporSonuc
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var filtre = ViewBag.Filtre as YkcTalepListeFiltre ?? new YkcTalepListeFiltre();
    var sertifikaliFirmaMi = User.IsInRole("SertifikaliFirma");
    var icOperasyonGorsun = !sertifikaliFirmaMi;
    ViewData["Title"] = "Cihaz Değişim Raporları";
    ViewData["PanelTitle"] = "Cihaz Değişim Raporları";
    ViewData["PanelModule"] = "Cihaz Değişim İşlemleri";
    ViewData["ActiveMenu"] = "YkcRaporlar";
    ViewData["PanelSubtitle"] = "Raporlama";
    var sayfaBoyutu = Model.SayfaBoyutu > 0 ? Model.SayfaBoyutu : 10;
    var toplamSayfa = Math.Max(1, (int)Math.Ceiling(Model.Toplam / (double)sayfaBoyutu));
    var aktifSayfa = Math.Clamp(Model.Sayfa > 0 ? Model.Sayfa : 1, 1, toplamSayfa);
    var ilkKayit = Model.Toplam == 0 ? 0 : ((aktifSayfa - 1) * sayfaBoyutu) + 1;
    var sonKayit = Math.Min(aktifSayfa * sayfaBoyutu, Model.Toplam);
    var raporKolonSayisi = icOperasyonGorsun ? 11 : 9;
    var aktifFiltreler = new List<(string Etiket, string Deger)>();
    var disAktarimDegerleri = new
    {
        tesisatNo = filtre.TesisatNo,
        firma = filtre.Firma,
        il = filtre.Il,
        ilce = filtre.Ilce,
        bolge = filtre.Bolge,
        ekip = filtre.Ekip,
        marka = filtre.Marka,
        hedefUygulama = filtre.HedefUygulama,
        durum = filtre.Durum,
        bas = filtre.BaslangicTarihi?.ToString("yyyy-MM-dd"),
        bit = filtre.BitisTarihi?.ToString("yyyy-MM-dd")
    };
    var pdfUrl = Url.Action("RaporPdf", "Ykc", disAktarimDegerleri);
    var excelUrl = Url.Action("RaporExcel", "Ykc", disAktarimDegerleri);

    string SayfaUrl(int sayfaNo)
    {
        var degerler = new Dictionary<string, string?>
        {
            ["tesisatNo"] = filtre.TesisatNo,
            ["firma"] = filtre.Firma,
            ["il"] = filtre.Il,
            ["ilce"] = filtre.Ilce,
            ["bolge"] = filtre.Bolge,
            ["ekip"] = filtre.Ekip,
            ["marka"] = filtre.Marka,
            ["hedefUygulama"] = filtre.HedefUygulama,
            ["durum"] = filtre.Durum?.ToString(),
            ["bas"] = filtre.BaslangicTarihi?.ToString("yyyy-MM-dd"),
            ["bit"] = filtre.BitisTarihi?.ToString("yyyy-MM-dd"),
            ["sayfa"] = sayfaNo.ToString(),
            ["sayfaBoyutu"] = sayfaBoyutu.ToString()
        };
        return Url.Action("Raporlar", "Ykc", new
        {
            tesisatNo = degerler["tesisatNo"],
            firma = degerler["firma"],
            il = degerler["il"],
            ilce = degerler["ilce"],
            bolge = degerler["bolge"],
            ekip = degerler["ekip"],
            marka = degerler["marka"],
            hedefUygulama = degerler["hedefUygulama"],
            durum = degerler["durum"],
            bas = degerler["bas"],
            bit = degerler["bit"],
            sayfa = degerler["sayfa"],
            sayfaBoyutu = degerler["sayfaBoyutu"]
        }) ?? "#";
    }

    void AktifFiltreEkle(string etiket, string? deger)
    {
        if (!string.IsNullOrWhiteSpace(deger))
            aktifFiltreler.Add((etiket, deger));
    }

    AktifFiltreEkle("Tesisat", filtre.TesisatNo);
    AktifFiltreEkle("Firma", filtre.Firma);
    AktifFiltreEkle("Ekip", filtre.Ekip);
    AktifFiltreEkle("Marka", filtre.Marka);
    AktifFiltreEkle("İl", filtre.Il);
    AktifFiltreEkle("İlçe", filtre.Ilce);
    AktifFiltreEkle("Bölge", filtre.Bolge);
    if (filtre.Durum.HasValue)
        AktifFiltreEkle("Durum", DurumYazi(filtre.Durum.Value));
    if (filtre.BaslangicTarihi.HasValue)
        AktifFiltreEkle("Başlangıç", filtre.BaslangicTarihi.Value.ToString("dd.MM.yyyy"));
    if (filtre.BitisTarihi.HasValue)
        AktifFiltreEkle("Bitiş", filtre.BitisTarihi.Value.ToString("dd.MM.yyyy"));
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string? Secili(bool kosul) => kosul ? "selected" : null;

    private static int DurumToplam(IEnumerable<YkcRaporDurumOzetDto> ozetler, params int[] durumlar)
    {
        return ozetler.Where(x => durumlar.Contains(x.Durum)).Sum(x => x.Sayi);
    }

    private static string RandevuYazi(DateTime? tarih, string? saat, int? kontrolNo)
    {
        if (!tarih.HasValue && string.IsNullOrWhiteSpace(saat))
            return kontrolNo is > 1 ? $"{kontrolNo}. kontrol randevusu bekleniyor" : "Henüz planlanmadı";

        var randevu = string.Join(" ", new[]
        {
            tarih?.ToString("dd.MM.yyyy"),
            string.IsNullOrWhiteSpace(saat) ? null : saat
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

        return kontrolNo is > 1 ? $"{kontrolNo}. kontrol · {randevu}" : randevu;
    }

    private static string AtamaYazi(params string?[] parcalar)
    {
        var sonuc = string.Join(" / ", parcalar.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim()));
        return string.IsNullOrWhiteSpace(sonuc) ? "Henüz atanmadı" : sonuc;
    }

    private static string DurumYazi(int durum) => YkcDurumSunumu.Etiket(durum);
    private static string DurumClass(int durum) => YkcDurumSunumu.CssSinifi(durum);

    private static string ImzaDurumYazi(int durum, bool imzaliBelgeVar, string? imzaDurumu)
    {
        if (imzaliBelgeVar)
            return "İmzalı belge hazır";

        if (durum == YkcDurumDegerleri.Reddedildi || durum == YkcDurumDegerleri.Iptal)
            return "İmza süreci kapalı";

        return imzaDurumu switch
        {
            YkcImzaDurumDegerleri.ImzayaGonderildi => "İmzaya gönderildi",
            YkcImzaDurumDegerleri.ImzaBekliyor => "İmzalar bekleniyor",
            YkcImzaDurumDegerleri.KismiImzali => "Kısmen imzalandı",
            YkcImzaDurumDegerleri.Tamamlandi => "İmzalı belge doğrulanıyor",
            YkcImzaDurumDegerleri.Hata => "İmza işlemi hatalı",
            YkcImzaDurumDegerleri.Iptal => "İmza işlemi iptal edildi",
            _ => durum == YkcDurumDegerleri.SahaIsleminde ? "İmzaya gönderilmedi" : "İmza süreci başlamadı"
        };
    }

    private static string ImzaDurumClass(int durum, bool imzaliBelgeVar, string? imzaDurumu)
    {
        if (imzaliBelgeVar)
            return "df-pill-success";

        if (durum == YkcDurumDegerleri.Reddedildi || durum == YkcDurumDegerleri.Iptal
            || imzaDurumu == YkcImzaDurumDegerleri.Hata || imzaDurumu == YkcImzaDurumDegerleri.Iptal)
            return "df-pill-danger";

        return imzaDurumu is YkcImzaDurumDegerleri.ImzaBekliyor or YkcImzaDurumDegerleri.KismiImzali
            ? "df-pill-warning"
            : imzaDurumu is YkcImzaDurumDegerleri.ImzayaGonderildi or YkcImzaDurumDegerleri.Tamamlandi
                ? "df-pill-primary"
                : "df-pill-muted";
    }

    private static string ImzaDurumKisaYazi(int durum, bool imzaliBelgeVar, string? imzaDurumu)
    {
        if (imzaliBelgeVar)
            return "Belge hazır";
        if (durum == YkcDurumDegerleri.Reddedildi || durum == YkcDurumDegerleri.Iptal)
            return "Kapalı";
        return imzaDurumu switch
        {
            YkcImzaDurumDegerleri.ImzayaGonderildi => "İmzaya gönderildi",
            YkcImzaDurumDegerleri.ImzaBekliyor => "İmza bekleniyor",
            YkcImzaDurumDegerleri.KismiImzali => "Kısmi imza",
            YkcImzaDurumDegerleri.Tamamlandi => "Belge doğrulanıyor",
            YkcImzaDurumDegerleri.Hata => "İmza hatası",
            YkcImzaDurumDegerleri.Iptal => "İmza iptal",
            _ => "İmza başlamadı"
        };
    }

    private static string ImzaDurumIkonu(int durum, bool imzaliBelgeVar, string? imzaDurumu)
    {
        if (imzaliBelgeVar)
            return "bi bi-file-earmark-check";
        if (durum == YkcDurumDegerleri.Reddedildi || durum == YkcDurumDegerleri.Iptal)
            return "bi bi-slash-circle";
        return imzaDurumu switch
        {
            YkcImzaDurumDegerleri.Hata or YkcImzaDurumDegerleri.Iptal => "bi bi-exclamation-circle",
            YkcImzaDurumDegerleri.ImzayaGonderildi or YkcImzaDurumDegerleri.ImzaBekliyor
                or YkcImzaDurumDegerleri.KismiImzali or YkcImzaDurumDegerleri.Tamamlandi => "bi bi-pen",
            _ => "bi bi-clock-history"
        };
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ykc-operations.css" asp-append-version="true" />
}

<div class="ykc-workspace ykc-report-workspace ykc-report-page">
    <section class="ykc-report-insights" aria-label="Rapor analizi">
        <div class="ykc-report-insight is-summary">
            <span class="ykc-report-insight-icon"><i class="bi bi-collection" aria-hidden="true"></i></span>
            <div><small>Filtrelenen kayıt</small><strong>@Model.Toplam</strong></div>
            <dl><div><dt>Kontrol sürecinde</dt><dd>@DurumToplam(Model.DurumOzetleri, YkcDurumDegerleri.Atandi, YkcDurumDegerleri.SahaIsleminde)</dd></div><div><dt>Tamamlanan</dt><dd>@DurumToplam(Model.DurumOzetleri, YkcDurumDegerleri.Tamamlandi)</dd></div></dl>
        </div>
        <div class="ykc-report-insight">
            <span class="ykc-report-insight-title"><i class="bi bi-people" aria-hidden="true"></i>Ekip dağılımı</span>
            <div class="ykc-report-ranking">
                @if (Model.EkipOzetleri.Any())
                {
                    @foreach (var item in Model.EkipOzetleri.Take(3)) { <span><b>@Deger(item.Ad)</b><strong>@item.Sayi</strong></span> }
                }
                else { <small>Atanmış ekip bulunmuyor.</small> }
            </div>
        </div>
        <div class="ykc-report-insight">
            <span class="ykc-report-insight-title"><i class="bi bi-building-check" aria-hidden="true"></i>@(icOperasyonGorsun ? "Firma dağılımı" : "Süreç dağılımı")</span>
            <div class="ykc-report-ranking">
                @if (icOperasyonGorsun && Model.FirmaOzetleri.Any())
                {
                    @foreach (var item in Model.FirmaOzetleri.Take(3)) { <span><b>@Deger(item.Ad)</b><strong>@item.Sayi</strong></span> }
                }
                else if (Model.DurumOzetleri.Any())
                {
                    @foreach (var item in Model.DurumOzetleri.OrderByDescending(x => x.Sayi).Take(3)) { <span><b>@DurumYazi(item.Durum)</b><strong>@item.Sayi</strong></span> }
                }
                else { <small>Dağılım verisi bulunmuyor.</small> }
            </div>
        </div>
    </section>

    <details class="ykc-filter-panel" open="@(aktifFiltreler.Any() ? "open" : null)">
        <summary class="ykc-filter-bar">
                <span class="ykc-filter-leading"><i class="bi bi-sliders2"></i> Filtreler</span>
                <span class="ykc-filter-state">
                    @if (aktifFiltreler.Any())
                    {
                        @foreach (var item in aktifFiltreler.Take(5))
                        {
                            <span class="ykc-filter-chip"><b>@item.Etiket</b>@item.Deger</span>
                        }
                    }
                    else
                    {
                        <span class="ykc-filter-hint">@(sertifikaliFirmaMi ? "Tesisat, marka, durum veya tarih ile raporu daraltın." : "Firma, ekip, bölge, durum veya tarih ile raporu daraltın.")</span>
                    }
                </span>
                <span class="ykc-filter-chevron"><i class="bi bi-chevron-down"></i></span>
        </summary>
        <form method="get" action="@Url.Action("Raporlar", "Ykc")" class="ykc-filter-form">
            <input type="hidden" name="sayfaBoyutu" value="@sayfaBoyutu" />
            <div class="ykc-filter-grid">
                <div class="ykc-filter-field">
                    <label>Tesisat</label>
                    <input type="text" name="tesisatNo" value="@filtre.TesisatNo" placeholder="Tesisat no" />
                </div>
                @if (icOperasyonGorsun)
                {
                    <div class="ykc-filter-field">
                        <label>Firma</label>
                        <input type="text" name="firma" value="@filtre.Firma" placeholder="Firma adı" />
                    </div>
                    <div class="ykc-filter-field">
                        <label>Ekip</label>
                        <input type="text" name="ekip" value="@filtre.Ekip" placeholder="Ekip adı" />
                    </div>
                }
                <div class="ykc-filter-field">
                    <label>Marka</label>
                    <input type="text" name="marka" value="@filtre.Marka" placeholder="Marka" />
                </div>
                <div class="ykc-filter-field">
                    <label>İl</label>
                    <input type="text" name="il" value="@filtre.Il" placeholder="İl" />
                </div>
                <div class="ykc-filter-field">
                    <label>İlçe</label>
                    <input type="text" name="ilce" value="@filtre.Ilce" placeholder="İlçe" />
                </div>
                <div class="ykc-filter-field">
                    <label>Bölge</label>
                    <input type="text" name="bolge" value="@filtre.Bolge" placeholder="Bölge" />
                </div>
                <div class="ykc-filter-field">
                    <label>Durum</label>
                    <select name="durum">
                        <option value="">Tümü</option>
                        @foreach (var item in new[] {
                            new { Id = YkcDurumDegerleri.TalepAlindi, Ad = "Talep Alındı" },
                            new { Id = YkcDurumDegerleri.AtamaBekliyor, Ad = "İnceleniyor" },
                            new { Id = YkcDurumDegerleri.Atandi, Ad = "Randevu Oluşturuldu" },
                            new { Id = YkcDurumDegerleri.SahaIsleminde, Ad = "İşlem Devam Ediyor" },
                            new { Id = YkcDurumDegerleri.Reddedildi, Ad = "Reddedildi" },
                            new { Id = YkcDurumDegerleri.Tamamlandi, Ad = "Tamamlandı" },
                            new { Id = YkcDurumDegerleri.Iptal, Ad = "İptal" }
                        })
                        {
                            <option value="@item.Id" selected="@Secili(filtre.Durum == item.Id)">@item.Ad</option>
                        }
                    </select>
                </div>
                <div class="ykc-filter-field">
                    <label>Başlangıç</label>
                    <input type="date" name="bas" value="@filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="ykc-filter-field">
                    <label>Bitiş</label>
                    <input type="date" name="bit" value="@filtre.BitisTarihi?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="ykc-filter-actions">
                <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-funnel"></i> Uygula</button>
                <a class="df-btn df-btn-secondary" href="@Url.Action("Raporlar", "Ykc")"><i class="bi bi-x-lg"></i> Temizle</a>
            </div>
        </form>
    </details>

    <section class="ykc-data-panel ykc-results">
        <div class="ykc-data-toolbar">
            <div class="ykc-data-title-wrap">
                <span class="ykc-data-title-icon"><i class="bi bi-table"></i></span>
                <div>
                    <div class="ykc-data-title">Dönemsel Kayıtlar</div>
                </div>
            </div>
            <div class="ykc-header-actions">
                <span class="ykc-record-count"><i class="bi bi-database"></i> @ilkKayit-@sonKayit / @Model.Toplam kayıt</span>
                <span class="ykc-selected-count" data-ykc-selected-count>0 seçili</span>
                <button class="df-btn df-btn-sm ykc-export-action is-pdf" type="button" data-ykc-selected-export data-export-url="@pdfUrl" disabled title="Seçilen kayıtları PDF olarak indir"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Seçilen PDF</button>
                <button class="df-btn df-btn-sm ykc-export-action is-excel" type="button" data-ykc-selected-export data-export-url="@excelUrl" disabled title="Seçilen kayıtları Excel olarak indir"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Seçilen Excel</button>
                <a class="df-btn df-btn-sm ykc-export-action is-pdf @(Model.Toplam == 0 ? "is-disabled" : null)" href="@(Model.Toplam == 0 ? "#" : pdfUrl)" aria-disabled="@(Model.Toplam == 0 ? "true" : "false")" title="Filtrelenen kayıtları PDF olarak indir"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</a>
                <a class="df-btn df-btn-sm ykc-export-action is-excel @(Model.Toplam == 0 ? "is-disabled" : null)" href="@(Model.Toplam == 0 ? "#" : excelUrl)" aria-disabled="@(Model.Toplam == 0 ? "true" : "false")" title="Filtrelenen kayıtları Excel olarak indir"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</a>
            </div>
        </div>
        <div class="ykc-table-scroll">
            <table class="ykc-report-table @(icOperasyonGorsun ? "is-internal" : "is-firm")">
                <thead>
                    <tr>
                        <th class="ykc-report-select-cell"><input id="ykcReportSelectAll" type="checkbox" aria-label="Bu sayfadaki tüm rapor kayıtlarını seç" /></th>
                        <th>Kayıt</th>
                        <th>Abone İsmi</th>
                        <th>Tesisat Bilgileri</th>
                        @if (icOperasyonGorsun)
                        {
                            <th>Firma</th>
                        }
                        <th>Cihaz Türü</th>
                        @if (icOperasyonGorsun)
                        {
                            <th>Projedeki Cihaz</th>
                        }
                        <th>Yeni Kullanılan Cihaz</th>
                        <th>Randevu / Ekip</th>
                        <th>Talep / İmza Durumu</th>
                        <th>Detay</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Kayitlar.Any())
                    {
                        <tr><td colspan="@raporKolonSayisi"><div class="ykc-empty-state"><i class="bi bi-search"></i>Filtreye uygun cihaz değişim kaydı bulunamadı.</div></td></tr>
                    }
                    else
                    {
                        foreach (var kayit in Model.Kayitlar)
                        {
                            var yeniModelVar = !string.IsNullOrWhiteSpace(kayit.YeniModel)
                                && !string.Equals(kayit.YeniModel.Trim(), kayit.YeniMarka?.Trim(), StringComparison.OrdinalIgnoreCase)
                                && !string.Equals(kayit.YeniModel.Trim(), kayit.YeniCihazTipi?.Trim(), StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td class="ykc-report-select-cell" data-label="Seç"><input class="ykc-report-row-check" type="checkbox" value="@kayit.Id" aria-label="#@kayit.Id numaralı rapor kaydını seç" /></td>
                                <td data-label="Kayıt"><div class="ykc-cell-main"><span class="ykc-code">#@kayit.Id</span></div><div class="ykc-muted">@kayit.TalepTarihi.ToString("dd.MM.yyyy HH:mm")</div></td>
                                <td data-label="Abone İsmi"><div class="ykc-cell-main ykc-report-customer">@Deger(kayit.MusteriAdi)</div></td>
                                <td data-label="Tesisat Bilgileri"><dl class="ykc-id-list"><div><dt>Tesisat No:</dt><dd>@Deger(kayit.TesisatNo)</dd></div><div><dt>Abone No:</dt><dd>@Deger(kayit.AboneNo)</dd></div></dl></td>
                                @if (icOperasyonGorsun)
                                {
                                    <td data-label="Firma"><div class="ykc-cell-main">@Deger(kayit.FirmaAdi)</div>@if (!string.IsNullOrWhiteSpace(kayit.FirmaVergiNo)) { <div class="ykc-muted">VKN: @kayit.FirmaVergiNo</div> }@if (!string.IsNullOrWhiteSpace(kayit.FirmaFaaliyetIli)) { <div class="ykc-muted">@kayit.FirmaFaaliyetIli</div> }</td>
                                }
                                <td data-label="Cihaz Türü"><div class="ykc-cell-main">@Deger(kayit.YeniCihazTipi)</div>@if (icOperasyonGorsun && !string.Equals(kayit.EskiCihazTipi, kayit.YeniCihazTipi, StringComparison.OrdinalIgnoreCase)) { <div class="ykc-muted">Projede: @Deger(kayit.EskiCihazTipi)</div> }</td>
                                @if (icOperasyonGorsun)
                                {
                                    <td data-label="Projedeki Cihaz"><div class="ykc-device-column is-project"><strong>@Deger(kayit.EskiMarka)</strong><small>Kapasite: @Deger(kayit.EskiKapasite)</small><small>Baca tipi: @Deger(kayit.EskiBacaTipi)</small></div></td>
                                }
                                <td data-label="Yeni Kullanılan Cihaz"><div class="ykc-device-column is-new"><strong>@Deger(kayit.YeniMarka)</strong>@if (yeniModelVar) { <small>Model: @kayit.YeniModel</small> }<small>Kapasite: @Deger(kayit.YeniKapasite)</small><small>Baca tipi: @Deger(kayit.YeniBacaTipi)</small></div></td>
                                <td data-label="Randevu / Ekip">
                                    <div class="ykc-cell-main ykc-report-appointment">@RandevuYazi(kayit.RandevuTarihi, kayit.RandevuSaati, kayit.SiradakiKontrolNo)</div>
                                    @if (icOperasyonGorsun)
                                    {
                                        <div class="ykc-muted">@AtamaYazi(kayit.AtananEkip, kayit.Bolge)</div>
                                    }
                                </td>
                                <td data-label="Talep / İmza Durumu"><div class="ykc-report-process"><span class="ykc-report-state @DurumClass(kayit.Durum)"><i class="bi bi-circle-fill" aria-hidden="true"></i>@DurumYazi(kayit.Durum)</span><span class="ykc-report-form-state @ImzaDurumClass(kayit.Durum, kayit.ImzaliNihaiBelgeVar, kayit.ImzaDurumu)" title="@ImzaDurumYazi(kayit.Durum, kayit.ImzaliNihaiBelgeVar, kayit.ImzaDurumu)"><i class="@ImzaDurumIkonu(kayit.Durum, kayit.ImzaliNihaiBelgeVar, kayit.ImzaDurumu)" aria-hidden="true"></i>@ImzaDurumKisaYazi(kayit.Durum, kayit.ImzaliNihaiBelgeVar, kayit.ImzaDurumu)</span></div></td>
                                <td data-label="Detay">
                                    <button class="ykc-detail-action ykc-row-view-details"
                                            type="button"
                                            aria-label="#@kayit.Id numaralı kaydın özetini görüntüle"
                                            title="Kayıt özetini görüntüle"
                                            data-id="@kayit.Id"
                                            data-detail-url="@Url.Action("Detay", "Ykc", new { id = kayit.Id, kaynak = "rapor" })"
                                            data-tesisat="@Deger(kayit.TesisatNo)"
                                            data-firma="@Deger(kayit.FirmaAdi)"
                                            data-firma-vkn="@Deger(kayit.FirmaVergiNo)"
                                            data-firma-il="@Deger(kayit.FirmaFaaliyetIli)"
                                            data-sirket="@Deger(kayit.SirketAdi)"
                                            data-musteri="@Deger(kayit.MusteriAdi)"
                                            data-proje="@Deger(kayit.ProjeNo)"
                                            data-sayac="@Deger(kayit.SayacNo)"
                                            data-eski-cihaz="@(icOperasyonGorsun ? Deger(kayit.EskiCihazTipi) : "-")"
                                            data-yeni-cihaz="@Deger(kayit.YeniCihazTipi)"
                                            data-eski-marka="@(icOperasyonGorsun ? Deger(kayit.EskiMarka) : "-")"
                                            data-eski-kapasite="@(icOperasyonGorsun ? Deger(kayit.EskiKapasite) : "-")"
                                            data-eski-baca="@(icOperasyonGorsun ? Deger(kayit.EskiBacaTipi) : "-")"
                                            data-yeni-marka="@Deger(kayit.YeniMarka)"
                                            data-yeni-model="@(yeniModelVar ? kayit.YeniModel : "")"
                                            data-yeni-kapasite="@Deger(kayit.YeniKapasite)"
                                            data-yeni-baca="@Deger(kayit.YeniBacaTipi)"
                                            data-ikinci-el="@(kayit.IkinciElCihazMi == true ? "Evet" : "Hayır")"
                                            data-bolge="@Deger(kayit.Bolge)"
                                            data-ekip="@Deger(kayit.AtananEkip)"
                                            data-talep-tarihi="@kayit.TalepTarihi.ToString("dd.MM.yyyy HH:mm")"
                                            data-randevu="@RandevuYazi(kayit.RandevuTarihi, kayit.RandevuSaati, kayit.SiradakiKontrolNo)"
                                            data-durum="@DurumYazi(kayit.Durum)"
                                            data-durum-class="@DurumClass(kayit.Durum)"
                                            data-imza-durumu="@ImzaDurumYazi(kayit.Durum, kayit.ImzaliNihaiBelgeVar, kayit.ImzaDurumu)">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Toplam > 0)
        {
            <nav class="ykc-pager" aria-label="Rapor sayfaları">
                <span>@ilkKayit-@sonKayit arası gösteriliyor</span>
                <div class="ykc-pager-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm @(aktifSayfa == 1 ? "is-disabled" : "")" href="@(aktifSayfa == 1 ? "#" : SayfaUrl(aktifSayfa - 1))" aria-disabled="@(aktifSayfa == 1 ? "true" : "false")" title="Önceki sayfa"><i class="bi bi-chevron-left"></i></a>
                    @for (var sayfaNo = Math.Max(1, aktifSayfa - 2); sayfaNo <= Math.Min(toplamSayfa, aktifSayfa + 2); sayfaNo++)
                    {
                        <a class="ykc-page-number @(sayfaNo == aktifSayfa ? "is-active" : "")" href="@SayfaUrl(sayfaNo)" aria-current="@(sayfaNo == aktifSayfa ? "page" : null)">@sayfaNo</a>
                    }
                    <a class="df-btn df-btn-secondary df-btn-sm @(aktifSayfa == toplamSayfa ? "is-disabled" : "")" href="@(aktifSayfa == toplamSayfa ? "#" : SayfaUrl(aktifSayfa + 1))" aria-disabled="@(aktifSayfa == toplamSayfa ? "true" : "false")" title="Sonraki sayfa"><i class="bi bi-chevron-right"></i></a>
                </div>
            </nav>
        }
    </section>
</div>

<div class="ykc-report-modal" id="ykcReportDetailModal" aria-hidden="true">
    <div class="ykc-report-modal-backdrop" data-ykc-modal-close></div>
    <div class="ykc-report-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="ykcReportModalTitle" tabindex="-1">
        <div class="ykc-report-modal-header">
            <div class="ykc-modal-title-wrap">
                <div class="ykc-modal-icon"><i class="bi bi-eye"></i></div>
                <div>
                    <h3 class="ykc-modal-title" id="ykcReportModalTitle">Talep Detayı</h3>
                    <div class="ykc-modal-subtitle" id="ykcReportModalSubtitle">-</div>
                </div>
            </div>
            <button class="ykc-modal-close" type="button" data-ykc-modal-close aria-label="Kapat"><i class="bi bi-x-circle"></i></button>
        </div>
        <div class="ykc-report-modal-body">
            <div class="ykc-modal-stats">
                <div class="ykc-modal-stat ykc-modal-stat-primary"><i class="bi bi-activity"></i><div><small>Durum</small><strong><span class="df-pill" id="ykcModalDurum">-</span></strong></div></div>
                <div class="ykc-modal-stat ykc-modal-stat-date"><i class="bi bi-calendar2-check"></i><div><small>Randevu</small><strong id="ykcModalRandevu">-</strong></div></div>
                @if (icOperasyonGorsun)
                {
                    <div class="ykc-modal-stat ykc-modal-stat-route"><i class="bi bi-signpost-split"></i><div><small>Yönlendirme / Bölge</small><strong id="ykcModalEkipBolge">-</strong></div></div>
                }
                <div class="ykc-modal-stat ykc-modal-stat-created"><i class="bi bi-clock-history"></i><div><small>Talep Tarihi</small><strong id="ykcModalTalepOzetiTarihi">-</strong></div></div>
            </div>

            <div class="ykc-modal-grid">
                <section class="ykc-modal-section ykc-modal-section-customer">
                    <div class="ykc-modal-section-title"><i class="bi bi-person-vcard"></i> Tesisat ve Abone</div>
                    <div class="ykc-modal-info">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Tesisat</div><div class="ykc-modal-value" id="ykcModalTesisat">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Abone Adı Soyadı</div><div class="ykc-modal-value" id="ykcModalMusteri">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Proje</div><div class="ykc-modal-value" id="ykcModalProje">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Sayaç</div><div class="ykc-modal-value" id="ykcModalSayac">-</div></div>
                    </div>
                </section>

                <section class="ykc-modal-section ykc-modal-section-company">
                    <div class="ykc-modal-section-title"><i class="bi bi-building-check"></i> Firma Bilgileri</div>
                    <div class="ykc-modal-info">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Sertifikalı Firma</div><div class="ykc-modal-value" id="ykcModalFirma">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">VKN</div><div class="ykc-modal-value" id="ykcModalFirmaVkn">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Faaliyet İli</div><div class="ykc-modal-value" id="ykcModalFirmaIl">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Dağıtım Şirketi</div><div class="ykc-modal-value" id="ykcModalSirket">-</div></div>
                    </div>
                </section>

                <section class="ykc-modal-section ykc-modal-section-device">
                    <div class="ykc-modal-section-title"><i class="bi bi-arrow-left-right"></i> Cihaz Karşılaştırması</div>
                    <div class="ykc-modal-device-pair @(icOperasyonGorsun ? null : "is-single")">
                        @if (icOperasyonGorsun)
                        {
                            <div class="ykc-modal-device-side is-project">
                                <h4>Projedeki Cihaz</h4>
                                <dl>
                                    <div><dt>Tür</dt><dd id="ykcModalEskiTip">-</dd></div>
                                    <div><dt>Marka</dt><dd id="ykcModalEskiMarka">-</dd></div>
                                    <div><dt>Kapasite (kcal/h)</dt><dd id="ykcModalEskiKapasite">-</dd></div>
                                    <div><dt>Baca Tipi</dt><dd id="ykcModalEskiBaca">-</dd></div>
                                </dl>
                            </div>
                        }
                        <div class="ykc-modal-device-side is-new">
                            <h4>Yeni Kullanılan Cihaz</h4>
                            <dl>
                                <div><dt>Tür</dt><dd id="ykcModalYeniTip">-</dd></div>
                                <div><dt>Marka</dt><dd id="ykcModalYeniMarka">-</dd></div>
                                <div id="ykcModalYeniModelRow"><dt>Model</dt><dd id="ykcModalYeniModel">-</dd></div>
                                <div><dt>Kapasite (kcal/h)</dt><dd id="ykcModalYeniKapasite">-</dd></div>
                                <div><dt>Baca Tipi</dt><dd id="ykcModalYeniBaca">-</dd></div>
                            </dl>
                        </div>
                    </div>
                    <div class="ykc-modal-device-secondhand"><span>İkinci El Cihaz</span><strong id="ykcModalIkinciEl">-</strong></div>
                </section>

                <section class="ykc-modal-section ykc-modal-section-signature">
                    <div class="ykc-modal-section-title"><i class="bi bi-shield-check"></i> İmza Durumu</div>
                    <div class="ykc-modal-info full">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Dijital İmza</div><div class="ykc-modal-value" id="ykcModalImzaDurumu">-</div></div>
                    </div>
                </section>
            </div>
        </div>
        <div class="ykc-report-modal-footer">
            <button class="df-btn df-btn-secondary" type="button" data-ykc-modal-close>Kapat</button>
            <a class="df-btn df-btn-primary" id="ykcModalDetailLink" href="#"><i class="bi bi-arrow-right-circle"></i> Talep Detayını Aç</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
(function () {
            const selectAll = document.getElementById('ykcReportSelectAll');
            const rowChecks = Array.from(document.querySelectorAll('.ykc-report-row-check'));
            const selectedCount = document.querySelector('[data-ykc-selected-count]');
            const selectedExportButtons = Array.from(document.querySelectorAll('[data-ykc-selected-export]'));

            function selectedIds() {
                return rowChecks.filter(input => input.checked).map(input => input.value);
            }

            function updateSelection() {
                const ids = selectedIds();
                if (selectedCount) selectedCount.textContent = ids.length + ' seçili';
                selectedExportButtons.forEach(button => { button.disabled = ids.length === 0; });
                if (selectAll) {
                    selectAll.checked = rowChecks.length > 0 && ids.length === rowChecks.length;
                    selectAll.indeterminate = ids.length > 0 && ids.length < rowChecks.length;
                }
            }

            selectAll?.addEventListener('change', function () {
                rowChecks.forEach(input => { input.checked = selectAll.checked; });
                updateSelection();
            });
            rowChecks.forEach(input => input.addEventListener('change', updateSelection));
            selectedExportButtons.forEach(button => button.addEventListener('click', function () {
                const ids = selectedIds();
                if (ids.length === 0) return;
                const url = new URL(button.dataset.exportUrl, window.location.origin);
                url.searchParams.delete('ids');
                ids.forEach(id => url.searchParams.append('ids', id));
                window.location.assign(url.toString());
            }));
            updateSelection();

    var icOperasyonGorsun = @icOperasyonGorsun.ToString().ToLowerInvariant();
            const modal = document.getElementById('ykcReportDetailModal');
            const detailLink = document.getElementById('ykcModalDetailLink');
            const durum = document.getElementById('ykcModalDurum');
            let sonTetikleyici = null;

            function text(id, value) {
                const element = document.getElementById(id);
                if (element) {
                    element.textContent = value && value.trim ? value.trim() || '-' : value || '-';
                }
            }

            function birlestir(sol, sag) {
                const temizSol = (sol || '').trim();
                const temizSag = (sag || '').trim();
                if (!temizSol || temizSol === '-') {
                    return temizSag || '-';
                }
                if (!temizSag || temizSag === '-') {
                    return temizSol;
                }
                return temizSol + ' / ' + temizSag;
            }

            function ac(button) {
                const data = button.dataset;
                sonTetikleyici = button;

                text('ykcReportModalTitle', 'Talep #' + data.id + ' Detayı');
                text('ykcReportModalSubtitle', birlestir(data.firma, data.musteri));
                text('ykcModalRandevu', data.randevu);
                text('ykcModalEkipBolge', birlestir(data.ekip, data.bolge));
                text('ykcModalTalepOzetiTarihi', data.talepTarihi);
                text('ykcModalTesisat', data.tesisat);
                text('ykcModalMusteri', data.musteri);
                text('ykcModalProje', data.proje);
                text('ykcModalSayac', data.sayac);
                text('ykcModalFirma', data.firma);
                text('ykcModalFirmaVkn', data.firmaVkn);
                text('ykcModalFirmaIl', data.firmaIl);
                text('ykcModalSirket', data.sirket);
                if (icOperasyonGorsun) {
                    text('ykcModalEskiTip', data.eskiCihaz);
                    text('ykcModalEskiMarka', data.eskiMarka);
                    text('ykcModalEskiKapasite', data.eskiKapasite);
                    text('ykcModalEskiBaca', data.eskiBaca);
                }
                text('ykcModalYeniTip', data.yeniCihaz);
                text('ykcModalYeniMarka', data.yeniMarka);
                text('ykcModalYeniModel', data.yeniModel);
                document.getElementById('ykcModalYeniModelRow').hidden = !data.yeniModel?.trim();
                text('ykcModalYeniKapasite', data.yeniKapasite);
                text('ykcModalYeniBaca', data.yeniBaca);
                text('ykcModalIkinciEl', data.ikinciEl);
                text('ykcModalImzaDurumu', data.imzaDurumu);

                if (durum) {
                    durum.textContent = data.durum || '-';
                    durum.className = 'df-pill ' + (data.durumClass || 'df-pill-secondary');
                }

                if (detailLink) {
                    detailLink.href = data.detailUrl || ('/ykc/detay/' + data.id);
                }

                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
                modal.querySelector('button[data-ykc-modal-close]')?.focus();
            }

            function kapat() {
                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
                sonTetikleyici?.focus();
            }

            document.addEventListener('click', function (event) {
                const detailButton = event.target.closest('.ykc-row-view-details');
                if (detailButton) {
                    ac(detailButton);
                    return;
                }

                if (event.target.closest('[data-ykc-modal-close]')) {
                    kapat();
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && modal.classList.contains('is-open')) {
                    kapat();
                }
            });
        })();
    </script>
}
