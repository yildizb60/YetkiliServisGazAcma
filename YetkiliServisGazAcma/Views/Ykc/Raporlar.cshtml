@model YkcRaporSonuc
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var filtre = ViewBag.Filtre as YkcTalepListeFiltre ?? new YkcTalepListeFiltre();
    var yetkiliServisMi = User.IsInRole("SertifikaliFirma");
    var icOperasyonGorsun = !yetkiliServisMi;
    var listelenen = Model.Kayitlar.Count;
    var hedefFiltresiGoster = false;
    var aktifFiltreler = new List<(string Etiket, string Deger)>();

    void AktifFiltreEkle(string etiket, string? deger)
    {
        if (!string.IsNullOrWhiteSpace(deger))
            aktifFiltreler.Add((etiket, deger));
    }

    AktifFiltreEkle("Tesisat", filtre.TesisatNo);
    AktifFiltreEkle("Firma", filtre.Firma);
    AktifFiltreEkle("Ekip", filtre.Ekip);
    AktifFiltreEkle("Marka", filtre.Marka);
    AktifFiltreEkle("İl", filtre.Il);
    AktifFiltreEkle("İlçe", filtre.Ilce);
    AktifFiltreEkle("Bölge", filtre.Bolge);
    if (filtre.Durum.HasValue)
        AktifFiltreEkle("Durum", DurumYazi(filtre.Durum.Value));
    if (filtre.BaslangicTarihi.HasValue)
        AktifFiltreEkle("Başlangıç", filtre.BaslangicTarihi.Value.ToString("dd.MM.yyyy"));
    if (filtre.BitisTarihi.HasValue)
        AktifFiltreEkle("Bitiş", filtre.BitisTarihi.Value.ToString("dd.MM.yyyy"));
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string? Secili(bool kosul) => kosul ? "selected" : null;

    private static int DurumToplam(IEnumerable<YkcRaporDurumOzetDto> ozetler, params int[] durumlar)
    {
        return ozetler.Where(x => durumlar.Contains(x.Durum)).Sum(x => x.Sayi);
    }

    private static string RandevuYazi(DateTime? tarih, string? saat)
    {
        if (!tarih.HasValue && string.IsNullOrWhiteSpace(saat))
            return "-";

        return string.Join(" ", new[]
        {
            tarih?.ToString("dd.MM.yyyy"),
            string.IsNullOrWhiteSpace(saat) ? null : saat
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string DurumYazi(int durum)
    {
        return durum switch
        {
            YkcDurumDegerleri.TalepAlindi => "Beklemede",
            YkcDurumDegerleri.AtamaBekliyor => "İncelemede",
            YkcDurumDegerleri.Atandi => "Randevu Verildi",
            YkcDurumDegerleri.SahaIsleminde => "Saha İşleminde",
            YkcDurumDegerleri.Reddedildi => "Reddedildi",
            YkcDurumDegerleri.Tamamlandi => "Tamamlandı",
            YkcDurumDegerleri.Iptal => "İptal",
            _ => "Bilinmiyor"
        };
    }

    private static string DurumClass(int durum)
    {
        return durum switch
        {
            YkcDurumDegerleri.Tamamlandi => "df-pill-success",
            YkcDurumDegerleri.Reddedildi or YkcDurumDegerleri.Iptal => "df-pill-danger",
            YkcDurumDegerleri.Atandi or YkcDurumDegerleri.SahaIsleminde => "df-pill-primary",
            _ => "df-pill-warning"
        };
    }

    private static string HedefYazi(string? hedef)
    {
        return hedef switch
        {
            YkcHedefUygulamaDegerleri.YonetimPaneli => "Yönetim Paneli",
            YkcHedefUygulamaDegerleri.DogalgazMobileApp => "Doğalgaz Mobile App",
            YkcHedefUygulamaDegerleri.Crm187 => "CRM187",
            _ => Deger(hedef)
        };
    }
}

@section Styles {
    <style>
        .ykc-report-stack { display: grid; gap: 10px; }
        .ykc-report-hero { overflow: hidden; border-color: #dfe6f2; }
        .ykc-report-hero .df-panel-head { align-items: flex-start; background: linear-gradient(180deg, #ffffff 0%, #f7f9fd 100%); padding: 15px 20px; }
        .ykc-report-hero .df-panel-title { font-size: 19px; }
        .ykc-report-hero .df-panel-subtitle { font-size: 12px; margin-top: 4px; }
        .ykc-report-metrics { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 9px; padding: 0 20px 14px; }
        .ykc-report-metric { position: relative; min-width: 0; border: 1px solid #e5ebf4; border-radius: 8px; background: #fff; padding: 10px 13px 10px 15px; box-shadow: 0 8px 18px rgba(13, 34, 112, .04); }
        .ykc-report-metric::before { content: ""; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; border-radius: 999px; background: var(--report-accent, var(--df-primary)); }
        .ykc-report-label { color: #62708a; font-size: 10.5px; font-weight: 850; text-transform: uppercase; letter-spacing: .03em; }
        .ykc-report-value { color: #172033; font-size: 22px; font-weight: 900; line-height: 1; margin-top: 6px; }

        .ykc-report-filter-panel { background: #fff; border: 1px solid var(--df-border); border-radius: 8px; overflow: hidden; box-shadow: 0 10px 24px rgba(13, 34, 112, .045); }
        .ykc-report-filter-panel summary { list-style: none; cursor: pointer; user-select: none; }
        .ykc-report-filter-panel summary::-webkit-details-marker { display: none; }
        .ykc-filter-summary { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px; min-height: 48px; padding: 10px 16px; }
        .ykc-filter-title { display: flex; align-items: center; gap: 9px; color: var(--df-text); font-size: 14px; font-weight: 900; }
        .ykc-filter-title::before { content: ""; width: 7px; height: 20px; border-radius: 999px; background: var(--df-primary); }
        .ykc-filter-toggle { color: var(--df-primary); border: 1px solid #d9e2f1; background: #fff; border-radius: 999px; padding: 6px 10px; font-size: 11px; font-weight: 900; }
        .ykc-report-filter-panel[open] .ykc-filter-toggle::after { content: "Kapat"; }
        .ykc-report-filter-panel:not([open]) .ykc-filter-toggle::after { content: "Filtreleri aç"; }
        .ykc-active-filters { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; min-width: 0; }
        .ykc-filter-empty { color: #72809a; font-size: 12px; font-weight: 700; }
        .ykc-filter-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 25px; padding: 3px 9px; border-radius: 999px; background: #eef4ff; color: #33415c; border: 1px solid #d4e0f7; font-size: 11px; font-weight: 750; }
        .ykc-filter-chip b { color: var(--df-primary); font-weight: 900; }
        .ykc-report-filter-form { border-top: 1px solid #edf2f7; padding: 14px 16px 16px; }
        .ykc-report-filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; align-items: end; }
        .ykc-report-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
        .ykc-report-field label { font-size: 10.5px; color: #68758c; font-weight: 850; text-transform: uppercase; letter-spacing: .035em; }
        .ykc-report-field input, .ykc-report-field select { height: 36px; padding: 8px 10px; border: 1.5px solid #dfe5ee; border-radius: 8px; font-size: 13px; outline: none; color: var(--df-text); background: #fff; width: 100%; min-width: 0; }
        .ykc-report-field input:focus, .ykc-report-field select:focus { border-color: var(--df-primary); box-shadow: 0 0 0 3px rgba(46, 78, 200, .10); }
        .ykc-filter-actions { display: flex; gap: 10px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #edf2f7; }

        .ykc-summary-strip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
        .ykc-summary-group { display: flex; align-items: center; gap: 7px; min-width: 0; min-height: 44px; background: #fff; border: 1px solid var(--df-border); border-radius: 8px; padding: 8px 11px; box-shadow: 0 8px 18px rgba(13, 34, 112, .035); overflow: hidden; }
        .ykc-summary-group > strong { color: var(--df-text); font-size: 12px; font-weight: 900; white-space: nowrap; }
        .ykc-summary-tags { display: flex; align-items: center; gap: 6px; min-width: 0; overflow: hidden; }
        .ykc-summary-tag { display: inline-flex; align-items: center; gap: 6px; min-height: 24px; max-width: 160px; padding: 3px 8px; border: 1px solid #e4ebf5; border-radius: 999px; background: #fbfcff; color: #4b5a72; font-size: 11px; font-weight: 750; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .ykc-summary-tag b { color: var(--df-text); font-weight: 900; }

        .ykc-results { overflow: hidden; }
        .ykc-results .section-head { padding: 12px 16px; }
        .ykc-limit-note { color: var(--df-muted); font-size: 12px; padding: 0 16px 11px; border-bottom: 1px solid #edf2f7; }
        .ykc-report-head, .ykc-report-row { display: grid; grid-template-columns: 1fr 1.35fr 1.2fr 1.2fr 1.05fr .72fr; gap: 12px; align-items: center; }
        .ykc-report-head { padding: 10px 16px; background: #f4f7fb; color: #566280; font-size: 10.5px; font-weight: 900; text-transform: uppercase; letter-spacing: .035em; border-bottom: 1px solid var(--df-border); }
        .ykc-report-row { margin: 7px 10px; padding: 10px 12px; border: 1px solid #e8edf5; border-radius: 8px; background: #fff; color: var(--df-text-soft); font-size: 13px; box-shadow: 0 8px 18px rgba(13, 34, 112, .032); }
        .ykc-report-row:hover { border-color: #d6def0; background: #fbfcff; }
        .ykc-cell-main { color: var(--df-text); font-weight: 850; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .ykc-code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; color: var(--df-primary); font-weight: 900; }
        .ykc-muted { color: var(--df-muted); font-size: 12px; margin-top: 3px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .ykc-file-pills { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
        .ykc-empty { padding: 42px; text-align: center; color: var(--df-muted); }
        .ykc-row-view-details { white-space: nowrap; color: var(--df-primary); border-color: #cfd9f7; background: #f8faff; }
        .ykc-row-view-details:hover { color: #fff; border-color: var(--df-primary); background: var(--df-primary); }

        .ykc-report-modal { position: fixed; inset: 0; z-index: 1080; display: none; align-items: center; justify-content: center; padding: 24px; }
        .ykc-report-modal.is-open { display: flex; }
        .ykc-report-modal-backdrop { position: absolute; inset: 0; background: rgba(17, 29, 56, .42); backdrop-filter: blur(3px); }
        .ykc-report-modal-dialog { position: relative; z-index: 1; width: min(940px, 100%); max-height: calc(100vh - 48px); display: flex; flex-direction: column; background: #fff; border: 1px solid #dfe6f2; border-radius: 10px; overflow: hidden; box-shadow: 0 26px 70px rgba(13, 34, 112, .22); }
        .ykc-report-modal-header { min-height: 72px; padding: 16px 18px; display: flex; align-items: center; justify-content: space-between; gap: 14px; border-bottom: 1px solid #e6edf7; background: linear-gradient(180deg, #ffffff 0%, #f7f9fd 100%); }
        .ykc-modal-title-wrap { display: flex; align-items: center; gap: 12px; min-width: 0; }
        .ykc-modal-icon { width: 44px; height: 44px; border-radius: 10px; display: grid; place-items: center; color: #fff; background: var(--df-primary); box-shadow: 0 12px 24px rgba(46, 78, 200, .18); flex: 0 0 auto; }
        .ykc-modal-title { color: var(--df-text); font-size: 18px; font-weight: 900; margin: 0; line-height: 1.2; }
        .ykc-modal-subtitle { color: var(--df-muted); font-size: 12px; margin-top: 4px; overflow-wrap: anywhere; }
        .ykc-modal-close { width: 36px; height: 36px; border: 1px solid #d9e2f1; border-radius: 8px; background: #fff; color: var(--df-text-soft); display: grid; place-items: center; cursor: pointer; }
        .ykc-modal-close:hover { color: var(--df-primary); border-color: var(--df-primary); background: var(--df-primary-soft); }
        .ykc-report-modal-body { padding: 16px 18px; overflow-y: auto; display: grid; gap: 14px; }
        .ykc-modal-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; }
        .ykc-modal-stat { border: 1px solid #e5ebf4; border-radius: 8px; background: #fff; padding: 10px 12px; min-width: 0; box-shadow: 0 8px 18px rgba(13, 34, 112, .035); }
        .ykc-modal-stat small { display: block; color: #68758c; font-size: 10.5px; font-weight: 850; text-transform: uppercase; letter-spacing: .035em; }
        .ykc-modal-stat strong { display: block; color: var(--df-text); font-size: 13px; font-weight: 900; margin-top: 5px; overflow-wrap: anywhere; }
        .ykc-modal-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        .ykc-modal-section { border: 1px solid #e5ebf4; border-radius: 8px; overflow: hidden; background: #fff; }
        .ykc-modal-section-title { padding: 11px 13px; border-bottom: 1px solid #edf2f7; color: var(--df-text); font-size: 13px; font-weight: 900; display: flex; align-items: center; gap: 8px; }
        .ykc-modal-section-title::before { content: ""; width: 6px; height: 18px; border-radius: 999px; background: var(--df-primary); }
        .ykc-modal-info { padding: 12px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
        .ykc-modal-info.full { grid-template-columns: 1fr; }
        .ykc-modal-item { min-width: 0; border: 1px solid #edf2f7; border-radius: 8px; background: #fbfcff; padding: 9px 10px; }
        .ykc-modal-label { color: #68758c; font-size: 10px; font-weight: 850; text-transform: uppercase; letter-spacing: .035em; }
        .ykc-modal-value { color: var(--df-text); font-size: 13px; font-weight: 750; margin-top: 5px; overflow-wrap: anywhere; }
        .ykc-report-modal-footer { padding: 13px 18px; border-top: 1px solid #e6edf7; background: #fbfcff; display: flex; justify-content: flex-end; gap: 10px; }

        @@media (max-width: 1320px) {
            .ykc-report-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .ykc-summary-strip { grid-template-columns: 1fr; }
            .ykc-report-head { display: none; }
            .ykc-report-row { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
            .ykc-report-row > div::before { content: attr(data-label); display: block; color: var(--df-muted); font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 3px; }
        }
        @@media (max-width: 760px) {
            .ykc-report-metrics, .ykc-report-row, .ykc-filter-summary, .ykc-modal-stats, .ykc-modal-grid, .ykc-modal-info { grid-template-columns: 1fr; }
            .ykc-filter-actions, .df-actions { flex-direction: column; align-items: stretch; }
            .ykc-report-modal { padding: 12px; }
            .ykc-report-modal-footer { flex-direction: column; }
        }
    </style>
}

<div class="ykc-report-stack">
    <section class="df-page-panel ykc-report-hero">
        <div class="df-panel-head">
            <div>
                <h2 class="df-panel-title">Cihaz Değişim Raporları</h2>
                <div class="df-panel-subtitle">Firma, ekip, tesisat, marka ve tarih aralığına göre cihaz değişim kayıtlarını izleyin.</div>
            </div>
            <div class="df-actions">
                <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/talepler">Talep Listesi</a>
            </div>
        </div>
        <div class="ykc-report-metrics">
            <div class="ykc-report-metric" style="--report-accent:#2e4ec8;"><div class="ykc-report-label">Toplam</div><div class="ykc-report-value">@Model.Toplam</div></div>
            <div class="ykc-report-metric" style="--report-accent:#dc8e0d;"><div class="ykc-report-label">İncelemede</div><div class="ykc-report-value">@DurumToplam(Model.DurumOzetleri, YkcDurumDegerleri.TalepAlindi, YkcDurumDegerleri.AtamaBekliyor)</div></div>
            <div class="ykc-report-metric" style="--report-accent:#7056d8;"><div class="ykc-report-label">Randevu / Saha</div><div class="ykc-report-value">@DurumToplam(Model.DurumOzetleri, YkcDurumDegerleri.Atandi, YkcDurumDegerleri.SahaIsleminde)</div></div>
            <div class="ykc-report-metric" style="--report-accent:#1dbb7a;"><div class="ykc-report-label">Tamamlanan</div><div class="ykc-report-value">@DurumToplam(Model.DurumOzetleri, YkcDurumDegerleri.Tamamlandi)</div></div>
            <div class="ykc-report-metric" style="--report-accent:#d42828;"><div class="ykc-report-label">Red / İptal</div><div class="ykc-report-value">@DurumToplam(Model.DurumOzetleri, YkcDurumDegerleri.Reddedildi, YkcDurumDegerleri.Iptal)</div></div>
        </div>
    </section>

    <details class="ykc-report-filter-panel">
        <summary>
            <div class="ykc-filter-summary">
                <div class="ykc-filter-title">Filtreler</div>
                <div class="ykc-active-filters">
                    @if (aktifFiltreler.Any())
                    {
                        @foreach (var item in aktifFiltreler)
                        {
                            <span class="ykc-filter-chip"><b>@item.Etiket</b>@item.Deger</span>
                        }
                    }
                    else
                    {
                        <span class="ykc-filter-empty">Filtre alanları kapalı. Açınca tesisat, firma, ekip, tarih ve durum alanları görünür.</span>
                    }
                </div>
                <span class="ykc-filter-toggle"></span>
            </div>
        </summary>
        <form method="get" action="/ykc/raporlar" class="ykc-report-filter-form">
            <div class="ykc-report-filter-grid">
                <div class="ykc-report-field">
                    <label>Tesisat</label>
                    <input type="text" name="tesisatNo" value="@filtre.TesisatNo" placeholder="Tesisat no" />
                </div>
                @if (icOperasyonGorsun)
                {
                    <div class="ykc-report-field">
                        <label>Firma</label>
                        <input type="text" name="firma" value="@filtre.Firma" placeholder="Firma adı" />
                    </div>
                    <div class="ykc-report-field">
                        <label>Ekip</label>
                        <input type="text" name="ekip" value="@filtre.Ekip" placeholder="Ekip adı" />
                    </div>
                }
                <div class="ykc-report-field">
                    <label>Marka</label>
                    <input type="text" name="marka" value="@filtre.Marka" placeholder="Marka" />
                </div>
                <div class="ykc-report-field">
                    <label>İl</label>
                    <input type="text" name="il" value="@filtre.Il" placeholder="İl" />
                </div>
                <div class="ykc-report-field">
                    <label>İlçe</label>
                    <input type="text" name="ilce" value="@filtre.Ilce" placeholder="İlçe" />
                </div>
                <div class="ykc-report-field">
                    <label>Bölge</label>
                    <input type="text" name="bolge" value="@filtre.Bolge" placeholder="Bölge" />
                </div>
                @if (hedefFiltresiGoster && icOperasyonGorsun)
                {
                    <div class="ykc-report-field">
                        <label>Hedef</label>
                        <select name="hedefUygulama">
                            <option value="">Tümü</option>
                            <option value="@YkcHedefUygulamaDegerleri.YonetimPaneli" selected="@Secili(filtre.HedefUygulama == YkcHedefUygulamaDegerleri.YonetimPaneli)">Yönetim Paneli</option>
                            <option value="@YkcHedefUygulamaDegerleri.DogalgazMobileApp" selected="@Secili(filtre.HedefUygulama == YkcHedefUygulamaDegerleri.DogalgazMobileApp)">Doğalgaz Mobile App</option>
                            <option value="@YkcHedefUygulamaDegerleri.Crm187" selected="@Secili(filtre.HedefUygulama == YkcHedefUygulamaDegerleri.Crm187)">CRM187</option>
                        </select>
                    </div>
                }
                <div class="ykc-report-field">
                    <label>Durum</label>
                    <select name="durum">
                        <option value="">Tümü</option>
                        @foreach (var item in new[] {
                            new { Id = YkcDurumDegerleri.TalepAlindi, Ad = "Beklemede" },
                            new { Id = YkcDurumDegerleri.AtamaBekliyor, Ad = "İç Tesisat İncelemesinde" },
                            new { Id = YkcDurumDegerleri.Atandi, Ad = "Randevu Verildi" },
                            new { Id = YkcDurumDegerleri.SahaIsleminde, Ad = "Saha İşleminde" },
                            new { Id = YkcDurumDegerleri.Reddedildi, Ad = "Reddedildi" },
                            new { Id = YkcDurumDegerleri.Tamamlandi, Ad = "Tamamlandı" },
                            new { Id = YkcDurumDegerleri.Iptal, Ad = "İptal" }
                        })
                        {
                            <option value="@item.Id" selected="@Secili(filtre.Durum == item.Id)">@item.Ad</option>
                        }
                    </select>
                </div>
                <div class="ykc-report-field">
                    <label>Başlangıç</label>
                    <input type="date" name="bas" value="@filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="ykc-report-field">
                    <label>Bitiş</label>
                    <input type="date" name="bit" value="@filtre.BitisTarihi?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="ykc-filter-actions">
                <button class="df-btn df-btn-primary" type="submit">Raporla</button>
                <a class="df-btn df-btn-secondary" href="/ykc/raporlar">Temizle</a>
            </div>
        </form>
    </details>

    <section class="ykc-summary-strip">
        <div class="ykc-summary-group">
            <strong>Durum</strong>
            <div class="ykc-summary-tags">
                @foreach (var durum in Model.DurumOzetleri.OrderBy(x => x.Durum))
                {
                    <span class="ykc-summary-tag">@DurumYazi(durum.Durum) <b>@durum.Sayi</b></span>
                }
            </div>
        </div>
        @if (hedefFiltresiGoster)
        {
            <div class="ykc-summary-group">
                <strong>Hedef</strong>
                <div class="ykc-summary-tags">
                    @foreach (var hedef in Model.HedefOzetleri.OrderByDescending(x => x.Sayi))
                    {
                        <span class="ykc-summary-tag">@HedefYazi(hedef.Ad) <b>@hedef.Sayi</b></span>
                    }
                </div>
            </div>
        }
        <div class="ykc-summary-group">
            <strong>Ekip</strong>
            <div class="ykc-summary-tags">
                @foreach (var ekip in Model.EkipOzetleri)
                {
                    <span class="ykc-summary-tag">@Deger(ekip.Ad) <b>@ekip.Sayi</b></span>
                }
            </div>
        </div>
    </section>

    <section class="section ykc-results">
        <div class="section-head">
            <div class="section-title">Cihaz Değişim Kayıtları</div>
            <span class="section-sayi">@listelenen / @Model.Toplam kayıt</span>
        </div>
        <div class="ykc-limit-note">Filtreye uyan ilk @Model.KayitLimiti kayıt listelenir. Daha dar sonuç için tarih, firma, ekip veya tesisat filtresi kullanabilirsiniz.</div>
        <div class="ykc-report-head">
            <div>Tesisat / Form</div>
            <div>Firma / Müşteri</div>
            <div>Cihaz</div>
            <div>Randevu / Ekip</div>
            <div>Durum / Belge</div>
            <div>İşlem</div>
        </div>
        @if (!Model.Kayitlar.Any())
        {
            <div class="ykc-empty">Filtreye uygun cihaz değişim kaydı bulunamadı.</div>
        }
        else
        {
            foreach (var kayit in Model.Kayitlar)
            {
                <div class="ykc-report-row">
                    <div data-label="Tesisat / Form">
                        <div class="ykc-cell-main"><span class="ykc-code">@Deger(kayit.TesisatNo)</span></div>
                        <div class="ykc-muted">FR265 #@kayit.Id · @kayit.TalepTarihi.ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                    <div data-label="Firma / Müşteri">
                        <div class="ykc-cell-main">@Deger(kayit.FirmaAdi)</div>
                        <div class="ykc-muted">@Deger(kayit.MusteriAdi)</div>
                    </div>
                    <div data-label="Cihaz">
                        <div class="ykc-cell-main" title="@($"{kayit.EskiCihazTipi} -> {kayit.YeniCihazTipi}")">@Deger(kayit.EskiCihazTipi) → @Deger(kayit.YeniCihazTipi)</div>
                        <div class="ykc-muted" title="@($"{kayit.EskiMarka} -> {kayit.YeniMarka} / {kayit.YeniModel}")">@Deger(kayit.EskiMarka) → @Deger(kayit.YeniMarka) · @Deger(kayit.YeniModel)</div>
                    </div>
                    <div data-label="Randevu / Ekip">
                        <div class="ykc-cell-main">@RandevuYazi(kayit.RandevuTarihi, kayit.RandevuSaati)</div>
                        <div class="ykc-muted">@Deger(kayit.AtananEkip) / @Deger(kayit.Bolge)</div>
                    </div>
                    <div data-label="Durum / Belge">
                        <span class="df-pill @DurumClass(kayit.Durum)">@DurumYazi(kayit.Durum)</span>
                        <div class="ykc-file-pills">
                            <span class="df-pill @(kayit.FirmaFormuVar ? "df-pill-success" : "df-pill-warning")">Geçici Arşiv Belgesi</span>
                            <span class="df-pill @(kayit.SahaFormuVar ? "df-pill-success" : "df-pill-warning")">İmzalı Nihai Belge</span>
                        </div>
                    </div>
                    <div data-label="İşlem">
                        <button class="df-btn df-btn-secondary df-btn-sm ykc-row-view-details"
                                type="button"
                                data-id="@kayit.Id"
                                data-detail-url="/ykc/detay/@kayit.Id"
                                data-tesisat="@Deger(kayit.TesisatNo)"
                                data-firma="@Deger(kayit.FirmaAdi)"
                                data-sirket="@Deger(kayit.SirketAdi)"
                                data-musteri="@Deger(kayit.MusteriAdi)"
                                data-proje="@Deger(kayit.ProjeNo)"
                                data-sayac="@Deger(kayit.SayacNo)"
                                data-eski-cihaz="@Deger(kayit.EskiCihazTipi)"
                                data-yeni-cihaz="@Deger(kayit.YeniCihazTipi)"
                                data-eski-marka="@Deger(kayit.EskiMarka)"
                                data-yeni-marka="@Deger(kayit.YeniMarka)"
                                data-yeni-model="@Deger(kayit.YeniModel)"
                                data-yeni-kapasite="@Deger(kayit.YeniKapasite)"
                                data-bolge="@Deger(kayit.Bolge)"
                                data-ekip="@Deger(kayit.AtananEkip)"
                                data-talep-tarihi="@kayit.TalepTarihi.ToString("dd.MM.yyyy HH:mm")"
                                data-randevu="@RandevuYazi(kayit.RandevuTarihi, kayit.RandevuSaati)"
                                data-durum="@DurumYazi(kayit.Durum)"
                                data-durum-class="@DurumClass(kayit.Durum)"
                                data-firma-formu="@(kayit.FirmaFormuVar ? "Var" : "Yok")"
                                data-imzali-belge="@(kayit.SahaFormuVar ? "Var" : "Yok")">
                            <i class="bi bi-eye"></i> Detay Gör
                        </button>
                    </div>
                </div>
            }
        }
    </section>
</div>

<div class="ykc-report-modal" id="ykcReportDetailModal" aria-hidden="true">
    <div class="ykc-report-modal-backdrop" data-ykc-modal-close></div>
    <div class="ykc-report-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="ykcReportModalTitle">
        <div class="ykc-report-modal-header">
            <div class="ykc-modal-title-wrap">
                <div class="ykc-modal-icon"><i class="bi bi-eye"></i></div>
                <div>
                    <h3 class="ykc-modal-title" id="ykcReportModalTitle">Talep Detayı</h3>
                    <div class="ykc-modal-subtitle" id="ykcReportModalSubtitle">-</div>
                </div>
            </div>
            <button class="ykc-modal-close" type="button" data-ykc-modal-close aria-label="Kapat"><i class="bi bi-x-circle"></i></button>
        </div>
        <div class="ykc-report-modal-body">
            <div class="ykc-modal-stats">
                <div class="ykc-modal-stat"><small>Durum</small><strong><span class="df-pill" id="ykcModalDurum">-</span></strong></div>
                <div class="ykc-modal-stat"><small>Randevu</small><strong id="ykcModalRandevu">-</strong></div>
                <div class="ykc-modal-stat"><small>Ekip / Bölge</small><strong id="ykcModalEkipBolge">-</strong></div>
                <div class="ykc-modal-stat"><small>Talep Tarihi</small><strong id="ykcModalTalepOzetiTarihi">-</strong></div>
            </div>

            <div class="ykc-modal-grid">
                <section class="ykc-modal-section">
                    <div class="ykc-modal-section-title">Tesisat ve Müşteri</div>
                    <div class="ykc-modal-info">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Tesisat</div><div class="ykc-modal-value" id="ykcModalTesisat">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Müşteri</div><div class="ykc-modal-value" id="ykcModalMusteri">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Proje</div><div class="ykc-modal-value" id="ykcModalProje">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Sayaç</div><div class="ykc-modal-value" id="ykcModalSayac">-</div></div>
                    </div>
                </section>

                <section class="ykc-modal-section">
                    <div class="ykc-modal-section-title">Firma ve Kapsam</div>
                    <div class="ykc-modal-info">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Firma</div><div class="ykc-modal-value" id="ykcModalFirma">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Şirket</div><div class="ykc-modal-value" id="ykcModalSirket">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Talep Tarihi</div><div class="ykc-modal-value" id="ykcModalTalepTarihi">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Kayıt</div><div class="ykc-modal-value" id="ykcModalKayit">-</div></div>
                    </div>
                </section>

                <section class="ykc-modal-section">
                    <div class="ykc-modal-section-title">Cihaz Bilgisi</div>
                    <div class="ykc-modal-info">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Eski Cihaz</div><div class="ykc-modal-value" id="ykcModalEskiCihaz">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Yeni Cihaz</div><div class="ykc-modal-value" id="ykcModalYeniCihaz">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Marka Değişimi</div><div class="ykc-modal-value" id="ykcModalMarka">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Yeni Kapasite</div><div class="ykc-modal-value" id="ykcModalKapasite">-</div></div>
                    </div>
                </section>

                <section class="ykc-modal-section">
                    <div class="ykc-modal-section-title">Belge Durumu</div>
                    <div class="ykc-modal-info">
                        <div class="ykc-modal-item"><div class="ykc-modal-label">Geçici Arşiv Belgesi</div><div class="ykc-modal-value" id="ykcModalFirmaFormu">-</div></div>
                        <div class="ykc-modal-item"><div class="ykc-modal-label">İmzalı Nihai Belge</div><div class="ykc-modal-value" id="ykcModalImzaliBelge">-</div></div>
                    </div>
                </section>
            </div>
        </div>
        <div class="ykc-report-modal-footer">
            <button class="df-btn df-btn-secondary" type="button" data-ykc-modal-close>Kapat</button>
            <a class="df-btn df-btn-primary" id="ykcModalDetailLink" href="#">Tam Detaya Git</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById('ykcReportDetailModal');
            const detailLink = document.getElementById('ykcModalDetailLink');
            const durum = document.getElementById('ykcModalDurum');

            function text(id, value) {
                const element = document.getElementById(id);
                if (element) {
                    element.textContent = value && value.trim ? value.trim() || '-' : value || '-';
                }
            }

            function birlestir(sol, sag) {
                const temizSol = (sol || '').trim();
                const temizSag = (sag || '').trim();
                if (!temizSol || temizSol === '-') {
                    return temizSag || '-';
                }
                if (!temizSag || temizSag === '-') {
                    return temizSol;
                }
                return temizSol + ' / ' + temizSag;
            }

            function ac(button) {
                const data = button.dataset;

                text('ykcReportModalTitle', 'FR265 #' + data.id + ' Talep Detayı');
                text('ykcReportModalSubtitle', birlestir(data.firma, data.musteri));
                text('ykcModalRandevu', data.randevu);
                text('ykcModalEkipBolge', birlestir(data.ekip, data.bolge));
                text('ykcModalTalepOzetiTarihi', data.talepTarihi);
                text('ykcModalTesisat', data.tesisat);
                text('ykcModalMusteri', data.musteri);
                text('ykcModalProje', data.proje);
                text('ykcModalSayac', data.sayac);
                text('ykcModalFirma', data.firma);
                text('ykcModalSirket', data.sirket);
                text('ykcModalTalepTarihi', data.talepTarihi);
                text('ykcModalKayit', 'FR265 #' + data.id);
                text('ykcModalEskiCihaz', birlestir(data.eskiCihaz, data.eskiMarka));
                text('ykcModalYeniCihaz', birlestir(data.yeniCihaz, birlestir(data.yeniMarka, data.yeniModel)));
                text('ykcModalMarka', (data.eskiMarka || '-') + ' -> ' + (data.yeniMarka || '-'));
                text('ykcModalKapasite', data.yeniKapasite);
                text('ykcModalFirmaFormu', data.firmaFormu);
                text('ykcModalImzaliBelge', data.imzaliBelge);

                if (durum) {
                    durum.textContent = data.durum || '-';
                    durum.className = 'df-pill ' + (data.durumClass || 'df-pill-secondary');
                }

                if (detailLink) {
                    detailLink.href = data.detailUrl || ('/ykc/detay/' + data.id);
                }

                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }

            function kapat() {
                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            }

            document.addEventListener('click', function (event) {
                const detailButton = event.target.closest('.ykc-row-view-details');
                if (detailButton) {
                    ac(detailButton);
                    return;
                }

                if (event.target.closest('[data-ykc-modal-close]')) {
                    kapat();
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && modal.classList.contains('is-open')) {
                    kapat();
                }
            });
        })();
    </script>
}
