@model YkcRaporSonuc
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var filtre = ViewBag.Filtre as YkcTalepListeFiltre ?? new YkcTalepListeFiltre();
    var yetkiliServisMi = User.IsInRole("SertifikaliFirma");
    var icOperasyonGorsun = !yetkiliServisMi;
    var listelenen = Model.Kayitlar.Count;
    var aktifFiltreler = new List<(string Etiket, string Deger)>();

    void AktifFiltreEkle(string etiket, string? deger)
    {
        if (!string.IsNullOrWhiteSpace(deger))
            aktifFiltreler.Add((etiket, deger));
    }

    AktifFiltreEkle("Tesisat", filtre.TesisatNo);
    AktifFiltreEkle("Firma", filtre.Firma);
    AktifFiltreEkle("Ekip", filtre.Ekip);
    AktifFiltreEkle("Marka", filtre.Marka);
    AktifFiltreEkle("İl", filtre.Il);
    AktifFiltreEkle("İlçe", filtre.Ilce);
    AktifFiltreEkle("Bölge", filtre.Bolge);
    if (!string.IsNullOrWhiteSpace(filtre.HedefUygulama))
        AktifFiltreEkle("Hedef", HedefYazi(filtre.HedefUygulama));
    if (filtre.Durum.HasValue)
        AktifFiltreEkle("Durum", DurumYazi(filtre.Durum.Value));
    if (filtre.BaslangicTarihi.HasValue)
        AktifFiltreEkle("Başlangıç", filtre.BaslangicTarihi.Value.ToString("dd.MM.yyyy"));
    if (filtre.BitisTarihi.HasValue)
        AktifFiltreEkle("Bitiş", filtre.BitisTarihi.Value.ToString("dd.MM.yyyy"));
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string? Secili(bool kosul) => kosul ? "selected" : null;

    private static int DurumToplam(IEnumerable<YkcRaporDurumOzetDto> ozetler, params int[] durumlar)
    {
        return ozetler.Where(x => durumlar.Contains(x.Durum)).Sum(x => x.Sayi);
    }

    private static string RandevuYazi(DateTime? tarih, string? saat)
    {
        if (!tarih.HasValue && string.IsNullOrWhiteSpace(saat))
            return "-";

        return string.Join(" ", new[]
        {
            tarih?.ToString("dd.MM.yyyy"),
            string.IsNullOrWhiteSpace(saat) ? null : saat
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string DurumYazi(int durum)
    {
        return durum switch
        {
            YkcDurumDegerleri.TalepAlindi => "Beklemede",
            YkcDurumDegerleri.AtamaBekliyor => "İncelemede",
            YkcDurumDegerleri.Atandi => "Randevu Verildi",
            YkcDurumDegerleri.SahaIsleminde => "Saha İşleminde",
            YkcDurumDegerleri.Reddedildi => "Reddedildi",
            YkcDurumDegerleri.Tamamlandi => "Tamamlandı",
            YkcDurumDegerleri.Iptal => "İptal",
            _ => "Bilinmiyor"
        };
    }

    private static string DurumClass(int durum)
    {
        return durum switch
        {
            YkcDurumDegerleri.Tamamlandi => "df-pill-success",
            YkcDurumDegerleri.Reddedildi or YkcDurumDegerleri.Iptal => "df-pill-danger",
            YkcDurumDegerleri.Atandi or YkcDurumDegerleri.SahaIsleminde => "df-pill-primary",
            _ => "df-pill-warning"
        };
    }

    private static string HedefYazi(string? hedef)
    {
        return hedef switch
        {
            YkcHedefUygulamaDegerleri.YonetimPaneli => "Yönetim Paneli",
            YkcHedefUygulamaDegerleri.DogalgazMobileApp => "Doğalgaz Mobile App",
            YkcHedefUygulamaDegerleri.Crm187 => "CRM187",
            _ => Deger(hedef)
        };
    }
}

@section Styles {
    <style>
        .ykc-report-stack { display: grid; gap: 14px; }
        .ykc-report-hero { overflow: hidden; border-color: #dfe6f2; }
        .ykc-report-hero .df-panel-head { align-items: flex-start; background: linear-gradient(180deg, #ffffff 0%, #f7f9fd 100%); }
        .ykc-report-hero .df-panel-title { font-size: 20px; }
        .ykc-report-metrics { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; padding: 2px 22px 18px; }
        .ykc-report-metric { position: relative; min-width: 0; border: 1px solid #e5ebf4; border-radius: 8px; background: #fff; padding: 12px 15px 12px 17px; box-shadow: 0 10px 24px rgba(13, 34, 112, .045); }
        .ykc-report-metric::before { content: ""; position: absolute; left: 0; top: 11px; bottom: 11px; width: 3px; border-radius: 999px; background: var(--report-accent, var(--df-primary)); }
        .ykc-report-label { color: #62708a; font-size: 11px; font-weight: 850; text-transform: uppercase; letter-spacing: .035em; }
        .ykc-report-value { color: #172033; font-size: 24px; font-weight: 900; line-height: 1; margin-top: 8px; }

        .filtre-kart { background: #fff; border-radius: 8px; border: 1px solid var(--df-border); padding: 0; overflow: hidden; box-shadow: 0 10px 26px rgba(13, 34, 112, .045); }
        .filtre-baslik { display: flex; align-items: center; gap: 9px; font-size: 14px; font-weight: 900; color: var(--df-text); margin: 0; border-bottom: 1px solid var(--df-border); padding: 14px 20px; background: #fff; }
        .filtre-baslik::before { content: ""; width: 7px; height: 20px; border-radius: 999px; background: var(--df-primary); }
        .filtre-kart form { padding: 16px 20px 18px; }
        .filtre-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: 12px; align-items: end; }
        .filtre-alan { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
        .filtre-alan label { font-size: 11px; color: #68758c; font-weight: 850; text-transform: uppercase; letter-spacing: .035em; }
        .filtre-alan input, .filtre-alan select { height: 38px; padding: 8px 11px; border: 1.5px solid #dfe5ee; border-radius: 8px; font-size: 13px; outline: none; color: var(--df-text); background: #fff; width: 100%; min-width: 0; }
        .filtre-alan input:focus, .filtre-alan select:focus { border-color: var(--df-primary); background: #fff; box-shadow: 0 0 0 3px rgba(46, 78, 200, .10); }
        .ykc-filter-footer { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; margin-top: 14px; padding-top: 13px; border-top: 1px solid #edf2f7; }
        .filtre-butonlar { display: flex; gap: 10px; flex: 0 0 auto; }
        .ykc-active-filters { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; min-width: 0; }
        .ykc-active-title { color: #6b7890; font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: .035em; }
        .ykc-filter-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 26px; padding: 4px 9px; border-radius: 999px; background: #eef4ff; color: #33415c; border: 1px solid #d4e0f7; font-size: 11px; font-weight: 750; }
        .ykc-filter-chip b { color: var(--df-primary); font-weight: 900; }

        .ykc-report-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
        .ykc-summary-card { background: #fff; border: 1px solid var(--df-border); border-radius: 8px; box-shadow: 0 10px 26px rgba(13, 34, 112, .045); overflow: hidden; }
        .ykc-summary-head { display: flex; align-items: center; gap: 9px; padding: 13px 16px; border-bottom: 1px solid var(--df-border); color: var(--df-text); background: #fff; font-size: 14px; font-weight: 900; }
        .ykc-summary-head::before { content: ""; width: 7px; height: 18px; border-radius: 999px; background: var(--summary-accent, var(--df-primary)); flex: 0 0 auto; }
        .ykc-summary-list { display: grid; gap: 7px; padding: 12px 15px; max-height: 156px; overflow: auto; }
        .ykc-summary-row { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; border: 1px solid #edf2f7; background: #fbfcfe; border-radius: 8px; padding: 9px 11px; color: var(--df-text-soft); font-size: 13px; }

        .ykc-results { overflow: hidden; }
        .ykc-results .section-head { padding: 13px 18px; }
        .ykc-limit-note { color: var(--df-muted); font-size: 12px; padding: 0 18px 13px; border-bottom: 1px solid #edf2f7; }
        .ykc-report-head, .ykc-report-row { display: grid; grid-template-columns: 1fr 1.35fr 1.2fr 1.2fr 1.05fr .72fr; gap: 12px; align-items: center; }
        .ykc-report-head { padding: 11px 18px; background: #f4f7fb; color: #566280; font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: .035em; border-bottom: 1px solid var(--df-border); }
        .ykc-report-row { margin: 9px 12px; padding: 12px 14px; border: 1px solid #e8edf5; border-radius: 8px; background: #fff; color: var(--df-text-soft); font-size: 13px; box-shadow: 0 8px 18px rgba(13, 34, 112, .035); }
        .ykc-report-row:hover { border-color: #d6def0; background: #fbfcff; }
        .ykc-cell-main { color: var(--df-text); font-weight: 850; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .ykc-code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; color: var(--df-primary); font-weight: 900; }
        .ykc-muted { color: var(--df-muted); font-size: 12px; margin-top: 3px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .ykc-file-pills { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
        .ykc-empty { padding: 42px; text-align: center; color: var(--df-muted); }

        @@media (max-width: 1320px) {
            .ykc-report-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .ykc-report-grid { grid-template-columns: 1fr; }
            .ykc-report-head { display: none; }
            .ykc-report-row { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
            .ykc-report-row > div::before { content: attr(data-label); display: block; color: var(--df-muted); font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 3px; }
        }
        @@media (max-width: 900px) {
            .ykc-filter-footer { align-items: stretch; flex-direction: column; }
            .filtre-butonlar { justify-content: flex-start; }
        }
        @@media (max-width: 760px) {
            .ykc-report-metrics, .ykc-report-row { grid-template-columns: 1fr; }
            .filtre-butonlar, .df-actions { flex-direction: column; align-items: stretch; }
        }
    </style>
}

<div class="ykc-report-stack">
    <section class="df-page-panel ykc-report-hero">
        <div class="df-panel-head">
            <div>
                <h2 class="df-panel-title">Cihaz Değişim Raporları</h2>
                <div class="df-panel-subtitle">Firma, ekip, tesisat, marka ve tarih aralığına göre cihaz değişim kayıtlarını izleyin.</div>
            </div>
            <div class="df-actions">
                <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/talepler">Talep Listesi</a>
            </div>
        </div>
        <div class="ykc-report-metrics">
            <div class="ykc-report-metric" style="--report-accent:#2e4ec8;"><div class="ykc-report-label">Toplam</div><div class="ykc-report-value">@Model.Toplam</div></div>
            <div class="ykc-report-metric" style="--report-accent:#dc8e0d;"><div class="ykc-report-label">İncelemede</div><div class="ykc-report-value">@DurumToplam(Model.DurumOzetleri, YkcDurumDegerleri.TalepAlindi, YkcDurumDegerleri.AtamaBekliyor)</div></div>
            <div class="ykc-report-metric" style="--report-accent:#7056d8;"><div class="ykc-report-label">Randevu / Saha</div><div class="ykc-report-value">@DurumToplam(Model.DurumOzetleri, YkcDurumDegerleri.Atandi, YkcDurumDegerleri.SahaIsleminde)</div></div>
            <div class="ykc-report-metric" style="--report-accent:#1dbb7a;"><div class="ykc-report-label">Tamamlanan</div><div class="ykc-report-value">@DurumToplam(Model.DurumOzetleri, YkcDurumDegerleri.Tamamlandi)</div></div>
            <div class="ykc-report-metric" style="--report-accent:#d42828;"><div class="ykc-report-label">Red / İptal</div><div class="ykc-report-value">@DurumToplam(Model.DurumOzetleri, YkcDurumDegerleri.Reddedildi, YkcDurumDegerleri.Iptal)</div></div>
        </div>
    </section>

    <section class="filtre-kart">
        <div class="filtre-baslik">Filtrele</div>
        <form method="get" action="/ykc/raporlar">
            <div class="filtre-grid">
                <div class="filtre-alan">
                    <label>Tesisat</label>
                    <input type="text" name="tesisatNo" value="@filtre.TesisatNo" placeholder="Tesisat no" />
                </div>
                @if (icOperasyonGorsun)
                {
                    <div class="filtre-alan">
                        <label>Firma</label>
                        <input type="text" name="firma" value="@filtre.Firma" placeholder="Firma adı" />
                    </div>
                    <div class="filtre-alan">
                        <label>Ekip</label>
                        <input type="text" name="ekip" value="@filtre.Ekip" placeholder="Ekip adı" />
                    </div>
                }
                <div class="filtre-alan">
                    <label>Marka</label>
                    <input type="text" name="marka" value="@filtre.Marka" placeholder="Marka" />
                </div>
                <div class="filtre-alan">
                    <label>İl</label>
                    <input type="text" name="il" value="@filtre.Il" placeholder="İl" />
                </div>
                <div class="filtre-alan">
                    <label>İlçe</label>
                    <input type="text" name="ilce" value="@filtre.Ilce" placeholder="İlçe" />
                </div>
                <div class="filtre-alan">
                    <label>Bölge</label>
                    <input type="text" name="bolge" value="@filtre.Bolge" placeholder="Bölge" />
                </div>
                @if (icOperasyonGorsun)
                {
                    <div class="filtre-alan">
                        <label>Hedef</label>
                        <select name="hedefUygulama">
                            <option value="">Tümü</option>
                            <option value="@YkcHedefUygulamaDegerleri.YonetimPaneli" selected="@Secili(filtre.HedefUygulama == YkcHedefUygulamaDegerleri.YonetimPaneli)">Yönetim Paneli</option>
                            <option value="@YkcHedefUygulamaDegerleri.DogalgazMobileApp" selected="@Secili(filtre.HedefUygulama == YkcHedefUygulamaDegerleri.DogalgazMobileApp)">Doğalgaz Mobile App</option>
                            <option value="@YkcHedefUygulamaDegerleri.Crm187" selected="@Secili(filtre.HedefUygulama == YkcHedefUygulamaDegerleri.Crm187)">CRM187</option>
                        </select>
                    </div>
                }
                <div class="filtre-alan">
                    <label>Durum</label>
                    <select name="durum">
                        <option value="">Tümü</option>
                        @foreach (var item in new[] {
                            new { Id = YkcDurumDegerleri.TalepAlindi, Ad = "Beklemede" },
                            new { Id = YkcDurumDegerleri.AtamaBekliyor, Ad = "İç Tesisat İncelemesinde" },
                            new { Id = YkcDurumDegerleri.Atandi, Ad = "Randevu Verildi" },
                            new { Id = YkcDurumDegerleri.SahaIsleminde, Ad = "Saha İşleminde" },
                            new { Id = YkcDurumDegerleri.Reddedildi, Ad = "Reddedildi" },
                            new { Id = YkcDurumDegerleri.Tamamlandi, Ad = "Tamamlandı" },
                            new { Id = YkcDurumDegerleri.Iptal, Ad = "İptal" }
                        })
                        {
                            <option value="@item.Id" selected="@Secili(filtre.Durum == item.Id)">@item.Ad</option>
                        }
                    </select>
                </div>
                <div class="filtre-alan">
                    <label>Başlangıç</label>
                    <input type="date" name="bas" value="@filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="filtre-alan">
                    <label>Bitiş</label>
                    <input type="date" name="bit" value="@filtre.BitisTarihi?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="ykc-filter-footer">
                <div class="ykc-active-filters">
                    @if (aktifFiltreler.Any())
                    {
                        <span class="ykc-active-title">Aktif filtreler</span>
                        @foreach (var item in aktifFiltreler)
                        {
                            <span class="ykc-filter-chip"><b>@item.Etiket</b>@item.Deger</span>
                        }
                    }
                </div>
                <div class="filtre-butonlar">
                    <button class="df-btn df-btn-primary" type="submit">Raporla</button>
                    <a class="df-btn df-btn-secondary" href="/ykc/raporlar">Temizle</a>
                </div>
            </div>
        </form>
    </section>

    <div class="ykc-report-grid">
        <section class="ykc-summary-card" style="--summary-accent:#2e4ec8;">
            <div class="ykc-summary-head">Durum Dağılımı</div>
            <div class="ykc-summary-list">
                @foreach (var durum in Model.DurumOzetleri.OrderBy(x => x.Durum))
                {
                    <div class="ykc-summary-row">
                        <span>@DurumYazi(durum.Durum)</span>
                        <span class="df-pill @DurumClass(durum.Durum)">@durum.Sayi</span>
                    </div>
                }
                @if (!Model.DurumOzetleri.Any())
                {
                    <div class="ykc-empty">Veri bulunamadı.</div>
                }
            </div>
        </section>

        <section class="ykc-summary-card" style="--summary-accent:#1dbb7a;">
            <div class="ykc-summary-head">Hedef Uygulama Özeti</div>
            <div class="ykc-summary-list">
                @foreach (var hedef in Model.HedefOzetleri.OrderByDescending(x => x.Sayi))
                {
                    <div class="ykc-summary-row">
                        <span>@HedefYazi(hedef.Ad)</span>
                        <strong>@hedef.Sayi</strong>
                    </div>
                }
                @if (!Model.HedefOzetleri.Any())
                {
                    <div class="ykc-empty">Veri bulunamadı.</div>
                }
            </div>
        </section>

        <section class="ykc-summary-card" style="--summary-accent:#7056d8;">
            <div class="ykc-summary-head">Ekip Özeti</div>
            <div class="ykc-summary-list">
                @foreach (var ekip in Model.EkipOzetleri)
                {
                    <div class="ykc-summary-row">
                        <span>@Deger(ekip.Ad)</span>
                        <strong>@ekip.Sayi</strong>
                    </div>
                }
                @if (!Model.EkipOzetleri.Any())
                {
                    <div class="ykc-empty">Veri bulunamadı.</div>
                }
            </div>
        </section>
    </div>

    <section class="section ykc-results">
        <div class="section-head">
            <div class="section-title">Cihaz Değişim Kayıtları</div>
            <span class="section-sayi">@listelenen / @Model.Toplam kayıt</span>
        </div>
        <div class="ykc-limit-note">Filtreye uyan ilk @Model.KayitLimiti kayıt listelenir. Daha dar sonuç için tarih, firma, ekip veya tesisat filtresi kullanabilirsiniz.</div>
        <div class="ykc-report-head">
            <div>Tesisat / Form</div>
            <div>Firma / Müşteri</div>
            <div>Cihaz</div>
            <div>Randevu / Ekip</div>
            <div>Durum / Formlar</div>
            <div>İşlem</div>
        </div>
        @if (!Model.Kayitlar.Any())
        {
            <div class="ykc-empty">Filtreye uygun cihaz değişim kaydı bulunamadı.</div>
        }
        else
        {
            foreach (var kayit in Model.Kayitlar)
            {
                <div class="ykc-report-row">
                    <div data-label="Tesisat / Form">
                        <div class="ykc-cell-main"><span class="ykc-code">@Deger(kayit.TesisatNo)</span></div>
                        <div class="ykc-muted">Form #@kayit.Id · @kayit.TalepTarihi.ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                    <div data-label="Firma / Müşteri">
                        <div class="ykc-cell-main">@Deger(kayit.FirmaAdi)</div>
                        <div class="ykc-muted">@Deger(kayit.MusteriAdi)</div>
                    </div>
                    <div data-label="Cihaz">
                        <div class="ykc-cell-main" title="@($"{kayit.EskiCihazTipi} -> {kayit.YeniCihazTipi}")">@Deger(kayit.EskiCihazTipi) → @Deger(kayit.YeniCihazTipi)</div>
                        <div class="ykc-muted" title="@($"{kayit.EskiMarka} -> {kayit.YeniMarka} / {kayit.YeniModel}")">@Deger(kayit.EskiMarka) → @Deger(kayit.YeniMarka) · @Deger(kayit.YeniModel)</div>
                    </div>
                    <div data-label="Randevu / Ekip">
                        <div class="ykc-cell-main">@RandevuYazi(kayit.RandevuTarihi, kayit.RandevuSaati)</div>
                        <div class="ykc-muted">@Deger(kayit.AtananEkip) / @Deger(kayit.Bolge)</div>
                    </div>
                    <div data-label="Durum / Formlar">
                        <span class="df-pill @DurumClass(kayit.Durum)">@DurumYazi(kayit.Durum)</span>
                        <div class="ykc-file-pills">
                            <span class="df-pill @(kayit.FirmaFormuVar ? "df-pill-success" : "df-pill-warning")">Firma Formu</span>
                            <span class="df-pill @(kayit.SahaFormuVar ? "df-pill-success" : "df-pill-warning")">Saha Formu</span>
                        </div>
                    </div>
                    <div data-label="İşlem">
                        <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/detay/@kayit.Id">Detay</a>
                    </div>
                </div>
            }
        }
    </section>
</div>
