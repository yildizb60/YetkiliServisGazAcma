@section Scripts {
    <script>
        (function () {
            const tabs = Array.from(document.querySelectorAll('[data-ykc-tab]'));
            const panels = Array.from(document.querySelectorAll('[data-ykc-tab-panel]'));

            function aktifEt(tabId) {
                tabs.forEach(function (tab) {
                    const aktif = tab.dataset.ykcTab === tabId;
                    tab.classList.toggle('active', aktif);
                    tab.setAttribute('aria-selected', aktif ? 'true' : 'false');
                });

                panels.forEach(function (panel) {
                    panel.classList.toggle('active', panel.dataset.ykcTabPanel === tabId);
                });
            }

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    aktifEt(tab.dataset.ykcTab);
                });
            });
        })();

        document.addEventListener('click', function (event) {
            const button = event.target.closest('[data-picker]');
            if (!button) {
                return;
            }

            const input = document.querySelector(button.dataset.picker);
            if (!input) {
                return;
            }

            if (typeof input.showPicker === 'function') {
                input.showPicker();
            } else {
                input.focus();
            }
        });

        (function () {
            const randevuTarihi = document.getElementById('randevuTarihi');
            const randevuSaati = document.getElementById('randevuSaati');
            const ekip = document.querySelector('input[name="AtananEkip"]');
            const bolge = document.querySelector('input[name="Bolge"]');
            const planTarih = document.getElementById('ykcPlanTarih');
            const planSaat = document.getElementById('ykcPlanSaat');
            const planEkip = document.getElementById('ykcPlanEkip');
            const planBolge = document.getElementById('ykcPlanBolge');

            function planDeger(value) {
                const temiz = (value || '').trim();
                return temiz.length > 0 ? temiz : '-';
            }

            function tarihYaz(value) {
                if (!value) {
                    return '-';
                }

                const parcalar = value.split('-');
                if (parcalar.length !== 3) {
                    return value;
                }

                return parcalar[2] + '.' + parcalar[1] + '.' + parcalar[0];
            }

            function planOnizlemeGuncelle() {
                if (planTarih && randevuTarihi) {
                    planTarih.textContent = tarihYaz(randevuTarihi.value);
                }

                if (planSaat && randevuSaati) {
                    planSaat.textContent = planDeger(randevuSaati.value);
                }

                if (planEkip && ekip) {
                    planEkip.textContent = planDeger(ekip.value);
                }

                if (planBolge && bolge) {
                    planBolge.textContent = planDeger(bolge.value);
                }
            }

            [randevuTarihi, randevuSaati, ekip, bolge]
                .filter(Boolean)
                .forEach(function (alan) {
                    alan.addEventListener('input', planOnizlemeGuncelle);
                    alan.addEventListener('change', planOnizlemeGuncelle);
                });

            planOnizlemeGuncelle();
        })();
    </script>
}
