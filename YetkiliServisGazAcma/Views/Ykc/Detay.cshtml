@model YkcTalepDetayDto
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var ykcYetkileri = ViewBag.YkcYetkileri as YkcYetkiOzeti ?? new YkcYetkiOzeti();
    var atamaYetkisi = ykcYetkileri.AtamaYapabilir;
    var fr265ImzaYetkisi = ykcYetkileri.Fr265ImzaIslemiYapabilir;
    var yonetebilir = atamaYetkisi || fr265ImzaYetkisi;
    var icOperasyonGorsun = !User.IsInRole("SertifikaliFirma");
    ViewData["PanelSubtitle"] = icOperasyonGorsun
        ? "Cihaz karşılaştırması ve talep işlemleri"
        : "Talep, randevu ve FR265 durumu";
    var atamaYapilabilir = Model.Durum == YkcDurumDegerleri.AtamaBekliyor || Model.Durum == YkcDurumDegerleri.Atandi || Model.Durum == YkcDurumDegerleri.SahaIsleminde;
    var terminalDurum = Model.Durum == YkcDurumDegerleri.Tamamlandi || Model.Durum == YkcDurumDegerleri.Reddedildi || Model.Durum == YkcDurumDegerleri.Iptal;
    var imzaSureci = Model.ImzaSureci;
    var imzaEntegrasyonu = ViewBag.ImzaEntegrasyonu as YkcImzaEntegrasyonDto ?? new YkcImzaEntegrasyonDto();
    var demoImzaModu = imzaEntegrasyonu.DemoModuMu;
    var imzaliBelge = imzaSureci?.NihaiDosyaId is int nihaiDosyaId
        ? Model.Dosyalar.FirstOrDefault(x => x.Id == nihaiDosyaId && x.DosyaTuru == YkcFormDosyaTuruDegerleri.Fr265ImzaliNihai)
        : null;
    var imzaliBelgeHazir = imzaliBelge != null
        && !string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId)
        && string.Equals(imzaSureci?.Durum, YkcImzaDurumDegerleri.Tamamlandi, StringComparison.OrdinalIgnoreCase);
    var gonderimTakildi = imzaSureci?.Durum == YkcImzaDurumDegerleri.ImzayaGonderildi
        && string.IsNullOrWhiteSpace(imzaSureci.ProviderDocumentId)
        && (!imzaSureci.GonderimTarihi.HasValue || imzaSureci.GonderimTarihi <= DateTime.Now.AddMinutes(-5));
    var imzayaHazirKontroller = Model.Kontroller
        .Where(x => x.KontrolNo is >= 1 and <= 5)
        .GroupBy(x => x.KontrolNo)
        .Select(x => x.OrderByDescending(k => k.KontrolTarihi ?? DateTime.MinValue).First())
        .ToList();
    var kontrollerImzayaHazir = imzayaHazirKontroller.Count == 5
        && imzayaHazirKontroller.All(x => x.Sonuc == YkcFr265KontrolSonucDegerleri.Uygun || x.Sonuc == YkcFr265KontrolSonucDegerleri.Uygulanmaz);
    var talepImzayaHazir = Model.Durum == YkcDurumDegerleri.SahaIsleminde
        && Model.RandevuTarihi.HasValue
        && !string.IsNullOrWhiteSpace(Model.RandevuSaati)
        && kontrollerImzayaHazir;
    var imzayaGonderebilir = fr265ImzaYetkisi
        && imzaEntegrasyonu.KullanilabilirMi
        && talepImzayaHazir
        && string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId)
        && (imzaSureci?.Durum is null or YkcImzaDurumDegerleri.Hazir or YkcImzaDurumDegerleri.Hata || gonderimTakildi);
    var imzaDurumuSorgulanabilir = fr265ImzaYetkisi
        && imzaEntegrasyonu.KullanilabilirMi
        && !string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId)
        && !imzaliBelgeHazir;
    var imzaBirincilIslemVar = imzaliBelge != null || imzayaGonderebilir || imzaDurumuSorgulanabilir;
    var indirilebilirDosyalar = Model.Dosyalar
        .Where(x => x.DosyaTuru == YkcFormDosyaTuruDegerleri.TeknikEk
            || (x.DosyaTuru == YkcFormDosyaTuruDegerleri.Fr265ImzaliNihai && imzaliBelgeHazir && imzaliBelge != null && x.Id == imzaliBelge.Id))
        .ToList();
    var kontrolSatirlari = Model.Kontroller.Any()
        ? Model.Kontroller
        : Enumerable.Range(1, 5).Select(no => new YkcFr265KontrolDto { KontrolNo = no }).ToList();
    var aktifAdim = Model.Durum switch
    {
        YkcDurumDegerleri.TalepAlindi => 1,
        YkcDurumDegerleri.AtamaBekliyor => 2,
        YkcDurumDegerleri.Atandi => 3,
        YkcDurumDegerleri.SahaIsleminde => 4,
        YkcDurumDegerleri.Tamamlandi => 5,
        _ => 2
    };
    var gorevBasligi = Model.Durum switch
    {
        YkcDurumDegerleri.TalepAlindi => "Talebi incelemeye alın",
        YkcDurumDegerleri.AtamaBekliyor => "Randevu ve yönlendirmeyi planlayın",
        YkcDurumDegerleri.Atandi => "Planlanan randevuyu takip edin",
        YkcDurumDegerleri.SahaIsleminde => "FR265 ve imza işlemlerini tamamlayın",
        YkcDurumDegerleri.Tamamlandi => "Talep tamamlandı",
        YkcDurumDegerleri.Reddedildi => "Talep reddedildi",
        YkcDurumDegerleri.Iptal => "Talep iptal edildi",
        _ => "Talebi inceleyin"
    };
    var gorevAciklamasi = Model.Durum switch
    {
        YkcDurumDegerleri.TalepAlindi => "Cihaz bilgilerini karşılaştırın ve kaydı inceleme sürecine alın.",
        YkcDurumDegerleri.AtamaBekliyor => "Uygun yönlendirmeyi, bölgeyi ve randevu bilgisini tek işlemde kaydedin.",
        YkcDurumDegerleri.Atandi => "Randevu bilgisi aşağıda hazır. Randevu gerçekleştiğinde işlemi devam ettirin.",
        YkcDurumDegerleri.SahaIsleminde => "Kontrol sonuçlarını kaydedin, FR265'i inceleyin ve imza durumunu takip edin.",
        YkcDurumDegerleri.Tamamlandi => "İmzalı nihai belgeyi ve işlem geçmişini görüntüleyebilirsiniz.",
        YkcDurumDegerleri.Reddedildi => "Red gerekçesi işlem geçmişinde yer alır.",
        YkcDurumDegerleri.Iptal => "İptal bilgisi işlem geçmişinde yer alır.",
        _ => "Talebin güncel bilgilerini kontrol edin."
    };
    if (!icOperasyonGorsun)
    {
        gorevBasligi = Model.Durum switch
        {
            YkcDurumDegerleri.TalepAlindi => "Talebiniz alındı",
            YkcDurumDegerleri.AtamaBekliyor => "Talebiniz inceleniyor",
            YkcDurumDegerleri.Atandi => "Randevunuz oluşturuldu",
            YkcDurumDegerleri.SahaIsleminde => "Form ve imza süreci devam ediyor",
            _ => gorevBasligi
        };
        gorevAciklamasi = Model.Durum switch
        {
            YkcDurumDegerleri.TalepAlindi => "Tesisat ve cihaz bilgileriniz kontrol için kaydedildi.",
            YkcDurumDegerleri.AtamaBekliyor => "Talebiniz değerlendiriliyor. Randevu oluşturulduğunda burada görebileceksiniz.",
            YkcDurumDegerleri.Atandi => "Planlanan randevu tarihini ve talebinizin güncel durumunu takip edebilirsiniz.",
            YkcDurumDegerleri.SahaIsleminde => "FR265 önizlemesini ve dijital imza sonucunu bu ekrandan takip edebilirsiniz.",
            _ => gorevAciklamasi
        };
    }
    var formYardimMetni = demoImzaModu
        ? "FR265 geliştirme ortamındaki test sağlayıcısına gönderilir. Durum güncellendiğinde gerçek imza yerine, akışı göstermek için açıkça işaretlenmiş bir demo sonuç belgesi oluşturulur."
        : imzaEntegrasyonu.KullanilabilirMi
        ? "Kontrol edilen FR265 dijital imza uygulamasına gönderilir. Süreç tamamlandığında imzalı nihai belge bu kayda eklenir."
        : "FR265 önizlemesi kullanılabilir. Dijital imza bağlantısı etkinleşmeden belge gönderilmiş veya imzalanmış sayılmaz.";
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Tarih(DateTime? value) => value.HasValue ? value.Value.ToString("dd.MM.yyyy") : "-";
    private static string? Secili(bool kosul) => kosul ? "selected" : null;
    private static string EvetHayir(bool? value) => value.HasValue ? (value.Value ? "Evet" : "Hayır") : "-";
    private static string DurumYazi(int durum) => YkcDurumSunumu.Etiket(durum);
    private static string DurumClass(int durum) => YkcDurumSunumu.CssSinifi(durum);

    private static string RandevuYazi(DateTime? tarih, string? saat)
    {
        if (!tarih.HasValue && string.IsNullOrWhiteSpace(saat))
            return "Henüz planlanmadı";

        return string.Join(" ", new[]
        {
            tarih?.ToString("dd.MM.yyyy"),
            string.IsNullOrWhiteSpace(saat) ? null : saat
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string DosyaTuruYazi(string? tur) => tur switch
    {
        YkcFormDosyaTuruDegerleri.Fr265Taslak => "FR265 Taslak",
        YkcFormDosyaTuruDegerleri.Fr265ImzayaGonderilen => "İmzaya Gönderilen FR265",
        YkcFormDosyaTuruDegerleri.Fr265ImzaliAday => "Doğrulama Bekleyen İmzalı Belge",
        YkcFormDosyaTuruDegerleri.Fr265ImzaliNihai => "İmzalı Nihai Belge",
        YkcFormDosyaTuruDegerleri.TeknikEk => "Teknik Ek",
        _ => Deger(tur)
    };

    private static string ImzaDurumYazi(string? durum) => durum switch
    {
        YkcImzaDurumDegerleri.Hazir => "Önizlemeye Hazır",
        YkcImzaDurumDegerleri.ImzayaGonderildi => "İmzaya Gönderildi",
        YkcImzaDurumDegerleri.ImzaBekliyor => "İmza Bekliyor",
        YkcImzaDurumDegerleri.KismiImzali => "İmzalar Tamamlanıyor",
        YkcImzaDurumDegerleri.Tamamlandi => "İmzalı Belge Hazır",
        YkcImzaDurumDegerleri.Hata => "İmza İşlemi Hatası",
        YkcImzaDurumDegerleri.Iptal => "İptal",
        _ => "Önizlemeye Hazır"
    };

    private static string KontrolSonucYazi(string? sonuc) => sonuc switch
    {
        YkcFr265KontrolSonucDegerleri.Uygun => "Uygun",
        YkcFr265KontrolSonucDegerleri.UygunDegil => "Uygun Değil",
        YkcFr265KontrolSonucDegerleri.Uygulanmaz => "Uygulanmaz",
        _ => "Bekliyor"
    };

    private static string KontrolSonucClass(string? sonuc) => sonuc switch
    {
        YkcFr265KontrolSonucDegerleri.Uygun => "df-pill-success",
        YkcFr265KontrolSonucDegerleri.UygunDegil => "df-pill-danger",
        YkcFr265KontrolSonucDegerleri.Uygulanmaz => "df-pill-primary",
        _ => "df-pill-warning"
    };

    private static string AkisClass(int adim, int aktifAdim, bool durduruldu)
    {
        if (durduruldu) return adim == aktifAdim ? "is-stopped" : adim < aktifAdim ? "is-complete" : "";
        if (adim < aktifAdim) return "is-complete";
        return adim == aktifAdim ? "is-active" : "";
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ykc-operations.css" asp-append-version="true" />
}

<div class="ykc-workspace ykc-detail-page">
    @if (TempData["Basarili"] != null)
    {
        <div class="df-alert df-alert-success">@TempData["Basarili"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <header class="ykc-page-header ykc-detail-header">
        <div class="ykc-page-heading">
            <div class="ykc-page-eyebrow">Cihaz değişim talebi · #@Model.Id</div>
            <h1>@Deger(Model.MusteriAdi)</h1>
            <p>@Deger(Model.FirmaAdi) <span aria-hidden="true">·</span> Tesisat @Deger(Model.TesisatNo) <span aria-hidden="true">·</span> @Model.TalepTarihi.ToString("dd.MM.yyyy HH:mm")</p>
        </div>
        <div class="ykc-header-actions">
            <span class="df-pill @DurumClass(Model.Durum)">@DurumYazi(Model.Durum)</span>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/talepler"><i class="bi bi-arrow-left"></i> Listeye Dön</a>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/fr265/onizle/@Model.Id" target="_blank"><i class="bi bi-eye"></i> FR265'i Önizle</a>
        </div>
        <dl class="ykc-request-summary">
            <div><dt>Tesisat / Proje</dt><dd>@Deger(Model.TesisatNo) / @Deger(Model.ProjeNo)</dd></div>
            @if (icOperasyonGorsun)
            {
                <div><dt>Bölge</dt><dd id="ykcPlanBolge">@Deger(Model.Bolge)</dd></div>
                <div><dt>Yönlendirme</dt><dd id="ykcPlanEkip">@Deger(Model.AtananEkip)</dd></div>
            }
            <div><dt>Randevu</dt><dd><span id="ykcPlanTarih">@(Model.RandevuTarihi.HasValue ? Tarih(Model.RandevuTarihi) : string.IsNullOrWhiteSpace(Model.RandevuSaati) ? "Henüz planlanmadı" : "")</span> <span id="ykcPlanSaat">@(string.IsNullOrWhiteSpace(Model.RandevuSaati) ? "" : Model.RandevuSaati)</span></dd></div>
            <div><dt>Form ve İmza</dt><dd>@(imzaliBelgeHazir ? (demoImzaModu ? "Demo sonuç belgesi hazır" : "İmzalı belge hazır") : ImzaDurumYazi(imzaSureci?.Durum))</dd></div>
        </dl>
    </header>

    <nav class="ykc-process-line" aria-label="Talep süreci">
        @foreach (var adim in new[] {
            new { No = 1, Baslik = "Talep" },
            new { No = 2, Baslik = "İnceleme" },
            new { No = 3, Baslik = "Randevu" },
            new { No = 4, Baslik = "Form & İmza" },
            new { No = 5, Baslik = "Tamamlandı" }
        })
        {
            <div class="@AkisClass(adim.No, aktifAdim, Model.Durum == YkcDurumDegerleri.Reddedildi || Model.Durum == YkcDurumDegerleri.Iptal)">
                <span>@(adim.No < aktifAdim ? "✓" : adim.No.ToString())</span>
                <strong>@adim.Baslik</strong>
            </div>
        }
    </nav>

    <section class="ykc-focus-section" aria-labelledby="current-task-title">
        <header class="ykc-focus-header">
            <div>
                <span class="ykc-section-kicker">Şimdi yapılacak işlem</span>
                <h2 id="current-task-title">@gorevBasligi</h2>
                <p>@gorevAciklamasi</p>
            </div>
            <span class="df-pill @DurumClass(Model.Durum)">@DurumYazi(Model.Durum)</span>
        </header>

        @if (!icOperasyonGorsun)
        {
            <div class="ykc-firm-progress">
                <div><span>Randevu</span><strong>@RandevuYazi(Model.RandevuTarihi, Model.RandevuSaati)</strong></div>
                <div><span>FR265 ve imza</span><strong>@(imzaliBelgeHazir ? (demoImzaModu ? "Demo sonuç belgesi hazır" : "İmzalı belge hazır") : ImzaDurumYazi(imzaSureci?.Durum))</strong></div>
                @if (imzaliBelge != null)
                {
                    <a class="df-btn df-btn-primary" href="/ykc/dosya/@imzaliBelge.Id" target="_blank"><i class="bi bi-download"></i> @(demoImzaModu ? "Demo Sonuç Belgesini İndir" : "İmzalı Belgeyi İndir")</a>
                }
            </div>
        }
        else if (yonetebilir)
        {
            @if (Model.Durum == YkcDurumDegerleri.TalepAlindi && atamaYetkisi)
            {
                <form method="post" action="/ykc/durum-guncelle" class="ykc-inline-action-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TalepId" value="@Model.Id" />
                    <input type="hidden" name="Durum" value="@YkcDurumDegerleri.AtamaBekliyor" />
                    <div class="ykc-field ykc-grow"><label>İnceleme Notu</label><textarea name="Aciklama" placeholder="Gerekliyse kısa bir not ekleyin"></textarea></div>
                    <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-check2"></i> İncelemeye Al</button>
                </form>
            }

            @if (Model.Durum == YkcDurumDegerleri.Atandi && (atamaYetkisi || fr265ImzaYetkisi))
            {
                <div class="ykc-current-plan">
                    <div><span>Planlanan randevu</span><strong>@RandevuYazi(Model.RandevuTarihi, Model.RandevuSaati)</strong></div>
                    <div><span>Yönlendirilen birim / kişi</span><strong>@Deger(Model.AtananEkip)</strong></div>
                    <form method="post" action="/ykc/durum-guncelle">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TalepId" value="@Model.Id" />
                        <input type="hidden" name="Durum" value="@YkcDurumDegerleri.SahaIsleminde" />
                        <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-check2-circle"></i> Randevu Gerçekleşti</button>
                    </form>
                </div>
            }

            @if (Model.Durum == YkcDurumDegerleri.SahaIsleminde && fr265ImzaYetkisi)
            {
                <div class="ykc-current-plan">
                    <a class="ykc-text-action" href="#fr265-controls"><i class="bi bi-clipboard2-check"></i><span><strong>Kontrol sonuçlarını gir</strong><small>Kontrol 1-5 sonuç ve açıklamaları</small></span></a>
                    <a class="ykc-text-action" href="#fr265-signature"><i class="bi bi-file-earmark-check"></i><span><strong>FR265 ve imzayı kontrol et</strong><small>Önizleme, gönderim ve nihai belge</small></span></a>
                    @if (imzaliBelgeHazir)
                    {
                        <form method="post" action="/ykc/durum-guncelle">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="TalepId" value="@Model.Id" />
                            <input type="hidden" name="Durum" value="@YkcDurumDegerleri.Tamamlandi" />
                            <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-check2-circle"></i> İşlemi Tamamla</button>
                        </form>
                    }
                    else
                    {
                        <div class="ykc-completion-gate"><i class="bi bi-lock"></i><span><strong>Tamamlama için imza sonucu bekleniyor</strong><small>FR265'i gönderin ve imza durumunu güncelleyin.</small></span></div>
                    }
                </div>
            }

            @if (terminalDurum)
            {
                <div class="ykc-terminal-message">@gorevAciklamasi</div>
            }

            @if (atamaYapilabilir && atamaYetkisi)
            {
                <details class="ykc-assignment-disclosure" open="@(Model.Durum == YkcDurumDegerleri.AtamaBekliyor ? "open" : null)">
                    <summary>
                        <span><strong>@(Model.Durum == YkcDurumDegerleri.AtamaBekliyor ? "Randevu ve yönlendirme bilgileri" : "Randevuyu güncelle")</strong><small>@Deger(Model.AtananEkip) · @RandevuYazi(Model.RandevuTarihi, Model.RandevuSaati)</small></span>
                        <i class="bi bi-chevron-down"></i>
                    </summary>
                    <form method="post" action="/ykc/atama-yap" class="ykc-assignment-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TalepId" value="@Model.Id" />
                        <input type="hidden" name="AtananKullaniciTipi" value="@Model.Atamalar.FirstOrDefault()?.AtananKullaniciTipi" />
                        <input type="hidden" name="HedefUygulama" value="@Model.HedefUygulama" />
                        <input type="hidden" name="CallCenterTetiklenecekMi" value="false" />

                        <fieldset class="ykc-route-fieldset">
                            <legend>Yönlendirme</legend>
                            <div class="ykc-route-options">
                                <button type="button" data-route-ekip="187 Acil" data-route-tip="CRM187" data-route-hedef="@YkcHedefUygulamaDegerleri.Crm187" data-route-callcenter="true" data-route-note="187 acil yönlendirme"><i class="bi bi-telephone-outbound"></i><span><strong>187 Acil</strong><small>Acil müdahale</small></span><i class="bi bi-check2"></i></button>
                                <button type="button" data-route-ekip="Mühendis" data-route-tip="Mühendis" data-route-hedef="@YkcHedefUygulamaDegerleri.DogalgazMobileApp" data-route-callcenter="false" data-route-note="mühendis yönlendirme"><i class="bi bi-person-gear"></i><span><strong>Mühendis</strong><small>Planlı inceleme</small></span><i class="bi bi-check2"></i></button>
                            </div>
                        </fieldset>

                        <div class="ykc-assignment-fields">
                            <div class="ykc-field"><label>Yönlendirilecek Birim / Kişi</label><input name="AtananEkip" value="@Model.AtananEkip" placeholder="187 Acil veya mühendis" required /></div>
                            <div class="ykc-field"><label>Tesisat Bölgesi</label><input name="Bolge" value="@Model.Bolge" placeholder="Tesisat bölgesi" required /></div>
                            <div class="ykc-field"><label>Randevu Tarihi</label><div class="ykc-picker"><input id="randevuTarihi" type="date" name="RandevuTarihi" value="@Model.RandevuTarihi?.ToString("yyyy-MM-dd")" required /><button type="button" data-picker="#randevuTarihi" title="Takvimi aç"><i class="bi bi-calendar3"></i></button></div></div>
                            <div class="ykc-field"><label>Randevu Saati</label><div class="ykc-picker"><input id="randevuSaati" type="time" name="RandevuSaati" value="@Model.RandevuSaati" required /><button type="button" data-picker="#randevuSaati" title="Saati seç"><i class="bi bi-clock"></i></button></div></div>
                            <div class="ykc-field ykc-field-wide"><label>Not</label><textarea name="Aciklama" placeholder="Atama ve yönlendirme notu"></textarea></div>
                        </div>
                        <div class="ykc-form-actions"><button class="df-btn df-btn-primary" type="submit"><i class="bi bi-calendar2-check"></i> @(Model.Durum == YkcDurumDegerleri.AtamaBekliyor ? "Randevuyu Kaydet" : "Randevuyu Güncelle")</button></div>
                    </form>
                </details>
            }

            @if (!terminalDurum && atamaYetkisi)
            {
                <details class="ykc-other-actions">
                    <summary>Diğer işlemler <i class="bi bi-chevron-down"></i></summary>
                    <form method="post" action="/ykc/durum-guncelle">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TalepId" value="@Model.Id" />
                        <div class="ykc-field"><label>Açıklama</label><textarea name="Aciklama" placeholder="Red veya iptal gerekçesi">@Model.RedAciklama</textarea></div>
                        <div class="ykc-form-actions is-left">
                            <button class="df-btn df-btn-secondary df-btn-sm" type="submit" name="Durum" value="@YkcDurumDegerleri.Reddedildi"><i class="bi bi-x-circle"></i> Reddet</button>
                            <button class="df-btn df-btn-secondary df-btn-sm" type="submit" name="Durum" value="@YkcDurumDegerleri.Iptal"><i class="bi bi-slash-circle"></i> İptal Et</button>
                        </div>
                    </form>
                </details>
            }
        }
        else
        {
            <div class="ykc-terminal-message">Bu talebi görüntüleyebilirsiniz. Atama veya FR265 işlemi için ayrıca YKC operasyon yetkisi gerekir.</div>
        }
    </section>

    <section class="ykc-content-section ykc-device-comparison" aria-labelledby="device-comparison-title">
        <div class="ykc-section-heading">
            <div><span class="ykc-section-kicker">FR265 cihaz bilgileri</span><h2 id="device-comparison-title">Projedeki ve yeni cihaz karşılaştırması</h2></div>
            <span>Belgedeki ana alanlar yan yana gösterilir.</span>
        </div>
        <div class="ykc-table-scroll">
            <table class="ykc-comparison-table">
                <thead><tr><th>Özellik</th><th>Projedeki Cihaz</th><th>Yeni Kullanılan Cihaz</th></tr></thead>
                <tbody>
                    <tr><th>Yakıcı Cihaz Tipi</th><td>@Deger(Model.EskiCihazTipi)</td><td>@Deger(Model.YeniCihazTipi)</td></tr>
                    <tr><th>Marka</th><td>@Deger(Model.EskiMarka)</td><td><strong>@Deger(Model.YeniMarka)</strong>@if (!string.IsNullOrWhiteSpace(Model.YeniModel)) { <small>Model: @Model.YeniModel</small> }</td></tr>
                    <tr><th>Baca Tipi</th><td>@Deger(Model.EskiBacaTipi)</td><td>@Deger(Model.YeniBacaTipi)</td></tr>
                    <tr><th>Kapasite (kcal/h)</th><td>@Deger(Model.EskiKapasite)</td><td>@Deger(Model.YeniKapasite)</td></tr>
                </tbody>
            </table>
        </div>
        <dl class="ykc-comparison-meta">
            <div><dt>Takılan cihaz ikinci el mi?</dt><dd>@EvetHayir(Model.IkinciElCihazMi)</dd></div>
            <div><dt>Yeni cihaz seri no</dt><dd>@Deger(Model.YeniSeriNo)</dd></div>
        </dl>
    </section>

    <section class="ykc-info-groups" aria-label="Talep bilgileri">
        <article>
            <h2>Tesisat ve Müşteri</h2>
            <dl>
                <div><dt>Müşteri</dt><dd>@Deger(Model.MusteriAdi)</dd></div><div><dt>Telefon</dt><dd>@Deger(Model.MusteriTelefon)</dd></div>
                <div><dt>Abone</dt><dd>@Deger(Model.AboneNo)</dd></div><div><dt>Sözleşme</dt><dd>@Deger(Model.SozlesmeNo)</dd></div>
                <div><dt>Proje</dt><dd>@Deger(Model.ProjeNo)</dd></div><div><dt>Sayaç</dt><dd>@Deger(Model.SayacNo)</dd></div>
                <div class="wide"><dt>Adres</dt><dd>@Deger(Model.Adres)</dd></div>
            </dl>
        </article>
        <article>
            <h2>Firma ve Kapsam</h2>
            <dl>
                <div><dt>Firma</dt><dd>@Deger(Model.FirmaAdi)</dd></div><div><dt>Şirket</dt><dd>@Deger(Model.SirketAdi)</dd></div>
                <div><dt>VKN</dt><dd>@Deger(Model.Vkn)</dd></div><div><dt>Firma Kodu</dt><dd>@Deger(Model.FirmaKodu)</dd></div>
                <div class="wide"><dt>İl / İlçe</dt><dd>@Deger(Model.Il) / @Deger(Model.Ilce)</dd></div>
            </dl>
        </article>
        <article>
            <h2>Planlama</h2>
            <dl>
                <div><dt>Randevu Tarihi</dt><dd>@Tarih(Model.RandevuTarihi)</dd></div><div><dt>Randevu Saati</dt><dd>@Deger(Model.RandevuSaati)</dd></div>
                @if (icOperasyonGorsun)
                {
                    <div><dt>Bölge</dt><dd>@Deger(Model.Bolge)</dd></div><div><dt>Yönlendirme</dt><dd>@Deger(Model.AtananEkip)</dd></div>
                }
                <div class="wide"><dt>Güncel Durum</dt><dd>@DurumYazi(Model.Durum)</dd></div>
            </dl>
        </article>
    </section>

    <details class="ykc-detail-section" id="fr265-controls" open="@(Model.Durum == YkcDurumDegerleri.SahaIsleminde ? "open" : null)">
        <summary><span><strong>FR265 Kontrol Adımları</strong><small>Kontrol 1-5 · Sonuç ve açıklama</small></span><i class="bi bi-chevron-down"></i></summary>
        <div class="ykc-detail-section-body">
            @if (fr265ImzaYetkisi)
            {
                <form method="post" action="/ykc/kontroller-kaydet">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TalepId" value="@Model.Id" />
                    <div class="ykc-control-list">
                        @for (var i = 0; i < kontrolSatirlari.Count; i++)
                        {
                            var kontrol = kontrolSatirlari[i];
                            <div class="ykc-control-row">
                                <input type="hidden" name="Kontroller[@i].KontrolNo" value="@kontrol.KontrolNo" />
                                <strong>@kontrol.KontrolNo. Kontrol</strong>
                                <select name="Kontroller[@i].Sonuc">
                                    <option value="@YkcFr265KontrolSonucDegerleri.Bekliyor" selected="@Secili(kontrol.Sonuc == YkcFr265KontrolSonucDegerleri.Bekliyor)">Bekliyor</option>
                                    <option value="@YkcFr265KontrolSonucDegerleri.Uygun" selected="@Secili(kontrol.Sonuc == YkcFr265KontrolSonucDegerleri.Uygun)">Uygun</option>
                                    <option value="@YkcFr265KontrolSonucDegerleri.UygunDegil" selected="@Secili(kontrol.Sonuc == YkcFr265KontrolSonucDegerleri.UygunDegil)">Uygun Değil</option>
                                    <option value="@YkcFr265KontrolSonucDegerleri.Uygulanmaz" selected="@Secili(kontrol.Sonuc == YkcFr265KontrolSonucDegerleri.Uygulanmaz)">Uygulanmaz</option>
                                </select>
                                <textarea name="Kontroller[@i].Aciklama" placeholder="Açıklama">@kontrol.Aciklama</textarea>
                            </div>
                        }
                    </div>
                    <div class="ykc-form-actions"><button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-save"></i> Kontrolleri Kaydet</button></div>
                </form>
            }
            else
            {
                <div class="ykc-control-list is-readonly">
                    @foreach (var kontrol in kontrolSatirlari)
                    {
                        <div class="ykc-control-row"><strong>@kontrol.KontrolNo. Kontrol</strong><span class="df-pill @KontrolSonucClass(kontrol.Sonuc)">@KontrolSonucYazi(kontrol.Sonuc)</span><small>@Deger(kontrol.Aciklama)</small></div>
                    }
                </div>
            }
        </div>
    </details>

    <details class="ykc-detail-section" id="fr265-signature" open="@(Model.Durum == YkcDurumDegerleri.SahaIsleminde || Model.Durum == YkcDurumDegerleri.Tamamlandi ? "open" : null)">
        <summary><span><strong>FR265 ve Dijital İmza</strong><small>@ImzaDurumYazi(imzaSureci?.Durum) · Belge sürümü @Model.Fr265BelgeVersiyonNo</small></span><i class="bi bi-chevron-down"></i></summary>
        <div class="ykc-detail-section-body">
            @if (demoImzaModu)
            {
                <div class="ykc-demo-mode"><i class="bi bi-beaker"></i><span><strong>Demo imza modu</strong><small>Bu işlem yalnızca geliştirme ve sunum içindir; hukuki elektronik imza üretmez.</small></span></div>
            }
            <dl class="ykc-signature-summary">
                <div><dt>İmza Durumu</dt><dd><span class="df-pill @(imzaliBelgeHazir ? "df-pill-success" : "df-pill-warning")">@ImzaDurumYazi(imzaSureci?.Durum)</span></dd></div>
                <div><dt>Sağlayıcı</dt><dd>@Deger(imzaEntegrasyonu.ProviderAdi)</dd></div>
                <div><dt>Belge No</dt><dd>@(string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId) ? "Henüz gönderilmedi" : imzaSureci.ProviderDocumentId)</dd></div>
            </dl>
            <p class="ykc-process-message">@formYardimMetni</p>
            <div class="ykc-form-actions is-left">
                @if (imzaliBelge != null)
                {
                    <a class="df-btn df-btn-primary df-btn-sm" href="/ykc/dosya/@imzaliBelge.Id" target="_blank"><i class="bi bi-download"></i> @(demoImzaModu ? "Demo Sonuç Belgesini İndir" : "İmzalı Belgeyi İndir")</a>
                }
                else if (imzayaGonderebilir)
                {
                    <form method="post" action="/ykc/imzaya-gonder">@Html.AntiForgeryToken()<input type="hidden" name="talepId" value="@Model.Id" /><button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-send"></i> İmzaya Gönder</button></form>
                }
                else if (imzaDurumuSorgulanabilir)
                {
                    <form method="post" action="/ykc/imza-durum-sorgula">@Html.AntiForgeryToken()<input type="hidden" name="talepId" value="@Model.Id" /><button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-arrow-repeat"></i> İmza Durumunu Güncelle</button></form>
                }
                <a class="df-btn @(imzaBirincilIslemVar ? "df-btn-secondary" : "df-btn-primary") df-btn-sm" href="/ykc/fr265/onizle/@Model.Id" target="_blank"><i class="bi bi-eye"></i> FR265'i Önizle</a>
            </div>
            @if (!imzaEntegrasyonu.KullanilabilirMi)
            {
                <div class="ykc-integration-note"><i class="bi bi-info-circle"></i> Dijital imza bağlantısı henüz etkin değil. Önizleme gerçek talep verileriyle kullanılabilir.</div>
            }
            @if (fr265ImzaYetkisi)
            {
                <details class="ykc-transition-upload">
                    <summary>Teknik ek belge ekle <i class="bi bi-chevron-down"></i></summary>
                    <form method="post" action="/ykc/form-yukle" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="talepId" value="@Model.Id" />
                        <input type="hidden" name="dosyaTuru" value="@YkcFormDosyaTuruDegerleri.TeknikEk" />
                        <div class="ykc-field"><label>Belge</label><input type="file" name="formDosyasi" accept=".pdf,.jpg,.jpeg,.png" /></div>
                        <button class="df-btn df-btn-secondary df-btn-sm" type="submit">Teknik Ek Ekle</button>
                    </form>
                </details>
            }
            @if (indirilebilirDosyalar.Any())
            {
                <div class="ykc-document-list">
                    @foreach (var dosya in indirilebilirDosyalar)
                    {
                        <a href="/ykc/dosya/@dosya.Id" target="_blank"><i class="bi bi-file-earmark"></i><span><strong>@Deger(dosya.DosyaAdi)</strong><small>@DosyaTuruYazi(dosya.DosyaTuru) · @dosya.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</small></span><i class="bi bi-download"></i></a>
                    }
                </div>
            }
        </div>
    </details>

    <section class="ykc-content-section ykc-history-section">
        <div class="ykc-section-heading"><div><span class="ykc-section-kicker">Kayıt hareketleri</span><h2>İşlem Geçmişi</h2></div><span>@Model.Gecmis.Count kayıt</span></div>
        @if (!Model.Gecmis.Any())
        {
            <div class="ykc-empty-state">Henüz işlem geçmişi yok.</div>
        }
        else
        {
            <div class="ykc-history-list">
                @foreach (var gecmis in Model.Gecmis.Take(3))
                {
                    <div><time>@gecmis.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</time><span></span><section><strong>@Deger(gecmis.IslemTipi)</strong><small>@Deger(gecmis.KullaniciAdi) @if (!string.IsNullOrWhiteSpace(gecmis.Aciklama)) { <text>· @gecmis.Aciklama</text> }</small></section>@if (gecmis.YeniDurum.HasValue) { <span class="df-pill @DurumClass(gecmis.YeniDurum.Value)">@DurumYazi(gecmis.YeniDurum.Value)</span> }</div>
                }
            </div>
            @if (Model.Gecmis.Count > 3)
            {
                <details class="ykc-history-more">
                    <summary>Tüm geçmişi göster (@(Model.Gecmis.Count - 3) kayıt) <i class="bi bi-chevron-down"></i></summary>
                    <div class="ykc-history-list">
                        @foreach (var gecmis in Model.Gecmis.Skip(3))
                        {
                            <div><time>@gecmis.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</time><span></span><section><strong>@Deger(gecmis.IslemTipi)</strong><small>@Deger(gecmis.KullaniciAdi) @if (!string.IsNullOrWhiteSpace(gecmis.Aciklama)) { <text>· @gecmis.Aciklama</text> }</small></section>@if (gecmis.YeniDurum.HasValue) { <span class="df-pill @DurumClass(gecmis.YeniDurum.Value)">@DurumYazi(gecmis.YeniDurum.Value)</span> }</div>
                        }
                    </div>
                </details>
            }
        }
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('click', event => {
            const button = event.target.closest('[data-picker]');
            if (!button) return;
            const input = document.querySelector(button.dataset.picker);
            if (!input) return;
            if (typeof input.showPicker === 'function') input.showPicker(); else input.focus();
        });

        (() => {
            const routeCards = Array.from(document.querySelectorAll('[data-route-ekip]'));
            const ekip = document.querySelector('input[name="AtananEkip"]');
            const tip = document.querySelector('input[name="AtananKullaniciTipi"]');
            const hedef = document.querySelector('input[name="HedefUygulama"]');
            const callCenter = document.querySelector('input[name="CallCenterTetiklenecekMi"]');
            const aciklama = document.querySelector('textarea[name="Aciklama"][placeholder="Atama ve yönlendirme notu"]');
            let otomatikNot = '';

            function selectRoute(card) {
                routeCards.forEach(item => { item.classList.remove('active'); item.setAttribute('aria-pressed', 'false'); });
                card.classList.add('active');
                card.setAttribute('aria-pressed', 'true');
                if (ekip) { ekip.value = card.dataset.routeEkip || ''; ekip.dispatchEvent(new Event('input', { bubbles: true })); }
                if (tip) tip.value = card.dataset.routeTip || '';
                if (hedef) hedef.value = card.dataset.routeHedef || '';
                if (callCenter) callCenter.value = card.dataset.routeCallcenter === 'true' ? 'true' : 'false';
                if (aciklama && (!aciklama.value.trim() || aciklama.value === otomatikNot)) {
                    otomatikNot = card.dataset.routeNote || '';
                    aciklama.value = otomatikNot;
                }
            }

            routeCards.forEach(card => {
                card.setAttribute('aria-pressed', 'false');
                card.addEventListener('click', () => selectRoute(card));
                if (ekip && ekip.value.trim().toLocaleLowerCase('tr-TR') === (card.dataset.routeEkip || '').toLocaleLowerCase('tr-TR')) selectRoute(card);
            });
        })();

        (() => {
            const date = document.getElementById('randevuTarihi');
            const time = document.getElementById('randevuSaati');
            const team = document.querySelector('input[name="AtananEkip"]');
            const region = document.querySelector('input[name="Bolge"]');
            const targets = {
                date: [document.getElementById('ykcPlanTarih')],
                time: [document.getElementById('ykcPlanSaat')],
                team: [document.getElementById('ykcPlanEkip')],
                region: [document.getElementById('ykcPlanBolge')]
            };
            const clean = current => current?.trim() || '-';
            const formatDate = current => {
                if (!current) return '-';
                const parts = current.split('-');
                return parts.length === 3 ? parts[2] + '.' + parts[1] + '.' + parts[0] : current;
            };
            function update() {
                if (date) targets.date.filter(Boolean).forEach(item => item.textContent = formatDate(date.value));
                if (time) targets.time.filter(Boolean).forEach(item => item.textContent = clean(time.value));
                if (team) targets.team.filter(Boolean).forEach(item => item.textContent = clean(team.value));
                if (region) targets.region.filter(Boolean).forEach(item => item.textContent = clean(region.value));
            }
            [date, time, team, region].filter(Boolean).forEach(item => { item.addEventListener('input', update); item.addEventListener('change', update); });
            update();
        })();
    </script>
}
