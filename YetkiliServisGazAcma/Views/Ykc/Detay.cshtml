            .ykc-actions, .df-actions { flex-direction: column; align-items: stretch; }
        }
    </style>
}

<div class="ykc-detail-stack">
    @if (TempData["Basarili"] != null)
    {
        <div class="df-alert df-alert-success">@TempData["Basarili"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <section class="df-page-panel ykc-hero">
        <div class="df-panel-head">
            <div>
                <h2 class="df-panel-title">Cihaz Değişim Talebi #@Model.Id</h2>
                <div class="df-panel-subtitle">@Deger(Model.FirmaAdi) / @Deger(Model.TesisatNo)</div>
            </div>
            <div class="df-actions">
                <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/talepler">Listeye Dön</a>
                <a class="df-btn df-btn-primary df-btn-sm" href="/ykc/fr265/onizle/@Model.Id" target="_blank">FR265 Önizle</a>
                <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/fr265/indir/@Model.Id">Belge İndir</a>
                <span class="df-pill @DurumClass(Model.Durum)">@DurumYazi(Model.Durum)</span>
            </div>
        </div>
        <div class="ykc-summary-grid">
            <div class="ykc-summary"><div class="ykc-summary-label">Tesisat</div><div class="ykc-summary-value">@Deger(Model.TesisatNo)</div></div>
            @if (icOperasyonGorsun)
            {
                <div class="ykc-summary"><div class="ykc-summary-label">İç Operasyon</div><div class="ykc-summary-value">@DurumYazi(Model.Durum)</div></div>
            }
            else
            {
                <div class="ykc-summary"><div class="ykc-summary-label">Durum</div><div class="ykc-summary-value">@DurumYazi(Model.Durum)</div></div>
            }
