@model YkcTalepDetayDto
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var ykcYetkileri = ViewBag.YkcYetkileri as YkcYetkiOzeti ?? new YkcYetkiOzeti();
    var atamaYetkisi = ykcYetkileri.AtamaYapabilir;
    var fr265ImzaYetkisi = ykcYetkileri.Fr265ImzaIslemiYapabilir;
    var yonetebilir = atamaYetkisi || fr265ImzaYetkisi;
    var icOperasyonGorsun = !User.IsInRole("SertifikaliFirma");
    var kaynak = Context.Request.Query["kaynak"].ToString() switch { "rapor" => "rapor", "takvim" => "takvim", _ => "" };
    var geriUrl = kaynak == "rapor" && icOperasyonGorsun ? "/ykc/raporlar" : kaynak == "takvim" && icOperasyonGorsun ? "/ykc/takvim" : "/ykc/talepler";
    var geriMetni = kaynak == "rapor" && icOperasyonGorsun ? "Raporlara Dön" : kaynak == "takvim" && icOperasyonGorsun ? "Takvime Dön" : "Taleplere Dön";
    ViewData["PanelSubtitle"] = "Cihaz Değişimi";
    var terminalDurum = Model.Durum == YkcDurumDegerleri.Tamamlandi || Model.Durum == YkcDurumDegerleri.Reddedildi || Model.Durum == YkcDurumDegerleri.Iptal;
    var imzaSureci = Model.ImzaSureci;
    var imzaSureciBasladi = !string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId)
        || imzaSureci?.Durum == YkcImzaDurumDegerleri.ImzayaGonderildi
        || imzaSureci?.Durum == YkcImzaDurumDegerleri.ImzaBekliyor
        || imzaSureci?.Durum == YkcImzaDurumDegerleri.KismiImzali
        || imzaSureci?.Durum == YkcImzaDurumDegerleri.Tamamlandi;
    var atamaYapilabilir = !imzaSureciBasladi
        && (Model.Durum == YkcDurumDegerleri.AtamaBekliyor || Model.Durum == YkcDurumDegerleri.Atandi || Model.Durum == YkcDurumDegerleri.SahaIsleminde);
    var tesisatBolgesi = string.IsNullOrWhiteSpace(Model.Bolge) ? Model.Il : Model.Bolge;
    var sonAtamaTipi = Model.Atamalar.FirstOrDefault()?.AtananKullaniciTipi ?? string.Empty;
    var acilEkipSecili = string.Equals(Model.HedefUygulama, YkcHedefUygulamaDegerleri.Crm187, StringComparison.OrdinalIgnoreCase)
        || sonAtamaTipi.Contains("187", StringComparison.OrdinalIgnoreCase)
        || (Model.AtananEkip?.Contains("187", StringComparison.OrdinalIgnoreCase) ?? false);
    var muhendisEkipSecili = !acilEkipSecili
        && (string.Equals(Model.HedefUygulama, YkcHedefUygulamaDegerleri.DogalgazMobileApp, StringComparison.OrdinalIgnoreCase)
            || sonAtamaTipi.Contains("Mühendis", StringComparison.OrdinalIgnoreCase)
            || (Model.AtananEkip?.Contains("Mühendis", StringComparison.OrdinalIgnoreCase) ?? false));
    var ekipler = ViewBag.Ekipler as List<YkcEkipSecenegi> ?? new();
    var mevcutEkipler = ekipler.Where(x => x.Secili).ToList();
    var seciliEkipId = mevcutEkipler.Count == 1 ? mevcutEkipler[0].Id : null;
    var imzaEntegrasyonu = ViewBag.ImzaEntegrasyonu as YkcImzaEntegrasyonDto ?? new YkcImzaEntegrasyonDto();
    var demoImzaModu = imzaEntegrasyonu.DemoModuMu;
    var imzaliBelge = imzaSureci?.NihaiDosyaId is int nihaiDosyaId
        ? Model.Dosyalar.FirstOrDefault(x => x.Id == nihaiDosyaId && x.DosyaTuru == YkcFormDosyaTuruDegerleri.Fr265ImzaliNihai)
        : null;
    var imzaliBelgeHazir = imzaliBelge != null
        && !string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId)
        && string.Equals(imzaSureci?.Durum, YkcImzaDurumDegerleri.Tamamlandi, StringComparison.OrdinalIgnoreCase);
    var gonderimTakildi = imzaSureci?.Durum == YkcImzaDurumDegerleri.ImzayaGonderildi
        && string.IsNullOrWhiteSpace(imzaSureci.ProviderDocumentId)
        && (!imzaSureci.GonderimTarihi.HasValue || imzaSureci.GonderimTarihi <= DateTime.Now.AddMinutes(-5));
    var sonKontrolKayitlari = Model.Kontroller
        .Where(x => x.KontrolNo is >= 1 and <= 5)
        .GroupBy(x => x.KontrolNo)
        .Select(x => x.OrderByDescending(k => k.KontrolTarihi ?? DateTime.MinValue).First())
        .OrderBy(x => x.KontrolNo)
        .ToList();
    var kontrolSatirlari = Enumerable.Range(1, 5)
        .Select(no => sonKontrolKayitlari.FirstOrDefault(x => x.KontrolNo == no) ?? new YkcFr265KontrolDto { KontrolNo = no })
        .ToList();
    var sonucGirilenKontroller = kontrolSatirlari
        .Where(x => x.Sonuc == YkcFr265KontrolSonucDegerleri.Uygun || x.Sonuc == YkcFr265KontrolSonucDegerleri.UygunDegil)
        .OrderBy(x => x.KontrolNo)
        .ToList();
    var sonKontrol = sonucGirilenKontroller.LastOrDefault();
    var kontrollerImzayaHazir = sonKontrol?.Sonuc == YkcFr265KontrolSonucDegerleri.Uygun;
    var siradakiKontrolNo = (sonKontrol?.KontrolNo ?? 0) + 1;
    var aktifKontrolNo = kontrollerImzayaHazir || siradakiKontrolNo > 5 ? (int?)null : siradakiKontrolNo;
    var aktifKontrol = aktifKontrolNo.HasValue
        ? kontrolSatirlari.FirstOrDefault(x => x.KontrolNo == aktifKontrolNo.Value)
        : null;
    var tekrarKontrolBekleniyor = sonKontrol?.Sonuc == YkcFr265KontrolSonucDegerleri.UygunDegil && aktifKontrolNo.HasValue;
    var talepImzayaHazir = Model.Durum == YkcDurumDegerleri.SahaIsleminde
        && Model.RandevuTarihi.HasValue
        && !string.IsNullOrWhiteSpace(Model.RandevuSaati)
        && kontrollerImzayaHazir;
    var imzayaGonderebilir = fr265ImzaYetkisi
        && imzaEntegrasyonu.KullanilabilirMi
        && talepImzayaHazir
        && string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId)
        && (imzaSureci?.Durum is null or YkcImzaDurumDegerleri.Hazir or YkcImzaDurumDegerleri.Hata || gonderimTakildi);
    var imzaDurumuSorgulanabilir = fr265ImzaYetkisi
        && imzaEntegrasyonu.KullanilabilirMi
        && !string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId)
        && !imzaliBelgeHazir;
    var kontrolBolumuAktif = icOperasyonGorsun
        && fr265ImzaYetkisi
        && Model.Durum == YkcDurumDegerleri.SahaIsleminde
        && !kontrollerImzayaHazir
        && aktifKontrol != null
        && !imzaliBelgeHazir
        && !imzaDurumuSorgulanabilir;
    var tamamlamayaHazir = Model.Durum == YkcDurumDegerleri.SahaIsleminde
        && imzaliBelgeHazir
        && fr265ImzaYetkisi;
    var imzaBirincilIslemVar = imzaliBelge != null || imzayaGonderebilir || imzaDurumuSorgulanabilir;
    var imzaBolumuGorsun = !icOperasyonGorsun
        || imzaliBelgeHazir
        || imzaDurumuSorgulanabilir
        || imzayaGonderebilir
        || kontrollerImzayaHazir
        || Model.Durum == YkcDurumDegerleri.Tamamlandi;
    var imzaBolumuAktif = imzaBolumuGorsun
        && (imzayaGonderebilir || imzaDurumuSorgulanabilir);
    var indirilebilirDosyalar = Model.Dosyalar
        .Where(x => x.DosyaTuru == YkcFormDosyaTuruDegerleri.TeknikEk
            || (x.DosyaTuru == YkcFormDosyaTuruDegerleri.Fr265ImzaliNihai && imzaliBelgeHazir && imzaliBelge != null && x.Id == imzaliBelge.Id))
        .ToList();
    var aktifAdim = Model.Durum switch
    {
        YkcDurumDegerleri.TalepAlindi => 1,
        YkcDurumDegerleri.AtamaBekliyor => 2,
        YkcDurumDegerleri.Atandi => 3,
        YkcDurumDegerleri.SahaIsleminde => 4,
        YkcDurumDegerleri.Tamamlandi => 5,
        _ => 2
    };
    var gorevBasligi = Model.Durum switch
    {
        YkcDurumDegerleri.TalepAlindi => "Talebi incelemeye alın",
        YkcDurumDegerleri.AtamaBekliyor => "Randevu ve yönlendirmeyi planlayın",
        YkcDurumDegerleri.Atandi => "Randevu sonucunu kaydedin",
        YkcDurumDegerleri.SahaIsleminde => "Form ve imza işlemlerini tamamlayın",
        YkcDurumDegerleri.Tamamlandi => "Talep tamamlandı",
        YkcDurumDegerleri.Reddedildi => "Talep reddedildi",
        YkcDurumDegerleri.Iptal => "Talep iptal edildi",
        _ => "Talebi inceleyin"
    };
    var gorevAciklamasi = Model.Durum switch
    {
        YkcDurumDegerleri.TalepAlindi => "Cihaz bilgilerini karşılaştırın ve kaydı inceleme sürecine alın.",
        YkcDurumDegerleri.AtamaBekliyor => "Tesisattan belirlenen bölge için ekibi ve randevu bilgisini kaydedin.",
        YkcDurumDegerleri.Atandi => "Randevu gerçekleştiyse saha kontrolünü başlatın; gidilemediyse randevuyu güncelleyin.",
        YkcDurumDegerleri.SahaIsleminde => "Kontrol sonucunu kaydedin, formu inceleyin ve imza durumunu takip edin.",
        YkcDurumDegerleri.Tamamlandi => "İmzalı belgeyi ve işlem geçmişini görüntüleyebilirsiniz.",
        YkcDurumDegerleri.Reddedildi => "Red gerekçesi işlem geçmişinde yer alır.",
        YkcDurumDegerleri.Iptal => "İptal bilgisi işlem geçmişinde yer alır.",
        _ => "Talebin güncel bilgilerini kontrol edin."
    };
    if (icOperasyonGorsun && Model.Durum == YkcDurumDegerleri.SahaIsleminde)
    {
        if (imzaliBelgeHazir)
        {
            gorevBasligi = "İmzalı form hazır";
            gorevAciklamasi = "İmzalı belgeyi kontrol edip işlemi tamamlayabilirsiniz.";
        }
        else if (imzaDurumuSorgulanabilir)
        {
            gorevBasligi = "İmza sonucunu güncelleyin";
            gorevAciklamasi = "Form imza uygulamasına gönderildi. Sonucu almak için imza durumunu güncelleyin.";
        }
        else if (imzayaGonderebilir)
        {
            gorevBasligi = "Formu önizleyip imzaya gönderin";
            gorevAciklamasi = "Kontrol tamamlandı. Form doğruysa imzaya gönderin.";
        }
        else if (!kontrollerImzayaHazir && aktifKontrol == null)
        {
            gorevBasligi = "Kontrol uygun tamamlanmadı";
            gorevAciklamasi = "Formdaki kontrol alanları kullanıldı. Yeni kontrol için iş kuralı netleştirilmelidir.";
        }
        else if (tekrarKontrolBekleniyor)
        {
            gorevBasligi = $"{aktifKontrolNo}. kontrol sonucunu girin";
            gorevAciklamasi = "Önceki kontrolde uygunsuzluk kaydedildi. Firma eksikliği giderdikten sonra bu kontrol satırında uygun veya uygun değil kararını kaydedin.";
        }
        else if (!kontrollerImzayaHazir)
        {
            gorevBasligi = "Kontrol sonucunu girin";
            gorevAciklamasi = "Kontrol sonucunu Uygun veya Uygun Değil olarak kaydedin.";
        }
    }
    if (!icOperasyonGorsun)
    {
        gorevBasligi = Model.Durum switch
        {
            YkcDurumDegerleri.TalepAlindi => "Talebiniz alındı",
            YkcDurumDegerleri.AtamaBekliyor => "Talebiniz inceleniyor",
            YkcDurumDegerleri.Atandi => "Randevunuz oluşturuldu",
            YkcDurumDegerleri.SahaIsleminde => imzaliBelgeHazir ? "İmzalı form hazır" : "Form ve imza süreci devam ediyor",
            _ => gorevBasligi
        };
        gorevAciklamasi = Model.Durum switch
        {
            YkcDurumDegerleri.TalepAlindi => "Tesisat ve cihaz bilgileriniz kontrol için kaydedildi.",
            YkcDurumDegerleri.AtamaBekliyor => "Talebiniz değerlendiriliyor. Randevu oluşturulduğunda burada görebileceksiniz.",
            YkcDurumDegerleri.Atandi => "Planlanan randevu tarihini ve talebinizin güncel durumunu takip edebilirsiniz.",
            YkcDurumDegerleri.SahaIsleminde => imzaliBelgeHazir ? "İmzalı belgeyi indirip talep durumunu takip edebilirsiniz." : "Formu ve dijital imza sonucunu bu ekrandan takip edebilirsiniz.",
            _ => gorevAciklamasi
        };
    }
    var formYardimMetni = demoImzaModu
        ? "Geliştirme ortamında süreç aynı form üzerinden test edilir. Gerçek e-imza entegrasyonu bağlandığında bu adım imza uygulamasına gider."
        : imzaEntegrasyonu.KullanilabilirMi
        ? "Kontrol edilen form dijital imza uygulamasına gönderilir. Süreç tamamlandığında imzalı belge bu kayda eklenir."
        : "Form önizlenebilir. Dijital imza bağlantısı etkinleşmeden belge gönderilmiş veya imzalanmış sayılmaz.";
    var gorevIkonu = terminalDurum ? "bi-check2-circle"
        : Model.Durum == YkcDurumDegerleri.TalepAlindi ? "bi-inbox"
        : Model.Durum == YkcDurumDegerleri.AtamaBekliyor ? "bi-calendar2-plus"
        : Model.Durum == YkcDurumDegerleri.Atandi ? "bi-calendar2-check"
        : imzaliBelgeHazir ? "bi-file-earmark-check"
        : imzaDurumuSorgulanabilir ? "bi-arrow-repeat"
        : imzayaGonderebilir ? "bi-send-check"
        : "bi-clipboard2-check";
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Tarih(DateTime? value) => value.HasValue ? value.Value.ToString("dd.MM.yyyy") : "-";
    private static string? Secili(bool kosul) => kosul ? "selected" : null;
    private static string EvetHayir(bool? value) => value.HasValue ? (value.Value ? "Evet" : "Hayır") : "-";
    private static string DurumYazi(int durum) => YkcDurumSunumu.Etiket(durum);
    private static string DurumClass(int durum) => YkcDurumSunumu.CssSinifi(durum);
    private static string GecmisIslemYazi(string? islemTipi) => islemTipi switch
    {
        "TalepOlusturuldu" => "Talep oluşturuldu",
        "DurumGuncellendi" => "Durum güncellendi",
        "AtamaYapildi" => "Randevu ve yönlendirme kaydedildi",
        "FR265TaslakOlusturuldu" => "Form hazırlandı",
        "FR265ImzayaGonderildi" => "Form imzaya gönderildi",
        "FR265ImzaliNihaiBelgeAlindi" => "İmzalı form alındı",
        "FR265DemoNihaiBelgeYenilendi" => "İmzalı form yenilendi",
        "FR265KontrolleriGuncellendi" => "Kontrol sonucu kaydedildi",
        "DosyaEklendi" => "Belge eklendi",
        _ => Deger(islemTipi)
    };

    private static bool DurumDegisimiMi(string? islemTipi)
    {
        return string.Equals(islemTipi, "DurumGuncellendi", StringComparison.OrdinalIgnoreCase);
    }

    private static string GecmisAciklamaYazi(string? islemTipi, string? aciklama) => islemTipi switch
    {
        "FR265TaslakOlusturuldu" => "Formun imzaya gönderilecek sürümü hazırlandı.",
        "FR265ImzayaGonderildi" => "Form dijital imza uygulamasına gönderildi.",
        "FR265ImzaliNihaiBelgeAlindi" => "İmzalı nihai belge kayda alındı.",
        "FR265DemoNihaiBelgeYenilendi" => "Demo imzalı belge PDF olarak yenilendi.",
        "FR265KontrolleriGuncellendi" => "Kontrol sonucu kaydedildi.",
        _ => Deger(aciklama)
    };

    private static string RandevuYazi(DateTime? tarih, string? saat)
    {
        if (!tarih.HasValue && string.IsNullOrWhiteSpace(saat))
            return "Henüz planlanmadı";

        return string.Join(" ", new[]
        {
            tarih?.ToString("dd.MM.yyyy"),
            string.IsNullOrWhiteSpace(saat) ? null : saat
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string DosyaTuruYazi(string? tur) => tur switch
    {
        YkcFormDosyaTuruDegerleri.Fr265Taslak => "Form Taslağı",
        YkcFormDosyaTuruDegerleri.Fr265ImzayaGonderilen => "İmzaya Gönderilen Form",
        YkcFormDosyaTuruDegerleri.Fr265ImzaliAday => "Doğrulama Bekleyen İmzalı Belge",
        YkcFormDosyaTuruDegerleri.Fr265ImzaliNihai => "İmzalı Nihai Belge",
        YkcFormDosyaTuruDegerleri.TeknikEk => "Teknik Ek",
        _ => Deger(tur)
    };

    private static string ImzaDurumYazi(string? durum) => durum switch
    {
        YkcImzaDurumDegerleri.Hazir => "Önizlemeye Hazır",
        YkcImzaDurumDegerleri.ImzayaGonderildi => "İmzaya Gönderildi",
        YkcImzaDurumDegerleri.ImzaBekliyor => "İmza Bekliyor",
        YkcImzaDurumDegerleri.KismiImzali => "İmzalar Tamamlanıyor",
        YkcImzaDurumDegerleri.Tamamlandi => "İmzalı Belge Hazır",
        YkcImzaDurumDegerleri.Hata => "İmza İşlemi Hatası",
        YkcImzaDurumDegerleri.Iptal => "İptal",
        _ => "Önizlemeye Hazır"
    };

    private static string KontrolSonucYazi(string? sonuc) => sonuc switch
    {
        YkcFr265KontrolSonucDegerleri.Uygun => "Uygun",
        YkcFr265KontrolSonucDegerleri.UygunDegil => "Uygun Değil",
        _ => "Henüz girilmedi"
    };

    private static string KontrolSonucClass(string? sonuc) => sonuc switch
    {
        YkcFr265KontrolSonucDegerleri.Uygun => "df-pill-success",
        YkcFr265KontrolSonucDegerleri.UygunDegil => "df-pill-danger",
        _ => "df-pill-warning"
    };

    private static string AkisClass(int adim, int aktifAdim, bool durduruldu)
    {
        if (durduruldu) return adim == aktifAdim ? "is-stopped" : adim < aktifAdim ? "is-complete" : "";
        if (adim < aktifAdim) return "is-complete";
        return adim == aktifAdim ? "is-active" : "";
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ykc-operations.css" asp-append-version="true" />
}

<div class="ykc-workspace ykc-detail-page is-streamlined" data-return-context="@kaynak">
    @if (TempData["Basarili"] != null)
    {
        <div class="df-alert df-alert-success">@TempData["Basarili"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <header class="ykc-page-header ykc-detail-header">
        <div class="ykc-page-heading">
            <div class="ykc-detail-reference"><i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>Cihaz Değişim Talebi <strong>#@Model.Id</strong></span></div>
            <h1>@Deger(Model.MusteriAdi)</h1>
            <p>Tesisat @Deger(Model.TesisatNo) <span aria-hidden="true">·</span> @Deger(Model.FirmaAdi)</p>
        </div>
        <div class="ykc-header-actions">
            <span class="ykc-header-status @DurumClass(Model.Durum)">@DurumYazi(Model.Durum)</span>
            <a class="df-btn df-btn-secondary df-btn-sm" href="@geriUrl"><i class="bi bi-arrow-left"></i> @geriMetni</a>
            <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/fr265/onizle/@Model.Id" target="_blank"><i class="bi bi-eye"></i> Formu Önizle</a>
        </div>
        <dl class="ykc-detail-facts">
            @if (icOperasyonGorsun)
            {
                <div><dt><i class="bi bi-geo-alt" aria-hidden="true"></i> Bölge</dt><dd id="ykcPlanBolge">@Deger(Model.Bolge)</dd></div>
                <div><dt><i class="bi bi-people" aria-hidden="true"></i> Yönlendirme</dt><dd id="ykcPlanEkip">@Deger(Model.AtananEkip)</dd></div>
            }
            <div><dt><i class="bi bi-calendar3" aria-hidden="true"></i> Randevu</dt><dd><span id="ykcPlanTarih">@(Model.RandevuTarihi.HasValue ? Tarih(Model.RandevuTarihi) : string.IsNullOrWhiteSpace(Model.RandevuSaati) ? "Henüz planlanmadı" : "")</span> <span id="ykcPlanSaat">@(string.IsNullOrWhiteSpace(Model.RandevuSaati) ? "" : Model.RandevuSaati)</span></dd></div>
            <div><dt><i class="bi bi-pen" aria-hidden="true"></i> Form ve İmza</dt><dd>@(imzaliBelgeHazir ? "İmzalı form hazır" : ImzaDurumYazi(imzaSureci?.Durum))</dd></div>
        </dl>
    </header>

    <nav class="ykc-process-line" aria-label="Talep süreci">
        @foreach (var adim in new[] {
            new { No = 1, Baslik = "Talep" },
            new { No = 2, Baslik = "İnceleme" },
            new { No = 3, Baslik = "Randevu" },
            new { No = 4, Baslik = "Form & İmza" },
            new { No = 5, Baslik = "Tamamlandı" }
        })
        {
            <div class="@AkisClass(adim.No, aktifAdim, Model.Durum == YkcDurumDegerleri.Reddedildi || Model.Durum == YkcDurumDegerleri.Iptal)">
                <span>@(adim.No < aktifAdim ? "✓" : adim.No.ToString())</span>
                <strong>@adim.Baslik</strong>
            </div>
        }
    </nav>

    <nav class="ykc-detail-index" aria-label="Talep bölümleri">
        <a href="#current-task-title">@(terminalDurum ? "Sonuç" : "İşlem")</a>
        @if (icOperasyonGorsun) { <a href="#device-comparison">Cihaz Karşılaştırması</a> }
        <a href="#record-details">Tesisat ve Firma</a>
        @if (imzaBolumuGorsun) { <a href="#fr265-signature">Belgeler</a> }
        <a href="#request-history">Geçmiş</a>
    </nav>

    <section class="ykc-focus-section @(terminalDurum ? "is-resolved" : null)" aria-labelledby="current-task-title">
        <header class="ykc-focus-header">
            <span class="ykc-focus-icon" aria-hidden="true"><i class="bi @gorevIkonu"></i></span>
            <div>
                <span class="ykc-section-kicker">@(terminalDurum ? "Talep sonucu" : "Şimdi yapılacak işlem")</span>
                <h2 id="current-task-title">@gorevBasligi</h2>
                <p>@gorevAciklamasi</p>
            </div>
        </header>

        @if (!icOperasyonGorsun)
        {
            <div class="ykc-firm-progress">
                @if (imzaliBelge != null)
                {
                    <a class="df-btn df-btn-secondary" href="/ykc/dosya/@imzaliBelge.Id" target="_blank"><i class="bi bi-download"></i> İmzalı Belgeyi İndir</a>
                }
            </div>
        }
        else if (yonetebilir)
        {
            @if (Model.Durum == YkcDurumDegerleri.TalepAlindi && atamaYetkisi)
            {
                <form method="post" action="/ykc/durum-guncelle" class="ykc-inline-action-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TalepId" value="@Model.Id" />
                    <input type="hidden" name="Durum" value="@YkcDurumDegerleri.AtamaBekliyor" />
                    <div class="ykc-field ykc-grow"><label>İnceleme Notu</label><textarea name="Aciklama" placeholder="Gerekliyse kısa bir not ekleyin"></textarea></div>
                    <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-check2"></i> İncelemeye Al</button>
                </form>
            }

            @if (Model.Durum == YkcDurumDegerleri.Atandi && (atamaYetkisi || fr265ImzaYetkisi))
            {
                <div class="ykc-current-plan">
                    <div><span>Planlanan randevu</span><strong>@RandevuYazi(Model.RandevuTarihi, Model.RandevuSaati)</strong></div>
                    <div><span>Yönlendirilen birim / kişi</span><strong>@Deger(Model.AtananEkip)</strong></div>
                    <div class="ykc-appointment-confirmation">
                        <form method="post" action="/ykc/durum-guncelle">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="TalepId" value="@Model.Id" />
                            <input type="hidden" name="Durum" value="@YkcDurumDegerleri.SahaIsleminde" />
                            <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-check2-circle"></i> Randevu Gerçekleşti</button>
                        </form>
                        <small>Sahaya giden ekip veya personel doğruladıktan sonra kaydedilir.</small>
                    </div>
                </div>
            }

            @if (tamamlamayaHazir && fr265ImzaYetkisi)
            {
                <div class="ykc-current-plan @(tamamlamayaHazir ? "is-final-ready" : null)">
                    @if (tamamlamayaHazir)
                    {
                        <div class="ykc-final-toolbar" aria-label="İmzalı form işlemleri">
                            @if (imzaliBelge != null)
                            {
                                <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/dosya/@imzaliBelge.Id" target="_blank"><i class="bi bi-download"></i> İmzalı Belgeyi İndir</a>
                            }
                            <form method="post" action="/ykc/durum-guncelle">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="TalepId" value="@Model.Id" />
                                <input type="hidden" name="Durum" value="@YkcDurumDegerleri.Tamamlandi" />
                                <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-check2-circle"></i> İşlemi Tamamla</button>
                            </form>
                        </div>
                    }
                </div>
            }

            @if (imzayaGonderebilir && fr265ImzaYetkisi)
            {
                <div class="ykc-current-plan is-signature-ready">
                    <div class="ykc-final-toolbar" aria-label="Form imza işlemleri">
                        <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/fr265/onizle/@Model.Id" target="_blank"><i class="bi bi-eye"></i> Formu Önizle</a>
                        <form method="post" action="/ykc/imzaya-gonder">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="talepId" value="@Model.Id" />
                            <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-send"></i> Önizledim, İmzaya Gönder</button>
                        </form>
                    </div>
                </div>
            }
            else if (imzaDurumuSorgulanabilir && fr265ImzaYetkisi)
            {
                <div class="ykc-current-plan is-signature-ready">
                    <div class="ykc-final-toolbar" aria-label="İmza durumu işlemi">
                        <form method="post" action="/ykc/imza-durum-sorgula">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="talepId" value="@Model.Id" />
                            <button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-arrow-repeat"></i> İmza Durumunu Güncelle</button>
                        </form>
                    </div>
                </div>
            }

            @if (atamaYapilabilir && atamaYetkisi)
            {
                <details class="ykc-assignment-disclosure" open="@(Model.Durum == YkcDurumDegerleri.AtamaBekliyor ? "open" : null)">
                    <summary>
                        <span><strong>@(Model.Durum == YkcDurumDegerleri.AtamaBekliyor ? "Randevu ve yönlendirme bilgileri" : "Randevuyu güncelle")</strong></span>
                        <i class="bi bi-chevron-down"></i>
                    </summary>
                    <form method="post" action="/ykc/atama-yap" class="ykc-assignment-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TalepId" value="@Model.Id" />
                        <input type="hidden" name="Bolge" value="@tesisatBolgesi" />

                        <div class="ykc-assignment-region">
                            <i class="bi bi-geo-alt-fill"></i>
                            <span><small>Planlama Bölgesi</small><strong>@Deger(tesisatBolgesi)</strong></span>
                        </div>

                        <div class="ykc-assignment-fields">
                            <div class="ykc-field"><label for="ykcRoute">Yönlendirme</label>
                                <select id="ykcRoute" name="AtananKullaniciTipi" required>
                                    <option value="">Seçin</option>
                                    <option value="CRM187" selected="@acilEkipSecili">187 Acil</option>
                                    <option value="Mühendis" selected="@muhendisEkipSecili">Mühendis</option>
                                </select>
                            </div>
                            <div class="ykc-field"><label for="ykcTeam">Bölgeye Tanımlı Ekip / Personel</label>
                                <select id="ykcTeam" name="EkipId">
                                    <option value="">Birim yönlendirmesi (personel atanmadı)</option>
                                    @foreach (var ekip in ekipler)
                                    {
                                        <option value="@ekip.Id" data-route="@ekip.YonlendirmeTipi" selected="@(ekip.Id == seciliEkipId)">@ekip.Ad</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="ykc-assignment-fields">
                            <div class="ykc-field"><label>Randevu Tarihi</label><div class="ykc-picker"><input id="randevuTarihi" type="date" name="RandevuTarihi" value="@Model.RandevuTarihi?.ToString("yyyy-MM-dd")" min="@DateTime.Now.ToString("yyyy-MM-dd")" required /><button type="button" data-picker="#randevuTarihi" title="Takvimi aç"><i class="bi bi-calendar3"></i></button></div></div>
                            <div class="ykc-field"><label>Randevu Saati</label><div class="ykc-picker"><input id="randevuSaati" type="time" name="RandevuSaati" value="@Model.RandevuSaati" required /><button type="button" data-picker="#randevuSaati" title="Saati seç"><i class="bi bi-clock"></i></button></div></div>
                            <div class="ykc-field ykc-field-wide"><label>Not</label><textarea name="Aciklama" placeholder="Atama ve yönlendirme notu"></textarea></div>
                        </div>
                        <div class="ykc-form-actions"><button class="df-btn df-btn-primary" type="submit"><i class="bi bi-calendar2-check"></i> @(Model.Durum == YkcDurumDegerleri.AtamaBekliyor ? "Randevuyu Kaydet" : "Randevuyu Güncelle")</button></div>
                    </form>
                </details>
            }

            @if (!terminalDurum && atamaYetkisi)
            {
                <details class="ykc-other-actions">
                    <summary>Diğer işlemler <i class="bi bi-chevron-down"></i></summary>
                    <form method="post" action="/ykc/durum-guncelle">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TalepId" value="@Model.Id" />
                        <div class="ykc-field"><label>Açıklama</label><textarea name="Aciklama" placeholder="Red veya iptal gerekçesi">@Model.RedAciklama</textarea></div>
                        <div class="ykc-form-actions is-left">
                            <button class="df-btn df-btn-secondary df-btn-sm" type="submit" name="Durum" value="@YkcDurumDegerleri.Reddedildi"><i class="bi bi-x-circle"></i> Reddet</button>
                            <button class="df-btn df-btn-secondary df-btn-sm" type="submit" name="Durum" value="@YkcDurumDegerleri.Iptal"><i class="bi bi-slash-circle"></i> İptal Et</button>
                        </div>
                    </form>
                </details>
            }
        }
        else
        {
            <div class="ykc-terminal-message">Bu talebi görüntüleyebilirsiniz. Atama veya form işlemi için ayrıca YKC operasyon yetkisi gerekir.</div>
        }
        @if (icOperasyonGorsun && terminalDurum && imzaliBelge != null)
        {
            <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/dosya/@imzaliBelge.Id" target="_blank"><i class="bi bi-download"></i> İmzalı Belgeyi İndir</a>
        }
        @if (demoImzaModu && imzaliBelgeHazir)
        {
            <p class="ykc-demo-caption"><i class="bi bi-info-circle"></i> Demo belgesidir; gerçek e-imza içermez.</p>
        }
    @if (icOperasyonGorsun && (Model.Durum == YkcDurumDegerleri.SahaIsleminde || sonucGirilenKontroller.Any()))
    {
        <details class="ykc-detail-section @(kontrolBolumuAktif ? "is-current-task" : null)" id="fr265-controls" data-auto-focus="@(kontrolBolumuAktif ? "true" : "false")" tabindex="-1" open="@(kontrolBolumuAktif ? "open" : null)">
            <summary><span><strong>Kontrol Sonucu</strong><small>@(aktifKontrolNo.HasValue ? $"{aktifKontrolNo}. kontrol" : "Kontrol geçmişi")</small></span><i class="bi bi-chevron-down"></i></summary>
            <div class="ykc-detail-section-body">
                @if (sonucGirilenKontroller.Any())
                {
                    <div class="ykc-control-history">
                        @foreach (var kontrol in sonucGirilenKontroller)
                        {
                            <div>
                                <span>@(kontrol.KontrolNo). kontrol</span>
                                <strong class="@KontrolSonucClass(kontrol.Sonuc)">@KontrolSonucYazi(kontrol.Sonuc)</strong>
                                @if (!string.IsNullOrWhiteSpace(kontrol.Aciklama))
                                {
                                    <small>@kontrol.Aciklama</small>
                                }
                            </div>
                        }
                    </div>
                }

                @if (fr265ImzaYetkisi && kontrolBolumuAktif && aktifKontrol != null)
                {
                    <form method="post" action="/ykc/kontroller-kaydet" class="ykc-control-active">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TalepId" value="@Model.Id" />
                        <input type="hidden" name="Kontroller[0].KontrolNo" value="@aktifKontrol.KontrolNo" />
                        <div>
                            <span class="ykc-section-kicker">Sıradaki kayıt</span>
                            <h3>@(aktifKontrol.KontrolNo). Kontrol</h3>
                        </div>
                        <fieldset class="ykc-control-choice-group">
                            <legend>Kontrol sonucu</legend>
                            <label><input type="radio" name="Kontroller[0].Sonuc" value="@YkcFr265KontrolSonucDegerleri.Uygun" required /> Uygun</label>
                            <label><input type="radio" name="Kontroller[0].Sonuc" value="@YkcFr265KontrolSonucDegerleri.UygunDegil" required /> Uygun Değil</label>
                        </fieldset>
                        <div class="ykc-field">
                            <label>Uygun değil ise nedeni</label>
                            <textarea name="Kontroller[0].Aciklama" placeholder="Uygun değilse nedeni yazın">@aktifKontrol.Aciklama</textarea>
                        </div>
                        <div class="ykc-form-actions"><button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-save"></i> Kontrolü Kaydet</button></div>
                    </form>
                }
                else if (kontrollerImzayaHazir)
                {
                    <div class="ykc-inline-status is-success"><i class="bi bi-check2-circle"></i> Kontrol uygun. Form imzaya gönderilebilir.</div>
                }
                else if (!fr265ImzaYetkisi)
                {
                    <div class="ykc-inline-status is-info"><i class="bi bi-info-circle"></i> Kontrol sonucu girmek için form ve imza yetkisi gerekir.</div>
                }
            </div>
        </details>
    }

    @if (imzaBolumuGorsun)
    {
        <details class="ykc-detail-section @(imzaBolumuAktif ? "is-current-task" : null)" id="fr265-signature" open="@(imzaBolumuAktif ? "open" : null)">
            <summary><span><strong>Form ve Dijital İmza</strong><small>@ImzaDurumYazi(imzaSureci?.Durum)</small></span><i class="bi bi-chevron-down"></i></summary>
            <div class="ykc-detail-section-body">
                @if (demoImzaModu && (imzayaGonderebilir || imzaDurumuSorgulanabilir || imzaliBelgeHazir))
                {
                    <div class="ykc-demo-mode"><i class="bi bi-info-circle"></i><span><strong>Geliştirme ortamı</strong><small>Gerçek e-imza bağlantısı yerine demo sağlayıcı kullanılıyor.</small></span></div>
                }
                <dl class="ykc-signature-summary">
                    <div><dt>İmza Durumu</dt><dd><span class="df-pill @(imzaliBelgeHazir ? "df-pill-success" : "df-pill-warning")">@ImzaDurumYazi(imzaSureci?.Durum)</span></dd></div>
                    <div><dt>Sağlayıcı</dt><dd>@Deger(imzaEntegrasyonu.ProviderAdi)</dd></div>
                    <div><dt>Belge No</dt><dd>@(string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId) ? "Henüz gönderilmedi" : imzaSureci.ProviderDocumentId)</dd></div>
                </dl>
                <div class="ykc-form-actions is-left">
                    @if (imzaliBelge != null)
                    {
                        @if (demoImzaModu && fr265ImzaYetkisi && !(imzaliBelge.DosyaAdi?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ?? false))
                        {
                            <form method="post" action="/ykc/imza-durum-sorgula">@Html.AntiForgeryToken()<input type="hidden" name="talepId" value="@Model.Id" /><button class="df-btn df-btn-secondary df-btn-sm" type="submit"><i class="bi bi-file-earmark-pdf"></i> Eski Demo Belgesini PDF Olarak Yenile</button></form>
                        }
                    }
                    @if (!imzayaGonderebilir && !imzaDurumuSorgulanabilir)
                    {
                        <a class="df-btn @(imzaBirincilIslemVar || terminalDurum ? "df-btn-secondary" : "df-btn-primary") df-btn-sm" href="/ykc/fr265/onizle/@Model.Id" target="_blank"><i class="bi bi-eye"></i> Formu Önizle</a>
                    }
                </div>
                @if (!imzaEntegrasyonu.KullanilabilirMi)
                {
                    <div class="ykc-integration-note"><i class="bi bi-info-circle"></i> Dijital imza bağlantısı henüz etkin değil. Önizleme gerçek talep verileriyle kullanılabilir.</div>
                }
                @if (fr265ImzaYetkisi)
                {
                    <details class="ykc-transition-upload">
                        <summary>Teknik ek belge ekle <i class="bi bi-chevron-down"></i></summary>
                        <form method="post" action="/ykc/form-yukle" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="talepId" value="@Model.Id" />
                            <input type="hidden" name="dosyaTuru" value="@YkcFormDosyaTuruDegerleri.TeknikEk" />
                            <div class="ykc-field"><label>Belge</label><input type="file" name="formDosyasi" accept=".pdf,.jpg,.jpeg,.png" /></div>
                            <button class="df-btn df-btn-secondary df-btn-sm" type="submit">Teknik Ek Ekle</button>
                        </form>
                    </details>
                }
                @if (indirilebilirDosyalar.Any())
                {
                    <div class="ykc-document-list">
                        @foreach (var dosya in indirilebilirDosyalar)
                        {
                            <a href="/ykc/dosya/@dosya.Id" target="_blank"><i class="bi bi-file-earmark"></i><span><strong>@Deger(dosya.DosyaAdi)</strong><small>@DosyaTuruYazi(dosya.DosyaTuru) · @dosya.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</small></span><i class="bi bi-download"></i></a>
                        }
                    </div>
                }
            </div>
        </details>
    }

    </section>

    @if (icOperasyonGorsun)
    {
    <details class="ykc-detail-section ykc-device-comparison" id="device-comparison" open="@(Model.Durum <= YkcDurumDegerleri.AtamaBekliyor || terminalDurum)">
        <summary><span class="ykc-disclosure-title"><i class="bi bi-arrow-left-right" aria-hidden="true"></i><strong>Cihaz Karşılaştırması</strong></span><i class="bi bi-chevron-down"></i></summary>
        <div class="ykc-detail-section-body">
        @foreach (var uyari in YkcCihazUyumKurali.Uyarilar(Model.EskiCihazTipi, Model.YeniCihazTipi, Model.EskiMarka, Model.YeniMarka, Model.EskiBacaTipi, Model.YeniBacaTipi, Model.EskiKapasite, Model.YeniKapasite))
        {
            <p class="ykc-comparison-warning"><i class="bi bi-exclamation-triangle"></i> @uyari</p>
        }
        <div class="ykc-table-scroll">
            <table class="ykc-comparison-table">
                <thead><tr><th>Özellik</th><th>Projedeki Cihaz</th><th>Yeni Kullanılan Cihaz</th></tr></thead>
                <tbody>
                    <tr><th>Yakıcı Cihaz Tipi</th><td>@Deger(Model.EskiCihazTipi)</td><td>@Deger(Model.YeniCihazTipi)</td></tr>
                    <tr><th>Marka</th><td>@Deger(Model.EskiMarka)</td><td>@Deger(Model.YeniMarka)</td></tr>
                    <tr><th>Baca Tipi</th><td>@Deger(Model.EskiBacaTipi)</td><td>@Deger(Model.YeniBacaTipi)</td></tr>
                    <tr><th>Kapasite (kcal/h)</th><td>@Deger(Model.EskiKapasite)</td><td>@Deger(Model.YeniKapasite)</td></tr>
                </tbody>
            </table>
        </div>
        <dl class="ykc-comparison-meta">
            <div><dt>Takılan cihaz ikinci el mi?</dt><dd>@EvetHayir(Model.IkinciElCihazMi)</dd></div>
        </dl>
        </div>
    </details>

    }

    <details class="ykc-detail-section ykc-record-details" id="record-details">
        <summary><span class="ykc-disclosure-title"><i class="bi bi-person-vcard" aria-hidden="true"></i><strong>Tesisat ve Firma Bilgileri</strong></span><i class="bi bi-chevron-down"></i></summary>
        <div class="ykc-detail-section-body">
            <section class="ykc-info-groups" aria-label="Talep bilgileri">
                <article>
                    <h2>Tesisat ve Müşteri</h2>
                    <dl>
                        <div><dt>Müşteri</dt><dd>@Deger(Model.MusteriAdi)</dd></div><div><dt>Telefon</dt><dd>@Deger(Model.MusteriTelefon)</dd></div>
                        <div><dt>Abone</dt><dd>@Deger(Model.AboneNo)</dd></div><div><dt>Sözleşme</dt><dd>@Deger(Model.SozlesmeNo)</dd></div>
                        <div><dt>Sayaç</dt><dd>@Deger(Model.SayacNo)</dd></div>
                        <div class="wide"><dt>Adres</dt><dd>@Deger(Model.Adres)</dd></div>
                    </dl>
                </article>
                <article>
                    <h2>Firma Bilgileri</h2>
                    <dl>
                        <div><dt>Firma</dt><dd>@Deger(Model.FirmaAdi)</dd></div><div><dt>Şirket</dt><dd>@Deger(Model.SirketAdi)</dd></div>
                        <div><dt>VKN</dt><dd>@Deger(Model.Vkn)</dd></div><div><dt>Firma Kodu</dt><dd>@Deger(Model.FirmaKodu)</dd></div>
                        <div class="wide"><dt>İl / İlçe</dt><dd>@Deger(Model.Il) / @Deger(Model.Ilce)</dd></div>
                    </dl>
                </article>
            </section>
        </div>
    </details>

    <details class="ykc-content-section ykc-history-section" id="request-history">
        <summary class="ykc-section-heading"><div><h2>İşlem Geçmişi</h2></div><span>@Model.Gecmis.Count kayıt <i class="bi bi-chevron-down" aria-hidden="true"></i></span></summary>
        @if (!Model.Gecmis.Any())
        {
            <div class="ykc-empty-state">Henüz işlem geçmişi yok.</div>
        }
        else
        {
            <div class="ykc-history-list">
                @foreach (var gecmis in Model.Gecmis.Take(3))
                {
                    var gecmisDetaylari = new List<string>();
                    if (!string.IsNullOrWhiteSpace(gecmis.KullaniciAdi)) gecmisDetaylari.Add(gecmis.KullaniciAdi);
                    if (DurumDegisimiMi(gecmis.IslemTipi) && gecmis.YeniDurum.HasValue) gecmisDetaylari.Add(DurumYazi(gecmis.YeniDurum.Value));
                    if (!string.IsNullOrWhiteSpace(gecmis.Aciklama)) gecmisDetaylari.Add(GecmisAciklamaYazi(gecmis.IslemTipi, gecmis.Aciklama));
                    <div><time>@gecmis.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</time><span></span><section><strong>@GecmisIslemYazi(gecmis.IslemTipi)</strong>@if (gecmisDetaylari.Count > 0) { <small>@string.Join(" · ", gecmisDetaylari)</small> }</section></div>
                }
            </div>
            @if (Model.Gecmis.Count > 3)
            {
                <details class="ykc-history-more">
                    <summary>Tüm geçmişi göster (@(Model.Gecmis.Count - 3) kayıt) <i class="bi bi-chevron-down"></i></summary>
                    <div class="ykc-history-list">
                    @foreach (var gecmis in Model.Gecmis.Skip(3))
                    {
                        var gecmisDetaylari = new List<string>();
                        if (!string.IsNullOrWhiteSpace(gecmis.KullaniciAdi)) gecmisDetaylari.Add(gecmis.KullaniciAdi);
                        if (DurumDegisimiMi(gecmis.IslemTipi) && gecmis.YeniDurum.HasValue) gecmisDetaylari.Add(DurumYazi(gecmis.YeniDurum.Value));
                        if (!string.IsNullOrWhiteSpace(gecmis.Aciklama)) gecmisDetaylari.Add(GecmisAciklamaYazi(gecmis.IslemTipi, gecmis.Aciklama));
                        <div><time>@gecmis.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</time><span></span><section><strong>@GecmisIslemYazi(gecmis.IslemTipi)</strong>@if (gecmisDetaylari.Count > 0) { <small>@string.Join(" · ", gecmisDetaylari)</small> }</section></div>
                    }
                    </div>
                </details>
            }
        }
    </details>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.ykc-detail-index a').forEach(link => {
            link.addEventListener('click', () => {
                const target = document.querySelector(link.getAttribute('href'));
                if (target?.tagName === 'DETAILS') target.open = true;
            });
        });
        document.querySelectorAll('.ykc-detail-page form[method="post"]').forEach(form => {
            const context = document.querySelector('.ykc-detail-page').dataset.returnContext;
            if (!context) return;
            const input = document.createElement('input');
            input.type = 'hidden'; input.name = 'kaynak'; input.value = context; form.append(input);
        });
        document.addEventListener('click', event => {
            const button = event.target.closest('[data-picker]');
            if (!button) return;
            const input = document.querySelector(button.dataset.picker);
            if (!input) return;
            if (typeof input.showPicker === 'function') input.showPicker(); else input.focus();
        });

        (() => {
            const date = document.getElementById('randevuTarihi');
            const time = document.getElementById('randevuSaati');
            const route = document.getElementById('ykcRoute');
            const team = document.getElementById('ykcTeam');
            team?.addEventListener('change', () => {
                const selected = team.selectedOptions[0];
                if (selected?.dataset.route) route.value = selected.dataset.route;
            });
            route?.addEventListener('change', () => {
                if (team?.selectedOptions[0]?.dataset.route !== route.value) team.value = '';
            });
            document.querySelectorAll('form[action="/ykc/atama-yap"]').forEach(form => {
                form.addEventListener('submit', event => {
                    if (!date?.value || !time?.value) return;
                    const selected = new Date(date.value + 'T' + time.value);
                    if (!Number.isNaN(selected.valueOf()) && selected < new Date()) {
                        event.preventDefault();
                        alert('Geçmiş tarih veya saat için randevu kaydedilemez.');
                        date.focus();
                    }
                });
            });
        })();

        (() => {
            const controls = document.querySelector('#fr265-controls[data-auto-focus="true"]');
            if (!controls) return;

            controls.open = true;
        })();
    </script>
}
