@model YkcTalepDetayDto
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var yonetebilir = User.IsInRole("GenelSistemAdmin") || User.IsInRole("SuperAdmin") || User.IsInRole("SirketAdmin") || User.IsInRole("Personel");
    var icOperasyonGorsun = !User.IsInRole("SertifikaliFirma");
    var atamaYapilabilir = Model.Durum == YkcDurumDegerleri.AtamaBekliyor || Model.Durum == YkcDurumDegerleri.Atandi || Model.Durum == YkcDurumDegerleri.SahaIsleminde;
    var terminalDurum = Model.Durum == YkcDurumDegerleri.Tamamlandi || Model.Durum == YkcDurumDegerleri.Reddedildi || Model.Durum == YkcDurumDegerleri.Iptal;
    var imzaSureci = Model.ImzaSureci;
    var imzaEntegrasyonu = ViewBag.ImzaEntegrasyonu as YkcImzaEntegrasyonDto ?? new YkcImzaEntegrasyonDto();
    var imzaliBelge = imzaSureci?.NihaiDosyaId is int nihaiDosyaId
        ? Model.Dosyalar.FirstOrDefault(x => x.Id == nihaiDosyaId && x.DosyaTuru == YkcFormDosyaTuruDegerleri.Fr265ImzaliNihai)
        : null;
    var imzaliBelgeHazir = imzaliBelge != null
        && !string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId)
        && string.Equals(imzaSureci?.Durum, YkcImzaDurumDegerleri.Tamamlandi, StringComparison.OrdinalIgnoreCase);
    var gonderimTakildi = imzaSureci?.Durum == YkcImzaDurumDegerleri.ImzayaGonderildi
        && string.IsNullOrWhiteSpace(imzaSureci.ProviderDocumentId)
        && (!imzaSureci.GonderimTarihi.HasValue || imzaSureci.GonderimTarihi <= DateTime.Now.AddMinutes(-5));
    var imzayaGonderebilir = yonetebilir
        && imzaEntegrasyonu.KullanilabilirMi
        && string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId)
        && (imzaSureci?.Durum is null or YkcImzaDurumDegerleri.Hazir or YkcImzaDurumDegerleri.Hata || gonderimTakildi);
    var imzaDurumuSorgulanabilir = yonetebilir
        && imzaEntegrasyonu.KullanilabilirMi
        && !string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId)
        && !imzaliBelgeHazir;
    var kontrolSatirlari = Model.Kontroller.Any()
        ? Model.Kontroller
        : Enumerable.Range(1, 5).Select(no => new YkcFr265KontrolDto { KontrolNo = no }).ToList();
    var aktifAdim = Model.Durum switch
    {
        YkcDurumDegerleri.TalepAlindi => 1,
        YkcDurumDegerleri.AtamaBekliyor => 2,
        YkcDurumDegerleri.Atandi => 3,
        YkcDurumDegerleri.SahaIsleminde => 4,
        YkcDurumDegerleri.Tamamlandi => 5,
        _ => 2
    };
    var gorevBasligi = Model.Durum switch
    {
        YkcDurumDegerleri.TalepAlindi => "Talebi incelemeye alın",
        YkcDurumDegerleri.AtamaBekliyor => "187 veya mühendis yönlendirmesi yapın",
        YkcDurumDegerleri.Atandi => "Randevu planını doğrulayın",
        YkcDurumDegerleri.SahaIsleminde => "Saha ve FR265 sürecini tamamlayın",
        YkcDurumDegerleri.Tamamlandi => "İşlem tamamlandı",
        YkcDurumDegerleri.Reddedildi => "Talep reddedildi",
        YkcDurumDegerleri.Iptal => "Talep iptal edildi",
        _ => "Talebi inceleyin"
    };
    var gorevAciklamasi = Model.Durum switch
    {
        YkcDurumDegerleri.TalepAlindi => "Cihaz karşılaştırmasını kontrol ederek talebi yönlendirme kuyruğuna alın.",
        YkcDurumDegerleri.AtamaBekliyor => "Uygun yönlendirmeyi seçin, bölge ile randevu bilgisini girip kaydedin.",
        YkcDurumDegerleri.Atandi => "Atama kaydedildi. Randevu gerçekleştiğinde saha sürecini başlatın.",
        YkcDurumDegerleri.SahaIsleminde => "Kontrolleri kaydedin, FR265'i önizleyin ve imza durumunu izleyin.",
        YkcDurumDegerleri.Tamamlandi => "İmzalı nihai belge ve işlem geçmişi görüntülenebilir.",
        YkcDurumDegerleri.Reddedildi => "Red gerekçesi ve işlem geçmişi aşağıdaki kayıtlarda yer alır.",
        YkcDurumDegerleri.Iptal => "İptal bilgisi ve işlem geçmişi aşağıdaki kayıtlarda yer alır.",
        _ => "Talebin güncel bilgilerini kontrol edin."
    };
    if (!icOperasyonGorsun)
    {
        gorevBasligi = Model.Durum switch
        {
            YkcDurumDegerleri.TalepAlindi => "Talebiniz inceleme sırasına alındı",
            YkcDurumDegerleri.AtamaBekliyor => "İç tesisat incelemesi sürüyor",
            YkcDurumDegerleri.Atandi => "Randevu ve yönlendirme planlandı",
            YkcDurumDegerleri.SahaIsleminde => "Saha ve FR265 süreci devam ediyor",
            _ => gorevBasligi
        };
        gorevAciklamasi = Model.Durum switch
        {
            YkcDurumDegerleri.TalepAlindi => "Tesisat ve cihaz bilgileri iç tesisat personeli tarafından incelenecek.",
            YkcDurumDegerleri.AtamaBekliyor => "187 veya mühendis yönlendirmesi iç tesisat personeli tarafından planlanıyor.",
            YkcDurumDegerleri.Atandi => "Planlanan ekip ve randevu bilgilerini sağdaki özetten izleyebilirsiniz.",
            YkcDurumDegerleri.SahaIsleminde => "Kontrol, FR265 ve dijital imza durumu bu ekrandan takip edilebilir.",
            _ => gorevAciklamasi
        };
    }
    var formYardimMetni = imzaEntegrasyonu.KullanilabilirMi
        ? "Önizlemesi onaylanan FR265 dijital imza uygulamasına gönderilir. Süreç tamamlandığında sağlayıcıdan dönen imzalı nihai belge indirilir."
        : "FR265 önizlemesi hazırdır. Sağlayıcı bağlantısı yapılandırılana kadar belge imzaya gönderilmiş veya imzalanmış sayılmaz.";
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Tarih(DateTime? value) => value.HasValue ? value.Value.ToString("dd.MM.yyyy") : "-";
    private static string? Secili(bool kosul) => kosul ? "selected" : null;
    private static string EvetHayir(bool? value) => value.HasValue ? (value.Value ? "Evet" : "Hayır") : "-";
    private static string KisaHash(string? value) => string.IsNullOrWhiteSpace(value) ? "Belge henüz kilitlenmedi" : $"SHA-256 {value[..Math.Min(value.Length, 16)]}...";

    private static string KontrolYazi(string? eskiDeger, string? yeniDeger)
    {
        if (string.IsNullOrWhiteSpace(eskiDeger)) return "Atlandı";
        if (string.IsNullOrWhiteSpace(yeniDeger)) return "Eksik";
        return string.Equals(eskiDeger.Trim(), yeniDeger.Trim(), StringComparison.OrdinalIgnoreCase) ? "Uyumlu" : "Uyumsuz";
    }

    private static string KontrolClass(string? eskiDeger, string? yeniDeger) => KontrolYazi(eskiDeger, yeniDeger) switch
    {
        "Uyumlu" => "df-pill-success",
        "Uyumsuz" or "Eksik" => "df-pill-danger",
        _ => "df-pill-warning"
    };

    private static string DurumYazi(int durum) => YkcDurumSunumu.Etiket(durum);
    private static string DurumClass(int durum) => YkcDurumSunumu.CssSinifi(durum);

    private static string DosyaTuruYazi(string? tur) => tur switch
    {
        YkcFormDosyaTuruDegerleri.Fr265Taslak => "FR265 Taslak",
        YkcFormDosyaTuruDegerleri.Fr265ImzayaGonderilen => "İmzaya Gönderilen FR265",
        YkcFormDosyaTuruDegerleri.Fr265ImzaliAday => "Doğrulama Bekleyen İmzalı Belge",
        YkcFormDosyaTuruDegerleri.Fr265ImzaliNihai => "İmzalı Nihai Belge",
        YkcFormDosyaTuruDegerleri.TeknikEk => "Teknik Ek",
        _ => Deger(tur)
    };

    private static string ImzaDurumYazi(string? durum) => durum switch
    {
        YkcImzaDurumDegerleri.Hazir => "Önizleme Aşamasında",
        YkcImzaDurumDegerleri.ImzayaGonderildi => "İmzaya Gönderildi",
        YkcImzaDurumDegerleri.ImzaBekliyor => "İmza Bekliyor",
        YkcImzaDurumDegerleri.KismiImzali => "Kısmi İmzalı",
        YkcImzaDurumDegerleri.Tamamlandi => "İmzalı Nihai Belge Hazır",
        YkcImzaDurumDegerleri.Hata => "İmza Hatası",
        YkcImzaDurumDegerleri.Iptal => "İptal",
        _ => "Önizleme Hazır"
    };

    private static string KontrolSonucYazi(string? sonuc) => sonuc switch
    {
        YkcFr265KontrolSonucDegerleri.Uygun => "Uygun",
        YkcFr265KontrolSonucDegerleri.UygunDegil => "Uygun Değil",
        YkcFr265KontrolSonucDegerleri.Uygulanmaz => "Uygulanmaz",
        _ => "Bekliyor"
    };

    private static string KontrolSonucClass(string? sonuc) => sonuc switch
    {
        YkcFr265KontrolSonucDegerleri.Uygun => "df-pill-success",
        YkcFr265KontrolSonucDegerleri.UygunDegil => "df-pill-danger",
        YkcFr265KontrolSonucDegerleri.Uygulanmaz => "df-pill-primary",
        _ => "df-pill-warning"
    };

    private static string AkisClass(int adim, int aktifAdim, bool durduruldu)
    {
        if (durduruldu) return adim == aktifAdim ? "is-stopped" : adim < aktifAdim ? "is-complete" : "";
        if (adim < aktifAdim) return "is-complete";
        return adim == aktifAdim ? "is-active" : "";
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ykc-operations.css" asp-append-version="true" />
}

<div class="ykc-workspace ykc-detail-cockpit">
    @if (TempData["Basarili"] != null)
    {
        <div class="df-alert df-alert-success">@TempData["Basarili"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <section class="ykc-workspace-hero ykc-detail-hero">
        <div class="df-panel-head">
            <div class="ykc-hero-title-wrap">
                <span class="ykc-hero-mark"><i class="bi bi-file-earmark-text"></i></span>
                <div>
                    <div class="ykc-detail-eyebrow">Talep #@Model.Id · @Model.TalepTarihi.ToString("dd.MM.yyyy HH:mm")</div>
                    <h1 class="df-panel-title">@Deger(Model.MusteriAdi)</h1>
                    <div class="df-panel-subtitle">@Deger(Model.FirmaAdi) · Tesisat @Deger(Model.TesisatNo)</div>
                </div>
            </div>
            <div class="df-actions">
                <span class="ykc-hero-status @DurumClass(Model.Durum)">@DurumYazi(Model.Durum)</span>
                <a class="ykc-hero-secondary" href="/ykc/talepler" title="Talep listesine dön"><i class="bi bi-arrow-left"></i><span>Liste</span></a>
                <a class="ykc-hero-action" href="/ykc/fr265/onizle/@Model.Id" target="_blank"><i class="bi bi-eye"></i><span>FR265 Önizle</span></a>
            </div>
        </div>
        <div class="ykc-detail-summary">
            <div><small>Tesisat / Proje</small><strong>@Deger(Model.TesisatNo) / @Deger(Model.ProjeNo)</strong></div>
            <div><small>Bölge / Yönlendirme</small><strong><span id="ykcPlanBolge">@Deger(Model.Bolge)</span> / <span id="ykcPlanEkip">@Deger(Model.AtananEkip)</span></strong></div>
            <div><small>Randevu</small><strong><span id="ykcPlanTarih">@Tarih(Model.RandevuTarihi)</span> <span id="ykcPlanSaat">@Deger(Model.RandevuSaati)</span></strong></div>
            <div><small>Belge</small><strong>@(imzaliBelgeHazir ? "İmzalı Nihai Belge Hazır" : ImzaDurumYazi(imzaSureci?.Durum))</strong></div>
        </div>
        <div class="ykc-process-rail" aria-label="Talep süreci">
            @foreach (var adim in new[] {
                new { No = 1, Baslik = "Talep Alındı" },
                new { No = 2, Baslik = "Yönlendirme" },
                new { No = 3, Baslik = "Randevu" },
                new { No = 4, Baslik = "FR265 ve İmza" },
                new { No = 5, Baslik = "Tamamlandı" }
            })
            {
                <div class="ykc-process-node @AkisClass(adim.No, aktifAdim, Model.Durum == YkcDurumDegerleri.Reddedildi || Model.Durum == YkcDurumDegerleri.Iptal)">
                    <span>@adim.No</span><strong>@adim.Baslik</strong>
                </div>
            }
        </div>
    </section>

    <div class="ykc-detail-layout">
        <main class="ykc-detail-main">
            <section class="ykc-current-task-banner">
                <span><i class="bi bi-lightning-charge-fill"></i></span>
                <div><small>Şu anki aşama</small><strong>@gorevBasligi</strong><p>@gorevAciklamasi</p></div>
            </section>

            <section class="ykc-operation-card ykc-device-comparison">
                <header class="ykc-operation-head">
                    <div><span class="ykc-operation-icon is-device"><i class="bi bi-arrow-left-right"></i></span><div><h2>Cihaz Karşılaştırması</h2><p>Projedeki kayıt ile yeni cihaz aynı satırda değerlendirilir.</p></div></div>
                </header>
                <div class="ykc-device-table">
                    <div class="ykc-device-table-head">Alan</div><div class="ykc-device-table-head is-old">Projedeki Cihaz</div><div class="ykc-device-table-head is-new">Yeni Cihaz</div><div class="ykc-device-table-head">Sonuç</div>
                    <div class="ykc-device-label">Cihaz Tipi</div><div>@Deger(Model.EskiCihazTipi)</div><div>@Deger(Model.YeniCihazTipi)</div><div><span class="df-pill @KontrolClass(Model.EskiCihazTipiKodu ?? Model.EskiCihazTipi, Model.YeniCihazTipiKodu ?? Model.YeniCihazTipi)">@KontrolYazi(Model.EskiCihazTipiKodu ?? Model.EskiCihazTipi, Model.YeniCihazTipiKodu ?? Model.YeniCihazTipi)</span></div>
                    <div class="ykc-device-label">Marka / Model</div><div>@Deger(Model.EskiMarka)</div><div>@Deger(Model.YeniMarka) @if (!string.IsNullOrWhiteSpace(Model.YeniModel)) { <small>@Model.YeniModel</small> }</div><div><span class="df-pill df-pill-secondary">Bilgi</span></div>
                    <div class="ykc-device-label">Baca Tipi</div><div>@Deger(Model.EskiBacaTipi)</div><div>@Deger(Model.YeniBacaTipi)</div><div><span class="df-pill @KontrolClass(Model.EskiBacaTipiKodu ?? Model.EskiBacaTipi, Model.YeniBacaTipiKodu ?? Model.YeniBacaTipi)">@KontrolYazi(Model.EskiBacaTipiKodu ?? Model.EskiBacaTipi, Model.YeniBacaTipiKodu ?? Model.YeniBacaTipi)</span></div>
                    <div class="ykc-device-label">Kapasite</div><div>@Deger(Model.EskiKapasite)</div><div>@Deger(Model.YeniKapasite)</div><div><span class="df-pill @KontrolClass(Model.EskiKapasite, Model.YeniKapasite)">@KontrolYazi(Model.EskiKapasite, Model.YeniKapasite)</span></div>
                    <div class="ykc-device-label">İkinci El</div><div>-</div><div>@EvetHayir(Model.IkinciElCihazMi)</div><div><span class="df-pill @(Model.IkinciElCihazMi == true ? "df-pill-warning" : "df-pill-secondary")">FR265 Bilgisi</span></div>
                    @if (!string.IsNullOrWhiteSpace(Model.YeniSeriNo))
                    {
                        <div class="ykc-device-label">Seri No</div><div>-</div><div>@Model.YeniSeriNo</div><div><span class="df-pill df-pill-secondary">Bilgi</span></div>
                    }
                </div>
            </section>

            <div class="ykc-context-row">
                <details class="ykc-disclosure-card">
                    <summary><span><i class="bi bi-person-vcard"></i><strong>Tesisat ve Müşteri</strong><small>@Deger(Model.TesisatNo) · @Deger(Model.MusteriAdi)</small></span><i class="bi bi-chevron-down"></i></summary>
                    <div class="ykc-compact-info">
                        <div><small>Müşteri</small><strong>@Deger(Model.MusteriAdi)</strong></div><div><small>Telefon</small><strong>@Deger(Model.MusteriTelefon)</strong></div>
                        <div><small>Abone</small><strong>@Deger(Model.AboneNo)</strong></div><div><small>Sözleşme</small><strong>@Deger(Model.SozlesmeNo)</strong></div>
                        <div><small>Proje</small><strong>@Deger(Model.ProjeNo)</strong></div><div><small>Sayaç</small><strong>@Deger(Model.SayacNo)</strong></div>
                        <div class="wide"><small>Adres</small><strong>@Deger(Model.Adres)</strong></div>
                    </div>
                </details>
                <details class="ykc-disclosure-card">
                    <summary><span><i class="bi bi-building-check"></i><strong>Firma ve Kapsam</strong><small>@Deger(Model.FirmaAdi) · @Deger(Model.Il) / @Deger(Model.Ilce)</small></span><i class="bi bi-chevron-down"></i></summary>
                    <div class="ykc-compact-info">
                        <div><small>Firma</small><strong>@Deger(Model.FirmaAdi)</strong></div><div><small>Şirket</small><strong>@Deger(Model.SirketAdi)</strong></div>
                        <div><small>VKN</small><strong>@Deger(Model.Vkn)</strong></div><div><small>Firma Kodu</small><strong>@Deger(Model.FirmaKodu)</strong></div>
                        <div><small>İl / İlçe</small><strong>@Deger(Model.Il) / @Deger(Model.Ilce)</strong></div><div><small>Kayıt Kanalı</small><strong>@Deger(Model.KaynakTipi)</strong></div>
                    </div>
                </details>
            </div>

            <details class="ykc-detail-section" id="fr265-controls" open="@(Model.Durum == YkcDurumDegerleri.SahaIsleminde ? "open" : null)">
                <summary><span class="ykc-operation-icon is-control"><i class="bi bi-clipboard2-check"></i></span><div><strong>FR265 Kontrol Adımları</strong><small>5 teknik kontrol · Belge sürümü @Model.Fr265BelgeVersiyonNo</small></div><i class="bi bi-chevron-down"></i></summary>
                <div class="ykc-detail-section-body">
                    @if (yonetebilir)
                    {
                        <form method="post" action="/ykc/kontroller-kaydet">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="TalepId" value="@Model.Id" />
                            <div class="ykc-control-grid">
                                @for (var i = 0; i < kontrolSatirlari.Count; i++)
                                {
                                    var kontrol = kontrolSatirlari[i];
                                    <div class="ykc-control-item">
                                        <input type="hidden" name="Kontroller[@i].KontrolNo" value="@kontrol.KontrolNo" />
                                        <div><span>@kontrol.KontrolNo</span><strong>Kontrol @kontrol.KontrolNo</strong></div>
                                        <select name="Kontroller[@i].Sonuc">
                                            <option value="@YkcFr265KontrolSonucDegerleri.Bekliyor" selected="@Secili(kontrol.Sonuc == YkcFr265KontrolSonucDegerleri.Bekliyor)">Bekliyor</option>
                                            <option value="@YkcFr265KontrolSonucDegerleri.Uygun" selected="@Secili(kontrol.Sonuc == YkcFr265KontrolSonucDegerleri.Uygun)">Uygun</option>
                                            <option value="@YkcFr265KontrolSonucDegerleri.UygunDegil" selected="@Secili(kontrol.Sonuc == YkcFr265KontrolSonucDegerleri.UygunDegil)">Uygun Değil</option>
                                            <option value="@YkcFr265KontrolSonucDegerleri.Uygulanmaz" selected="@Secili(kontrol.Sonuc == YkcFr265KontrolSonucDegerleri.Uygulanmaz)">Uygulanmaz</option>
                                        </select>
                                        <textarea name="Kontroller[@i].Aciklama" placeholder="Kontrol notu">@kontrol.Aciklama</textarea>
                                    </div>
                                }
                            </div>
                            <div class="ykc-section-actions"><button class="df-btn df-btn-primary df-btn-sm" type="submit"><i class="bi bi-save"></i> Kontrolleri Kaydet</button></div>
                        </form>
                    }
                    else
                    {
                        <div class="ykc-control-grid is-readonly">
                            @foreach (var kontrol in kontrolSatirlari)
                            {
                                <div class="ykc-control-item"><div><span>@kontrol.KontrolNo</span><strong>Kontrol @kontrol.KontrolNo</strong></div><span class="df-pill @KontrolSonucClass(kontrol.Sonuc)">@KontrolSonucYazi(kontrol.Sonuc)</span><small>@Deger(kontrol.Aciklama)</small></div>
                            }
                        </div>
                    }
                </div>
            </details>

            <details class="ykc-detail-section" id="fr265-signature" open="@(Model.Durum == YkcDurumDegerleri.SahaIsleminde || Model.Durum == YkcDurumDegerleri.Tamamlandi ? "open" : null)">
                <summary><span class="ykc-operation-icon is-signature"><i class="bi bi-pen"></i></span><div><strong>FR265 ve Dijital İmza</strong><small>@ImzaDurumYazi(imzaSureci?.Durum) · @KisaHash(Model.Fr265BelgeHash)</small></div><i class="bi bi-chevron-down"></i></summary>
                <div class="ykc-detail-section-body">
                    <div class="ykc-signature-status">
                        <div><small>İmza Durumu</small><span class="df-pill @(imzaliBelgeHazir ? "df-pill-success" : "df-pill-warning")">@ImzaDurumYazi(imzaSureci?.Durum)</span></div>
                        <div><small>Sağlayıcı Belge No</small><strong>@(string.IsNullOrWhiteSpace(imzaSureci?.ProviderDocumentId) ? "Henüz gönderilmedi" : imzaSureci.ProviderDocumentId)</strong></div>
                        <div><small>Sağlayıcı</small><strong>@Deger(imzaEntegrasyonu.ProviderAdi)</strong></div>
                    </div>
                    <div class="ykc-process-message">@formYardimMetni</div>
                    <div class="ykc-section-actions is-left">
                        <a class="df-btn df-btn-primary df-btn-sm" href="/ykc/fr265/onizle/@Model.Id" target="_blank"><i class="bi bi-eye"></i> FR265 Önizle</a>
                        @if (imzayaGonderebilir)
                        {
                            <form method="post" action="/ykc/imzaya-gonder">@Html.AntiForgeryToken()<input type="hidden" name="talepId" value="@Model.Id" /><button class="df-btn df-btn-secondary df-btn-sm" type="submit"><i class="bi bi-send"></i> İmza Uygulamasına Gönder</button></form>
                        }
                        else if (!imzaEntegrasyonu.KullanilabilirMi)
                        {
                            <span class="df-btn df-btn-secondary df-btn-sm ykc-disabled-action"><i class="bi bi-plug"></i> Entegrasyon Bekleniyor</span>
                        }
                        @if (imzaDurumuSorgulanabilir)
                        {
                            <form method="post" action="/ykc/imza-durum-sorgula">@Html.AntiForgeryToken()<input type="hidden" name="talepId" value="@Model.Id" /><button class="df-btn df-btn-secondary df-btn-sm" type="submit"><i class="bi bi-arrow-repeat"></i> İmza Durumunu Güncelle</button></form>
                        }
                        @if (imzaliBelge != null)
                        {
                            <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/dosya/@imzaliBelge.Id" target="_blank"><i class="bi bi-download"></i> İmzalı Belgeyi İndir</a>
                        }
                    </div>
                    @if (icOperasyonGorsun)
                    {
                        <details class="ykc-transition-upload">
                            <summary>Geçiş dönemi belge kaydı <i class="bi bi-chevron-down"></i></summary>
                            <form method="post" action="/ykc/form-yukle" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="talepId" value="@Model.Id" />
                                <div class="ykc-field"><label>Belge Türü</label><select name="dosyaTuru"><option value="@YkcFormDosyaTuruDegerleri.Fr265ImzaliAday">Doğrulama Bekleyen İmzalı Belge</option><option value="@YkcFormDosyaTuruDegerleri.TeknikEk">Teknik Ek</option></select></div>
                                <div class="ykc-field"><label>Belge</label><input type="file" name="formDosyasi" accept=".pdf,.jpg,.jpeg,.png" /></div>
                                <button class="df-btn df-btn-primary df-btn-sm" type="submit">Belge Ekle</button>
                            </form>
                        </details>
                    }
                    @if (Model.Dosyalar.Any())
                    {
                        <div class="ykc-document-list">
                            @foreach (var dosya in Model.Dosyalar)
                            {
                                <a href="/ykc/dosya/@dosya.Id" target="_blank"><span><i class="bi bi-file-earmark"></i></span><div><strong>@Deger(dosya.DosyaAdi)</strong><small>@DosyaTuruYazi(dosya.DosyaTuru) · @dosya.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</small></div><i class="bi bi-download"></i></a>
                            }
                        </div>
                    }
                </div>
            </details>

            <details class="ykc-detail-section ykc-history-section">
                <summary><span class="ykc-operation-icon is-history"><i class="bi bi-clock-history"></i></span><div><strong>İşlem Geçmişi</strong><small>@Model.Gecmis.Count kayıt</small></div><i class="bi bi-chevron-down"></i></summary>
                <div class="ykc-detail-section-body">
                    @if (!Model.Gecmis.Any())
                    {
                        <div class="ykc-empty-state">Henüz işlem geçmişi yok.</div>
                    }
                    else
                    {
                        <div class="ykc-history-list">
                            @foreach (var gecmis in Model.Gecmis)
                            {
                                <div><time>@gecmis.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</time><span></span><section><strong>@Deger(gecmis.IslemTipi)</strong><small>@Deger(gecmis.KullaniciAdi) @if (!string.IsNullOrWhiteSpace(gecmis.Aciklama)) { <text>· @gecmis.Aciklama</text> }</small></section>@if (gecmis.YeniDurum.HasValue) { <span class="df-pill @DurumClass(gecmis.YeniDurum.Value)">@DurumYazi(gecmis.YeniDurum.Value)</span> }</div>
                            }
                        </div>
                    }
                </div>
            </details>
        </main>

        <aside class="ykc-task-rail">
            <section class="ykc-task-card">
                <header><span><i class="bi bi-lightning-charge-fill"></i></span><div><small>Görev Paneli</small><h2>@gorevBasligi</h2><p>@gorevAciklamasi</p></div></header>

                @if (!icOperasyonGorsun)
                {
                    <div class="ykc-firm-status">
                        <span class="df-pill @DurumClass(Model.Durum)">@DurumYazi(Model.Durum)</span>
                        <strong>@(imzaliBelgeHazir ? "İmzalı nihai belge hazır." : "İç tesisat işlemi takip ediliyor.")</strong>
                        <p>Personel yönlendirme ve durum kararları firma hesabında gösterilmez. FR265 önizlemesini ve güncel durumu bu ekrandan izleyebilirsiniz.</p>
                    </div>
                }
                else if (yonetebilir)
                {
                    @if (Model.Durum == YkcDurumDegerleri.TalepAlindi)
                    {
                        <form method="post" action="/ykc/durum-guncelle" class="ykc-primary-decision">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="TalepId" value="@Model.Id" />
                            <input type="hidden" name="Durum" value="@YkcDurumDegerleri.AtamaBekliyor" />
                            <label>İnceleme Notu</label><textarea name="Aciklama" placeholder="Gerekliyse kısa bir inceleme notu ekleyin"></textarea>
                            <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-arrow-right-circle"></i> Yönlendirme Kuyruğuna Al</button>
                        </form>
                    }

                    @if (Model.Durum == YkcDurumDegerleri.Atandi)
                    {
                        <form method="post" action="/ykc/durum-guncelle" class="ykc-primary-decision is-field">
                            @Html.AntiForgeryToken()<input type="hidden" name="TalepId" value="@Model.Id" /><input type="hidden" name="Durum" value="@YkcDurumDegerleri.SahaIsleminde" />
                            <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-geo-alt"></i> Saha Sürecini Başlat</button>
                        </form>
                    }

                    @if (Model.Durum == YkcDurumDegerleri.SahaIsleminde)
                    {
                        <div class="ykc-field-task-links"><a href="#fr265-controls"><i class="bi bi-clipboard2-check"></i><span><strong>Kontrolleri tamamla</strong><small>5 FR265 kontrolünü kaydet</small></span></a><a href="#fr265-signature"><i class="bi bi-pen"></i><span><strong>Belge ve imzayı izle</strong><small>Önizleme, gönderim ve nihai belge</small></span></a></div>
                        <form method="post" action="/ykc/durum-guncelle" class="ykc-primary-decision is-complete">
                            @Html.AntiForgeryToken()<input type="hidden" name="TalepId" value="@Model.Id" /><input type="hidden" name="Durum" value="@YkcDurumDegerleri.Tamamlandi" />
                            <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-check2-circle"></i> İşlemi Tamamla</button>
                        </form>
                    }

                    @if (atamaYapilabilir)
                    {
                        <form method="post" action="/ykc/atama-yap" class="ykc-assignment-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="TalepId" value="@Model.Id" />
                            <input type="hidden" name="AtananKullaniciTipi" value="@Model.Atamalar.FirstOrDefault()?.AtananKullaniciTipi" />
                            <input type="hidden" name="HedefUygulama" value="@Model.HedefUygulama" />
                            <input type="hidden" name="CallCenterTetiklenecekMi" value="false" />
                            <div class="ykc-assignment-label">Yönlendirme seçimi</div>
                            <div class="ykc-route-options">
                                <button type="button" data-route-ekip="187 Acil" data-route-tip="CRM187" data-route-hedef="@YkcHedefUygulamaDegerleri.Crm187" data-route-callcenter="true" data-route-note="187 acil yönlendirme"><span><i class="bi bi-telephone-outbound"></i></span><div><strong>187 Acil</strong><small>Acil müdahale</small></div><i class="bi bi-check-circle-fill"></i></button>
                                <button type="button" data-route-ekip="Mühendis" data-route-tip="Mühendis" data-route-hedef="@YkcHedefUygulamaDegerleri.DogalgazMobileApp" data-route-callcenter="false" data-route-note="mühendis yönlendirme"><span><i class="bi bi-person-gear"></i></span><div><strong>Mühendis</strong><small>Normal saha akışı</small></div><i class="bi bi-check-circle-fill"></i></button>
                            </div>
                            <div class="ykc-task-fields">
                                <div class="ykc-field full"><label>Yönlendirilecek Birim / Kişi</label><input name="AtananEkip" value="@Model.AtananEkip" placeholder="187 Acil veya mühendis" required /></div>
                                <div class="ykc-field full"><label>Tesisat Bölgesi</label><input name="Bolge" value="@Model.Bolge" placeholder="Tesisattan gelen bölge" required /></div>
                                <div class="ykc-field"><label>Randevu Tarihi</label><div class="ykc-picker"><input id="randevuTarihi" type="date" name="RandevuTarihi" value="@Model.RandevuTarihi?.ToString("yyyy-MM-dd")" required /><button type="button" data-picker="#randevuTarihi" title="Takvimi aç"><i class="bi bi-calendar3"></i></button></div></div>
                                <div class="ykc-field"><label>Randevu Saati</label><div class="ykc-picker"><input id="randevuSaati" type="time" name="RandevuSaati" value="@Model.RandevuSaati" required /><button type="button" data-picker="#randevuSaati" title="Saati seç"><i class="bi bi-clock"></i></button></div></div>
                                <div class="ykc-field full"><label>Yönlendirme Notu</label><textarea name="Aciklama" placeholder="Atama ve yönlendirme notu"></textarea></div>
                            </div>
                            <button class="df-btn df-btn-primary ykc-assignment-submit" type="submit"><i class="bi bi-calendar2-check"></i> Randevu ve Atamayı Kaydet</button>
                        </form>
                    }

                    @if (!terminalDurum)
                    {
                        <details class="ykc-other-actions">
                            <summary>Diğer kararlar <i class="bi bi-chevron-down"></i></summary>
                            <form method="post" action="/ykc/durum-guncelle">
                                @Html.AntiForgeryToken()<input type="hidden" name="TalepId" value="@Model.Id" />
                                <div class="ykc-field"><label>Açıklama</label><textarea name="Aciklama" placeholder="Red veya iptal gerekçesi">@Model.RedAciklama</textarea></div>
                                <div><button class="df-btn df-btn-secondary df-btn-sm" type="submit" name="Durum" value="@YkcDurumDegerleri.Reddedildi"><i class="bi bi-x-circle"></i> Reddet</button><button class="df-btn df-btn-secondary df-btn-sm" type="submit" name="Durum" value="@YkcDurumDegerleri.Iptal"><i class="bi bi-slash-circle"></i> İptal Et</button></div>
                            </form>
                        </details>
                    }
                }
            </section>

            <section class="ykc-quick-card">
                <header><i class="bi bi-pin-map"></i><strong>Plan Özeti</strong></header>
                <dl><div><dt>Bölge</dt><dd id="ykcQuickBolge">@Deger(Model.Bolge)</dd></div><div><dt>Yönlendirme</dt><dd id="ykcQuickEkip">@Deger(Model.AtananEkip)</dd></div><div><dt>Randevu</dt><dd><span id="ykcQuickTarih">@Tarih(Model.RandevuTarihi)</span> <span id="ykcQuickSaat">@Deger(Model.RandevuSaati)</span></dd></div><div><dt>İmza</dt><dd>@ImzaDurumYazi(imzaSureci?.Durum)</dd></div></dl>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('click', event => {
            const button = event.target.closest('[data-picker]');
            if (!button) return;
            const input = document.querySelector(button.dataset.picker);
            if (!input) return;
            if (typeof input.showPicker === 'function') input.showPicker(); else input.focus();
        });

        (() => {
            const routeCards = Array.from(document.querySelectorAll('[data-route-ekip]'));
            const ekip = document.querySelector('input[name="AtananEkip"]');
            const tip = document.querySelector('input[name="AtananKullaniciTipi"]');
            const hedef = document.querySelector('input[name="HedefUygulama"]');
            const callCenter = document.querySelector('input[name="CallCenterTetiklenecekMi"]');
            const aciklama = document.querySelector('textarea[name="Aciklama"][placeholder="Atama ve yönlendirme notu"]');
            let otomatikNot = '';

            function selectRoute(card) {
                routeCards.forEach(item => { item.classList.remove('active'); item.setAttribute('aria-pressed', 'false'); });
                card.classList.add('active');
                card.setAttribute('aria-pressed', 'true');
                if (ekip) { ekip.value = card.dataset.routeEkip || ''; ekip.dispatchEvent(new Event('input', { bubbles: true })); }
                if (tip) tip.value = card.dataset.routeTip || '';
                if (hedef) hedef.value = card.dataset.routeHedef || '';
                if (callCenter) callCenter.value = card.dataset.routeCallcenter === 'true' ? 'true' : 'false';
                if (aciklama && (!aciklama.value.trim() || aciklama.value === otomatikNot)) {
                    otomatikNot = card.dataset.routeNote || '';
                    aciklama.value = otomatikNot;
                }
            }

            routeCards.forEach(card => {
                card.setAttribute('aria-pressed', 'false');
                card.addEventListener('click', () => selectRoute(card));
                if (ekip && ekip.value.trim().toLocaleLowerCase('tr-TR') === (card.dataset.routeEkip || '').toLocaleLowerCase('tr-TR')) selectRoute(card);
            });
        })();

        (() => {
            const date = document.getElementById('randevuTarihi');
            const time = document.getElementById('randevuSaati');
            const team = document.querySelector('input[name="AtananEkip"]');
            const region = document.querySelector('input[name="Bolge"]');
            const targets = {
                date: [document.getElementById('ykcPlanTarih'), document.getElementById('ykcQuickTarih')],
                time: [document.getElementById('ykcPlanSaat'), document.getElementById('ykcQuickSaat')],
                team: [document.getElementById('ykcPlanEkip'), document.getElementById('ykcQuickEkip')],
                region: [document.getElementById('ykcPlanBolge'), document.getElementById('ykcQuickBolge')]
            };
            const clean = current => current?.trim() || '-';
            const formatDate = current => { if (!current) return '-'; const parts = current.split('-'); return parts.length === 3 ? `${parts[2]}.${parts[1]}.${parts[0]}` : current; };
            function update() {
                targets.date.filter(Boolean).forEach(item => item.textContent = formatDate(date?.value));
                targets.time.filter(Boolean).forEach(item => item.textContent = clean(time?.value));
                targets.team.filter(Boolean).forEach(item => item.textContent = clean(team?.value));
                targets.region.filter(Boolean).forEach(item => item.textContent = clean(region?.value));
            }
            [date, time, team, region].filter(Boolean).forEach(item => { item.addEventListener('input', update); item.addEventListener('change', update); });
            update();
        })();
    </script>
}
