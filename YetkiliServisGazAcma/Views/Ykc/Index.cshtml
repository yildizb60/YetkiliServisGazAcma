@model YkcDashboardOzetDto
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Cihaz Değişimi";
    ViewData["PanelTitle"] = "Ana Sayfa";
    ViewData["PanelSubtitle"] = "Cihaz Değişimi";
    ViewData["ActiveMenu"] = "Dashboard";

    var toplam = Model.Toplam;
    var incelemede = Model.Incelemede;
    var randevuda = Model.RandevuSaha;
    var tamamlanan = Model.Tamamlanan;
    var imzaBekleyen = Model.ImzaBekleyen;
    var devamEden = Math.Max(toplam - tamamlanan - Model.RedIptal, 0);
    var sonTalepler = Model.SonTalepler.Take(6).ToList();
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string DurumYazi(int durum) => YkcDurumSunumu.Etiket(durum);
    private static string DurumClass(int durum) => YkcDurumSunumu.CssSinifi(durum);

    private static string RandevuYazi(DateTime? tarih, string? saat)
    {
        if (!tarih.HasValue && string.IsNullOrWhiteSpace(saat))
            return "Randevu bekleniyor";

        return string.Join(" ", new[]
        {
            tarih?.ToString("dd.MM.yyyy"),
            string.IsNullOrWhiteSpace(saat) ? null : saat
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }
}

<div class="df-dashboard df-personnel-home ykc-firm-home">
    <section class="df-home-section" aria-labelledby="firm-actions-title">
        <header class="df-home-section-head">
            <div>
                <span class="df-home-kicker"><i class="bi bi-grid" aria-hidden="true"></i> Cihaz değişimi</span>
                <h1 id="firm-actions-title">İşlemlerim</h1>
            </div>
            <dl class="ykc-home-status" aria-label="Talep durumu özeti">
                <div><dt>İncelenen</dt><dd>@incelemede</dd></div>
                <div><dt>Randevu / İşlem</dt><dd>@randevuda</dd></div>
                <div><dt>İmza Bekleyen</dt><dd>@imzaBekleyen</dd></div>
                <div><dt>Tamamlanan</dt><dd>@tamamlanan</dd></div>
            </dl>
        </header>

        <div class="df-home-action-grid ykc-home-actions">
            <a class="df-home-action" href="/ykc/yeni">
                <span class="df-home-action-icon"><i class="bi bi-plus-lg" aria-hidden="true"></i></span>
                <span class="df-home-action-copy"><strong>Yeni Talep</strong><small>Tesisat ve cihaz bilgilerini girin</small></span>
                <i class="bi bi-chevron-right df-home-action-arrow" aria-hidden="true"></i>
            </a>
            <a class="df-home-action is-green" href="/ykc/talepler">
                <span class="df-home-action-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span>
                <span class="df-home-action-copy"><strong>Taleplerim</strong><small>@devamEden işlem devam ediyor</small></span>
                <span class="df-home-action-value">@toplam</span>
                <i class="bi bi-chevron-right df-home-action-arrow" aria-hidden="true"></i>
            </a>
            <a class="df-home-action is-purple" href="/ykc/talepler?durum=@YkcDurumDegerleri.Tamamlandi">
                <span class="df-home-action-icon"><i class="bi bi-file-earmark-check" aria-hidden="true"></i></span>
                <span class="df-home-action-copy"><strong>Tamamlanan Talepler</strong><small>Form ve işlem sonucunu görüntüleyin</small></span>
                <span class="df-home-action-value">@tamamlanan</span>
                <i class="bi bi-chevron-right df-home-action-arrow" aria-hidden="true"></i>
            </a>
        </div>
    </section>

    <section class="df-home-feed ykc-home-recent" aria-labelledby="firm-recent-title">
        <header>
            <div>
                <span class="df-home-feed-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                <h2 id="firm-recent-title">Son Talepler</h2>
            </div>
            <a href="/ykc/talepler">Tümünü Gör <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </header>

        @if (!sonTalepler.Any())
        {
            <div class="df-home-empty"><i class="bi bi-inbox" aria-hidden="true"></i><span>Henüz cihaz değişim talebi bulunmuyor.</span></div>
        }
        else
        {
            <div class="ykc-home-request-list">
                @foreach (var talep in sonTalepler)
                {
                    <a class="ykc-home-request" href="/ykc/detay/@talep.Id">
                        <span class="ykc-home-request-id">#@talep.Id</span>
                        <span class="ykc-home-request-customer">
                            <strong>@Deger(talep.MusteriAdi)</strong>
                            <small>Tesisat @Deger(talep.TesisatNo)</small>
                        </span>
                        <span class="ykc-home-request-appointment">
                            <small>Randevu</small>
                            <strong>@RandevuYazi(talep.RandevuTarihi, talep.RandevuSaati)</strong>
                        </span>
                        <span class="df-pill @DurumClass(talep.Durum)">@DurumYazi(talep.Durum)</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                }
            </div>
        }
    </section>
</div>
