@model YkcDashboardOzetDto
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Ana Sayfa";
    ViewData["PanelTitle"] = "Ana Sayfa";
    ViewData["ActiveMenu"] = "Dashboard";
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var ozetler = new[] {
        ("bi-journal-text", "Tüm taleplerim", Model.Toplam, "Kayıtlı cihaz değişim talebi", "blue"),
        ("bi-hourglass-split", "İnceleme / atama bekleyen", Model.Incelemede, "Cihaz değişim talebi", "amber"),
        ("bi-calendar2-check", "Kontrol sürecindeki", Model.RandevuSaha, "Randevu verilen / kontrolü süren talep", "cyan"),
        ("bi-check2-circle", "Tamamlanan", Model.Tamamlanan, "Sonuçlanan cihaz değişim talebi", "green")
    };
}
@section PageStyles {
    <link rel="stylesheet" href="~/css/operations-home.css" asp-append-version="true" />
}
<div class="ops-home">
    <header class="ops-home-toolbar">
        <time datetime="@DateTime.Today.ToString("yyyy-MM-dd")"><i class="bi bi-calendar3" aria-hidden="true"></i>@DateTime.Today.ToString("dd MMMM yyyy, dddd", tr)</time>
        <a class="df-btn df-btn-primary" href="/ykc/yeni"><i class="bi bi-plus-lg" aria-hidden="true"></i>Yeni Cihaz Değişim Talebi</a>
    </header>
    <div class="ops-tiles" aria-label="Cihaz değişim taleplerimin durumu">
        @foreach (var (icon, title, count, caption, tone) in ozetler)
        {
            <section class="ops-tile is-@tone">
                <div class="ops-tile-heading"><i class="bi @icon" aria-hidden="true"></i><h2>@title</h2></div>
                <strong class="ops-tile-number">@count</strong>
                <span class="ops-tile-caption">@caption</span>
            </section>
        }
    </div>
    <section class="ops-records" aria-labelledby="recent-title">
        <header class="ops-section-heading">
            <h2 id="recent-title"><i class="bi bi-clock-history" aria-hidden="true"></i>Son Cihaz Değişim Taleplerim</h2>
            <a href="/ykc/talepler">Tüm Taleplerim<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </header>
        @if (Model.SonTalepler.Count == 0)
        {
            <div class="ops-empty"><i class="bi bi-inbox" aria-hidden="true"></i><p>Henüz cihaz değişim talebiniz bulunmuyor.</p></div>
        }
        else
        {
            <div class="ops-table-scroll">
                <table class="ops-table">
                    <thead><tr><th>Talep No</th><th>Abone Adı Soyadı</th><th>Tesisat No</th><th>Kontrol Randevusu</th><th>Talep Durumu</th><th><span class="visually-hidden">Detay</span></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.SonTalepler.Take(5))
                    {
                        <tr>
                            <td><a class="ops-record-link" href="/ykc/detay/@item.Id">#@item.Id</a></td>
                            <td>@(string.IsNullOrWhiteSpace(item.MusteriAdi) ? "Kayıtlı değil" : item.MusteriAdi)</td>
                            <td>@item.TesisatNo</td>
                            <td>@if (item.RandevuTarihi.HasValue) { <time>@item.RandevuTarihi.Value.ToString("dd.MM.yyyy") <b>@item.RandevuSaati</b></time> } else { <span class="ops-muted">Planlanmadı</span> }</td>
                            <td><span class="df-pill @YkcDurumSunumu.CssSinifi(item.Durum)">@(item.Durum == YkcDurumDegerleri.TalepAlindi ? "İnceleme Bekleniyor" : YkcDurumSunumu.Etiket(item.Durum))</span></td>
                            <td><a class="ops-icon-button" href="/ykc/detay/@item.Id" aria-label="@($"Talep {item.Id} detayını aç")" title="Talep detayını aç"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.RedIptal > 0) { <footer class="ops-section-footer">@Model.RedIptal talep ret / iptal ile sonuçlandı.</footer> }
    </section>
</div>
