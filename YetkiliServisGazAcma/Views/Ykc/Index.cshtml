@model YkcDashboardOzetDto
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Ana Sayfa";
    ViewData["PanelTitle"] = "Ana Sayfa";
    ViewData["ActiveMenu"] = "Dashboard";
}
@section PageStyles {
    <link rel="stylesheet" href="~/css/operations-home.css" asp-append-version="true" />
}
<div class="ops-home ops-firm-home">
    <header class="ops-overview">
        <div class="ops-overview-heading">
            <h2>Cihaz Değişim İşlemlerim</h2>
            <a class="df-btn df-btn-primary df-btn-sm" href="@Url.Action("Yeni", "Ykc")"><i class="bi bi-plus-lg" aria-hidden="true"></i>Yeni Talep</a>
        </div>
        <dl class="ops-overview-stats" aria-label="Talep durumu özeti">
            <div><dt>Toplam talep</dt><dd>@Model.Toplam</dd></div>
            <div><dt>İnceleme ve randevu bekleyen</dt><dd>@Model.Incelemede</dd></div>
            <div><dt>Kontrol sürecinde</dt><dd>@Model.RandevuSaha</dd></div>
            <div><dt>Tamamlanan</dt><dd>@Model.Tamamlanan</dd></div>
        </dl>
    </header>
    @await Component.InvokeAsync("YkcRandevuOzeti")
    <section class="ops-records" aria-labelledby="recent-title">
        <header class="ops-section-heading">
            <h2 id="recent-title"><i class="bi bi-clock-history" aria-hidden="true"></i>Son Cihaz Değişim Taleplerim</h2>
            <a href="@Url.Action("Talepler", "Ykc")">Tüm Taleplerim<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </header>
        @if (Model.SonTalepler.Count == 0)
        {
            <div class="ops-empty"><i class="bi bi-inbox" aria-hidden="true"></i><p>Henüz cihaz değişim talebiniz bulunmuyor.</p></div>
        }
        else
        {
            <div class="ops-table-scroll">
                <table class="ops-table">
                    <thead><tr><th>Talep No</th><th>Abone Adı Soyadı</th><th>Tesisat No</th><th>Kontrol Randevusu</th><th>Talep Durumu</th><th><span class="visually-hidden">Detay</span></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.SonTalepler.Take(5))
                    {
                        <tr>
                            <td><a class="ops-record-link" href="@Url.Action("Detay", "Ykc", new { id = item.Id })">#@item.Id</a></td>
                            <td>@(string.IsNullOrWhiteSpace(item.MusteriAdi) ? "Kayıtlı değil" : item.MusteriAdi)</td>
                            <td>@item.TesisatNo</td>
                            <td>@if (item.RandevuTarihi.HasValue) { <time>@item.RandevuTarihi.Value.ToString("dd.MM.yyyy") <b>@item.RandevuSaati</b></time> } else { <span class="ops-muted">Planlanmadı</span> }</td>
                            <td><span class="df-pill @YkcDurumSunumu.CssSinifi(item.Durum)">@(item.Durum == YkcDurumDegerleri.TalepAlindi ? "İnceleme Bekleniyor" : YkcDurumSunumu.Etiket(item.Durum))</span></td>
                            <td><a class="ops-icon-button" href="@Url.Action("Detay", "Ykc", new { id = item.Id })" aria-label="@($"Talep {item.Id} detayını aç")" title="Talep detayını aç"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.RedIptal > 0) { <footer class="ops-section-footer">@Model.RedIptal talep ret / iptal ile sonuçlandı.</footer> }
    </section>
</div>
