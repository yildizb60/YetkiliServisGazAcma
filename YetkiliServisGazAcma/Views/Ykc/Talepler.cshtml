@model YkcTalepListeSonuc
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var filtre = ViewBag.Filtre as YkcTalepListeFiltre ?? new YkcTalepListeFiltre();
    var ozet = ViewBag.Ozet as YkcDashboardOzetDto ?? new YkcDashboardOzetDto();
    var sertifikaliFirmaMi = User.IsInRole("SertifikaliFirma");
    var icOperasyonGorsun = !sertifikaliFirmaMi;
    var aktifFiltreler = new List<(string Etiket, string Deger)>();
    var toplamSayfa = Model.SayfaBoyutu > 0
        ? Math.Max((int)Math.Ceiling(Model.Toplam / (double)Model.SayfaBoyutu), 1)
        : 1;

    void AktifFiltreEkle(string etiket, string? deger)
    {
        if (!string.IsNullOrWhiteSpace(deger))
            aktifFiltreler.Add((etiket, deger));
    }

    AktifFiltreEkle("Tesisat", filtre.TesisatNo);
    AktifFiltreEkle("Firma", filtre.Firma);
    AktifFiltreEkle("İl", filtre.Il);
    AktifFiltreEkle("İlçe", filtre.Ilce);
    AktifFiltreEkle("Bölge", filtre.Bolge);
    if (filtre.Durum.HasValue)
        AktifFiltreEkle("Durum", DurumYazi(filtre.Durum.Value));
    if (filtre.BaslangicTarihi.HasValue)
        AktifFiltreEkle("Başlangıç", filtre.BaslangicTarihi.Value.ToString("dd.MM.yyyy"));
    if (filtre.BitisTarihi.HasValue)
        AktifFiltreEkle("Bitiş", filtre.BitisTarihi.Value.ToString("dd.MM.yyyy"));
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string? Secili(bool kosul) => kosul ? "selected" : null;

    private static string RandevuYazi(DateTime? tarih, string? saat)
    {
        if (!tarih.HasValue && string.IsNullOrWhiteSpace(saat))
            return "Randevu bekliyor";

        return string.Join(" ", new[]
        {
            tarih?.ToString("dd.MM.yyyy"),
            string.IsNullOrWhiteSpace(saat) ? null : saat
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string KonumYazi(params string?[] parcalar)
    {
        var sonuc = string.Join(" / ", parcalar.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim()));
        return string.IsNullOrWhiteSpace(sonuc) ? "-" : sonuc;
    }

    private static string SayfaUrl(YkcTalepListeFiltre filtre, int sayfa)
    {
        var query = new List<string>();
        Ekle(query, "tesisatNo", filtre.TesisatNo);
        Ekle(query, "firma", filtre.Firma);
        Ekle(query, "il", filtre.Il);
        Ekle(query, "ilce", filtre.Ilce);
        Ekle(query, "bolge", filtre.Bolge);
        Ekle(query, "durum", filtre.Durum?.ToString());
        Ekle(query, "bas", filtre.BaslangicTarihi?.ToString("yyyy-MM-dd"));
        Ekle(query, "bit", filtre.BitisTarihi?.ToString("yyyy-MM-dd"));
        Ekle(query, "sayfa", sayfa.ToString());
        return "/ykc/talepler" + (query.Count == 0 ? "" : "?" + string.Join("&", query));
    }

    private static void Ekle(List<string> query, string ad, string? deger)
    {
        if (!string.IsNullOrWhiteSpace(deger))
            query.Add($"{ad}={Uri.EscapeDataString(deger)}");
    }

    private static string DurumYazi(int durum)
    {
        return durum switch
        {
            YkcDurumDegerleri.TalepAlindi => "Beklemede",
            YkcDurumDegerleri.AtamaBekliyor => "İncelemede",
            YkcDurumDegerleri.Atandi => "Randevu Verildi",
            YkcDurumDegerleri.SahaIsleminde => "Saha İşleminde",
            YkcDurumDegerleri.Reddedildi => "Reddedildi",
            YkcDurumDegerleri.Tamamlandi => "Tamamlandı",
            YkcDurumDegerleri.Iptal => "İptal",
            _ => "Bilinmiyor"
        };
    }

    private static string DurumClass(int durum)
    {
        return durum switch
        {
            YkcDurumDegerleri.Tamamlandi => "df-pill-success",
            YkcDurumDegerleri.Reddedildi or YkcDurumDegerleri.Iptal => "df-pill-danger",
            YkcDurumDegerleri.Atandi or YkcDurumDegerleri.SahaIsleminde => "df-pill-primary",
            _ => "df-pill-warning"
        };
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ykc-operations.css" asp-append-version="true" />
}

<div class="ykc-workspace">
    @if (TempData["Basarili"] != null)
    {
        <div class="df-alert df-alert-success">@TempData["Basarili"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <section class="ykc-workspace-hero">
        <div class="df-panel-head">
            <div class="ykc-hero-title-wrap">
                <span class="ykc-hero-mark"><i class="bi bi-fire"></i></span>
                <div>
                    <h1 class="df-panel-title">@(sertifikaliFirmaMi ? "Cihaz Değişim Talepleri" : "Cihaz Değişim Operasyonları")</h1>
                    <div class="df-panel-subtitle">@(sertifikaliFirmaMi ? "FR265, randevu ve dijital imza durumlarını tek listeden izleyin." : "İnceleme, ekip ataması, saha ve imza bekleyen kayıtları yönetin.")</div>
                </div>
            </div>
            @if (sertifikaliFirmaMi)
            {
                <div class="df-actions">
                    <a class="ykc-hero-action" href="/ykc/yeni"><i class="bi bi-plus-lg"></i><span>Yeni Talep</span></a>
                </div>
            }
        </div>
        <div class="ykc-kpi-strip" style="--ykc-kpi-count:4;">
            <div class="ykc-kpi" style="--ykc-kpi-accent:#22d3ee;">
                <span class="ykc-kpi-icon"><i class="bi bi-collection"></i></span>
                <div><strong class="ykc-kpi-value">@ozet.Toplam</strong><span class="ykc-kpi-label">Toplam Kayıt</span></div>
            </div>
            <div class="ykc-kpi" style="--ykc-kpi-accent:#fbbf24;">
                <span class="ykc-kpi-icon"><i class="bi bi-hourglass-split"></i></span>
                <div><strong class="ykc-kpi-value">@ozet.Incelemede</strong><span class="ykc-kpi-label">İnceleme Kuyruğu</span></div>
            </div>
            <div class="ykc-kpi" style="--ykc-kpi-accent:#c084fc;">
                <span class="ykc-kpi-icon"><i class="bi bi-calendar2-check"></i></span>
                <div><strong class="ykc-kpi-value">@ozet.RandevuSaha</strong><span class="ykc-kpi-label">Randevu / Saha</span></div>
            </div>
            <div class="ykc-kpi" style="--ykc-kpi-accent:#34d399;">
                <span class="ykc-kpi-icon"><i class="bi bi-check2-circle"></i></span>
                <div><strong class="ykc-kpi-value">@ozet.Tamamlanan</strong><span class="ykc-kpi-label">Tamamlanan</span></div>
            </div>
        </div>
    </section>

    <details class="ykc-filter-panel">
        <summary class="ykc-filter-bar">
            <span class="ykc-filter-leading"><i class="bi bi-sliders2"></i> Filtreler</span>
            <span class="ykc-filter-state">
                @if (aktifFiltreler.Any())
                {
                    @foreach (var item in aktifFiltreler.Take(5))
                    {
                        <span class="ykc-filter-chip"><b>@item.Etiket</b>@item.Deger</span>
                    }
                }
                else
                {
                    <span class="ykc-filter-hint">Tesisat, durum, firma, bölge veya tarih ile listeyi daraltın.</span>
                }
            </span>
            <span class="ykc-filter-chevron"><i class="bi bi-chevron-down"></i></span>
        </summary>
        <form method="get" action="/ykc/talepler" class="ykc-filter-form">
            <div class="ykc-filter-grid">
                <div class="ykc-filter-field">
                    <label>Tesisat</label>
                    <input type="text" name="tesisatNo" value="@filtre.TesisatNo" placeholder="Tesisat no" />
                </div>
                @if (icOperasyonGorsun)
                {
                    <div class="ykc-filter-field">
                        <label>Firma</label>
                        <input type="text" name="firma" value="@filtre.Firma" placeholder="Firma adı" />
                    </div>
                    <div class="ykc-filter-field">
                        <label>İl</label>
                        <input type="text" name="il" value="@filtre.Il" placeholder="İl" />
                    </div>
                    <div class="ykc-filter-field">
                        <label>İlçe</label>
                        <input type="text" name="ilce" value="@filtre.Ilce" placeholder="İlçe" />
                    </div>
                    <div class="ykc-filter-field">
                        <label>Bölge</label>
                        <input type="text" name="bolge" value="@filtre.Bolge" placeholder="Bölge" />
                    </div>
                }
                <div class="ykc-filter-field">
                    <label>Durum</label>
                    <select name="durum">
                        <option value="">Tümü</option>
                        @foreach (var item in new[] {
                            new { Id = YkcDurumDegerleri.TalepAlindi, Ad = "Beklemede" },
                            new { Id = YkcDurumDegerleri.AtamaBekliyor, Ad = "İç Tesisat İncelemesinde" },
                            new { Id = YkcDurumDegerleri.Atandi, Ad = "Randevu Verildi" },
                            new { Id = YkcDurumDegerleri.SahaIsleminde, Ad = "Saha İşleminde" },
                            new { Id = YkcDurumDegerleri.Reddedildi, Ad = "Reddedildi" },
                            new { Id = YkcDurumDegerleri.Tamamlandi, Ad = "Tamamlandı" },
                            new { Id = YkcDurumDegerleri.Iptal, Ad = "İptal" }
                        })
                        {
                            <option value="@item.Id" selected="@Secili(filtre.Durum == item.Id)">@item.Ad</option>
                        }
                    </select>
                </div>
                <div class="ykc-filter-field">
                    <label>Başlangıç</label>
                    <input type="date" name="bas" value="@filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="ykc-filter-field">
                    <label>Bitiş</label>
                    <input type="date" name="bit" value="@filtre.BitisTarihi?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="ykc-filter-actions">
                <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-funnel"></i> Uygula</button>
                <a class="df-btn df-btn-secondary" href="/ykc/talepler"><i class="bi bi-x-lg"></i> Temizle</a>
            </div>
        </form>
    </details>

    <section class="ykc-data-panel">
        <div class="ykc-data-toolbar">
            <div class="ykc-data-title-wrap">
                <span class="ykc-data-title-icon"><i class="bi bi-journal-text"></i></span>
                <div>
                    <div class="ykc-data-title">Cihaz Değişim Kayıtları</div>
                    <div class="ykc-data-subtitle">En güncel talepler işlem önceliğiyle listelenir.</div>
                </div>
            </div>
            <span class="ykc-record-count"><i class="bi bi-database"></i> @Model.Toplam kayıt</span>
        </div>

        <div class="ykc-table-scroll">
            <table class="ykc-data-table">
                <colgroup>
                    <col style="width:15%" />
                    <col style="width:20%" />
                    <col style="width:25%" />
                    <col style="width:18%" />
                    <col style="width:12%" />
                    <col style="width:10%" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Talep / Tesisat</th>
                        <th>@(icOperasyonGorsun ? "Firma / Müşteri" : "Müşteri / Konum")</th>
                        <th>Cihaz Değişimi</th>
                        <th>Randevu / Atama</th>
                        <th>Durum</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Talepler.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="ykc-empty-state"><i class="bi bi-inbox"></i>Filtreye uygun cihaz değişim talebi bulunamadı.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var talep in Model.Talepler)
                        {
                            <tr>
                                <td data-label="Talep / Tesisat">
                                    <div class="ykc-primary-cell"><span class="ykc-code">@Deger(talep.TesisatNo)</span></div>
                                    <div class="ykc-cell-meta">FR265 #@talep.Id · @talep.TalepTarihi.ToString("dd.MM.yyyy HH:mm")</div>
                                </td>
                                <td data-label="@(icOperasyonGorsun ? "Firma / Müşteri" : "Müşteri / Konum")">
                                    <div class="ykc-primary-cell">@(icOperasyonGorsun ? Deger(talep.FirmaAdi) : Deger(talep.MusteriAdi))</div>
                                    <div class="ykc-cell-meta">@(icOperasyonGorsun ? $"{Deger(talep.MusteriAdi)} · {KonumYazi(talep.Ilce, talep.Bolge)}" : KonumYazi(talep.Il, talep.Ilce, talep.Bolge))</div>
                                </td>
                                <td data-label="Cihaz Değişimi">
                                    <div class="ykc-device-change" title="@($"{talep.EskiCihaz} -> {talep.YeniCihaz}")">
                                        <span class="ykc-device-old">@Deger(talep.EskiCihaz)</span>
                                        <i class="bi bi-arrow-right ykc-device-arrow"></i>
                                        <span class="ykc-device-new">@Deger(talep.YeniCihaz)</span>
                                    </div>
                                </td>
                                <td data-label="Randevu / Atama">
                                    <div class="ykc-primary-cell">@RandevuYazi(talep.RandevuTarihi, talep.RandevuSaati)</div>
                                    <div class="ykc-cell-meta">@KonumYazi(talep.AtananEkip, talep.Bolge)</div>
                                </td>
                                <td data-label="Durum"><span class="df-pill @DurumClass(talep.Durum)">@DurumYazi(talep.Durum)</span></td>
                                <td class="ykc-action-cell" data-label="İşlem">
                                    <a class="ykc-detail-action" href="/ykc/detay/@talep.Id" title="Talep detayını aç"><i class="bi bi-eye"></i><span>Detay</span></a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (toplamSayfa > 1)
        {
            <div class="ykc-pager">
                <span>Sayfa @Model.Sayfa / @toplamSayfa</span>
                <div class="ykc-pager-actions">
                    @if (Model.Sayfa > 1)
                    {
                        <a class="df-btn df-btn-secondary df-btn-sm" href="@SayfaUrl(filtre, Model.Sayfa - 1)"><i class="bi bi-chevron-left"></i> Önceki</a>
                    }
                    @if (Model.Sayfa < toplamSayfa)
                    {
                        <a class="df-btn df-btn-primary df-btn-sm" href="@SayfaUrl(filtre, Model.Sayfa + 1)">Sonraki <i class="bi bi-chevron-right"></i></a>
                    }
                </div>
            </div>
        }
    </section>
</div>
