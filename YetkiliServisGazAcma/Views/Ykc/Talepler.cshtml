@model YkcTalepListeSonuc
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var filtre = ViewBag.Filtre as YkcTalepListeFiltre ?? new YkcTalepListeFiltre();
    var sertifikaliFirmaMi = User.IsInRole("SertifikaliFirma");
    var icOperasyonGorsun = !sertifikaliFirmaMi;
    ViewData["Title"] = sertifikaliFirmaMi ? "Cihaz Değişim Taleplerim" : "Cihaz Değişim Talepleri";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelModule"] = "Cihaz Değişim İşlemleri";
    ViewData["PanelSubtitle"] = "Cihaz Değişimi";
    ViewData["ActiveMenu"] = "YkcTalepler";
    var aktifFiltreler = new List<(string Etiket, string Deger)>();
    var toplamSayfa = Model.SayfaBoyutu > 0
        ? Math.Max((int)Math.Ceiling(Model.Toplam / (double)Model.SayfaBoyutu), 1)
        : 1;
    var aktifSayfa = Math.Clamp(Model.Sayfa, 1, toplamSayfa);
    var ilkKayit = Model.Toplam == 0 ? 0 : ((aktifSayfa - 1) * Model.SayfaBoyutu) + 1;
    var sonKayit = Math.Min(aktifSayfa * Model.SayfaBoyutu, Model.Toplam);
    var kolonSayisi = icOperasyonGorsun ? 11 : 9;
    var raporGorebilir = (ViewBag.YkcYetkileri as YkcYetkiOzeti)?.RaporlariGorebilir == true;
    var aktarim = SayfaDegerleri(filtre, aktifSayfa);
    aktarim["kaynak"] = "talepler";
    aktarim["sayfaBoyutu"] = Model.SayfaBoyutu;

    void AktifFiltreEkle(string etiket, string? deger)
    {
        if (!string.IsNullOrWhiteSpace(deger))
            aktifFiltreler.Add((etiket, deger));
    }

    AktifFiltreEkle("Tesisat", filtre.TesisatNo);
    AktifFiltreEkle("Abone adı soyadı", filtre.MusteriAdi);
    AktifFiltreEkle("Sözleşme", filtre.SozlesmeNo);
    AktifFiltreEkle("Abone", filtre.AboneNo);
    AktifFiltreEkle("Firma", filtre.Firma);
    AktifFiltreEkle("İl", filtre.Il);
    AktifFiltreEkle("İlçe", filtre.Ilce);
    AktifFiltreEkle("Bölge", filtre.Bolge);
    AktifFiltreEkle("Bekleyen iş", YkcBekleyenIsDegerleri.Etiket(filtre.BekleyenIs));
    if (filtre.Durum.HasValue)
        AktifFiltreEkle("Durum", DurumYazi(filtre.Durum.Value));
    if (filtre.KontrolNo is >= 1 and <= 5)
        AktifFiltreEkle("Kontrol aşaması", $"{filtre.KontrolNo}. kontrol");
    if (filtre.BaslangicTarihi.HasValue)
        AktifFiltreEkle("Başlangıç", filtre.BaslangicTarihi.Value.ToString("dd.MM.yyyy"));
    if (filtre.BitisTarihi.HasValue)
        AktifFiltreEkle("Bitiş", filtre.BitisTarihi.Value.ToString("dd.MM.yyyy"));

    Microsoft.AspNetCore.Routing.RouteValueDictionary SayfaDegerleri(YkcTalepListeFiltre seciliFiltre, int sayfa) => new(new
    {
        sirketId = seciliFiltre.SirketId,
        tesisatNo = seciliFiltre.TesisatNo,
        q = seciliFiltre.Q,
        sirala = seciliFiltre.Sirala,
        cihazTipi = seciliFiltre.CihazTipi,
        talepId = seciliFiltre.TalepId,
        marka = seciliFiltre.Marka,
        randevuBas = seciliFiltre.RandevuBaslangicTarihi?.ToString("yyyy-MM-dd"),
        randevuBit = seciliFiltre.RandevuBitisTarihi?.ToString("yyyy-MM-dd"),
        musteriAdi = seciliFiltre.MusteriAdi,
        sozlesmeNo = seciliFiltre.SozlesmeNo,
        aboneNo = seciliFiltre.AboneNo,
        firma = seciliFiltre.Firma,
        il = seciliFiltre.Il,
        ilce = seciliFiltre.Ilce,
        bolge = seciliFiltre.Bolge,
        hedefUygulama = seciliFiltre.HedefUygulama,
        durum = seciliFiltre.Durum,
        kontrolNo = seciliFiltre.KontrolNo,
        bekleyenIs = seciliFiltre.BekleyenIs,
        bas = seciliFiltre.BaslangicTarihi?.ToString("yyyy-MM-dd"),
        bit = seciliFiltre.BitisTarihi?.ToString("yyyy-MM-dd"),
        sayfa
    });
    string SayfaUrl(YkcTalepListeFiltre seciliFiltre, int sayfa) => Url.Action("Talepler", "Ykc", SayfaDegerleri(seciliFiltre, sayfa)) ?? "#";
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string? Secili(bool kosul) => kosul ? "selected" : null;

    private static string RandevuYazi(DateTime? tarih, string? saat, int? kontrolNo)
    {
        if (!tarih.HasValue && string.IsNullOrWhiteSpace(saat))
            return kontrolNo is > 1 ? $"{kontrolNo}. kontrol randevusu planlanacak" : "Randevu planlanacak";

        var randevu = string.Join(" ", new[]
        {
            tarih?.ToString("dd.MM.yyyy"),
            string.IsNullOrWhiteSpace(saat) ? null : saat
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

        return kontrolNo is > 1 ? $"{kontrolNo}. kontrol · {randevu}" : randevu;
    }

    private static string KonumYazi(params string?[] parcalar)
    {
        var sonuc = string.Join(" / ", parcalar
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(sonuc) ? "-" : sonuc;
    }

    private static string DurumYazi(int durum) => YkcDurumSunumu.Etiket(durum);
    private static string DurumClass(int durum) => YkcDurumSunumu.CssSinifi(durum);

    private static string GerekenIslemYazi(int durum, bool icOperasyonGorsun, int? kontrolNo)
    {
        if (kontrolNo is > 1 && durum == YkcDurumDegerleri.AtamaBekliyor)
            return icOperasyonGorsun ? $"{kontrolNo}. kontrolü planla" : $"{kontrolNo}. kontrol durumunu gör";
        if (kontrolNo is > 1 && durum == YkcDurumDegerleri.Atandi)
            return icOperasyonGorsun ? $"{kontrolNo}. kontrolü gör" : $"{kontrolNo}. randevuyu gör";

        return (durum, icOperasyonGorsun) switch
        {
            (YkcDurumDegerleri.TalepAlindi, true) => "Talebi incele",
            (YkcDurumDegerleri.AtamaBekliyor, true) => "Randevu planla",
            (YkcDurumDegerleri.Atandi, true) => "Randevuyu gör",
            (YkcDurumDegerleri.SahaIsleminde, true) => "Formu kontrol et",
            (YkcDurumDegerleri.TalepAlindi, false) => "Talebin durumunu gör",
            (YkcDurumDegerleri.AtamaBekliyor, false) => "İnceleme durumunu gör",
            (YkcDurumDegerleri.Atandi, false) => "Randevuyu gör",
            (YkcDurumDegerleri.SahaIsleminde, false) => "Form sürecini gör",
            (YkcDurumDegerleri.Tamamlandi, _) => "Kaydı gör",
            (YkcDurumDegerleri.Reddedildi, _) => "Red nedenini gör",
            (YkcDurumDegerleri.Iptal, _) => "İptali gör",
            _ => "Talebi görüntüle"
        };
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/operations-directory.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ykc-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/commissioning-history.css" asp-append-version="true" />
}

<div class="ykc-workspace ykc-list-page df-record-directory" data-history-directory data-directory-form="#ykcFilters" data-directory-panel="#ykcFiltersPanel" data-directory-export-all data-storage-key="ykc-requests-view">
    <partial name="_KayitListeAracCubugu" model="@(new KayitListeAracCubuguViewModel { Baslik = ViewData["Title"]?.ToString() ?? "Cihaz Değişim Talepleri", KayitSayisi = Model.Toplam, KayitVar = Model.Talepler.Any(), FormId = "ykcFilters", PanelId = "ykcFiltersPanel", TumFiltrelenenKayitlar = true, PdfUrl = raporGorebilir ? Url.Action("RaporPdf", "Ykc", aktarim) : null, ExcelUrl = raporGorebilir ? Url.Action("RaporExcel", "Ykc", aktarim) : null, YeniKayitUrl = sertifikaliFirmaMi ? Url.Action("Yeni", "Ykc") : null, YeniKayitEtiketi = "Yeni Talep" })" />
    <h1 class="ykc-list-accessible-title">@ViewData["Title"]</h1>

    <details id="ykcFiltersPanel" class="ykc-filter-panel" open="@(aktifFiltreler.Any() && string.IsNullOrEmpty(filtre.BekleyenIs) ? "open" : null)">
        <summary class="ykc-filter-bar">
            <span class="ykc-filter-leading"><i class="bi bi-sliders2"></i> Filtreler</span>
            <span class="ykc-filter-state">
                @if (aktifFiltreler.Any())
                {
                    @foreach (var item in aktifFiltreler.Take(5))
                    {
                        <span class="ykc-filter-chip"><b>@item.Etiket</b>@item.Deger</span>
                    }
                }
            </span>
            <span class="ykc-filter-chevron"><i class="bi bi-chevron-down"></i></span>
        </summary>
        <form id="ykcFilters" method="get" action="@Url.Action("Talepler", "Ykc")" class="ykc-filter-form">
            @if (filtre.SirketId.HasValue) { <input type="hidden" name="sirketId" value="@filtre.SirketId" /> }
            @if (!string.IsNullOrEmpty(filtre.BekleyenIs))
            {
                <input type="hidden" name="bekleyenIs" value="@filtre.BekleyenIs" />
            }
            <div class="ykc-filter-grid">
                <div class="ykc-filter-field"><label for="ykcRequestId">Talep No</label><input id="ykcRequestId" type="number" name="talepId" min="1" value="@filtre.TalepId" /></div>
                <div class="ykc-filter-field">
                    <label>Tesisat No</label>
                    <input type="text" name="tesisatNo" value="@filtre.TesisatNo" placeholder="Tesisat no" />
                </div>
                <div class="ykc-filter-field">
                    <label for="talepAboneAdi">Abone Adı Soyadı</label>
                    <input id="talepAboneAdi" type="text" name="musteriAdi" value="@filtre.MusteriAdi" />
                </div>
                <div class="ykc-filter-field">
                    <label>Sözleşme No</label>
                    <input type="text" name="sozlesmeNo" value="@filtre.SozlesmeNo" placeholder="Sözleşme no" />
                </div>
                <div class="ykc-filter-field">
                    <label>Abone No</label>
                    <input type="text" name="aboneNo" value="@filtre.AboneNo" placeholder="Abone no" />
                </div>
                @if (icOperasyonGorsun)
                {
                    <div class="ykc-filter-field">
                        <label>Firma</label>
                        <input type="text" name="firma" value="@filtre.Firma" placeholder="Firma adı" />
                    </div>
                    <div class="ykc-filter-field">
                        <label>İl</label>
                        <input type="text" name="il" value="@filtre.Il" placeholder="İl" />
                    </div>
                    <div class="ykc-filter-field">
                        <label>İlçe</label>
                        <input type="text" name="ilce" value="@filtre.Ilce" placeholder="İlçe" />
                    </div>
                    <div class="ykc-filter-field">
                        <label>Bölge</label>
                        <input type="text" name="bolge" value="@filtre.Bolge" placeholder="Bölge" />
                    </div>
                }
                <div class="ykc-filter-field">
                    <label for="ykcDeviceType">Yakıcı Cihaz Tipi</label>
                    <select id="ykcDeviceType" name="cihazTipi"><option value="">Tümü</option>@foreach (var tip in new[] { "Kombi", "Ocak", "Şofben", "Diğer" }) { <option value="@tip" selected="@Secili(filtre.CihazTipi == tip)">@tip</option> }</select>
                </div>
                <div class="ykc-filter-field">
                    <label for="ykcBrand">Marka</label><input id="ykcBrand" type="search" name="marka" value="@filtre.Marka" />
                </div>
                <div class="ykc-filter-field">
                    <label>Durum</label>
                    <select name="durum">
                        <option value="">Tümü</option>
                        @foreach (var item in new[] {
                            YkcDurumDegerleri.TalepAlindi,
                            YkcDurumDegerleri.AtamaBekliyor,
                            YkcDurumDegerleri.Atandi,
                            YkcDurumDegerleri.SahaIsleminde,
                            YkcDurumDegerleri.Reddedildi,
                            YkcDurumDegerleri.Tamamlandi,
                            YkcDurumDegerleri.Iptal
                        })
                        {
                            <option value="@item" selected="@Secili(filtre.Durum == item)">@DurumYazi(item)</option>
                        }
                    </select>
                </div>
                <div class="ykc-filter-field">
                    <label>Kontrol Aşaması</label>
                    <select name="kontrolNo">
                        <option value="">Tümü</option>
                        @for (var kontrol = 1; kontrol <= 5; kontrol++)
                        {
                            <option value="@kontrol" selected="@Secili(filtre.KontrolNo == kontrol)">@kontrol. Kontrol</option>
                        }
                    </select>
                </div>
                <div class="ykc-filter-field">
                    <label for="ykcAppointmentStart">Randevu Başlangıcı</label><input id="ykcAppointmentStart" type="date" name="randevuBas" value="@filtre.RandevuBaslangicTarihi?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="ykc-filter-field">
                    <label for="ykcAppointmentEnd">Randevu Bitişi</label><input id="ykcAppointmentEnd" type="date" name="randevuBit" value="@filtre.RandevuBitisTarihi?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="ykc-filter-field">
                    <label>Başlangıç</label>
                    <input type="date" name="bas" value="@filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="ykc-filter-field">
                    <label>Bitiş</label>
                    <input type="date" name="bit" value="@filtre.BitisTarihi?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="ykc-filter-actions">
                <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-funnel"></i> Uygula</button>
                <a class="df-btn df-btn-secondary" href="@Url.Action("Talepler", "Ykc", new { sirketId = filtre.SirketId })"><i class="bi bi-x-lg"></i> Temizle</a>
            </div>
        </form>
    </details>

    <section class="ykc-data-panel">
        <div class="ykc-table-scroll">
            <table class="ykc-data-table df-record-table @(icOperasyonGorsun ? "is-internal" : "is-firm")">
                <colgroup>
                    <col class="ykc-col-select" />
                    <col class="ykc-col-record" />
                    <col class="ykc-col-customer" />
                    @if (icOperasyonGorsun) { <col class="ykc-col-company" /> }
                    <col class="ykc-col-installation" />
                    <col class="ykc-col-contract" />
                    <col class="ykc-col-type" />
                    @if (icOperasyonGorsun) { <col class="ykc-col-project" /> }
                    <col class="ykc-col-new" />
                    <col class="ykc-col-date" />
                    <col class="ykc-col-status" />
                </colgroup>
                <thead>
                    <tr>
                        <th class="ykc-directory-select"><input type="checkbox" data-directory-select-all aria-label="Bu sayfadaki tüm talepleri seç" disabled="@(!Model.Talepler.Any())" /></th>
                        <th data-directory-column="record" data-directory-fields="talepId" title="Talebin benzersiz kayıt numarasıdır; toplam talep sayısı değildir.">Talep No</th>
                        <th data-directory-column="customer" data-directory-fields="musteriAdi">Abone Adı Soyadı</th>
                        @if (icOperasyonGorsun) { <th class="ykc-list-company-cell" data-directory-column="company" data-directory-fields="firma">Firma</th> }
                        <th scope="col" class="ykc-list-installation-cell" data-directory-column="installation" data-directory-fields="tesisatNo">Tesisat No</th>
                        <th scope="col" class="ykc-list-contract-cell" data-directory-column="contract" data-directory-fields="sozlesmeNo">Sözleşme No</th>
                        <th class="ykc-device-type-heading ykc-column-separated" data-directory-column="type" data-directory-fields="cihazTipi">Yakıcı Cihaz Tipi</th>
                        @if (icOperasyonGorsun)
                        {
                            <th class="ykc-column-separated">Projedeki Cihaz</th>
                        }
                        <th class="ykc-column-separated" data-directory-column="device" data-directory-fields="marka">Yeni Kullanılan Cihaz</th>
                        <th class="ykc-column-separated" data-directory-column="date" data-directory-fields="randevuBas randevuBit">Kontrol Randevusu</th>
                        <th class="ykc-column-separated" data-directory-column="status" data-directory-fields="durum">Süreç</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Talepler.Any())
                    {
                        <tr>
                            <td colspan="@kolonSayisi">
                                <div class="ykc-empty-state"><i class="bi bi-inbox"></i>Filtreye uygun cihaz değişim talebi bulunamadı.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var talep in Model.Talepler)
                        {
                            var gerekenIslem = GerekenIslemYazi(talep.Durum, icOperasyonGorsun, talep.SiradakiKontrolNo);
                            var aboneAdi = AboneAdiSunumu.Bicimlendir(talep.MusteriAdi);
                            var randevuPlanli = talep.RandevuTarihi.HasValue || !string.IsNullOrWhiteSpace(talep.RandevuSaati);
                            <tr data-directory-record data-directory-row-open data-export-id="@talep.Id">
                                <td class="ykc-directory-select"><input type="checkbox" data-directory-select value="@talep.Id" aria-label="#@talep.Id numaralı talebi seç" /></td>
                                <td class="ykc-directory-record-id" data-label="Talep No">
                                    <div class="ykc-primary-cell"><a class="ykc-code" data-directory-open href="@Url.Action("Detay", "Ykc", new { id = talep.Id, geri = SayfaUrl(filtre, aktifSayfa) })" title="Talep kayıt numarası: @talep.Id" aria-label="#@talep.Id: @gerekenIslem">#@talep.Id</a></div>
                                </td>
                                <td class="ykc-directory-customer" data-label="Abone Adı Soyadı">
                                    <div class="ykc-primary-cell" title="@aboneAdi">@aboneAdi</div>
                                </td>
                                @if (icOperasyonGorsun)
                                {
                                    <td class="ykc-list-company-cell" data-label="Firma"><div class="ykc-primary-cell is-regular" title="Firma: @Deger(talep.FirmaAdi)">@Deger(talep.FirmaAdi)</div></td>
                                }
                                <td class="ykc-list-installation-cell" data-label="Tesisat No">
                                    <div class="ykc-primary-cell" title="@Deger(talep.TesisatNo)">@Deger(talep.TesisatNo)</div>
                                </td>
                                <td class="ykc-list-contract-cell" data-label="Sözleşme No">
                                    <div class="ykc-primary-cell" title="@Deger(talep.SozlesmeNo)">@Deger(talep.SozlesmeNo)</div>
                                </td>
                                <td class="ykc-column-separated" data-label="Yakıcı Cihaz Tipi"><partial name="_YakiciCihazTipiEtiketi" model='@(talep.YeniCihazBilgisi?.Tip ?? "")' /></td>
                                @if (icOperasyonGorsun)
                                {
                                    <td data-label="Projedeki Cihaz" class="ykc-project-device-cell ykc-column-separated">
                                        <partial name="_YkcCihazDegisimBasligi" />
                                        <div class="ykc-device-summary is-project"><strong title="Marka: @Deger(talep.ProjedekiCihazBilgisi?.Marka)">@Deger(talep.ProjedekiCihazBilgisi?.Marka)</strong><span title="Baca tipi"><i class="bi bi-wind" aria-hidden="true"></i><span class="ykc-device-fact-label">Baca:</span> @Deger(talep.ProjedekiCihazBilgisi?.BacaTipi)</span><span title="Kapasite"><i class="bi bi-speedometer2" aria-hidden="true"></i><span class="ykc-device-fact-label">Kapasite:</span> @Deger(talep.ProjedekiCihazBilgisi?.Kapasite) kcal/h</span></div>
                                    </td>
                                }
                                <td class="ykc-column-separated" data-label="Yeni Kullanılan Cihaz"><div class="ykc-device-summary is-new"><strong title="Marka: @Deger(talep.YeniCihazBilgisi?.Marka)">@Deger(talep.YeniCihazBilgisi?.Marka)</strong><span title="Baca tipi"><i class="bi bi-wind" aria-hidden="true"></i><span class="ykc-device-fact-label">Baca:</span> @Deger(talep.YeniCihazBilgisi?.BacaTipi)</span><span title="Kapasite"><i class="bi bi-speedometer2" aria-hidden="true"></i><span class="ykc-device-fact-label">Kapasite:</span> @Deger(talep.YeniCihazBilgisi?.Kapasite) kcal/h</span></div></td>
                                <td class="ykc-column-separated" data-label="Kontrol Randevusu">
                                    @if (randevuPlanli)
                                    {
                                        <div class="ykc-primary-cell ykc-scheduled-appointment" title="@RandevuYazi(talep.RandevuTarihi, talep.RandevuSaati, talep.SiradakiKontrolNo)">
                                            @if (talep.SiradakiKontrolNo is > 1)
                                            {
                                                <span class="ykc-appointment-number">@talep.SiradakiKontrolNo. kontrol</span>
                                            }
                                            @if (talep.RandevuTarihi.HasValue)
                                            {
                                                <time class="df-schedule-value" datetime="@talep.RandevuTarihi.Value.ToString("yyyy-MM-dd")"><i class="bi bi-calendar3" aria-hidden="true"></i>@talep.RandevuTarihi.Value.ToString("dd.MM.yyyy")</time>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(talep.RandevuSaati))
                                            {
                                                <span class="df-schedule-value"><i class="bi bi-clock" aria-hidden="true"></i>@talep.RandevuSaati</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ykc-primary-cell is-pending-appointment" title="@RandevuYazi(talep.RandevuTarihi, talep.RandevuSaati, talep.SiradakiKontrolNo)">@RandevuYazi(talep.RandevuTarihi, talep.RandevuSaati, talep.SiradakiKontrolNo)</div>
                                    }
                                    @if (talep.KontrolAlaniDolduMu)
                                    {
                                        <div class="ykc-control-limit-note" title="Beş kontrolün tamamı uygun değil sonuçlandı"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span> 5 kontrol uygunsuz</span></div>
                                    }
                                    @if (icOperasyonGorsun && (!string.IsNullOrWhiteSpace(talep.AtananEkip) || !string.IsNullOrWhiteSpace(talep.Bolge)))
                                    {
                                        <div class="ykc-cell-meta" title="@KonumYazi(talep.AtananEkip, talep.Bolge)">@KonumYazi(talep.AtananEkip, talep.Bolge)</div>
                                    }
                                </td>
                                <td class="ykc-action-cell ykc-column-separated" data-label="Süreç">
                                    <div class="ykc-list-process">
                                        <span class="ykc-process-state @DurumClass(talep.Durum)" title="@DurumYazi(talep.Durum)">@DurumYazi(talep.Durum)</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Toplam > 0)
        {
            <nav class="ykc-pager" aria-label="Talep listesi sayfaları">
                <span>@ilkKayit-@sonKayit / @Model.Toplam kayıt gösteriliyor</span>
                <div class="ykc-pager-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm @(aktifSayfa == 1 ? "is-disabled" : "")"
                       href="@(aktifSayfa == 1 ? "#" : SayfaUrl(filtre, aktifSayfa - 1))"
                       aria-disabled="@(aktifSayfa == 1 ? "true" : "false")"
                       title="Önceki sayfa">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    @for (var sayfaNo = Math.Max(1, aktifSayfa - 2); sayfaNo <= Math.Min(toplamSayfa, aktifSayfa + 2); sayfaNo++)
                    {
                        <a class="ykc-page-number @(sayfaNo == aktifSayfa ? "is-active" : "")"
                           href="@SayfaUrl(filtre, sayfaNo)"
                           aria-current="@(sayfaNo == aktifSayfa ? "page" : null)">@sayfaNo</a>
                    }
                    <a class="df-btn df-btn-secondary df-btn-sm @(aktifSayfa == toplamSayfa ? "is-disabled" : "")"
                       href="@(aktifSayfa == toplamSayfa ? "#" : SayfaUrl(filtre, aktifSayfa + 1))"
                       aria-disabled="@(aktifSayfa == toplamSayfa ? "true" : "false")"
                       title="Sonraki sayfa">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </nav>
        }
    </section>
    <partial name="_KayitSutunFiltresi" model='@("ykcFilters")' />
</div>

@section Scripts {
    <script src="~/js/commissioning-history.js" asp-append-version="true"></script>
}
