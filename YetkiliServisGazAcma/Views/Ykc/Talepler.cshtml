@model YkcTalepListeSonuc
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var filtre = ViewBag.Filtre as YkcTalepListeFiltre ?? new YkcTalepListeFiltre();
    var ozet = ViewBag.Ozet as YkcDashboardOzetDto ?? new YkcDashboardOzetDto();
    var sertifikaliFirmaMi = User.IsInRole("SertifikaliFirma");
    var icOperasyonGorsun = !sertifikaliFirmaMi;
    ViewData["Title"] = sertifikaliFirmaMi ? "Taleplerim" : "Gelen Talepler";
    ViewData["PanelTitle"] = ViewData["Title"];
    ViewData["PanelSubtitle"] = "Cihaz Değişimi";
    ViewData["ActiveMenu"] = "YkcTalepler";
    var aktifFiltreler = new List<(string Etiket, string Deger)>();
    var toplamSayfa = Model.SayfaBoyutu > 0
        ? Math.Max((int)Math.Ceiling(Model.Toplam / (double)Model.SayfaBoyutu), 1)
        : 1;
    var aktifSayfa = Math.Clamp(Model.Sayfa, 1, toplamSayfa);
    var ilkKayit = Model.Toplam == 0 ? 0 : ((aktifSayfa - 1) * Model.SayfaBoyutu) + 1;
    var sonKayit = Math.Min(aktifSayfa * Model.SayfaBoyutu, Model.Toplam);
    var kolonSayisi = icOperasyonGorsun ? 9 : 7;

    void AktifFiltreEkle(string etiket, string? deger)
    {
        if (!string.IsNullOrWhiteSpace(deger))
            aktifFiltreler.Add((etiket, deger));
    }

    AktifFiltreEkle("Tesisat", filtre.TesisatNo);
    AktifFiltreEkle("Müşteri", filtre.MusteriAdi);
    AktifFiltreEkle("Sözleşme", filtre.SozlesmeNo);
    AktifFiltreEkle("Abone", filtre.AboneNo);
    AktifFiltreEkle("Firma", filtre.Firma);
    AktifFiltreEkle("İl", filtre.Il);
    AktifFiltreEkle("İlçe", filtre.Ilce);
    AktifFiltreEkle("Bölge", filtre.Bolge);
    if (filtre.Durum.HasValue)
        AktifFiltreEkle("Durum", DurumYazi(filtre.Durum.Value));
    if (filtre.BaslangicTarihi.HasValue)
        AktifFiltreEkle("Başlangıç", filtre.BaslangicTarihi.Value.ToString("dd.MM.yyyy"));
    if (filtre.BitisTarihi.HasValue)
        AktifFiltreEkle("Bitiş", filtre.BitisTarihi.Value.ToString("dd.MM.yyyy"));
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string? Secili(bool kosul) => kosul ? "selected" : null;

    private static string RandevuYazi(DateTime? tarih, string? saat)
    {
        if (!tarih.HasValue && string.IsNullOrWhiteSpace(saat))
            return "Randevu planlanacak";

        return string.Join(" ", new[]
        {
            tarih?.ToString("dd.MM.yyyy"),
            string.IsNullOrWhiteSpace(saat) ? null : saat
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string KonumYazi(params string?[] parcalar)
    {
        var sonuc = string.Join(" / ", parcalar
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(sonuc) ? "-" : sonuc;
    }

    private static string SayfaUrl(YkcTalepListeFiltre filtre, int sayfa)
    {
        var query = new List<string>();
        Ekle(query, "tesisatNo", filtre.TesisatNo);
        Ekle(query, "musteriAdi", filtre.MusteriAdi);
        Ekle(query, "sozlesmeNo", filtre.SozlesmeNo);
        Ekle(query, "aboneNo", filtre.AboneNo);
        Ekle(query, "firma", filtre.Firma);
        Ekle(query, "il", filtre.Il);
        Ekle(query, "ilce", filtre.Ilce);
        Ekle(query, "bolge", filtre.Bolge);
        Ekle(query, "durum", filtre.Durum?.ToString());
        Ekle(query, "bas", filtre.BaslangicTarihi?.ToString("yyyy-MM-dd"));
        Ekle(query, "bit", filtre.BitisTarihi?.ToString("yyyy-MM-dd"));
        Ekle(query, "sayfa", sayfa.ToString());
        return "/ykc/talepler" + (query.Count == 0 ? "" : "?" + string.Join("&", query));
    }

    private static void Ekle(List<string> query, string ad, string? deger)
    {
        if (!string.IsNullOrWhiteSpace(deger))
            query.Add($"{ad}={Uri.EscapeDataString(deger)}");
    }

    private static string DurumYazi(int durum) => YkcDurumSunumu.Etiket(durum);
    private static string DurumClass(int durum) => YkcDurumSunumu.CssSinifi(durum);

    private static string GerekenIslemYazi(int durum, bool icOperasyonGorsun) => (durum, icOperasyonGorsun) switch
    {
        (YkcDurumDegerleri.TalepAlindi, true) => "Talebi incele",
        (YkcDurumDegerleri.AtamaBekliyor, true) => "Randevu planla",
        (YkcDurumDegerleri.Atandi, true) => "Randevuyu takip et",
        (YkcDurumDegerleri.SahaIsleminde, true) => "Form ve imzayı kontrol et",
        (YkcDurumDegerleri.TalepAlindi, false) => "Talebin durumunu gör",
        (YkcDurumDegerleri.AtamaBekliyor, false) => "İnceleme durumunu gör",
        (YkcDurumDegerleri.Atandi, false) => "Randevuyu gör",
        (YkcDurumDegerleri.SahaIsleminde, false) => "Form sürecini gör",
        (YkcDurumDegerleri.Tamamlandi, _) => "Tamamlanan kaydı gör",
        (YkcDurumDegerleri.Reddedildi, _) => "Red gerekçesini gör",
        (YkcDurumDegerleri.Iptal, _) => "İptal bilgisini gör",
        _ => "Talebi görüntüle"
    };
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ykc-operations.css" asp-append-version="true" />
}

<div class="ykc-workspace ykc-list-page">
    @if (TempData["Basarili"] != null)
    {
        <div class="df-alert df-alert-success">@TempData["Basarili"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <header class="ykc-list-header">
        <div class="ykc-list-title-row">
            <h1>@(sertifikaliFirmaMi ? "Taleplerim" : "Gelen Talepler")</h1>
            <dl class="ykc-inline-overview" aria-label="Talep özeti">
                <div><dt>Toplam</dt><dd>@ozet.Toplam</dd></div>
                <div><dt>İncelenen</dt><dd>@ozet.Incelemede</dd></div>
                <div><dt>Randevu / İşlem</dt><dd>@ozet.RandevuSaha</dd></div>
                <div><dt>Tamamlanan</dt><dd>@ozet.Tamamlanan</dd></div>
            </dl>
        </div>
        @if (sertifikaliFirmaMi)
        {
            <div class="ykc-header-actions">
                <a class="df-btn df-btn-primary" href="/ykc/yeni"><i class="bi bi-plus-lg"></i> Yeni Talep</a>
            </div>
        }
    </header>

    <details class="ykc-filter-panel" open="@(aktifFiltreler.Any() ? "open" : null)">
        <summary class="ykc-filter-bar">
            <span class="ykc-filter-leading"><i class="bi bi-sliders2"></i> Filtreler</span>
            <span class="ykc-filter-state">
                @if (aktifFiltreler.Any())
                {
                    @foreach (var item in aktifFiltreler.Take(5))
                    {
                        <span class="ykc-filter-chip"><b>@item.Etiket</b>@item.Deger</span>
                    }
                }
                else
                {
                    <span class="ykc-filter-hint">@(sertifikaliFirmaMi ? "Tesisat, durum veya tarih ile taleplerinizi daraltın." : "Tesisat, durum, firma, bölge veya tarih ile listeyi daraltın.")</span>
                }
            </span>
            <span class="ykc-filter-chevron"><i class="bi bi-chevron-down"></i></span>
        </summary>
        <form method="get" action="/ykc/talepler" class="ykc-filter-form">
            <div class="ykc-filter-grid">
                <div class="ykc-filter-field">
                    <label>Tesisat</label>
                    <input type="text" name="tesisatNo" value="@filtre.TesisatNo" placeholder="Tesisat no" />
                </div>
                <div class="ykc-filter-field">
                    <label>Müşteri</label>
                    <input type="text" name="musteriAdi" value="@filtre.MusteriAdi" placeholder="Müşteri adı" />
                </div>
                <div class="ykc-filter-field">
                    <label>Sözleşme</label>
                    <input type="text" name="sozlesmeNo" value="@filtre.SozlesmeNo" placeholder="Sözleşme no" />
                </div>
                <div class="ykc-filter-field">
                    <label>Abone</label>
                    <input type="text" name="aboneNo" value="@filtre.AboneNo" placeholder="Abone no" />
                </div>
                @if (icOperasyonGorsun)
                {
                    <div class="ykc-filter-field">
                        <label>Firma</label>
                        <input type="text" name="firma" value="@filtre.Firma" placeholder="Firma adı" />
                    </div>
                    <div class="ykc-filter-field">
                        <label>İl</label>
                        <input type="text" name="il" value="@filtre.Il" placeholder="İl" />
                    </div>
                    <div class="ykc-filter-field">
                        <label>İlçe</label>
                        <input type="text" name="ilce" value="@filtre.Ilce" placeholder="İlçe" />
                    </div>
                    <div class="ykc-filter-field">
                        <label>Bölge</label>
                        <input type="text" name="bolge" value="@filtre.Bolge" placeholder="Bölge" />
                    </div>
                }
                <div class="ykc-filter-field">
                    <label>Durum</label>
                    <select name="durum">
                        <option value="">Tümü</option>
                        @foreach (var item in new[] {
                            new { Id = YkcDurumDegerleri.TalepAlindi, Ad = "Talep Alındı" },
                            new { Id = YkcDurumDegerleri.AtamaBekliyor, Ad = "İnceleniyor" },
                            new { Id = YkcDurumDegerleri.Atandi, Ad = "Randevu Oluşturuldu" },
                            new { Id = YkcDurumDegerleri.SahaIsleminde, Ad = "İşlem Devam Ediyor" },
                            new { Id = YkcDurumDegerleri.Reddedildi, Ad = "Reddedildi" },
                            new { Id = YkcDurumDegerleri.Tamamlandi, Ad = "Tamamlandı" },
                            new { Id = YkcDurumDegerleri.Iptal, Ad = "İptal" }
                        })
                        {
                            <option value="@item.Id" selected="@Secili(filtre.Durum == item.Id)">@item.Ad</option>
                        }
                    </select>
                </div>
                <div class="ykc-filter-field">
                    <label>Başlangıç</label>
                    <input type="date" name="bas" value="@filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="ykc-filter-field">
                    <label>Bitiş</label>
                    <input type="date" name="bit" value="@filtre.BitisTarihi?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="ykc-filter-actions">
                <button class="df-btn df-btn-primary" type="submit"><i class="bi bi-funnel"></i> Uygula</button>
                <a class="df-btn df-btn-secondary" href="/ykc/talepler"><i class="bi bi-x-lg"></i> Temizle</a>
            </div>
        </form>
    </details>

    <section class="ykc-data-panel">
        <div class="ykc-data-toolbar">
            <div class="ykc-data-title-wrap">
                <span class="ykc-data-title-icon"><i class="bi bi-journal-text"></i></span>
                <div>
                    <div class="ykc-data-title">Talep Listesi</div>
                </div>
            </div>
        </div>

        <div class="ykc-table-scroll">
            <table class="ykc-data-table @(icOperasyonGorsun ? "is-internal" : "is-firm")">
                <colgroup>
                    @if (icOperasyonGorsun)
                    {
                        <col style="width:6%" /><col style="width:10%" /><col style="width:10%" /><col style="width:14%" /><col style="width:11%" /><col style="width:11%" /><col style="width:15%" /><col style="width:9%" /><col style="width:14%" />
                    }
                    else
                    {
                        <col style="width:8%" /><col style="width:17%" /><col style="width:20%" /><col style="width:17%" /><col style="width:15%" /><col style="width:9%" /><col style="width:14%" />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th>Talep</th>
                        <th>@(icOperasyonGorsun ? "Müşteri" : "Müşteri / Konum")</th>
                        @if (icOperasyonGorsun) { <th>Firma</th> }
                        <th>Tesisat Bilgileri</th>
                        @if (icOperasyonGorsun) { <th>Projedeki Cihaz</th> }
                        <th>Yeni Kullanılan Cihaz</th>
                        <th>@(icOperasyonGorsun ? "Randevu / Yönlendirme" : "Randevu")</th>
                        <th>Durum</th>
                        <th>Gereken İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Talepler.Any())
                    {
                        <tr>
                            <td colspan="@kolonSayisi">
                                <div class="ykc-empty-state"><i class="bi bi-inbox"></i>Filtreye uygun cihaz değişim talebi bulunamadı.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var talep in Model.Talepler)
                        {
                            var gerekenIslem = GerekenIslemYazi(talep.Durum, icOperasyonGorsun);
                            <tr>
                                <td data-label="Talep">
                                    <div class="ykc-primary-cell"><span class="ykc-code">#@talep.Id</span></div>
                                    <div class="ykc-cell-meta">@talep.TalepTarihi.ToString("dd.MM.yyyy HH:mm")</div>
                                </td>
                                <td data-label="Müşteri">
                                    <div class="ykc-primary-cell">@Deger(talep.MusteriAdi)</div>
                                    @if (!icOperasyonGorsun) { <div class="ykc-cell-meta">@KonumYazi(talep.Il, talep.Ilce, talep.Bolge)</div> }
                                </td>
                                @if (icOperasyonGorsun)
                                {
                                    <td data-label="Firma"><div class="ykc-primary-cell is-regular">@Deger(talep.FirmaAdi)</div></td>
                                }
                                <td data-label="Tesisat Bilgileri">
                                    <dl class="ykc-id-list">
                                        <div><dt>Tesisat</dt><dd>@Deger(talep.TesisatNo)</dd></div>
                                        <div><dt>Sözleşme</dt><dd>@Deger(talep.SozlesmeNo)</dd></div>
                                        <div><dt>Abone</dt><dd>@Deger(talep.AboneNo)</dd></div>
                                    </dl>
                                </td>
                                @if (icOperasyonGorsun) { <td data-label="Projedeki Cihaz"><div class="ykc-device-column is-project">@Deger(talep.EskiCihaz)</div></td> }
                                <td data-label="Yeni Kullanılan Cihaz"><div class="ykc-device-column is-new">@Deger(talep.YeniCihaz)</div></td>
                                <td data-label="@(icOperasyonGorsun ? "Randevu / Yönlendirme" : "Randevu")">
                                    <div class="ykc-primary-cell">@RandevuYazi(talep.RandevuTarihi, talep.RandevuSaati)</div>
                                    @if (icOperasyonGorsun)
                                    {
                                        <div class="ykc-cell-meta">@KonumYazi(talep.AtananEkip, talep.Bolge)</div>
                                    }
                                </td>
                                <td data-label="Durum"><span class="df-pill @DurumClass(talep.Durum)">@DurumYazi(talep.Durum)</span></td>
                                <td class="ykc-action-cell" data-label="Gereken İşlem">
                                    <a class="ykc-next-action" href="/ykc/detay/@talep.Id" title="Talep detayını aç"><span>@gerekenIslem</span><i class="bi bi-arrow-right"></i></a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Toplam > 0)
        {
            <nav class="ykc-pager" aria-label="Talep listesi sayfaları">
                <span>@ilkKayit-@sonKayit / @Model.Toplam kayıt gösteriliyor</span>
                <div class="ykc-pager-actions">
                    <a class="df-btn df-btn-secondary df-btn-sm @(aktifSayfa == 1 ? "is-disabled" : "")"
                       href="@(aktifSayfa == 1 ? "#" : SayfaUrl(filtre, aktifSayfa - 1))"
                       aria-disabled="@(aktifSayfa == 1 ? "true" : "false")"
                       title="Önceki sayfa">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    @for (var sayfaNo = Math.Max(1, aktifSayfa - 2); sayfaNo <= Math.Min(toplamSayfa, aktifSayfa + 2); sayfaNo++)
                    {
                        <a class="ykc-page-number @(sayfaNo == aktifSayfa ? "is-active" : "")"
                           href="@SayfaUrl(filtre, sayfaNo)"
                           aria-current="@(sayfaNo == aktifSayfa ? "page" : null)">@sayfaNo</a>
                    }
                    <a class="df-btn df-btn-secondary df-btn-sm @(aktifSayfa == toplamSayfa ? "is-disabled" : "")"
                       href="@(aktifSayfa == toplamSayfa ? "#" : SayfaUrl(filtre, aktifSayfa + 1))"
                       aria-disabled="@(aktifSayfa == toplamSayfa ? "true" : "false")"
                       title="Sonraki sayfa">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </nav>
        }
    </section>
</div>
