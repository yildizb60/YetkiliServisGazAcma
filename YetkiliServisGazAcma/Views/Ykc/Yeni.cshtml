@model YkcTalepKaydetDto
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var sorgulandi = !string.IsNullOrWhiteSpace(Model.SorguReferansi);
}
@section PageStyles {
    <link rel="stylesheet" href="~/css/ykc-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ykc-request.css" asp-append-version="true" />
}
<div class="ykc-request">
    <header class="ykc-request-header">
        <h1>Yeni Cihaz Değişim Talebi</h1>
        <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/talepler"><i class="bi bi-arrow-left"></i> Taleplerim</a>
    </header>
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger" role="alert">@TempData["Hata"]</div>
    }
    <form method="post" action="/ykc/yeni" id="ykcCreateForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="SorguReferansi" />
        <input type="hidden" asp-for="KaynakTipi" value="OnlineServis" />
        <input type="hidden" asp-for="MusteriAdi" />
        <input type="hidden" asp-for="Adres" />
        <section class="ykc-request-section">
            <h2><i class="bi bi-house-check"></i> Tesisat</h2>
            <div class="ykc-request-query">
                <div class="ykc-field"><label for="TesisatNo">Tesisat No</label><input asp-for="TesisatNo" inputmode="numeric" autocomplete="off" required /></div>
                <div class="ykc-field"><label for="SozlesmeNo">Sözleşme No</label><input asp-for="SozlesmeNo" inputmode="numeric" autocomplete="off" required /></div>
                <button type="button" class="df-btn df-btn-primary" id="ykcTesisatSorgulaBtn"><i class="bi bi-search"></i> Sorgula</button>
            </div>
            <p id="ykcSorguAlert" role="status" hidden></p>
            <div id="ykcCustomer" class="ykc-request-customer" hidden="@(!sorgulandi)">
                <strong id="ykcCustomerName">@Model.MusteriAdi</strong><span id="ykcCustomerAddress">@Model.Adres</span>
            </div>
        </section>
        <fieldset id="ykcDeviceFields" class="ykc-request-section" hidden="@(!sorgulandi)" disabled="@(!sorgulandi)">
            <h2><i class="bi bi-arrow-left-right"></i> Cihaz Değişimi</h2>
            <div class="ykc-field ykc-request-selection">
                <label for="ykcServisCihazSecimi">Değiştirilecek Cihaz</label>
                <select id="ykcServisCihazSecimi" required>
                    @if (sorgulandi) { <option value="@Model.SorguReferansi">Seçilen proje cihazı</option> }
                    else { <option value="">Cihaz seçin</option> }
                </select>
            </div>
            <h3>Yeni Kullanılan Cihaz</h3>
            <div class="ykc-request-grid">
                <div class="ykc-field"><label for="YeniCihazTipi">Yakıcı Cihaz Tipi</label><input asp-for="YeniCihazTipi" required maxlength="100" /></div>
                <div class="ykc-field"><label for="YeniMarka">Marka</label><input asp-for="YeniMarka" required maxlength="100" /></div>
                <div class="ykc-field"><label for="YeniBacaTipi">Baca Tipi</label><input asp-for="YeniBacaTipi" required maxlength="100" /></div>
                <div class="ykc-field"><label for="YeniKapasite">Kapasite (kcal/h)</label><input asp-for="YeniKapasite" inputmode="decimal" required maxlength="30" /></div>
            </div>
            <fieldset class="ykc-request-secondhand">
                <legend>Takılan yakıcı cihaz ikinci el mi?</legend>
                <label><input type="radio" name="IkinciElCihazMi" value="false" checked="@(Model.IkinciElCihazMi != true)" /> Hayır</label>
                <label><input type="radio" name="IkinciElCihazMi" value="true" checked="@(Model.IkinciElCihazMi == true)" /> Evet</label>
            </fieldset>
            <p id="ykcSecondhandNote" hidden="@(Model.IkinciElCihazMi != true)" class="ykc-request-notice">İkinci el cihaz için Yetkili Servis Cihaz Kontrol Raporu gereklidir.</p>
            <footer class="ykc-request-footer">
                <button type="submit" id="ykcCreateButton" class="df-btn df-btn-primary"><i class="bi bi-check2"></i> Talebi Oluştur</button>
            </footer>
        </fieldset>
    </form>
</div>
@section Scripts {
    <script src="~/js/ykc-request.js" asp-append-version="true"></script>
}
