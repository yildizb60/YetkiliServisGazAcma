@model YkcTalepKaydetDto
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}

@section Styles {
    <style>
        .ykc-form-stack {
            --ykc-ink: #10162f;
            --ykc-purple: #6d5dfc;
            --ykc-cyan: #16c6e8;
            --ykc-coral: #f15f78;
            display: grid;
            gap: 12px;
        }
        .ykc-create-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
        .ykc-create-form > .validation-summary-errors,
        .ykc-create-form > .ykc-card:first-of-type,
        .ykc-create-form > .ykc-card:last-of-type { grid-column: 1 / -1; }
        .ykc-create-form > .ykc-card { margin-top: 0 !important; }
        .ykc-steps-shell { padding: 0 20px 16px; }
        .ykc-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
        .ykc-step { background: #fff; border: 1px solid var(--df-border); border-radius: 8px; padding: 10px 11px; display: grid; grid-template-columns: auto 1fr; gap: 9px; align-items: center; }
        .ykc-step-no { width: 28px; height: 28px; border-radius: 999px; display: grid; place-items: center; background: var(--df-primary-soft); color: var(--df-primary); font-weight: 900; }
        .ykc-step-title { color: var(--df-text); font-size: 12px; font-weight: 900; }
        .ykc-step-text { color: var(--df-muted); font-size: 11px; line-height: 1.28; margin-top: 2px; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
        .ykc-card { background: #fff; border: 1px solid var(--df-border); border-radius: 8px; overflow: hidden; }
        .ykc-card-head { position: relative; padding: 16px 20px; border-bottom: 1px solid var(--df-border); background: linear-gradient(90deg, rgba(109, 93, 252, .10), rgba(22, 198, 232, .07) 42%, #fff 82%); display: flex; justify-content: space-between; gap: 12px; align-items: center; }
        .ykc-card-head::after { content: ""; position: absolute; left: 20px; right: 20px; bottom: -1px; height: 2px; border-radius: 999px; background: linear-gradient(90deg, var(--df-primary), var(--ykc-cyan), transparent 78%); opacity: .55; }
        .ykc-card-title { color: var(--df-text); font-size: 15px; font-weight: 900; }
        .ykc-card-subtitle { color: var(--df-muted); font-size: 12px; margin-top: 3px; }
        .ykc-form-grid { padding: 20px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
        .ykc-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
        .ykc-field.full { grid-column: 1 / -1; }
        .ykc-field.two { grid-column: span 2; }
        .ykc-field label { font-size: 11px; color: #555; font-weight: 850; text-transform: uppercase; letter-spacing: .04em; }
        .ykc-field input, .ykc-field select, .ykc-field textarea { width: 100%; min-width: 0; border: 1.5px solid #dfe5ee; border-radius: 8px; background: #fafbfc; color: var(--df-text); padding: 10px 12px; font-size: 13px; outline: none; }
        .ykc-field textarea { min-height: 82px; resize: vertical; }
        .ykc-field input:focus, .ykc-field select:focus, .ykc-field textarea:focus { border-color: var(--df-primary); background: #fff; }
        .ykc-required { color: var(--df-danger); }
        .ykc-help { color: var(--df-muted); font-size: 12px; line-height: 1.45; }
        .ykc-compare-wrap { padding: 18px 20px 20px; display: grid; gap: 14px; overflow-x: auto; }
        .ykc-device-select {
            display: grid;
            gap: 7px;
            border: 1px solid #dfe8f5;
            background: linear-gradient(180deg, #fbfdff 0%, #f6f9fe 100%);
            border-radius: 8px;
            padding: 12px;
        }
        .ykc-device-select label { color: var(--df-text); font-size: 12px; font-weight: 900; text-transform: uppercase; letter-spacing: .035em; }
        .ykc-device-select select { width: 100%; border: 1.5px solid #d8e1ee; border-radius: 8px; background: #fff; color: var(--df-text); padding: 11px 12px; font-size: 13px; outline: none; }
        .ykc-device-select select:focus { border-color: var(--df-primary); box-shadow: 0 0 0 3px rgba(46, 78, 200, .10); }
        .ykc-device-card { grid-column: 1 / -1; }
        .ykc-compare-table { width: 100%; min-width: 760px; border-collapse: separate; border-spacing: 0; border: 1px solid #dfe6f2; border-radius: 8px; overflow: hidden; background: #fff; }
        .ykc-compare-table th { background: #f4f7fb; color: var(--df-text); font-size: 12px; font-weight: 900; text-align: left; padding: 13px 12px; border-bottom: 1px solid #dfe6f2; }
        .ykc-compare-table th:nth-child(2) { background: #f6f8ff; color: #203c9a; }
        .ykc-compare-table th:nth-child(3) { background: #f2fbf7; color: #18724e; }
        .ykc-compare-table td { padding: 11px 12px; border-bottom: 1px solid #edf2f7; vertical-align: top; }
        .ykc-compare-table tr:last-child td { border-bottom: 0; }
        .ykc-compare-table .row-label { width: 190px; color: var(--df-muted); font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: .035em; background: #fbfcff; }
        .ykc-compare-table input { width: 100%; min-width: 0; border: 1.5px solid #dfe5ee; border-radius: 8px; background: #fff; color: var(--df-text); padding: 10px 12px; font-size: 13px; outline: none; }
        .ykc-compare-table input[readonly] { background: #f5f7fb; color: var(--df-muted); cursor: not-allowed; }
        .ykc-compare-note { display: flex; gap: 10px; align-items: flex-start; border: 1px solid #dbe7ff; background: #f6f8ff; color: var(--df-text-soft); border-radius: 8px; padding: 11px 12px; font-size: 12px; line-height: 1.45; }
        .ykc-compare-note strong { color: var(--df-primary); }
        .ykc-inline-hint { color: var(--df-muted); font-size: 11px; margin-top: 5px; }
        .ykc-hidden-fields { display: none; }
        .ykc-field:has(#EskiCihazTipiKodu),
        .ykc-field:has(#EskiMarkaKodu),
        .ykc-field:has(#EskiBacaTipiKodu),
        .ykc-field:has(#YeniCihazTipiKodu),
        .ykc-field:has(#YeniMarkaKodu),
        .ykc-field:has(#YeniBacaTipiKodu) { display: none; }
        .ykc-query-action { display: flex; align-items: end; }
        .ykc-query-action .df-btn { width: 100%; min-height: 40px; }
        .ykc-query-strip {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: minmax(220px, .85fr) minmax(0, 2.15fr);
            gap: 14px;
            align-items: end;
            border: 1px solid #dbe6f4;
            border-radius: 8px;
            background: linear-gradient(180deg, #fbfdff 0%, #f5f8fd 100%);
            padding: 14px;
        }
        .ykc-query-copy { display: grid; gap: 4px; }
        .ykc-query-copy strong { color: var(--df-text); font-size: 14px; font-weight: 900; }
        .ykc-query-copy span { color: var(--df-muted); font-size: 12px; line-height: 1.45; }
        .ykc-query-inputs {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
            gap: 12px;
            align-items: end;
        }
        .ykc-query-inputs .df-btn {
            min-width: 150px;
            min-height: 42px;
            white-space: nowrap;
        }
        .ykc-auto-details {
            grid-column: 1 / -1;
            border: 1px solid #e3ebf6;
            border-radius: 8px;
            background: #fff;
            overflow: hidden;
        }
        .ykc-auto-details summary {
            list-style: none;
            min-height: 42px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            color: var(--df-text);
            font-size: 12px;
            font-weight: 900;
            cursor: pointer;
            user-select: none;
            background: linear-gradient(180deg, #ffffff 0%, #f7faff 100%);
        }
        .ykc-auto-details summary::-webkit-details-marker { display: none; }
        .ykc-auto-details summary::after {
            content: "Aç";
            border: 1px solid #d9e2f1;
            border-radius: 999px;
            color: var(--df-primary);
            background: #fff;
            padding: 5px 10px;
            font-size: 11px;
            font-weight: 900;
        }
        .ykc-auto-details[open] summary::after { content: "Kapat"; }
        .ykc-auto-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            padding: 12px;
            border-top: 1px solid #edf2f7;
        }
        .ykc-digital-note {
            grid-column: 1 / -1;
            border: 1px solid #d9e4ff;
            border-radius: 8px;
            background: linear-gradient(135deg, #f7fbff 0%, #f6f4ff 100%);
            color: var(--df-text-soft);
            padding: 12px 13px;
            font-size: 12px;
            line-height: 1.5;
        }
        .ykc-digital-note strong { color: var(--ykc-purple); }
        .ykc-query-alert { display: none; margin: 0 20px 16px; border-radius: 8px; padding: 12px 14px; font-size: 13px; font-weight: 700; }
        .ykc-query-card .ykc-query-alert { margin: 0; }
        .ykc-query-alert.success { display: block; background: var(--df-success-soft); border: 1px solid #bcebd4; color: #157347; }
        .ykc-query-alert.warning { display: block; background: var(--df-warning-soft); border: 1px solid #f5d999; color: #8a5a00; }
        .ykc-query-alert.danger { display: block; background: var(--df-danger-soft); border: 1px solid #ffd3d3; color: var(--df-danger); }
        .ykc-field input[readonly], .ykc-field textarea[readonly] { background: #f0f4f9; color: var(--df-muted); cursor: not-allowed; }
        .ykc-actions { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 20px 20px; }
        .validation-summary-errors { background: var(--df-danger-soft); border: 1px solid #ffd3d3; color: var(--df-danger); border-radius: 8px; padding: 12px 16px; font-size: 13px; }
        .ykc-form-stack > .df-page-panel,
        .ykc-card {
            border-color: #dfe6f2;
            box-shadow: 0 14px 32px rgba(13, 34, 112, .055);
        }
        .ykc-form-stack > .df-page-panel .df-panel-head {
            background:
                radial-gradient(circle at 88% 18%, rgba(22, 198, 232, .30) 0 54px, transparent 56px),
                radial-gradient(circle at 74% 78%, rgba(109, 93, 252, .32) 0 68px, transparent 70px),
                linear-gradient(135deg, #10162f 0%, #172557 58%, #513bd6 100%);
            color: #fff;
            padding: 16px 20px;
            position: relative;
        }
        .ykc-form-stack > .df-page-panel .df-panel-title {
            color: #fff;
            font-size: 20px;
        }
        .ykc-form-stack > .df-page-panel .df-panel-subtitle {
            color: rgba(255, 255, 255, .76);
            margin-top: 4px;
        }
        .ykc-form-stack > .df-page-panel .df-btn-secondary {
            border-color: rgba(255, 255, 255, .30);
            background: rgba(255, 255, 255, .10);
            color: #fff;
        }
        .ykc-form-stack > .df-page-panel .df-btn-secondary:hover {
            background: #fff;
            color: var(--ykc-ink);
        }
        .ykc-step {
            position: relative;
            min-height: 58px;
            background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
            border-color: #e0e7f2;
            box-shadow: 0 10px 22px rgba(13, 34, 112, .04);
        }
        .ykc-step::after {
            content: "";
            position: absolute;
            left: 14px;
            right: 14px;
            bottom: 0;
            height: 3px;
            border-radius: 999px 999px 0 0;
            background: linear-gradient(90deg, var(--df-primary), var(--ykc-cyan));
            opacity: .86;
        }
        .ykc-step:nth-child(2)::after { background: linear-gradient(90deg, #1dbb7a, var(--ykc-cyan)); }
        .ykc-step:nth-child(3)::after { background: linear-gradient(90deg, #dc8e0d, var(--ykc-coral)); }
        .ykc-step:nth-child(4)::after { background: linear-gradient(90deg, var(--ykc-purple), var(--ykc-cyan)); }
        .ykc-step-no {
            border-radius: 8px;
            box-shadow: inset 0 0 0 1px rgba(46, 78, 200, .08);
        }
        .ykc-card-head { background: linear-gradient(90deg, rgba(109, 93, 252, .10), rgba(22, 198, 232, .07) 42%, #fff 82%); }
        .ykc-card-title {
            display: flex;
            align-items: center;
            gap: 9px;
        }
        .ykc-card-title::before {
            content: "";
            width: 7px;
            height: 20px;
            border-radius: 999px;
            background: linear-gradient(180deg, var(--df-primary), var(--ykc-purple));
        }
        form .ykc-card:nth-of-type(2) .ykc-card-title::before { background: #1dbb7a; }
        form .ykc-card:nth-of-type(3) .ykc-card-title::before { background: #dc8e0d; }
        form .ykc-card:nth-of-type(4) .ykc-card-title::before { background: #7056d8; }
        .ykc-field input,
        .ykc-field select,
        .ykc-field textarea {
            background: #fff;
            box-shadow: 0 1px 0 rgba(13, 34, 112, .03);
            transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
        }
        .ykc-field input:focus,
        .ykc-field select:focus,
        .ykc-field textarea:focus {
            box-shadow: 0 0 0 3px rgba(46, 78, 200, .10);
        }
        .ykc-field input[readonly],
        .ykc-field textarea[readonly] {
            border-color: #e4eaf3;
            background: #f5f7fb;
        }
        .ykc-help {
            border-left: 3px solid var(--ykc-cyan);
            padding-left: 10px;
        }
        .ykc-query-alert {
            box-shadow: 0 10px 24px rgba(13, 34, 112, .045);
        }
        .ykc-field input[type="file"] {
            border-style: dashed;
            background: #fbfcff;
            padding: 9px;
        }
        .ykc-field input[type="file"]::file-selector-button {
            border: 1px solid #dbe3ef;
            border-radius: 8px;
            background: #fff;
            color: var(--df-primary);
            font-weight: 800;
            padding: 8px 12px;
            margin-right: 10px;
            cursor: pointer;
        }
        .ykc-signature-flow {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
        }
        .ykc-signature-step {
            border: 1px solid #dce6f4;
            border-radius: 8px;
            background: linear-gradient(180deg, #fff 0%, #f8fbff 100%);
            padding: 14px;
            display: grid;
            gap: 8px;
            min-height: 132px;
        }
        .ykc-signature-step strong {
            color: var(--df-text);
            font-size: 13px;
            font-weight: 900;
        }
        .ykc-signature-step span {
            color: var(--df-muted);
            font-size: 12px;
            line-height: 1.45;
        }
        .ykc-signature-no {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            display: grid;
            place-items: center;
            color: #fff;
            font-weight: 900;
            background: linear-gradient(135deg, var(--df-primary), var(--ykc-purple));
        }
        .ykc-signature-note {
            grid-column: 1 / -1;
            border: 1px solid #d9e9ff;
            border-radius: 8px;
            background: linear-gradient(90deg, #f8fbff 0%, #eefbff 100%);
            color: var(--df-text-soft);
            font-size: 12px;
            line-height: 1.5;
            padding: 12px 14px;
        }
        @@media (max-width: 1100px) {
            .ykc-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .ykc-form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .ykc-signature-flow { grid-template-columns: 1fr; }
            .ykc-field.two { grid-column: 1 / -1; }
            .ykc-auto-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .ykc-query-strip,
            .ykc-query-inputs { grid-template-columns: 1fr; }
            .ykc-query-inputs .df-btn { width: 100%; }
        }
        @@media (max-width: 720px) {
            .ykc-create-form,
            .ykc-steps, .ykc-form-grid, .ykc-auto-grid { grid-template-columns: 1fr; }
            .ykc-actions { flex-direction: column; }
        }
    </style>
}

<div class="ykc-form-stack">
    @if (TempData["Hata"] != null)
    {
        <div class="df-alert df-alert-danger">@TempData["Hata"]</div>
    }

    <section class="df-page-panel">
        <div class="df-panel-head">
            <div>
                <h2 class="df-panel-title">Yeni Cihaz Değişim Talebi</h2>
                <div class="df-panel-subtitle">Tesisatı sorgulayın, değişecek cihazı seçin ve yeni cihaz bilgisini dijital kayıt olarak oluşturun.</div>
            </div>
            <div class="df-actions">
                <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/talepler">Listeye Dön</a>
            </div>
        </div>
        <div class="ykc-steps-shell">
            <div class="ykc-steps">
                <div class="ykc-step"><div class="ykc-step-no">1</div><div><div class="ykc-step-title">Tesisat</div><div class="ykc-step-text">Tesisat ve sözleşme sorgulanır.</div></div></div>
                <div class="ykc-step"><div class="ykc-step-no">2</div><div><div class="ykc-step-title">Projedeki Cihaz</div><div class="ykc-step-text">Değişimi istenen cihaz seçilir.</div></div></div>
                <div class="ykc-step"><div class="ykc-step-no">3</div><div><div class="ykc-step-title">Yeni Cihaz</div><div class="ykc-step-text">Yeni cihaz bilgileri girilir.</div></div></div>
                <div class="ykc-step"><div class="ykc-step-no">4</div><div><div class="ykc-step-title">Dijital Kayıt</div><div class="ykc-step-text">FR265 sistemde dijital hazırlanır.</div></div></div>
            </div>
        </div>
    </section>

    <form method="post" action="/ykc/yeni" enctype="multipart/form-data" class="ykc-create-form">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false)

        <section class="ykc-card ykc-query-card">
            <div class="ykc-card-head">
                <div>
                    <div class="ykc-card-title">Tesisat Sorgulama</div>
                    <div class="ykc-card-subtitle">Tesisat numarası ile müşteri, sayaç ve projedeki cihaz bilgileri sorgulanır.</div>
                </div>
            </div>
            <div class="ykc-form-grid">
                <div class="ykc-query-strip">
                    <div class="ykc-query-copy">
                        <strong>Projedeki cihazları getir</strong>
                        <span>Tesisat ve sözleşme numarası girildiğinde son onaylı projedeki cihazlar listelenir.</span>
                    </div>
                    <div class="ykc-query-inputs">
                        <div class="ykc-field">
                            <label>Tesisat No <span class="ykc-required">*</span></label>
                            <input asp-for="TesisatNo" autocomplete="off" required />
                            <span asp-validation-for="TesisatNo"></span>
                        </div>
                        <div class="ykc-field">
                            <label>Sözleşme No</label>
                            <input asp-for="SozlesmeNo" autocomplete="off" />
                        </div>
                        <button type="button" class="df-btn df-btn-primary" id="ykcTesisatSorgulaBtn">Sorgula</button>
                    </div>
                </div>
                <div class="ykc-field full">
                    <div id="ykcSorguAlert" class="ykc-query-alert"></div>
                </div>

                <details class="ykc-auto-details">
                    <summary>Sorgudan gelen tesisat, müşteri ve konum bilgileri</summary>
                    <div class="ykc-auto-grid">
                <div class="ykc-field">
                    <label>Abone No</label>
                    <input asp-for="AboneNo" autocomplete="off" />
                </div>
                <div class="ykc-field">
                    <label>Proje No</label>
                    <input asp-for="ProjeNo" autocomplete="off" />
                </div>
                <div class="ykc-field">
                    <label>Sayaç No</label>
                    <input asp-for="SayacNo" autocomplete="off" />
                </div>
                <div class="ykc-field">
                    <label>Firma Kodu</label>
                    <input asp-for="FirmaKodu" autocomplete="off" />
                </div>
                <div class="ykc-field">
                    <label>Müşteri Adı</label>
                    <input asp-for="MusteriAdi" autocomplete="off" />
                </div>
                <div class="ykc-field">
                    <label>Müşteri Telefon</label>
                    <input asp-for="MusteriTelefon" autocomplete="off" />
                </div>
                <input type="hidden" asp-for="KaynakTipi" />
                <div class="ykc-field">
                    <label>İl</label>
                    <input asp-for="Il" autocomplete="off" />
                </div>
                <div class="ykc-field">
                    <label>İlçe</label>
                    <input asp-for="Ilce" autocomplete="off" />
                </div>
                <div class="ykc-field">
                    <label>Bölge</label>
                    <input asp-for="Bolge" autocomplete="off" />
                </div>
                <div class="ykc-field full">
                    <label>Adres</label>
                    <textarea asp-for="Adres"></textarea>
                </div>
                    </div>
                </details>
            </div>
        </section>

        <section class="ykc-card ykc-device-card" style="margin-top:16px;">
            <div class="ykc-card-head">
                <div>
                    <div class="ykc-card-title">Cihaz Bilgileri</div>
                    <div class="ykc-card-subtitle">FR265 formundaki düzene göre projedeki cihaz ve yeni kullanılan cihaz aynı satırda karşılaştırılır.</div>
                </div>
            </div>
            <div class="ykc-compare-wrap">
                <div class="ykc-device-select">
                    <label>Projedeki Cihazlar</label>
                    <select id="ykcServisCihazSecimi" disabled>
                        <option value="">Önce tesisat sorgulayınız</option>
                    </select>
                    <div class="ykc-inline-hint">Sorgudan gelen cihaz seçilince projedeki cihaz sütunu dolar. Bilgi gelmezse manuel giriş yapılabilir.</div>
                </div>

                <input type="hidden" asp-for="EskiCihazTipiKodu" />
                <input type="hidden" asp-for="EskiMarkaKodu" />
                <input type="hidden" asp-for="EskiBacaTipiKodu" />
                <input type="hidden" asp-for="YeniCihazTipiKodu" />
                <input type="hidden" asp-for="YeniMarkaKodu" />
                <input type="hidden" asp-for="YeniBacaTipiKodu" />

                <table class="ykc-compare-table">
                    <thead>
                        <tr>
                            <th>Alan</th>
                            <th>Projedeki Cihaz</th>
                            <th>Yeni Kullanılan Cihaz</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="row-label">Yakıcı Cihaz Tipi</td>
                            <td><input asp-for="EskiCihazTipi" autocomplete="off" readonly /></td>
                            <td>
                                <input asp-for="YeniCihazTipi" autocomplete="off" placeholder="Kombi, ocak..." required />
                                <span asp-validation-for="YeniCihazTipi"></span>
                            </td>
                        </tr>
                        <tr>
                            <td class="row-label">Marka</td>
                            <td><input asp-for="EskiMarka" autocomplete="off" readonly /></td>
                            <td>
                                <input asp-for="YeniMarka" autocomplete="off" required />
                                <span asp-validation-for="YeniMarka"></span>
                            </td>
                        </tr>
                        <tr>
                            <td class="row-label">Baca Tipi</td>
                            <td><input asp-for="EskiBacaTipi" autocomplete="off" readonly /></td>
                            <td>
                                <input asp-for="YeniBacaTipi" autocomplete="off" placeholder="Baca tipi" required />
                                <span asp-validation-for="YeniBacaTipi"></span>
                            </td>
                        </tr>
                        <tr>
                            <td class="row-label">Kapasite (kcal/h)</td>
                            <td><input asp-for="EskiKapasite" autocomplete="off" readonly /></td>
                            <td>
                                <input asp-for="YeniKapasite" autocomplete="off" placeholder="Örn: 24000" required />
                                <span asp-validation-for="YeniKapasite"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="ykc-compare-note">
                    <strong>Kontrol</strong>
                    <span>Projedeki cihaz ve yeni cihaz aynı tabloda görünür. Uyum değerlendirmesi otomatik karar vermez; iç tesisat incelemesinde mühendis tarafından netleştirilir.</span>
                </div>
            </div>
        </section>

        <section class="ykc-card" style="margin-top:16px;">
            <div class="ykc-card-head">
                <div>
                    <div class="ykc-card-title">FR265 Önizleme ve İmza Akışı</div>
                    <div class="ykc-card-subtitle">Talep kaydedildikten sonra form sistemde önizlenir, uygun aşamada imza/arşiv servisine gönderilir.</div>
                </div>
            </div>
            <div class="ykc-form-grid">
                <div class="ykc-signature-flow">
                    <div class="ykc-signature-step">
                        <div class="ykc-signature-no">1</div>
                        <strong>Form Önizleme</strong>
                        <span>FR265, bu ekrandaki tesisat ve cihaz bilgileriyle sistemde dijital olarak hazırlanır.</span>
                    </div>
                    <div class="ykc-signature-step">
                        <div class="ykc-signature-no">2</div>
                        <strong>İmzaya Gönderim</strong>
                        <span>İç tesisat incelemesi tamamlanınca belge imza/arşiv uygulamasına API üzerinden aktarılır.</span>
                    </div>
                    <div class="ykc-signature-step">
                        <div class="ykc-signature-no">3</div>
                        <strong>İmzalı Nihai Belge</strong>
                        <span>İmza süreci tamamlandığında durum ve imzalı belge sistemde görüntülenir.</span>
                    </div>
                </div>
                <div class="ykc-signature-note">
                    Bu ekranda dosya yükletmiyoruz; amaç talep verisini doğru kayda almak ve FR265'i dijital imza sürecine hazır hale getirmek. İmzalı belge takibi detay ekranında yapılır.
                </div>
            </div>
            <div class="ykc-actions">
                <a class="df-btn df-btn-secondary" href="/ykc/talepler">Vazgeç</a>
                <button class="df-btn df-btn-primary" type="submit">Talep Kaydını Oluştur</button>
            </div>
        </section>
    </form>
</div>

@section Scripts {
    <script>
        (() => {
            const sorgulaBtn = document.getElementById("ykcTesisatSorgulaBtn");
            const cihazSecimi = document.getElementById("ykcServisCihazSecimi");
            const alertBox = document.getElementById("ykcSorguAlert");
            let servisCihazlari = [];

            const field = (id) => document.getElementById(id);
            const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";
            const prop = (obj, name) => obj?.[name] ?? obj?.[name.charAt(0).toUpperCase() + name.slice(1)] ?? "";

            const setValue = (id, value) => {
                const el = field(id);
                if (el) el.value = value ?? "";
            };

            const setValueIfPresent = (id, value) => {
                if (value === null || value === undefined || value === "") return;
                setValue(id, value);
            };

            const setReadonly = (ids, readonly) => {
                ids.forEach(id => {
                    const el = field(id);
                    if (el) el.readOnly = readonly;
                });
            };

            const showAlert = (type, message) => {
                alertBox.className = `ykc-query-alert ${type}`;
                alertBox.textContent = message;
            };

            const clearDevices = (message) => {
                servisCihazlari = [];
                cihazSecimi.innerHTML = "";
                const option = document.createElement("option");
                option.value = "";
                option.textContent = message;
                cihazSecimi.appendChild(option);
                cihazSecimi.disabled = true;
            };

            const autoFieldIds = ["AboneNo", "ProjeNo", "SayacNo", "FirmaKodu", "MusteriAdi", "MusteriTelefon", "Il", "Ilce", "Bolge", "Adres"];
            const oldDeviceFieldIds = ["EskiCihazTipiKodu", "EskiCihazTipi", "EskiMarkaKodu", "EskiMarka", "EskiBacaTipiKodu", "EskiBacaTipi", "EskiKapasite"];

            const fillTopFields = (data) => {
                setValueIfPresent("TesisatNo", prop(data, "tesisatNo"));
                setValueIfPresent("SozlesmeNo", prop(data, "sozlesmeNo"));
                setValueIfPresent("AboneNo", prop(data, "aboneNo"));
                setValueIfPresent("SayacNo", prop(data, "sayacNo"));
                setValueIfPresent("FirmaKodu", prop(data, "firmaKodu"));
                setValueIfPresent("MusteriAdi", prop(data, "musteriAdi"));
                setValueIfPresent("MusteriTelefon", prop(data, "musteriTelefon"));
                setValueIfPresent("Il", prop(data, "il"));
                setValueIfPresent("Ilce", prop(data, "ilce"));
                setValueIfPresent("Bolge", prop(data, "bolge"));
                setValueIfPresent("Adres", prop(data, "adres"));
            };

            const applyDevice = (cihaz) => {
                if (!cihaz) return;

                const tipKodu = prop(cihaz, "cihazTipKodu");
                const tip = prop(cihaz, "cihazTipi");
                const marka = prop(cihaz, "cihazMarka");
                const kapasite = prop(cihaz, "cihazKapasite");
                const projeNo = prop(cihaz, "projeNo");

                setValue("EskiCihazTipiKodu", tipKodu);
                setValue("EskiCihazTipi", tip);
                setValue("EskiMarka", marka);
                setValue("EskiMarkaKodu", "");
                setValue("EskiBacaTipiKodu", "");
                setValue("EskiBacaTipi", "");
                setValue("EskiKapasite", kapasite);
                setValue("ProjeNo", projeNo);

                setValue("YeniCihazTipiKodu", tipKodu);
                setValue("YeniCihazTipi", tip);
                setValue("YeniKapasite", kapasite);

                setReadonly(oldDeviceFieldIds, true);
            };

            const populateDevices = (cihazlar) => {
                servisCihazlari = cihazlar;
                cihazSecimi.innerHTML = "";

                if (!cihazlar.length) {
                    clearDevices("Servisten cihaz gelmedi");
                    return;
                }

                if (cihazlar.length > 1) {
                    const placeholder = document.createElement("option");
                    placeholder.value = "";
                    placeholder.textContent = "Değiştirilecek cihazı seçiniz";
                    cihazSecimi.appendChild(placeholder);
                }

                cihazlar.forEach((cihaz, index) => {
                    const marka = prop(cihaz, "cihazMarka") || "Marka yok";
                    const tip = prop(cihaz, "cihazTipi") || "Cihaz tipi yok";
                    const kapasite = prop(cihaz, "cihazKapasite") || "Kapasite yok";
                    const option = document.createElement("option");
                    option.value = String(index);
                    option.textContent = `${marka} / ${tip} / ${kapasite} kcal`;
                    cihazSecimi.appendChild(option);
                });

                cihazSecimi.disabled = false;
                if (cihazlar.length === 1) {
                    cihazSecimi.value = "0";
                    applyDevice(cihazlar[0]);
                }
            };

            cihazSecimi?.addEventListener("change", () => {
                const index = Number(cihazSecimi.value);
                if (!Number.isNaN(index) && servisCihazlari[index]) {
                    applyDevice(servisCihazlari[index]);
                }
            });

            sorgulaBtn?.addEventListener("click", async () => {
                const tesisatNo = field("TesisatNo")?.value?.trim() ?? "";
                const sozlesmeNo = field("SozlesmeNo")?.value?.trim() ?? "";

                if (!tesisatNo || !sozlesmeNo) {
                    showAlert("warning", "Tesisat no ve sözleşme no giriniz.");
                    return;
                }

                const originalText = sorgulaBtn.textContent;
                sorgulaBtn.disabled = true;
                sorgulaBtn.textContent = "Sorgulanıyor...";

                try {
                    const formData = new FormData();
                    formData.append("__RequestVerificationToken", token());
                    formData.append("TesisatNo", tesisatNo);
                    formData.append("SozlesmeNo", sozlesmeNo);

                    const response = await fetch("/ykc/tesisat-sorgula", {
                        method: "POST",
                        body: formData,
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });

                    if (!response.ok) throw new Error("Sorgu yanıtı alınamadı.");

                    const data = await response.json();
                    const cihazlar = prop(data, "cihazlar") || [];
                    fillTopFields(data);

                    if (prop(data, "basarili") === true || cihazlar.length > 0) {
                        setValue("KaynakTipi", "OnlineServis");
                        setReadonly(autoFieldIds, true);
                        populateDevices(cihazlar);
                        showAlert("success", prop(data, "mesaj") || "Tesisat bilgileri alındı.");
                    } else {
                        setReadonly(autoFieldIds, false);
                        setReadonly(oldDeviceFieldIds, false);
                        clearDevices("Manuel eski cihaz girişi yapınız");
                        showAlert("warning", prop(data, "mesaj") || "Servisten bilgi alınamadı, manuel girebilirsiniz.");
                    }
                } catch (error) {
                    setReadonly(autoFieldIds, false);
                    setReadonly(oldDeviceFieldIds, false);
                    clearDevices("Manuel eski cihaz girişi yapınız");
                    showAlert("danger", error.message || "Tesisat sorgusu sırasında hata oluştu.");
                } finally {
                    sorgulaBtn.disabled = false;
                    sorgulaBtn.textContent = originalText;
                }
            });
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
