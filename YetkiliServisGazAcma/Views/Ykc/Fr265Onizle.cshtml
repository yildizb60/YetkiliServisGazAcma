@model YkcTalepDetayDto
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var formTarihi = Model.TalepTarihi.ToString("dd.MM.yyyy");
    var imzaEntegrasyonu = ViewBag.ImzaEntegrasyonu as YkcImzaEntegrasyonDto ?? new YkcImzaEntegrasyonDto();
    var ykcYetkileri = ViewBag.YkcYetkileri as YkcYetkiOzeti ?? new YkcYetkiOzeti();
    var imzaIslemYetkisi = ykcYetkileri.Fr265ImzaIslemiYapabilir;
    var demoImzaModu = imzaEntegrasyonu.DemoModuMu;
    var gonderimTakildi = Model.ImzaSureci?.Durum == YkcImzaDurumDegerleri.ImzayaGonderildi
        && string.IsNullOrWhiteSpace(Model.ImzaSureci.ProviderDocumentId)
        && (!Model.ImzaSureci.GonderimTarihi.HasValue || Model.ImzaSureci.GonderimTarihi <= DateTime.Now.AddMinutes(-5));
    var kontroller = Model.Kontroller
        .Where(x => x.KontrolNo is >= 1 and <= 5)
        .GroupBy(x => x.KontrolNo)
        .Select(x => x.OrderByDescending(k => k.KontrolTarihi ?? DateTime.MinValue).First())
        .ToList();
    var imzayaHazir = Model.Durum == YkcDurumDegerleri.SahaIsleminde
        && Model.RandevuTarihi.HasValue
        && !string.IsNullOrWhiteSpace(Model.RandevuSaati)
        && kontroller.Count == 5
        && kontroller.All(x => x.Sonuc == YkcFr265KontrolSonucDegerleri.Uygun || x.Sonuc == YkcFr265KontrolSonucDegerleri.Uygulanmaz);
    var imzayaGonderebilir = imzaIslemYetkisi
        && imzaEntegrasyonu.KullanilabilirMi
        && imzayaHazir
        && string.IsNullOrWhiteSpace(Model.ImzaSureci?.ProviderDocumentId)
        && (Model.ImzaSureci?.Durum is null or YkcImzaDurumDegerleri.Hazir or YkcImzaDurumDegerleri.Hata || gonderimTakildi);
    var imzaDurumuSorgulanabilir = imzaIslemYetkisi
        && imzaEntegrasyonu.KullanilabilirMi
        && !string.IsNullOrWhiteSpace(Model.ImzaSureci?.ProviderDocumentId)
        && Model.ImzaSureci?.Durum != YkcImzaDurumDegerleri.Tamamlandi;
}

@functions {
    private static string Deger(string? value) => string.IsNullOrWhiteSpace(value) ? "" : value.Trim();
    private static string KontrolSonucYazi(string? sonuc)
    {
        return sonuc switch
        {
            YkcFr265KontrolSonucDegerleri.Uygun => "Uygun",
            YkcFr265KontrolSonucDegerleri.UygunDegil => "Uygun Değil",
            YkcFr265KontrolSonucDegerleri.Uygulanmaz => "Uygulanmaz",
            _ => "Bekliyor"
        };
    }

    private static string LogoUrl(YkcTalepDetayDto model)
    {
        var anahtar = $"{model.FirmaKodu} {model.SirketAdi}".ToUpperInvariant();
        return anahtar.Contains("MARMARA") || anahtar.Contains("YALOVA") || anahtar.Contains("CORLU")
            ? "/images/company/marmaragaz-logo.png"
            : "/images/company/corumgaz-kargaz-surmeligaz-logo.png";
    }
}

@section Styles {
    <style>
        .fr265-toolbar { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin-bottom: 14px; }
        .fr265-paper { max-width: 920px; margin: 0 auto; background: #fff; border: 1px solid var(--df-border); border-radius: 8px; box-shadow: var(--df-shadow-soft); padding: 34px 38px; color: #111827; }
        .fr265-head { display: grid; grid-template-columns: 1fr auto; gap: 18px; align-items: start; border-bottom: 2px solid #111827; padding-bottom: 14px; margin-bottom: 18px; }
        .fr265-brand { display: flex; align-items: center; gap: 16px; min-width: 0; }
        .fr265-logo { width: 172px; max-height: 58px; object-fit: contain; flex: 0 0 auto; }
        .fr265-title { font-size: 18px; font-weight: 900; text-transform: uppercase; line-height: 1.35; }
        .fr265-date { font-size: 13px; font-weight: 800; white-space: nowrap; }
        .fr265-table { width: 100%; border-collapse: collapse; margin: 12px 0 18px; table-layout: fixed; }
        .fr265-table th, .fr265-table td { border: 1px solid #111827; padding: 9px 10px; vertical-align: middle; font-size: 13px; min-height: 36px; }
        .fr265-table th { background: #f3f4f6; font-weight: 900; text-align: left; }
        .fr265-label { width: 34%; font-weight: 850; background: #f9fafb; }
        .fr265-section-title { font-size: 13px; font-weight: 900; text-transform: uppercase; margin: 18px 0 8px; color: #1f2937; }
        .fr265-text { font-size: 13px; line-height: 1.55; margin: 10px 0; text-align: justify; }
        .fr265-sign-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 22px; }
        .fr265-sign-grid.three { grid-template-columns: repeat(3, 1fr); }
        .fr265-sign { border: 1px solid #111827; min-height: 138px; padding: 12px; font-size: 13px; }
        .fr265-sign-title { font-weight: 900; margin-bottom: 14px; }
        .fr265-line { margin-top: 10px; }
        .fr265-note { color: var(--df-muted); font-size: 12px; margin-top: 12px; }
        .fr265-demo-note { display: flex; align-items: flex-start; gap: 10px; max-width: 920px; margin: 0 auto 14px; padding: 11px 13px; border: 1px solid #f0c36a; background: #fff8e8; color: #714f0d; font-size: 12px; }
        .fr265-demo-note i { font-size: 16px; }
        .fr265-demo-note strong { display: block; margin-bottom: 2px; }
        @@media print {
            body { background: #fff !important; }
            .df-sidebar, .df-topbar, .fr265-toolbar { display: none !important; }
            .df-main, .df-content { margin: 0 !important; padding: 0 !important; }
            .fr265-paper { border: none; box-shadow: none; max-width: none; padding: 0; }
        }
        @@media (max-width: 760px) {
            .fr265-paper { padding: 22px 18px; }
            .fr265-head, .fr265-sign-grid, .fr265-sign-grid.three { grid-template-columns: 1fr; }
            .fr265-brand { align-items: flex-start; flex-direction: column; }
            .fr265-logo { width: 150px; }
            .fr265-toolbar { flex-direction: column; align-items: stretch; }
        }
    </style>
}

<div class="fr265-toolbar">
    <div>
        <h2 class="df-panel-title" style="margin:0;">FR265 Form Önizleme</h2>
        <div class="df-panel-subtitle">Cihaz değişim talebi #@Model.Id için imzaya gönderilecek dijital belge taslağı.</div>
    </div>
    <div class="df-actions">
        <a class="df-btn df-btn-secondary df-btn-sm" href="/ykc/detay/@Model.Id">Detaya Dön</a>
        @if (imzayaGonderebilir)
        {
            <form method="post" action="/ykc/imzaya-gonder">
                @Html.AntiForgeryToken()
                <input type="hidden" name="talepId" value="@Model.Id" />
                <button class="df-btn df-btn-primary df-btn-sm" type="submit">@(demoImzaModu ? "Demo İmza Sürecine Gönder" : "İmza Uygulamasına Gönder")</button>
            </form>
        }
        else if (imzaDurumuSorgulanabilir)
        {
            <form method="post" action="/ykc/imza-durum-sorgula">
                @Html.AntiForgeryToken()
                <input type="hidden" name="talepId" value="@Model.Id" />
                <button class="df-btn df-btn-primary df-btn-sm" type="submit">İmza Durumunu Güncelle</button>
            </form>
        }
        else if (!imzaEntegrasyonu.KullanilabilirMi)
        {
            <span class="df-btn df-btn-secondary df-btn-sm" style="pointer-events:none;opacity:.65;">İmza Entegrasyonu Bekleniyor</span>
        }
    </div>
</div>

@if (demoImzaModu)
{
    <div class="fr265-demo-note"><i class="bi bi-beaker"></i><span><strong>Demo imza modu</strong>Gönderim ve sonuç alma adımları sunum için simüle edilir. Oluşan sonuç belgesi hukuki elektronik imza içermez.</span></div>
}

<section class="fr265-paper">
    <div class="fr265-head">
        <div class="fr265-brand">
            <img class="fr265-logo" src="@LogoUrl(Model)" alt="Şirket logosu" />
            <div class="fr265-title">FR265 Proje Tadilatı Gerektirmeyen Yakıcı Cihaz Değişim Formu</div>
        </div>
        <div class="fr265-date">Tarih: @formTarihi</div>
    </div>

    <table class="fr265-table">
        <tbody>
            <tr><td class="fr265-label">Sertifikalı Firma Unvanı</td><td>@Deger(Model.FirmaAdi)</td></tr>
            <tr><td class="fr265-label">Sertifika Numarası</td><td>@Deger(Model.YetkiBelgesiNo)</td></tr>
        </tbody>
    </table>

    <div class="fr265-section-title">Abone / Tesisat Bilgileri</div>
    <table class="fr265-table">
        <tbody>
            <tr><td class="fr265-label">Adı Soyadı</td><td>@Deger(Model.MusteriAdi)</td></tr>
            <tr><td class="fr265-label">Tesisat Numarası</td><td>@Deger(Model.TesisatNo)</td></tr>
            <tr><td class="fr265-label">Tüketim Noktası (Daire/İş Yeri Numarası)</td><td>@Deger(Model.TuketimNoktasi)</td></tr>
            <tr><td class="fr265-label">Bina Kodu</td><td>@Deger(Model.BaglantiNesnesi)</td></tr>
            <tr><td class="fr265-label">Adres</td><td>@Deger(Model.Adres)</td></tr>
        </tbody>
    </table>

    <div class="fr265-section-title">Cihaz Karşılaştırması</div>
    <table class="fr265-table">
        <thead>
            <tr>
                <th></th>
                <th>Projedeki Cihaz</th>
                <th>Yeni Kullanılan Cihaz</th>
            </tr>
        </thead>
        <tbody>
            <tr><td class="fr265-label">Yakıcı Cihaz Tipi</td><td>@Deger(Model.EskiCihazTipi)</td><td>@Deger(Model.YeniCihazTipi)</td></tr>
            <tr><td class="fr265-label">Marka</td><td>@Deger(Model.EskiMarka)</td><td>@Deger(Model.YeniMarka)</td></tr>
            <tr><td class="fr265-label">Baca Tipi</td><td>@Deger(Model.EskiBacaTipi)</td><td>@Deger(Model.YeniBacaTipi)</td></tr>
            <tr><td class="fr265-label">Kapasite (kcal/h)</td><td>@Deger(Model.EskiKapasite)</td><td>@Deger(Model.YeniKapasite)</td></tr>
        </tbody>
    </table>

    <table class="fr265-table">
        <tbody>
            <tr>
                <td class="fr265-label">Takılan Yakıcı Cihaz İkinci El Cihaz Mı?</td>
                <td>@(Model.IkinciElCihazMi == true ? "☑" : "☐") Evet</td>
                <td>@(Model.IkinciElCihazMi == false ? "☑" : "☐") Hayır</td>
            </tr>
            <tr>
                <td colspan="3">Cihazın ikinci el olması durumunda, yetkili servis tarafından düzenlenecek “Yetkili Servis Cihaz Kontrol Raporu” bu forma eklenmelidir.</td>
            </tr>
        </tbody>
    </table>

    <p class="fr265-text">Yukarıda bilgileri verilen abonenin/tesisatın mevcut onaylı projesinde bulunan yakıcı cihazın tip, yerleşim ve kapasite değişikliği yapılmamıştır.</p>
    <p class="fr265-text">Aynı yerde, aynı tip ve kapasitedeki yeni yakıcı cihaz tesisat üzerindeki cihaz vanasına, cihaz bağlantı parçaları ve atık sistemleri ile tesis edilmiş olup değişimle ilgili tüm idari ve teknik sorumluluk sertifikalı firmaya aittir.</p>

    @if (Model.Kontroller.Any())
    {
        <div class="fr265-section-title">Kontrol Bilgileri</div>
        <table class="fr265-table">
            <thead>
                <tr>
                    <th>Kontrol</th>
                    <th>Sonuç</th>
                    <th>Açıklama</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kontrol in Model.Kontroller.OrderBy(x => x.KontrolNo))
                {
                    <tr>
                        <td>@(kontrol.KontrolNo). Kontrol</td>
                        <td>@KontrolSonucYazi(kontrol.Sonuc)</td>
                        <td>@Deger(kontrol.Aciklama)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="fr265-sign-grid">
        <div class="fr265-sign">
            <div class="fr265-sign-title">Sertifikalı Firma Yetkilisi</div>
            <div class="fr265-line">Adı ve Soyadı: @Deger(Model.FirmaYetkiliKisi)</div>
            <div class="fr265-line">Tarih: @formTarihi</div>
            <div class="fr265-line">İmza:</div>
        </div>
        <div class="fr265-sign">
            <div class="fr265-sign-title">İşlemi Yapan Gaz Dağıtım Şirketi Yetkilisi</div>
            <div class="fr265-line">Adı ve Soyadı:</div>
            <div class="fr265-line">Tarih:</div>
            <div class="fr265-line">İmza:</div>
        </div>
    </div>

    <p class="fr265-text">Yukarıdaki bilgileri verilen yeni cihaz belirtilen adreste görülmüştür.</p>
    <div class="fr265-sign-grid">
        <div class="fr265-sign">
            <div class="fr265-sign-title">İşlemi Yapan Gaz Dağıtım Şirketi Yetkilisi</div>
            <div class="fr265-line">Adı ve Soyadı:</div>
            <div class="fr265-line">Tarih:</div>
            <div class="fr265-line">İmza:</div>
        </div>
        <div class="fr265-sign">
            <div class="fr265-sign-title">İşlem Yapılan Abone / Kullanıcı</div>
            <div class="fr265-line">Adı ve Soyadı: @Deger(Model.MusteriAdi)</div>
            <div class="fr265-line">Tarih:</div>
            <div class="fr265-line">İmza:</div>
        </div>
    </div>

    <div class="fr265-note">Not: Bu belge kontrol önizlemesidir. @(demoImzaModu ? "Geliştirme ortamında akış demo sağlayıcıyla gösterilir; sonuç hukuki imza sayılmaz." : "Gerçek entegrasyonda doğru bulunan form dış dijital imza/arşiv uygulamasına gönderilecek, indirme işlemi imzalı nihai belge üzerinden yapılacaktır.")</div>
</section>
