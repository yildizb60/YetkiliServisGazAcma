@model YkcTalepDetayDto
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["ContentClass"] = "fr265-preview-content";
    var formTarihi = Model.TalepTarihi.ToString("dd.MM.yyyy");
    var imzaEntegrasyonu = ViewBag.ImzaEntegrasyonu as YkcImzaEntegrasyonDto ?? new YkcImzaEntegrasyonDto();
    var ykcYetkileri = ViewBag.YkcYetkileri as YkcYetkiOzeti ?? new YkcYetkiOzeti();
    var imzaIslemYetkisi = ykcYetkileri.Fr265ImzaIslemiYapabilir;
    var demoImzaModu = imzaEntegrasyonu.DemoModuMu;
    var imzaliBelge = Model.ImzaSureci?.NihaiDosyaId is int nihaiDosyaId
        ? Model.Dosyalar.FirstOrDefault(x => x.Id == nihaiDosyaId && x.DosyaTuru == YkcFormDosyaTuruDegerleri.Fr265ImzaliNihai)
        : null;
    var imzaliBelgeHazir = imzaliBelge != null
        && Model.ImzaSureci?.Durum == YkcImzaDurumDegerleri.Tamamlandi
        && !string.IsNullOrWhiteSpace(Model.ImzaSureci.ProviderDocumentId)
        && Model.ImzaSureci.NihaiDosyaId.HasValue;
    var gonderimTakildi = Model.ImzaSureci?.Durum == YkcImzaDurumDegerleri.ImzayaGonderildi
        && string.IsNullOrWhiteSpace(Model.ImzaSureci.ProviderDocumentId)
        && (!Model.ImzaSureci.GonderimTarihi.HasValue || Model.ImzaSureci.GonderimTarihi <= DateTime.Now.AddMinutes(-5));
    var kontroller = Model.Kontroller
        .Where(x => x.KontrolNo is >= 1 and <= 5)
        .GroupBy(x => x.KontrolNo)
        .Select(x => x.OrderByDescending(k => k.KontrolTarihi ?? DateTime.MinValue).First())
        .OrderBy(x => x.KontrolNo)
        .ToList();
    var kontrolSatirlari = Enumerable.Range(1, 5)
        .Select(no => kontroller.FirstOrDefault(x => x.KontrolNo == no) ?? new YkcFr265KontrolDto { KontrolNo = no })
        .ToList();
    var sonKontrol = kontrolSatirlari
        .Where(x => x.Sonuc == YkcFr265KontrolSonucDegerleri.Uygun || x.Sonuc == YkcFr265KontrolSonucDegerleri.UygunDegil)
        .OrderBy(x => x.KontrolNo)
        .LastOrDefault();
    var imzayaHazir = Model.Durum == YkcDurumDegerleri.SahaIsleminde
        && Model.RandevuTarihi.HasValue
        && !string.IsNullOrWhiteSpace(Model.RandevuSaati)
        && sonKontrol?.Sonuc == YkcFr265KontrolSonucDegerleri.Uygun;
    var imzayaGonderebilir = imzaIslemYetkisi
        && imzaEntegrasyonu.KullanilabilirMi
        && imzayaHazir
        && string.IsNullOrWhiteSpace(Model.ImzaSureci?.ProviderDocumentId)
        && (Model.ImzaSureci?.Durum is null or YkcImzaDurumDegerleri.Hazir or YkcImzaDurumDegerleri.Hata || gonderimTakildi);
    var imzaDurumuSorgulanabilir = imzaIslemYetkisi
        && imzaEntegrasyonu.KullanilabilirMi
        && !string.IsNullOrWhiteSpace(Model.ImzaSureci?.ProviderDocumentId)
        && Model.ImzaSureci?.Durum != YkcImzaDurumDegerleri.Tamamlandi;
}

@section Styles {
    <link rel="stylesheet" href="~/css/form-pdf-viewer.css" asp-append-version="true" />
}
@section PageStyles {
    <style>
        body:has(.fr265-preview-content), .layout:has(.fr265-preview-content) { height:100dvh; min-height:0; overflow:hidden; }
        .main:has(.fr265-preview-content) { height:100dvh; min-height:0; display:flex; flex-direction:column; overflow:hidden; }
        .content.fr265-preview-content { flex:1; min-height:0; box-sizing:border-box; padding:6px 12px; display:flex; flex-direction:column; overflow:hidden; }
        .fr265-preview-content .form-pdf-viewer { min-height:0; flex:1; display:flex; flex-direction:column; }
        .fr265-preview-content .form-pdf-controls { min-height:38px; padding:3px 8px; flex:none; justify-content:space-between; gap:7px; }
        .fr265-control-context, .fr265-pdf-navigation, .fr265-control-actions { min-width:0; display:flex; align-items:center; gap:5px; }
        .fr265-control-context { flex:1; color:#213b53; white-space:nowrap; }
        .fr265-control-context strong { overflow:hidden; font-size:11px; font-weight:700; text-overflow:ellipsis; }
        .fr265-pdf-navigation { flex:none; }
        .fr265-control-actions { flex:1; justify-content:flex-end; }
        .fr265-control-actions form { margin:0; }
        .fr265-preview-content .form-pdf-controls .df-btn { box-sizing:border-box; width:auto; min-width:0; height:30px; min-height:30px; padding:4px 8px; flex:none; border-radius:5px; font-size:10px; white-space:nowrap; }
        .fr265-preview-content .form-pdf-controls .fr265-return { width:30px; padding:4px; }
        .fr265-preview-content .form-pdf-controls .fr265-signature-action { width:30px; padding:4px; }
        .fr265-preview-content .form-pdf-scroll { min-height:0; height:auto; flex:1; padding:9px; }
        @@media (max-width:760px) {
            .content.fr265-preview-content { padding:6px 8px; }
            .fr265-preview-content .form-pdf-controls { flex-wrap:wrap; }
            .fr265-control-context { flex:1 1 100px; }
            .fr265-pdf-navigation { order:3; width:100%; justify-content:center; }
            .fr265-control-actions { flex:0 1 auto; }
        }
        @@media (max-width:420px) {
            .fr265-preview-content .form-pdf-controls { gap:4px; padding-inline:6px; }
            .fr265-preview-content .form-pdf-controls output { min-width:42px; }
            .fr265-preview-content .form-pdf-controls select { width:112px; }
            .fr265-control-actions .df-btn span { display:none; }
        }
    </style>
}
<section class="form-pdf-viewer" data-pdf-viewer data-pdf-url="/ykc/fr265/pdf/@Model.Id" aria-label="Cihaz değişim formu PDF önizlemesi">
    <div class="form-pdf-controls" role="group" aria-label="PDF araçları">
        <div class="fr265-control-context"><a class="df-btn df-btn-secondary df-btn-sm fr265-return" href="/ykc/detay/@Model.Id" title="Detaya Dön" aria-label="Detaya Dön"><i class="bi bi-arrow-left" aria-hidden="true"></i></a><strong>@(imzaliBelgeHazir ? $"İmzalı Form #{Model.Id}" : $"Form #{Model.Id}")</strong></div>
        <div class="fr265-pdf-navigation">
            <button type="button" data-pdf-prev title="Önceki sayfa" aria-label="Önceki sayfa" disabled><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
            <output data-pdf-page aria-live="polite">- / -</output>
            <button type="button" data-pdf-next title="Sonraki sayfa" aria-label="Sonraki sayfa" disabled><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            <select data-pdf-zoom aria-label="PDF yakınlaştırma" disabled><option value="fit">Genişliğe sığdır</option><option value="75">%75</option><option value="100">%100</option><option value="125">%125</option><option value="150">%150</option><option value="200">%200</option></select>
            <a class="form-pdf-download" href="/ykc/fr265/pdf/@Model.Id?indir=true" title="PDF indir" aria-label="PDF indir"><i class="bi bi-download" aria-hidden="true"></i></a>
        </div>
        <div class="fr265-control-actions">
        @if (imzaliBelgeHazir && imzaliBelge != null)
        {
            <a class="df-btn df-btn-primary df-btn-sm fr265-signature-action" href="/ykc/dosya/@imzaliBelge.Id" target="_blank" title="İmzalı Belgeyi İndir" aria-label="İmzalı Belgeyi İndir"><i class="bi bi-file-earmark-check" aria-hidden="true"></i></a>
            @if (demoImzaModu && imzaIslemYetkisi
                && Model.ImzaSureci?.ProviderDocumentId?.StartsWith("DEMO-YKC-", StringComparison.Ordinal) == true
                && imzaliBelge.DosyaAdi?.Contains(YkcFr265PdfService.TasarimSurumu, StringComparison.Ordinal) != true)
            {
                <form method="post" action="/ykc/imza-durum-sorgula">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="talepId" value="@Model.Id" />
                    <button type="submit" class="df-btn df-btn-secondary df-btn-sm"><i class="bi bi-arrow-clockwise"></i> Demo PDF'yi Güncelle</button>
                </form>
            }
        }
        @if (imzayaGonderebilir)
        {
            <form method="post" action="/ykc/imzaya-gonder">
                @Html.AntiForgeryToken()
                <input type="hidden" name="talepId" value="@Model.Id" />
                <button class="df-btn df-btn-primary df-btn-sm" type="submit" title="İmzaya Gönder" aria-label="İmzaya Gönder"><i class="bi bi-send" aria-hidden="true"></i><span>İmzaya Gönder</span></button>
            </form>
        }
        else if (imzaDurumuSorgulanabilir)
        {
            <form method="post" action="/ykc/imza-durum-sorgula">
                @Html.AntiForgeryToken()
                <input type="hidden" name="talepId" value="@Model.Id" />
                <button class="df-btn df-btn-primary df-btn-sm" type="submit" title="İmza Durumunu Güncelle" aria-label="İmza Durumunu Güncelle"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span>Durumu Güncelle</span></button>
            </form>
        }
        else if (!imzaEntegrasyonu.KullanilabilirMi)
        {
            <span class="df-btn df-btn-secondary df-btn-sm" style="pointer-events:none;opacity:.65;">İmza Entegrasyonu Bekleniyor</span>
        }
        </div>
    </div>
    <p class="form-pdf-message" data-pdf-message role="status">Form yükleniyor...</p>
    <div class="form-pdf-scroll" data-pdf-scroll tabindex="0" aria-label="PDF sayfası">
        <canvas data-pdf-canvas role="img" aria-label="Form sayfası" hidden></canvas>
        <p class="form-pdf-accessible-text" data-pdf-text></p>
    </div>
    <noscript><p>Formu görüntülemek için <a href="/ykc/fr265/pdf/@Model.Id?indir=true">PDF dosyasını indirin</a>.</p></noscript>
</section>
@section Scripts {
    <script type="module" src="~/js/form-pdf-viewer.js" asp-append-version="true"></script>
}
